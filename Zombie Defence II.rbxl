owner = name.Parent.OwnerName

while true do
if owner.Value ~= &quot;&quot; then
name.Name = &quot;Tycoon Owner : &quot; .. owner.Value
else
name.Name = &quot;Tycoon Owner : No One&quot;
end
wait(2)
end
