&#9;&#9;&#9;&#9;&#9;&#9;target=s
&#9;&#9;&#9;&#9;&#9;elseif d&lt;smallest then
&#9;&#9;&#9;&#9;&#9;&#9;smallest=d
&#9;&#9;&#9;&#9;&#9;&#9;target=s
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end

&#9;&#9;&#9;if smallest==nil then stopmoving() return end
&#9;&#9;&#9;
