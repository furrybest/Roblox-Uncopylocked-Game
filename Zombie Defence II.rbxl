&#9;&#9;sound:play()
&#9;else
&#9;&#9;sound:pause()
&#9;end
end

function onRunning(speed)
&#9;if speed&gt;0 then
&#9;&#9;sRunning:play()
&#9;else
&#9;&#9;sRunning:pause()
&#9;end
end


