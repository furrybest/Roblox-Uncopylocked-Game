&#9;&#9;&#9;&#9;&#9;&#9;&#9;script.Parent.Humanoid:MoveTo(pp6.Position, pp6)
&#9;&#9;&#9;&#9;&#9;&#9;&#9;wait(time)
&#9;&#9;&#9;&#9;&#9;&#9;&#9;if points&gt;6 then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;script.Parent.Humanoid:MoveTo(pp7.Position, pp7)
