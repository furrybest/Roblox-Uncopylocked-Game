						<ProtectedString name="Source">local Humanoid = script.Parent.Monster-- Or Zombie Or Whatever 
function PwntX_X() 
local tag = Humanoid:findFirstChild(&quot;creator&quot;) 
&#9;if tag ~= nil then 
&#9;&#9;if tag.Value ~= nil then 
local Leaderstats = tag.Value:findFirstChild(&quot;leaderstats&quot;) 
&#9;&#9;&#9;if Leaderstats ~= nil then 
&#9;&#9;&#9;&#9;local playershirt = tag.Value.Character.Torso.roblox.Texture
&#9;&#9;&#9;&#9;if playershirt ~= nil then
&#9;&#9;&#9;&#9;&#9;if playershirt == &quot;http://www.roblox.com/asset/?id=70183818&quot; then
&#9;&#9;&#9;&#9;&#9;&#9;Leaderstats.Gold.Value = Leaderstats.Gold.Value + math.random(14,20)
&#9;&#9;&#9;&#9;&#9;&#9;Leaderstats.XP.Value = Leaderstats.XP.Value + math.random(4,8)
&#9;&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;&#9;Leaderstats.Gold.Value = Leaderstats.Gold.Value + math.random(7,10)
&#9;&#9;&#9;&#9;&#9;&#9;Leaderstats.XP.Value = Leaderstats.XP.Value + math.random(2,4)
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
wait(0.1)
script:remove()
&#9;&#9;&#9;end 
&#9;&#9;end 
&#9;end 
end 
