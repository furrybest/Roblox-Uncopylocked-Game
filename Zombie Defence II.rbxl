				<Item class="Script" referent="RBX5623">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">XP/Gold Script Tier 3</string>
						<ProtectedString name="Source">local Humanoid = script.Parent.Monster-- Or Zombie Or Whatever 
function PwntX_X() 
local tag = Humanoid:findFirstChild(&quot;creator&quot;) 
&#9;if tag ~= nil then 
&#9;&#9;if tag.Value ~= nil then 
local Leaderstats = tag.Value:findFirstChild(&quot;leaderstats&quot;) 
&#9;&#9;&#9;if Leaderstats ~= nil then 
&#9;&#9;&#9;&#9;local playershirt = tag.Value.Character.Torso.roblox.Texture
&#9;&#9;&#9;&#9;if playershirt ~= nil then
&#9;&#9;&#9;&#9;&#9;if playershirt == &quot;http://www.roblox.com/asset/?id=70183871&quot; then
&#9;&#9;&#9;&#9;&#9;&#9;Leaderstats.Gold.Value = Leaderstats.Gold.Value + math.random(40,60)
&#9;&#9;&#9;&#9;&#9;&#9;Leaderstats.XP.Value = Leaderstats.XP.Value + math.random(12,24)
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
wait(0.1)
script:remove()
&#9;&#9;&#9;end 
&#9;&#9;end 
&#9;end 
end 
