&#9;&#9;&#9;&#9;&#9;&#9;Leaderstats.XP.Value = Leaderstats.XP.Value + math.random(4,12)
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
wait(0.1)
script:remove()
&#9;&#9;&#9;end 
&#9;&#9;end 
&#9;end 
end 
