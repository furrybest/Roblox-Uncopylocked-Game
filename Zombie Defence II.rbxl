		<Item class="Script" referent="RBX2985">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Voice Timed Regen</string>
				<ProtectedString name="Source">model = game.Workspace.RegenFix --change mymodelname to your model name
messageText = &quot;&quot; -- dont put anything if you dont want a message

message = Instance.new(&quot;Message&quot;)
message.Text = messageText
backup = model:clone()

while true do
&#9;wait(30) -- change this to whatever seconds you want

&#9;message.Parent = game.Workspace
&#9;model:remove()

&#9;wait() -- Change this to make how long the regen message appears

&#9;model = backup:clone()
&#9;model.Parent = game.Workspace
&#9;model:makeJoints()
&#9;message.Parent = nil 
end
----- Made by StarWolfXP</ProtectedString>
			</Properties>
		</Item>
