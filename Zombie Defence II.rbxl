&#9;&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end

&#9;if points&lt;1 then return end
&#9;patrolling=true
&#9;local time=2
&#9;if points==1 then return end
&#9;if points&gt;1 then
&#9;&#9;while patrolling==true do
&#9;&#9;&#9;script.Parent.Humanoid:MoveTo(pp1.Position, pp1)
&#9;&#9;&#9;wait(time)
&#9;&#9;&#9;script.Parent.Humanoid:MoveTo(pp2.Position, pp2)
