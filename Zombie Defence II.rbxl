				<string name="Name">MinigameScript</string>
				<ProtectedString name="Source">--Developed by StarWolfXP
-- Master Scripter

while true do
wait(0)
local m = math.random(1,4)
local player = game.Players:GetPlayers()
for i = 1, #player do
h = Instance.new(&quot;Hint&quot;)
h.Parent = game.Workspace

if m == 1 then
h.Text = &quot;Intermission&quot;
wait (15)
h.Text = &quot;Zombies will arrive in 45 Second(s)&quot;
wait (15)
h.Text = &quot;Zombies will arrive in 30 Second(s)&quot;
wait (15)
h.Text = &quot;Zombies will arrive in 15 Second(s)&quot;
wait (15)
h.Text = &quot;&quot;
game.lighting.TimeOfDay = &quot;16:00:00&quot;
wait(0.1)
game.lighting.TimeOfDay = &quot;17:00:00&quot;
wait(0.1)
game.lighting.TimeOfDay = &quot;18:00:00&quot;
