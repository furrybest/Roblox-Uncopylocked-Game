game.lighting.TimeOfDay = &quot;23:00:00&quot;
wait(0.1)
game.lighting.TimeOfDay = &quot;24:00:00&quot;
wait(0.1)
target = Vector3.new(435, 20.4, 174) --could be near a brick or in a new area
for i, v in pairs(game.Players:GetChildren()) do
v.Character.Torso.CFrame = CFrame.new(target + Vector3.new(0, i * 15, 0))
end
game.Lighting.Z1:clone().Parent = game.Workspace
model1 = game.Workspace.Z1
backup = model1:clone()
&#9;do
&#9;&#9;model1:remove()
&#9;&#9;model1 = backup:clone()
&#9;&#9;model1.Parent = game.Workspace
&#9;&#9;model1:makeJoints()
&#9;end
h.Text = &quot;Round 1!&quot;
wait (10)
wait(120)
do
&#9;wait(0)
&#9;game.Workspace.Z1:Remove()
end
