				<Item class="Script" referent="RBX4488">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">local larm = script.Parent:FindFirstChild(&quot;Left Arm&quot;)
local rarm = script.Parent:FindFirstChild(&quot;Right Arm&quot;)

function findNearestTorso(pos)
&#9;local list = game.Workspace:children()
&#9;local torso = nil
&#9;local dist = 1000
&#9;local temp = nil
&#9;local human = nil
&#9;local temp2 = nil
&#9;for x = 1, #list do
&#9;&#9;temp2 = list[x]
&#9;&#9;if (temp2.className == &quot;Model&quot;) and (temp2 ~= script.Parent) then
&#9;&#9;&#9;temp = temp2:findFirstChild(&quot;Torso&quot;)
&#9;&#9;&#9;human = temp2:findFirstChild(&quot;Humanoid&quot;)
&#9;&#9;&#9;if (temp ~= nil) and (human ~= nil) and (human.Health &gt; 0) then
&#9;&#9;&#9;&#9;if (temp.Position - pos).magnitude &lt; dist then
&#9;&#9;&#9;&#9;&#9;torso = temp
&#9;&#9;&#9;&#9;&#9;dist = (temp.Position - pos).magnitude
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
&#9;return torso
end

function Hit(hit)
&#9;local human = hit.Parent:FindFirstChild(&quot;Humanoid&quot;)
&#9;if human ~= nil then
&#9;&#9;human.Health =  human.Health -4
&#9;end
end

larm.Touched:connect(Hit)
rarm.Touched:connect(Hit)

while true do
&#9;wait(0.1)
&#9;local target = findNearestTorso(script.Parent.Torso.Position)
&#9;if target ~= nil then
&#9;&#9;script.Parent.Monster:MoveTo(target.Position, target)
&#9;end
end
</ProtectedString>
					</Properties>
				</Item>
				<Item class="Script" referent="RBX4489">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Health</string>
						<ProtectedString name="Source">function waitForChild(parent, childName)
&#9;while true do
&#9;&#9;local child = parent:findFirstChild(childName)
&#9;&#9;if child then
&#9;&#9;&#9;return child
&#9;&#9;end
&#9;&#9;parent.ChildAdded:wait()
&#9;end
end

-- declarations

local Figure = script.Parent
local Head = waitForChild(Figure, &quot;Head&quot;)
local Humanoid = waitForChild(Figure, &quot;Monster&quot;)
Humanoid.Health=10
-- regeneration
while true do
&#9;local s = wait(60)
&#9;local health = Humanoid.Health
&#9;if health &gt; 0 and health &lt; Humanoid.MaxHealth then
&#9;&#9;health = health + 0.08 * s * Humanoid.MaxHealth
&#9;&#9;if health * 1.05 &lt; Humanoid.MaxHealth then
&#9;&#9;&#9;Humanoid.Health = health
&#9;&#9;else
&#9;&#9;&#9;Humanoid.Health = Humanoid.MaxHealth
&#9;&#9;end
&#9;end
end
</ProtectedString>
					</Properties>
				</Item>
				<Item class="Script" referent="RBX4490">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">XP/Gold Script Tier 1</string>
						<ProtectedString name="Source">local Humanoid = script.Parent.Monster-- Or Zombie Or Whatever 
function PwntX_X() 
local tag = Humanoid:findFirstChild(&quot;creator&quot;) 
&#9;if tag ~= nil then 
&#9;&#9;if tag.Value ~= nil then 
local Leaderstats = tag.Value:findFirstChild(&quot;leaderstats&quot;) 
&#9;&#9;&#9;if Leaderstats ~= nil then 
&#9;&#9;&#9;&#9;local playershirt = tag.Value.Character.Torso.roblox.Texture
&#9;&#9;&#9;&#9;if playershirt ~= nil then
&#9;&#9;&#9;&#9;&#9;if playershirt == &quot;http://www.roblox.com/asset/?id=70183818&quot; then
&#9;&#9;&#9;&#9;&#9;&#9;Leaderstats.Gold.Value = Leaderstats.Gold.Value + math.random(14,20)
&#9;&#9;&#9;&#9;&#9;&#9;Leaderstats.XP.Value = Leaderstats.XP.Value + math.random(4,8)
&#9;&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;&#9;Leaderstats.Gold.Value = Leaderstats.Gold.Value + math.random(7,10)
&#9;&#9;&#9;&#9;&#9;&#9;Leaderstats.XP.Value = Leaderstats.XP.Value + math.random(2,4)
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
wait(0.1)
script:remove()
&#9;&#9;&#9;end 
&#9;&#9;end 
&#9;end 
end 
Humanoid.Died:connect(PwntX_X) </ProtectedString>
					</Properties>
				</Item>
				<Item class="Script" referent="RBX4491">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
