&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end

&#9;end
end

if game.Players.NumPlayers&gt;1 then
&#9;x=game.Players:children()
&#9;
&#9;for i=1, #x do
