				<ProtectedString name="Source">--Music: Super Mario Bros. Underworld (World 1-2)
--Scripted/Composed by: Wiistar97&#9;&#9;Edited by: Wazupmaster
--P.S. - I&apos;m in your base, Telamon, stealing your fried chicken.


music = Instance.new(&quot;Sound&quot;)
music.Parent = game.Workspace
music.Name = &quot;Super Mario Bros. Underworld&quot;
music.SoundId = &quot;rbxasset://sounds\\bass.wav&quot;

while true do
&#9;wait(.5) --Start
&#9;music.Pitch = 1.5
&#9;music:play()
&#9;wait(0.2)
