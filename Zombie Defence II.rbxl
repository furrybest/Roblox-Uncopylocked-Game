				<Item class="Script" referent="RBX5765">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Health</string>
						<ProtectedString name="Source">function waitForChild(parent, childName)
&#9;while true do
&#9;&#9;local child = parent:findFirstChild(childName)
&#9;&#9;if child then
&#9;&#9;&#9;return child
&#9;&#9;end
&#9;&#9;parent.ChildAdded:wait()
&#9;end
end

-- declarations

local Figure = script.Parent
local Head = waitForChild(Figure, &quot;Head&quot;)
local Humanoid = waitForChild(Figure, &quot;Monster&quot;)
Humanoid.Health=35
-- regeneration
while true do
&#9;local s = wait(60)
&#9;local health = Humanoid.Health
&#9;if health &gt; 0 and health &lt; Humanoid.MaxHealth then
&#9;&#9;health = health + 0.08 * s * Humanoid.MaxHealth
&#9;&#9;if health * 1.05 &lt; Humanoid.MaxHealth then
&#9;&#9;&#9;Humanoid.Health = health
&#9;&#9;else
&#9;&#9;&#9;Humanoid.Health = Humanoid.MaxHealth
&#9;&#9;end
&#9;end
end
</ProtectedString>
					</Properties>
				</Item>
				<Item class="Script" referent="RBX5766">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">XP/Gold Script Tier 1</string>
						<ProtectedString name="Source">local Humanoid = script.Parent.Monster-- Or Zombie Or Whatever 
function PwntX_X() 
local tag = Humanoid:findFirstChild(&quot;creator&quot;) 
&#9;if tag ~= nil then 
&#9;&#9;if tag.Value ~= nil then 
local Leaderstats = tag.Value:findFirstChild(&quot;leaderstats&quot;) 
&#9;&#9;&#9;if Leaderstats ~= nil then 
&#9;&#9;&#9;&#9;local playershirt = tag.Value.Character.Torso.roblox.Texture
&#9;&#9;&#9;&#9;if playershirt ~= nil then
&#9;&#9;&#9;&#9;&#9;if playershirt == &quot;http://www.roblox.com/asset/?id=70183818&quot; then
&#9;&#9;&#9;&#9;&#9;&#9;Leaderstats.Gold.Value = Leaderstats.Gold.Value + math.random(20,30)
&#9;&#9;&#9;&#9;&#9;&#9;Leaderstats.XP.Value = Leaderstats.XP.Value + math.random(6,12)
&#9;&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;&#9;Leaderstats.Gold.Value = Leaderstats.Gold.Value + math.random(10,15)
&#9;&#9;&#9;&#9;&#9;&#9;Leaderstats.XP.Value = Leaderstats.XP.Value + math.random(3,6)
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
wait(0.1)
script:remove()
&#9;&#9;&#9;end 
&#9;&#9;end 
&#9;end 
end 
Humanoid.Died:connect(PwntX_X) </ProtectedString>
					</Properties>
				</Item>
