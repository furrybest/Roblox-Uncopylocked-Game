							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Buy</string>
							<ProtectedString name="Source">amnt = 10
state = 0
hold = false
prt = script.Parent

function GiveProduct(human)
	local teamColor = Color3.new(1,1,1)
	human.Torso.Color = teamColor
end

function onTouched(part)
	local h = part.Parent:findFirstChild(&quot;Humanoid&quot;)
	if (h~=nil and hold==false) then
		hold=true
		state=state+1
		prt.Color = Color3.new(0,0,0)
		wait(3)
		if (state==1) then
			prt.Color = Color3.new(1,1,0)
		end
		if (state==2) then
			prt.Color = Color3.new(1,0,0)
			local thisplr = game.Players:findFirstChild(h.Parent.Name)
			if (thisplr~=nil) then
				local stats = thisplr:findFirstChild(&quot;leaderstats&quot;)
				if (stats~=nil) then
					local score = stats:findFirstChild(&quot;Cash&quot;)
					if (score~=nil) then
						if (score.Value &gt;=amnt) then
							score.Value = score.Value - amnt
							GiveProduct(h)
						end
					end
				end
			end
			wait(3)
			prt.Color = Color3.new(0,1,0)
			state=0
		end
		hold=false
	end
end

