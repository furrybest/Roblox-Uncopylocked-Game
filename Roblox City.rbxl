					<string name="Name">Code</string>
					<ProtectedString name="Source">--01234
--13214
step=0
door=game.Workspace.BulletTrain.EgnrDr
dig1=script.Parent.digit3
dig2=script.Parent.digit4
dig3=script.Parent.digit1
dig4=script.Parent.digit2
conf=script.Parent.toplt
dighold=0

function unlock()
	door.CanCollide = false
	door.Transparency = 1

	--FOR BULLET TRAIN ONLY
	game.Workspace.BulletTrain.Door1.CanCollide = false
	game.Workspace.BulletTrain.Door1.Transparency = 1
	game.Workspace.BulletTrain.Door2.CanCollide = false
	game.Workspace.BulletTrain.Door2.Transparency = 1
end

function deny()
	step=0
	conf.Color = Color3.new(0,0,0)
	dighold=1
	wait(2)
	conf.Color = Color3.new(1,1,0)
	dighold=0
end

function onTouchedDg1(part)
	local h = part.Parent:findFirstChild(&quot;Humanoid&quot;)
	if (h~=nil and dighold==0) then
		local elsebrk=false
		if (step==0 or step==3) then
			step=step+1
			dig1.Color = Color3.new(0,0,0)
			dighold=1
			wait(1)
			dig1.Color = Color3.new(1,0,0)
			dighold=0
			elsebrk=true
		end
		if (elsebrk==false) then
			deny()
		end
	end
end

function onTouchedDg2(part)
	local h = part.Parent:findFirstChild(&quot;Humanoid&quot;)
	if (h~=nil and dighold==0) then
		local elsebrk=false
		if (step==2) then
			step=step+1
			dig2.Color = Color3.new(0,0,0)
			dighold=1
			wait(1)
			dig2.Color = Color3.new(0,1,0)
			dighold=0
			elsebrk=true
		end
		if (elsebrk==false) then
			deny()
		end
	end
end

function onTouchedDg3(part)
	local h = part.Parent:findFirstChild(&quot;Humanoid&quot;)
	if (h~=nil and dighold==0) then
		local elsebrk=false
		if (step==1) then
			step=step+1
			dig3.Color = Color3.new(0,0,0)
			dighold=1
			wait(1)
			dig3.Color = Color3.new(0,0,1)
			dighold=0
			elsebrk=true
		end
		if (elsebrk==false) then
			deny()
		end
	end
end

function onTouchedDg4(part)
	local h = part.Parent:findFirstChild(&quot;Humanoid&quot;)
	if (h~=nil and dighold==0) then
		local elsebrk=false
		if (step==4) then
			dig4.Color = Color3.new(0,0,0)
			conf.Color = Color3.new(1,1,1)
			unlock()
			dighold=1

			wait(1)
			dig4.Color = Color3.new(1,1,0)
			conf.Color = Color3.new(1,1,0)
			dighold=0
			step=0
			elsebrk=true
		end
		if (elsebrk==false) then
			deny()
		end
	end
end

dig1.Touched:connect(onTouchedDg1)
dig2.Touched:connect(onTouchedDg2)
dig3.Touched:connect(onTouchedDg3)
dig4.Touched:connect(onTouchedDg4)
