					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">CannonBall</string>
					<ProtectedString name="Source">ball = script.Parent
damage = 0

function onTouched(hit)
	local humanoid = hit.Parent:findFirstChild(&quot;Humanoid&quot;)
	if humanoid~=nil then
		tagHumanoid(humanoid)
		humanoid.Health = humanoid.Health - damage
		wait(2)
		untagHumanoid(humanoid)
		connection:disconnect()
	else
		damage = damage / 2
		if damage &lt; 0.1 then
			connection:disconnect()
		end
	end
end

function tagHumanoid(humanoid)
	-- todo: make tag expire
	local tag = ball:findFirstChild(&quot;creator&quot;)
	if tag ~= nil then
		local new_tag = tag:clone()
		new_tag.Parent = humanoid
	end
end


function untagHumanoid(humanoid)
	if humanoid ~= nil then
		local tag = humanoid:findFirstChild(&quot;creator&quot;)
		if tag ~= nil then
			tag.Parent = nil
		end
	end
end

function blowUp()
	print(&quot;Smokin up!&quot;)
	local smoke = Instance.new(&quot;Part&quot;)
	smoke.Position = script.Parent.Position
	smoke.Color = Color3.new(0,.5,0)
	smoke.Size = Vector3.new(50,50,50)
	smoke.Shape = 0
	smoke.BottomSurface = 0
	smoke.TopSurface = 0
	smoke.Transparency = 1
	smoke.Anchored = true
	smoke.CanCollide = false
	smoke.Parent = game.Workspace

	local pc = game.Workspace.ScriptBank.PoisonControl:clone()
	pc.Disabled = false
	pc.Parent = smoke
	
	ball.Transparency = 1

	local trans = 1
	while (trans&gt;0) do
		trans = trans - .1
		smoke.Transparency = trans
		wait(.1)
	end
	wait(5)
	while (trans&lt;1) do
		trans = trans + .1
		smoke.Transparency = trans
		wait(.1)
	end
	smoke:remove()
end

connection = ball.Touched:connect(onTouched)

r = game:service(&quot;RunService&quot;)
t, s = r.Stepped:wait()
d = t + 3.0 - s
while t &lt; d do
	t = r.Stepped:wait()
end
blowUp()
wait(2)
ball.Parent = nil
