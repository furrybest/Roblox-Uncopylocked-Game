		<Item class="Script" referent="RBX543">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Leaderboard</string>
				<ProtectedString name="Source">print(&quot;Custom Leaderboard running!&quot;)

function onPlayerEntered(newPlayer)

	local stats = Instance.new(&quot;IntValue&quot;)
	stats.Name = &quot;leaderstats&quot;

	local mins = Instance.new(&quot;IntValue&quot;)
	mins.Name = &quot;Mins.&quot;
	mins.Value = 0

	local cash = Instance.new(&quot;IntValue&quot;)
	cash.Name = &quot;Cash&quot;
	cash.Value = 0

	mins.Parent = stats
	cash.Parent = stats
	
	stats.Parent = newPlayer

	while true do
		wait(60)
		mins.Value = mins.Value + 1
	end
end

game.Players.ChildAdded:connect(onPlayerEntered)</ProtectedString>
