			<Item class="Script" referent="RBX944">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Conductor</string>
					<ProtectedString name="Source">print(&quot;RobloxPolice&apos;s AutoCar script loaded!&quot;)

part=script.Parent
le=part.LeftEngine.BodyVelocity
re=part.RightEngine.BodyVelocity
starter=part.StartBlock
ender=part.EndBlock
running=true

dir=1
spd=0
maxspd=50

pos1=starter.Position.z
pos2=ender.Position.z

function SetSpeed(setvel)
	le.velocity = Vector3.new(0,0,-setvel)
	re.velocity = Vector3.new(0,0,-setvel)
end

function StartUp()
	while (spd&lt;maxspd) do
		wait(.1)
		spd=spd+5
		SetSpeed(spd)
	end
end

function StartUpRev()
	while (spd&gt;-maxspd) do
		wait(.1)
		spd=spd-5
		SetSpeed(spd)
	end
end

function SlowDown()
	while (spd&gt;0) do
		wait(.1)
		spd=spd-5
		SetSpeed(spd)
	end
end

function SlowDownRev()
	while (spd&lt;0) do
		wait(.1)
		spd=spd+5
		SetSpeed(spd)
	end
end

while true do
	wait(.1)
	local cpos=part.LeftEngine.Position.z
	if (running==true) then
		if (dir==1) then
			if (spd==0) then
				StartUp()
			end
			if (cpos&lt;=pos2) then
				SlowDown()
				wait(5)
				dir=-1
			end
		end
		if (dir==-1) then
			if (spd==0) then
				StartUpRev()
			end
			if (cpos&gt;=pos1) then
				SlowDownRev()
				wait(5)
				dir=1
			end
		end
	end
end
</ProtectedString>
					<bool name="archivable">true</bool>
				</Properties>
			</Item>
