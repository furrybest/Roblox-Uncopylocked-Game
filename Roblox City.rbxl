				<Item class="Script" referent="RBX410">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">TrainConductor</string>
						<ProtectedString name="Source">print(&quot;RobloxPolice&apos;s Train Started!&quot;)

part=script.Parent

eng1=part.Engine1.BodyVelocity
eng2=part.Engine2.BodyVelocity
eng3=part.Engine3.BodyVelocity
eng4=part.Engine4.BodyVelocity

start=part.StartSw
stop=part.StopSw
trans=part.TransSw

spdlt=part.SpeedLt
trnlt=part.TransLt

spd=0
maxspd=20
func=0
direct=1
transfunc=0

function SetSpeed(vel)
	eng1.velocity=Vector3.new(0,0,vel)
	eng2.velocity=Vector3.new(0,0,vel)
	eng3.velocity=Vector3.new(0,0,vel)
	eng4.velocity=Vector3.new(0,0,vel)
end

function StartUp()
	while (spd&lt;maxspd) do
		wait(.1)
		spd=spd+1
		SetSpeed(spd)
	end
	SetSpeed(maxspd)
end

function StartUpRev()
	while (spd&gt;-maxspd) do
		wait(.1)
		spd=spd-1
		SetSpeed(spd)
	end
	SetSpeed(-maxspd)
end

function SlowDown()
	while (spd&gt;0) do
		wait(.1)
		spd=spd-1
		SetSpeed(spd)
	end
	SetSpeed(0)
end

function SlowDownRev()
	while (spd&lt;0) do
		wait(.1)
		spd=spd+1
		SetSpeed(spd)
	end
	SetSpeed(0)
end

function onTouchedStart(part)
	local h = part.Parent:findFirstChild(&quot;Humanoid&quot;)
	if h~=nil then
		if (func==0) then
			spdlt.Color = Color3.new(0,1,0)
			if (direct==1) then
				StartUp()
			end
			if (direct==-1) then
				StartUpRev()
			end
			func=1
		end
	end
end

function onTouchedStop(part)
	local h = part.Parent:findFirstChild(&quot;Humanoid&quot;)
	if h~=nil then
		if (func==1) then
			if (direct==1) then
				SlowDown()
			end
			if (direct==-1) then
				SlowDownRev()
			end
			spdlt.Color = Color3.new(1,0,0)
			func=0
		end
	end
end

function onTouchedTrans(part)
	local h = part.Parent:findFirstChild(&quot;Humanoid&quot;)
	if h~=nil then
		if (func==0 and transfunc==0) then
			local bypass=false
			if (direct==1) then
				direct=-1
				bypass=true
				trnlt.Color = Color3.new(0,0,0)
			end
			if (bypass==false) then
				if (direct==-1) then
					direct=1
					trnlt.Color = Color3.new(1,1,1)
				end
			end
			trans.Color=Color3.new(0,0,0)
			transfunc=1
			wait(3)
			trans.Color=Color3.new(1,1,0)
			transfunc=0
		end
	end
end

start.Touched:connect(onTouchedStart)
stop.Touched:connect(onTouchedStop)
trans.Touched:connect(onTouchedTrans)
</ProtectedString>
