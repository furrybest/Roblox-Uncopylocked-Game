					<ProtectedString name="Source">print(&quot;RobloxPolice&apos;s Digital Station&quot;)

bin=script.Parent

--Buttons
DoorBtn=bin.DoorBtn
LoadBtn=bin.LoadingBtn
ServBtn=bin.ServiceBtn

--Doors
OfficeDr=bin.OfficeDr
LoadDr=bin.LoadingDr

--Lights
LoadLt=bin.LoadingLt
ServLt=bin.ServLt

--Status
LoadSt=0  --Open
OfficeSt=0 --Open
DoorFnc=0
LoadFnc=0
ServFnc=0

function onTouchedDoor(part)
	local h = part.Parent:findFirstChild(&quot;Humanoid&quot;)
	if (h~=nil and DoorFnc==0) then
		local bypass=false
		if (OfficeSt==0) then --Open Door
			OfficeSt=1
			bypass=true
			OfficeDr.CanCollide=true
			OfficeDr.Transparency=0

			DoorFnc=1 --Stall Function
			DoorBtn.Color = Color3.new(0.3,0.3,0.3)
			wait(3)
			DoorFnc=0
			DoorBtn.Color = Color3.new(0,1,0)
		end
		if (OfficeSt==1 and bypass==false) then --Close Door
			OfficeSt=0
			OfficeDr.CanCollide=false
			OfficeDr.Transparency=1

			DoorFnc=1 --Stall Function
			DoorBtn.Color = Color3.new(0.3,0.3,0.3)
			wait(3)
			DoorFnc=0
			DoorBtn.Color = Color3.new(1,0,0)
		end
	end
end

function onTouchedLoad(part)
	local h = part.Parent:findFirstChild(&quot;Humanoid&quot;)
	if (h~=nil and LoadFnc==0) then
		local bypass=false
		if (LoadSt==0) then --Close Door
			LoadSt=1
			bypass=true
			LoadDr.CanCollide=true
			LoadDr.Transparency=0
			LoadLt.Color = Color3.new(1,1,0)

			LoadFnc=1 --Stall Function
			LoadBtn.Color = Color3.new(0.3,0.3,0.3)
			wait(3)
			LoadFnc=0
			LoadBtn.Color = Color3.new(0,1,0)
		end
		if (LoadSt==1 and bypass==false) then --Open Door
			LoadSt=0
			LoadDr.CanCollide=false
			LoadDr.Transparency=1
			LoadLt.Color = Color3.new(0.3,0.3,0)

			LoadFnc=1 --Stall Function
			LoadBtn.Color = Color3.new(0.3,0.3,0.3)
			wait(3)
			LoadFnc=0
			LoadBtn.Color = Color3.new(1,0,0)
		end
	end
end

function onTouchedServ(part)
	local h = part.Parent:findFirstChild(&quot;Humanoid&quot;)
	if (h~=nil and ServFnc==0) then
		ServFnc=1 --Stall Function
		ServBtn.Color = Color3.new(0.3,0.3,0.3)
		ServLt.Color = Color3.new(1,1,0.3)
		
		wait(5)
		ServFnc=0
		ServBtn.Color = Color3.new(1,1,0)
		ServLt.Color = Color3.new(0.3,0.3,0.3)
	end
end

DoorBtn.Touched:connect(onTouchedDoor)
LoadBtn.Touched:connect(onTouchedLoad)
ServBtn.Touched:connect(onTouchedServ)
