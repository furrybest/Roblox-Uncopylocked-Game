			<Item class="Script" referent="RBX4">
				<Properties>
					<bool name="Disabled">true</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">PoisonControl</string>
					<ProtectedString name="Source">part = script.Parent

function onTouched(part)
	local h = part.Parent:findFirstChild(&quot;Humanoid&quot;)
	if (h~=nil) then
		local chk = h:findFirstChild(&quot;PoisonUpdate&quot;)
		if (chk==nil) then --Hasn&apos;t been poisoned
			--POISON
			print(&quot;Poisoned!&quot;)
			local teamColor = Color3.new(.5,1,.5)
			local LeftArm = h.Parent:findFirstChild(&quot;Left Arm&quot;)
			local RightArm = h.Parent:findFirstChild(&quot;Right Arm&quot;)
			h.Parent.Head.Color = teamColor
			LeftArm.Color = teamColor
			RightArm.Color = teamColor
	
			local pu = game.Workspace.ScriptBank.PoisonUpdate:clone()
			pu.Disabled = false
			pu.Parent = h
		end
	end
end

part.Touched:connect(onTouched)
</ProtectedString>
					<bool name="archivable">true</bool>
				</Properties>
			</Item>
			<Item class="Script" referent="RBX5">
				<Properties>
					<bool name="Disabled">true</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">PoisonUpdate</string>
					<ProtectedString name="Source">part=script.Parent

while (part.Health&gt;10) do
	wait(1)
	part.Health = part.Health - 10
end
local teamColor = Color3.new(1,1,0)
local LeftArm = h.Parent:findFirstChild(&quot;Left Arm&quot;)
local RightArm = h.Parent:findFirstChild(&quot;Right Arm&quot;)
h.Parent.Head.Color = teamColor
LeftArm.Color = teamColor
RightArm.Color = teamColor
</ProtectedString>
					<bool name="archivable">true</bool>
				</Properties>
