			<Item class="Script" referent="RBX2164">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">SlotGame</string>
					<ProtectedString name="Source">amnt = 1  --COST TO PLAY
hold = false
bin = script.Parent

light = bin.Light
button = bin.Button
dig1 = bin.Digit1
dig2 = bin.Digit2
dig3 = bin.Digit3

color1 = 0
color2 = 0
color3 = 0
function Roll(cash)
	for i=1, 10 do
		--ROLL FIRST
		color1 = math.random(0,10)
		dig1.Color = GetColor(color1)
		--ROLLSECOND
		color2 = math.random(0,10)
		dig2.Color = GetColor(color2)
		--ROLL THIRD
		color3 = math.random(0,10)
		dig3.Color = GetColor(color3)
		wait(0.1)
	end
	for i=1, 10 do
		--ROLLSECOND
		color2 = math.random(0,10)
		dig2.Color = GetColor(color2)
		--ROLL THIRD
		color3 = math.random(0,10)
		dig3.Color = GetColor(color3)
		wait(0.1)
	end
	for i=1, 10 do
		--ROLL THIRD
		color3 = math.random(0,10)
		dig3.Color = GetColor(color3)
		wait(0.1)
	end

	if (color1==3 and color2==2 and color3==5) then
		cash.Value=cash.Value+1000
	end
	if (color1==color2 and color2==color3) then
		cash.Value=cash.Value+500
	end
end

function GetColor(num)
	if (num==0) then --Black
		return Color3.new(0,0,0)
	end
	if (num==1) then --Grey
		return Color3.new(.5,.5,.5)
	end
	if (num==2) then --White
		return Color3.new(1,1,1)
	end
	if (num==3) then --Red
		return Color3.new(1,0,0)
	end
	if (num==4) then --Green
		return Color3.new(0,1,0)
	end
	if (num==5) then --Blue
		return Color3.new(0,0,1)
	end
	return Color3.new(GetRand(),GetRand(),GetRand())
end

function GetRand()
	return (math.random(1,10)/10)
end

function onTouched(part)
	local h = part.Parent:findFirstChild(&quot;Humanoid&quot;)
	if (h~=nil and hold==false) then
		hold=true
		button.Color = Color3.new(0,0,0)
		local thisplr = game.Players:findFirstChild(h.Parent.Name)
		if (thisplr~=nil) then
			local stats = thisplr:findFirstChild(&quot;leaderstats&quot;)
			if (stats~=nil) then
				local score = stats:findFirstChild(&quot;Cash&quot;)
				if (score~=nil) then
					if (score.Value &gt;=amnt) then
						score.Value = score.Value - amnt
						Roll(score)
					end
				end
			end
		end
		button.Color = Color3.new(0,1,0)
		hold=false
	end
end

button.Touched:connect(onTouched)</ProtectedString>
					<bool name="archivable">true</bool>
				</Properties>
			</Item>
		</Item>
