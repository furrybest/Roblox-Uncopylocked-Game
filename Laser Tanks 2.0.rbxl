					<Item class="Script" referent="RBX4732">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script</string>
							<ProtectedString name="Source">local player = script.Parent.Parent.Parent.Parent.Parent

script.Parent.MouseButton1Down:connect(function()
&#9;for _, v in ipairs(player.Backpack:GetChildren()) do
&#9;&#9;v:remove()
&#9;end
&#9;for _, v in ipairs(player.Character:GetChildren()) do
&#9;&#9;if v:IsA(&quot;Tool&quot;) then
&#9;&#9;&#9;v:remove()
&#9;&#9;end
&#9;end
&#9;game.Lighting.Guns:findFirstChild(script.Parent.Name):clone().Parent = player.Backpack
end)</ProtectedString>
						</Properties>
					</Item>
				</Item>
				<Item class="Script" referent="RBX4733">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">local player = script.Parent.Parent.Parent.Parent

for _, v in ipairs(game.Lighting.Guns:GetChildren()) do
&#9;if player.leaderstats.KOs.Value &gt;= v.Cost.Value then
&#9;&#9;local e = script.Parent.Button:clone()
&#9;&#9;e.Parent = script.Parent
&#9;&#9;e.Visible = true
&#9;&#9;e.Name = v.Name
&#9;&#9;e.Text = v.Name
&#9;&#9;e.Position = UDim2.new(.1*(_-1), 0, 0, 0)
&#9;end
end
</ProtectedString>
					</Properties>
				</Item>
			</Item>
		</Item>
		<Item class="Script" referent="RBX4734">
			<Properties>
				<bool name="Disabled">true</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">TankScript</string>
				<ProtectedString name="Source">wait(.1)
local tank = script.Parent
local player = game.Players:playerFromCharacter(tank.Parent.Parent)
tank.MaxHealth.Value = math.min(math.ceil((1.145^player.Health.Value)*tank.MaxHealth.Value), 2^31-1)
if game:GetService(&quot;BadgeService&quot;):UserHasBadge(player.userId, 74814653) then
&#9;tank.MaxHealth.Value = math.min(tank.MaxHealth.Value*2, 2^31-1)
end
tank.Health.Value = tank.MaxHealth.Value
tank.Damage.Value = math.min(math.ceil((1.15^player.Damage.Value)*tank.Damage.Value), 2^31-1)
if player:IsInGroup(452756) then
&#9;tank.Damage.Value = math.min(tank.Damage.Value*2, 2^31 - 1)
end
if game:GetService(&quot;BadgeService&quot;):UserHasBadge(player.userId, 75127820) then
&#9;tank.Damage.Value = math.min(tank.Damage.Value*1.5, 2^31-1)
end
tank.Range.Value = math.min(tank.Range.Value + player.Range.Value * 10, 2^31-1)
local shield = Instance.new(&quot;Model&quot;)
shield.Name = &quot;Shield&quot;
local S = Instance.new(&quot;Part&quot;, shield)
S.formFactor = &quot;Symmetric&quot;
S.TopSurface, S.BottomSurface = &quot;Smooth&quot;, &quot;Smooth&quot;
S.Transparency = 1
S.Reflectance = .1
S.Name = &quot;Shield&quot;
S.BrickColor = BrickColor.new(&quot;Cyan&quot;)
S.CanCollide = false
S.Size = Vector3.new(0, 0, 0)
local dSize = 0
local modSize = script.Parent:GetModelSize()
dSize = math.ceil(math.max(modSize.X, modSize.Y, modSize.Z))+1
local dMesh = Instance.new(&quot;SpecialMesh&quot;, S)
dMesh.MeshType = &quot;Sphere&quot;
dMesh.Scale = Vector3.new(dSize, dSize, dSize)
S.CFrame = script.Parent:GetModelCFrame()
shield.Parent = script.Parent
local shweld = Instance.new(&quot;Weld&quot;, script.Parent.Head)
shweld.Part0, shweld.Part1 = shweld.Parent, S
shweld.C0, shweld.C1 = shweld.Part0.CFrame:inverse(), shweld.Part1.CFrame:inverse()
local sHealth = Instance.new(&quot;IntValue&quot;, shield)
sHealth.Name = &quot;Health&quot;
local hMod = Instance.new(&quot;Model&quot;, tank)
hMod.Name = &quot;&quot;
local hum = Instance.new(&quot;Humanoid&quot;, hMod)
hum.Health = 0
hum.MaxHealth = 0
local hHead = Instance.new(&quot;Part&quot;, hMod)
hHead.Name = &quot;Head&quot;
hHead.formFactor = &quot;Custom&quot;
hHead.Size = Vector3.new(1, 1, 1)
hHead.Transparency = .9
hHead.CFrame = tank.Head.CFrame + Vector3.new(0, (tank.Head.Size.Y/2)-1, 0)
local hTorso = hHead:clone()
hTorso.Parent = hMod
hTorso.formFactor = &quot;Custom&quot;
hTorso.Size = Vector3.new(0,0,0)
hTorso.Transparency = .9
hTorso.CFrame = hHead.CFrame
hTorso.Name = &quot;Torso&quot;
local hTWeld = Instance.new(&quot;Weld&quot;, hTorso)
hTWeld.Part0 = hHead
hTWeld.Part1 = hTorso
local hWeld = Instance.new(&quot;Weld&quot;, hHead)
hWeld.Part0 = tank.Head
hWeld.Part1 = hHead
local hHealth = Instance.new(&quot;BillboardGui&quot;, hMod)
hHealth.Name = &quot;Health&quot;
hHealth.Adornee = hHead
hHealth.Size = UDim2.new(3, 0, .5, 0)
hHealth.StudsOffset = Vector3.new(0, 3.5, 0)
local hFrame = Instance.new(&quot;Frame&quot;, hHealth)
hFrame.Size = UDim2.new(1, 0, 1, 0)
hFrame.BackgroundColor = BrickColor.new(&quot;Black&quot;)
hFrame.BorderSizePixel = 0
hFrame.Name = &quot;Back&quot;
local hFront = hFrame:clone()
hFront.Parent = hHealth
hFront.Name = &quot;Front&quot;
hFront.BackgroundColor = BrickColor.new(&quot;Bright green&quot;)
hFront.ZIndex = 2
local hLevel = hHealth:clone()
hLevel.Parent = hMod
hLevel.Name = &quot;Level&quot;
hLevel.Adornee = hHead
hLevel.StudsOffset = Vector3.new(0, 3, 0)
local lFront = hLevel.Front
lFront.Size = UDim2.new(0, 0, 1, 0)
lFront.BackgroundColor = BrickColor.new(&quot;Bright blue&quot;)
local LV = Instance.new(&quot;TextLabel&quot;, hLevel.Back)
LV.Name = &quot;LevelDisplay&quot;
LV.BackgroundTransparency = 1
LV.TextColor = BrickColor.new(&quot;Institutional white&quot;)
LV.Text = &quot;&quot;
LV.Size = UDim2.new(1, 0, 1, 0)
LV.ZIndex = 3
local max = tank.MaxHealth
local health = tank.Health
health.Changed:connect(function()
&#9;hFront.Size = UDim2.new(health.Value/max.Value, 0, 1, 0)
end)
local level = tank.Level
local exp = tank.Exp
exp.Changed:connect(function()
&#9;wait()
&#9;local mx = level.Value*10
&#9;lFront.Size = UDim2.new(exp.Value/mx, 0, 1, 0)
&#9;if not script.Parent:findFirstChild(&quot;Mini&quot;) then
&#9;&#9;player.PlayerGui.ScreenGui.Stats.Exp.Text = &quot;Exp: &quot;..exp.Value
&#9;end
&#9;if exp.Value &gt;= mx then
&#9;&#9;exp.Value = exp.Value - mx
&#9;&#9;level.Value = level.Value + 1
&#9;end
end)
level.Changed:connect(function()
&#9;LV.Text = &quot;Level &quot;..level.Value
&#9;if level.Value &gt;= 100 then
&#9;&#9;game:GetService(&quot;BadgeService&quot;):AwardBadge(player.userId, 55365622)
&#9;end
&#9;if level.Value &gt;= 1000 then
&#9;&#9;game:GetService(&quot;BadgeService&quot;):AwardBadge(player.userId, 61980989)
&#9;end
&#9;if level.Value &gt;= 10000 then
&#9;&#9;game:GetService(&quot;BadgeService&quot;):AwardBadge(player.userId, 69679017)
&#9;end
&#9;if not script.Parent:findFirstChild(&quot;Mini&quot;) then
&#9;&#9;player.PlayerGui.ScreenGui.Stats.Level.Text = &quot;Level: &quot;..level.Value
&#9;end
end)
if not script.Parent.Head:findFirstChild(&quot;Welder&quot;) then
&#9;local parts = {}
&#9;for _, v in ipairs(script.Parent:GetChildren()) do
&#9;&#9;if v:IsA(&quot;BasePart&quot;) then
&#9;&#9;&#9;table.insert(parts, v)
&#9;&#9;end
&#9;end
&#9;for _, v in ipairs(parts) do
&#9;&#9;local b = parts[_+1]
&#9;&#9;if b then
&#9;&#9;&#9;local w = Instance.new(&quot;Weld&quot;, v)
&#9;&#9;&#9;w.Part0 = v
&#9;&#9;&#9;w.Part1 = b
&#9;&#9;&#9;w.C0 = v.CFrame:inverse()
&#9;&#9;&#9;w.C1 = b.CFrame:inverse()
&#9;&#9;end
&#9;end
end
if not script.Parent:findFirstChild(&quot;Ultimate&quot;) then
&#9;wait()
&#9;for _, v in ipairs(script.Parent:GetChildren()) do
&#9;&#9;if v:IsA(&quot;BasePart&quot;) then
&#9;&#9;&#9;v.Anchored = false
&#9;&#9;end
&#9;end
end
script.Parent:MoveTo(script.Parent.Head.Position + Vector3.new(0, 5, 0))
script.Parent.Head.Move.Changed:connect(function()
&#9;if script.Parent.Head.Move.velocity ~= Vector3.new(0, 0, 0) then
&#9;&#9;script.Parent.Head.BodyGyro.cframe = CFrame.new(script.Parent.Head.Position*Vector3.new(1, 0, 1), (script.Parent.Head.Position + script.Parent.Head.Move.velocity)*Vector3.new(1, 0, 1))
&#9;end
end)

local mini = script.Parent:findFirstChild(&quot;Mini&quot;)
if mini then
&#9;Delay(0, function()
&#9;&#9;while wait(5) do
&#9;&#9;&#9;if mini.Value &lt; 0 then
&#9;&#9;&#9;&#9;script.Parent:BreakJoints()
&#9;&#9;&#9;&#9;wait(3)
&#9;&#9;&#9;&#9;script.Parent:remove()
&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;mini.Value = math.max(mini.Value-5, 0)
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end)
else
&#9;player:WaitForDataReady()
&#9;script.Parent.Level.Value = math.max((player:LoadNumber(&quot;Level&quot;) or 1), 1)
&#9;script.Parent.Exp.Value = player:LoadNumber(&quot;Exp&quot;) or 0
&#9;player.PlayerGui.ScreenGui.Stats.Level.Text = &quot;Level: &quot;..level.Value
&#9;LV.Text = &quot;Level &quot;..script.Parent.Level.Value
end

player.leaderstats.KOs.Changed:connect(function()
&#9;if player.leaderstats.KOs.Value &gt;= 1000 then
&#9;&#9;game:GetService(&quot;BadgeService&quot;):AwardBadge(player.userId, 55321891)
&#9;end
&#9;if player.leaderstats.KOs.Value &gt;= 5000 then
&#9;&#9;game:GetService(&quot;BadgeService&quot;):AwardBadge(player.userId, 55485889)
&#9;end
&#9;if player.leaderstats.Points.Value &gt;= 100000 then
&#9;&#9;game:GetService(&quot;BadgeService&quot;):AwardBadge(player.userId, 55402106)
&#9;end
&#9;if player.leaderstats.Points.Value &gt;= 1000000 then
&#9;&#9;game:GetService(&quot;BadgeService&quot;):AwardBadge(player.userId, 58383834)
&#9;end
end)
S.Anchored = false

if not script.Parent:findFirstChild(&quot;Fly&quot;) then
&#9;local f = Instance.new(&quot;IntValue&quot;, script.Parent)
&#9;f.Name = &quot;Fly&quot;
&#9;f.Value = 3
end
while wait(2) do
&#9;if math.random(1, 5) == 1 or script.Parent.Head.Move.velocity ~= Vector3.new(0, 0, 0) then
&#9;&#9;local ray = Ray.new(script.Parent.Bottom.Position, Vector3.new(0,-1,0) * script.Parent.Fly.Value) 
&#9;&#9;local obj, pos = workspace:FindPartOnRay(ray, script.Parent)
&#9;&#9;pos = pos or Vector3.new(0, 0, 0)
&#9;&#9;local OK = pos
&#9;&#9;if OK then
&#9;&#9;&#9;if obj then
&#9;&#9;&#9;&#9;if not obj.CanCollide then
&#9;&#9;&#9;&#9;&#9;OK = false
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;if OK then
&#9;&#9;&#9;script.Parent.Head.BodyPosition.position = Vector3.new(0, script.Parent.Fly.Value+(pos.Y), 0)&#9;&#9;
&#9;&#9;else
&#9;&#9;&#9;script.Parent.Head.BodyPosition.position = Vector3.new(0, script.Parent.Fly.Value, 0)
&#9;&#9;end
&#9;end
end
</ProtectedString>
			</Properties>
		</Item>
		<Item class="Model" referent="RBX4735">
			<Properties>
				<CoordinateFrame name="ModelInPrimary">
					<X>0</X>
					<Y>0</Y>
					<Z>0</Z>
					<R00>1</R00>
					<R01>0</R01>
					<R02>0</R02>
					<R10>0</R10>
					<R11>1</R11>
					<R12>0</R12>
					<R20>0</R20>
					<R21>0</R21>
					<R22>1</R22>
				</CoordinateFrame>
				<string name="Name">Upgrades</string>
				<Ref name="PrimaryPart">null</Ref>
			</Properties>
