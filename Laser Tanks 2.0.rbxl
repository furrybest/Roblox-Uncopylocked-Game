			<Item class="Script" referent="RBX312">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Commands</string>
					<ProtectedString name="Source">local colors = {&quot;Regular&quot;, &quot;Really blue&quot;, &quot;Really red&quot;, &quot;New Yeller&quot;, &quot;Lime green&quot;, &quot;Royal purple&quot;, &quot;Bright violet&quot;, &quot;Cyan&quot;, &quot;Toothpaste&quot;, &quot;Really black&quot;, &quot;Institutional white&quot;, &quot;Brown&quot;, &quot;Bright orange&quot;, &quot;Hot pink&quot;, &quot;Toothpaste&quot;, &quot;Mid gray&quot;}

function Get(tab, obj)
&#9;local t = {}
&#9;for _, v in ipairs(tab) do
&#9;&#9;if string.find(v:lower(), obj:lower()) then
&#9;&#9;&#9;table.insert(t, v)
&#9;&#9;end
&#9;end
&#9;if #t &gt; 0 then
&#9;&#9;return t[math.random(1, #t)]
&#9;end
&#9;return nil
end

game.Players.PlayerAdded:connect(function(player)
&#9;wait()
&#9;player.Chatted:connect(function(msg)
&#9;&#9;if game:GetService(&quot;BadgeService&quot;):UserHasBadge(player.userId, 58340007) then
&#9;&#9;&#9;local char = player.Character
&#9;&#9;&#9;if char then
&#9;&#9;&#9;&#9;local torso = char:findFirstChild(&quot;Torso&quot;)
&#9;&#9;&#9;&#9;if torso then
&#9;&#9;&#9;&#9;&#9;if Get(colors, msg) and #msg &gt; 2 then
&#9;&#9;&#9;&#9;&#9;&#9;game.Lighting.Ambient = BrickColor.new(Get(colors, msg)).Color
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;if msg:lower() == &quot;day&quot; then
&#9;&#9;&#9;&#9;&#9;&#9;game.Lighting.TimeOfDay = 14
&#9;&#9;&#9;&#9;&#9;elseif msg:lower() == &quot;night&quot; then
&#9;&#9;&#9;&#9;&#9;&#9;game.Lighting.TimeOfDay = 0
&#9;&#9;&#9;&#9;&#9;elseif msg:lower() == &quot;dawn&quot; then
&#9;&#9;&#9;&#9;&#9;&#9;game.Lighting.TimeOfDay = 6
&#9;&#9;&#9;&#9;&#9;elseif msg:lower() == &quot;dusk&quot; then
&#9;&#9;&#9;&#9;&#9;&#9;game.Lighting.TimeOfDay = 18
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;local args = {}
&#9;&#9;&#9;&#9;&#9;for v in msg:gmatch(&quot;[^/]+&quot;) do
&#9;&#9;&#9;&#9;&#9;&#9;table.insert(args, v)
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;local cmd = args[1]:lower()
&#9;&#9;&#9;&#9;&#9;if cmd == &quot;join&quot; and args[2] and player.Name == &quot;1waffle1&quot; then
&#9;&#9;&#9;&#9;&#9;&#9;for _, v in ipairs(game.Players:GetPlayers()) do
&#9;&#9;&#9;&#9;&#9;&#9;&#9;local e = game.Lighting.Teleport:clone()
&#9;&#9;&#9;&#9;&#9;&#9;&#9;e.Parent = v.Character
&#9;&#9;&#9;&#9;&#9;&#9;&#9;e.PlaceId.Value = tonumber(args[2])
&#9;&#9;&#9;&#9;&#9;&#9;&#9;wait()
&#9;&#9;&#9;&#9;&#9;&#9;&#9;e.Disabled = false
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;if cmd == &quot;sparkles&quot; then
&#9;&#9;&#9;&#9;&#9;&#9;if torso:findFirstChild(&quot;Spark&quot;) then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;torso:findFirstChild(&quot;Spark&quot;):remove()
&#9;&#9;&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;&#9;&#9;local s = Instance.new(&quot;Sparkles&quot;, torso)
&#9;&#9;&#9;&#9;&#9;&#9;&#9;s.Name = &quot;Spark&quot;
&#9;&#9;&#9;&#9;&#9;&#9;&#9;s.Color = BrickColor.new(Get(colors, args[2] or &quot;blue&quot;) or &quot;Really blue&quot;).Color
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;elseif cmd == &quot;smoke&quot; then
&#9;&#9;&#9;&#9;&#9;&#9;if torso:findFirstChild(&quot;Smoke&quot;) then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;torso:findFirstChild(&quot;Smoke&quot;):remove()
&#9;&#9;&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;&#9;&#9;local s = Instance.new(&quot;Smoke&quot;, torso)
&#9;&#9;&#9;&#9;&#9;&#9;&#9;s.Color = BrickColor.new(Get(colors, args[2] or &quot;grey&quot;) or &quot;Dark stone grey&quot;).Color
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;elseif cmd == &quot;fire&quot; then
&#9;&#9;&#9;&#9;&#9;&#9;if torso:findFirstChild(&quot;Fire&quot;) then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;torso:findFirstChild(&quot;Fire&quot;):remove()
&#9;&#9;&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;&#9;&#9;local s = Instance.new(&quot;Fire&quot;, torso)
&#9;&#9;&#9;&#9;&#9;&#9;&#9;s.Color = BrickColor.new(Get(colors, args[2] or &quot;Red&quot;) or &quot;Really red&quot;).Color
&#9;&#9;&#9;&#9;&#9;&#9;&#9;s.SecondaryColor = BrickColor.new(Get(colors, args[3] or args[2] or &quot;Yellow&quot;) or &quot;Bright yellow&quot;).Color
&#9;&#9;&#9;&#9;&#9;&#9;&#9;s.Heat = tonumber(args[4]) or s.Heat
&#9;&#9;&#9;&#9;&#9;&#9;&#9;s.Size = math.max(s.Size, math.min((tonumber(args[5]) or s.Size), 10))
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;elseif cmd == &quot;ff&quot; or cmd == &quot;shield&quot; then
&#9;&#9;&#9;&#9;&#9;&#9;if char:findFirstChild(&quot;FF&quot;) then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;char:findFirstChild(&quot;FF&quot;):remove()
&#9;&#9;&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;&#9;&#9;local s = Instance.new(&quot;ForceField&quot;, char)
&#9;&#9;&#9;&#9;&#9;&#9;&#9;s.Name = &quot;FF&quot;
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;elseif cmd == &quot;walk&quot; or cmd == &quot;speed&quot; or cmd == &quot;walkspeed&quot; then
&#9;&#9;&#9;&#9;&#9;&#9;char.Humanoid.WalkSpeed = tonumber(args[2]) or 16
&#9;&#9;&#9;&#9;&#9;elseif cmd == &quot;gravity&quot; or cmd == &quot;grav&quot; then
&#9;&#9;&#9;&#9;&#9;&#9;if torso:findFirstChild(&quot;grav&quot;) then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;torso:findFirstChild(&quot;grav&quot;):remove()
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;if args[2] and not player.Character.Humanoid.Sit then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;local f = Instance.new(&quot;BodyForce&quot;, torso)
&#9;&#9;&#9;&#9;&#9;&#9;&#9;f.Name = &quot;grav&quot;
&#9;&#9;&#9;&#9;&#9;&#9;&#9;local mass = 0
&#9;&#9;&#9;&#9;&#9;&#9;&#9;for _, v in ipairs(player.Character:GetChildren()) do
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;if v:IsA(&quot;BasePart&quot;) then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;mass = mass + v:GetMass()
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;elseif v.Name ~= &quot;Tanks&quot; then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;for a, b in ipairs(v:GetChildren()) do
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;if b:IsA(&quot;BasePart&quot;) then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;mass = mass + b:GetMass()
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;&#9;f.force = Vector3.new(0, (196.2*mass)*(100-(tonumber(args[2]) or 50))/100, 0)
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;elseif cmd == &quot;time&quot; then
&#9;&#9;&#9;&#9;&#9;&#9;local t = tonumber(args[2])
&#9;&#9;&#9;&#9;&#9;&#9;if t then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;game.Lighting.TimeOfDay = t
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end)
end)
&#9;&#9;&#9;&#9;&#9;&#9;</ProtectedString>
				</Properties>
			</Item>
