					<Item class="Script" referent="RBX3157">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script</string>
							<ProtectedString name="Source">wait(1)
local player = script.Parent.Parent.Parent.Parent.Parent

function Run()
&#9;if player.Character:findFirstChild(&quot;Tanks&quot;) then
&#9;&#9;script.Parent.Text = &quot;Waiting&quot;
&#9;&#9;player:WaitForDataReady()
&#9;&#9;script.Parent.Text = &quot;Saving&quot;
&#9;&#9;local ts = player.Character:findFirstChild(&quot;Tanks&quot;)
&#9;&#9;if ts then
&#9;&#9;&#9;local tank = ts:findFirstChild(&quot;Tank&quot;)
&#9;&#9;&#9;if tank then
&#9;&#9;&#9;&#9;shared.Save(player)
&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;script.Parent.Text = &quot;Saved.&quot;
&#9;else
&#9;&#9;script.Parent.Text = &quot;Need tank&quot;
&#9;end
&#9;player:WaitForDataReady()
&#9;if player:LoadNumber(&quot;Level&quot;) == 0 then
&#9;&#9;script.Parent.Text = &quot;Failed&quot;
&#9;&#9;wait(1)
&#9;&#9;Run()
&#9;end
end

script.Parent.MouseButton1Down:connect(function()
&#9;Run()
&#9;wait(2)
&#9;script.Parent.Text = &quot;SAVE&quot;
end)</ProtectedString>
						</Properties>
					</Item>
				</Item>
