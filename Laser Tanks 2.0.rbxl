				<Item class="LocalScript" referent="RBX4695">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">LocalScript</string>
						<ProtectedString name="Source">local player = script.Parent.Parent.Parent
wait(.5)

local parts = {}
local rings = {}
for _, v in ipairs(script.Parent:GetChildren()) do
&#9;if v:IsA(&quot;BasePart&quot;) and v.Name ~= &quot;Ring&quot; then
&#9;&#9;table.insert(parts, v)
&#9;elseif v.Name == &quot;Ring&quot; then
&#9;&#9;table.insert(rings, v)
&#9;end
&#9;if v:IsA(&quot;BasePart&quot;) then
&#9;&#9;if v.BrickColor == BrickColor.new(&quot;Bright yellow&quot;) then
&#9;&#9;&#9;v.BrickColor = player.PART1.Value
&#9;&#9;elseif v.BrickColor == BrickColor.new(&quot;Bright blue&quot;) then
&#9;&#9;&#9;v.BrickColor = player.PART2.Value
&#9;&#9;elseif v.BrickColor == BrickColor.new(&quot;Br. yellowish green&quot;) then
&#9;&#9;&#9;v.BrickColor = player.PART3.Value
&#9;&#9;end
&#9;end
end
for _, v in ipairs(parts) do
&#9;local b = parts[_+1]
&#9;if b then
&#9;&#9;local w = Instance.new(&quot;Weld&quot;, v)
&#9;&#9;w.Part0 = v
&#9;&#9;w.Part1 = b
&#9;&#9;w.C0 = v.CFrame:inverse()
&#9;&#9;w.C1 = b.CFrame:inverse()
&#9;end
&#9;v.Anchored = false
end
local welds = {}
for _, v in ipairs(rings) do
&#9;local w = Instance.new(&quot;Weld&quot;, v)
&#9;w.Part0 = v
&#9;w.Part1 = script.Parent.Tip
&#9;table.insert(welds, w)
&#9;v.Anchored = false
end
local spinmax = 30
Delay(0, function()
&#9;while true do
&#9;&#9;for i = 1, spinmax do
&#9;&#9;&#9;welds[1].C0 = CFrame.Angles(-math.rad(360/spinmax*i), 0, 0)
&#9;&#9;&#9;welds[2].C0 = CFrame.Angles(0, -math.rad(360/spinmax*i) + math.rad(90), 0)
&#9;&#9;&#9;welds[3].C0 = CFrame.Angles(math.rad(360/spinmax*i)+math.rad(45), 0, 0)
&#9;&#9;&#9;wait(3/spinmax)
&#9;&#9;end
&#9;end
end)
function fire(tank)
&#9;local laser = Instance.new(&quot;Part&quot;, player.Character)
&#9;laser.Anchored = true
&#9;laser.CanCollide = false
&#9;laser.formFactor = &quot;Custom&quot;
&#9;laser.TopSurface, laser.BottomSurface = &quot;Smooth&quot;, &quot;Smooth&quot;
&#9;laser.Size = Vector3.new(1.5, 1.5, (tank.Head.Position - script.Parent.Tip.Position).magnitude)
&#9;laser.CFrame = CFrame.new(script.Parent.Tip.Position:lerp(tank.Head.Position, .5), tank.Head.Position)
&#9;laser.BrickColor = player.PART2.Value
&#9;Delay(0, function()
&#9;&#9;for i = 0, 1, .1 do
&#9;&#9;&#9;laser.Transparency = i
&#9;&#9;&#9;wait(.1)
&#9;&#9;end
&#9;&#9;laser:remove()
&#9;end)
end

player.Character.Humanoid.MaxHealth = 400
wait(.1)
player.Character.Humanoid.Health = 400

local ok = true
script.Parent.Equipped:connect(function(mouse)
&#9;mouse.Button1Down:connect(function()
&#9;&#9;if ok then
&#9;&#9;&#9;if mouse.Target then
&#9;&#9;&#9;&#9;if mouse.Target.Parent:findFirstChild(&quot;CPU&quot;) then
&#9;&#9;&#9;&#9;&#9;local tank = mouse.Target.Parent
&#9;&#9;&#9;&#9;&#9;if tank.Health.Value &gt; 0 then
&#9;&#9;&#9;&#9;&#9;&#9;ok = false
&#9;&#9;&#9;&#9;&#9;&#9;fire(mouse.Target.Parent)
&#9;&#9;&#9;&#9;&#9;&#9;tank.Health.Value = tank.Health.Value - math.random(50, 100)
&#9;&#9;&#9;&#9;&#9;&#9;if tank.Health.Value &lt;= 0 then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;player.leaderstats.KOs.Value = player.leaderstats.KOs.Value + 1
&#9;&#9;&#9;&#9;&#9;&#9;&#9;player.leaderstats.Points.Value = player.leaderstats.Points.Value + tank.MaxHealth.Value/3
