							<ProtectedString name="Source">local player = script.Parent.Parent.Parent.Parent.Parent
repeat wait() until player:findFirstChild(&quot;leaderstats&quot;)
player:WaitForDataReady()
wait(.5)

if player.leaderstats.KOs.Value &lt;= 400 then
&#9;script.Parent.Visible = true
end
local t = false
script.Parent.MouseButton1Down:connect(function()
&#9;t = not t
&#9;if t then
&#9;&#9;player.Character:MoveTo(workspace.Newb.Position+Vector3.new(math.random(-20, 20), 20, math.random(-20, 20)))
&#9;&#9;script.Parent.Text = &quot;Back&quot;
&#9;else
&#9;&#9;player.Character:MoveTo(Vector3.new(math.random(-20, 20), 20, math.random(-20, 20)))
&#9;&#9;script.Parent.Text = &quot;Newb Zone&quot;
&#9;end
end)</ProtectedString>
