					<Item class="Script" referent="RBX4871">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script</string>
							<ProtectedString name="Source">local player = script.Parent.Parent.Parent.Parent.Parent

script.Parent.MouseButton1Down:connect(function()
&#9;for _, v in ipairs(player.Backpack:GetChildren()) do
&#9;&#9;v:remove()
&#9;end
&#9;for _, v in ipairs(player.Character:GetChildren()) do
&#9;&#9;if v:IsA(&quot;Tool&quot;) then
&#9;&#9;&#9;v:remove()
&#9;&#9;end
&#9;end
&#9;game.Lighting.Guns2:findFirstChild(script.Parent.Name):clone().Parent = player.Backpack
end)</ProtectedString>
						</Properties>
					</Item>
				</Item>
				<Item class="Script" referent="RBX4872">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">local player = script.Parent.Parent.Parent.Parent

for _, v in ipairs(game.Lighting.Guns2:GetChildren()) do
&#9;if player.leaderstats.KOs.Value &gt;= v.Cost.Value then
&#9;&#9;local e = script.Parent.Button:clone()
&#9;&#9;e.Parent = script.Parent
&#9;&#9;e.Visible = true
&#9;&#9;e.Name = v.Name
&#9;&#9;e.Text = v.Name
&#9;&#9;e.Position = UDim2.new(.1*(_-1), 0, 0, 0)
&#9;end
end
</ProtectedString>
					</Properties>
				</Item>
			</Item>
		</Item>
