				<Item class="Script" referent="RBX3987">
					<Properties>
						<bool name="Disabled">true</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Welder</string>
						<ProtectedString name="Source">wait(1)

function Connect(a, b)
&#9;local w = Instance.new(&quot;Weld&quot;, a)
&#9;w.Part0 = a
&#9;w.Part1 = b
&#9;w.C0 = a.CFrame:inverse()
&#9;w.C1 = b.CFrame:inverse()
&#9;return w
end

local top = {}
for _, v in ipairs(script.Parent.Parent:GetChildren()) do
&#9;if v.Name == &quot;Top&quot; then
&#9;&#9;table.insert(top, v)
&#9;--[[else
&#9;&#9;local b = script.Parent.Parent:GetChildren()[_+1]
&#9;&#9;if b then
&#9;&#9;&#9;if not b.Name:find(&quot;Top&quot;) then
&#9;&#9;&#9;&#9;Connect(v, b)
&#9;&#9;&#9;end
&#9;&#9;end]]
&#9;end
end
local welds = {}
for _, v in ipairs(top) do
&#9;local b = top[_+1]
&#9;if b then
&#9;&#9;table.insert(welds, Connect(v, b))
&#9;end
end
for _, v in ipairs(top) do
&#9;Connect(v, script.Parent.Parent.Top1)
end
local W = Connect(script.Parent.Parent.Top1, script.Parent)

wait(2)

while wait() do
&#9;local max = 360
&#9;for i = 1, max do
&#9;&#9;W.C0 = script.Parent.Parent.Top1.CFrame:inverse()*CFrame.Angles(0, math.rad(i*(360/max)), 0)
&#9;&#9;wait()
&#9;end
end

</ProtectedString>
					</Properties>
