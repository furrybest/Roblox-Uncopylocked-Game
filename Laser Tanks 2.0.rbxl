				</Item>
				<Item class="Script" referent="RBX3329">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">local main1 = script.Parent.Parent.Main
local info = script.Parent.Parent.Info
local player = main1.Parent.Parent.Parent
local special = main1.Special
local check = special.Check1
local yLen = 15
local xLen = .1
main1.Player.Size = UDim2.new(main1.Player.Size.X.Scale, main1.Player.Size.X.Offset, 1/yLen, main1.Player.Size.Y.Offset)

for x = 0, 1, xLen do
&#9;local e = Instance.new(&quot;ImageLabel&quot;, special)
&#9;e.Name = &quot;Line&quot;..(x/xLen + 1)
&#9;e.BorderSizePixel = 0
&#9;e.BackgroundColor = BrickColor.new(&quot;Institutional white&quot;)
&#9;e.Size = UDim2.new(0,1,1,0)
&#9;e.Position = UDim2.new(x,0,0,0)
end

function Load()
&#9;for _, v in ipairs(main1:GetChildren()) do
&#9;&#9;if v.Visible and v.ClassName == &quot;TextButton&quot; then
&#9;&#9;&#9;v:remove()
&#9;&#9;end
&#9;end
&#9;local stats = {}
&#9;for _, v in ipairs(workspace.Leaderboard:GetChildren()) do
&#9;&#9;if (game.Players:findFirstChild(v.Name) and check.Text == &quot;X&quot;) or check.Text ~= &quot;X&quot; then
&#9;&#9;&#9;local name = &quot;Guest &quot;..math.random(1, 9999)
&#9;&#9;&#9;local inv = 0
&#9;&#9;&#9;local code = &quot;0000&quot;
&#9;&#9;&#9;pcall(function() name = v.Name end)
&#9;&#9;&#9;pcall(function() inv = v.Invites.Value end)
&#9;&#9;&#9;pcall(function() code = v.Code.Value end)
&#9;&#9;&#9;table.insert(stats, {[&quot;Name&quot;]=name, [&quot;Value&quot;]=inv, [&quot;Invites&quot;]=inv, [&quot;Code&quot;]=code})
&#9;&#9;end
&#9;end
&#9;if #stats &gt; 1 then
&#9;&#9;repeat
&#9;&#9;&#9;local n = 0
&#9;&#9;&#9;for i = 1, #stats-1 do
&#9;&#9;&#9;&#9;if stats[i].Value &lt; stats[i+1].Value then
&#9;&#9;&#9;&#9;&#9;local a, b = stats[i], stats[i+1]
&#9;&#9;&#9;&#9;&#9;stats[i] = b
&#9;&#9;&#9;&#9;&#9;stats[i+1] = a
&#9;&#9;&#9;&#9;&#9;n=n+1
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;until n == 0
&#9;end
&#9;local debug = {}
&#9;for _, v in ipairs(stats) do
&#9;&#9;if v then
&#9;&#9;&#9;table.insert(debug, v)
&#9;&#9;end
&#9;end
&#9;stats = debug
&#9;for x = 0, math.floor(#stats/yLen) do
&#9;&#9;for y = 0, yLen-1 do
&#9;&#9;&#9;local ind = (x*yLen) + y + 1
&#9;&#9;&#9;local stat = stats[ind]
&#9;&#9;&#9;if stat then
&#9;&#9;&#9;&#9;local e = main1.Player:clone()
&#9;&#9;&#9;&#9;if game.Players:findFirstChild(stat.Name) then
&#9;&#9;&#9;&#9;&#9;e.TextStrokeColor3 = BrickColor.new(&quot;Really blue&quot;).Color
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;if stat.Name == player.Name then
&#9;&#9;&#9;&#9;&#9;e.TextStrokeColor3 = BrickColor.new(&quot;Really red&quot;).Color
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;e.Parent = main1
&#9;&#9;&#9;&#9;e.Name = stat.Name
&#9;&#9;&#9;&#9;e.Text = &quot;#&quot;..ind..&quot; &quot;..stat.Name
&#9;&#9;&#9;&#9;e.Visible = true
&#9;&#9;&#9;&#9;e.Position = UDim2.new(x*xLen,0,y*(1/yLen)*(1-.15),0)
&#9;&#9;&#9;&#9;e.MouseButton1Down:connect(function()
&#9;&#9;&#9;&#9;&#9;pcall(function()
&#9;&#9;&#9;&#9;&#9;&#9;info.Visible = true
&#9;&#9;&#9;&#9;&#9;&#9;info.Invites.Text = &quot;Invites: &quot;..stat.Invites
&#9;&#9;&#9;&#9;&#9;&#9;info.Code.Text = &quot;Code: &quot;..stat.Code
&#9;&#9;&#9;&#9;&#9;&#9;info.User.Text = stat.Name
&#9;&#9;&#9;&#9;&#9;&#9;local name = stat.Name
&#9;&#9;&#9;&#9;&#9;&#9;if name:find(&quot;Guest &quot;) then name = &quot;ROBLOX&quot; end
&#9;&#9;&#9;&#9;&#9;&#9;info.Player.Image = &quot;http://www.roblox.com/Thumbs/Avatar.ashx?x=100&amp;y=100&amp;Format=Png&amp;username=&quot;..name
&#9;&#9;&#9;&#9;&#9;end)
&#9;&#9;&#9;&#9;end)
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end

script.Parent.MouseButton1Down:connect(function()
&#9;main1.Visible = not main1.Visible
&#9;if main1.Visible then
&#9;&#9;script.Parent.Text = &quot;Close&quot;
&#9;&#9;script.Parent.Style = &quot;RobloxButtonDefault&quot;
&#9;&#9;Load()
&#9;else
&#9;&#9;script.Parent.Text = &quot;Top Inviters&quot;
&#9;&#9;script.Parent.Style = &quot;RobloxButton&quot;
&#9;&#9;info.Visible = false
&#9;&#9;for _, v in ipairs(main1:GetChildren()) do
