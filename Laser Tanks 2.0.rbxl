								<ProtectedString name="Source">local check = false

script.Parent.MouseButton1Down:connect(function()
&#9;check = not check
&#9;if check then
&#9;&#9;script.Parent.Text = &quot;X&quot;
&#9;else
&#9;&#9;script.Parent.Text = &quot;&quot;
&#9;end
&#9;script.Parent.Parent.Parent.Parent.Leaderboard.Reload.Value = true
end)</ProtectedString>
