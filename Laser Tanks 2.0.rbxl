							<string name="Name">LocalScript</string>
							<ProtectedString name="Source">local player = script.Parent.Parent.Parent.Parent.Parent
local cam = workspace.CurrentCamera

script.Parent.Parent.Changed:connect(function()
&#9;if script.Parent.Parent.Visible then
&#9;&#9;while script.Parent.Parent.Visible do
&#9;&#9;&#9;if cam.CameraSubject ~= player.Character then
&#9;&#9;&#9;&#9;workspace.CurrentCamera.CoordinateFrame = CFrame.new(workspace.ShopCam.Head.Position)
&#9;&#9;&#9;&#9;workspace.CurrentCamera.Focus = CFrame.new(workspace.tPos.Position-Vector3.new(20, 20, 0))
&#9;&#9;&#9;end
&#9;&#9;&#9;wait(.2)
&#9;&#9;end
&#9;end
end)

script.Parent.MouseButton1Down:connect(function()
&#9;cam.CameraSubject = player.Character
&#9;cam.CameraType = &quot;Custom&quot;
&#9;for _, v in ipairs(cam:GetChildren()) do
&#9;&#9;v:remove()
&#9;end
&#9;script.Parent.Parent.Visible = false
end)</ProtectedString>
