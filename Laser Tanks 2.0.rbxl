						<Item class="Script" referent="RBX3283">
							<Properties>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">Script</string>
								<ProtectedString name="Source">local player = script.Parent.Parent.Parent.Parent.Parent.Parent

script.Parent.MouseButton1Down:connect(function()
&#9;player.Character.Torso.CFrame = workspace.Arena.Center.CFrame + Vector3.new(0, 10, 0)
&#9;player.Backpack.Tank:remove()
&#9;pcall(function()
&#9;&#9;player.Character.Tanks:remove()
&#9;end)
&#9;local l, m = -1, nil
&#9;for _, v in ipairs(game.Lighting.Guns:GetChildren()) do
&#9;&#9;if v.Cost.Value &gt; l and player.leaderstats.KOs.Value &gt;= v.Cost.Value then
&#9;&#9;&#9;l = v.Cost.Value
&#9;&#9;&#9;m = v
&#9;&#9;end
&#9;end
&#9;if m then
&#9;&#9;m:clone().Parent = player.Backpack
&#9;end
&#9;for _, v in ipairs(player.PlayerGui.ScreenGui:GetChildren()) do
&#9;&#9;pcall(function()
&#9;&#9;&#9;v.Visible = false
&#9;&#9;end)
&#9;end
&#9;pcall(function()
&#9;&#9;player.Character.Humanoid.MaxHealth = 100
&#9;end)
&#9;game.Lighting.Arena:clone().Parent = player.PlayerGui
end)</ProtectedString>
							</Properties>
						</Item>
					</Item>
				</Item>
