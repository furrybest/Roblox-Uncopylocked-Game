				<Item class="Script" referent="RBX3297">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">local idea = script.Parent.Parent.Idea
local read = script.Parent.Parent.IdeasRead
local create = script.Parent.Parent.IdeasCreate

script.Parent.Read.MouseButton1Down:connect(function()
&#9;read.Visible = true
&#9;for _, v in ipairs(read:GetChildren()) do
&#9;&#9;if v.Name == &quot;Idea&quot; then
&#9;&#9;&#9;if v.Visible then
&#9;&#9;&#9;&#9;v:remove()
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
&#9;for _, v in ipairs(workspace.Ideas:GetChildren()) do
&#9;&#9;local e = read.Idea:clone()
&#9;&#9;e.Parent = read
&#9;&#9;e.Text = v.Name..&quot; (&quot;..v.Value.Value..&quot;)&quot;
&#9;&#9;e.Position = UDim2.new(0,0,.05*(_-1),0)
&#9;&#9;e.MouseButton1Down:connect(function()
&#9;&#9;&#9;idea.Visible = true
&#9;&#9;&#9;idea.Area.Text = v.Value
&#9;&#9;&#9;idea.Subject.Text = v.Name
&#9;&#9;&#9;idea.Yes.MouseButton1Down:connect(function()
&#9;&#9;&#9;&#9;local n = workspace.Ideas:findFirstChild(idea.Subject.Text)
&#9;&#9;&#9;&#9;n.Support.Value = n.Support.Value + 1
&#9;&#9;&#9;end)
&#9;&#9;&#9;idea.No.MouseButton1Down:connect(function()
&#9;&#9;&#9;&#9;local n = workspace.Ideas:findFirstChild(idea.Subject.Text)
&#9;&#9;&#9;&#9;n.Reject.Value = n.Reject.Value + 1
&#9;&#9;&#9;end)
&#9;&#9;&#9;read.Visible = false
&#9;&#9;end)
&#9;end
&#9;script.Parent.Visible = false
end)
script.Parent.Create.MouseButton1Down:connect(function()
&#9;create.Visible = true
&#9;create.Subject.Text = &quot;[ Subject ]&quot;
&#9;create.Body.Text = &quot;[ Idea ]&quot;
&#9;create.Submit.MouseButton1Down:connect(function()
&#9;&#9;if create.Subject.Text ~= &quot;[ Subject ]&quot; and create.Body.Text ~= &quot;[ Idea ]&quot; and not workspace.Ideas:findFirstChild(create.Subject.Text) then
&#9;&#9;&#9;local n = Instance.new(&quot;StringValue&quot;, workspace.Ideas)
&#9;&#9;&#9;n.Name = create.Subject.Text
&#9;&#9;&#9;n.Value = create.Body.Text
&#9;&#9;&#9;local m = Instance.new(&quot;IntValue&quot;, n)
&#9;&#9;&#9;workspace.IDEAS.Value = workspace.IDEAS.Value+1
&#9;&#9;&#9;m.Value = workspace.IDEAS.Value
&#9;&#9;&#9;local o = Instance.new(&quot;IntValue&quot;, n)
&#9;&#9;&#9;o.Name = &quot;Support&quot;
&#9;&#9;&#9;local p = Instance.new(&quot;IntValue&quot;, n)
&#9;&#9;&#9;p.Name = &quot;Reject&quot;
&#9;&#9;end
&#9;&#9;create.Visible = false
&#9;&#9;script.Parent.Visible = true
&#9;end)
&#9;create.Cancel.MouseButton1Down:connect(function()
&#9;&#9;script.Parent.Visible = false
&#9;end)
end)</ProtectedString>
					</Properties>
				</Item>
			</Item>
