					<Item class="LocalScript" referent="RBX3245">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">LocalScript</string>
							<ProtectedString name="Source">local player = script.Parent.Parent.Parent.Parent.Parent
repeat wait(.1) until player:findFirstChild(&quot;leaderstats&quot;)
repeat wait(.1) until player.Character
repeat wait(.1) until player.Character:findFirstChild(&quot;Tanks&quot;)
local p1, p2, p3 = player.PART1, player.PART2, player.PART3
local cam = workspace.CurrentCamera
local color = script.Parent.Parent.Color

function Spin(tank)
&#9;for _, v in ipairs(tank:GetChildren()) do
&#9;&#9;if v:IsA(&quot;BasePart&quot;) then
&#9;&#9;&#9;v.CFrame = (tank.Bottom.CFrame * CFrame.Angles(0, -.03, 0)):toWorldSpace(tank.Bottom.CFrame:toObjectSpace(v.CFrame))
&#9;&#9;end
&#9;end
end

function Go()
&#9;for _, v in ipairs(script.Parent:GetChildren()) do
&#9;&#9;if v ~= script then
&#9;&#9;&#9;v:remove()
&#9;&#9;end
&#9;end
&#9;local tank = player.Character.Tanks.Tank
&#9;local t = nil
&#9;if tank then
&#9;&#9;local t = tank:clone()
&#9;&#9;for _, v in ipairs(t:GetChildren()) do
&#9;&#9;&#9;if not v:IsA(&quot;BasePart&quot;) then
&#9;&#9;&#9;&#9;v:remove()
&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;v.Anchored = true
&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;t.Parent = cam
&#9;&#9;local p = {}
&#9;&#9;for _, v in ipairs(player.Character.Tanks:GetChildren()) do
&#9;&#9;&#9;for a, b in ipairs(v:GetChildren()) do
&#9;&#9;&#9;&#9;if b:IsA(&quot;BasePart&quot;) then
&#9;&#9;&#9;&#9;&#9;table.insert(p, b)
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;for _, v in ipairs(t:GetChildren()) do
&#9;&#9;&#9;if v:IsA(&quot;BasePart&quot;) then
&#9;&#9;&#9;&#9;table.insert(p, v)
&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;t:MoveTo(workspace.tPos.Position)
&#9;&#9;for x = 0, 7 do
&#9;&#9;&#9;for y = 0, 7 do
&#9;&#9;&#9;&#9;local c = Instance.new(&quot;TextButton&quot;, script.Parent)
&#9;&#9;&#9;&#9;c.Name = &quot;Color&quot;
&#9;&#9;&#9;&#9;c.Size = UDim2.new(1/8, 0, 1/8, 0)
&#9;&#9;&#9;&#9;c.Position = UDim2.new(1/8*x, 0, 1/8*y, 0)
&#9;&#9;&#9;&#9;c.BackgroundColor = BrickColor.palette(x+y*8)
&#9;&#9;&#9;&#9;c.Text = &quot;&quot;
&#9;&#9;&#9;&#9;c.BorderSizePixel = 0
&#9;&#9;&#9;&#9;c.MouseButton1Down:connect(function()
&#9;&#9;&#9;&#9;&#9;if color.Text == &quot;PART1&quot; then
&#9;&#9;&#9;&#9;&#9;&#9;p1.Value = c.BackgroundColor
&#9;&#9;&#9;&#9;&#9;&#9;for _, v in ipairs(p) do
&#9;&#9;&#9;&#9;&#9;&#9;&#9;if v:findFirstChild(&quot;PART1&quot;) then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;v.BrickColor = c.BackgroundColor
&#9;&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;elseif color.Text == &quot;PART2&quot; then
&#9;&#9;&#9;&#9;&#9;&#9;p2.Value = c.BackgroundColor
&#9;&#9;&#9;&#9;&#9;&#9;for _, v in ipairs(p) do
&#9;&#9;&#9;&#9;&#9;&#9;&#9;if v:findFirstChild(&quot;PART2&quot;) then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;v.BrickColor = c.BackgroundColor
&#9;&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;elseif color.Text == &quot;PART3&quot; then
&#9;&#9;&#9;&#9;&#9;&#9;p3.Value = c.BackgroundColor
&#9;&#9;&#9;&#9;&#9;&#9;for _, v in ipairs(p) do
&#9;&#9;&#9;&#9;&#9;&#9;&#9;if v:findFirstChild(&quot;PART3&quot;) then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;v.BrickColor = c.BackgroundColor
&#9;&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end)
&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;Delay(0, function()
&#9;&#9;&#9;while t do
&#9;&#9;&#9;&#9;Spin(t)
&#9;&#9;&#9;&#9;wait()
&#9;&#9;&#9;end
&#9;&#9;end)
&#9;end
end

local last = false
while wait(1) do
&#9;pcall(function()
&#9;&#9;if script.Parent.Parent.Visible ~= last then
&#9;&#9;&#9;last = script.Parent.Parent.Visible
&#9;&#9;&#9;if last then
&#9;&#9;&#9;&#9;Go()
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end)
end
</ProtectedString>
