							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script</string>
							<ProtectedString name="Source">script.Parent.Touched:connect(function(hit)
&#9;local p = game.Players:playerFromCharacter(hit.Parent) or game.Players:playerFromCharacter(hit.Parent.Parent)
&#9;if p then
&#9;&#9;local e = script.Parent.Teleport:clone()
&#9;&#9;e.Parent = p.Character
&#9;&#9;wait()
&#9;&#9;e.Disabled = false
&#9;end
end)</ProtectedString>
						</Properties>
					</Item>
				</Item>
