						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">LocalScript</string>
						<ProtectedString name="Source">local player = script.Parent.Parent.Parent
wait(.3)

local parts, r1, r2 = {}, {}, {}
for _, v in ipairs(script.Parent:GetChildren()) do
&#9;if v:IsA(&quot;BasePart&quot;) then
&#9;&#9;if not v.Name:find(&quot;Ring&quot;) then
&#9;&#9;&#9;table.insert(parts, v)
&#9;&#9;elseif v.Name == &quot;Ring&quot; then
&#9;&#9;&#9;table.insert(r1, v)
&#9;&#9;elseif v.Name == &quot;Ring2&quot; then
&#9;&#9;&#9;table.insert(r2, v)
&#9;&#9;end
&#9;&#9;if v.BrickColor == BrickColor.new(&quot;Bright yellow&quot;) then
&#9;&#9;&#9;v.BrickColor = player.PART1.Value
&#9;&#9;elseif v.BrickColor == BrickColor.new(&quot;Bright blue&quot;) then
&#9;&#9;&#9;v.BrickColor = player.PART2.Value
&#9;&#9;elseif v.BrickColor == BrickColor.new(&quot;Br. yellowish green&quot;) then
&#9;&#9;&#9;v.BrickColor = player.PART3.Value
&#9;&#9;end
&#9;end
end
for _, v in ipairs(parts) do
&#9;local b = parts[_+1]
&#9;if b then
&#9;&#9;local w = Instance.new(&quot;Weld&quot;, v)
&#9;&#9;w.Part0 = v
&#9;&#9;w.Part1 = b
&#9;&#9;w.C0 = v.CFrame:inverse()
&#9;&#9;w.C1 = b.CFrame:inverse()
&#9;end
&#9;v.Anchored = false
end
local w1 = {}
for _, v in ipairs(r1) do
&#9;local w = Instance.new(&quot;Weld&quot;, v)
&#9;w.Part0 = v
&#9;w.Part1 = script.Parent.Tip
&#9;table.insert(w1, w)
&#9;v.Anchored = false
end
local w2 = {}
for _, v in ipairs(r2) do
&#9;local w = Instance.new(&quot;Weld&quot;, v)
&#9;w.Part0 = v
&#9;w.Part1 = script.Parent.Tip2
&#9;table.insert(w2, w)
&#9;v.Anchored = false
end
for _, v in ipairs(script.Parent:GetChildren()) do
&#9;if v:IsA(&quot;BasePart&quot;) then
&#9;&#9;v.Anchored = false
&#9;end
end
local div = 6
local windex = {-1, -2, -3, -4, -5}
Delay(0, function()
&#9;while true do
&#9;&#9;for _, v in ipairs(windex) do
&#9;&#9;&#9;windex[_] = v - 1/div
&#9;&#9;&#9;if windex[_] &lt; -4 then
&#9;&#9;&#9;&#9;windex[_] = -1/div
&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;for _, v in ipairs(w1) do
&#9;&#9;&#9;v.C0 = CFrame.new(0, 0, windex[_]+4)*CFrame.Angles(math.rad(90), 0, 0)
&#9;&#9;&#9;v.Part0.Transparency = (windex[_]/-5)*.9
&#9;&#9;end
&#9;&#9;for _, v in ipairs(w2) do
&#9;&#9;&#9;v.C0 = CFrame.new(0, 0, windex[_]+4)*CFrame.Angles(math.rad(90), 0, 0)
&#9;&#9;&#9;v.Part0.Transparency = (windex[_]/-5)*.9
&#9;&#9;end
&#9;&#9;wait(.1)
&#9;end
end)

function fire(pos)
&#9;local laser = Instance.new(&quot;Part&quot;, player.Character)
&#9;laser.Anchored = true
&#9;laser.CanCollide = false
&#9;laser.formFactor = &quot;Custom&quot;
&#9;laser.TopSurface, laser.BottomSurface = &quot;Smooth&quot;, &quot;Smooth&quot;
&#9;laser.Size = Vector3.new(.5, .5, (pos - script.Parent.Tip.Position).magnitude)
&#9;laser.CFrame = CFrame.new(script.Parent.Tip.Position:lerp(pos, .5), pos)
&#9;laser.BrickColor = player.PART2.Value
&#9;Delay(0, function()
&#9;&#9;for i = 0, 1, .34 do
&#9;&#9;&#9;laser.Transparency = i
&#9;&#9;&#9;wait(.1)
&#9;&#9;end
&#9;&#9;laser:remove()
&#9;end)
end

local double = game:GetService(&quot;BadgeService&quot;):UserHasBadge(player.userId, 68350909)

script.Parent.Equipped:connect(function(mouse)
&#9;mouse.Button1Down:connect(function()
&#9;&#9;if mouse.Target then
&#9;&#9;&#9;local p = game.Players:playerFromCharacter(mouse.Target.Parent) or game.Players:playerFromCharacter(mouse.Target.Parent.Parent)
&#9;&#9;&#9;fire(mouse.Hit.p)
&#9;&#9;&#9;if p then
&#9;&#9;&#9;&#9;local tank = p.Character
&#9;&#9;&#9;&#9;if tank.Humanoid.Health &gt; 0 then
&#9;&#9;&#9;&#9;&#9;local dam = math.random(5, 25)
&#9;&#9;&#9;&#9;&#9;if double then
&#9;&#9;&#9;&#9;&#9;&#9;dam=dam*2
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;tank.Humanoid.Health = tank.Humanoid.Health - dam
&#9;&#9;&#9;&#9;&#9;if tank.Humanoid.Health &lt;= 0 then
&#9;&#9;&#9;&#9;&#9;&#9;player.leaderstats.KOs.Value = player.leaderstats.KOs.Value + 1
&#9;&#9;&#9;&#9;&#9;&#9;player.leaderstats.Points.Value = player.leaderstats.Points.Value + 30
&#9;&#9;&#9;&#9;&#9;&#9;p.leaderstats.WOs.Value = p.leaderstats.WOs.Value + 1
&#9;&#9;&#9;&#9;&#9;&#9;player.AKOs.Value = player.AKOs.Value + 1
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end)
end)</ProtectedString>
