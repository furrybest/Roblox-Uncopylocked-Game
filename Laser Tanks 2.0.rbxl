					<Item class="Script" referent="RBX3173">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script</string>
							<ProtectedString name="Source">local player = script.Parent.Parent.Parent.Parent.Parent
local al = player:findFirstChild(&quot;Allies&quot;) or Instance.new(&quot;Model&quot;, player)
al.Name = &quot;Allies&quot;
local rq = player:findFirstChild(&quot;Request&quot;) or Instance.new(&quot;Model&quot;, player)
rq.Name = &quot;Request&quot;
local allies = player.PlayerGui.ScreenGui.Allies

function Get(tab, obj)
&#9;for _, v in ipairs(tab) do
&#9;&#9;if v == obj  then
&#9;&#9;&#9;return _, v
&#9;&#9;end
&#9;end
end

script.Parent.MouseButton1Down:connect(function()
&#9;allies.Visible = not allies.Visible
&#9;if allies.Visible then
&#9;&#9;for _, v in ipairs(allies:GetChildren()) do
&#9;&#9;&#9;if v.Visible then
&#9;&#9;&#9;&#9;v:remove()
&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;local p = {}
&#9;&#9;local a = {}
&#9;&#9;local rs = {}
&#9;&#9;local rp = {}
&#9;&#9;for _, v in ipairs(game.Players:GetChildren()) do
&#9;&#9;&#9;if v ~= player then
&#9;&#9;&#9;&#9;table.insert(p, v)
&#9;&#9;&#9;&#9;if player.Allies:findFirstChild(v.Name) then
&#9;&#9;&#9;&#9;&#9;table.insert(a, v)
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;if v.Request:findFirstChild(player.Name) then
&#9;&#9;&#9;&#9;&#9;table.insert(rs, v)
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;if player.Request:findFirstChild(v.Name) then
&#9;&#9;&#9;&#9;&#9;table.insert(rp, v)
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;for _, v in ipairs(p) do
&#9;&#9;&#9;local e = allies.Player:clone()
&#9;&#9;&#9;local e_ = allies.Player_:clone()
&#9;&#9;&#9;e.Parent = allies
&#9;&#9;&#9;e_.Parent = allies
&#9;&#9;&#9;e.Visible = true
&#9;&#9;&#9;e_.Visible = true
&#9;&#9;&#9;e.Position = UDim2.new(0, 0, .1*(_-1), 0)
&#9;&#9;&#9;e_.Position = UDim2.new(.2, 0, .1*(_-1), 0)
&#9;&#9;&#9;e.Text = v.Name
&#9;&#9;&#9;local txt = {&quot;Ally&quot;, &quot;Awaiting their approval&quot;, &quot;Awaiting your approval&quot;, &quot;Enemy&quot;}
&#9;&#9;&#9;if Get(a, v) then
&#9;&#9;&#9;&#9;e_.Text = txt[1]
&#9;&#9;&#9;elseif Get(rs, v) then
&#9;&#9;&#9;&#9;e_.Text = txt[2]
&#9;&#9;&#9;elseif Get(rp, v) then
&#9;&#9;&#9;&#9;e_.Text = txt[3]
&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;e_.Text = txt[4]
&#9;&#9;&#9;end
&#9;&#9;&#9;e.MouseButton1Down:connect(function()
&#9;&#9;&#9;&#9;if e_.Text == txt[1] then
&#9;&#9;&#9;&#9;&#9;pcall(function()
&#9;&#9;&#9;&#9;&#9;&#9;v.Allies:findFirstChild(player.Name):remove()
&#9;&#9;&#9;&#9;&#9;end)
&#9;&#9;&#9;&#9;&#9;pcall(function()
&#9;&#9;&#9;&#9;&#9;&#9;player.Allies:findFirstChild(v.Name):remove()
&#9;&#9;&#9;&#9;&#9;end)
&#9;&#9;&#9;&#9;&#9;e_.Text = txt[4]
&#9;&#9;&#9;&#9;elseif e_.Text == txt[2] then
&#9;&#9;&#9;&#9;&#9;pcall(function()
&#9;&#9;&#9;&#9;&#9;&#9;v.Request:findFirstChild(player.Name):remove()
&#9;&#9;&#9;&#9;&#9;end)
&#9;&#9;&#9;&#9;&#9;e_.Text = txt[4]
&#9;&#9;&#9;&#9;elseif e_.Text == txt[3] then
&#9;&#9;&#9;&#9;&#9;local a, b = Instance.new(&quot;IntValue&quot;, player.Allies), Instance.new(&quot;IntValue&quot;, v.Allies)
&#9;&#9;&#9;&#9;&#9;a.Name, b.Name = v.Name, player.Name
&#9;&#9;&#9;&#9;&#9;pcall(function() player.Request:findFirstChild(v.Name):remove() end)
&#9;&#9;&#9;&#9;&#9;pcall(function() v.Request:findFirstChild(player.Name):remove() end)
&#9;&#9;&#9;&#9;elseif e_.Text == txt[4] then
&#9;&#9;&#9;&#9;&#9;local a = Instance.new(&quot;IntValue&quot;, v.Request)
&#9;&#9;&#9;&#9;&#9;a.Name = player.Name
&#9;&#9;&#9;&#9;&#9;e_.Text = txt[2]
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end)
&#9;&#9;end
&#9;end
end)</ProtectedString>
