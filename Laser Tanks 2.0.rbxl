			<Item class="Script" referent="RBX3017">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">LBoard</string>
					<ProtectedString name="Source">local new = Instance.new

local l = workspace:findFirstChild(&quot;Leaderboard&quot;) or new(&quot;Model&quot;, workspace)
l.Name = &quot;Leaderboard&quot;

function Save(v, data)
&#9;Delay(0, function()
&#9;&#9;v:WaitForDataReady()
&#9;&#9;v:SaveNumber(&quot;Invites&quot;, v.Invites.Value)
&#9;&#9;v:SaveString(&quot;topinviters&quot;, data)
&#9;end)
end

function shared.Clear(v)
&#9;Delay(0, function()
&#9;&#9;v:WaitForDataReady()
&#9;&#9;v:SaveNumber(&quot;Invites&quot;, 0)
&#9;&#9;v:SaveString(&quot;topinviters&quot;, &quot;&quot;)
&#9;end)
end

function shared.Fix(player)
&#9;local k = player:findFirstChild(&quot;Invites&quot;) or new(&quot;IntValue&quot;, player)
&#9;k.Name = &quot;Invites&quot;
&#9;local n = l:findFirstChild(player.Name) or new(&quot;Model&quot;, l)
&#9;n.Name = player.Name
&#9;local K = n:findFirstChild(&quot;Invites&quot;) or new(&quot;IntValue&quot;, n)
&#9;K.Name = &quot;Invites&quot;
&#9;local C = n:findFirstChild(&quot;Code&quot;) or new(&quot;StringValue&quot;, n)
&#9;C.Name = &quot;Code&quot;
&#9;C.Value = (&quot;0000&quot;..tostring(player.userId)):sub(-4)
&#9;local S = n:findFirstChild(&quot;Subtract&quot;) or new(&quot;IntValue&quot;, n)
&#9;S.Name = &quot;Subtract&quot;
end

Fix = shared.Fix
local reloading = false

function Update()
&#9;if reloading then return end
&#9;print(&quot;Updated&quot;)
&#9;for _, v in ipairs(game.Players:GetPlayers()) do
&#9;&#9;Fix(v)
&#9;&#9;local n = l:findFirstChild(v.Name)
&#9;&#9;k = v.Invites.Value/7
&#9;&#9;n.Invites.Value = k
&#9;&#9;local C = n:findFirstChild(&quot;Code&quot;) or new(&quot;IntValue&quot;, n)
&#9;&#9;C.Name = &quot;Code&quot;
&#9;&#9;C.Value = (&quot;0000&quot;..tostring(v.userId)):sub(-4)
&#9;&#9;local S = n:findFirstChild(&quot;Subtract&quot;) or new(&quot;IntValue&quot;, n)
&#9;&#9;S.Name = &quot;Subtract&quot;
&#9;&#9;v:WaitForDataReady()
&#9;&#9;local data = v:LoadString(&quot;topinviters&quot;)
&#9;&#9;local data2 = {}
&#9;&#9;for a in data:gmatch(&quot;[^\n]+&quot;) do
&#9;&#9;&#9;table.insert(data2, {tonumber(a)})
&#9;&#9;&#9;for b in tostring(a):gmatch(&quot;[^/]+&quot;) do
&#9;&#9;&#9;&#9;table.insert(data2[#data2], tonumber(b) or b)
&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;for i, c in ipairs(data2) do
&#9;&#9;&#9;if c[1] and c[2] and c[3] then
&#9;&#9;&#9;&#9;local p = l:findFirstChild(c[1]) or new(&quot;Model&quot;, l)
&#9;&#9;&#9;&#9;p.Name = c[1]
&#9;&#9;&#9;&#9;local k = p:findFirstChild(&quot;Invites&quot;) or new(&quot;IntValue&quot;, p)
&#9;&#9;&#9;&#9;k.Name = &quot;Invites&quot;
&#9;&#9;&#9;&#9;if k.Value &lt; c[2] then k.Value = c[2] end
&#9;&#9;&#9;&#9;local C = p:findFirstChild(&quot;Code&quot;) or new(&quot;StringValue&quot;, p)
&#9;&#9;&#9;&#9;C.Name = &quot;Code&quot;
&#9;&#9;&#9;&#9;if (#C.Value == 0 or C.Value == &quot;0000&quot;) then C.Value = c[3] end
&#9;&#9;&#9;&#9;local S = p:findFirstChild(&quot;Subtract&quot;) or new(&quot;IntValue&quot;, p)
&#9;&#9;&#9;&#9;S.Name = &quot;Subtract&quot;
&#9;&#9;&#9;&#9;if c[4] then
&#9;&#9;&#9;&#9;&#9;if S.Value &lt; c[4] then k.Value = c[4] end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
&#9;for _, v in ipairs(game.Players:GetPlayers()) do
&#9;&#9;local data = &quot;&quot;
&#9;&#9;for i, c in ipairs(l:GetChildren()) do
&#9;&#9;&#9;if i &lt;= 150 then
&#9;&#9;&#9;&#9;if data ~= &quot;&quot; then data = data..&quot;\n&quot; end
&#9;&#9;&#9;&#9;data = data..c.Name..&quot;/&quot;..c.Invites.Value..&quot;/&quot;..(c.Code.Value or &quot;0000&quot;)..&quot;/&quot;..c.Subtract.Value
&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;print(data)
&#9;&#9;Save(v, data)
&#9;end
end
function shared.Update()
&#9;Update()
end

game.Players.PlayerAdded:connect(function(player)
&#9;Fix(player)
&#9;player:WaitForDataReady()
&#9;player.Invites.Value = player:LoadNumber(&quot;Invites&quot;) or 0
&#9;wait()
&#9;Delay(0, function() Update() end)
end)


function Reload()
&#9;local stats = {}
&#9;for _, v in ipairs(l:GetChildren()) do
&#9;&#9;local name = &quot;Guest &quot;..math.random(1, 9999)
&#9;&#9;local inv = 0
&#9;&#9;local code = &quot;0000&quot;
&#9;&#9;local sub = 0
&#9;&#9;pcall(function() name = v.Name end)
&#9;&#9;pcall(function() inv = v.Invites.Value end)
&#9;&#9;pcall(function() code = v.Code.Value end)
&#9;&#9;pcall(function() sub = v.Subtract.Value end)
&#9;&#9;table.insert(stats, {[&quot;Name&quot;]=name, [&quot;Value&quot;]=inv, [&quot;Invites&quot;]=inv, [&quot;Code&quot;]=code, [&quot;Subtract&quot;]=sub})
&#9;end
&#9;if #stats &gt; 1 then
&#9;&#9;repeat
&#9;&#9;&#9;local n = 0
&#9;&#9;&#9;for i = 1, #stats-1 do
&#9;&#9;&#9;&#9;if stats[i].Value &lt; stats[i+1].Value then
&#9;&#9;&#9;&#9;&#9;local a, b = stats[i], stats[i+1]
&#9;&#9;&#9;&#9;&#9;stats[i] = b
&#9;&#9;&#9;&#9;&#9;stats[i+1] = a
&#9;&#9;&#9;&#9;&#9;n=n+1
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;until n == 0
&#9;end
&#9;for _, v in ipairs(l:GetChildren()) do
&#9;&#9;v:remove()
&#9;end
&#9;for i = 1, #stats do
&#9;&#9;local m = new(&quot;Model&quot;, l)
&#9;&#9;m.Name = stats[i].Name
&#9;&#9;local invites = new(&quot;IntValue&quot;, m)
&#9;&#9;invites.Name = &quot;Invites&quot;
&#9;&#9;invites.Value = stats[i].Invites
&#9;&#9;local code = new(&quot;StringValue&quot;, m)
&#9;&#9;code.Name = &quot;Code&quot;
&#9;&#9;code.Value = stats[i].Code
&#9;&#9;local subtract = new(&quot;IntValue&quot;, m)
&#9;&#9;subtract.Name = &quot;Subtract&quot;
&#9;&#9;subtract.Value = stats[i].Subtract
&#9;&#9;wait()
&#9;end
&#9;reloading = false
end

Delay(0, function()
&#9;while wait(6) do
&#9;&#9;Update()
&#9;&#9;--[[if math.random(1, 3) == 1 then
&#9;&#9;&#9;reloading = true
&#9;&#9;&#9;Reload()
&#9;&#9;end]]
&#9;end
end)</ProtectedString>
				</Properties>
			</Item>
			<Item class="Script" referent="RBX3018">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Shield</string>
					<ProtectedString name="Source">Delay(0, function()
&#9;while wait(2) do
&#9;&#9;for index, player in ipairs(game.Players:GetPlayers()) do
&#9;&#9;&#9;pcall(function()
&#9;&#9;&#9;&#9;local tanks = player.Character:findFirstChild(&quot;Tanks&quot;)
&#9;&#9;&#9;&#9;if tanks then
&#9;&#9;&#9;&#9;&#9;local health = 0
&#9;&#9;&#9;&#9;&#9;local avail = 0
&#9;&#9;&#9;&#9;&#9;local want = 0
&#9;&#9;&#9;&#9;&#9;local tab = {}
&#9;&#9;&#9;&#9;&#9;for _, v in ipairs(tanks:GetChildren()) do
&#9;&#9;&#9;&#9;&#9;&#9;pcall(function()
&#9;&#9;&#9;&#9;&#9;&#9;&#9;table.insert(tab, {[&quot;Tank&quot;] = v, [&quot;Want&quot;] = v.MaxHealth.Value})
&#9;&#9;&#9;&#9;&#9;&#9;&#9;avail = avail + v.Shield.Health.Value
&#9;&#9;&#9;&#9;&#9;&#9;&#9;health = health + v.Health.Value
&#9;&#9;&#9;&#9;&#9;&#9;&#9;want = want + v.MaxHealth.Value
&#9;&#9;&#9;&#9;&#9;&#9;end)
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;if avail &gt; 0 then
&#9;&#9;&#9;&#9;&#9;&#9;for _, v in ipairs(tab) do
&#9;&#9;&#9;&#9;&#9;&#9;&#9;pcall(function()
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;v.Tank.Shield.Health.Value = math.floor(v.Want/math.max(want, 1)*avail)
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;v.Tank.Shield.Shield.Transparency = 1-math.max(v.Tank.Shield.Health.Value/(v.Tank.MaxHealth.Value*20), 0)
&#9;&#9;&#9;&#9;&#9;&#9;&#9;end)
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;player.PlayerGui.ScreenGui.Stats.Shields.Text = &quot;Shields: &quot;..avail
&#9;&#9;&#9;&#9;&#9;player.PlayerGui.ScreenGui.Stats.Health.Text = &quot;Health: &quot;..health
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end)
&#9;&#9;end
&#9;end
end)</ProtectedString>
				</Properties>
			</Item>
			<Item class="Model" referent="RBX3019">
				<Properties>
					<CoordinateFrame name="ModelInPrimary">
						<X>0</X>
						<Y>0</Y>
						<Z>0</Z>
						<R00>1</R00>
						<R01>0</R01>
						<R02>0</R02>
						<R10>0</R10>
						<R11>1</R11>
						<R12>0</R12>
						<R20>0</R20>
						<R21>0</R21>
