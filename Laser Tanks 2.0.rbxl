					<Item class="Script" referent="RBX3257">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script</string>
							<ProtectedString name="Source">function Clear()
&#9;for _, v in ipairs(script.Parent.Parent:GetChildren()) do
&#9;&#9;if v.className == &quot;TextButton&quot; and v ~= script.Parent then
&#9;&#9;&#9;if v.Visible then
&#9;&#9;&#9;&#9;v:remove()
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end

local player = script.Parent.Parent.Parent.Parent.Parent

script.Parent.MouseButton1Down:connect(function()
&#9;Clear()
&#9;local p = {}
&#9;for _, v in ipairs(game.Players:GetPlayers()) do
&#9;&#9;if v ~= player then
&#9;&#9;&#9;table.insert(p, v)
&#9;&#9;end
&#9;end
&#9;for i = 1, #p do
&#9;&#9;local new = script.Parent.Parent.Person:clone()
&#9;&#9;new.Parent = script.Parent.Parent
&#9;&#9;new.Name = p[i].Name
&#9;&#9;new.Text = p[i].Name
&#9;&#9;new.Position = UDim2.new(.2*(i-1-math.floor((i-1)/5)*5), 0, .1*math.floor((i-1)/5) + .2, 0)
&#9;&#9;new.Visible = true
&#9;&#9;new.MouseButton1Down:connect(function()
&#9;&#9;&#9;local num = tonumber(script.Parent.Parent.TextBox.Text) or 0
&#9;&#9;&#9;num = math.abs(num)
&#9;&#9;&#9;num = math.min(num, math.floor(p[i].leaderstats.KOs.Value^1.2+.5))
&#9;&#9;&#9;local p1, p2 = player.leaderstats.Points, p[i].leaderstats.Points
&#9;&#9;&#9;if p1.Value &gt;= num then
&#9;&#9;&#9;&#9;p1.Value = p1.Value - num
&#9;&#9;&#9;&#9;p2.Value = p2.Value + num
&#9;&#9;&#9;&#9;shared.Save(player)
&#9;&#9;&#9;end
&#9;&#9;&#9;Clear()
&#9;&#9;&#9;script.Parent.Parent.Visible = false
&#9;&#9;end)
&#9;end
end)</ProtectedString>
						</Properties>
					</Item>
				</Item>
