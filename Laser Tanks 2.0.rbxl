						<Item class="Script" referent="RBX303">
							<Properties>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">CPU</string>
								<ProtectedString name="Source">local tank = script.Parent
tank.Health.Value = math.max(tank.Health.Value*1.2, 50)
tank.MaxHealth.Value = tank.Health.Value
tank.Range.Value = math.min(tank.Range.Value, 40)
local hMod = Instance.new(&quot;Model&quot;, tank)
hMod.Name = &quot;&quot;
local hum = Instance.new(&quot;Humanoid&quot;, hMod)
hum.Health = 0
hum.MaxHealth = 0
local hHead = Instance.new(&quot;Part&quot;, hMod)
hHead.Name = &quot;Head&quot;
hHead.formFactor = &quot;Custom&quot;
hHead.Size = Vector3.new(1, 1, 1)
hHead.Transparency = .9
hHead.CFrame = tank.Head.CFrame + Vector3.new(0, (tank.Head.Size.Y/2)-1, 0)
local hWeld = Instance.new(&quot;Weld&quot;, hHead)
hWeld.Part0 = tank.Head
hWeld.Part1 = hHead
local hHealth = Instance.new(&quot;BillboardGui&quot;, hMod)
hHealth.Name = &quot;Health&quot;
hHealth.Adornee = hHead
hHealth.Size = UDim2.new(3, 0, .5, 0)
hHealth.StudsOffset = Vector3.new(0, 4.5, 0)
local hFrame = Instance.new(&quot;Frame&quot;, hHealth)
hFrame.Size = UDim2.new(1, 0, 1, 0)
hFrame.BackgroundColor = BrickColor.new(&quot;Black&quot;)
hFrame.BorderSizePixel = 0
hFrame.Name = &quot;Back&quot;
local hFront = hFrame:clone()
hFront.Parent = hHealth
hFront.Name = &quot;Front&quot;
hFront.BackgroundColor = BrickColor.new(&quot;Bright green&quot;)
hFront.ZIndex = 2

for _, v in ipairs(script.Parent:GetChildren()) do
&#9;if v.className == &quot;Seat&quot; then
&#9;&#9;v:remove()
&#9;end
end

local max = tank.MaxHealth
local health = tank.Health
health.Changed:connect(function()
&#9;hFront.Size = UDim2.new(health.Value/max.Value, 0, 1, 0)
&#9;if health.Value &lt;= 0 then
&#9;&#9;health.Value = 0
&#9;&#9;Delay(2, function()
&#9;&#9;&#9;if script then
&#9;&#9;&#9;&#9;script.Parent:remove()
&#9;&#9;&#9;end
&#9;&#9;end)
&#9;end
end)

local parts = {}
for _, v in ipairs(script.Parent:GetChildren()) do
&#9;if v:IsA(&quot;BasePart&quot;) then
&#9;&#9;table.insert(parts, v)
&#9;end
end
for _, v in ipairs(parts) do
&#9;local b = parts[_+1]
&#9;if b then
&#9;&#9;local w = Instance.new(&quot;Weld&quot;, v)
&#9;&#9;w.Part0 = v
&#9;&#9;w.Part1 = b
&#9;&#9;w.C0 = v.CFrame:inverse()
&#9;&#9;w.C1 = b.CFrame:inverse()
&#9;end
end

wait()
for _, v in ipairs(script.Parent:GetChildren()) do
&#9;if v:IsA(&quot;BasePart&quot;) then
&#9;&#9;v.Anchored = false
&#9;end
end
script.Parent:MoveTo(workspace.Arena.Center.Position + Vector3.new(math.random(-40, 40), 5, math.random(-40, 40)))
script.Parent.Head.Move.Changed:connect(function()
&#9;if script.Parent.Head.Move.velocity ~= Vector3.new(0, 0, 0) then
&#9;&#9;script.Parent.Head.BodyGyro.cframe = CFrame.new(script.Parent.Head.Position*Vector3.new(1, 0, 1), (script.Parent.Head.Position + script.Parent.Head.Move.velocity)*Vector3.new(1, 0, 1))
&#9;end
&#9;if script.Parent.Head.Position.Y &lt; 0 then
&#9;&#9;script.Parent:remove()
&#9;end
end)

if not script.Parent:findFirstChild(&quot;Fly&quot;) then
&#9;local f = Instance.new(&quot;IntValue&quot;, script.Parent)
&#9;f.Name = &quot;Fly&quot;
&#9;f.Value = 3
end
script.Parent.Head.BodyPosition.position = Vector3.new(0, script.Parent.Fly.Value, 0)

function fire(p)
&#9;if p.Humanoid.Health &gt; 0 and script.Parent.Health.Value &gt; 0 then
&#9;&#9;for _, v in ipairs(script.Parent:GetChildren()) do
&#9;&#9;&#9;if v.Name == &quot;Tip&quot; then
&#9;&#9;&#9;&#9;p.Humanoid.Health = p.Humanoid.Health - math.min(script.Parent.Damage.Value, 8)
&#9;&#9;&#9;&#9;local laser = Instance.new(&quot;Part&quot;, script.Parent)
&#9;&#9;&#9;&#9;laser.Anchored = true
&#9;&#9;&#9;&#9;laser.CanCollide = false
&#9;&#9;&#9;&#9;laser.formFactor = &quot;Custom&quot;
&#9;&#9;&#9;&#9;laser.TopSurface, laser.BottomSurface = &quot;Smooth&quot;, &quot;Smooth&quot;
&#9;&#9;&#9;&#9;laser.BrickColor = script.Parent.Head.BrickColor
&#9;&#9;&#9;&#9;laser.Size = Vector3.new(.5, .5, (v.Position - p.Torso.Position).magnitude)
&#9;&#9;&#9;&#9;laser.CFrame = CFrame.new(v.Position:lerp(p.Torso.Position, .5), p.Torso.Position)
&#9;&#9;&#9;&#9;Delay(0, function()
&#9;&#9;&#9;&#9;&#9;for i = 0, 1, .34 do
&#9;&#9;&#9;&#9;&#9;&#9;laser.Transparency = i
&#9;&#9;&#9;&#9;&#9;&#9;wait(.34)
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;laser:remove()
&#9;&#9;&#9;&#9;end)
&#9;&#9;&#9;&#9;wait(.1)
&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;if p then
&#9;&#9;&#9;if p.Humanoid.Health &lt;= 0 then
&#9;&#9;&#9;&#9;pcall(function()
&#9;&#9;&#9;&#9;&#9;local player = game.Players:playerFromCharacter(p)
&#9;&#9;&#9;&#9;&#9;player.leaderstats.WOs.Value = player.leaderstats.WOs.Value + 1
&#9;&#9;&#9;&#9;end)
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end

function Attack(p)
&#9;for _, v in ipairs(game.Lighting.Guns:GetChildren()) do
&#9;&#9;if p.Backpack:findFirstChild(v.Name) or p.Character:findFirstChild(v.Name) then
&#9;&#9;&#9;if p.Character:findFirstChild(&quot;Torso&quot;) then
&#9;&#9;&#9;&#9;return true
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
&#9;return false
end

while true do
&#9;local p, n = nil, math.huge
&#9;for _, v in ipairs(game.Players:GetPlayers()) do
&#9;&#9;if v.Character then
&#9;&#9;&#9;local char = v.Character
&#9;&#9;&#9;if Attack(v) then
&#9;&#9;&#9;&#9;local torso = char:findFirstChild(&quot;Torso&quot;)
&#9;&#9;&#9;&#9;local dist = (torso.Position - script.Parent.Head.Position).magnitude
&#9;&#9;&#9;&#9;if dist &lt; n then
&#9;&#9;&#9;&#9;&#9;p, n = char, dist
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
&#9;if p then
&#9;&#9;local dist = 0
&#9;&#9;repeat wait(1)
&#9;&#9;&#9;dist = (p.Torso.Position - script.Parent.Head.Position).magnitude
&#9;&#9;&#9;script.Parent.Head.Move.velocity = CFrame.new(script.Parent.Head.Position, p.Torso.Position).lookVector*script.Parent.Speed.Value
&#9;&#9;&#9;script.Parent.Head.BodyGyro.cframe = CFrame.new(script.Parent.Head.Position, script.Parent.Head.Position + script.Parent.Head.Move.velocity)
&#9;&#9;until
&#9;&#9;&#9;dist &lt;= script.Parent.Range.Value or not p
&#9;&#9;if p then
&#9;&#9;&#9;script.Parent.Head.Move.velocity = Vector3.new(0, 0, 0)
&#9;&#9;&#9;script.Parent.Head.BodyGyro.cframe = CFrame.new(script.Parent.Head.Position*Vector3.new(1,0,1), p.Torso.Position*Vector3.new(1,0,1))
&#9;&#9;&#9;fire(p)
&#9;&#9;end
&#9;end
&#9;wait(2.5)
end
</ProtectedString>
