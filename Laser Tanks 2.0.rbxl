			<Item class="Script" referent="RBX2389">
				<Properties>
					<bool name="Disabled">true</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Game2</string>
					<ProtectedString name="Source">for _, player in ipairs(game.Players:GetPlayers()) do
&#9;local stats = Instance.new(&quot;IntValue&quot;, player)
&#9;stats.Name = &quot;leaderstats&quot;
&#9;local KOs, WOs, Points = stats:clone(), stats:clone(), stats:clone()
&#9;KOs.Parent, WOs.Parent, Points.Parent = stats, stats, stats
&#9;KOs.Value = 0
&#9;WOs.Value = 0
&#9;Points.Value = 0
&#9;KOs.Name, WOs.Name, Points.Name = &quot;KOs&quot;, &quot;WOs&quot;, &quot;Points&quot;
&#9;local p1, p2, p3 = Instance.new(&quot;BrickColorValue&quot;, player),  Instance.new(&quot;BrickColorValue&quot;, player), Instance.new(&quot;BrickColorValue&quot;, player)
&#9;p1.Name, p2.Name, p3.Name = &quot;PART1&quot;, &quot;PART2&quot;, &quot;PART3&quot;
&#9;p1.Value = BrickColor.new(&quot;Bright yellow&quot;)
&#9;p2.Value = BrickColor.new(&quot;Bright blue&quot;)
&#9;p3.Value = BrickColor.new(&quot;Br. yellowish green&quot;)
&#9;local controls = Instance.new(&quot;StringValue&quot;, player)
&#9;controls.Name = &quot;Controls&quot;
&#9;controls.Value = &quot;Drag&quot;
&#9;Instance.new(&quot;Model&quot;, player).Name = &quot;Allies&quot;
&#9;Instance.new(&quot;Model&quot;, player).Name = &quot;Request&quot;
&#9;Instance.new(&quot;IntValue&quot;, player).Name = &quot;Damage&quot;
&#9;Instance.new(&quot;IntValue&quot;, player).Name = &quot;Health&quot;
end
</ProtectedString>
				</Properties>
			</Item>
