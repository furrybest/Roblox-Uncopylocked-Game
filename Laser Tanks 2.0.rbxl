					<Item class="Script" referent="RBX3168">
						<Properties>
							<bool name="Disabled">true</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script</string>
							<ProtectedString name="Source">local player = script.Parent.Parent.Parent.Parent.Parent
repeat wait(.1) until player.leaderstats
repeat wait(.1) until player.Character
repeat wait(.1) until player.Character:findFirstChild(&quot;Tanks&quot;)
local tanks = player.Character:findFirstChild(&quot;Tanks&quot;)
repeat wait(.1) until tanks:findFirstChild(&quot;Tank&quot;)
repeat wait(.1) until player:findFirstChild(&quot;Block&quot;)
local block = player:findFirstChild(&quot;Block&quot;)
repeat wait(.1) until player:findFirstChild(&quot;Blocking&quot;)
local blocking = player:findFirstChild(&quot;Blocking&quot;)
script.Parent.BNum.Text = block.Value

if tanks.Tank.Level.Value &gt;= 200 then
&#9;blocking.Value = false
&#9;script.Parent.Block.Text = &quot;Not blocking&quot;
end

script.Parent[&quot;+&quot;].MouseButton1Down:connect(function()
&#9;block.Value = block.Value + 1
&#9;script.Parent.BNum.Text = block.Value
end)
script.Parent[&quot;-&quot;].MouseButton1Down:connect(function()
&#9;block.Value = block.Value - 1
&#9;script.Parent.BNum.Text = block.Value
end)
script.Parent.Block.MouseButton1Down:connect(function()
&#9;blocking.Value = not blocking.Value
&#9;if blocking.Value then
&#9;&#9;script.Parent.Block.Text = &quot;Blocking&quot;
&#9;else
&#9;&#9;script.Parent.Block.Text = &quot;Not blocking&quot;
&#9;end
end)

block.Changed:connect(function()
&#9;pcall(function()
&#9;&#9;if block.Value &lt;= math.max(tanks.Tank.Level.Value*1.5, 15) then
&#9;&#9;&#9;script.Parent[&quot;-&quot;].Visible = false
&#9;&#9;else
&#9;&#9;&#9;script.Parent[&quot;-&quot;].Visible = true
&#9;&#9;end
&#9;end)
end)
while wait(4) do
&#9;pcall(function()
&#9;&#9;if math.max(tanks.Tank.Level.Value*1.5, 15) &gt; block.Value then
&#9;&#9;&#9;block.Value = math.max(tanks.Tank.Level.Value*1.5, 15)
&#9;&#9;&#9;script.Parent.BNum.Text = block.Value
&#9;&#9;end
&#9;end)
end
</ProtectedString>
						</Properties>
