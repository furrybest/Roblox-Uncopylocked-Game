					<Item class="Script" referent="RBX4154">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Welder</string>
							<ProtectedString name="Source">wait(2)

function Connect(a, b)
&#9;local w = Instance.new(&quot;Weld&quot;, a)
&#9;w.Part0 = a
&#9;w.Part1 = b
&#9;w.C0 = a.CFrame:inverse()
&#9;w.C1 = b.CFrame:inverse()
&#9;return w
end
function Weld(a, b)
&#9;local w = Instance.new(&quot;Weld&quot;, a)
&#9;w.Part0 = a
&#9;w.Part1 = b
&#9;return w
end

local parts = {}
local rings = {}
local tips = {}
for _, v in ipairs(script.Parent.Parent:GetChildren()) do
&#9;if v:IsA(&quot;BasePart&quot;) then
&#9;&#9;if v.Name == &quot;A&quot; or v.Name == &quot;B&quot; or v.Name == &quot;C&quot; then
&#9;&#9;&#9;table.insert(rings, v)
&#9;&#9;elseif v.Name ~= &quot;Tip&quot; then
&#9;&#9;&#9;table.insert(parts, v)
&#9;&#9;else
&#9;&#9;&#9;table.insert(tips, v)
&#9;&#9;end
&#9;end
end
local rweld = {}
for _, v in ipairs(rings) do
&#9;table.insert(rweld, Weld(v, script.Parent.Parent.Bottom))
end
for _, v in ipairs(tips) do
&#9;Connect(v, script.Parent.Parent.A)
end
for _, v in ipairs(parts) do
&#9;local b = parts[_+1]
&#9;if b then
&#9;&#9;Connect(v, b)
&#9;end
end
local spinmax = 30
Delay(0, function()
&#9;while true do
&#9;&#9;for i = 1, spinmax do
&#9;&#9;&#9;script.Parent.Parent.B.Weld.C0 = CFrame.Angles(-math.rad(360/spinmax*i)+math.rad(90), 0, 0)
&#9;&#9;&#9;script.Parent.Parent.A.Weld.C0 = CFrame.Angles(-math.rad(90), math.rad(360/spinmax*i), 0)
&#9;&#9;&#9;script.Parent.Parent.C.Weld.C0 = CFrame.Angles(0, math.rad(360/spinmax*i), 0)
&#9;&#9;&#9;wait(3/spinmax)
&#9;&#9;end
&#9;end
end)
wait()
for _, v in ipairs(script.Parent.Parent:GetChildren()) do
&#9;if v:IsA(&quot;BasePart&quot;) then
&#9;&#9;v.Anchored = false
&#9;end
end
</ProtectedString>
