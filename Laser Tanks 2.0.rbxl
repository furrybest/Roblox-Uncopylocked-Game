function Connect(a, b)
&#9;local w = Instance.new(&quot;Weld&quot;, a)
&#9;w.Part0 = a
&#9;w.Part1 = b
&#9;w.C0 = a.CFrame:inverse()
&#9;w.C1 = b.CFrame:inverse()
&#9;return w
end
function Weld(a, b)
&#9;local w = Instance.new(&quot;Weld&quot;, a)
&#9;w.Part0 = a
&#9;w.Part1 = b
&#9;return w
end

local barrels = {}
local tips = {}

for _, v in ipairs(script.Parent.Parent:GetChildren()) do
&#9;if v.Name == &quot;Barrel&quot; then
&#9;&#9;table.insert(barrels, v)
&#9;elseif v.Name == &quot;Tip&quot; then
&#9;&#9;table.insert(tips, v)
&#9;end
end

if #barrels == #tips then
&#9;for i = 1, #tips do
&#9;&#9;Weld(barrels[i], tips[i])
&#9;end
end
Connect(script.Parent, script.Parent.Parent.Bottom)

local part = {}
for i = 1, 5 do
&#9;table.insert(part, Weld(script.Parent, barrels[i]))
end

Delay(0, function()
&#9;while wait() do
&#9;&#9;for i = 1, 40 do
&#9;&#9;&#9;local a = i*(math.pi*2/40)
&#9;&#9;&#9;part[1].C0 = CFrame.new(Vector3.new(10*math.cos(a), 2, 10*math.sin(a)))
&#9;&#9;&#9;wait(.1)
