					<Item class="Script" referent="RBX79">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script</string>
							<ProtectedString name="Source">Delay(0, function()
&#9;while wait(1.5) do
&#9;&#9;for _, v in ipairs(game.Players:GetPlayers()) do
&#9;&#9;&#9;pcall(function()
&#9;&#9;&#9;&#9;if (v.Character.Torso.Position*Vector3.new(1,0,1) - script.Parent.Position*Vector3.new(1,0,1)).magnitude &lt;= 20 then
&#9;&#9;&#9;&#9;&#9;if not v.Backpack:findFirstChild(&quot;Tank&quot;) then
&#9;&#9;&#9;&#9;&#9;&#9;v.PlayerGui.ScreenGui.LeaveArena.Visible = true
&#9;&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;&#9;v.PlayerGui.ScreenGui.EnterArena.Visible = true
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end)
&#9;&#9;end
&#9;end
end)

function GP()
&#9;local e = 0
&#9;for _, v in ipairs(game.Players:GetPlayers()) do
&#9;&#9;if not v.Backpack:findFirstChild(&quot;Tank&quot;) then
&#9;&#9;&#9;e = e + 1
&#9;&#9;end
&#9;end
&#9;return e
end

local tanks = {&quot;Tank&quot;, &quot;Sniper&quot;, &quot;Double&quot;, &quot;MiniFighter&quot;, &quot;DSniper&quot;, &quot;UberTank&quot;, &quot;Tribeam&quot;, &quot;MiniSpeed&quot;}

Delay(0, function()
&#9;while wait(2) do
&#9;&#9;if GP() &gt;= 1 then
&#9;&#9;&#9;for i = 1, math.max(GP()/2, 1) do
&#9;&#9;&#9;&#9;if #workspace.Arena.Tanks:GetChildren() &lt; math.min(GP()*3, 10) then
&#9;&#9;&#9;&#9;&#9;local e = game.Lighting.Tanks:findFirstChild(tanks[math.random(1, #tanks)]):clone()
&#9;&#9;&#9;&#9;&#9;e.Parent = workspace.Arena.Tanks
&#9;&#9;&#9;&#9;&#9;local c = game.Lighting.CPU:clone()
&#9;&#9;&#9;&#9;&#9;c.Parent = e
&#9;&#9;&#9;&#9;&#9;c.Disabled = false
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end)</ProtectedString>
						</Properties>
					</Item>
