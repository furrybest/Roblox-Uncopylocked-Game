							<string name="Name">LocalScript</string>
							<ProtectedString name="Source">wait(1)
local player = script.Parent.Parent.Parent.Parent.Parent
local info = script.Parent.Parent.Info
local cam = workspace.CurrentCamera
local holo = script.Parent.Parent.holo

function Minis()
&#9;local e = 0
&#9;for _, v in ipairs(player.Character.Tanks:GetChildren()) do
&#9;&#9;if v.Name == &quot;Mini&quot; then
&#9;&#9;&#9;e = e + 1
&#9;&#9;end
&#9;end
&#9;return e
end

function Tips(tank)
&#9;local e = 0
&#9;for _, v in ipairs(tank:GetChildren()) do
&#9;&#9;if v.Name == &quot;Tip&quot; then
&#9;&#9;&#9;e = e + 1
&#9;&#9;end
&#9;end
&#9;return e
end

function Cost(tank)
&#9;local e = 0
&#9;print(Tips(tank))
&#9;e = e + (tank.Damage.Value)*(Tips(tank)*2)
&#9;e = e + (tank.Health.Value)
&#9;e = e + (tank.Range.Value)
&#9;e = e + (tank.Speed.Value)
&#9;return math.floor(e+.5)
end

function Spin(tank)
&#9;for _, v in ipairs(tank:GetChildren()) do
&#9;&#9;if v:IsA(&quot;BasePart&quot;) then
&#9;&#9;&#9;v.CFrame = (tank.Bottom.CFrame * CFrame.Angles(0, -.03, 0)):toWorldSpace(tank.Bottom.CFrame:toObjectSpace(v.CFrame))
&#9;&#9;end
&#9;end
end

local moving = false
for _, v in ipairs(script.Parent:GetChildren()) do
&#9;if v.ClassName == &quot;TextButton&quot; then
&#9;&#9;v.Text = v.Name
&#9;&#9;if #v.Text &gt;= 8 then
&#9;&#9;&#9;v.FontSize = &quot;Size18&quot;
&#9;&#9;end
&#9;&#9;v.MouseButton1Down:connect(function()
&#9;&#9;&#9;Delay(0, function()
&#9;&#9;&#9;&#9;if not moving then
&#9;&#9;&#9;&#9;&#9;moving = true
&#9;&#9;&#9;&#9;&#9;info.Visible = true
&#9;&#9;&#9;&#9;&#9;info.Tank.Text = v.Name
&#9;&#9;&#9;&#9;&#9;local tank = game.Lighting.Tanks:findFirstChild(v.Name)
&#9;&#9;&#9;&#9;&#9;local h = tank:clone()
&#9;&#9;&#9;&#9;&#9;for _, v in ipairs(h:GetChildren()) do
&#9;&#9;&#9;&#9;&#9;&#9;if v:IsA(&quot;BasePart&quot;) then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;v.Anchored = true
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;if holo.Value then
&#9;&#9;&#9;&#9;&#9;&#9;Delay(0, function()
&#9;&#9;&#9;&#9;&#9;&#9;&#9;local e = holo.Value
&#9;&#9;&#9;&#9;&#9;&#9;&#9;for i = 1, 40 do
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;if e then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;for _, v in ipairs(e:GetChildren()) do
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;if v:IsA(&quot;BasePart&quot;) then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;v.CFrame = v.CFrame - Vector3.new(1, 0, 0)
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;wait()
&#9;&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;&#9;e:remove()
&#9;&#9;&#9;&#9;&#9;&#9;&#9;if holo.Value == e then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;holo.Value = nil
&#9;&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;end)
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;h.Parent = cam
&#9;&#9;&#9;&#9;&#9;h:MoveTo(workspace.tPos.Position + Vector3.new(40, 0, 0))
&#9;&#9;&#9;&#9;&#9;Delay(0, function()
&#9;&#9;&#9;&#9;&#9;&#9;local e = h
&#9;&#9;&#9;&#9;&#9;&#9;holo.Value = h
&#9;&#9;&#9;&#9;&#9;&#9;for i = 1, 40 do
&#9;&#9;&#9;&#9;&#9;&#9;&#9;if e then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;for _, v in ipairs(e:GetChildren()) do
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;if v:IsA(&quot;BasePart&quot;) then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;v.CFrame = v.CFrame - Vector3.new(1, 0, 0)
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;&#9;wait()
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;moving = false
&#9;&#9;&#9;&#9;&#9;&#9;while e do
&#9;&#9;&#9;&#9;&#9;&#9;&#9;Spin(e)
&#9;&#9;&#9;&#9;&#9;&#9;&#9;wait()
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;end)
&#9;&#9;&#9;&#9;&#9;info.Cost.Text = &quot;&quot;..Cost(tank)..&quot; Points&quot;
&#9;&#9;&#9;&#9;&#9;info.Damage.Text = &quot;Damage: &quot;..tank.Damage.Value
&#9;&#9;&#9;&#9;&#9;info.Health.Text = &quot;Health: &quot;..tank.MaxHealth.Value
&#9;&#9;&#9;&#9;&#9;info.Range.Text = &quot;Range: &quot;..tank.Range.Value
&#9;&#9;&#9;&#9;&#9;info.Speed.Text = &quot;Speed: &quot;..tank.Speed.Value
&#9;&#9;&#9;&#9;&#9;local Max = 5
&#9;&#9;&#9;&#9;&#9;if player:findFirstChild(&quot;MEGAVIP&quot;) then
&#9;&#9;&#9;&#9;&#9;&#9;Max = 10
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;pcall(function()
&#9;&#9;&#9;&#9;&#9;&#9;local invites = math.floor(workspace.Leaderboard:findFirstChild(player.Name).Invites.Value/2)
&#9;&#9;&#9;&#9;&#9;&#9;Max = Max + invites
&#9;&#9;&#9;&#9;&#9;end)
&#9;&#9;&#9;&#9;&#9;if tank.Name == &quot;MiniAmb&quot; and not player:findFirstChild(&quot;MiniAmb&quot;) then
&#9;&#9;&#9;&#9;&#9;&#9;info.Buy.TextColor = BrickColor.new(&quot;Really red&quot;)
&#9;&#9;&#9;&#9;&#9;&#9;info.Buy.Text = &quot;You must own the Mini Ambassador T-Shirt to buy a MiniAmb.&quot;
&#9;&#9;&#9;&#9;&#9;&#9;info.Buy.FontSize = &quot;Size14&quot;
&#9;&#9;&#9;&#9;&#9;elseif player.leaderstats.Points.Value &gt;= Cost(tank) and Minis() &lt; Max then
&#9;&#9;&#9;&#9;&#9;&#9;info.Buy.TextColor = BrickColor.new(&quot;Institutional white&quot;)
&#9;&#9;&#9;&#9;&#9;&#9;info.Buy.Text = &quot;Buy&quot;
&#9;&#9;&#9;&#9;&#9;&#9;info.Buy.FontSize = &quot;Size48&quot;
&#9;&#9;&#9;&#9;&#9;&#9;script.Parent.Parent.buy.Value = tank
&#9;&#9;&#9;&#9;&#9;elseif Minis() &gt;= Max then
&#9;&#9;&#9;&#9;&#9;&#9;info.Buy.TextColor3 = Color3.new(50, 50, 50)
&#9;&#9;&#9;&#9;&#9;&#9;info.Buy.Text = Max..&quot; Minis max&quot;
&#9;&#9;&#9;&#9;&#9;&#9;info.Buy.FontSize = &quot;Size24&quot;
&#9;&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;&#9;info.Buy.TextColor3 = Color3.new(50, 50, 50)
&#9;&#9;&#9;&#9;&#9;&#9;info.Buy.Text = &quot;Not enough Points&quot;
&#9;&#9;&#9;&#9;&#9;&#9;info.Buy.FontSize = &quot;Size24&quot;
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end)
&#9;&#9;end)
&#9;end
end
</ProtectedString>
