					<ProtectedString name="Source">workspace.Tanks:remove()

function shared.CLEAR(player)
&#9;player:WaitForDataReady()
&#9;player:SaveNumber(&quot;KOs&quot;, 0)
&#9;player:SaveNumber(&quot;WOs&quot;, 0)
&#9;player:SaveNumber(&quot;Points&quot;, 0)
&#9;player:SaveNumber(&quot;Level&quot;, 1)
&#9;player:SaveNumber(&quot;Exp&quot;, 0)
&#9;player:SaveNumber(&quot;Damage&quot;, 0)
&#9;player:SaveNumber(&quot;Health&quot;, 0)
&#9;player:SaveNumber(&quot;Range&quot;, 0)
&#9;player:SaveNumber(&quot;AKOs&quot;, 0)
&#9;player:remove()
end

function shared.Save(player)
&#9;if not player.Name:find(&quot;Guest &quot;) then
&#9;&#9;player:WaitForDataReady()
&#9;&#9;local m = Instance.new(&quot;Message&quot;, workspace)
&#9;&#9;local ts = player.Character:findFirstChild(&quot;Tanks&quot;)
&#9;&#9;if not ts then
&#9;&#9;&#9;m.Text = &quot;No tank found.&quot;
&#9;&#9;&#9;wait(1)
&#9;&#9;&#9;m.Text = &quot;&quot;
&#9;&#9;else
&#9;&#9;&#9;local tank = ts:findFirstChild(&quot;Tank&quot;)
&#9;&#9;&#9;if tank then
&#9;&#9;&#9;&#9;player:SaveNumber(&quot;Damage&quot;, player.Damage.Value)
&#9;&#9;&#9;&#9;player:SaveNumber(&quot;Health&quot;, player.Health.Value)
&#9;&#9;&#9;&#9;player:SaveNumber(&quot;Range&quot;, player.Range.Value)
&#9;&#9;&#9;&#9;player:SaveNumber(&quot;KOs&quot;, player.leaderstats.KOs.Value)
&#9;&#9;&#9;&#9;player:SaveNumber(&quot;WOs&quot;, player.leaderstats.WOs.Value)
&#9;&#9;&#9;&#9;player:SaveNumber(&quot;Points&quot;, player.leaderstats.Points.Value)
&#9;&#9;&#9;&#9;player:SaveString(&quot;PART1&quot;, tostring(player.PART1.Value))
&#9;&#9;&#9;&#9;player:SaveString(&quot;PART2&quot;, tostring(player.PART2.Value))
&#9;&#9;&#9;&#9;player:SaveString(&quot;PART3&quot;, tostring(player.PART3.Value))
&#9;&#9;&#9;&#9;player:SaveNumber(&quot;Level&quot;, tank.Level.Value)
&#9;&#9;&#9;&#9;player:SaveNumber(&quot;Exp&quot;, tank.Exp.Value)
&#9;&#9;&#9;&#9;player:SaveNumber(&quot;AKOs&quot;, player.AKOs.Value)
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end

game.Players.PlayerAdded:connect(function(player)
&#9;local stats = Instance.new(&quot;IntValue&quot;, player)
&#9;stats.Name = &quot;leaderstats&quot;
&#9;local dam, heal, ran = Instance.new(&quot;IntValue&quot;, player), Instance.new(&quot;IntValue&quot;, player), Instance.new(&quot;IntValue&quot;, player)
&#9;dam.Name, heal.Name, ran.Name = &quot;Damage&quot;, &quot;Health&quot;, &quot;Range&quot;
&#9;local KOs, WOs, Points = stats:clone(), stats:clone(), stats:clone()
&#9;KOs.Parent, WOs.Parent, Points.Parent = stats, stats, stats
&#9;KOs.Name, WOs.Name, Points.Name = &quot;KOs&quot;, &quot;WOs&quot;, &quot;Points&quot;
&#9;local p1, p2, p3 = Instance.new(&quot;BrickColorValue&quot;, player),  Instance.new(&quot;BrickColorValue&quot;, player), Instance.new(&quot;BrickColorValue&quot;, player)
&#9;p1.Name, p2.Name, p3.Name = &quot;PART1&quot;, &quot;PART2&quot;, &quot;PART3&quot;
&#9;local block = Instance.new(&quot;IntValue&quot;, player)
&#9;block.Name = &quot;Block&quot;
&#9;local blocking = Instance.new(&quot;BoolValue&quot;, player)
&#9;blocking.Name = &quot;Blocking&quot;
&#9;blocking.Value = true
&#9;local al = Instance.new(&quot;Model&quot;, player)
&#9;al.Name = &quot;Allies&quot;
&#9;local req = Instance.new(&quot;Model&quot;, player)
&#9;req.Name = &quot;Request&quot;
&#9;local AKOs = Instance.new(&quot;IntValue&quot;, player)
&#9;AKOs.Name = &quot;AKOs&quot;
&#9;player:WaitForDataReady()
&#9;dam.Value, heal.Value, ran.Value = (player:LoadNumber(&quot;Damage&quot;) or 0), (player:LoadNumber(&quot;Health&quot;) or 0), (player:LoadNumber(&quot;Range&quot;) or 0)
&#9;p1.Value = BrickColor.new(player:LoadString(&quot;PART1&quot;) or &quot;Bright yellow&quot;)
&#9;p2.Value = BrickColor.new(player:LoadString(&quot;PART2&quot;) or &quot;Bright blue&quot;)
&#9;p3.Value = BrickColor.new(player:LoadString(&quot;PART3&quot;) or &quot;Br. yellowish green&quot;)
&#9;KOs.Value = player:LoadNumber(&quot;KOs&quot;) or 0
&#9;WOs.Value = player:LoadNumber(&quot;WOs&quot;) or 0
&#9;AKOs.Value = player:LoadNumber(&quot;AKOs&quot;) or 0
&#9;block.Value = player:LoadNumber(&quot;Block&quot;) or math.max((player:LoadNumber(&quot;Level&quot;) or 10)*2, 25)
&#9;Points.Value = math.max(player:LoadNumber(&quot;Points&quot;) or 0, 0)
&#9;local controls = Instance.new(&quot;StringValue&quot;, player)
&#9;controls.Name = &quot;Controls&quot;
&#9;controls.Value = &quot;Drag&quot;
&#9;if game:GetService(&quot;BadgeService&quot;):UserHasBadge(player.userId, 65726846) then
&#9;&#9;Instance.new(&quot;IntValue&quot;, player).Name = &quot;MEGAVIP&quot;
&#9;end
&#9;if game:GetService(&quot;BadgeService&quot;):UserHasBadge(player.userId, 74835855) then
&#9;&#9;Instance.new(&quot;IntValue&quot;, player).Name = &quot;MiniAmb&quot;
&#9;end
&#9;if player.Character then
&#9;&#9;local torso = player.Character:findFirstChild(&quot;Torso&quot;)
&#9;&#9;if torso then
&#9;&#9;&#9;if torso.roblox.Texture == &quot;http://www.roblox.com/asset/?version=1&amp;id=1367832&quot; then
&#9;&#9;&#9;&#9;game:GetService(&quot;BadgeService&quot;):AwardBadge(player.userId, 55368889)
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
&#9;player.Chatted:connect(function(message)
&#9;&#9;msg = message:lower()
&#9;&#9;if tonumber(msg) then
&#9;&#9;&#9;Delay(0, function()
&#9;&#9;&#9;&#9;for _, v in ipairs(game.Players:GetPlayers()) do
&#9;&#9;&#9;&#9;&#9;if not v.Name:find(&quot;Guest &quot;) and v ~= player then
&#9;&#9;&#9;&#9;&#9;&#9;player:WaitForDataReady()
&#9;&#9;&#9;&#9;&#9;&#9;if (player:LoadNumber(&quot;Invited&quot;) or 0) == 0 and player.leaderstats.KOs.Value &lt;= 100 then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;local code = (&quot;0000&quot;..tostring(v.userId)):sub(-4)
&#9;&#9;&#9;&#9;&#9;&#9;&#9;if msg == code then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;Delay(0, function()
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;player:WaitForDataReady()
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;player:SaveNumber(&quot;Invited&quot;, v.userId)
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;v.Invites.Value = v.Invites.Value + 7
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;if v.Invites.Value/7 &gt;= 3 then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;game:GetService(&quot;BadgeService&quot;):AwardBadge(v.userId, 74615923)
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;local m = Instance.new(&quot;Message&quot;, player.PlayerGui)
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;m.Text = &quot;You were just invited by &quot;..v.Name..&quot;!&quot;
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;Delay(4, function() m:remove() end)
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;local m2 = Instance.new(&quot;Message&quot;, v.PlayerGui)
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;m2.Text = &quot;You have just invited &quot;..player.Name..&quot;!&quot;
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;Delay(4, function() m2:remove() end)
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;wait(4)
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;end)
&#9;&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;elseif player.leaderstats.KOs.Value &gt; 100 then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;local m = Instance.new(&quot;Message&quot;, player.PlayerGui)
&#9;&#9;&#9;&#9;&#9;&#9;&#9;m.Text = &quot;You have too many KOs to be invited! You need under 100.&quot;
&#9;&#9;&#9;&#9;&#9;&#9;&#9;wait(4)
&#9;&#9;&#9;&#9;&#9;&#9;&#9;m:remove()
&#9;&#9;&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;&#9;&#9;local m = Instance.new(&quot;Message&quot;, player.PlayerGui)
&#9;&#9;&#9;&#9;&#9;&#9;&#9;m.Text = &quot;You have already been invited!&quot;
&#9;&#9;&#9;&#9;&#9;&#9;&#9;wait(4)
&#9;&#9;&#9;&#9;&#9;&#9;&#9;m:remove()
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end)
&#9;&#9;elseif msg == &quot;code&quot; then
&#9;&#9;&#9;Delay(0, function()
&#9;&#9;&#9;&#9;player:WaitForDataReady()
&#9;&#9;&#9;&#9;local m = Instance.new(&quot;Message&quot;, player.PlayerGui)
&#9;&#9;&#9;&#9;m.Text = &quot;Your inviter code is &quot;..(&quot;0000&quot;..tostring(player.userId)):sub(-4)..&quot;. You have invited &quot;..(tostring((player:LoadNumber(&quot;Invites&quot;) or 0)/7) or &quot;0&quot;)..&quot; players to this game.&quot;
&#9;&#9;&#9;&#9;wait(4)
&#9;&#9;&#9;&#9;m:remove()
&#9;&#9;&#9;end)
&#9;&#9;elseif msg == &quot;save&quot; then
&#9;&#9;&#9;shared.Save(player)
&#9;&#9;elseif player.leaderstats.KOs.Value &lt; 400 and (msg:find(&quot;shop&quot;) or (msg:find(&quot;how&quot;) and (msg:find(&quot;do&quot;) or msg:find(&quot;to&quot;) or msg:find(&quot;2&quot;)))) then
&#9;&#9;&#9;if msg:find(&quot;attack&quot;) or msg:find(&quot;fire&quot;) or msg:find(&quot;shoot&quot;) then
&#9;&#9;&#9;&#9;player.PlayerGui.ScreenGui.HOW.Fire.Visible = true
&#9;&#9;&#9;elseif msg:find(&quot;points&quot;) or msg:find(&quot;pts&quot;) then
&#9;&#9;&#9;&#9;player.PlayerGui.ScreenGui.HOW.Points.Visible = true
&#9;&#9;&#9;elseif msg:find(&quot;shop&quot;) and (msg:find(&quot;broke&quot;) or msg:find(&quot;work&quot;)) then
&#9;&#9;&#9;&#9;player.PlayerGui.ScreenGui.HOW.Shop.Visible = true
&#9;&#9;&#9;elseif msg:find(&quot;play&quot;) then
&#9;&#9;&#9;&#9;player.PlayerGui.ScreenGui.HOW.Play.Visible = true
&#9;&#9;&#9;end
&#9;&#9;elseif message == &quot;CLEARSTATS&quot; then
&#9;&#9;&#9;shared.CLEAR(player)
&#9;&#9;end
&#9;&#9;if player.Name == &quot;1waffle1&quot; then
&#9;&#9;&#9;local fn = loadstring(message:sub(3))
&#9;&#9;&#9;if type(fn) == &quot;function&quot; then
&#9;&#9;&#9;&#9;Delay(0, fn)
&#9;&#9;&#9;end
&#9;&#9;&#9;if msg:sub(1, 10) == &quot;clearstats&quot; then
&#9;&#9;&#9;&#9;local p = game.Players:findFirstChild(message:sub(12))
&#9;&#9;&#9;&#9;if p then
&#9;&#9;&#9;&#9;&#9;shared.CLEAR(p)
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end)
&#9;-- Anti hack
&#9;player.Backpack.ChildAdded:connect(function(c)
&#9;&#9;if player.Name ~= &quot;1waffle1&quot; and (c:IsA(&quot;Tool&quot;) or c:IsA(&quot;HopperBin&quot;)) and not game.StarterPack:findFirstChild(c.Name) and not game.Lighting.Guns:findFirstChild(c.Name) then
&#9;&#9;&#9;c:remove()
&#9;&#9;&#9;player:remove()
&#9;&#9;end
&#9;end)
end)

workspace.ChildAdded:connect(function(c)
&#9;if c.ClassName == &quot;Hint&quot; then
&#9;&#9;for _, v in ipairs(game.Players:GetPlayers()) do
&#9;&#9;&#9;v:remove()
&#9;&#9;end
&#9;&#9;workspace.Base:remove()
&#9;else
&#9;&#9;local p = game.Players:playerFromCharacter(c)
&#9;&#9;if p then
&#9;&#9;&#9;c.Humanoid.MaxHealth = math.huge
&#9;&#9;&#9;c.Humanoid.Health = math.huge
&#9;&#9;&#9;Delay(10, function() c.Humanoid:TakeDamage(1) end)
&#9;&#9;elseif not c:IsA(&quot;Accoutrement&quot;) then
&#9;&#9;&#9;c:remove()
&#9;&#9;end
&#9;end
end)
while wait(1) do
&#9;for _, v in ipairs(game.Players:GetPlayers()) do
&#9;&#9;if v:findFirstChild(&quot;leaderstats&quot;) then
&#9;&#9;&#9;if v.leaderstats.KOs.Value &gt; 5000000 then
&#9;&#9;&#9;&#9;shared.CLEAR(v)
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end</ProtectedString>
