						<Item class="LocalScript" referent="RBX3230">
							<Properties>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">LocalScript</string>
								<ProtectedString name="Source">local buy = script.Parent.Parent.Parent.buy
local player = script.Parent.Parent.Parent.Parent.Parent.Parent
local cam = workspace.CurrentCamera

repeat wait(.1) until script.Parent.Parent.Parent.Visible
script.Parent.Text = &quot;Loading&quot;
repeat wait(.1) until player.leaderstats
repeat wait(.1) until player.Character
repeat wait(.1) until player.Character:findFirstChild(&quot;Tanks&quot;)
local tanks = player.Character:findFirstChild(&quot;Tanks&quot;)
repeat wait(.1) until tanks:findFirstChild(&quot;Tank&quot;)
wait()
script.Parent.Text = &quot;Loaded.&quot;

function Minis()
&#9;local e = 0
&#9;for _, v in ipairs(tanks:GetChildren()) do
&#9;&#9;if v.Name == &quot;Mini&quot; then
&#9;&#9;&#9;e = e + 1
&#9;&#9;end
&#9;end
&#9;return e
end

function Tips(tank)
&#9;local e = 0
&#9;for _, v in ipairs(buy.Value:GetChildren()) do
&#9;&#9;if v.Name == &quot;Tip&quot; then
&#9;&#9;&#9;e = e + 1
&#9;&#9;end
&#9;end
&#9;return e
end

function Cost(tank)
&#9;local e = 0
&#9;if tank.Name == &quot;Shield&quot; then
&#9;&#9;for _, v in ipairs(player.Character.Tanks:GetChildren()) do
&#9;&#9;&#9;e = e + v.MaxHealth.Value
&#9;&#9;end
&#9;elseif tank.Name == &quot;Damage&quot; then
&#9;&#9;e = math.ceil(1.1^(player.Damage.Value+100))
&#9;elseif tank.Name == &quot;Health&quot; then
&#9;&#9;e = math.ceil(1.1^(player.Health.Value+100))
&#9;elseif tank.Name == &quot;Range&quot; then
&#9;&#9;e = math.ceil(1.1^(player.Range.Value+10))
&#9;else
&#9;&#9;e = e + (tank.Damage.Value)*(Tips(tank)*2)
&#9;&#9;e = e + (tank.Health.Value)
&#9;&#9;e = e + (tank.Range.Value)
&#9;&#9;e = e + (tank.Speed.Value)
&#9;&#9;e = math.floor(e+.5)
&#9;end
&#9;return e
end

Max = 5
if player:findFirstChild(&quot;MEGAVIP&quot;) then
&#9;Max = 10
end
pcall(function()
&#9;local invites = math.floor(workspace.Leaderboard:findFirstChild(player.Name).Invites.Value/2)
&#9;Max = Max + invites
end)

script.Parent.MouseButton1Down:connect(function()
&#9;if buy.Value then
&#9;&#9;local tank = buy.Value
&#9;&#9;if tank.Name == &quot;Shield&quot; and player.leaderstats.Points.Value &gt;= Cost(tank) then
&#9;&#9;&#9;for _, v in ipairs(player.Character.Tanks:GetChildren()) do
&#9;&#9;&#9;&#9;v.Shield.Health.Value = v.Shield.Health.Value + v.MaxHealth.Value
&#9;&#9;&#9;&#9;v.Shield.Shield.Transparency = 1-math.max(v.Shield.Health.Value/(v.MaxHealth.Value*20), 0)
&#9;&#9;&#9;end
&#9;&#9;&#9;player.leaderstats.Points.Value = player.leaderstats.Points.Value - Cost(tank)
&#9;&#9;elseif tank.Name == &quot;Damage&quot; and player.Damage.Value &lt; 100 then
&#9;&#9;&#9;if player.leaderstats.Points.Value &gt;= Cost(tank) then
&#9;&#9;&#9;&#9;player.leaderstats.Points.Value = player.leaderstats.Points.Value - Cost(tank)
&#9;&#9;&#9;&#9;player.Damage.Value = player.Damage.Value + 1
&#9;&#9;&#9;&#9;script.Parent.Parent.Parent.Upgrades.Damage.Text = &quot;Damage &quot;..player.Damage.Value
&#9;&#9;&#9;&#9;script.Parent.Parent.Cost.Text = &quot;Cost: &quot;..Cost(tank)
&#9;&#9;&#9;&#9;for _, v in ipairs(player.Character.Tanks:GetChildren()) do
&#9;&#9;&#9;&#9;&#9;v.Damage.Value = v.Damage.Value * 1.1
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;elseif tank.Name == &quot;Health&quot; and player.Health.Value &lt; 100 then
&#9;&#9;&#9;if player.leaderstats.Points.Value &gt;= Cost(tank) then
&#9;&#9;&#9;&#9;player.leaderstats.Points.Value = player.leaderstats.Points.Value - Cost(tank)
&#9;&#9;&#9;&#9;player.Health.Value = player.Health.Value + 1
&#9;&#9;&#9;&#9;script.Parent.Parent.Parent.Upgrades.Health.Text = &quot;Health &quot;..player.Health.Value
&#9;&#9;&#9;&#9;script.Parent.Parent.Cost.Text = &quot;Cost: &quot;..Cost(tank)
&#9;&#9;&#9;&#9;for _, v in ipairs(player.Character.Tanks:GetChildren()) do
&#9;&#9;&#9;&#9;&#9;v.MaxHealth.Value = v.MaxHealth.Value * 1.1
&#9;&#9;&#9;&#9;&#9;v.Health.Value = v.Health.Value * 1.1
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;elseif tank.Name == &quot;Range&quot; and player.Range.Value &lt; 100 then
&#9;&#9;&#9;if player.leaderstats.Points.Value &gt;= Cost(tank) then
&#9;&#9;&#9;&#9;player.leaderstats.Points.Value = player.leaderstats.Points.Value - Cost(tank)
&#9;&#9;&#9;&#9;player.Range.Value = player.Range.Value + 1
&#9;&#9;&#9;&#9;script.Parent.Parent.Parent.Upgrades.Range.Text = &quot;Range &quot;..player.Health.Value
&#9;&#9;&#9;&#9;script.Parent.Parent.Cost.Text = &quot;Cost: &quot;..Cost(tank)
&#9;&#9;&#9;&#9;for _, v in ipairs(player.Character.Tanks:GetChildren()) do
&#9;&#9;&#9;&#9;&#9;v.Range.Value = v.Range.Value + 10
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;elseif not buy.Value:findFirstChild(&quot;Mini&quot;) then
&#9;&#9;&#9;local tnk = tanks:findFirstChild(&quot;Tank&quot;)
&#9;&#9;&#9;if tnk then
&#9;&#9;&#9;&#9;if tnk:findFirstChild(&quot;Bottom&quot;) then
&#9;&#9;&#9;&#9;&#9;local health = tanks.Tank.Health.Value
&#9;&#9;&#9;&#9;&#9;local t = buy.Value:clone()
&#9;&#9;&#9;&#9;&#9;t.Name = &quot;Tank&quot;
&#9;&#9;&#9;&#9;&#9;tanks.Tank.Level.Parent = t
&#9;&#9;&#9;&#9;&#9;tanks.Tank.Exp.Parent = t
&#9;&#9;&#9;&#9;&#9;t.Health.Value = health
&#9;&#9;&#9;&#9;&#9;local pos = tanks.Tank.Bottom.Position
&#9;&#9;&#9;&#9;&#9;tanks.Tank:remove()
&#9;&#9;&#9;&#9;&#9;local T = tanks
&#9;&#9;&#9;&#9;&#9;t.Parent = T
&#9;&#9;&#9;&#9;&#9;t:MoveTo(pos)
&#9;&#9;&#9;&#9;&#9;t:MakeJoints()
&#9;&#9;&#9;&#9;&#9;local ts = game.Lighting.TankScript:clone()
&#9;&#9;&#9;&#9;&#9;ts.Parent = t
&#9;&#9;&#9;&#9;&#9;ts.Disabled = false
&#9;&#9;&#9;&#9;&#9;for _, v in ipairs(t:GetChildren()) do
&#9;&#9;&#9;&#9;&#9;&#9;if v:IsA(&quot;BasePart&quot;) then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;if v.BrickColor == BrickColor.new(&quot;Bright yellow&quot;) then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;Instance.new(&quot;IntValue&quot;, v).Name = &quot;PART1&quot;
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;v.BrickColor = player.PART1.Value
&#9;&#9;&#9;&#9;&#9;&#9;&#9;elseif v.BrickColor == BrickColor.new(&quot;Bright blue&quot;) then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;Instance.new(&quot;IntValue&quot;, v).Name = &quot;PART2&quot;
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;v.BrickColor = player.PART2.Value
&#9;&#9;&#9;&#9;&#9;&#9;&#9;elseif v.BrickColor == BrickColor.new(&quot;Br. yellowish green&quot;) then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;Instance.new(&quot;IntValue&quot;, v).Name = &quot;PART3&quot;
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;v.BrickColor = player.PART3.Value
&#9;&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;script.Parent.Parent.Parent.Visible = false
&#9;&#9;&#9;&#9;&#9;cam.CameraSubject = player.Character
&#9;&#9;&#9;&#9;&#9;cam.CameraType = &quot;Custom&quot;
&#9;&#9;&#9;&#9;&#9;for _, v in ipairs(cam:GetChildren()) do
&#9;&#9;&#9;&#9;&#9;&#9;v:remove()
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;tnk:remove()
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;elseif Minis() &lt; Max and player.leaderstats.Points.Value &gt; Cost(tank) and (tank.Name ~= &quot;MiniAmb&quot; or player:findFirstChild(&quot;MiniAmb&quot;)) then
&#9;&#9;&#9;local tnk = tanks:findFirstChild(&quot;Tank&quot;)
&#9;&#9;&#9;if tnk then
&#9;&#9;&#9;&#9;if tnk:findFirstChild(&quot;Bottom&quot;) then
&#9;&#9;&#9;&#9;&#9;local t = buy.Value:clone()
&#9;&#9;&#9;&#9;&#9;t.Name = &quot;Mini&quot;
&#9;&#9;&#9;&#9;&#9;local T = tanks
&#9;&#9;&#9;&#9;&#9;t.Parent = T
&#9;&#9;&#9;&#9;&#9;t:MoveTo(tnk.Bottom.Position + Vector3.new(math.random(-10, 10), 5, math.random(-10, 10)))
&#9;&#9;&#9;&#9;&#9;t:MakeJoints()
&#9;&#9;&#9;&#9;&#9;local level, exp = Instance.new(&quot;IntValue&quot;, t), Instance.new(&quot;IntValue&quot;, t)
&#9;&#9;&#9;&#9;&#9;level.Name, exp.Name = &quot;Level&quot;, &quot;Exp&quot;
&#9;&#9;&#9;&#9;&#9;level.Value = 1
&#9;&#9;&#9;&#9;&#9;local ts = game.Lighting.TankScript:clone()
&#9;&#9;&#9;&#9;&#9;ts.Parent = t
&#9;&#9;&#9;&#9;&#9;ts.Disabled = false
&#9;&#9;&#9;&#9;&#9;player.leaderstats.Points.Value = player.leaderstats.Points.Value - Cost(buy.Value)
&#9;&#9;&#9;&#9;&#9;for _, v in ipairs(t:GetChildren()) do
&#9;&#9;&#9;&#9;&#9;&#9;if v:IsA(&quot;BasePart&quot;) then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;if v.BrickColor == BrickColor.new(&quot;Bright yellow&quot;) then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;Instance.new(&quot;IntValue&quot;, v).Name = &quot;PART1&quot;
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;v.BrickColor = player.PART1.Value
&#9;&#9;&#9;&#9;&#9;&#9;&#9;elseif v.BrickColor == BrickColor.new(&quot;Bright blue&quot;) then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;Instance.new(&quot;IntValue&quot;, v).Name = &quot;PART2&quot;
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;v.BrickColor = player.PART2.Value
&#9;&#9;&#9;&#9;&#9;&#9;&#9;elseif v.BrickColor == BrickColor.new(&quot;Br. yellowish green&quot;) then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;Instance.new(&quot;IntValue&quot;, v).Name = &quot;PART3&quot;
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;v.BrickColor = player.PART3.Value
&#9;&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;tnk:remove()
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;else
&#9;&#9;&#9;script.Parent.TextColor3 = Color3.new(50, 50, 50)
&#9;&#9;&#9;script.Parent.Text = Max..&quot; Minis max&quot;
&#9;&#9;&#9;script.Parent.FontSize = &quot;Size24&quot;
&#9;&#9;&#9;script.Parent.Parent.Parent.Visible = false
&#9;&#9;&#9;cam.CameraSubject = player.Character
&#9;&#9;&#9;cam.CameraType = &quot;Custom&quot;
&#9;&#9;&#9;for _, v in ipairs(cam:GetChildren()) do
&#9;&#9;&#9;&#9;v:remove()
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end)</ProtectedString>
