			<Item class="Script" referent="RBX3143">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<ProtectedString name="Source">wait(1)
local player = script.Parent.Parent.Parent
repeat wait() until player:findFirstChild(&quot;leaderstats&quot;)

local new = Instance.new
local lighting = game.Lighting

function fire(a, t)
&#9;for _, v in ipairs(a:GetChildren()) do
&#9;&#9;if v.Name == &quot;Tip&quot; then
&#9;&#9;&#9;wait(math.random(10, 15)/100)
&#9;&#9;&#9;if not t then return end
&#9;&#9;&#9;if not t:findFirstChild(&quot;Head&quot;) then return end
&#9;&#9;&#9;local shield = t:findFirstChild(&quot;Shield&quot;)
&#9;&#9;&#9;if not shield then return end
&#9;&#9;&#9;local laser = Instance.new(&quot;SelectionPartLasso&quot;, a)
&#9;&#9;&#9;laser.Color = a.Head.BrickColor
&#9;&#9;&#9;for q, w in ipairs(t:GetChildren()) do
&#9;&#9;&#9;&#9;if w:findFirstChild(&quot;Humanoid&quot;) then
&#9;&#9;&#9;&#9;&#9;laser.Humanoid = w:findFirstChild(&quot;Humanoid&quot;)
&#9;&#9;&#9;&#9;&#9;break
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;&#9;laser.Part = v
&#9;&#9;&#9;if shield.Health.Value &gt; 0 or shield.Shield.Transparency ~= 1 then
&#9;&#9;&#9;&#9;shield.Health.Value = math.max(0, shield.Health.Value - a.Damage.Value)
&#9;&#9;&#9;&#9;shield.Shield.Transparency = 1-math.max(t.Shield.Health.Value/(t.MaxHealth.Value*20), 0)
&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;t.Health.Value = t.Health.Value - a.Damage.Value
&#9;&#9;&#9;end
&#9;&#9;&#9;Delay(1, function() laser:remove() end)
&#9;&#9;&#9;pcall(function()
&#9;&#9;&#9;&#9;if t.Health.Value &lt;= 0 then
&#9;&#9;&#9;&#9;&#9;local victim = game.Players:playerFromCharacter(t.Parent.Parent)
&#9;&#9;&#9;&#9;&#9;victim.leaderstats.WOs.Value = victim.leaderstats.WOs.Value + 1
&#9;&#9;&#9;&#9;&#9;local mini = t:findFirstChild(&quot;Mini&quot;)
&#9;&#9;&#9;&#9;&#9;if mini then
&#9;&#9;&#9;&#9;&#9;&#9;mini.Value = mini.Value - 1
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;t.Health.Value = t.MaxHealth.Value
&#9;&#9;&#9;&#9;&#9;local KOs, points = player.leaderstats.KOs, player.leaderstats.Points
&#9;&#9;&#9;&#9;&#9;KOs.Value = KOs.Value + 1
&#9;&#9;&#9;&#9;&#9;local add = math.max(t.Level.Value/5, 1)
&#9;&#9;&#9;&#9;&#9;if player:findFirstChild(&quot;MEGAVIP&quot;) then
&#9;&#9;&#9;&#9;&#9;&#9;add = add * 5
&#9;&#9;&#9;&#9;&#9;elseif player.Character.Torso.roblox.Texture == &quot;http://www.roblox.com/asset/?id=53915094&quot; then
&#9;&#9;&#9;&#9;&#9;&#9;add = add * 3
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;points.Value = points.Value + add
&#9;&#9;&#9;&#9;&#9;Tanks(function(x)
&#9;&#9;&#9;&#9;&#9;&#9;x.Exp.Value = x.Exp.Value + t.Level.Value + math.max(t.Level.Value/3, 1)
&#9;&#9;&#9;&#9;&#9;&#9;local mini = x:findFirstChild(&quot;Mini&quot;)
&#9;&#9;&#9;&#9;&#9;&#9;if mini then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;mini.Value = mini.Value + 1
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;end)
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end)
&#9;&#9;end
&#9;end
end

function Width(mod)
&#9;local max = 0
&#9;for _1, a in ipairs(mod:GetChildren()) do
&#9;&#9;if a:IsA(&quot;BasePart&quot;) then
&#9;&#9;&#9;for _2, b in ipairs(mod:GetChildren()) do
&#9;&#9;&#9;&#9;if b:IsA(&quot;BasePart&quot;) then
&#9;&#9;&#9;&#9;&#9;local diff = (a.Position - b.Position).magnitude
&#9;&#9;&#9;&#9;&#9;if diff &gt; max then
&#9;&#9;&#9;&#9;&#9;&#9;max = diff
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
&#9;return max
end

function Tanks(f)
&#9;local T = player.Character:findFirstChild(&quot;Tanks&quot;) or new(&quot;Model&quot;, player.Character)
&#9;T.Name = &quot;Tanks&quot;
&#9;for _, v in ipairs(T:GetChildren()) do
&#9;&#9;f(v)
&#9;end
end

function CanAttack(t)
&#9;local p = game.Players:playerFromCharacter(t.Parent.Parent)
&#9;if p then
&#9;&#9;local k1, k2 = p.leaderstats.KOs.Value, player.leaderstats.KOs.Value
&#9;&#9;return ((k1 &gt; 400 and k2 &gt; 400) or (k1 &lt;= 400 and k2 &lt;= 400)) and (not player.Allies:findFirstChild(p.Name)) and (not p.Allies:findFirstChild(player.Name))
&#9;&#9;--return (not player.Allies:findFirstChild(p.Name)) and (not p.Allies:findFirstChild(player.Name))
&#9;end
&#9;return false
end

function NoFire(t)
&#9;local label = player.PlayerGui.ScreenGui.NoFire.Label
&#9;label.TextTransparency = 0
&#9;label.TextStrokeTransparency = 0
&#9;label.Text = &quot;You cannot attack this player.&quot;
&#9;local p = game.Players:playerFromCharacter(t.Parent.Parent)
&#9;if not p then return end
&#9;local k1, k2 = p.leaderstats.KOs.Value, player.leaderstats.KOs.Value
&#9;if not (k1 &gt; 400 and k2 &gt; 400) or not (k1 &lt;= 400 and k2 &lt;= 400) then
&#9;&#9;if k2 &gt; k1 then
&#9;&#9;&#9;label.Text = &quot;You have too many KOs to attack this player. (400+ KOs)&quot;
&#9;&#9;else
&#9;&#9;&#9;label.Text = &quot;You do not have enough KOs to attack this player. (400+ KOs)&quot;
&#9;&#9;end
&#9;elseif not (k1 &gt; 5000 and k2 &gt; 5000) or not (k1 &lt;= 5000 and k2 &lt;= 5000) then
&#9;&#9;if k2 &gt; k1 then
&#9;&#9;&#9;label.Text = &quot;You have too many KOs to attack this player. (5000+ KOs)&quot;
&#9;&#9;else
&#9;&#9;&#9;label.Text = &quot;You do not have enough KOs to attack this player. (5000+ KOs)&quot;
&#9;&#9;end
&#9;elseif player.Allies:findFirstChild(p.Name) and p.Allies:findFirstChild(player.Name) then
&#9;&#9;label.Text = &quot;You are allies with this player!&quot;
&#9;end
&#9;wait(1)
&#9;for i = 0, 1, .1 do
&#9;&#9;wait(.1)
&#9;&#9;label.TextTransparency = i
&#9;&#9;label.TextStrokeTransparency = i
&#9;end
end

local mHit = Vector3.new(0, 1, 0)

function Attack()
&#9;if not attack then return end
&#9;if not attack.Parent then return end
&#9;if CanAttack(attack.Parent) then
&#9;&#9;Tanks(function(a)
&#9;&#9;&#9;if not a then return end
&#9;&#9;&#9;Delay(0, function()
&#9;&#9;&#9;&#9;if not attack then return end
&#9;&#9;&#9;&#9;if not attack.Parent then return end
&#9;&#9;&#9;&#9;if (attack.Position - a.Head.Position).magnitude &lt;= a.Range.Value + (Width(attack.Parent)/2) then
&#9;&#9;&#9;&#9;&#9;a.Head.Move.velocity = Vector3.new(0, 0, 0)
&#9;&#9;&#9;&#9;&#9;a.Head.BodyGyro.cframe = CFrame.new(a.Head.Position*Vector3.new(1, 0, 1), attack.Position*Vector3.new(1, 0, 1))
&#9;&#9;&#9;&#9;&#9;fire(a, attack.Parent)
&#9;&#9;&#9;&#9;&#9;wait(2)
&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;a.Head.Move.velocity = CFrame.new(a.Head.Position, attack.Position).lookVector*a.Speed.Value
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end)
&#9;&#9;end)
&#9;&#9;wait(3)
&#9;else
&#9;&#9;NoFire(attack.Parent)
&#9;end
&#9;if mHit ~= Vector3.new(0, 1, 0) and player.Controls.Value == &quot;Click&quot; then
&#9;&#9;Tanks(function(a)
&#9;&#9;&#9;a.Head.Move.velocity = CFrame.new(a.Head.Position, mHit).lookVector*a.Speed.Value
&#9;&#9;&#9;repeat wait(.1) until (a.Head.Position*Vector3.new(1, 0, 1) - mHit*Vector3.new(1, 0, 1)).magnitude &lt;= a.Shield.Shield.Size.X or attack
&#9;&#9;&#9;if not attack then
&#9;&#9;&#9;&#9;a.Head.Move.velocity = Vector3.new(0, 0, 0)
&#9;&#9;&#9;end
&#9;&#9;end)
&#9;end
&#9;mHit = Vector3.new(0, 1, 0)
end
Delay(0, function()
&#9;while wait(.5) do
&#9;&#9;Attack()
&#9;end
end)

local tanks = lighting.Tanks
local tank = tanks:findFirstChild(&quot;Tank&quot;):clone()

script.Parent.Selected:connect(function(mouse)
&#9;local T = player.Character:findFirstChild(&quot;Tanks&quot;) or new(&quot;Model&quot;, player.Character)
&#9;T.Name = &quot;Tanks&quot;
&#9;if not T:findFirstChild(&quot;Tank&quot;) then
&#9;&#9;tank.Parent = T
&#9;&#9;tank:MoveTo(player.Character.Torso.Position + player.Character.Torso.CFrame.lookVector*(Width(tank)*1.5))
&#9;&#9;tank:MakeJoints()
&#9;&#9;local lvl, exp = new(&quot;IntValue&quot;, tank), new(&quot;IntValue&quot;, tank)
&#9;&#9;lvl.Name, exp.Name = &quot;Level&quot;, &quot;Exp&quot;
&#9;&#9;local ts = lighting.TankScript:clone()
&#9;&#9;ts.Parent = tank
&#9;&#9;ts.Disabled = false
&#9;&#9;for _, v in ipairs(tank:GetChildren()) do
&#9;&#9;&#9;if v:IsA(&quot;BasePart&quot;) then
&#9;&#9;&#9;&#9;if v.BrickColor == BrickColor.new(&quot;Bright yellow&quot;) then
&#9;&#9;&#9;&#9;&#9;new(&quot;IntValue&quot;, v).Name = &quot;PART1&quot;
&#9;&#9;&#9;&#9;&#9;v.BrickColor = player.PART1.Value
&#9;&#9;&#9;&#9;elseif v.BrickColor == BrickColor.new(&quot;Bright blue&quot;) then
&#9;&#9;&#9;&#9;&#9;new(&quot;IntValue&quot;, v).Name = &quot;PART2&quot;
&#9;&#9;&#9;&#9;&#9;v.BrickColor = player.PART2.Value
&#9;&#9;&#9;&#9;elseif v.BrickColor == BrickColor.new(&quot;Br. yellowish green&quot;) then
&#9;&#9;&#9;&#9;&#9;new(&quot;IntValue&quot;, v).Name = &quot;PART3&quot;
&#9;&#9;&#9;&#9;&#9;v.BrickColor = player.PART3.Value
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
&#9;local down = false
&#9;mouse.Move:connect(function()
&#9;&#9;if down and math.random(1, 5) == 1 then
&#9;&#9;&#9;Tanks(function(a)
&#9;&#9;&#9;&#9;a.Head.Move.maxForce = Vector3.new(1e10, 0, 1e10)
&#9;&#9;&#9;&#9;a.Head.Move.velocity = CFrame.new(a.Head.Position, mouse.Hit.p).lookVector*a.Speed.Value
&#9;&#9;&#9;end)
&#9;&#9;end
&#9;end)
&#9;mouse.Button1Down:connect(function()
&#9;&#9;attack = nil
&#9;&#9;wait()
&#9;&#9;if mouse.Target then
&#9;&#9;&#9;if mouse.Target.Parent:findFirstChild(&quot;TankScript&quot;) then
&#9;&#9;&#9;&#9;local p = game.Players:playerFromCharacter(mouse.Target.Parent.Parent.Parent)
&#9;&#9;&#9;&#9;if p then
&#9;&#9;&#9;&#9;&#9;if CanAttack(p.Character.Tanks.Tank) then
&#9;&#9;&#9;&#9;&#9;&#9;if mouse.Target.Parent.Parent ~= player.Character.Tanks then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;attack = mouse.Target.Parent:findFirstChild(&quot;Head&quot;)
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;&#9;NoFire(p.Character.Tanks.Tank)
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;if not attack then
&#9;&#9;&#9;if player.Controls.Value == &quot;Click&quot; then
&#9;&#9;&#9;&#9;if mouse.Target then
&#9;&#9;&#9;&#9;&#9;mHit = mouse.Hit.p*Vector3.new(1, 0, 1)
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;elseif player.Controls.Value == &quot;Drag&quot; then
&#9;&#9;&#9;&#9;down = true
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end)
&#9;mouse.Button1Up:connect(function()
&#9;&#9;if down then
&#9;&#9;&#9;down = false
&#9;&#9;&#9;wait(.1)
&#9;&#9;&#9;Tanks(function(a)
&#9;&#9;&#9;&#9;a.Head.Move.velocity = Vector3.new(0, 0, 0)
&#9;&#9;&#9;end)
&#9;&#9;end
&#9;end)
end)</ProtectedString>
				</Properties>
			</Item>
		</Item>
	</Item>
