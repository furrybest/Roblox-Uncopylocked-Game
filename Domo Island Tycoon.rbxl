				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">You Met the Creator!</string>
				<ProtectedString name="Source">--BADGE!!1 
--AMAZING?

person = &quot;Supasonic4ever&quot; --Put your name here.
badgeid = 63673858 --Put your badgeId here

game.Players.PlayerAdded:connect(function(p)
for i, v in ipairs(game.Players:GetChildren()) do
if v.Name:lower() == person:lower() then
for _, badge in ipairs (game.Players:GetChildren()) do
game:GetService(&quot;BadgeService&quot;):AwardBadge(badge.userId, badgeid)
end
end
end
end)</ProtectedString>
