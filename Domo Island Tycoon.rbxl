								<string name="Name">Script</string>
								<ProtectedString name="Source">money = script.Parent.Parent.Money

function onTouched(hit)
&#9;if hit.Name == &quot;TycoonBrick&quot; then
&#9;hit:remove()
&#9;money.Value = money.Value + 25
&#9;elseif hit.Name == &quot;UpgradedTycoonBrick&quot; then
&#9;hit:remove()
&#9;money.Value = money.Value + 50
&#9;end
end

script.Parent.Touched:connect(onTouched)</ProtectedString>
