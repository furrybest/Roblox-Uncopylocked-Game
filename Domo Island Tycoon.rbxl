								<Item class="Script" referent="RBX14705">
									<Properties>
										<bool name="Disabled">true</bool>
										<Content name="LinkedSource"><null></null></Content>
										<string name="Name">Script</string>
										<ProtectedString name="Source">bin = script.Parent
VS = bin.VehicleSeat
RTurn = false
LTurn = false
MoveR = false
MoveF = false
NotMoving = true 
engine = script.Parent.Base
position = engine.Velocity
bin.Base.BG.cframe = bin.Base.CFrame

function DirChng()
if VS.Steer == 1 then 
&#9;RTurn = true
&#9;&#9;while RTurn do
&#9;&#9;&#9;bin.Base.BG.cframe = bin.Base.CFrame * CFrame.fromEulerAnglesXYZ(0, -VS.TurnSpeed, 0)
&#9;&#9;&#9;wait(0.1)
&#9;&#9;end
else if VS.Steer == -1 then 
&#9;LTurn = true 
&#9;&#9;while LTurn do
&#9;&#9;&#9;bin.Base.BG.cframe = bin.Base.CFrame * CFrame.fromEulerAnglesXYZ(0, VS.TurnSpeed, 0)
&#9;&#9;&#9;wait(0.1)
&#9;&#9;end
else if VS.Steer == 0 then 
&#9;RTurn = false
&#9;LTurn = false 
end
end
end
end

VS.Changed:connect(DirChng)
</ProtectedString>
