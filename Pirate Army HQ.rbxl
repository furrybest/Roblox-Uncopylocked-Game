						<ProtectedString name="Source">function onTouched(part)
	local h = part.Parent:findFirstChild(&quot;Humanoid&quot;)
	if h~=nil then 
		h.Health = 100
	end
end

script.Parent.Touched:connect(onTouched)
</ProtectedString>
