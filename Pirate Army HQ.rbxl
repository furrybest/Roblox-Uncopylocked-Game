				<string name="Name">Regen Scene</string>
				<ProtectedString name="Source">model= game.Workspace.Castle
messageText = &quot;Regenerating Castle...&quot;

message = Instance.new(&quot;Message&quot;)
message.Text = messageText
backup = model:clone()

while true do
	wait(400) -- regenerate this model every 300 seconds

	message.Parent = game.Workspace
	model:remove()

	wait(4) -- display regen message for 4 seconds

	model = backup:clone()
	model.Parent = game.Workspace
	model:makeJoints()
	message.Parent = nil
end</ProtectedString>
				<bool name="archivable">true</bool>
			</Properties>
