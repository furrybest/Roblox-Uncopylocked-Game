&#9;rain2.Disabled = false
&#9;end
&#9;if (myCharacter:findFirstChild(&quot;Left Leg&quot;):findFirstChild(&quot;rain&quot;) == nil) then
&#9;rain3.Parent = myCharacter:findFirstChild(&quot;Left Leg&quot;)
&#9;rain3.Disabled = false&#9;
&#9;end
&#9;if (myCharacter:findFirstChild(&quot;Right Leg&quot;):findFirstChild(&quot;rain&quot;) == nil) then
&#9;rain4.Parent = myCharacter:findFirstChild(&quot;Right Leg&quot;)
&#9;rain4.Disabled = false
&#9;end
&#9;if (myCharacter:findFirstChild(&quot;Left Arm&quot;):findFirstChild(&quot;rain&quot;) == nil) then
&#9;rain5.Parent = myCharacter:findFirstChild(&quot;Left Arm&quot;)
&#9;rain5.Disabled = false
&#9;end
end

function onUnequipped()
lolz = game.Players:GetPlayerFromCharacter(myCharacter)
if lolz then
&#9;lolz.Character:findFirstChild(&quot;Left Arm&quot;).Mesh:remove()
&#9;lolz.Character:findFirstChild(&quot;Torso&quot;).Mesh:remove()
