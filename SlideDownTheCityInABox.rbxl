							<string name="Name">ThumbnailFixer</string>
							<ProtectedString name="Source">Tool = script.Parent
Handle = Tool:WaitForChild(&quot;Handle&quot;)

Tool.Grip = CFrame.new(1.40000021, 1.96000028, -1.4000001, 1, 0, 0, 0, 1, -3.9340253e-007, 0, 3.9340253e-007, 1)</ProtectedString>
						</Properties>
					</Item>
					<Item class="Script" referent="RBX1746">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">SoundManager</string>
							<ProtectedString name="Source">Tool = script.Parent
Handle = Tool:WaitForChild(&quot;Handle&quot;)

SoundInput = Tool:WaitForChild(&quot;SoundInput&quot;)

Variables = {}

function Split(String, Divider)
&#9;local Results = {}
&#9;local Number = 1
&#9;for i = 1, string.len(String) do
&#9;&#9;if string.sub(String, i, i + (string.len(Divider) - 1)) == Divider then
&#9;&#9;&#9;if string.sub(String, Number, (i - 1)) ~= &quot;&quot; then
&#9;&#9;&#9;&#9;table.insert(Results, string.sub(String, Number, (i - 1)))
&#9;&#9;&#9;end
&#9;&#9;&#9;Number = (i + string.len(Divider))
&#9;&#9;end
&#9;end
&#9;if string.sub(String, Number) ~= &quot;&quot; then
&#9;&#9;table.insert(Results, string.sub(String, Number))
&#9;end
&#9;return Results
end

SoundInput.Changed:connect(function()
&#9;if SoundInput.Value ~= &quot;&quot; then
&#9;&#9;local SoundInputValue = string.gsub(SoundInput.Value, &quot;, &quot;, &quot;,&quot;)
&#9;&#9;SoundInputValue = string.gsub(SoundInputValue, &quot; = &quot;, &quot;=&quot;)
&#9;&#9;local Values = Split(SoundInputValue, &quot;,&quot;)
&#9;&#9;for i, v in pairs(Values) do
&#9;&#9;&#9;if string.find(v, &quot;=&quot;) then
&#9;&#9;&#9;&#9;local Variable = string.sub(v, 1, (string.find(v, &quot;=&quot;) - 1))
&#9;&#9;&#9;&#9;local Value = string.sub(v, (string.find(v, &quot;=&quot;) + 1), string.len(v))
&#9;&#9;&#9;&#9;Variables[Variable] = Value
&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;local Sound = Handle:FindFirstChild(Variables.Name)
&#9;&#9;if Sound then
&#9;&#9;&#9;if string.lower(Variables.IsPlaying) == string.lower(&quot;true&quot;) then
&#9;&#9;&#9;&#9;Sound:Play()
&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;Sound:Stop()
&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;SoundInput.Value = &quot;&quot;
&#9;end
end)</ProtectedString>
						</Properties>
