								<float name="Volume">0.5</float>
							</Properties>
						</Item>
					</Item>
					<Item class="Animation" referent="RBX1392">
						<Properties>
							<Content name="AnimationId"><url>http://www.roblox.com/Asset?ID=31319431</url></Content>
							<string name="Name">StandStill</string>
						</Properties>
					</Item>
					<Item class="LocalScript" referent="RBX1393">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">JetpackScript</string>
							<ProtectedString name="Source">--Made by Luckymaxer

Tool = script.Parent
Handle = Tool:WaitForChild(&quot;Handle&quot;)

Players = game:GetService(&quot;Players&quot;)

CurrentFuel = Tool:WaitForChild(&quot;CurrentFuel&quot;)
StandStill = Tool:WaitForChild(&quot;StandStill&quot;)
FuelGui = Tool:WaitForChild(&quot;FuelGui&quot;)

EngineFail = Handle:WaitForChild(&quot;EngineFail&quot;)
InitialThrust = Handle:WaitForChild(&quot;InitialThrust&quot;)
LowFuelWarning = Handle:WaitForChild(&quot;LowFuelWarning&quot;)
ThrustingAnim = Handle:WaitForChild(&quot;Thrusting&quot;)

CurrentCamera = game:GetService(&quot;Workspace&quot;).CurrentCamera

Mass = 0
EqualizingForce = 236 / 1.2 -- amount of force required to levitate a mass
Gravity = 0.80 -- things float at &gt; 1

MaxFuel = 1300

Fuel = CurrentFuel.Value
Gui = nil
Anim = nil
JetPack = nil
Regen = false

Force = Instance.new(&quot;BodyVelocity&quot;)
Force.velocity = Vector3.new(0, 0, 0)

BodyGyro = Instance.new(&quot;BodyGyro&quot;)
BodyGyro.P = 20000
BodyGyro.D = 8000     
BodyGyro.maxTorque = Vector3.new(BodyGyro.P, BodyGyro.P, BodyGyro.P)

function UpdateGui()
&#9;if Gui then
&#9;&#9;local Frame = Gui:FindFirstChild(&quot;Frame&quot;)
&#9;&#9;if Frame then
&#9;&#9;&#9;Frame.Size = UDim2.new(0, 32, 0.45 * (CurrentFuel.Value / MaxFuel), 0)
&#9;&#9;&#9;Frame.Position = UDim2.new(0.903, 0, 0.2 + (0.45 * (1 - CurrentFuel.Value / MaxFuel)), 0)
&#9;&#9;end
&#9;end 
end

function Thrust()
&#9;if Fuel &gt; 0 then
&#9;&#9;Thrusting = true
&#9;&#9;Force.Parent = Torso
&#9;&#9;Fire.Enabled = true
&#9;&#9;LeftSmoke.Enabled = true
&#9;&#9;RightSmoke.Enabled = true
&#9;&#9;InitialThrust:Play()
&#9;&#9;BodyGyro.Parent = Torso
&#9;&#9;while Thrusting do
&#9;&#9;&#9;BodyGyro.cframe = CurrentCamera.CoordinateFrame
&#9;&#9;&#9;Force.velocity = Vector3.new(0, CurrentCamera.CoordinateFrame.lookVector.unit.y, 0) * 50
&#9;&#9;&#9;Fuel = Fuel - 1
&#9;&#9;&#9;CurrentFuel.Value = Fuel
&#9;&#9;&#9;if Fuel &lt;= 0 then
&#9;&#9;&#9;&#9;EngineFail:Play()
&#9;&#9;&#9;&#9;CutEngine()
&#9;&#9;&#9;end
&#9;&#9;&#9;UpdateGui()
&#9;&#9;&#9;wait()
&#9;&#9;&#9;ThrustingAnim:Play()
&#9;&#9;&#9;if Fuel &lt;= 200 then
&#9;&#9;&#9;&#9;LowFuelWarning:Play()
&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;ThrustingAnim:Stop()
&#9;&#9;LowFuelWarning:Stop()
&#9;end
end

function CutEngine()
&#9;Thrusting = false
&#9;Fire.Enabled = false
&#9;LeftSmoke.Enabled = false
&#9;RightSmoke.Enabled = false
&#9;Force.velocity = Vector3.new(0, 0, 0)
&#9;Force.Parent = nil
&#9;Anim:Stop()
&#9;BodyGyro.Parent = nil
end

function RecursiveGetLift(Parent)
&#9;local TotalMass = 0
&#9;for i, v in pairs(Parent:GetChildren()) do
&#9;&#9;if v:IsA(&quot;BasePart&quot;) then
&#9;&#9;&#9;if Head and Head.Parent and (v.Position - Head.Position).magnitude &lt; 10 then
&#9;&#9;&#9;&#9;TotalMass = TotalMass + (v:GetMass() * EqualizingForce * 1)
&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;TotalMas = TotalMass + (v:GetMass() * EqualizingForce * Gravity)
&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;TotalMass = TotalMass + RecursiveGetLift(v)
&#9;end
&#9;return TotalMass
end

function RegenFuel()
&#9;while Regen do
&#9;&#9;if Fuel &lt; MaxFuel then
&#9;&#9;&#9;Fuel = Fuel + 1
&#9;&#9;&#9;CurrentFuel.Value = Fuel
&#9;&#9;&#9;UpdateGui()
&#9;&#9;end
&#9;&#9;wait(0.2)
&#9;end
end

function EquipJetPack()

&#9;JetPack = Handle:clone()
&#9;JetPack.CanCollide = false
&#9;JetPack.Name = &quot;JetPack&quot;

&#9;Handle.Transparency = 1

&#9;local Weld = Instance.new(&quot;Weld&quot;)
&#9;Weld.Part0 = JetPack
&#9;Weld.Part1 = Torso
&#9;Weld.C0 = CFrame.new(Vector3.new(0, 0.25, -1.25)) * CFrame.Angles(0, 0, 0)
&#9;Weld.Parent = JetPack

&#9;FirePart = Instance.new(&quot;Part&quot;)
&#9;FirePart.Name = &quot;FirePart&quot;
&#9;FirePart.Shape = Enum.PartType.Block
&#9;FirePart.Material = Enum.Material.Plastic
&#9;FirePart.FormFactor = Enum.FormFactor.Custom
&#9;FirePart.TopSurface = Enum.SurfaceType.Smooth
&#9;FirePart.BottomSurface = Enum.SurfaceType.Smooth
&#9;FirePart.Transparency = 1
&#9;FirePart.Anchored = false
&#9;FirePart.CanCollide = false
&#9;FirePart.Locked = true
&#9;FirePart.Size = Vector3.new(1, 0.4, 1)
&#9;FirePart.Parent = JetPack

&#9;Fire = Instance.new(&quot;Fire&quot;)
&#9;Fire.Heat = -12
&#9;Fire.Size = 4
&#9;Fire.Enabled = false
&#9;Fire.Parent = FirePart

&#9;local FireWeld = Instance.new(&quot;Weld&quot;)
&#9;FireWeld.Part0 = FirePart
&#9;FireWeld.Part1 = JetPack
&#9;FireWeld.C0 = CFrame.new(Vector3.new(0, 2, 0))
&#9;FireWeld.Parent = FirePart
&#9;
&#9;LeftSmokePart = Instance.new(&quot;Part&quot;)
&#9;LeftSmokePart.Name = &quot;LeftSmokePart&quot;
&#9;LeftSmokePart.Shape = Enum.PartType.Block
&#9;LeftSmokePart.Material = Enum.Material.Plastic
&#9;LeftSmokePart.FormFactor = Enum.FormFactor.Custom
&#9;LeftSmokePart.TopSurface = Enum.SurfaceType.Smooth
&#9;LeftSmokePart.BottomSurface = Enum.SurfaceType.Smooth
&#9;LeftSmokePart.Transparency = 1
&#9;LeftSmokePart.Anchored = false
&#9;LeftSmokePart.CanCollide = false
&#9;LeftSmokePart.Locked = true
&#9;LeftSmokePart.Size = Vector3.new(1, 0.4, 1)
&#9;LeftSmokePart.Parent = JetPack

&#9;LeftSmoke = Instance.new(&quot;Smoke&quot;)
&#9;LeftSmoke.Color = BrickColor.new(&quot;Institutional white&quot;).Color
&#9;LeftSmoke.Opacity = 0.25
&#9;LeftSmoke.RiseVelocity = 0
&#9;LeftSmoke.Size = 0.1
&#9;LeftSmoke.Enabled = false
&#9;LeftSmoke.Parent = LeftSmokePart

&#9;local LeftSmokeWeld = Instance.new(&quot;Weld&quot;)
&#9;LeftSmokeWeld.Part0 = LeftSmokePart
&#9;LeftSmokeWeld.Part1 = JetPack
&#9;LeftSmokeWeld.C0 = CFrame.new(Vector3.new(1.25, 1.5, 0))
&#9;LeftSmokeWeld.Parent = LeftSmokePart
&#9;
&#9;RightSmokePart = Instance.new(&quot;Part&quot;)
&#9;RightSmokePart.Name = &quot;RightSmokePart&quot;
&#9;RightSmokePart.Shape = Enum.PartType.Block
&#9;RightSmokePart.Material = Enum.Material.Plastic
&#9;RightSmokePart.FormFactor = Enum.FormFactor.Custom
&#9;RightSmokePart.TopSurface = Enum.SurfaceType.Smooth
&#9;RightSmokePart.BottomSurface = Enum.SurfaceType.Smooth
&#9;RightSmokePart.Transparency = 1
&#9;RightSmokePart.Anchored = false
&#9;RightSmokePart.CanCollide = false
&#9;RightSmokePart.Locked = true
&#9;RightSmokePart.Size = Vector3.new(1, 0.4, 1)
&#9;RightSmokePart.Parent = JetPack

&#9;RightSmoke = Instance.new(&quot;Smoke&quot;)
&#9;RightSmoke.Color = BrickColor.new(&quot;Institutional white&quot;).Color
&#9;RightSmoke.Opacity = 0.25
&#9;RightSmoke.RiseVelocity = 0
&#9;RightSmoke.Size = 0.1
&#9;RightSmoke.Enabled = false
&#9;RightSmoke.Parent = RightSmokePart

&#9;local RightSmokeWeld = Instance.new(&quot;Weld&quot;)
&#9;RightSmokeWeld.Part0 = RightSmokePart
&#9;RightSmokeWeld.Part1 = JetPack
&#9;RightSmokeWeld.C0 = CFrame.new(Vector3.new(-1.25, 1.5, 0))
&#9;RightSmokeWeld.Parent = RightSmokePart
&#9;
&#9;JetPack.Parent = Character
&#9;
end

function Equipped(Mouse)
&#9;Character = Tool.Parent
&#9;Player = Players:GetPlayerFromCharacter(Character)
&#9;Humanoid = Character:FindFirstChild(&quot;Humanoid&quot;)
&#9;Head = Character:FindFirstChild(&quot;Head&quot;)
&#9;Torso = Character:FindFirstChild(&quot;Torso&quot;)
&#9;if not Player or not Humanoid or Humanoid.Health == 0 or not Head or not Torso then
&#9;&#9;return
&#9;end
&#9;wait()
&#9;EquipJetPack()
&#9;
&#9;Mass = RecursiveGetLift(Character)
&#9;Force.P = Mass * 10
&#9;Force.maxForce = Vector3.new(0, Force.P, 0)
&#9;Mouse.Button1Down:connect(Thrust)
&#9;Mouse.Button1Up:connect(CutEngine)
&#9;Anim = Humanoid:LoadAnimation(StandStill)
&#9;if Anim then
&#9;&#9;Anim:Play()
&#9;end
&#9;Gui = FuelGui:Clone()
&#9;UpdateGui()
&#9;Gui.Parent = Player:FindFirstChild(&quot;PlayerGui&quot;)
&#9;Regen = true
&#9;RegenFuel()
end

function Unequipped()
&#9;Regen = false
&#9;if Force and Force.Parent then
&#9;&#9;Force.Parent = nil
&#9;end
&#9;if BodyGyro and BodyGyro.Parent then
&#9;&#9;BodyGyro.Parent = nil
&#9;end
&#9;if Anim then
&#9;&#9;Anim:Stop()
&#9;end
&#9;if Gui and Gui.Parent then
&#9;&#9;Gui:Destroy()
&#9;end
&#9;if JetPack and JetPack.Parent then
&#9;&#9;JetPack:Destroy()
&#9;end
&#9;Handle.Transparency = 0
&#9;Thrusting = false 
end

Tool.Equipped:connect(Equipped)
Tool.Unequipped:connect(Unequipped)</ProtectedString>
