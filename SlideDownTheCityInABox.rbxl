		<Item class="Script" referent="RBX6849">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">RegenScript</string>
				<ProtectedString name="Source">---Place this INSIDE the model. Don&apos;t replace the model name or anything
------------------------------------------------------------------------------------------ 
object = script.Parent --leave this alone
if (object ~= nil) and (object ~= game.Workspace) then --Leave this alone
model = object --Leave this alone
messageText = &quot;regenerating &quot; .. model.Name .. &quot;&quot; --LEAVE THIS ALONE OR IT WILL NOT WORK

message = Instance.new(&quot;Message&quot;) --Leave this alone
message.Text = messageText -- Leave this alone
backup = model:clone() -- Leave this alone
waitTime = 1200 --Time to wait between regenerations 
wait(math.random(0, waitTime)) --Leave this alone
while true do  -- Leave this alone
wait(waitTime) -- Regen wait time 

message.Parent = game.Workspace --Leave this alone
model:remove() --leave this alone

wait(2.5) -- Display regen message for this amount of time 

model = backup:clone() --leave this alone
model.Parent = game.Workspace --leave this alone
model:makeJoints() --leave this alone
message.Parent = nil --Leave this alone
end --DO NOT MESS WITH END&apos;S
end 
------------------------------------------------------------------------------------------ 
</ProtectedString>
			</Properties>
		</Item>
