							<string name="Name">Remover</string>
							<ProtectedString name="Source">--Robug Labs--
&#9;&#9;--Just put this in the drivers seat and it should remove the vehicle when the player gets out--

function add(p)
&#9;script.Parent.ChildRemoved:connect(function()
&#9;&#9;local seat = script.Parent:FindFirstChild(&quot;SeatWeld&quot;)
&#9;&#9;if seat ~= nil then return end
&#9;&#9;wait(0.1)
&#9;&#9;script.Parent.Parent:remove()  --Make sure this removes the whole vehicle and not just a part of it (You might have to add another .Parent)--
&#9;end)
&#9;
end

script.Parent.ChildAdded:connect(add)
</ProtectedString>
						</Properties>
					</Item>
				</Item>
