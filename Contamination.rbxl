			<Item class="Script" referent="RBX2141">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">ActivateScript</string>
					<ProtectedString name="Source">while true do
&#9;wait()
&#9;if game.Workspace.MainScript.Game.Value == false and script.Parent.Parent.Parent.Playing.Value == true then
&#9;&#9;for n = 1,20 do
&#9;&#9;script.Parent.Parent.Parent.Character.Humanoid.Sit = true
&#9;&#9;&#9;wait()
&#9;&#9;&#9;script.Parent.Blackout.BackgroundTransparency = script.Parent.Blackout.BackgroundTransparency - 0.05
&#9;&#9;end
&#9;&#9;script.Parent.Parent.Parent.Character.Head:Remove()
&#9;&#9;wait(20)
&#9;end
end
</ProtectedString>
				</Properties>
			</Item>
