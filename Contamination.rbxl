		<Item class="Script" referent="RBX1682">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">AutoFixScript</string>
				<ProtectedString name="Source">backup_script = game.Workspace.MainScript:Clone()
backup_script.Parent = game.Lighting
backup_script.Disabled = true
timer = 0

function reset_timer()
&#9;timer = 0
end

game.Workspace.MainScript.Message.Changed:connect(reset_timer)

function check_gameitems()
&#9;local check = game.Workspace:FindFirstChild(&quot;GameItems&quot;)
&#9;if check ~= nil then
&#9;&#9;check:Remove()
&#9;end
end

function check_landscape()
&#9;local check = game.Workspace:FindFirstChild(&quot;Landscape&quot;)
&#9;if check ~= nil then
&#9;&#9;check:Remove()
&#9;end
end

function regen()
&#9;local clone = game.Lighting.MainScript:Clone()
&#9;clone.Parent = game.Workspace
&#9;clone.Disabled = false
&#9;game.Workspace.MainScript:Remove()
&#9;check_gameitems()
&#9;check_landscape()
&#9;wait(5)
&#9;local gameitems_clone = game.Lighting.GameItems:Clone()
&#9;gameitems_clone.Parent = game.Workspace
&#9;gameitems_clone:MakeJoints()
&#9;local landscape_clone = game.Lighting.Landscape:Clone()
&#9;landscape_clone.Parent = game.Workspace
&#9;landscape_clone:MakeJoints()
&#9;game.Workspace.MainScript.Message.Changed:connect(reset_timer)
end

while true do
&#9;wait(1)
&#9;timer = timer + 1
&#9;if timer == 30 then
&#9;&#9;regen()
&#9;&#9;wait(20)
&#9;&#9;timer = 0
&#9;end
end

</ProtectedString>
			</Properties>
		</Item>
		<Item class="BoolValue" referent="RBX1683">
