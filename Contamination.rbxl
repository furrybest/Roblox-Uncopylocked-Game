			<Item class="LocalScript" referent="RBX5683">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Local Gui Key</string>
					<ProtectedString name="Source">r = game:service(&quot;RunService&quot;)



local Tool = script.Parent
local mload = Tool.meele
local team = Tool.Team
MaxAmmo = script.Parent.Bullets.Value

local isOn = false

function reload()
&#9;enabled = false
&#9;Tool.Enabled = false
&#9;script.Parent.Handle.Reload:play()
&#9;script.Parent.Clip.Transparency = 1
&#9;script.Parent.Clip2.Transparency = 1
&#9;script.Parent.Clip3.Transparency = 1
&#9;script.Parent.Clip4.Transparency = 1
&#9;script.Parent.Clip5.Transparency = 1
&#9;script.Parent.Clip6.Transparency = 1
&#9;script.Parent.Clip7.Transparency = 1
&#9;script.Parent.Clip8.Transparency = 1
&#9;wait(1.5)
&#9;script.Parent.Clip.Transparency = 0
&#9;script.Parent.Clip2.Transparency = 0
&#9;script.Parent.Clip3.Transparency = 0
&#9;script.Parent.Clip4.Transparency = 0
&#9;script.Parent.Clip5.Transparency = 0
&#9;script.Parent.Clip6.Transparency = 0
&#9;script.Parent.Clip7.Transparency = 0
&#9;script.Parent.Clip8.Transparency = 0
&#9;script.Parent.Bullets.Value = MaxAmmo
&#9;enabled = true
&#9;Tool.Enabled = true
&#9;Tool.Name = (&quot;Sterling[&quot;..script.Parent.Bullets.Value..&quot;]&quot;)
end

function tagHumanoid(humanoid, player)
&#9;local creator_tag = Instance.new(&quot;ObjectValue&quot;)
&#9;creator_tag.Value = player
&#9;creator_tag.Name = &quot;creator&quot;
&#9;creator_tag.Parent = humanoid
end

function untagHumanoid(humanoid)
&#9;if humanoid ~= nil then
&#9;&#9;local tag = humanoid:findFirstChild(&quot;creator&quot;)
&#9;&#9;if tag ~= nil then
&#9;&#9;&#9;tag.Parent = nil
&#9;&#9;end
&#9;end
end

function onKeyDown(key)
&#9;Tool.Name = (&quot;Sterling[&quot;..script.Parent.Bullets.Value..&quot;]&quot;)
&#9;if (key~=nil) then
&#9;&#9;key = key:lower()
&#9;&#9;if (key==&quot;r&quot;)  then
&#9;&#9;&#9;reload()
&#9;&#9;end
&#9;end
end

function onEquippedLocal(mouse)

&#9;if mouse == nil then
&#9;&#9;print(&quot;Mouse not found&quot;)
&#9;&#9;return 
&#9;end

&#9;Tool.Name = (&quot;Sterling[&quot;..script.Parent.Bullets.Value..&quot;]&quot;)

&#9;mouse.KeyDown:connect(onKeyDown)
&#9;mouse.Icon = &quot;http://www.roblox.com/asset/?id=42445293&quot;
end

Tool.Equipped:connect(onEquippedLocal)
</ProtectedString>
