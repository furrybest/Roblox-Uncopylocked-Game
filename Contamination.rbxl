		<Item class="LocalScript" referent="RBX2120">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">SecondTeleportScript</string>
				<ProtectedString name="Source">destination = game.Workspace.TeleportDestinationTwo

while true do
&#9;wait()
&#9;if game.Workspace.MainScript.SecondTeleport.Value == true and script.Parent.Parent.Playing.Value == true then
&#9;&#9;script.Parent.Parent.Character.Humanoid.Sit = true
&#9;&#9;for n = 1,10000000 do
&#9;&#9;&#9;wait(0.2)
&#9;&#9;&#9;script.Parent.Parent.Character.Torso.CFrame = CFrame.new(Vector3.new(destination.Position.X,destination.Position.Y,destination.Position.Z), Vector3.new(0,destination.Position.Y,0))
&#9;&#9;&#9;if script.Parent.Parent.Character.Torso.CFrame == CFrame.new(Vector3.new(destination.Position.X,destination.Position.Y,destination.Position.Z), Vector3.new(0,destination.Position.Y,0)) then
&#9;&#9;&#9;&#9;break
&#9;&#9;&#9;end
&#9;&#9;end&#9;&#9;--script.Parent.Parent.Character.Humanoid.Health = script.Parent.Parent.Character.Humanoid.Health - math.random(50,90)
&#9;&#9;wait(20)
&#9;end
end</ProtectedString>
			</Properties>
		</Item>
		<Item class="LocalScript" referent="RBX2121">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">ThirdTeleportScript</string>
				<ProtectedString name="Source">destination = game.Workspace.TeleportDestinationThree

function zombify() 
&#9;Character = script.Parent.Parent.Character
&#9;Character[&quot;Body Colors&quot;].HeadColor = BrickColor.new(&quot;Medium green&quot;)
&#9;Character[&quot;Body Colors&quot;].LeftArmColor = BrickColor.new(&quot;Medium green&quot;)
&#9;Character[&quot;Body Colors&quot;].RightArmColor = BrickColor.new(&quot;Medium green&quot;)
&#9;Character[&quot;Body Colors&quot;].LeftLegColor = BrickColor.new(&quot;Reddish brown&quot;)
&#9;Character[&quot;Body Colors&quot;].RightLegColor = BrickColor.new(&quot;Reddish brown&quot;)
&#9;Character[&quot;Body Colors&quot;].TorsoColor = BrickColor.new(&quot;Reddish brown&quot;)
&#9;Character.Head.Mesh.MeshId = &quot;http://www.roblox.com/asset/?id=17392637&quot;
&#9;Character.Head.Mesh.TextureId = &quot;http://www.roblox.com/asset/?id=17392623&quot;
&#9;Character.Head.Mesh.Scale = Vector3.new(1,1,1)
&#9;Character.Humanoid.Name = &quot;Zombie&quot;
&#9;Character.Zombie.MaxHealth = 150
&#9;Character.Zombie.Health = 150
&#9;remove_shirt()
&#9;remove_pants()
&#9;remove_hats()
&#9;remove_tshirts()
&#9;local hurt_script = script[&quot;Chase Script&quot;]:Clone()
&#9;hurt_script.Parent = Character
&#9;hurt_script.Disabled = false
end

function remove_shirt()
&#9;local shirt = Character:FindFirstChild(&quot;Shirt&quot;)
&#9;if shirt ~= nil then
&#9;&#9;shirt:Remove()
&#9;end
end

function remove_pants()
&#9;local shirt = Character:FindFirstChild(&quot;Pants&quot;)
&#9;if shirt ~= nil then
&#9;&#9;shirt:Remove()
&#9;end
end

function remove_hats()
&#9;local d = Character:GetChildren() 
&#9;for i=1, #d do 
&#9;&#9;if (d[i].className == &quot;Hat&quot;) then 
&#9;&#9;&#9;d[i]:remove() 
&#9;&#9;end 
&#9;end
end 

function remove_tshirts()
&#9;local d = Character:GetChildren() 
&#9;for i=1, #d do 
&#9;&#9;if (d[i].className == &quot;ShirtGrahic&quot;) then 
&#9;&#9;&#9;d[i]:remove() 
&#9;&#9;end 
&#9;end
end 


while true do
&#9;wait()
&#9;if game.Workspace.MainScript.PlayerZombieTeleport.Value == true and script.Parent.Parent.Playing.Value == false then
&#9;&#9;zombify()
&#9;&#9;for n = 1,10000000 do&#9;
&#9;&#9;&#9;wait(0.1)
&#9;&#9;&#9;script.Parent.Parent.Character.Torso.CFrame = CFrame.new(Vector3.new(destination.Position.X,destination.Position.Y,destination.Position.Z), Vector3.new(0,destination.Position.Y,0))
&#9;&#9;&#9;if script.Parent.Parent.Character.Torso.CFrame == CFrame.new(Vector3.new(destination.Position.X,destination.Position.Y,destination.Position.Z), Vector3.new(0,destination.Position.Y,0)) then
&#9;&#9;&#9;&#9;break
&#9;&#9;&#9;end
&#9;&#9;end&#9;&#9;wait(20)
&#9;end
end
</ProtectedString>
			</Properties>
			<Item class="Script" referent="RBX2122">
				<Properties>
					<bool name="Disabled">true</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Chase Script</string>
					<ProtectedString name="Source">local larm = script.Parent:FindFirstChild(&quot;Left Arm&quot;)
local rarm = script.Parent:FindFirstChild(&quot;Right Arm&quot;)

--[[

function findNearestTorso(pos)
&#9;local list = game.Workspace:children()
&#9;local torso = nil
&#9;local dist = 100
&#9;local temp = nil
&#9;local human = nil
&#9;local temp2 = nil
&#9;for x = 1, #list do
&#9;&#9;temp2 = list[x]
&#9;&#9;if (temp2.className == &quot;Model&quot;) and (temp2 ~= script.Parent) then
&#9;&#9;&#9;temp = temp2:findFirstChild(&quot;Torso&quot;)
&#9;&#9;&#9;human = temp2:findFirstChild(&quot;Humanoid&quot;)
&#9;&#9;&#9;if (temp ~= nil) and (human ~= nil) and (human.Health &gt; 0) then
&#9;&#9;&#9;&#9;if (temp.Position - pos).magnitude &lt; dist then
&#9;&#9;&#9;&#9;&#9;torso = temp
&#9;&#9;&#9;&#9;&#9;dist = (temp.Position - pos).magnitude
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
&#9;return torso
end

]]

function Hit(hit)
&#9;local human = hit.Parent:FindFirstChild(&quot;Humanoid&quot;)
&#9;if human ~= nil then
&#9;&#9;human.Health =  human.Health -30
&#9;end
end

larm.Touched:connect(Hit)
rarm.Touched:connect(Hit)

--[[

while true do
&#9;wait(0.1)
&#9;local target = findNearestTorso(script.Parent.Torso.Position)
&#9;if target ~= nil then
&#9;&#9;script.Parent.Zombie:MoveTo(target.Position, target)
&#9;end
end

]]
</ProtectedString>
				</Properties>
			</Item>
		</Item>
