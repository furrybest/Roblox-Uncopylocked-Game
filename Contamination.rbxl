&#9;script.GameMusic:Stop()
&#9;script.TankMusic:Stop()
&#9;script.VictoryMusic:Stop()
&#9;script.Leader.Value = &quot;None&quot;
&#9;script.Medic.Value = &quot;None&quot;
&#9;script.Melee.Value = &quot;None&quot;
&#9;script.DeadPlayers.Value = 0
&#9;script.StartPlayers.Value = 0
&#9;game.Workspace.GameItems:Remove()
&#9;game.Workspace.Landscape:Remove()
&#9;game_clone = game.Lighting.GameItems:Clone()
&#9;landscape_clone = game.Lighting.Landscape:Clone()
&#9;wait(5)
&#9;game_clone.Parent = game.Workspace
&#9;landscape_clone.Parent = game.Workspace
&#9;game_clone:MakeJoints()
&#9;landscape_clone:MakeJoints()
&#9;script.Message.Text = &quot;You have failed.&quot;
&#9;game.Workspace.OutputText.Value = &quot;No one survived a game of Contamination.&quot;
&#9;wait(3)
&#9;script.Game.Value = false
&#9;running = false
&#9;script.Message.Text = &quot;&quot;
end

function win_game()
&#9;script.PlayerCheck.Value = false
&#9;game.Lighting.Brightness = 1
&#9;game.Workspace.GameStats.TotalWins.Value = game.Workspace.GameStats.TotalWins.Value + 1
&#9;script.GameMusic:Stop()
&#9;script.LiftMusic:Stop()
&#9;script.TankMusic:Stop()&#9;
&#9;script.VictoryMusic:Stop()
&#9;script.Leader.Value = &quot;None&quot;
&#9;script.Medic.Value = &quot;None&quot;
&#9;script.Melee.Value = &quot;None&quot;
&#9;script.DeadPlayers.Value = 0
&#9;script.StartPlayers.Value = 0
&#9;game.Workspace.GameItems:Remove()
&#9;game.Workspace.Landscape:Remove()
&#9;game_clone = game.Lighting.GameItems:Clone()
&#9;landscape_clone = game.Lighting.Landscape:Clone()
&#9;wait(10)
&#9;game_clone.Parent = game.Workspace
&#9;game_clone:MakeJoints()
&#9;landscape_clone.Parent = game.Workspace
&#9;landscape_clone:MakeJoints()
&#9;script.Message.Text = &quot;Congratulations, &quot; ..script.StartPlayers.Value - script.DeadPlayers.Value.. &quot; of you survived!&quot;
&#9;game.Workspace.OutputText.Value = &quot;&quot; ..script.StartPlayers.Value - script.DeadPlayers.Value.. &quot; of you survived Contamination.&quot;
&#9;wait(3)
&#9;script.Message.Text = &quot;&quot;
&#9;script.Game.Value = false
&#9;running = false
end

function start_game()
&#9;script.LobbyMusic:Play()
&#9;game.Workspace.OutputText.Value = &quot;Contamination will begin soon.&quot;
&#9;running = true
&#9;wait(math.random(10,20))
&#9;script.DeadPlayers.Value = 0
&#9;script.StartPlayers.Value = 0
&#9;print(&quot;Starting a new game of Contamination.&quot;)
&#9;script.Message.Text = &quot;Welcome to Contamination.&quot;
&#9;wait(3)
&#9;script.Message.Text = &quot;Contamination will begin in: 5.&quot;
&#9;script.StartSound.S1:Play()
&#9;wait(1)
&#9;script.Message.Text = &quot;Contamination will begin in: 4.&quot;
&#9;script.StartSound.S1:Play()
&#9;wait(1)
&#9;script.Message.Text = &quot;Contamination will begin in: 3.&quot;
&#9;script.StartSound.S1:Play()
&#9;wait(1)
&#9;script.Message.Text = &quot;Contamination will begin in: 2.&quot;
&#9;script.StartSound.S1:Play()
&#9;wait(1)
&#9;script.Message.Text = &quot;Contamination will begin in: 1.&quot;
&#9;script.StartSound.S1:Play()
&#9;wait(1)
&#9;script.Message.Text = &quot;Contamination will begin in: 0.&quot;
&#9;script.StartSound.S2:Play()
&#9;wait(1)
&#9;script.Message.Text = &quot;&quot;
&#9;script.Game.Value = true
&#9;script.Teleport.Value = true
&#9;--script.StartPlayers.Value = game.Players.NumPlayers
&#9;game.Workspace.OutputText.Value = &quot;A new game of Contamination has started.&quot;
&#9;script.LobbyMusic:Stop()
&#9;run_game()
end

while true do
&#9;wait(1)
&#9;if running == false then
&#9;&#9;start_game()
&#9;else
&#9;wait(5)
&#9;end
end


