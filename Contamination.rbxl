						<string name="Name">ChangeScript</string>
						<ProtectedString name="Source">Tool = script.Parent

function onEquipped(mouse)
&#9;mouse.KeyDown:connect(onKeyDown)
end

function onKeyDown(key)
&#9;key = key:lower()
&#9;if (key == &quot;c&quot;) then
&#9;&#9;local medkit = game.Lighting.ClassTools.Medkit:Clone()
&#9;&#9;medkit.Parent = game.Players[Tool.Parent.Name].Backpack
&#9;&#9;Tool:Remove()
&#9;end
end

Tool.Equipped:connect(onEquipped)</ProtectedString>
