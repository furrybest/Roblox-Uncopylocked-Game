				<Item class="LocalScript" referent="RBX2829">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Local Gui Key</string>
						<ProtectedString name="Source">r = game:service(&quot;RunService&quot;)



local Tool = script.Parent
local mload = Tool.meele
local team = Tool.Team
MaxAmmo = script.Parent.Bullets.Value

local isOn = false

function reload()
&#9;enabled = false
&#9;Tool.Enabled = false
&#9;script.Parent.Handle.Reload:play()
&#9;script.Parent.Clip.Transparency = 1
&#9;script.Parent.Clip2.Transparency = 1
&#9;script.Parent.Clip3.Transparency = 1
&#9;script.Parent.Clip4.Transparency = 1
&#9;script.Parent.Clip5.Transparency = 1
&#9;script.Parent.Clip6.Transparency = 1
&#9;script.Parent.Clip7.Transparency = 1
&#9;script.Parent.Clip8.Transparency = 1
&#9;wait(1.5)
&#9;script.Parent.Clip.Transparency = 0
&#9;script.Parent.Clip2.Transparency = 0
&#9;script.Parent.Clip3.Transparency = 0
&#9;script.Parent.Clip4.Transparency = 0
&#9;script.Parent.Clip5.Transparency = 0
&#9;script.Parent.Clip6.Transparency = 0
&#9;script.Parent.Clip7.Transparency = 0
&#9;script.Parent.Clip8.Transparency = 0
&#9;script.Parent.Bullets.Value = MaxAmmo
&#9;enabled = true
&#9;Tool.Enabled = true
&#9;Tool.Name = (&quot;Sterling[&quot;..script.Parent.Bullets.Value..&quot;]&quot;)
end

function tagHumanoid(humanoid, player)
&#9;local creator_tag = Instance.new(&quot;ObjectValue&quot;)
&#9;creator_tag.Value = player
&#9;creator_tag.Name = &quot;creator&quot;
&#9;creator_tag.Parent = humanoid
end

function untagHumanoid(humanoid)
&#9;if humanoid ~= nil then
&#9;&#9;local tag = humanoid:findFirstChild(&quot;creator&quot;)
&#9;&#9;if tag ~= nil then
&#9;&#9;&#9;tag.Parent = nil
&#9;&#9;end
&#9;end
end

function onKeyDown(key)
&#9;Tool.Name = (&quot;Sterling[&quot;..script.Parent.Bullets.Value..&quot;]&quot;)
&#9;if (key~=nil) then
&#9;&#9;key = key:lower()
&#9;&#9;if (key==&quot;r&quot;)  then
&#9;&#9;&#9;reload()
&#9;&#9;end
&#9;end
end

function onEquippedLocal(mouse)

&#9;if mouse == nil then
&#9;&#9;print(&quot;Mouse not found&quot;)
&#9;&#9;return 
&#9;end

&#9;Tool.Name = (&quot;Sterling[&quot;..script.Parent.Bullets.Value..&quot;]&quot;)

&#9;mouse.KeyDown:connect(onKeyDown)
&#9;mouse.Icon = &quot;http://www.roblox.com/asset/?id=42445293&quot;
end

Tool.Equipped:connect(onEquippedLocal)
</ProtectedString>
					</Properties>
				</Item>
				<Item class="LocalScript" referent="RBX2830">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Local Gui</string>
						<ProtectedString name="Source">local Tool = script.Parent;

enabled = true
function onButton1Down(mouse)
&#9;if not enabled then
&#9;&#9;return
&#9;end

&#9;enabled = true
&#9;mouse.Icon = &quot;http://www.roblox.com/asset/?id=42445293&quot;

&#9;--wait(.5)
&#9;--mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
&#9;--enabled = true
&#9;mouse.Button1Up:connect(function() onButton1Up(mouse) end)

end

function onButton1Up(mouse)
&#9;Tool.Name = (&quot;Sterling[&quot;..script.Parent.Bullets.Value..&quot;]&quot;)
&#9;enabled = false
&#9;Tool.Enabled = false
&#9;wait(.115)
&#9;enabled = true
&#9;Tool.Enabled = true
end

function onEquippedLocal(mouse)

&#9;if mouse == nil then
&#9;&#9;print(&quot;Mouse not found&quot;)
&#9;&#9;return 
&#9;end

&#9;Tool.Name = (&quot;Sterling[&quot;..script.Parent.Bullets.Value..&quot;]&quot;)

&#9;mouse.Icon = &quot;http://www.roblox.com/asset/?id=42445293&quot;
&#9;mouse.Button1Down:connect(function() onButton1Down(mouse) end)&#9;
&#9;mouse.Button1Up:connect(function() onButton1Up(mouse)end)

&#9;local m = Instance.new(&quot;Message&quot;)
&#9;m.Parent = game.Players.LocalPlayer
&#9;m.Text = &quot;Equipped weapon: Sterling&quot;
&#9;wait(1)
&#9;m:remove()
end


Tool.Equipped:connect(onEquippedLocal)
</ProtectedString>
					</Properties>
				</Item>
				<Item class="Script" referent="RBX2831">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">WeldArm</string>
						<ProtectedString name="Source">Tool = script.Parent;
local arms = nil
local torso = nil
local welds = {}

function Equip(mouse)
wait(0.01)
arms = {Tool.Parent:FindFirstChild(&quot;Left Arm&quot;), Tool.Parent:FindFirstChild(&quot;Right Arm&quot;)}
torso = Tool.Parent:FindFirstChild(&quot;Torso&quot;)
if arms ~= nil and torso ~= nil then
local sh = {torso:FindFirstChild(&quot;Left Shoulder&quot;), torso:FindFirstChild(&quot;Right Shoulder&quot;)}
if sh ~= nil then
local yes = true
if yes then
yes = false
sh[1].Part1 = nil
sh[2].Part1 = nil
local weld1 = Instance.new(&quot;Weld&quot;)
weld1.Part0 = torso
weld1.Parent = torso
weld1.Part1 = arms[1]
weld1.C1 = CFrame.new(-0.249, 1.35, 0.6) * CFrame.fromEulerAnglesXYZ(math.rad(290), 0, math.rad(-90))
welds[1] = weld1
local weld2 = Instance.new(&quot;Weld&quot;)
weld2.Part0 = torso
weld2.Parent = torso
weld2.Part1 = arms[2]
weld2.C1 = CFrame.new(-1, -0.2, 0.35) * CFrame.fromEulerAnglesXYZ(math.rad(-90), math.rad(-15), 0)
welds[2] = weld2
end
else
print(&quot;sh&quot;)
end
else
print(&quot;arms&quot;)
end
end

function Unequip(mouse)
if arms ~= nil and torso ~= nil then
local sh = {torso:FindFirstChild(&quot;Left Shoulder&quot;), torso:FindFirstChild(&quot;Right Shoulder&quot;)}
if sh ~= nil then
local yes = true
if yes then
yes = false
sh[1].Part1 = arms[1]
sh[2].Part1 = arms[2]
welds[1].Parent = nil
