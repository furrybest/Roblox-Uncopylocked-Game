		<Item class="Script" referent="RBX2118">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">TeleportScript</string>
				<ProtectedString name="Source">function create_value()
&#9;local value = script.Parent.Parent:FindFirstChild(&quot;Playing&quot;)
&#9;if (value == nil) then
&#9;&#9;playing = Instance.new(&quot;BoolValue&quot;)
&#9;&#9;playing.Parent = script.Parent.Parent
&#9;&#9;playing.Name = &quot;Playing&quot;
&#9;&#9;playing.Value = false
&#9;end
end

create_value()

function choose_basic(random)&#9;
&#9;if random == 1 then
&#9;&#9;local normal_clone = game.Lighting.ClassTools.Pistol:Clone()
&#9;&#9;normal_clone.Parent = script.Parent.Parent.Backpack
&#9;&#9;script.Parent.Parent.Character.Humanoid.WalkSpeed = math.random(15,17)
&#9;&#9;script.Parent.Parent.Parent.Character.Humanoid.MaxHealth = math.random(95,105)
&#9;&#9;script.Parent.Parent.Parent.Character.Humanoid.Health = script.Parent.Parent.Character.Humanoid.MaxHealth
&#9;&#9;wait(20)
&#9;elseif random == 2 then
&#9;&#9;local normal_clone = game.Lighting.ClassTools.Glock:Clone()
&#9;&#9;normal_clone.Parent = script.Parent.Parent.Backpack
&#9;&#9;script.Parent.Parent.Character.Humanoid.WalkSpeed = math.random(15,17)
&#9;&#9;script.Parent.Parent.Character.Humanoid.MaxHealth = math.random(95,105)
&#9;&#9;script.Parent.Parent.Character.Humanoid.Health = script.Parent.Parent.Character.Humanoid.MaxHealth
&#9;&#9;wait(20)
&#9;elseif random == 3 then
&#9;&#9;local normal_clone = game.Lighting.ClassTools.Derringer:Clone()
&#9;&#9;normal_clone.Parent = script.Parent.Parent.Backpack
&#9;&#9;script.Parent.Parent.Character.Humanoid.WalkSpeed = math.random(15,17)
&#9;&#9;script.Parent.Parent.Character.Humanoid.MaxHealth = math.random(95,105)
&#9;&#9;script.Parent.Parent.Character.Humanoid.Health = script.Parent.Parent.Character.Humanoid.MaxHealth
&#9;&#9;wait(20)
&#9;elseif random == 4 then
&#9;&#9;local normal_clone = game.Lighting.ClassTools.Mamba:Clone()
&#9;&#9;normal_clone.Parent = script.Parent.Parent.Backpack
&#9;&#9;script.Parent.Parent.Character.Humanoid.WalkSpeed = math.random(15,17)
&#9;&#9;script.Parent.Parent.Character.Humanoid.MaxHealth = math.random(95,105)
&#9;&#9;script.Parent.Parent.Character.Humanoid.Health = script.Parent.Parent.Character.Humanoid.MaxHealth
&#9;&#9;wait(20)
&#9;elseif random == 5 then
&#9;&#9;local normal_clone = game.Lighting.ClassTools.Walther:Clone()
&#9;&#9;normal_clone.Parent = script.Parent.Parent.Backpack
&#9;&#9;script.Parent.Parent.Character.Humanoid.WalkSpeed = math.random(15,17)
&#9;&#9;script.Parent.Parent.Character.Humanoid.MaxHealth = math.random(95,105)
&#9;&#9;script.Parent.Parent.Character.Humanoid.Health = script.Parent.Parent.Character.Humanoid.MaxHealth
&#9;&#9;wait(20)
&#9;end
end

function choose_melee(random)
&#9;if random == 1 then
&#9;&#9;game.Workspace.MainScript.Melee.Value = script.Parent.Parent.Name
&#9;&#9;local melee_clone = game.Lighting.ClassTools.MeleeBat:Clone()
&#9;&#9;melee_clone.Parent = script.Parent.Parent.Backpack
&#9;&#9;script.Parent.Parent.Character.Humanoid.WalkSpeed = math.random(18,19)
&#9;&#9;script.Parent.Parent.Character.Humanoid.MaxHealth = math.random(95,105)
&#9;&#9;script.Parent.Parent.Character.Humanoid.Health = script.Parent.Parent.Character.Humanoid.MaxHealth
&#9;&#9;wait(20)
&#9;elseif random == 2 then
&#9;&#9;game.Workspace.MainScript.Melee.Value = script.Parent.Parent.Name
&#9;&#9;local melee_clone = game.Lighting.ClassTools.MeleeWrench:Clone()
&#9;&#9;melee_clone.Parent = script.Parent.Parent.Backpack
&#9;&#9;script.Parent.Parent.Character.Humanoid.WalkSpeed = math.random(18,19)
&#9;&#9;script.Parent.Parent.Character.Humanoid.MaxHealth = math.random(95,105)
&#9;&#9;script.Parent.Parent.Character.Humanoid.Health = script.Parent.Parent.Character.Humanoid.MaxHealth
&#9;&#9;wait(20)
&#9;elseif random == 3 then
&#9;&#9;game.Workspace.MainScript.Melee.Value = script.Parent.Parent.Name
&#9;&#9;local melee_clone = game.Lighting.ClassTools.MeleeSword:Clone()
&#9;&#9;melee_clone.Parent = script.Parent.Parent.Backpack
&#9;&#9;script.Parent.Parent.Character.Humanoid.WalkSpeed = math.random(18,19)
&#9;&#9;script.Parent.Parent.Character.Humanoid.MaxHealth = math.random(95,105)
&#9;&#9;script.Parent.Parent.Character.Humanoid.Health = script.Parent.Parent.Character.Humanoid.MaxHealth
&#9;&#9;wait(20)
&#9;end
end

while true do
&#9;wait()
&#9;if game.Workspace.MainScript.Teleport.Value == true then
&#9;&#9;script.Parent.Parent.Playing.Value = true
&#9;&#9;game.Workspace.MainScript.StartPlayers.Value = game.Workspace.MainScript.StartPlayers.Value + 1
&#9;&#9;script.TeleportPlayer.Disabled = false
&#9;&#9;local graphic = script.Parent.Parent.Character:FindFirstChild(&quot;Shirt Graphic&quot;)
&#9;&#9;if graphic ~= nil and graphic.Graphic == &quot;http://www.roblox.com/asset/?id=47730520&quot; then
&#9;&#9;&#9;print(&quot;Normal VIP: Sterling&quot;)
&#9;&#9;&#9;local vip_clone = game.Lighting.ClassTools.Sterling:Clone()
&#9;&#9;&#9;vip_clone.Parent = script.Parent.Parent.Backpack
&#9;&#9;&#9;script.Parent.Parent.Character.Humanoid.WalkSpeed = math.random(18,19)
&#9;&#9;&#9;script.Parent.Parent.Character.Humanoid.MaxHealth = math.random(120,140)
&#9;&#9;&#9;script.Parent.Parent.Character.Humanoid.Health = script.Parent.Parent.Character.Humanoid.MaxHealth
&#9;&#9;&#9;wait(20)
&#9;&#9;elseif graphic ~= nil and graphic.Graphic == &quot;http://www.roblox.com/asset/?id=47780191&quot; then
&#9;&#9;&#9;print(&quot;Normal VIP: Desert Eagle&quot;)
&#9;&#9;&#9;local vip_clone2 = game.Lighting.ClassTools.DesertEagle:Clone()
&#9;&#9;&#9;vip_clone2.Name = &quot;Desert Eagle&quot;
&#9;&#9;&#9;vip_clone2.Parent = script.Parent.Parent.Backpack
&#9;&#9;&#9;script.Parent.Parent.Character.Humanoid.WalkSpeed = math.random(18,19)
&#9;&#9;&#9;script.Parent.Parent.Character.Humanoid.MaxHealth = math.random(120,140)
&#9;&#9;&#9;script.Parent.Parent.Character.Humanoid.Health = script.Parent.Parent.Character.Humanoid.MaxHealth
&#9;&#9;&#9;wait(20)
&#9;&#9;elseif script.Parent.Parent.Name == &quot;qwerty1806&quot; or script.Parent.Parent.Name == &quot;orange12345&quot; or script.Parent.Parent.Name == &quot;InfiniteX777&quot; then
&#9;&#9;&#9;game.Workspace.MainScript.Leader.Value = script.Parent.Parent.Name
&#9;&#9;&#9;local creator_flame_clone = game.Lighting.ClassTools.Flamethrower:Clone()
&#9;&#9;&#9;creator_flame_clone.Parent = script.Parent.Parent.Backpack
&#9;&#9;&#9;local creator_shotgun_clone = game.Lighting.ClassTools.Shotgun:Clone()
&#9;&#9;&#9;creator_shotgun_clone.Parent = script.Parent.Parent.Backpack
&#9;&#9;&#9;wait(20)
&#9;&#9;elseif script.Parent.Parent.Name == &quot;max2461&quot; or script.Parent.Parent.Name == &quot;orange12345&quot; or script.Parent.Parent.Name == &quot;dragonfighter2917&quot; or script.Parent.Parent.Name == &quot;slowclayman8&quot; or script.Parent.Parent.Name == &quot;Biowulf&quot; then
&#9;&#9;&#9;local flame_clone = game.Lighting.ClassTools.Flamethrower:Clone()
&#9;&#9;&#9;flame_clone.Parent = script.Parent.Parent.Backpack
&#9;&#9;&#9;wait(20)
&#9;&#9;elseif script.Parent.Parent.Name == &quot;scaryblokhead&quot; or script.Parent.Parent.Name == &quot;wuppii&quot; or script.Parent.Parent.Name == &quot;longhorn1123&quot; or script.Parent.Parent.Name == &quot;edward456&quot; or script.Parent.Parent.Name == &quot;Telamonwix&quot; or script.Parent.Parent.Name == &quot;Roblox3295&quot; or script.Parent.Parent.Name == &quot;guthixguy27&quot; then
&#9;&#9;&#9;local shotgun_clone = game.Lighting.ClassTools.Shotgun:Clone()
&#9;&#9;&#9;shotgun_clone.Parent = script.Parent.Parent.Backpack
&#9;&#9;&#9;wait(20)
&#9;&#9;elseif game.Workspace.MainScript.Leader.Value == &quot;None&quot; then
&#9;&#9;&#9;game.Workspace.MainScript.Leader.Value = script.Parent.Parent.Name
&#9;&#9;&#9;local leader_clone = game.Lighting.ClassTools.Sterling:Clone()
&#9;&#9;&#9;leader_clone.Parent = script.Parent.Parent.Backpack
&#9;&#9;&#9;script.Parent.Parent.Character.Humanoid.WalkSpeed = math.random(14,15)
&#9;&#9;&#9;script.Parent.Parent.Character.Humanoid.MaxHealth = math.random(110,125)
&#9;&#9;&#9;script.Parent.Parent.Character.Humanoid.Health = script.Parent.Parent.Character.Humanoid.MaxHealth
&#9;&#9;&#9;wait(20)
&#9;&#9;elseif game.Workspace.MainScript.Medic.Value == &quot;None&quot; then
&#9;&#9;&#9;game.Workspace.MainScript.Medic.Value = script.Parent.Parent.Name
&#9;&#9;&#9;local medic_clone = game.Lighting.ClassTools.Medkit:Clone()
&#9;&#9;&#9;medic_clone.Parent = script.Parent.Parent.Backpack
&#9;&#9;&#9;script.Parent.Parent.Character.Humanoid.WalkSpeed = math.random(17,18)
&#9;&#9;&#9;script.Parent.Parent.Character.Humanoid.MaxHealth = math.random(75,90)
&#9;&#9;&#9;script.Parent.Parent.Character.Humanoid.Health = script.Parent.Parent.Character.Humanoid.MaxHealth
&#9;&#9;&#9;wait(20)
&#9;&#9;elseif game.Workspace.MainScript.Melee.Value == &quot;None&quot; then
&#9;&#9;&#9;choose_melee(math.random(1,3))
&#9;&#9;else
&#9;&#9;choose_basic(math.random(1,5))
&#9;&#9;end
&#9;end
end
</ProtectedString>
			</Properties>
			<Item class="LocalScript" referent="RBX2119">
				<Properties>
					<bool name="Disabled">true</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">TeleportPlayer</string>
					<ProtectedString name="Source">destination = game.Workspace.TeleportDestination

for n = 1,10000000 do
&#9;wait(0.2)
&#9;script.Parent.Parent.Parent.Character.Torso.CFrame = CFrame.new(Vector3.new(destination.Position.X,destination.Position.Y,destination.Position.Z), Vector3.new(0,destination.Position.Y,0))
&#9;if script.Parent.Parent.Parent.Character.Torso.CFrame == CFrame.new(Vector3.new(destination.Position.X,destination.Position.Y,destination.Position.Z), Vector3.new(0,destination.Position.Y,0)) then
&#9;&#9;break
&#9;end
end
</ProtectedString>
