					<string name="Name">DeactivateScript</string>
					<ProtectedString name="Source">while true do
&#9;wait()
&#9;if game.Workspace.MainScript.ReturnLightPower.Value == true and script.Parent.Parent.Parent.Playing.Value == true then
&#9;&#9;wait(2)
&#9;&#9;for n = 1,7 do
&#9;&#9;&#9;wait(0.1)
&#9;&#9;&#9;script.Parent.Blackout.BackgroundTransparency = script.Parent.Blackout.BackgroundTransparency + 0.1
&#9;&#9;end
&#9;&#9;wait(20)
