				<Item class="Script" referent="RBX2161">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">MainScript</string>
						<ProtectedString name="Source">base = script.Parent.Parent.Parent.Parent.Character.Humanoid

function check()
&#9;wait(0.5)
&#9;script.Parent.BackgroundTransparency = (base.Health*0.01)
&#9;script.Parent.HeartBeat:Play()
&#9;script.Parent.HeartBeat.Volume = 1 - (base.Health*0.01)
&#9;if base.Health == 0 then
&#9;&#9;script.Parent.HeartBeat.Volume = 0
&#9;&#9;script:Remove()
&#9;else
&#9;loop()
&#9;end
end

function loop()
&#9;wait()
&#9;check()
end

loop()
</ProtectedString>
					</Properties>
				</Item>
