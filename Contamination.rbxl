				<Item class="Script" referent="RBX1921">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">SinkScript</string>
						<ProtectedString name="Source">function Sink(hit)
v = Instance.new(&quot;BodyVelocity&quot;)
scr = script:findFirstChild(&quot;Erase&quot;):clone()
scr.Parent = hit
v.maxForce = v.maxForce*9999999
v.velocity = Vector3.new(0, -1.5, 0)
v.Parent = hit
end

script.Parent.Touched:connect(Sink)
</ProtectedString>
					</Properties>
					<Item class="Script" referent="RBX1922">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Erase</string>
							<ProtectedString name="Source">function erase()
&#9;if script.Parent.className==&quot;Part&quot; then
wait()
script.Parent:BreakJoints()
wait(0.2)
script.Parent:Remove()
&#9;end
end

erase()
</ProtectedString>
						</Properties>
					</Item>
				</Item>
				<Item class="Script" referent="RBX1923">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">InfectScript</string>
						<ProtectedString name="Source">bin = script.Parent

function onTouched(part)
&#9;script.Parent.Sound:Play()
&#9;part.BrickColor = BrickColor.new(151)
&#9;local fire = script.Parent.Fire:Clone()
&#9;fire.Parent = part
end

connection = bin.Touched:connect(onTouched)</ProtectedString>
					</Properties>
				</Item>
