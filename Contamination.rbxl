				<Item class="Script" referent="RBX4177">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">ChaseScript</string>
						<ProtectedString name="Source">script.Parent.Zombie.Health = script.Parent.Zombie.MaxHealth
local larm = script.Parent:FindFirstChild(&quot;Left Arm&quot;)
local rarm = script.Parent:FindFirstChild(&quot;Right Arm&quot;)

function findNearestTorso(pos)
&#9;local list = game.Workspace:children()
&#9;local torso = nil
&#9;local dist = 15
&#9;local temp = nil
&#9;local human = nil
&#9;local temp2 = nil
&#9;for x = 1, #list do
&#9;&#9;temp2 = list[x]
&#9;&#9;if (temp2.className == &quot;Model&quot;) and (temp2 ~= script.Parent) then
&#9;&#9;&#9;temp = temp2:findFirstChild(&quot;Torso&quot;)
&#9;&#9;&#9;human = temp2:findFirstChild(&quot;Humanoid&quot;)
&#9;&#9;&#9;if (temp ~= nil) and (human ~= nil) and (human.Health &gt; 0) then
&#9;&#9;&#9;&#9;if (temp.Position - pos).magnitude &lt; dist then
&#9;&#9;&#9;&#9;&#9;torso = temp
&#9;&#9;&#9;&#9;&#9;dist = (temp.Position - pos).magnitude
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
&#9;return torso
end

function Hit(hit)
&#9;local human = hit.Parent:FindFirstChild(&quot;Humanoid&quot;)
&#9;if human ~= nil then
&#9;&#9;human.Health =  human.Health -50
&#9;end
end

larm.Touched:connect(Hit)
rarm.Touched:connect(Hit)

while true do
&#9;wait(0.1)
&#9;local target = findNearestTorso(script.Parent.Torso.Position)
&#9;if target ~= nil then
&#9;&#9;script.Parent.Zombie:MoveTo(target.Position, target)
&#9;end
end
</ProtectedString>
					</Properties>
				</Item>
				<Item class="Script" referent="RBX4178">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Weld Script</string>
						<ProtectedString name="Source">local p=script.Parent:GetChildren()
for i=1,#p do 
if p[i].className==&quot;Part&quot; then 

&#9;local weld = Instance.new(&quot;Weld&quot;) 
        weld.Name=&quot;Hold&quot;
&#9;weld.Part0 = p[i]
&#9;weld.Part1 = script.Parent.Parent.Torso

&#9;local HitPos = p[i].Position + (p[i].CFrame.lookVector * .5) 

&#9;local CJ = CFrame.new(HitPos) 
&#9;local C0 = p[i].CFrame:inverse() *CJ 
&#9;local C1 = script.Parent.Parent.Torso.CFrame:inverse() * CJ 

&#9;weld.C0 = C0 
&#9;weld.C1 = C1 

&#9;weld.Parent = p[i]
end
end </ProtectedString>
					</Properties>
				</Item>
				<Item class="Script" referent="RBX4179">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">BodyScript</string>
						<ProtectedString name="Source">function randomise_body_parts()
&#9;if game.Workspace.MainScript.ZombieBodies.Value == true then
&#9;&#9;torso(math.random(1,2))
&#9;&#9;left_leg(math.random(1,2))
&#9;&#9;left_arm(math.random(1,2))
&#9;&#9;right_leg(math.random(1,2))
&#9;&#9;right_arm(math.random(1,2))
&#9;end
end

function torso(result)
&#9;if result == 1 then
&#9;&#9;local torso = script.Zombie.Torso:Clone()
&#9;&#9;torso.Parent = script.Parent
&#9;else
&#9;local torso = script.Skeleton.Torso:Clone()
&#9;torso.Parent = script.Parent
&#9;end
end

function left_leg(result)
&#9;if result == 1 then
&#9;&#9;local left_leg = script.Zombie.LeftLeg:Clone()
&#9;&#9;left_leg.Parent = script.Parent
&#9;else
&#9;local left_leg = script.Skeleton.LeftLeg:Clone()
&#9;left_leg.Parent = script.Parent
&#9;end
end

function left_arm(result)
&#9;if result == 1 then
&#9;&#9;local left_arm = script.Zombie.LeftArm:Clone()
&#9;&#9;left_arm.Parent = script.Parent
&#9;else
&#9;local left_arm = script.Skeleton.LeftArm:Clone()
&#9;left_arm.Parent = script.Parent
&#9;end
end

function right_leg(result)
&#9;if result == 1 then
&#9;&#9;local right_leg = script.Zombie.RightLeg:Clone()
&#9;&#9;right_leg.Parent = script.Parent
&#9;else
&#9;local right_leg = script.Skeleton.RightLeg:Clone()
&#9;right_leg.Parent = script.Parent
&#9;end
end

function right_arm(result)
&#9;if result == 1 then
&#9;&#9;local right_arm = script.Zombie.RightArm:Clone()
&#9;&#9;right_arm.Parent = script.Parent
&#9;else
&#9;local right_arm = script.Skeleton.RightArm:Clone()
&#9;right_arm.Parent = script.Parent
&#9;end
end

randomise_body_parts()</ProtectedString>
