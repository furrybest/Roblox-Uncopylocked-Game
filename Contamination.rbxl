				<Item class="Script" referent="RBX2149">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">function news_visible()
&#9;for n = 1,10 do
&#9;&#9;wait(0.1)
&#9;&#9;script.Parent.Text.TextTransparency = script.Parent.Text.TextTransparency - 0.1
&#9;end
end

function news_invisible()
&#9;for n = 1,10 do
&#9;&#9;wait(0.1)
&#9;&#9;script.Parent.Text.TextTransparency = script.Parent.Text.TextTransparency + 0.1
&#9;end
end

while true do
&#9;wait(5)
&#9;news_invisible()
&#9;script.Parent.Text.Text = &quot;A new melee class has been added, should it stay in the game?&quot;
&#9;news_visible()
&#9;wait(5)
&#9;news_invisible()
&#9;script.Parent.Text.Text = &quot;A new music track has been added after the lift drop, please comment on it.&quot;
&#9;news_visible()
&#9;wait(5)
&#9;news_invisible()
&#9;script.Parent.Text.Text = &quot;A blood script has been added to the game, it will probably stay in.&quot;
&#9;news_visible()
&#9;wait(5)
&#9;news_invisible()
&#9;script.Parent.Text.Text = &quot;Contamination is now about 99.4% complete.&quot;
&#9;news_visible()
end
</ProtectedString>
					</Properties>
				</Item>
			</Item>
