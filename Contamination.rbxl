							<ProtectedString name="Source">function onTouch(hit)
&#9;if hit.Name == &quot;Bullet&quot; then
&#9;&#9;print(&quot;Witch Activated.&quot;)
&#9;&#9;script.Parent.Parent.FirstChaseScript.Disabled = true
