					<Item class="Script" referent="RBX1864">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">SinkScript</string>
							<ProtectedString name="Source">function Sink(hit)
local h = hit.Parent:findFirstChild(&quot;Humanoid&quot;)
if h~=nil then
v = Instance.new(&quot;BodyVelocity&quot;)
scr = script:findFirstChild(&quot;Erase&quot;):clone()
scr.Parent = hit
v.maxForce = v.maxForce*9999999
v.velocity = Vector3.new(0, 0, 0)
v.Parent = hit
end
end

script.Parent.Touched:connect(Sink)
</ProtectedString>
						</Properties>
						<Item class="Script" referent="RBX1865">
							<Properties>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">Erase</string>
								<ProtectedString name="Source">function erase()
&#9;if script.Parent.className==&quot;Part&quot; then
script.Parent:BreakJoints()
wait(1)
script.Parent:Remove()
&#9;end
end

erase()
</ProtectedString>
							</Properties>
						</Item>
					</Item>
					<Item class="Script" referent="RBX1866">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">InfectScript</string>
							<ProtectedString name="Source">bin = script.Parent

function onTouched(part)
&#9;script.Parent.Sound:Play()
&#9;local h = part.Parent:findFirstChild(&quot;Humanoid&quot;)
&#9;if h~=nil then
&#9;&#9;wait()
&#9;&#9;h.Sit = true
&#9;&#9;part.BrickColor = BrickColor.new(151)
&#9;&#9;--local fire = script.Parent.Fire:Clone()
&#9;&#9;--fire.Parent = part
&#9;end
end

connection = bin.Touched:connect(onTouched)
</ProtectedString>
						</Properties>
					</Item>
					<Item class="Script" referent="RBX1867">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">ChangeScript</string>
							<ProtectedString name="Source">function onTouched(part)
&#9;local h = part.Parent:findFirstChild(&quot;Humanoid&quot;)
&#9;if h~=nil then 
&#9;&#9;wait(1)
&#9;&#9;--h.Name = &quot;Zombie&quot;
&#9;end
end



script.Parent.Touched:connect(onTouched)</ProtectedString>
