					<Item class="Script" referent="RBX4299">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">StickScript</string>
							<ProtectedString name="Source">tongue = script.Tongue:Clone()
run = 0

function findNearestTorso(pos)
&#9;local list = game.Workspace:children()
&#9;local torso = nil
&#9;local dist = 30
&#9;local temp = nil
&#9;local human = nil
&#9;local temp2 = nil
&#9;for x = 1, #list do
&#9;&#9;temp2 = list[x]
&#9;&#9;if (temp2.className == &quot;Model&quot;) and (temp2 ~= script.Parent) then
&#9;&#9;&#9;temp = temp2:findFirstChild(&quot;Torso&quot;)
&#9;&#9;&#9;human = temp2:findFirstChild(&quot;Humanoid&quot;)
&#9;&#9;&#9;if (temp ~= nil) and (human ~= nil) and (human.Health &gt; 0) then
&#9;&#9;&#9;&#9;if (temp.Position - pos).magnitude &lt; dist then
&#9;&#9;&#9;&#9;&#9;torso = temp
&#9;&#9;&#9;&#9;&#9;dist = (temp.Position - pos).magnitude
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
&#9;return torso
end

while true do
&#9;wait(0.1)
&#9;local target = findNearestTorso(script.Parent.Parent.Torso.Position)
&#9;local check = script.Parent:FindFirstChild(&quot;Tongue&quot;)
&#9;if target ~= nil and run == 0 then
&#9;&#9;script.Parent.TongueFire:Play()
&#9;&#9;tongue.Parent = script.Parent
&#9;&#9;tongue.Humanoid = script.Parent.Parent.HiddenHead.Hidden
&#9;&#9;tongue.Point = target.Parent.Torso.Position + Vector3.new(0,1,0)
&#9;&#9;target.Parent.Humanoid.Sit = true
&#9;elseif check ~= nil then
&#9;&#9;check:Remove()
&#9;&#9;run = 1
&#9;end
end
</ProtectedString>
