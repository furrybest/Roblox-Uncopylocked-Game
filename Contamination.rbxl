						<string name="Name">FallScript</string>
						<ProtectedString name="Source">function onTouch(hit)
&#9;local humanoid = hit.Parent:FindFirstChild(&quot;Humanoid&quot;)
&#9;if (humanoid ~= nil) then
&#9;&#9;humanoid.PlatformStand = true
&#9;&#9;script.Parent.Anchored = false
&#9;&#9;script.Parent:BreakJoints()
&#9;&#9;script.Parent.Parent.UnstableBarrier.Anchored = false
&#9;&#9;script.Parent.Parent.UnstableBarrier:BreakJoints()
&#9;&#9;script.Parent.RotVelocity = Vector3.new(2,1,5)
&#9;end
end

script.Parent.Touched:connect(onTouch)</ProtectedString>
