					<ProtectedString name="Source">while true do
&#9;wait()
&#9;if game.Workspace.MainScript.LightFade.Value == true and script.Parent.Parent.Parent.Playing.Value == true then
&#9;&#9;for n = 1,100 do
&#9;&#9;&#9;wait(0.05)
&#9;&#9;&#9;script.Parent.Light.BackgroundTransparency = 1 - (n/100)
&#9;&#9;end
&#9;&#9;script.Parent.Parent.Parent.Character.Head:Remove()
&#9;&#9;wait(20)
&#9;end
end
