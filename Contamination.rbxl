						<token name="BottomSurface">4</token>
						<token name="BottomSurfaceInput">0</token>
						<int name="BrickColor">29</int>
						<CoordinateFrame name="CFrame">
							<X>85.5</X>
							<Y>28.3004189</Y>
							<Z>-138.516846</Z>
							<R00>-1</R00>
							<R01>3.15444413e-005</R01>
							<R02>2.94535948e-005</R02>
