						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">BloodInserter</string>
						<ProtectedString name="Source">if game.Workspace.Blood.Value == true then
&#9;sc = game.Lighting.ZombieBloodScript:Clone()
&#9;sc.Parent, sc.Disabled = script.Parent, false
&#9;script:Remove()
end
</ProtectedString>
