							<token name="MeshType">3</token>
							<string name="Name">Mesh</string>
							<Vector3 name="Offset">
								<X>0</X>
								<Y>0</Y>
								<Z>0</Z>
							</Vector3>
							<Vector3 name="Scale">
								<X>0.200000003</X>
								<Y>0.200000003</Y>
								<Z>0.200000003</Z>
							</Vector3>
