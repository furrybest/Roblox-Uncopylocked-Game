						<string name="Name">MasterScript</string>
						<ProtectedString name="Source">function update_output(property)
&#9;print(&quot;The OutputText has changed value.&quot;)
&#9;script.Parent.Output.OutputFour.Text = script.Parent.Output.OutputThree.Text
&#9;script.Parent.Output.OutputThree.Text = script.Parent.Output.OutputTwo.Text
&#9;script.Parent.Output.OutputTwo.Text = script.Parent.Output.OutputOne.Text
&#9;script.Parent.Output.OutputOne.Text = game.Workspace.OutputText.Value
end

game.Workspace.OutputText.Changed:connect(update_output)</ProtectedString>
