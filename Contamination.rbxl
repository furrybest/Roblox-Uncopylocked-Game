				<Item class="Script" referent="RBX1977">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">TrapScript</string>
						<ProtectedString name="Source">touched = false

function onTouch(hit)
&#9;if touched == false then
&#9;&#9;touched = true
&#9;&#9;local humanoid = hit.Parent:FindFirstChild(&quot;Humanoid&quot;)
&#9;&#9;if (humanoid ~= nil) then
&#9;&#9;&#9;local J1 = game.Lighting.Jockey1:Clone()
&#9;&#9;&#9;J1.Parent = game.Workspace
&#9;&#9;&#9;J1:MakeJoints()
&#9;&#9;end
&#9;end
end

script.Parent.Touched:connect(onTouch)</ProtectedString>
					</Properties>
				</Item>
			</Item>
