				<Item class="Script" referent="RBX4132">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">KillScript</string>
						<ProtectedString name="Source">running = false

function onTouch(hit)
&#9;print(&quot;Something touched the brick.&quot;)
&#9;local humanoid = hit.Parent:FindFirstChild(&quot;Humanoid&quot;)
&#9;if (humanoid ~= nil) and running == false then
&#9;&#9;humanoid.Health = 0
&#9;end
end


script.Parent.Touched:connect(onTouch)</ProtectedString>
					</Properties>
				</Item>
			</Item>
