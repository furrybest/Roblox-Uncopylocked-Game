								<ProtectedString name="Source">script.Parent.MouseButton1Click:connect(function ()
local check = game.Players:FindFirstChild(script.Parent.Parent.TargetName.Text)
if check ~= nil then
game.Workspace.Camera.CameraSubject = game.Players[script.Parent.Parent.TargetName.Text].Character
