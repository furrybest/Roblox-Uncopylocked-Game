		<Item class="Script" referent="RBX6032">
			<Properties>
				<bool name="Disabled">true</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">ZombieBloodScript</string>
				<ProtectedString name="Source">last_health = script.Parent.Zombie.MaxHealth
blood_base = Instance.new(&quot;Part&quot;)
blood_base.formFactor, blood_base.Size, blood_base.BrickColor = 0, Vector3.new(0.2,0.2,0.2), BrickColor.new(&quot;Really red&quot;)
local blood_colour = script.Smoke:Clone()
blood_colour.Parent = blood_base
mesh = Instance.new(&quot;BlockMesh&quot;)
mesh.Scale = Vector3.new(0.4,0.4,0.4)
mesh.Parent = blood_base

while true do
&#9;wait()
&#9;if script.Parent.Zombie.Health &lt; last_health then
&#9;&#9;last_health = script.Parent.Zombie.Health
&#9;&#9;for n = 1,math.random(1,5) do
&#9;&#9;&#9;local blood = blood_base:Clone()
&#9;&#9;&#9;blood.Parent = game.Workspace
&#9;&#9;&#9;blood.CFrame = CFrame.new(script.Parent.Torso.Position)
&#9;&#9;&#9;--blood.Transparency = 1
&#9;&#9;&#9;blood.CanCollide = false
&#9;&#9;&#9;blood.Velocity = Vector3.new(math.random(-50,50), math.random(10,50), math.random(-50,50))
&#9;&#9;&#9;wait()
&#9;&#9;end
&#9;&#9;if script.Parent.Zombie.Health == 0 then 
&#9;&#9;&#9;for n = 1,100 do
&#9;&#9;&#9;&#9;local blood = blood_base:Clone()
&#9;&#9;&#9;&#9;blood.Parent = game.Workspace
&#9;&#9;&#9;&#9;blood.CFrame = CFrame.new(script.Parent.Torso.Position)
&#9;&#9;&#9;&#9;--blood.Transparency = 1
&#9;&#9;&#9;&#9;blood.CanCollide = false
&#9;&#9;&#9;&#9;blood.Velocity = Vector3.new(math.random(-50,50), math.random(10,50), math.random(-50,50))
&#9;&#9;&#9;&#9;wait()
&#9;&#9;&#9;end
&#9;&#9;end
&#9;else
&#9;last_health = script.Parent.Zombie.Health
&#9;end
end
</ProtectedString>
