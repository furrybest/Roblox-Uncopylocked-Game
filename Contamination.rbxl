					<Item class="Script" referent="RBX4501">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">HurtScript</string>
							<ProtectedString name="Source">running = false

function onTouch(hit)
&#9;local humanoid = hit.Parent:FindFirstChild(&quot;Humanoid&quot;)
&#9;if (humanoid ~= nil) and running == false then
&#9;&#9;if humanoid.Health &gt;= 1 then
&#9;&#9;&#9;running = true
&#9;&#9;&#9;script.Parent.Parent.Zombie.WalkSpeed = 0
&#9;&#9;&#9;script.Parent.Parent.JumpScript.Disabled = true
&#9;&#9;&#9;wait(0.5)
&#9;&#9;&#9;script.Parent.Parent[&quot;Left Arm&quot;].Transparency = 1
&#9;&#9;&#9;script.Parent.Parent.FakeLeftArm.Transparency = 0
&#9;&#9;&#9;random = math.random(1,100)
&#9;&#9;&#9;script.Parent.Parent.Head.AttackSound.Pitch = random/100
&#9;&#9;&#9;script.Parent.Parent.Head.AttackSound:Play()
&#9;&#9;&#9;for n = 1,math.random(4,6) do
&#9;&#9;&#9;&#9;wait(0.1)
&#9;&#9;&#9;&#9;script.Parent.Parent[&quot;Left Arm&quot;].Transparency = 1
&#9;&#9;&#9;&#9;script.Parent.Parent.FakeLeftArm.Transparency = 0
&#9;&#9;&#9;&#9;humanoid.Health = humanoid.Health - math.random(12,15)
&#9;&#9;&#9;&#9;random = math.random(80,150)
&#9;&#9;&#9;&#9;script.Parent.Parent.FakeLeftArm.CutSound.Pitch = random/100
&#9;&#9;&#9;&#9;script.Parent.Parent.FakeLeftArm.CutSound:Play()
&#9;&#9;&#9;&#9;wait(0.1)
&#9;&#9;&#9;&#9;script.Parent.Parent[&quot;Left Arm&quot;].Transparency = 0
&#9;&#9;&#9;&#9;script.Parent.Parent.FakeLeftArm.Transparency = 1
&#9;&#9;&#9;&#9;humanoid.Health = humanoid.Health - math.random(12,15)
&#9;&#9;&#9;&#9;random = math.random(80,150)
&#9;&#9;&#9;&#9;script.Parent.Parent.FakeLeftArm.CutSound.Pitch = random/100
&#9;&#9;&#9;&#9;script.Parent.Parent.FakeLeftArm.CutSound:Play()
&#9;&#9;&#9;end
&#9;&#9;&#9;humanoid.PlatformStand = true
&#9;&#9;&#9;wait()
&#9;&#9;&#9;humanoid.Health = humanoid.Health - math.random(10,15)
&#9;&#9;&#9;wait(0.5)
&#9;&#9;&#9;script.Parent.Parent.JumpScript.Disabled = false
&#9;&#9;&#9;running = false
&#9;&#9;&#9;wait(0.5)
&#9;&#9;&#9;script.Parent.Parent.Zombie.WalkSpeed = 25
&#9;&#9;end
&#9;end
end

script.Parent.Touched:connect(onTouch)</ProtectedString>
