					<ProtectedString name="Source">while true do
&#9;local check = script.Parent.Parent.Parent:FindFirstChild(&quot;Playing&quot;)
&#9;if check ~= nil then
&#9;&#9;if check.Value == true then 
&#9;&#9;script.Parent.MainFrame.Visible = false
