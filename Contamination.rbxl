				<Item class="Script" referent="RBX4198">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">SpitScript</string>
						<ProtectedString name="Source">script.Parent.Zombie.Health = script.Parent.Zombie.MaxHealth
local larm = script.Parent:FindFirstChild(&quot;Left Arm&quot;)
local rarm = script.Parent:FindFirstChild(&quot;Right Arm&quot;)

function findNearestTorso(pos)
&#9;local list = game.Workspace:children()
&#9;local torso = nil
&#9;local dist = 25
&#9;local temp = nil
&#9;local human = nil
&#9;local temp2 = nil
&#9;for x = 1, #list do
&#9;&#9;temp2 = list[x]
&#9;&#9;if (temp2.className == &quot;Model&quot;) and (temp2 ~= script.Parent) then
&#9;&#9;&#9;temp = temp2:findFirstChild(&quot;Torso&quot;)
&#9;&#9;&#9;human = temp2:findFirstChild(&quot;Humanoid&quot;)
&#9;&#9;&#9;if (temp ~= nil) and (human ~= nil) and (human.Health &gt; 0) then
&#9;&#9;&#9;&#9;if (temp.Position - pos).magnitude &lt; dist then
&#9;&#9;&#9;&#9;&#9;torso = temp
&#9;&#9;&#9;&#9;&#9;dist = (temp.Position - pos).magnitude
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
&#9;return torso
end


while true do
&#9;wait(math.random(1,5))
&#9;local target = findNearestTorso(script.Parent.Torso.Position)
&#9;if target ~= nil then
&#9;&#9;spit = Instance.new(&quot;Part&quot;)
&#9;&#9;spit.Parent = script
&#9;&#9;spit.Name = &quot;Spit&quot;
&#9;&#9;spit.Transparency = 0.5
&#9;&#9;spit.Position = Vector3.new(script.Parent.Head.Position.X, script.Parent.Head.Position.Y, script.Parent.Head.Position.Z)
&#9;&#9;spit.BrickColor = BrickColor.new(&quot;Earth green&quot;)&#9;
&#9;&#9;spit.CanCollide = false
&#9;&#9;spit.Size = Vector3.new(1,1,1)
&#9;&#9;local mesh = script.Mesh:Clone()
&#9;&#9;mesh.Parent = spit
&#9;&#9;force = Instance.new(&quot;BodyPosition&quot;)
&#9;&#9;force.Parent = spit
&#9;&#9;force.position = target.Position
&#9;&#9;force.P = force.P/10
&#9;&#9;force.D = force.D/10
&#9;&#9;local spit_script = script.SpitScript:Clone()
&#9;&#9;spit_script.Parent = spit
&#9;&#9;spit_script.Disabled = false
&#9;&#9;fire = Instance.new(&quot;Fire&quot;)
&#9;&#9;fire.Parent = spit
&#9;&#9;fire.Color = Color3.new(0,255,0)
&#9;&#9;fire.SecondaryColor = Color3.new(0,150,0)&#9;
&#9;&#9;fire.Size = 0
&#9;&#9;fire.Heat = 0
&#9;end
end
</ProtectedString>
					</Properties>
					<Item class="SpecialMesh" referent="RBX4199">
						<Properties>
							<token name="LODX">2</token>
