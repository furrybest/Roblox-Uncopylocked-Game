					<Item class="Script" referent="RBX4301">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">TripScript</string>
							<ProtectedString name="Source">function onTouch(hit)
&#9;local check = hit.Parent:FindFirstChild(&quot;Humanoid&quot;)
&#9;if check ~= nil then
&#9;&#9;if check.Sit == true then
&#9;&#9;&#9;wait(2)
&#9;&#9;&#9;check.Jump = true
&#9;&#9;elseif check.Sit == false then
&#9;&#9;&#9;check.Sit = true
&#9;&#9;end
&#9;end
end

script.Parent.Touched:connect(onTouch)</ProtectedString>
