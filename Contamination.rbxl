		<Item class="Script" referent="RBX1687">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">DeathInserter</string>
				<ProtectedString name="Source">function Intialize(character)
&#9;for i, child in pairs(script:GetChildren()) do
&#9;&#9;if child.className == &quot;Script&quot; or child.className == &quot;LocalScript&quot; then
&#9;&#9;&#9;local c = child:Clone()
&#9;&#9;&#9;c.Parent = character
&#9;&#9;&#9;c.Disabled = false
&#9;&#9;end
&#9;end
end

function Apply(obj)
&#9;if obj.className == &quot;Humanoid&quot; then
&#9;&#9;Intialize(obj.Parent)
&#9;end
&#9;for i, child in pairs(obj:GetChildren()) do
&#9;&#9;Apply(child)
&#9;end
end

Apply(game.Workspace)
game.Workspace.ChildAdded:connect(Apply)
</ProtectedString>
			</Properties>
			<Item class="Script" referent="RBX1688">
				<Properties>
					<bool name="Disabled">true</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">DeathRecorder</string>
					<ProtectedString name="Source">Character = script.Parent
Humanoid = Character.Humanoid

function OnDeath()
&#9;print(&quot;Death&quot;)
&#9;if game.Players[Character.Name].Playing.Value == true then
&#9;&#9;game.Workspace.OutputText.Value = &quot;&quot; ..Character.Name.. &quot; has died.&quot;
&#9;&#9;game.Workspace.MainScript.DeadPlayers.Value = game.Workspace.MainScript.DeadPlayers.Value + 1
&#9;&#9;game.Players[Character.Name].Playing.Value = false
&#9;&#9;game.Workspace.GameStats.TotalPlayersDied.Value = game.Workspace.GameStats.TotalPlayersDied.Value + 1
&#9;end
end

Humanoid.Died:connect(OnDeath)</ProtectedString>
