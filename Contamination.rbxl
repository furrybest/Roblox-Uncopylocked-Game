&#9;&#9;left_leg(math.random(1,2))
&#9;&#9;left_arm(math.random(1,2))
&#9;&#9;right_leg(math.random(1,2))
&#9;&#9;right_arm(math.random(1,2))
&#9;end
end

function torso(result)
&#9;if result == 1 then
&#9;&#9;local torso = script.Zombie.Torso:Clone()
&#9;&#9;torso.Parent = script.Parent
&#9;else
&#9;local torso = script.Skeleton.Torso:Clone()
&#9;torso.Parent = script.Parent
&#9;end
end

function left_leg(result)
&#9;if result == 1 then
&#9;&#9;local left_leg = script.Zombie.LeftLeg:Clone()
&#9;&#9;left_leg.Parent = script.Parent
&#9;else
&#9;local left_leg = script.Skeleton.LeftLeg:Clone()
&#9;left_leg.Parent = script.Parent
&#9;end
end

function left_arm(result)
&#9;if result == 1 then
&#9;&#9;local left_arm = script.Zombie.LeftArm:Clone()
&#9;&#9;left_arm.Parent = script.Parent
&#9;else
&#9;local left_arm = script.Skeleton.LeftArm:Clone()
&#9;left_arm.Parent = script.Parent
&#9;end
end

function right_leg(result)
&#9;if result == 1 then
&#9;&#9;local right_leg = script.Zombie.RightLeg:Clone()
&#9;&#9;right_leg.Parent = script.Parent
&#9;else
&#9;local right_leg = script.Skeleton.RightLeg:Clone()
&#9;right_leg.Parent = script.Parent
&#9;end
end

function right_arm(result)
&#9;if result == 1 then
&#9;&#9;local right_arm = script.Zombie.RightArm:Clone()
&#9;&#9;right_arm.Parent = script.Parent
&#9;else
&#9;local right_arm = script.Skeleton.RightArm:Clone()
&#9;right_arm.Parent = script.Parent
&#9;end
end

randomise_body_parts()</ProtectedString>
