					<Item class="Script" referent="RBX2128">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">MainScript</string>
							<ProtectedString name="Source">-- Admin Powers GUI Version 1.0
 
 -- Last updated on the 18th February 2011.

target = script.Parent.TargetName
text = script.Parent.MessageText

function kill_target()
&#9;local fatality = game.Players:FindFirstChild(target.Text)
&#9;if (fatality ~= nil) then
&#9;&#9;fatality.Character:BreakJoints()
&#9;end
end

function kick_target()
&#9;local kicked = game.Players:FindFirstChild(target.Text)
&#9;if (kicked ~= nil) then
&#9;&#9;kicked:Remove()
&#9;end
end

function ban_target()
&#9;local banned = game.Players:FindFirstChild(target.Text)
&#9;if (banned ~= nil) then
&#9;&#9;local ban_script = script.BanScript:Clone()
&#9;&#9;ban_script.Parent = game.Workspace
&#9;&#9;ban_script.Name = &quot;&quot; ..banned.Name.. &quot;BanScript&quot;
&#9;&#9;ban_script.Banned.Value = banned.Name
&#9;&#9;ban_script.Disabled = false
&#9;end
end

function punish_target()
&#9;local punished = game.Players:FindFirstChild(target.Text)
&#9;if (punished ~= nil) then
&#9;&#9;punished.Character.Parent = game.Lighting
&#9;end
end

function output_text()
&#9;game.Workspace.OutputText.Value = text.Text
end

function create_message()
&#9;message = Instance.new(&quot;Message&quot;)
&#9;message.Parent = game.Workspace
&#9;message.Name = &quot;AdminMessage&quot;
&#9;message.Text = text.Text
&#9;wait(5)
&#9;message:Remove()
end


script.Parent.KillButton.MouseButton1Click:connect(kill_target)
script.Parent.KickButton.MouseButton1Click:connect(kick_target)
script.Parent.BanButton.MouseButton1Click:connect(ban_target)
script.Parent.PunishButton.MouseButton1Click:connect(punish_target)
script.Parent.OutputButton.MouseButton1Click:connect(output_text)
script.Parent.MessageButton.MouseButton1Click:connect(create_message)</ProtectedString>
						</Properties>
						<Item class="Script" referent="RBX2129">
							<Properties>
								<bool name="Disabled">true</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">BanScript</string>
								<ProtectedString name="Source">while true do
&#9;wait(0.1)
&#9;local player = game.Players:FindFirstChild(script.Banned.Value)
&#9;if (player ~= nil) then
&#9;&#9;player:Remove()
&#9;end
end
</ProtectedString>
