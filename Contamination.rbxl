			<Item class="Script" referent="RBX5677">
				<Properties>
					<bool name="Disabled">true</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Paintball</string>
					<ProtectedString name="Source">ball = script.Parent
damage = math.random(5,10)

function onTouched(hit)
&#9;local humanoid = hit.Parent:findFirstChild(&quot;Zombie&quot;)
&#9;local co = script.Parent.BrickColor
&#9;


&#9;if humanoid ~= nil then
&#9;&#9;local team = script.Parent.Team
&#9;&#9;if team.Value ~= 0 and hit.Parent.Torso.BrickColor ~= co then
&#9;&#9;&#9;tagHumanoid(humanoid)
&#9;&#9;&#9;humanoid.Health = humanoid.Health - damage
&#9;&#9;&#9;wait(2)
&#9;&#9;&#9;untagHumanoid(humanoid)
&#9;&#9;end
&#9;&#9;if team.Value == 0 then
&#9;&#9;&#9;tagHumanoid(humanoid)
&#9;&#9;&#9;humanoid.Health = humanoid.Health - damage
&#9;&#9;&#9;wait(2)
&#9;&#9;&#9;untagHumanoid(humanoid)
&#9;&#9;end
&#9;end

&#9;connection:disconnect()

&#9;wait(1)
&#9;ball.Parent = nil
end

function tagHumanoid(humanoid)
&#9;-- todo: make tag expire
&#9;local tag = ball:findFirstChild(&quot;creator&quot;)
&#9;if tag ~= nil then
&#9;&#9;local new_tag = tag:clone()
&#9;&#9;new_tag.Parent = humanoid
&#9;end
end


function untagHumanoid(humanoid)
&#9;if humanoid ~= nil then
&#9;&#9;local tag = humanoid:findFirstChild(&quot;creator&quot;)
&#9;&#9;if tag ~= nil then
&#9;&#9;&#9;tag.Parent = nil
&#9;&#9;end
&#9;end
end

connection = ball.Touched:connect(onTouched)

wait(3)
ball.Parent = nil
</ProtectedString>
				</Properties>
			</Item>
			<Item class="Script" referent="RBX5678">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">PaintballShooter</string>
					<ProtectedString name="Source">Tool = script.Parent


function fire(v)

&#9;Tool.Handle.Fire:play()
&#9;

&#9;local vCharacter = Tool.Parent
&#9;local vPlayer = game.Players:playerFromCharacter(vCharacter)

&#9;local missile = Instance.new(&quot;Part&quot;)

        

&#9;local spawnPos = Tool.Barrel.CFrame + Vector3.new(0, .5, 0)

&#9;local mesh = Tool.Mesh:clone()
&#9;


&#9;spawnPos  = spawnPos + (v * 2)

&#9;missile.CFrame = spawnPos
&#9;missile.Size = Vector3.new(1,1,1)
&#9;missile.Velocity = v * 467
&#9;local team = script.Parent.Team
&#9;if team.Value ~= 0 then
&#9;&#9;missile.BrickColor = Tool.Parent.Torso.BrickColor
&#9;end
&#9;local tw = Tool.Team:clone()
&#9;tw.Parent = missile
&#9;missile.Shape = 0
&#9;missile.BottomSurface = 0
&#9;missile.TopSurface = 0
&#9;missile.Name = &quot;Paintball&quot;
&#9;missile.Elasticity = 0
&#9;missile.Reflectance = .3
&#9;missile.Friction = 1
&#9;mesh.Parent = missile


&#9;local force = Instance.new(&quot;BodyForce&quot;)
&#9;force.force = Vector3.new(0,100,0)
&#9;force.Parent = missile
&#9;
&#9;local new_script = script.Parent.Paintball:clone()
&#9;new_script.Disabled = false
&#9;new_script.Parent = missile

&#9;local creator_tag = Instance.new(&quot;ObjectValue&quot;)
&#9;creator_tag.Value = vPlayer
&#9;creator_tag.Name = &quot;creator&quot;
&#9;creator_tag.Parent = missile
&#9;


&#9;missile.Parent = game.Workspace&#9;

&#9;missile.Name = &quot;Bullet&quot;

&#9;explosion = Instance.new(&quot;Explosion&quot;)
&#9;explosion.Name = &quot;FireBang&quot;
&#9;explosion.BlastRadius = 0
&#9;explosion.BlastPressure = 0 
&#9;explosion.Position = Tool.Barrel.Position
&#9;explosion.Parent = game.Workspace
&#9;
end


function check(en)
---------------------------------------Function start here.
if (Tool.Enabled == false) then
return false
end--end for if!
-------------------------------
if (Tool.Enabled == true) then
return true
end
---------------------------------------Function end here.
end


Tool.Enabled = true
function onActivated()

&#9;if not Tool.Enabled then
&#9;&#9;return
&#9;end
&#9;
&#9;local character = Tool.Parent;
&#9;local bullets = script.Parent.Bullets
&#9;local humanoid = character:findFirstChild(&quot;Humanoid&quot;)
&#9;if humanoid == nil then
&#9;&#9;print(&quot;Humanoid not found&quot;)
&#9;&#9;return 
&#9;end

&#9;if Tool.Enabled ~= true then return end

&#9;local offsetRatio = {-.01, 0, .01}
&#9;local targetPos = humanoid.TargetPoint
&#9;local lookAt = (targetPos - character.Head.Position).unit
&#9;
&#9;if (check()) and bullets.Value &gt; 0 then
&#9;&#9;local offset = (targetPos - character.Head.Position).unit + Vector3.new((offsetRatio[math.random(.1, #offsetRatio)]), (offsetRatio[math.random(.1, #offsetRatio)]), 0)
&#9;&#9;fire(offset)
&#9;&#9;character.Torso:findFirstChild(&quot;Right Shoulder&quot;).DesiredAngle = 1.7&#9;
&#9;&#9;bullets.Value = bullets.Value - 1 
&#9;&#9;Tool.Name = (&quot;Sterling[&quot;..script.Parent.Bullets.Value..&quot;]&quot;)
&#9;&#9;wait(0.115)
&#9;&#9;onActivated()
&#9;end


&#9;Tool.Name = (&quot;Sterling[&quot;..script.Parent.Bullets.Value..&quot;]&quot;)

&#9;return
&#9;&#9;

&#9;--Tool.Enabled = true
end


script.Parent.Activated:connect(onActivated)
</ProtectedString>
