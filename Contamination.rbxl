			<Item class="Script" referent="RBX2178">
				<Properties>
					<bool name="Disabled">true</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">RunScript</string>
					<ProtectedString name="Source">function main()
&#9;frame_visible(script.Parent.Background) -- 1
&#9;wait(0.5)
&#9;frame_visible(script.Parent.MainFrame) -- 2.5
&#9;wait(0.5)
&#9;visible(script.Parent.MainFrame.GroupName) -- 4
&#9;wait(0.5)
&#9;visible(script.Parent.MainFrame.Title) -- 5.5
&#9;wait(0.5)
&#9;visible(script.Parent.MainFrame.Part1) -- 7
&#9;wait(1)
&#9;visible(script.Parent.MainFrame.Part2) -- 9
&#9;wait(1)
&#9;visible(script.Parent.MainFrame.Part3) -- 11
&#9;wait(15) &#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;  -- 26
&#9;script.Parent.Background.BackgroundTransparency = 1
&#9;script.Parent.MainFrame.BackgroundTransparency = 1
&#9;script.Parent.MainFrame.GroupName.TextTransparency = 1
&#9;script.Parent.MainFrame.Title.TextTransparency = 1
&#9;script.Parent.MainFrame.Part1.TextTransparency = 1
&#9;script.Parent.MainFrame.Part2.TextTransparency = 1
&#9;script.Parent.MainFrame.Part3.TextTransparency = 1
&#9;script.SmashSound:Play()
&#9;script.RoarSound:Play()
&#9;script.SmashSound:Play()
&#9;script.RoarSound:Play()
&#9;script.SmashSound:Play()
&#9;script.RoarSound:Play()
&#9;script.SmashSound:Play()
&#9;script.RoarSound:Play()
&#9;script.SmashSound:Play()
&#9;script.RoarSound:Play()
&#9;script.Disabled = true
end

function visible(text_gui)
&#9;for n = 1,10 do
&#9;&#9;text_gui.TextTransparency = text_gui.TextTransparency - 0.1
&#9;&#9;wait(0.1)
&#9;end
end

function invisible(text_gui)
&#9;for n = 1,10 do
&#9;&#9;text_gui.TextTransparency = text_gui.TextTransparency + 0.1
&#9;&#9;wait(0.1)
&#9;end
end

function frame_visible(gui)
&#9;for n = 1,10 do
&#9;&#9;gui.BackgroundTransparency = gui.BackgroundTransparency - 0.1
&#9;&#9;wait(0.1)
&#9;end
end

function frame_invisible(gui)
&#9;for n = 1,10 do
&#9;&#9;gui.BackgroundTransparency = gui.BackgroundTransparency + 0.1
&#9;&#9;wait(0.1)
&#9;end
end

main()</ProtectedString>
