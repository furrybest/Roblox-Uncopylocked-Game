					<Item class="Script" referent="RBX4200">
						<Properties>
							<bool name="Disabled">true</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">SpitScript</string>
							<ProtectedString name="Source">function onTouch(hit)
&#9;local humanoid = hit.Parent:FindFirstChild(&quot;Humanoid&quot;)
&#9;if (humanoid ~= nil)&#9;then
&#9;&#9;humanoid.Health = humanoid.Health - math.random(50,76)
&#9;&#9;script.Parent:Remove()
&#9;end
end

script.Parent.Touched:connect(onTouch)

wait(4)
script.Parent:Remove()</ProtectedString>
						</Properties>
