				<Item class="LocalScript" referent="RBX2253">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">LocalScript</string>
						<ProtectedString name="Source">function switch(value)
&#9;local c = workspace.CurrentCamera
&#9;if c.CameraSubject == game.Players.LocalPlayer.Character.Humanoid and not value then
&#9;&#9;if script.Parent.TheIt.Value and script.Parent.TheIt.Value.Parent then
&#9;&#9;&#9;c.CameraSubject = script.Parent.TheIt.Value
&#9;&#9;&#9;c.CameraType = Enum.CameraType.Track
&#9;&#9;&#9;script.Parent.Switch.Text = &quot;View Yourself&quot;
&#9;&#9;&#9;script.Parent.Switch.TextColor3 = Color3.new(0,0,0)
&#9;&#9;else
&#9;&#9;&#9;script.Parent.Switch.Text = &quot;Cannot find the It&quot;
&#9;&#9;&#9;script.Parent.Switch.TextColor3 = Color3.new(1,0,0)
&#9;&#9;&#9;wait(3)
&#9;&#9;&#9;if script.Parent.Switch.Text == &quot;Cannot find the It&quot; then
&#9;&#9;&#9;&#9;script.Parent.Switch.Text = &quot;View It&quot;
&#9;&#9;&#9;&#9;script.Parent.Switch.TextColor3 = Color3.new(0,0,0)
&#9;&#9;&#9;end
&#9;&#9;end
&#9;else
&#9;&#9;c.CameraSubject = game.Players.LocalPlayer.Character.Humanoid
&#9;&#9;c.CameraType = Enum.CameraType.Custom
&#9;&#9;script.Parent.Switch.Text = &quot;View It&quot;
&#9;&#9;script.Parent.Switch.TextColor3 = Color3.new(0,0,0)
&#9;end
end

script.Parent.Switch.MouseButton1Down:connect(function() switch(false) end)
script.Parent.ChildAdded:connect(function(new)
&#9;if new.Name == &quot;RevertCam&quot; then
&#9;&#9;switch(true)
&#9;&#9;wait()
&#9;&#9;new.Parent = nil
&#9;end
end)
</ProtectedString>
