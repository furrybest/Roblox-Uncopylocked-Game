&#9;&#9;elseif ChosenField == 14 then
&#9;&#9;&#9;Message(&quot;The Desert field has been chosen.  Created by Mace122.&quot; .. CHSN,game.Workspace,6)
&#9;&#9;elseif ChosenField == 15 then
&#9;&#9;&#9;Message(&quot;The Waiting Room has been chosen.  Created by lando64000.&quot; .. CHSN,game.Workspace,6)
&#9;&#9;elseif ChosenField == 16 then
&#9;&#9;&#9;Message(&quot;The Mountain Base Field has been chosen.  Created by Mccainissocool.&quot; .. CHSN,game.Workspace,6)
&#9;&#9;elseif ChosenField == 17 then
&#9;&#9;&#9;Message(&quot;The Hidden Village Field has been chosen.  Created by lando64000.&quot; .. CHSN,game.Workspace,6)
&#9;&#9;elseif ChosenField == 18 then
&#9;&#9;&#9;Message(&quot;The Big City Field has been chosen.  Created by lando64000.&quot; .. CHSN,game.Workspace,6)
&#9;&#9;elseif ChosenField == 19 then
&#9;&#9;&#9;Message(&quot;The Santa&apos;s Workshop Field has been chosen.  Created by tbradm.&quot; .. CHSN,game.Workspace,6)
&#9;&#9;elseif ChosenField == 20 then
&#9;&#9;&#9;Message(&quot;The Woods Field has been chosen.  Created by ICE128.&quot; .. CHSN,game.Workspace,6)
&#9;&#9;elseif ChosenField == 21 then
&#9;&#9;&#9;Message(&quot;The Factory Field has been chosen.  Created by asknunlab.&quot; .. CHSN,game.Workspace,6)
&#9;&#9;elseif ChosenField == 22 then
&#9;&#9;&#9;Message(&quot;The Underground Pipes Field has been chosen.  Created by tbradm.&quot; .. CHSN,game.Workspace,6)
&#9;&#9;elseif ChosenField == 23 then
&#9;&#9;&#9;Message(&quot;The Enchanted Forest Field has been chosen.  Created by asknunlab.&quot; .. CHSN,game.Workspace,6)
&#9;&#9;elseif ChosenField == 24 then
&#9;&#9;&#9;Message(&quot;The Mountainside Home Field has been chosen.  Created by Splecki.&quot; .. CHSN,game.Workspace,6)
&#9;&#9;elseif ChosenField == 25 then
&#9;&#9;&#9;Message(&quot;The Underwater Temple Field has been chosen.  Created by asknunlab.&quot; .. CHSN,game.Workspace,6)
&#9;&#9;elseif ChosenField == 26 then
&#9;&#9;&#9;Message(&quot;The Dark Hills Field has been chosen.  Created by asknunlab.&quot; .. CHSN,game.Workspace,6)
&#9;&#9;elseif ChosenField == 27 then
&#9;&#9;&#9;Message(&quot;The Abandoned Mines Field has been chosen.  Created by asknunlab.&quot; .. CHSN,game.Workspace,6)
&#9;&#9;elseif ChosenField == 28 then
&#9;&#9;&#9;Message(&quot;The Compass Crossroads Field has been chosen.  Created by asknunlab.&quot; .. CHSN,game.Workspace,6)
&#9;&#9;elseif ChosenField == 29 then
&#9;&#9;&#9;Message(&quot;The Pet Shop Field has been chosen.  Created by BeckyBoo8.&quot; .. CHSN,game.Workspace,6)
&#9;&#9;elseif ChosenField == 30 then
&#9;&#9;&#9;Message(&quot;The Abandoned Moon Base Field has been chosen.  Created by lando64000.&quot; .. CHSN,game.Workspace,6)
&#9;&#9;end
&#9;&#9;wait(3)
&#9;&#9;for i=1, #P do
&#9;&#9;&#9;if P[i] ~= RP then
&#9;&#9;&#9;&#9;if P[i] ~= nil and P[i].Character ~= nil and P[i].Character:findFirstChild(&quot;Torso&quot;) ~= nil and P[i].Character:findFirstChild(&quot;Humanoid&quot;) ~= nil then
&#9;&#9;&#9;&#9;&#9;P[i].Character.Humanoid.Jump = true
&#9;&#9;&#9;&#9;&#9;if ChosenField == 6 or ChosenField == 16 or ChosenField == 19 or ChosenField == 25 or ChosenField == 26 or ChosenField == 29 or ChosenField == 30 then
&#9;&#9;&#9;&#9;&#9;&#9;--P[i].Character.Torso.CFrame = CFrame.new(math.random(-345,-317),39,math.random(-69,-43))
&#9;&#9;&#9;&#9;&#9;&#9;teleport(P[i].Character.Torso, CFrame.new(math.random(-345,-317),39,math.random(-69,-43)))
&#9;&#9;&#9;&#9;&#9;elseif ChosenField == 24 then
&#9;&#9;&#9;&#9;&#9;&#9;--P[i].Character.Torso.CFrame = CFrame.new(math.random(-526,-498),93,math.random(109,135))
&#9;&#9;&#9;&#9;&#9;&#9;teleport(P[i].Character.Torso, CFrame.new(math.random(-526,-498),93,math.random(109,135)))
&#9;&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;&#9;--P[i].Character.Torso.CFrame = CFrame.new(math.random(-212,-184),27,math.random(-74,-48))
&#9;&#9;&#9;&#9;&#9;&#9;teleport(P[i].Character.Torso, CFrame.new(math.random(-212,-184),27,math.random(-74,-48)))
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;P[i].Character.Head.Transparency = 1
&#9;&#9;&#9;&#9;&#9;P[i].Tagged.Value = false
&#9;&#9;&#9;&#9;&#9;--game.Lighting[&quot;View It&quot;]:clone().Parent = P[i].Backpack
&#9;&#9;&#9;&#9;&#9;if P[i]:findFirstChild(&quot;PlayerGui&quot;) and P[i].PlayerGui:findFirstChild(&quot;HSGui&quot;) and P[i].PlayerGui.HSGui:findFirstChild(&quot;ViewIt&quot;) then
&#9;&#9;&#9;&#9;&#9;&#9;local g = P[i].PlayerGui.HSGui.ViewIt
&#9;&#9;&#9;&#9;&#9;&#9;g.TheIt.Value = RP.Character
&#9;&#9;&#9;&#9;&#9;&#9;if g:findFirstChild(&quot;LocalScript&quot;) then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;local s = g.LocalScript:clone()
&#9;&#9;&#9;&#9;&#9;&#9;&#9;g.LocalScript:remove()
&#9;&#9;&#9;&#9;&#9;&#9;&#9;s.Parent = g
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;g.Visible = true
