				<Item class="Script" referent="RBX4612">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">local Trans = 0
local H, F

script.Parent.Equipped:connect(function()
&#9;wait()
&#9;if script.Parent.Parent.Name == &quot;It &quot; or script.Parent.Parent:findFirstChild(&quot;IsTheIt&quot;) then
&#9;&#9;local p = game.Players:playerFromCharacter(script.Parent.Parent)
&#9;&#9;if p == nil then
&#9;&#9;&#9;script.Parent.Parent = nil
&#9;&#9;else
&#9;&#9;&#9;script.Parent.Parent = p.Backpack
&#9;&#9;&#9;local H = Instance.new(&quot;Message&quot;)
&#9;&#9;&#9;H.Text = &quot;The &apos;It&apos; cannot use this tool. Sorry.&quot;
&#9;&#9;&#9;H.Parent = p
&#9;&#9;&#9;wait(1.5)
&#9;&#9;&#9;H:remove()
&#9;&#9;end
&#9;&#9;return
&#9;end
&#9;head = script.Parent.head.Value.Head
--&#9;head.Parent.Name = script.Parent.Parent.Name
&#9;H = script.Parent.Parent.Head
&#9;Trans = H.Transparency
&#9;H.Transparency = 1
&#9;head.BrickColor = H.BrickColor
&#9;head.face:remove()
&#9;head.Mesh:remove()
&#9;script.Parent.Parent.Head.Mesh:clone().Parent = head
&#9;script.Parent.Parent.Head.face:clone().Parent = head
&#9;F = script.Parent.Parent.Head.face:clone()
&#9;script.Parent.Parent.Head.face:remove()
&#9;local h = script.Parent.Parent:GetChildren()
&#9;for i = 1, #h do
&#9;&#9;if h[i].className == &quot;Hat&quot; and h[i].Name ~= &quot;tbradmsBowserShellthing&quot; then
&#9;&#9;&#9;HAT = h[i]
&#9;&#9;&#9;HAT.Parent = head.Parent
&#9;&#9;&#9;weld = Instance.new(&quot;Weld&quot;) 
&#9;&#9;&#9;weld.Part0 = HAT.Handle
&#9;&#9;&#9;weld.Part1 = head
&#9;&#9;&#9;weld.C0 = HAT.AttachmentPoint
&#9;&#9;&#9;weld.C1 = CFrame.new(0,0.5,0)
&#9;&#9;&#9;weld.Parent = weld.Part0
&#9;&#9;end
&#9;end
end)

script.Parent.Unequipped:connect(function()
&#9;if H and F then
&#9;&#9;H.Transparency = Trans
&#9;&#9;F.Parent = H
&#9;end
&#9;local h = head.Parent:GetChildren()
&#9;for i = 1, #h do
&#9;&#9;if h[i].className == &quot;Hat&quot; then
&#9;&#9;&#9;HAT = h[i]
&#9;&#9;&#9;HAT.Handle:BreakJoints()
&#9;&#9;&#9;HAT.Parent = H.Parent
&#9;&#9;end
&#9;end
end)</ProtectedString>
