									<Content name="LinkedSource"><null></null></Content>
									<string name="Name">Script</string>
									<ProtectedString name="Source">script.Parent.Touched:connect(function(hit)
&#9;if hit.Parent:findFirstChild(&quot;Humanoid&quot;) == nil then return end
&#9;local p = game.Players:playerFromCharacter(hit.Parent)
&#9;if p == nil then return end
&#9;local val = p.Coins[&quot;Coin&quot; .. tostring(script.Parent.FieldNumber.Value)]
&#9;if val == nil then return end
&#9;if val.Value then return end
&#9;val.Value = true
&#9;local m = Instance.new(&quot;Message&quot;)
&#9;m.Name = &quot;CoinMsg&quot;
&#9;local P = p.Coins:GetChildren()
&#9;local coins = 0
&#9;for i = 1, #P do
&#9;&#9;if P[i].Value then
&#9;&#9;&#9;coins = coins + 1
&#9;&#9;end
&#9;end
&#9;m.Parent = p
&#9;if coins == game.Lighting.NumberOfFields.Value then
&#9;&#9;m.Text = &quot;Congratulations!  You found all of the red coins!&quot;
&#9;&#9;local b = game:GetService(&quot;BadgeService&quot;)
&#9;&#9;b:AwardBadge(p.userId, 14670287)
&#9;else
&#9;&#9;m.Text = &quot;You found the red coin for this field!  (&quot; .. tostring(game.Lighting.NumberOfFields.Value - coins) .. &quot; left)&quot;
&#9;end
&#9;wait(5)
&#9;m.Parent = nil
end)
</ProtectedString>
								</Properties>
							</Item>
						</Item>
					</Item>
				</Item>
				<Item class="Script" referent="RBX1338">
