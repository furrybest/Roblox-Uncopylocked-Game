							<ProtectedString name="Source">local player = script.Parent.Parent.Parent.Parent

player.ChildAdded:connect(function(new)
&#9;if new:IsA(&quot;Message&quot;) and new.Name == &quot;CoinMsg&quot; then
&#9;&#9;script.Parent.TextLabel.Text = new.Text
&#9;&#9;new.Text = &quot;&quot;
