						<string name="Name">WeldScript</string>
						<ProtectedString name="Source">function onChanged()
&#9;local w1 = Instance.new(&quot;Weld&quot;)
&#9;w1.Parent = script.Parent.Handle
&#9;w1.Part0 = w1.Parent
&#9;w1.Part1 = script.Parent.Handle2
&#9;w1.C1 = CFrame.new(-0, 4, -0.1)

script.Parent.Handle2.Transparency = 0.5
end
script.Parent.AncestryChanged:connect(onChanged)</ProtectedString>
