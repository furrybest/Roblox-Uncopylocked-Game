					<string name="Name">ItScript</string>
					<ProtectedString name="Source">function Message(msg,par,time)
local M = Instance.new(&quot;Hint&quot;)
M.Text = msg
M.Parent = par
wait(time)
M:remove()
end

local halt = false

function teleport(torso, newCF)
&#9;if not torso then return end
&#9;local a = torso.Anchored
&#9;torso.Anchored = true
&#9;while (torso.Position-newCF.p).magnitude &gt; 0.1 and torso do
&#9;&#9;torso.CFrame = newCF
&#9;&#9;wait()
&#9;end
&#9;if torso then
&#9;&#9;torso.Anchored = a
&#9;end
end

function T(hit)
&#9;if halt then return end
&#9;halt = true
&#9;if hit.Parent:findFirstChild(&quot;Humanoid&quot;) ~= nil then
&#9;local P = game.Players:playerFromCharacter(hit.Parent)
&#9;&#9;if P ~= nil then
&#9;&#9;if P.Name == &quot;lando64000&quot; then
&#9;&#9;&#9;local player = game.Players:playerFromCharacter(script.Parent)
&#9;&#9;&#9;if player ~= nil then
&#9;&#9;&#9;&#9;local b = game:GetService(&quot;BadgeService&quot;)
&#9;&#9;&#9;&#9;b:AwardBadge(player.userId, script.BadgeID.Value)
&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;P.Character.Humanoid.Jump = true
&#9;&#9;--P.Character.Torso.CFrame = CFrame.new(-14.5, 199, -62.5)
&#9;&#9;teleport(P.Character.Torso, CFrame.new(-14.5, 199, -62.5))
&#9;&#9;local LP = game.Players:playerFromCharacter(script.Parent)
&#9;&#9;LP.leaderstats.Points.Value = LP.leaderstats.Points.Value + 2
&#9;&#9;P.Tagged.Value = true
&#9;&#9;script.NumCaught.Value = script.NumCaught.Value + 1
&#9;&#9;local o = hit.Parent.Humanoid:findFirstChild(&quot;OriSpeed&quot;)
&#9;&#9;if o ~= nil then
&#9;&#9;&#9;hit.Parent.Humanoid.WalkSpeed = o.Value
&#9;&#9;&#9;o:remove()
&#9;&#9;end
--&#9;&#9;Message(P.Name .. &quot; has been found.&quot;,game.Workspace,3)
&#9;&#9;end
&#9;end
&#9;wait(.01)
&#9;halt = false
end

local P = script.Parent:GetChildren()
for i = 1, #P do
&#9;if P[i].className == &quot;Part&quot; then
&#9;&#9;P[i].Touched:connect(T)
&#9;end
end
script.Parent.Humanoid.WalkSpeed = 19</ProtectedString>
