						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">function shiftColor(p)
&#9;--coroutine.resume(coroutine.create(function(p)
&#9;&#9;function u(n,i)
&#9;&#9;&#9;if math.abs(n) &lt; i then
&#9;&#9;&#9;&#9;return n
&#9;&#9;&#9;end
&#9;&#9;&#9;return (Vector3.new(n,0,0).unit.x)*i
&#9;&#9;end
&#9;&#9;local new = Vector3.new(10/math.random(10,100),10/math.random(10,100),10/math.random(10,100))
&#9;&#9;local dif = new - p.Mesh.VertexColor
&#9;&#9;repeat
&#9;&#9;&#9;local d = Vector3.new(u(dif.x,0.01),u(dif.y,0.01),u(dif.z,0.01))
&#9;&#9;&#9;p.Mesh.VertexColor = p.Mesh.VertexColor + d
&#9;&#9;&#9;dif = dif - d
&#9;&#9;&#9;wait()
&#9;&#9;until math.abs(dif.x) &lt;= 0.03 and math.abs(dif.y) &lt;= 0.03 and math.abs(dif.z) &lt;= 0.03
&#9;--end),p)
end

while true do
&#9;wait()
&#9;shiftColor(script.Parent)
end
</ProtectedString>
					</Properties>
					<Item class="Script" referent="RBX3408">
						<Properties>
							<bool name="Disabled">true</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">orig.</string>
							<ProtectedString name="Source">function shiftColor(p)
&#9;if not p:findFirstChild(&quot;Mesh&quot;) then
&#9;&#9;script.Mesh:clone().Parent = p
&#9;&#9;p.Mesh.Scale = p.Size * 2
&#9;end
&#9;coroutine.resume(coroutine.create(function(p)
&#9;&#9;function u(n,i)
&#9;&#9;&#9;if math.abs(n) &lt; i then
&#9;&#9;&#9;&#9;return n
&#9;&#9;&#9;end
&#9;&#9;&#9;return (Vector3.new(n,0,0).unit.x)*i
&#9;&#9;end
&#9;&#9;local new = Vector3.new(10/math.random(10,100),10/math.random(10,100),10/math.random(10,100))
&#9;&#9;local dif = new - p.Mesh.VertexColor
&#9;&#9;repeat
&#9;&#9;&#9;local d = Vector3.new(u(dif.x,0.01),u(dif.y,0.01),u(dif.z,0.01))
&#9;&#9;&#9;p.Mesh.VertexColor = p.Mesh.VertexColor + d
&#9;&#9;&#9;dif = dif - d
&#9;&#9;&#9;wait()
&#9;&#9;until math.abs(dif.x) &lt;= 0.03 and math.abs(dif.y) &lt;= 0.03 and math.abs(dif.z) &lt;= 0.03
&#9;end),p)
end

while true do
&#9;wait(4)
&#9;for i,j in pairs(script.Parent:GetChildren()) do
&#9;&#9;if j:IsA(&quot;BasePart&quot;) then
&#9;&#9;&#9;shiftColor(j)
&#9;&#9;end
&#9;end
end
</ProtectedString>
