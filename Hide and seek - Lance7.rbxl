					<Item class="Script" referent="RBX831">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script</string>
							<ProtectedString name="Source">local halt = false

function weld(a,b)
&#9;local w = Instance.new(&quot;Weld&quot;)
&#9;w.Part0 = a
&#9;w.Part1 = b
&#9;w.C0 = a.CFrame:inverse() * CFrame.new(a.Position)
&#9;w.C1 = b.CFrame:inverse() * CFrame.new(a.Position)
&#9;w.Parent = a
end

script.Parent.Touched:connect(function(hit)
&#9;if hit.Parent:findFirstChild(&quot;Humanoid&quot;) == nil or hit.Parent:findFirstChild(&quot;Head&quot;) == nil then return end
&#9;if halt then return end
&#9;halt = true
&#9;local v = hit.Parent:findFirstChild(&quot;VIPmask&quot;)
&#9;if v ~= nil then v:remove() end
&#9;local g = script.Parent.Parent.VIPmask:clone()
&#9;for _, i in ipairs(g:GetChildren()) do
&#9;&#9;if i.className == &quot;Part&quot; and i.Name ~= &quot;Main&quot; then
&#9;&#9;&#9;weld(i, g.Main)
&#9;&#9;&#9;i.Anchored = false
&#9;&#9;end
&#9;end
&#9;local w = Instance.new(&quot;Weld&quot;)
&#9;w.Part0 = hit.Parent.Head
&#9;w.Part1 = g.Main
&#9;w.C0 = CFrame.new(0,0,0)
&#9;w.Parent = w.Part0
&#9;g.Parent = hit.Parent
&#9;g.Main.Anchored = false
&#9;wait(2)
&#9;halt = false
end)
</ProtectedString>
						</Properties>
					</Item>
				</Item>
			</Item>
