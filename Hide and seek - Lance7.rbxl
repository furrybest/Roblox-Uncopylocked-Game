				<Item class="Script" referent="RBX1110">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Welding</string>
						<ProtectedString name="Source">function Weld(x,y)
&#9;local W = Instance.new(&quot;Weld&quot;)
&#9;W.Part0 = x
&#9;W.Part1 = y
&#9;local CJ = CFrame.new(x.Position)
&#9;local C0 = x.CFrame:inverse()*CJ
&#9;local C1 = y.CFrame:inverse()*CJ
&#9;W.C0 = C0
&#9;W.C1 = C1
&#9;W.Parent = x
end

function Get(A)
&#9;if A.className == &quot;Part&quot; then
&#9;&#9;Weld(script.Parent.Handle, A)
&#9;&#9;A.Anchored = false
&#9;else
&#9;&#9;local C = A:GetChildren()
&#9;&#9;for i=1, #C do
&#9;&#9;Get(C[i])
&#9;&#9;end
&#9;end
end

function Finale()
&#9;Get(script.Parent)
end

Finale()</ProtectedString>
					</Properties>
				</Item>
			</Item>
			<Item class="Script" referent="RBX1111">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Game</string>
					<ProtectedString name="Source">Number_Of_Fields = 30
CField = 0
FIELDS = {}

-- teleportation fix...?

function teleport(torso, newCF)
&#9;if not torso then return end
&#9;local a = torso.Anchored
&#9;torso.Anchored = true
&#9;while (torso.Position-newCF.p).magnitude &gt; 0.1 and torso do
&#9;&#9;torso.CFrame = newCF
&#9;&#9;wait()
&#9;end
&#9;if torso then
&#9;&#9;torso.Anchored = a
&#9;end
end

-- CHOOSING FIELD FUNCTIONS 

PField = 0
local cRoom = workspace.fieldChoosePass
local buttons = workspace.Buttons
local deb = false
local choosing = false
local chooser = nil
local cost = 25
local chooserName = &quot;&quot;

local P = cRoom:GetChildren()
for i = 1, #P do
&#9;if P[i].className == &quot;Part&quot; then
&#9;&#9;local t = Instance.new(&quot;NumberValue&quot;)
&#9;&#9;t.Name = &quot;Trans&quot;
&#9;&#9;t.Value = P[i].Transparency
&#9;&#9;t.Parent = P[i]
&#9;end
end
local P = buttons:GetChildren()
for i = 1, #P do
&#9;if P[i]:findFirstChild(&quot;Head&quot;) ~= nil then
&#9;&#9;local t = Instance.new(&quot;ClickDetector&quot;)
&#9;&#9;t.Parent = P[i].Head
&#9;&#9;t.MouseClick:connect(function()
&#9;&#9;&#9;if not choosing then return end
&#9;&#9;&#9;PField = P[i].FieldNum.Value
&#9;&#9;&#9;choosing = false
&#9;&#9;&#9;if chooser ~= nil then
&#9;&#9;&#9;&#9;chooser.leaderstats.Points.Value = chooser.leaderstats.Points.Value - cost
&#9;&#9;&#9;&#9;if chooser.Character ~= nil and chooser.Character:findFirstChild(&quot;Torso&quot;) ~= nil then
&#9;&#9;&#9;&#9;&#9;--chooser.Character.Torso.CFrame = CFrame.new(cRoom.Plat.Position.x,cRoom.Plat.Position.y+6,cRoom.Plat.Position.z)
&#9;&#9;&#9;&#9;&#9;teleport(chooser.Character.Torso, CFrame.new(cRoom.Plat.Position.x,cRoom.Plat.Position.y+6,cRoom.Plat.Position.z))
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end)
&#9;end
end

function open()
&#9;if PField ~= 0 then return end
&#9;local P = cRoom:GetChildren()
&#9;for i = 1, #P do 
&#9;&#9;if P[i].className == &quot;Part&quot; then
&#9;&#9;&#9;P[i].Transparency = P[i].Trans.Value
&#9;&#9;end
&#9;end
&#9;deb = false
end

function close()
&#9;deb = true
&#9;local P = cRoom:GetChildren()
&#9;for i = 1, #P do 
&#9;&#9;if P[i].className == &quot;Part&quot; then
&#9;&#9;&#9;P[i].Transparency = 1
&#9;&#9;end
&#9;end
&#9;cRoom.Door1.Transparency = 0.7
&#9;cRoom.Door2.Transparency = 0.7
&#9;cRoom.Plat.Transparency = 0
&#9;cRoom.Plat2.Transparency = 0
end

cRoom.Button.Touched:connect(function(hit)
&#9;if deb then return end
&#9;if hit.Parent:findFirstChild(&quot;Torso&quot;) == nil then return end
&#9;local p = game.Players:playerFromCharacter(hit.Parent)
&#9;if p == nil then return end
&#9;local l = p:findFirstChild(&quot;leaderstats&quot;)
&#9;if l == nil then return end
&#9;local P = l:findFirstChild(&quot;Points&quot;)
&#9;if P == nil then return end
&#9;if P.Value &lt; cost then return end
&#9;deb = true
&#9;hit.Parent.Torso.Anchored = true
&#9;local ws = hit.Parent.Humanoid.WalkSpeed
&#9;hit.Parent.Humanoid.WalkSpeed = 0
&#9;while true do
&#9;&#9;if hit == nil then
&#9;&#9;&#9;open()
&#9;&#9;&#9;return
&#9;&#9;end
&#9;&#9;hit.Parent.Torso.CFrame = hit.Parent.Torso.CFrame + Vector3.new(0,0,0.5)
&#9;&#9;if hit.Parent.Torso.Position.z &gt; (cRoom.Door2.Position.z+5) then break end
&#9;&#9;wait()
&#9;end
&#9;if hit == nil then
&#9;&#9;open()
&#9;&#9;return
&#9;end
&#9;hit.Parent.Torso.Anchored = false
&#9;hit.Parent.Humanoid.WalkSpeed = ws
&#9;close()
&#9;if p == nil then
&#9;&#9;open()
&#9;&#9;return
&#9;end
&#9;choosing = true
&#9;chooser = p
&#9;chooserName = p.Name
end)

-- =====================

local H = Instance.new(&quot;Hint&quot;)
H.Parent = workspace
local RP = nil
local field = nil
local Guis = {}

for i = 1, Number_Of_Fields do
&#9;FIELDS[i] = game.Lighting[&quot;field&quot; .. tostring(i)]:clone()
&#9;game.Lighting[&quot;field&quot; .. tostring(i)]:remove()
end

function showIt(it) -- Create Gui over It&apos;s head
&#9;local b = Instance.new(&quot;BillboardGui&quot;)
&#9;b.StudsOffset = Vector3.new(0,1.7,0)
&#9;--b.ExtentsOffset = Vector3.new(0,0,1)
&#9;b.Size = UDim2.new(1.5,0,1.5,0)
&#9;local i = Instance.new(&quot;ImageLabel&quot;)
&#9;i.Size = UDim2.new(1,0,1,0)
&#9;i.BackgroundTransparency = 1
&#9;i.Image = &quot;http://www.roblox.com/asset/?id=21570570&quot;
&#9;i.Parent = b
&#9;local t = Instance.new(&quot;TextLabel&quot;)
&#9;t.Text = &quot;IT&quot;
&#9;--t.Parent = b
&#9;local p = it.Character:findFirstChild(&quot;Head&quot;)
&#9;b.Adornee = p
&#9;b.Parent = p
&#9;table.insert(Guis,b)
&#9;--[===[
&#9;for i,j in pairs(game.Players:GetChildren()) do
&#9;&#9;local B = b:clone()
&#9;&#9;B.Adornee = it.Character:findFirstChild(&quot;Head&quot;)
&#9;&#9;B.Parent = j:findFirstChild(&quot;PlayerGui&quot;)
&#9;&#9;table.insert(Guis,B)
&#9;end--]===]
end

function Choose()
&#9;if PField ~= 0 then
&#9;&#9;CHSN = &quot;   Chosen by &quot; .. chooserName .. &quot;.&quot;
&#9;&#9;ChosenField = PField
&#9;&#9;PField = 0
&#9;elseif choosing and chooser ~= nil and chooser.Character ~= nil then
&#9;&#9;Message(&quot;The Field Chooser (&quot; .. chooserName .. &quot;) has 20 seconds to choose a field.&quot;,workspace,4)
&#9;&#9;for i = 1, 16 do
&#9;&#9;&#9;wait(1)
&#9;&#9;&#9;if PField ~= 0 then break end
&#9;&#9;end
&#9;&#9;if PField == 0 then
&#9;&#9;&#9;if chooser ~= nil then
&#9;&#9;&#9;&#9;if chooser.Character ~= nil then
&#9;&#9;&#9;&#9;&#9;if chooser.Character:findFirstChild(&quot;Torso&quot;) ~= nil then
&#9;&#9;&#9;&#9;&#9;&#9;--chooser.Character.Torso.CFrame = CFrame.new(cRoom.Plat.Position.x,cRoom.Plat.Position.y+6,cRoom.Plat.Position.z)
&#9;&#9;&#9;&#9;&#9;&#9;teleport(chooser.Character.Torso, CFrame.new(cRoom.Plat.Position.x,cRoom.Plat.Position.y+6,cRoom.Plat.Position.z))
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;else
&#9;&#9;&#9;CHSN = &quot;   Chosen by &quot; .. chooserName .. &quot;.&quot;
&#9;&#9;&#9;ChosenField = PField
&#9;&#9;&#9;PField = 0
&#9;&#9;end
&#9;else
&#9;&#9;if CField &lt; Number_Of_Fields then
&#9;&#9;&#9;CField = CField + 1
&#9;&#9;else
&#9;&#9;&#9;CField = 1
&#9;&#9;end
&#9;&#9;ChosenField = CField
&#9;&#9;CHSN = &quot;&quot;
&#9;end
&#9;close()
&#9;script.canHaveGear.Value = false
&#9;local P = game.Players:GetChildren()
&#9;RP = P[math.random(1,#P)]
&#9;if RP and RP.Character then
&#9;&#9;pcall(function() RP.Character.Name = &quot;It &quot; end)
&#9;&#9;local v = Instance.new(&quot;BoolValue&quot;)
&#9;&#9;v.Name = &quot;IsTheIt&quot;
&#9;&#9;v.Parent = RP.Character
&#9;&#9;showIt(RP)
&#9;&#9;Message(RP.Name .. &quot; is it!&quot;,game.Workspace,4)
&#9;&#9;field = FIELDS[ChosenField]:clone()
&#9;&#9;field.Parent = game.Workspace
&#9;&#9;if ChosenField == 1 then
&#9;&#9;&#9;Message(&quot;The Ghost Town field has been chosen.  Created by lando64000.&quot; .. CHSN,game.Workspace,6)
&#9;&#9;elseif ChosenField == 2 then
&#9;&#9;&#9;Message(&quot;The Jurrasic field has been chosen.  Created by lando64000.&quot; .. CHSN,game.Workspace,6)
&#9;&#9;elseif ChosenField == 3 then
&#9;&#9;&#9;Message(&quot;The Undersea field has been chosen.  Created by lando64000.&quot; .. CHSN,game.Workspace,6)
&#9;&#9;elseif ChosenField == 4 then
&#9;&#9;&#9;Message(&quot;The Army base field has been chosen.  Created by secretcape.&quot; .. CHSN,game.Workspace,6)
&#9;&#9;elseif ChosenField == 5 then
&#9;&#9;&#9;Message(&quot;The Power Plant field has been chosen.  Created by lando64000.&quot; .. CHSN,game.Workspace,6)
&#9;&#9;elseif ChosenField == 6 then
&#9;&#9;&#9;Message(&quot;The Backyard field has been chosen.  Created by lando64000.&quot; .. CHSN,game.Workspace,6)
&#9;&#9;elseif ChosenField == 7 then
&#9;&#9;&#9;Message(&quot;The Wild West field has been chosen.  Created by lando64000.&quot; .. CHSN,game.Workspace,6)
&#9;&#9;elseif ChosenField == 8 then
&#9;&#9;&#9;Message(&quot;The Sea side field has been chosen.  Created by Rockman7000.&quot; .. CHSN,game.Workspace,6)
&#9;&#9;elseif ChosenField == 9 then
&#9;&#9;&#9;Message(&quot;The City Ruins field has been chosen.  Created by asknunlab.&quot; .. CHSN,game.Workspace,6)
&#9;&#9;elseif ChosenField == 10 then
&#9;&#9;&#9;Message(&quot;The Museum Ruins field has been chosen.  Created by MarioBros125253.&quot; .. CHSN,game.Workspace,6)
&#9;&#9;elseif ChosenField == 11 then
&#9;&#9;&#9;Message(&quot;The Winter Land Field has been chosen.  Created by Sinisteralex.&quot; .. CHSN,game.Workspace,6)
&#9;&#9;elseif ChosenField == 12 then
&#9;&#9;&#9;Message(&quot;The Clocktown field has been chosen.  Created by Twinmold.&quot; .. CHSN,game.Workspace,6)
