&#9;&#9;end
&#9;&#9;if caughtAll and RP ~= nil and RP.Character ~= nil then
&#9;&#9;&#9;if numcaught &gt;= 8 then
&#9;&#9;&#9;&#9;local b = game:GetService(&quot;BadgeService&quot;)
&#9;&#9;&#9;&#9;b:AwardBadge(RP.userId, 14470942)
&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;--[[
&#9;&#9;if RP ~= nil and RP.Character ~= nil then
&#9;&#9;RP.Character.Name = &quot;&quot;
&#9;&#9;end
&#9;&#9;]]
&#9;&#9;RP = nil
&#9;&#9;if field~= nil then
&#9;&#9;&#9;field:remove()
&#9;&#9;&#9;field = nil
&#9;&#9;end
&#9;&#9;if game.Workspace:findFirstChild(&quot;It&quot;) ~= nil then
&#9;&#9;&#9;game.Workspace[&quot;It&quot;]:remove()
&#9;&#9;end
&#9;&#9;--wait(3)
--&#9;&#9;script.canHaveGear.Value = true
&#9;&#9;Message(&quot;Take a few to chill out and relax...&quot;,game.Workspace,4)
&#9;&#9;WAIT(35, &quot;until next round&quot;)
&#9;&#9;Message(&quot;Time for a new game!&quot;,game.Workspace,4)
&#9;&#9;Start()
&#9;else
&#9;&#9;Start()
&#9;&#9;--wait(2)
&#9;end
end

function Message(msg,par,time)
&#9;local M = Instance.new(&quot;Message&quot;)
&#9;M.Text = msg
&#9;M.Parent = par
&#9;wait(time)
&#9;M:remove()
end

function Start()
&#9;RP = nil
&#9;if PField == 0 and not choosing then open() end
&#9;if game.Players.NumPlayers &gt;= 3 then
&#9;&#9;Choose()
&#9;elseif game.Players.NumPlayers &lt; 3 then
&#9;&#9;Message(&quot;Minimum requirement of 3 players... Sorry.&quot;,game.Workspace,5)
&#9;&#9;print(&quot;Not enough players&quot;)
&#9;&#9;Wait()
&#9;end
end

function Wait()
&#9;WAIT(30, &quot;until next round&quot;)
&#9;Start()
end

function WAIT(time, Until, value)
&#9;local Time = time
&#9;for i = 1, time do
&#9;&#9;local min = math.floor(Time / 60)
&#9;&#9;local sec = Time % 60
&#9;&#9;H.Text = tostring(min) .. &quot; minutes and &quot; .. tostring(sec) .. &quot; seconds &quot; .. Until
&#9;&#9;wait(1)
&#9;&#9;Time = Time - 1
&#9;&#9;if value then
&#9;&#9;&#9;if RP == nil or RP.Parent == nil then
&#9;&#9;&#9;&#9;Message(&quot;The &apos;It&apos; left, starting new game...&quot;, workspace, 6)
&#9;&#9;&#9;&#9;if field ~= nil then
&#9;&#9;&#9;&#9;&#9;field:remove()
&#9;&#9;&#9;&#9;&#9;field = nil
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;Start()
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
&#9;H.Text = &quot;&quot;
end

wait(6)
Start()</ProtectedString>
