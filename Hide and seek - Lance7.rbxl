					<Item class="Script" referent="RBX3301">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script</string>
							<ProtectedString name="Source">local halt = false

function onTouched(hit)
if hit.Parent:findFirstChild(&quot;Humanoid&quot;) == nil then return end
local RL = hit.Parent:findFirstChild(&quot;Right Arm&quot;)
local LL = hit.Parent:findFirstChild(&quot;Left Arm&quot;)
if LL == nil and RL == nil then return end
local plyr = game.Players:playerFromCharacter(hit.Parent)
if plyr == nil then return end
local stats = plyr:findFirstChild(&quot;leaderstats&quot;)
if stats == nil then return end
local points = stats:findFirstChild(&quot;Points&quot;)
if points == nil then return end
if points.Value &lt; 5 then return end
if halt == true then return end
halt = true
if RL ~= nil then RL.Transparency = 1 end
if LL ~= nil then LL.Transparency = 1 end
points.Value = points.Value - 5
wait(5)
halt = false
end 

script.Parent.Touched:connect(onTouched)</ProtectedString>
