						<ProtectedString name="Source">debounce = true

function onTouched(hit)
&#9;if hit.Parent:findFirstChild(&quot;Humanoid&quot;) ~= nil and debounce == true then
&#9;&#9;if hit.Parent:findFirstChild(&quot;tbradmsBowserShellthing&quot;) ~= nil then
&#9;&#9;&#9;hit.Parent[&quot;tbradmsBowserShellthing&quot;]:remove()
&#9;&#9;end
&#9;&#9;debounce = false
&#9;&#9;h = Instance.new(&quot;Hat&quot;)
&#9;&#9;p = Instance.new(&quot;Part&quot;)
&#9;&#9;h.Name = &quot;tbradmsBowserShellthing&quot;
&#9;&#9;p.Parent = h
&#9;&#9;p.CanCollide = false
&#9;&#9;p.Position = hit.Parent:findFirstChild(&quot;Head&quot;).Position
&#9;&#9;p.Name = &quot;Handle&quot; 
&#9;&#9;p.formFactor = 0
&#9;&#9;p.Size = Vector3.new(1,1,1) 
&#9;&#9;p.BottomSurface = 0 
&#9;&#9;p.TopSurface = 0 
&#9;&#9;p.Locked = true 
&#9;&#9;script.Parent.Mesh:clone().Parent = p
&#9;&#9;h.Parent = hit.Parent
&#9;&#9;h.AttachmentPoint = CFrame.new(0, -0.6, -2, 1, 0, 0, 0, 0, 1, 0, -1, -0)
&#9;&#9;wait(5)
&#9;&#9;debounce = true
&#9;end
end

script.Parent.Touched:connect(onTouched)

--tbradm
