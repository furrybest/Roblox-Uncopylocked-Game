for i=1,3 do
wait(0.4)
m.Text = m.Text .. &quot;.&quot;
end
wait(0.4)

if random == 1 then
m.Text = &quot;Brick Battle!&quot;
wait(2)
m.Text = &quot;Be the last Robloxian standing to win!&quot;
wait(2)
workspace.IsGoing.Value = true
game.Lighting.GameScripts.Game1Script:clone().Parent = game.Workspace
