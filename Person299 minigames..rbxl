					<string name="Name">AFK</string>
					<ProtectedString name="Source">game.Players.PlayerAdded:connect(function(p)
local cnum = 0
local isafk = false
local m = nil
local update = function()
cnum = cnum + 1

print(cnum)
local num = cnum

if isafk == true then
m.Parent = nil
m = nil
p.IsPlaying.Value = true
isafk = false
end

wait(90)

if num == cnum and p.IsPlaying.Value == true then
m = Instance.new(&quot;Message&quot;)
m.Name = &quot;AFKMessage&quot;
m.Text = &quot;You&apos;ve been deemed AFK.&quot;
m.Parent = p
isafk = true
p.IsPlaying.Value = false
end

end

p.Chatted:connect(update)

p.Changed:connect(function(property)
if property == &quot;Character&quot; then
wait(0.3)
if p.Character ~= nil then
local h = p.Character:FindFirstChild(&quot;Humanoid&quot;)
if h ~= nil then
h.Running:connect(update)
h.Jumping:connect(update)
end end end end)

end)</ProtectedString>
