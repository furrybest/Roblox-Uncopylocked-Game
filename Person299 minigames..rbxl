						<string name="Name">Game2Script</string>
						<ProtectedString name="Source">--Initiation
table.insert(_G.GameObjects,script)
gamepoints = 40
workspace.WaitingRoom.North.Value = false
workspace.WaitingRoom.South.Value = false
workspace.WaitingRoom.West.Value = false
workspace.WaitingRoom.East.Value = false

--Functions

function _G.cancel()

workspace.WaitingRoom.North.Value = true
workspace.WaitingRoom.South.Value = true
workspace.WaitingRoom.West.Value = true
workspace.WaitingRoom.East.Value = true

for a,b in ipairs(_G.GameObjects) do
if b ~= script then
b:remove()
end end

_G.killall()

workspace.IsGoing.Value = false
script:remove()

end

function checkwin()
if #workspace.Players:GetChildren() == 1 then
hasended = true
local player = workspace.Players:GetChildren()[1].Value
player.leaderstats.Points.Value = player.leaderstats.Points.Value + gamepoints
local m = Instance.new(&quot;Message&quot;)
table.insert(_G.GameObjects,m)
m.Text = player.Name .. &quot; Won!&quot;
m.Parent = workspace
_G.killall()
_G.removetools()
workspace.WaitingRoom.North.Value = true
workspace.WaitingRoom.South.Value = true
workspace.WaitingRoom.West.Value = true
workspace.WaitingRoom.East.Value = true
wait(2)
for a,b in ipairs(_G.GameObjects) do
if b ~= script then
b:remove()
end end
workspace.IsGoing.Value = false
script:remove()
--_G.cancel(1)
end
end

function permseat(guy,seat)
local h = guy:FindFirstChild(&quot;Humanoid&quot;)
local t = guy:FindFirstChild(&quot;Torso&quot;)
if h ~= nil and t ~= nil then
t.CFrame = seat.CFrame + Vector3.new(0,3,0)
local w = Instance.new(&quot;Weld&quot;)
w.Part0 = seat
w.Part1 = t
w.C0 = CFrame.new(0,2,0)
w.Parent = seat
h.Sit = true
local c = h.Changed:connect(function() if h.Sit == false then h.Health = 0 end end)
end
end

--Body

for n,p in ipairs(game.Players:GetPlayers()) do
local pinfo = _G.checkplayer(p)
if pinfo ~= 0 then

local plane = game.Lighting.GameModels.Game2Model.Plane:clone()
--table.insert(_G.GameObjects,plane)

for a,b in ipairs(plane.Parts:GetChildren()) do
pcall(function() b.BrickColor = pinfo[1].SignatureColor.Value end)
end

for a,b in ipairs(plane.BodyKit:GetChildren()) do
pcall(function() b.BrickColor = pinfo[1].SignatureColor.Value end)
end

plane.Parent = pinfo[2]
plane:MakeJoints()
local op = game.Lighting.GameModels.Game2Model.Plane.Parts.Engine.Position
plane:MoveTo(Vector3.new(math.random(op.x - 500,op.x + 500),math.random(op.y - 50,op.y + 50),op.z))

_G.teleportplayertobrick(pinfo[3],plane.Parts.Seat)

permseat(pinfo[2],plane.Parts.Seat)

local o = Instance.new(&quot;ObjectValue&quot;)
o.Value = p
o.Parent = workspace.Players
_G.givetools(pinfo[5],game.Lighting.GameTools.Game2Tools:GetChildren())
pinfo[4].Died:connect(function() if hasended == nil then o:remove() end end)
end
end 

_G.checkifnone()

workspace.Players.ChildRemoved:connect(checkwin)</ProtectedString>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
				<Item class="Script" referent="RBX2970">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Game3Script</string>
						<ProtectedString name="Source">--Initiation
table.insert(_G.GameObjects,script)
gamemodel = game.Lighting.GameModels.Game3Model:clone()
table.insert(_G.GameObjects,gamemodel)
script.Name = &quot;GameScript&quot;
gamemodel.Name = &quot;GameModel&quot;
gamemodel.Parent = workspace
gamepoints = 35
workspace.WaitingRoom.South.Value = false

for a,b in ipairs(gamemodel:GetChildren()) do
while true do
b.BrickColor = BrickColor.new(math.random(1,268))
if tostring(b.BrickColor) ~= &quot;Medium stone grey&quot; then 
break
end end end


--Functions

function _G.cancel()

workspace.WaitingRoom.South.Value = true

for a,b in ipairs(_G.GameObjects) do
if b ~= script then
b:remove()
end end

_G.returnplayers()

workspace.IsGoing.Value = false
script:remove()

end

function checkwin()
if #workspace.Players:GetChildren() == 1 then
hasended = true
local player = workspace.Players:GetChildren()[1].Value
player.leaderstats.Points.Value = player.leaderstats.Points.Value + gamepoints
local m = Instance.new(&quot;Message&quot;)
table.insert(_G.GameObjects,m)
m.Text = player.Name .. &quot; Won!&quot;
m.Parent = workspace
_G.returnplayers()
_G.removetools()
workspace.WaitingRoom.South.Value = true
wait(2)
for a,b in ipairs(_G.GameObjects) do
if b ~= script then
b:remove()
end end
workspace.IsGoing.Value = false
script:remove()
end
end

--Body

for n,p in ipairs(game.Players:GetPlayers()) do
local pinfo = _G.checkplayer(p)
if pinfo ~= 0 then
local part = gamemodel:GetChildren()[math.random(1,#gamemodel:GetChildren())]
if _G.teleportplayertobrick(pinfo[3],part) == true then
local o = Instance.new(&quot;ObjectValue&quot;)
o.Value = p
o.Parent = workspace.Players
_G.givetools(pinfo[5],game.Lighting.GameTools.Game3Tools:GetChildren())

local bf = Instance.new(&quot;BodyForce&quot;)
bf.Name = &quot;BodyVelocity&quot;
bf.force = Vector3.new(0,600,0)
bf.Parent = pinfo[3]

pinfo[4].Died:connect(function() if hasended == nil then o:remove() end end)
end
end
end 

_G.checkifnone()

workspace.Players.ChildRemoved:connect(checkwin)

local gc = gamemodel:GetChildren()
table.remove(gc,math.random(1,#gc))
for a=1,#gc do

local random = math.random(1,#gc)

local part = gc[random]
table.remove(gc,random)
local rnum = 10
local cf = part.CFrame

coroutine.resume(coroutine.create(function()

for z =1,6 do
