					<Item class="Script" referent="RBX5607">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script</string>
							<ProtectedString name="Source">barrels = {}

Fire = game.Lighting.AdminTools.Fire:clone()

for a=1,6 do
barrels[a] = script.Parent[&quot;Barrel&quot; .. a]
end

bnum = 1
barrel = barrels[bnum]

acc = 5
Tool = script.Parent

function fire(v)
coroutine.resume(coroutine.create(function()
local v = (CFrame.new(Vector3.new(0,0,0),v) * CFrame.fromEulerAnglesXYZ(math.rad(math.random(-acc,acc)),math.rad(math.random(-acc,acc)),0)).lookVector
	Tool.Handle.Fire:play()
	local vCharacter = Tool.Parent
	local vPlayer = game.Players:playerFromCharacter(vCharacter)
	local missile = Instance.new(&quot;Part&quot;)
	local spawnPos = barrel.Position --vCharacter.PrimaryPart.Position
	--spawnPos  = spawnPos + (v * 8)
	missile.Position = spawnPos
	missile.Size = Vector3.new(.1,.1,.1)
	missile.Velocity = v * 350
	missile.BrickColor = BrickColor.Black()--new(colors[math.random(1, #colors)])
	missile.Shape = 1
	missile.BottomSurface = 0
	missile.TopSurface = 0
	missile.Name = &quot;Paintball&quot;
	missile.Elasticity = 0
	missile.Reflectance = 0.3
	missile.Friction = .3
		local mesh = Instance.new(&quot;SpecialMesh&quot;)
		mesh.MeshType = &quot;Sphere&quot;
		mesh.Scale = Vector3.new(0.2, 0.18, 0.2)
		mesh.Parent = missile
	local force = Instance.new(&quot;BodyForce&quot;)
	force.force = Vector3.new(0,missile:getMass() *  186.5,0)
	force.Parent = missile
--	Tool.BrickCleanup:clone().Parent = missile
	local new_script = script.Parent.Paintball:clone()
	new_script.Disabled = false
	new_script.Parent = missile

	local creator_tag = Instance.new(&quot;ObjectValue&quot;)
	creator_tag.Value = vPlayer
	creator_tag.Name = &quot;creator&quot;
	creator_tag.Parent = missile
	missile.Parent = game.Workspace

local f = Fire:clone()
f.CFrame = barrel.CFrame + ((barrel.CFrame * CFrame.fromEulerAnglesXYZ(math.rad(90),0,0)).lookVector * 2.5)
f.Parent = script.Parent
wait()
f:remove()

end))

end

function Weld(x,y)
	local W = Instance.new(&quot;Weld&quot;)
	W.Part0 = x
	W.Part1 = y
	local CJ = CFrame.new(x.Position)
	local C0 = x.CFrame:inverse()*CJ
	local C1 = y.CFrame:inverse()*CJ
	W.C0 = C0
	W.C1 = C1
	W.Parent = x
end 

for a,b in ipairs(barrels) do
Weld(script.Parent.Holder,b)
end

Weld(script.Parent.Handle,script.Parent.Holder)

speed = 0
maxspeed = 30

function start()

coroutine.resume(coroutine.create(function()

while isdown == true do

if speed &lt; maxspeed then
speed = speed + 1
wait()
end

script.Parent.Handle.Weld.C0 = script.Parent.Handle.Weld.C0 * CFrame.fromEulerAnglesXYZ(0,math.rad(speed),0)
wait()

end 

while true do
if speed &gt; 0 then
speed = speed - 1
else
break
end
script.Parent.Handle.Weld.C0 = script.Parent.Handle.Weld.C0 * CFrame.fromEulerAnglesXYZ(0,math.rad(speed),0)
wait()
wait()
end 

end))

end

isdown = false

script.Parent.Down.Changed:connect(function()
if script.Parent.Down.Value == true then
isdown = true
start()
while isdown == true do

barrel = barrels[bnum]
bnum = bnum + 1
if bnum &gt;= 7 then
bnum = 1
end

	local targetPos = script.Parent.Parent.Humanoid.TargetPoint
	local lookAt = (targetPos - barrel.Position).unit
fire(lookAt)
wait()
wait()
end
else
isdown = false
end
end)

script.Parent.Unequipped:connect(function()
isdown = false
end)</ProtectedString>
							<bool name="archivable">true</bool>
						</Properties>
					</Item>
					<Item class="Script" referent="RBX5608">
						<Properties>
							<bool name="Disabled">true</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Paintball</string>
							<ProtectedString name="Source">ball = script.Parent

function onTouched(hit)
--local humanoid = hit.Parent:findFirstChild(&quot;Humanoid&quot;)

--if humanoid ~= nil then
--hit:breakJoints()
--end

if hit.Name == &quot;Paintball&quot; then return end

local player = game.Players:playerFromCharacter(hit.Parent)

if hit.Parent.className == &quot;Tool&quot; then
player = game.Players:playerFromCharacter(hit.Parent.Parent)
end

if player ~= nil then
if hit:IsDescendantOf(script.Parent.creator.Value.Character) then return end

local h = hit.Parent:FindFirstChild(&quot;Humanoid&quot;)
if h ~= nil then
h.Health = h.Health - 40
ishuman = true

end

end 

if ishuman == nil then
if hit.Anchored == false then
hit:BreakJoints()
end end

connection:disconnect()
ball.Parent = nil
end

connection = ball.Touched:connect(onTouched)

wait(5)
ball.Parent = nil</ProtectedString>
							<bool name="archivable">true</bool>
						</Properties>
					</Item>
