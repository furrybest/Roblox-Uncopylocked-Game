function assignteam(player)
local team1list = {}
local team2list = {}
for a,b in ipairs(game.Players:GetPlayers()) do
if b.TeamColor == team1.TeamColor then
table.insert(team1list,b)
elseif b.TeamColor == team2.TeamColor then
table.insert(team2list,b)
end end
local team = nil
if #team1list &gt; #team2list then
team = team2
elseif #team2list &gt; #team1list then
team = team1
elseif #team1list == #team2list then
if math.random(1,2) == 1 then
team = team1
else
team = team2
end
end
player.TeamColor = team.TeamColor
player.Neutral = false
return team
end

