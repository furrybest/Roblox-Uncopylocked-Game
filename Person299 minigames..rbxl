						<ProtectedString name="Source">--Initiation
table.insert(_G.GameObjects,script)
script.Name = &quot;GameScript&quot;

game.Lighting.TimeOfDay = 0

gamemodel = game.Lighting.GameModels.Game11Model:clone()
table.insert(_G.GameObjects,gamemodel)
gamemodel.Name = &quot;GameModel&quot;
gamemodel.Parent = workspace

gamepoints = 35
workspace.WaitingRoom.North.Value = false
workspace.WaitingRoom.South.Value = false
workspace.WaitingRoom.West.Value = false
workspace.WaitingRoom.East.Value = false

team1 = Instance.new(&quot;Team&quot;)
team1.TeamColor = BrickColor.new(23)
team1.Name = &quot;Survivors&quot;
team1.AutoAssignable = false
team1.Parent = game.Teams

team2 = Instance.new(&quot;Team&quot;)
team2.TeamColor = BrickColor.new(&quot;Medium green&quot;)
team2.Name = &quot;Zombies&quot;
team2.AutoAssignable = false
team2.Parent = game.Teams

--Functions

function checkwin()

if hascancelled == true then return end
if hasended == true then return end

local t1 = {}
local t2 = {}

for a,b in ipairs(game.Players:GetPlayers()) do
if b.TeamColor == team1.TeamColor then
table.insert(t1,b)
elseif b.TeamColor == team2.TeamColor then
table.insert(t2,b)
end end

if #t1 == 0 then
hasended = true
local m = Instance.new(&quot;Message&quot;)
table.insert(_G.GameObjects,m)
m.Text = &quot;The Zombies have won!&quot;
m.Parent = workspace
for a,b in ipairs(t2) do
b.leaderstats.Points.Value = b.leaderstats.Points.Value + (gamepoints / 2)
end
_G.killall()
_G.makeneutral()
workspace.WaitingRoom.North.Value = true
workspace.WaitingRoom.South.Value = true
workspace.WaitingRoom.West.Value = true
workspace.WaitingRoom.East.Value = true
wait(2)
for a,b in ipairs(_G.GameObjects) do
if b ~= script then
b:remove()
end end
workspace.IsGoing.Value = false
script:remove()
end

end

function survivorwin()

if hasended == true then return end

hasended = true

local m = Instance.new(&quot;Message&quot;)
table.insert(_G.GameObjects,m)
m.Text = &quot;The Survivors have won!&quot;
m.Parent = workspace
for a,b in ipairs(game.Players:GetPlayers()) do
if b.TeamColor == team1.TeamColor then
b.leaderstats.Points.Value = b.leaderstats.Points.Value + gamepoints
end
end
_G.killall()
_G.makeneutral()
workspace.WaitingRoom.North.Value = true
workspace.WaitingRoom.South.Value = true
workspace.WaitingRoom.West.Value = true
workspace.WaitingRoom.East.Value = true
wait(2)
for a,b in ipairs(_G.GameObjects) do
if b ~= script then
b:remove()
end end
workspace.IsGoing.Value = false
script:remove()
end

function _G.cancel(dont)

hascancelled = true

game.Lighting.TimeOfDay = 14

workspace.WaitingRoom.North.Value = true
workspace.WaitingRoom.South.Value = true
workspace.WaitingRoom.West.Value = true
workspace.WaitingRoom.East.Value = true

for a,b in ipairs(_G.GameObjects) do
if b ~= script then
b:remove()
end end

_G.killall()
_G.makeneutral()

workspace.IsGoing.Value = false
script:remove()

end

--Body

players = game.Players:GetPlayers()
for a,b in ipairs(players) do
if _G.checkplayer(b) == 0 then
table.remove(players,a)
end end

local rand = math.random(1,#players)
local zombie = players[rand]
zombie.leaderstats.Points.Value = zombie.leaderstats.Points.Value + 20
table.remove(players,rand)
local zinfo = _G.checkplayer(zombie)
game.Lighting.SpecialScripts.Infect:clone().Parent = zinfo[2]
_G.teleportplayertobrick(zinfo[3],workspace.WaitingRoom.Roof)
zombie.TeamColor = team2.TeamColor
zombie.Neutral = false

local o = Instance.new(&quot;ObjectValue&quot;)
o.Value = zombie
o.Parent = workspace.Players

for n,p in ipairs(players) do
local pinfo = _G.checkplayer(p)
if pinfo ~= 0 then

pinfo[1].TeamColor = team1.TeamColor
pinfo[1].Neutral = false

_G.teleportplayertobrick(pinfo[3],gamemodel.Spawns:GetChildren()[math.random(1,4)])

local o = Instance.new(&quot;ObjectValue&quot;)
o.Value = p
o.Parent = workspace.Players

pinfo[4].Died:connect(function()
pinfo[1].TeamColor = BrickColor.new(&quot;Medium green&quot;)
end)

pinfo[1].Changed:connect(function(prop)
if prop == &quot;TeamColor&quot; then
checkwin()
end end)

end
end 

_G.checkifnone()

h = Instance.new(&quot;Hint&quot;)
table.insert(_G.GameObjects,h)
h.Parent = workspace
for n=1,60 do
h.Text = &quot;Time Left: &quot; .. 60 - n
wait(1)
end
h:remove()

survivorwin()
