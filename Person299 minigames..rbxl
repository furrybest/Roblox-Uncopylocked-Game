			<Item class="Script" referent="RBX2505">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Game19Script</string>
					<ProtectedString name="Source">--Initiation
table.insert(_G.GameObjects,script)
gamemodel = game.Lighting.GameModels.Game19Model:clone()
table.insert(_G.GameObjects,gamemodel)
script.Name = &quot;GameScript&quot;
gamemodel.Name = &quot;GameModel&quot;
gamemodel.Parent = workspace
gamepoints = 50
workspace.WaitingRoom.South.Value = false

--Functions

function _G.cancel()

workspace.WaitingRoom.South.Value = true

for a,b in ipairs(_G.GameObjects) do
if b ~= script then
b:remove()
end end

_G.killall()
_G.makeneutral()

workspace.IsGoing.Value = false
script:remove()

end

function checkwin()
hasended = true

tableofplayers = {}
tableofscores = {}
for a,b in ipairs(workspace.Players:GetChildren()) do
table.insert(tableofplayers,b.Value)
table.insert(tableofscores,0)
end 

for a,b in ipairs(tableofplayers) do
if b.Character ~= nil then
for c,d in ipairs(b.Character:GetChildren()) do
if d.className == &quot;Part&quot; then
local e = d:findFirstChild(&quot;DehPlayer&quot;)
if e ~= nil then

for f,g in ipairs(tableofplayers) do
if g == e.Value then
tableofscores[f] = tableofscores[f] + d:GetMass()
break
end
end

end
end 
end 
end 
end

local curhighscore = -1
local curhighplayer = nil

for a,b in ipairs(tableofplayers) do
if tableofscores[a] &gt; curhighscore then
curhighscore = tableofscores[a]
curhighplayer = b
end
end 

player = curhighplayer

player.leaderstats.Points.Value = player.leaderstats.Points.Value + gamepoints
local m = Instance.new(&quot;Message&quot;)
table.insert(_G.GameObjects,m)
m.Text = player.Name .. &quot; Won!&quot;
m.Parent = workspace
_G.killall()
_G.makeneutral()
workspace.WaitingRoom.South.Value = true
wait(2)
for a,b in ipairs(_G.GameObjects) do
if b ~= script then
b:remove()
end end
workspace.IsGoing.Value = false
script:remove()
--_G.cancel(1)
end

--Body

for n,p in ipairs(game.Players:GetPlayers()) do
local pinfo = _G.checkplayer(p)
if pinfo ~= 0 then
local part = gamemodel.Ground--:GetChildren()[math.random(1,4)]
if _G.teleportplayertobrick(pinfo[3],part) == true then
p.TeamColor = p.SignatureColor.Value
local o = Instance.new(&quot;ObjectValue&quot;)
o.Value = p
o.Parent = workspace.Players
_G.givetools(pinfo[5],game.Lighting.GameTools.Game19Tools:GetChildren())
--pinfo[4].Died:connect(function() o:remove() end)

for a,b in ipairs(pinfo[2]:GetChildren()) do
if b.className == &quot;BodyColors&quot; or b.className == &quot;Pants&quot; or b.className == &quot;Shirt&quot; or b.className == &quot;ShirtGraphic&quot; then

if b.className == &quot;BodyColors&quot; then
b.HeadColor = p.SignatureColor.Value
b.LeftArmColor = p.SignatureColor.Value
b.RightArmColor = p.SignatureColor.Value
b.LeftLegColor = p.SignatureColor.Value
b.RightLegColor = p.SignatureColor.Value
b.TorsoColor = p.SignatureColor.Value
end

b:remove()
end end
for a,b in ipairs(pinfo[2]:GetChildren()) do
if b.className == &quot;Part&quot; then
ident = Instance.new(&quot;ObjectValue&quot;)
ident.Name = &quot;DehPlayer&quot;
ident.Parent = b
ident.Value = pinfo[1]
b.BrickColor = p.SignatureColor.Value
table.insert(_G.GameObjects,ident)
end 
end


end
end
end 

_G.checkifnone()

--workspace.Players.ChildRemoved:connect(checkwin)

h = Instance.new(&quot;Hint&quot;)
table.insert(_G.GameObjects,h)
h.Parent = workspace
for n=1,30 do
h.Text = &quot;Time Left: &quot; .. 30 - n
wait(1)
end
h:remove()

checkwin()

--if hasended == nil then
--allwin()
--end
