end)

script.Parent.Torso[&quot;Left Shoulder&quot;].Changed:connect(function()
script.Parent.Torso[&quot;Left Shoulder&quot;].DesiredAngle = math.rad(-90)
end)

script.Parent.Torso[&quot;Right Shoulder&quot;].DesiredAngle = math.rad(90)
script.Parent.Torso[&quot;Left Shoulder&quot;].DesiredAngle = math.rad(-90)--]]

script.Parent.Humanoid.Died:connect(function()
script:Remove()
end)

