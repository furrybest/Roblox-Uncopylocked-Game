						<Item class="Script" referent="RBX4521">
							<Properties>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">Script</string>
								<ProtectedString name="Source">hassunk = false
script.Parent.Health.Changed:connect(function()
if hassunk == false then
if script.Parent.Health.Value &lt;= 0 then
hassunk = true
script.Parent:MakeJoints()
for a,b in ipairs(script.Parent:GetChildren()) do
if b.className == &quot;Part&quot; then
b.Anchored = false
end end

bv = Instance.new(&quot;BodyVelocity&quot;)
bv.maxForce = Vector3.new(999999999999,999999999999999,999999999999)
bv.velocity = Vector3.new(0,-1.5,0)
bv.Parent = script.Parent.Main

script.Parent.Sunk.Value = true

for a=1,100 do

local gc = script.Parent:GetChildren()
local part = gc[math.random(1,#gc)]
if part.className == &quot;Part&quot; then
local ex = Instance.new(&quot;Explosion&quot;)
ex.BlastPressure = 0
ex.Position = part.Position
ex.Parent = workspace
end
wait(0.05)
end


end end end)</ProtectedString>
