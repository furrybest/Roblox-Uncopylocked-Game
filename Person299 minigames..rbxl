				<Item class="Script" referent="RBX5569">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">DrownScript</string>
						<ProtectedString name="Source">while true do
if script.Parent.Position.y &lt;= workspace.GameModel.WaterHeight.Value then 
if script.Parent.Parent.Humanoid.Health == 0 then
break
end
local nc = game.Lighting.SpecialObjects.DrownedCharacter:clone()
nc.CharName.Value = script.Parent.Parent.Name
nc.WaterPosVal.Value = workspace.GameModel.WaterHeight
nc.Parent = workspace.GameModel

tcf = script.Parent.Parent.Torso.CFrame --+ Vector3.new(0,workspace.GameModel.WaterHeight.Value - script.Parent.Parent.Torso.Position.y,0) --+ Vector3(0,workspace.GameModel.WaterHeight.Value - script.Parent.Parent.Torso.Position.y,0)

--tcf = tcf + Vector3.new(0,10,0)

nc.Torso.CFrame = tcf --script.Parent.Parent.Torso.CFrame

for a,b in ipairs(script.Parent.Parent:GetChildren()) do
if b.className == &quot;BodyColors&quot; or b.className == &quot;Pants&quot; or b.className == &quot;Shirt&quot; or b.className == &quot;ShirtGraphic&quot; then
b:clone().Parent = nc
end end

script.Parent.Parent.Humanoid.Health = 0

for a,b in ipairs(script.Parent.Parent:GetChildren()) do
if b.className == &quot;Part&quot; then

local acko = nc:findFirstChild(b.Name)
if acko ~= nil then
acko.BrickColor = b.BrickColor
end 

if b.Name == &quot;Head&quot; then
wh = Instance.new(&quot;Weld&quot;)
wh.Part0 = nc.Torso
wh.Part1 = b
wh.C0 = CFrame.new(0,1.5,0)
wh.Parent = b
b.CanCollide = false
b.Transparency = 1
table.insert(_G.GameObjects,b)

coroutine.resume(coroutine.create(function()
for a=1,5 do
wait()
wait()
wh = Instance.new(&quot;Weld&quot;)
wh.Part0 = nc.Torso
wh.Part1 = b
wh.C0 = CFrame.new(0,1.5,0)
wh.Parent = b
end
end))

else
b:remove()
end end end

local Character = nc
local torso = nc.Torso

local part = Character:FindFirstChild(&quot;Right Arm&quot;)

if part ~= nil and part:FindFirstChild(&quot;IsDisconnected&quot;) == nil then

local m = Instance.new(&quot;Glue&quot;)
m.Name = &quot;Right Shoulder&quot;
--m.MaxVelocity = 0.1
m.C0 = CFrame.new((torso.Size.x + part.Size.x) / 2,part.Size.y / 4,0) * CFrame.fromEulerAnglesXYZ(0,math.pi/2,0) --CFrame.new((torso.Size.x / 2) + (part.Size.x / 2),part.Size.y / 4,0) * CFrame.fromEulerAnglesXYZ(0,math.pi/2,0) 
m.C1 = CFrame.new(0,part.Size.y / 4,0) * CFrame.fromEulerAnglesXYZ(0,math.pi/2,0) 
m.Part1 = part
m.Part0 = torso
m.Parent = torso

end

local part = Character:FindFirstChild(&quot;Left Arm&quot;)

if part ~= nil and part:FindFirstChild(&quot;IsDisconnected&quot;) == nil then

local m = Instance.new(&quot;Glue&quot;)
m.Name = &quot;Left Shoulder&quot;
--m.MaxVelocity = 0.1
m.C0 = CFrame.new((-torso.Size.x - part.Size.x) / 2,part.Size.y / 4,0) * CFrame.fromEulerAnglesXYZ(0,math.pi / 2,0) 
m.C1 = CFrame.new(0,part.Size.y/4,0) * CFrame.fromEulerAnglesXYZ(0,math.pi / 2,0) 
m.Part1 = part
m.Part0 = torso
m.Parent = torso

end

local part = Character:FindFirstChild(&quot;Right Leg&quot;)

if part ~= nil and part:FindFirstChild(&quot;IsDisconnected&quot;) == nil then

local m = Instance.new(&quot;Glue&quot;)
m.Name = &quot;Right Hip&quot;
--m.MaxVelocity = 0.1
m.C0 = CFrame.new((torso.Size.x - part.Size.x) / 2,-(part.Size.y/4) * 3,0) * CFrame.fromEulerAnglesXYZ(0,math.pi/2,0) 
m.C1 = CFrame.new(0,part.Size.y / 4,0) * CFrame.fromEulerAnglesXYZ(0,math.pi/2,0) 
m.Part1 = part
m.Part0 = torso
m.Parent = torso

end

local part = Character:FindFirstChild(&quot;Left Leg&quot;)

if part ~= nil and part:FindFirstChild(&quot;IsDisconnected&quot;) == nil then

local m = Instance.new(&quot;Glue&quot;)
m.Name = &quot;Left Hip&quot;
--m.MaxVelocity = 0.1
m.C0 = CFrame.new((torso.Size.x / 2) - part.Size.x * 1.5,-(part.Size.y / 4) * 3,0) * CFrame.fromEulerAnglesXYZ(0,math.pi/2,0) 
m.C1 = CFrame.new(0,part.Size.y / 4,0) * CFrame.fromEulerAnglesXYZ(0,math.pi/2,0) 
m.Part1 = part
m.Part0 = torso
m.Parent = torso

end

break
end 
wait()
wait()
wait()
end </ProtectedString>
