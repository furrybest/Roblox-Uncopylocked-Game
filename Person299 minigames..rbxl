cf = script.Parent.CFrame - Vector3.new(0,0.6,0)
script.Parent.Size = script.Parent.Size - Vector3.new(0,1.2,0)
script.Parent.CFrame = cf
end 
wait(2)
script.Parent:remove()--]]

wait(5)

for a=1,200 do
script.Parent.CFrame = script.Parent.CFrame - Vector3.new(0,0.05,0)
wait(0.05)
end
script.Parent:remove()</ProtectedString>
