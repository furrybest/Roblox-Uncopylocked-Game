function checkwin()
gamemodel.Finish.Touched:connect(function(hit)
if hasended == true then return end
if hit.Parent ~= nil then
local p = game.Players:playerFromCharacter(hit.Parent)
if p ~= nil then
local h = hit.Parent:FindFirstChild(&quot;Humanoid&quot;)
if h ~= nil then
if h.Health ~= 0 then
hasended = true
local m = Instance.new(&quot;Message&quot;)
table.insert(_G.GameObjects,m)
