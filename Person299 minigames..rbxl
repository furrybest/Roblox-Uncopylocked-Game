						<Item class="Script" referent="RBX2434">
							<Properties>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">Script</string>
								<ProtectedString name="Source">script.Parent.ClickDetector.MouseClick:connect(function()

if script.Parent.Is.Value == true then
script.Parent.Is.Value = false
script.Parent.Parent.Engine.BodyVelocity.velocity = Vector3.new(0,0,0)
else
script.Parent.Parent.Front.Is.Value = false
script.Parent.Is.Value = true
script.Parent.Parent.Engine.BodyVelocity.velocity = -script.Parent.Parent.Engine.CFrame.lookVector * 3
end

end)

script.Parent.Is.Changed:connect(function()

if script.Parent.Is.Value == true then
script.Parent.BrickColor = BrickColor.new(&quot;Bright green&quot;)
else
script.Parent.BrickColor = BrickColor.new(&quot;Really black&quot;)
end

end)</ProtectedString>
								<bool name="archivable">true</bool>
							</Properties>
						</Item>
