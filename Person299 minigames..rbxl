							<ProtectedString name="Source">script.Parent.Equipped:connect(function(m)
m.Button1Down:connect(function()
script.Parent.Down.Value = true
end)
m.Button1Up:connect(function()
script.Parent.Down.Value = false
end)
end)</ProtectedString>
