script:remove()
--_G.cancel(1)
end
end

function allwin()
hasended = true
local winners = {}
for a,b in ipairs(workspace.Players:GetChildren()) do 
table.insert(winners,b.Value)
end
local winlist = &quot;&quot;
for a,b in ipairs(winners) do
b.leaderstats.Points.Value = b.leaderstats.Points.Value + gamepoints
winlist = winlist .. b.Name
if a ~= #winners then
winlist = winlist .. &quot;, &quot;
end
end
winlist = winlist .. &quot; Win!&quot;
local m = Instance.new(&quot;Message&quot;)
table.insert(_G.GameObjects,m)
m.Text = winlist
m.Parent = workspace
_G.returnplayers()
_G.removetools()
workspace.WaitingRoom.North.Value = true
workspace.WaitingRoom.South.Value = true
workspace.WaitingRoom.West.Value = true
workspace.WaitingRoom.East.Value = true
wait(2)
_G.cancel(1)
end

--Body

for n,p in ipairs(game.Players:GetPlayers()) do
local pinfo = _G.checkplayer(p)
if pinfo ~= 0 then
local part = gamemodel.Brick
if _G.teleportplayertobrick(pinfo[3],part) == true then
local o = Instance.new(&quot;ObjectValue&quot;)
o.Value = p
o.Parent = workspace.Players
pinfo[4].Died:connect(function() if hasended == nil then o:remove() end end)
pinfo[4].WalkSpeed = 0
end
end
end 

_G.checkifnone()

workspace.Players.ChildRemoved:connect(checkwin)

wait(1.5)

for a,b in ipairs(workspace.Players:GetChildren()) do
local pinfo = _G.checkplayer(b.Value)
if pinfo ~= 0 then
pinfo[4].WalkSpeed = 16
end
end

h = Instance.new(&quot;Hint&quot;)
table.insert(_G.GameObjects,h)
h.Parent = workspace
for n=1,25 do
h.Text = &quot;Time Left: &quot; .. 25 - n
wait(1)
end
h:remove()

if hasended == nil then
allwin()
end
