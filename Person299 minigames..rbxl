							<Item class="Script" referent="RBX1686">
								<Properties>
									<bool name="Disabled">false</bool>
									<Content name="LinkedSource"><null></null></Content>
									<string name="Name">Script</string>
									<ProtectedString name="Source">function Weld(x,y)
	local W = Instance.new(&quot;Weld&quot;)
	W.Part0 = x
	W.Part1 = y
	local CJ = CFrame.new(x.Position)
	local C0 = x.CFrame:inverse()*CJ
	local C1 = y.CFrame:inverse()*CJ
	W.C0 = C0
	W.C1 = C1
	W.Parent = x
end 

Weld(script.Parent.RWing,script.Parent.Gun1)
Weld(script.Parent.LWing,script.Parent.Gun2)</ProtectedString>
									<bool name="archivable">true</bool>
								</Properties>
							</Item>
