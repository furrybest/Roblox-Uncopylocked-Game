cnum = 0
--[[
humanoid.Changed:connect(function(p)
if p ~= &quot;Jump&quot; then return end
if humanoid.Jump == false then return end

if hasjumped == 1 then 
return 
elseif hasjumped == 2 then
script.Parent.Torso.Velocity = Vector3.new(script.Parent.Torso.Velocity.x,0,script.Parent.Torso.Velocity.z)
return
end

if ap.Value &gt;= 2 then
ap.Value = ap.Value - 2
hasjumped = 1
else
script.Parent.Torso.Velocity = Vector3.new(script.Parent.Torso.Velocity.x,0,script.Parent.Torso.Velocity.z)
hasjumped = 2
end

wait(0.3)
hasjumped = 0

end)--]]

humanoid.Changed:connect(function(p)
if p == &quot;WalkDirection&quot; then
cnum = cnum + 1
local dnum = cnum
if humanoid.WalkDirection == Vector3.new(0,0,0) then
while dnum == cnum do
wait(1)
if cnum ~= dnum then return end
if ap.Value &gt;= 7 then return end

if script.Parent.Torso.Velocity.y &gt; -1 then
ap.Value = ap.Value + 1
end

end end end end)

ap.Changed:connect(function()
hint.Text = &quot;AP: &quot; .. ap.Value
end)

ap.Value = 0

local dnum = cnum
if humanoid.WalkDirection == Vector3.new(0,0,0) then
while dnum == cnum do
wait(1)
if cnum ~= dnum then return end
if ap.Value &gt;= 7 then return end
if script.Parent.Torso.Velocity.y &gt; -1 then
ap.Value = ap.Value + 1
end 
end end </ProtectedString>
