hint.Text = &quot;Red Crew Reinforcements: &quot; .. redcrew .. &quot; Blue Crew Reinforcements: &quot; .. bluecrew

end

function checkwin()
if hascancelled == true then return end
local team1list = {}
local team2list = {}
for a,b in ipairs(workspace.Players:GetChildren()) do
if b.Value.TeamColor == team1.TeamColor then
