					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Game18Script</string>
					<ProtectedString name="Source">--Initiation
table.insert(_G.GameObjects,script)
script.Name = &quot;GameScript&quot;
gamemodel = game.Lighting.GameModels.Game18Model:clone()
table.insert(_G.GameObjects,gamemodel)
gamemodel.Name = &quot;GameModel&quot;
pbu = gamemodel.Block:clone()
pbu.Locked = false
gamemodel.Block:remove()
kb = gamemodel.Killbot:clone()
gamemodel.Killbot:remove()
gamemodel.Parent = workspace
gamepoints = 60
workspace.WaitingRoom.South.Value = false

isbuild = true

--Functions

function oc(msg,speaker)

if isbuild == false then
return
end

if string.sub(string.lower(msg),1,5) == &quot;part/&quot; then
local t = {}
for a=6,string.len(msg) do
if string.sub(msg,a,a) == &quot;/&quot; then
table.insert(t,a)
end
end
if #t ~= 2 then
return
end
local i1 = tonumber(string.sub(msg,6,t[1] - 1))
local i2 = tonumber(string.sub(msg,t[1] + 1,t[2] - 1))
local i3 = tonumber(string.sub(msg,t[2] + 1))
if i1 &gt; 5 then
i1 = 5
end
if i2 &gt; 5 then
i2 = 5
end
if i3 &gt; 5 then
i3 = 5
end
local a = pbu:clone()
a.Size = Vector3.new(i1,i2,i3)
a.CFrame = gamemodel.Ground.CFrame + Vector3.new(0,70,0)
a.Parent = gamemodel
table.insert(_G.GameObjects,a)
end
end

function _G.cancel()

game.Lighting.TimeOfDay = 14

hascancelled = true

workspace.WaitingRoom.South.Value = true

for a,b in ipairs(_G.GameObjects) do
if b ~= script then
b:remove()
end end

_G.removelocalparts()
_G.killall()

workspace.IsGoing.Value = false
script:remove()

end

function allwin()
if hasended == true then return end
hasended = true
game.Lighting.TimeOfDay = 14
local winners = {}
for a,b in ipairs(workspace.Players:GetChildren()) do 
table.insert(winners,b.Value)
end
local winlist = &quot;&quot;
for a,b in ipairs(winners) do
b.leaderstats.Points.Value = b.leaderstats.Points.Value + gamepoints
winlist = winlist .. b.Name
if a ~= #winners then
winlist = winlist .. &quot;, &quot;
end
end
winlist = winlist .. &quot; Won!&quot;
local m = Instance.new(&quot;Message&quot;)
table.insert(_G.GameObjects,m)
m.Text = winlist
m.Parent = workspace
_G.killall()
_G.removetools()
workspace.WaitingRoom.South.Value = true
wait(2)
_G.removelocalparts()
for a,b in ipairs(_G.GameObjects) do
if b ~= script then
b:remove()
end end
workspace.IsGoing.Value = false
script:remove()
end

function nowin()
hasended = true
local m = Instance.new(&quot;Message&quot;)
table.insert(_G.GameObjects,m)
m.Text = &quot;The Killbots have won!&quot;
m.Parent = workspace
workspace.WaitingRoom.South.Value = true
_G.removetools()
wait(2)
game.Lighting.TimeOfDay = 14
_G.removelocalparts()
for a,b in ipairs(_G.GameObjects) do
if b ~= script then
b:remove()
end end
workspace.IsGoing.Value = false
script:remove()
end

--Body

for n,p in ipairs(game.Players:GetPlayers()) do
local pinfo = _G.checkplayer(p)
if pinfo ~= 0 then


_G.teleportplayertobrick(pinfo[3],gamemodel.Ground)

local o = Instance.new(&quot;ObjectValue&quot;)
o.Value = p
o.Parent = workspace.Players

local hb = Instance.new(&quot;HopperBin&quot;)
table.insert(_G.GameObjects,hb)
hb.BinType = &quot;GameTool&quot;
hb.Parent = pinfo[5]

local hb = Instance.new(&quot;HopperBin&quot;)
table.insert(_G.GameObjects,hb)
hb.BinType = &quot;Clone&quot;
hb.Parent = pinfo[5]

pinfo[1].Chatted:connect(function(msg) oc(msg,pinfo[1]) end)

--_G.givetools(pinfo[5],game.Lighting.GameTools.Game5Tools:GetChildren())
pinfo[4].Died:connect(function() if hasended == nil then if #workspace.Players:GetChildren() ~= 1 then o:remove() else nowin() end end end)

local mes = Instance.new(&quot;Message&quot;)
table.insert(_G.GameObjects,mes)
mes.Text = &quot;Say part/xsize/ysize/zsize to create a part.&quot;
mes.Parent = pinfo[1]

coroutine.resume(coroutine.create(function()
wait(2)
mes:remove()
end))

end
end 

_G.checkifnone()

workspace.Players.ChildRemoved:connect(checkwin)

local a = pbu:clone()
a.Size = Vector3.new(5,5,5)
a.CFrame = gamemodel.Ground.CFrame + Vector3.new(0,70,0)
a.Parent = gamemodel

workspace.ChildAdded:connect(function(p)
if p.className == &quot;Part&quot; then
if p.Name == &quot;Block&quot; then
p.Parent = gamemodel
p.CanCollide = true
end end end)

gamemodel.ChildAdded:connect(function(p)
if p.className == &quot;Part&quot; then
p.CanCollide = true
end end)

h = Instance.new(&quot;Hint&quot;)
table.insert(_G.GameObjects,h)
h.Parent = workspace
for n=1,60 do
h.Text = &quot;Time Left: &quot; .. 60 - n
wait(1)
end
h:remove()

isbuild = false

coroutine.resume(coroutine.create(function()
local num = 9
game.Lighting.TimeOfDay = 17
wait(wait() * num)
game.Lighting.TimeOfDay = 17.1
wait(wait() * num)
game.Lighting.TimeOfDay = 17.2
wait(wait() * num)
game.Lighting.TimeOfDay = 17.3
wait(wait() * num)
game.Lighting.TimeOfDay = 17.4
wait(wait() * num)
game.Lighting.TimeOfDay = 17.5
wait(wait() * num)
game.Lighting.TimeOfDay = 18
wait(wait() * num)
game.Lighting.TimeOfDay = 18.1
wait(wait() * num)
game.Lighting.TimeOfDay = 18.2
wait(wait() * num)
game.Lighting.TimeOfDay = 18.3
wait(wait() * num)
game.Lighting.TimeOfDay = 23
end))

m = Instance.new(&quot;Message&quot;)
table.insert(_G.GameObjects,m)
m.Text = &quot;The Killbots have arrived!&quot;
m.Parent = game.Workspace
wait(2.5)
m:remove()

_G.removetools()
for a,b in ipairs(gamemodel:GetChildren()) do
if b.Name == &quot;Block&quot; then
if b.className == &quot;Part&quot; then
b.Locked = true
b.CanCollide = false
b.CanCollide = true
end end end

for a,b in ipairs(workspace.Players:GetChildren()) do
game.Lighting.SpecialScripts.LockLocalParts:clone().Parent = b.Value.Backpack
end

for a,b in ipairs(workspace.Players:GetChildren()) do
_G.givetools(b.Value.Backpack,game.Lighting.GameTools.Game18Tools:GetChildren())
end

for num =1,15 do
local a = kb:clone()
a.CFrame = gamemodel.Ground.CFrame + Vector3.new(math.random(-gamemodel.Ground.Size.x / 2,gamemodel.Ground.Size.x / 2),100,math.random(-gamemodel.Ground.Size.z / 2,gamemodel.Ground.Size.z / 2))
a.Parent = gamemodel
end 

h = Instance.new(&quot;Hint&quot;)
table.insert(_G.GameObjects,h)
h.Parent = workspace
for n=1,60 do
h.Text = &quot;Time Left: &quot; .. 60 - n
wait(1)
end
h:remove()

allwin()</ProtectedString>
