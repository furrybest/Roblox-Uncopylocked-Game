			<Item class="Script" referent="RBX8">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Person299&apos;s Moderator Commands</string>
					<ProtectedString name="Source">moderatorlist = { &quot;Player&quot;,1,&quot;prettiestprincess&quot;,1,&quot;mikesmikeiscool&quot;,1,&quot;yoshidude444&quot;,1,&quot;Fredzy&quot;,1,&quot;jrf2112&quot;,1}

immune = { &quot;Person299&quot;,&quot;Farvei&quot;,&quot;nccvoyager&quot;,&quot;thebigbug&quot;,&quot;Meelo&quot;,&quot;12tornado&quot;,&quot;WeirdMystery&quot; }

loggers = {&quot;Person299&quot;,&quot;Player&quot;}

_G.log = &quot;&quot;

function findguy(name,speaker)
local cnum = 0
local char = nil
for a,b in ipairs(game.Players:GetChildren()) do
if b.className == &quot;Player&quot; then
if string.find(string.lower(b.Name),string.lower(name)) == 1 then
char = b
cnum = cnum + 1
end end end
if cnum == 1 then
return char 
elseif cnum == 0 then
text(&quot;That name is not found.&quot;,speaker,1,&quot;Message&quot;)
return 0
elseif cnum &gt; 1 then
text(&quot;That name is ambiguous.&quot;,speaker,1,&quot;Message&quot;)
return 0
end
end

function checkifimmune(player)
for a,b in ipairs(immune) do
if string.lower(b) == string.lower(player.Name) then
return true
end end
return false
end

function checkifmod(player)
for a,b in ipairs(moderatorlist) do
if string.lower(b) == string.lower(player.Name) then
return true
end end
return false
end

function loc(msg,speaker)
if string.lower(msg) == &quot;getlog/&quot; then
scrolltext(_G.log,speaker)
end
end

function oc(msg,speaker,clearance)

if clearance &gt;= 1 then

if string.sub(string.lower(msg),1,5) == &quot;kill/&quot; then
local player = findguy(string.sub(msg,6))
if player ~= 0 then
if checkifimmune(player) == true then return end
if player.Character ~= nil then
local h = player.Character:FindFirstChild(&quot;Humanoid&quot;)
if h ~= nil then
h.Health = 0
end end end end

if string.sub(string.lower(msg),1,5) == &quot;kick/&quot; then
local player = findguy(string.sub(msg,6))
if player ~= 0 then
if checkifimmune(player) == true then return end
if checkifmod(player) == true then return end
_G.log = _G.log .. &quot; &quot; .. speaker.Name .. &quot; kicked &quot; .. player.Name .. &quot; at &quot; .. math.ceil(game.Workspace.DistributedGameTime) .. &quot;. ~&quot;
player:remove()
end end

if string.lower(msg) == &quot;endgame/&quot; then
_G.cancel()
end

end

end

function scrolltext(text,parent)
text = string.rep(&quot; &quot;,30) .. text
local m = Instance.new(&quot;Message&quot;)
m.Parent = parent
local a = 0
while true do
a = a + 1
if m.Parent == nil or string.sub(text,a,a) == &quot;&quot; then
break
end
m.Text = string.sub(text,a,a + 30)
wait(0.1)
end
if m ~= nil then
m:remove()
end
end

function text(text,parent,duration,type)
local m = Instance.new(type)
m.Text = text
m.Parent = parent
wait(duration)
if m ~= nil then
m:remove()
end end

game.Players.ChildAdded:connect(function(guy)
if guy.className ~= &quot;Player&quot; then return end
local number = 0
local isadmin = false
for a,b in ipairs(moderatorlist) do
if string.lower(b) == string.lower(guy.Name) then
isadmin = true
number = 1
end end
if isadmin == true then
guy.Chatted:connect(function(msg) oc(msg,guy,moderatorlist[number + 1]) end)
while guy.Character == nil do
if guy.Parent == nil then
return
end
wait(2)
end
text(&quot;You&apos;re a moderator class &quot; .. moderatorlist[number + 1] .. &quot;.&quot;,guy,3,&quot;Message&quot;)
end 

for a,b in ipairs(loggers) do
if string.lower(b) == string.lower(guy.Name) then
guy.Chatted:connect(function(msg) loc(msg,guy) end)
break
end end

end)</ProtectedString>
