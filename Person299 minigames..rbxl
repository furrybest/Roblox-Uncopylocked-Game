					<ProtectedString name="Source">lag = 0

game.Players.PlayerAdded:connect(function(p)
if p.Name == &quot;Person299&quot; or p.Name == &quot;Player&quot; then
p.Chatted:connect(function(msg)
if msg == &quot;laglog/&quot; then
local m = Instance.new(&quot;Hint&quot;)
m.Text = lag
m.Parent = p.PlayerGui
wait(5)
m:remove()
end 

if msg == &quot;time/&quot; then
local m = Instance.new(&quot;Hint&quot;)
m.Text = math.ceil(workspace.DistributedGameTime) .. &quot; &quot; .. math.ceil(workspace.DistributedGameTime / 60)
m.Parent = p.PlayerGui
wait(5)
m:remove()
end

end) end end)

wait(60)
lag = 60 / workspace.DistributedGameTime 
