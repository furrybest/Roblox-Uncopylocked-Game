								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">Script</string>
								<ProtectedString name="Source">impalednum = 0

script.Parent.Touched:connect(function(hit)
if hit.Parent ~= nil then
if game.Players:playerFromCharacter(hit.Parent) ~= nil then
if hit.Parent.Humanoid.Health ~= 0 and impalednum &lt;= 2 then


local nc = game.Lighting.SpecialObjects.ImpaledCharacter:clone()
nc.CharName.Value = hit.Parent.Name
nc.Parent = workspace.GameModel

sw = Instance.new(&quot;Weld&quot;)
sw.Part0 = nc.Torso
sw.Part1 = script.Parent
sw.C0 = CFrame.new(0,0,-1.3 + impalednum) * CFrame.fromEulerAnglesXYZ(math.rad(90),math.rad(math.random(1,359)),math.rad(180))
sw.Parent = script.Parent

impalednum = impalednum + 1

for a,b in ipairs(hit.Parent:GetChildren()) do
if b.className == &quot;BodyColors&quot; or b.className == &quot;Pants&quot; or b.className == &quot;Shirt&quot; or b.className == &quot;ShirtGraphic&quot; then
b:clone().Parent = nc
end end

hit.Parent.Humanoid.Health = 0

for a,b in ipairs(hit.Parent:GetChildren()) do
if b.className == &quot;Part&quot; then

local acko = nc:findFirstChild(b.Name)
if acko ~= nil then
acko.BrickColor = b.BrickColor
end 

if b.Name == &quot;Head&quot; then
wh = Instance.new(&quot;Weld&quot;)
wh.Part0 = nc.Torso
wh.Part1 = b
wh.C0 = CFrame.new(0,1.5,0)
wh.Parent = b
b.CanCollide = false
b.Transparency = 1
table.insert(_G.GameObjects,b)

coroutine.resume(coroutine.create(function()
for a=1,5 do
wait()
wait()
wh = Instance.new(&quot;Weld&quot;)
wh.Part0 = nc.Torso
wh.Part1 = b
wh.C0 = CFrame.new(0,1.5,0)
wh.Parent = b
end
end))

else
b:remove()
end end end

end
end
end end)</ProtectedString>
