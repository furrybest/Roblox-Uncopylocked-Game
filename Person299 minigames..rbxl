								<string name="Name">Script</string>
								<ProtectedString name="Source">script.Parent.ClickDetector.MouseClick:connect(function()

if script.Parent.Is.Value == true then
script.Parent.Is.Value = false
else
script.Parent.Parent.Right.Is.Value = false
script.Parent.Is.Value = true

while script.Parent.Is.Value == true do
script.Parent.Parent.Engine.BodyGyro.cframe = script.Parent.Parent.Engine.BodyGyro.cframe * CFrame.fromEulerAnglesXYZ(0,math.rad(5),0)

if script.Parent.Parent.Front.Is.Value == true then
script.Parent.Parent.Engine.BodyVelocity.velocity = script.Parent.Parent.Engine.BodyGyro.cframe.lookVector * 10
elseif script.Parent.Parent.Back.Is.Value == true then
script.Parent.Parent.Engine.BodyVelocity.velocity = -script.Parent.Parent.Engine.BodyGyro.cframe.lookVector * 5
end

wait(0.5)
end

end

end)

script.Parent.Is.Changed:connect(function()

if script.Parent.Is.Value == true then
script.Parent.BrickColor = BrickColor.new(&quot;Bright green&quot;)
else
script.Parent.BrickColor = BrickColor.new(&quot;Really black&quot;)
end

end)</ProtectedString>
