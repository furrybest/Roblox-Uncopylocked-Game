ispage = true
end 
if string.sub(dastring,1,#&quot;http://www.roblox.com/asset/?id=&quot;) ~= &quot;http://www.roblox.com/asset/?id=&quot; then
inform(p)
return
end 
if tonumber(string.sub(dastring,#&quot;http://www.roblox.com/asset/?id=&quot; + 1)) == nil then
inform(p)
return 
end 

if ispage == true then
dastring = &quot;http://www.roblox.com/asset/?id=&quot; .. tonumber(string.sub(dastring,#&quot;http://www.roblox.com/asset/?id=&quot; + 1)) - 1
end

for a,b in ipairs(list) do
