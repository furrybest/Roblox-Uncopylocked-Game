torso.Velocity = Vector3.new(0,0,0)
bg.cframe = CFrame.new(torso.Position,torso.Position + Vector3.new(torso.CFrame.lookVector.x,0,torso.CFrame.lookVector.z))
wait(1)
pcall(function() bg.maxTorque = Vector3.new(0,0,0) end)
end)
end)
end)
