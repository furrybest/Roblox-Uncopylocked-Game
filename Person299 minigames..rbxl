						<Item class="Script" referent="RBX5216">
							<Properties>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">Script</string>
								<ProtectedString name="Source">engine = script.Parent.Engine
engine.BodyGyro.cframe = engine.CFrame
engine.BodyPosition.position = Vector3.new(engine.Position.x,99.2,engine.Position.z)
engine.Anchored = false
engine.BodyVelocity.maxForce = Vector3.new(math.huge,math.huge,math.huge)

hasended = false

script.Parent.Health.Changed:connect(function()
if script.Parent.Health.Value &lt;= 0 then
if hasended == true then return end
hasended = true

engine.BodyVelocity.velocity = Vector3.new(engine.BodyVelocity.velocity.x,-1,engine.BodyVelocity.velocity.z)
engine.BodyGyro.maxTorque = Vector3.new(0,0,0)
engine.BodyPosition.maxForce = Vector3.new(0,0,0)

coroutine.resume(coroutine.create(function()
while true do
local gc = script.Parent:GetChildren()
for a,b in ipairs(gc) do
if b.className ~= &quot;Part&quot; and b.className ~= &quot;TrussPart&quot; then
table.remove(gc,a)
end end
local part = gc[math.random(1,#gc)]
if part.className == &quot;Part&quot; then
local ex = Instance.new(&quot;Explosion&quot;)
ex.Position = part.Position
ex.Parent = workspace
end
wait(0.75)
end
end))

wait(45)
script.Parent:remove()

end
end)</ProtectedString>
								<bool name="archivable">true</bool>
							</Properties>
