								<ProtectedString name="Source">table.insert(_G.GameObjects,script.Parent)
while script.Parent:FindFirstChild(&quot;Handle&quot;) == nil do
wait()
end
script.Parent.Handle.BrickColor = BrickColor.new(1)
for a,b in ipairs(script.Parent.Handle:GetChildren()) do
if b.className == &quot;Script&quot; then
b:remove()
end end
script.Parent.Handle.Owner.Value = script.Parent.Parent.Parent.Character
script.Parent.Activated:connect(function()
local handle = script.Parent.Handle
local tcf = CFrame.new(handle.Position,script.Parent.Parent.Humanoid.TargetPoint)
local ts = script:clone()
ts.Disabled = true
ts.Parent = handle 
local ss = script.Parent.BallScript:clone()
ss.Disabled = false
ss.Parent = handle
handle.Parent = workspace
handle:BreakJoints()
handle.CanCollide = true
handle.Velocity = tcf.lookVector * 125
script.Parent:remove()
end)

</ProtectedString>
