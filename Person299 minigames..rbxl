				<Item class="Script" referent="RBX2798">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">character = script.Parent
torso = character:FindFirstChild(&quot;Torso&quot;)
if torso ~= nil then

part = character:FindFirstChild(&quot;Right Arm&quot;)
if part ~= nil then
local b = Instance.new(&quot;Part&quot;)
b.formFactor = &quot;Plate&quot;
b.Size = Vector3.new(1,.4,1)
b.CanCollide = true
b.TopSurface = 0
b.BottomSurface = 0
b.CFrame = part.CFrame --* Vector3.new(0,((part.Size.y / 2) * -1) + .2,0)  --vectorToWorldSpace(0,((part.Size.y / 2) * -1) + .2,0))   part.CFrame:toWorldSpace(CFrame.new(part.CFrame Vector3.new(0,((part.Size.y / 2) * -1) + .2,0)   ))
b.Transparency = 1
b.CFrame = part.CFrame --* w.C0
b.Parent = part
local w = Instance.new(&quot;Weld&quot;)
w.Name = &quot;LimbEnd&quot;
w.C0 = CFrame.new(0,((part.Size.y / 2) * -1) + .2,0)
w.Part0 = part
w.Part1 = b
w.Parent = torso
end

part = character:FindFirstChild(&quot;Left Arm&quot;)
if part ~= nil then
local b = Instance.new(&quot;Part&quot;)
b.formFactor = &quot;Plate&quot;
b.Size = Vector3.new(1,.4,1)
b.CanCollide = true
b.TopSurface = 0
b.BottomSurface = 0
b.CFrame = part.CFrame --* Vector3.new(0,((part.Size.y / 2) * -1) + .2,0)  --vectorToWorldSpace(0,((part.Size.y / 2) * -1) + .2,0))   part.CFrame:toWorldSpace(CFrame.new(part.CFrame Vector3.new(0,((part.Size.y / 2) * -1) + .2,0)   ))
b.Transparency = 1
b.CFrame = part.CFrame --* w.C0
b.Parent = part
local w = Instance.new(&quot;Weld&quot;)
w.Name = &quot;LimbEnd&quot;
w.C0 = CFrame.new(0,((part.Size.y / 2) * -1) + .2,0)
w.Part0 = part
w.Part1 = b
w.Parent = torso
end

part = character:FindFirstChild(&quot;Right Leg&quot;)
if part ~= nil then
local b = Instance.new(&quot;Part&quot;)
b.formFactor = &quot;Plate&quot;
b.Size = Vector3.new(1,.4,1)
b.CanCollide = true
b.TopSurface = 0
b.BottomSurface = 0
b.CFrame = part.CFrame --* Vector3.new(0,((part.Size.y / 2) * -1) + .2,0)  --vectorToWorldSpace(0,((part.Size.y / 2) * -1) + .2,0))   part.CFrame:toWorldSpace(CFrame.new(part.CFrame Vector3.new(0,((part.Size.y / 2) * -1) + .2,0)   ))
b.Transparency = 1
b.CFrame = part.CFrame --* w.C0
b.Parent = part
local w = Instance.new(&quot;Weld&quot;)
w.Name = &quot;LimbEnd&quot;
w.C0 = CFrame.new(0,((part.Size.y / 2) * -1) + .2,0)
w.Part0 = part
w.Part1 = b
w.Parent = torso
end

part = character:FindFirstChild(&quot;Left Leg&quot;)
if part ~= nil then
local b = Instance.new(&quot;Part&quot;)
b.formFactor = &quot;Plate&quot;
b.Size = Vector3.new(1,.4,1)
b.CanCollide = true
b.TopSurface = 0
b.BottomSurface = 0
b.CFrame = part.CFrame --* Vector3.new(0,((part.Size.y / 2) * -1) + .2,0)  --vectorToWorldSpace(0,((part.Size.y / 2) * -1) + .2,0))   part.CFrame:toWorldSpace(CFrame.new(part.CFrame Vector3.new(0,((part.Size.y / 2) * -1) + .2,0)   ))
b.Transparency = 1
b.CFrame = part.CFrame --* w.C0
b.Parent = part
local w = Instance.new(&quot;Weld&quot;)
w.Name = &quot;LimbEnd&quot;
w.C0 = CFrame.new(0,((part.Size.y / 2) * -1) + .2,0)
w.Part0 = part
w.Part1 = b
w.Parent = torso
end


end</ProtectedString>
						<bool name="archivable">true</bool>
