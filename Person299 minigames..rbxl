gamepoints = 30
workspace.WaitingRoom.North.Value = false
workspace.WaitingRoom.South.Value = false
workspace.WaitingRoom.West.Value = false
workspace.WaitingRoom.East.Value = false

team1 = Instance.new(&quot;Team&quot;)
team1.TeamColor = BrickColor.new(21)
team1.Name = &quot;Red Team&quot;
team1.AutoAssignable = false
team1.Parent = game.Teams

team2 = Instance.new(&quot;Team&quot;)
team2.TeamColor = BrickColor.new(23)
team2.Name = &quot;Blue Team&quot;
team2.AutoAssignable = false
team2.Parent = game.Teams

--Functions

function _G.cancel(dont)

workspace.WaitingRoom.North.Value = true
workspace.WaitingRoom.South.Value = true
workspace.WaitingRoom.West.Value = true
workspace.WaitingRoom.East.Value = true

for a,b in ipairs(_G.GameObjects) do
if b ~= script then
b:remove()
end end

_G.killall()
_G.makeneutral()

workspace.IsGoing.Value = false
script:remove()

end

function checkwin()
local team1list = {}
local team2list = {}
for a,b in ipairs(workspace.Players:GetChildren()) do
if b.Value.TeamColor == team1.TeamColor then
table.insert(team1list,b.Value)
elseif b.Value.TeamColor == team2.TeamColor then
table.insert(team2list,b.Value)
end end

if #team2list == 0 then
hasended = true
local m = Instance.new(&quot;Message&quot;)
table.insert(_G.GameObjects,m)
m.Text = &quot;Red Team Wins!&quot;
m.Parent = workspace
_G.killall()
_G.removetools()
workspace.WaitingRoom.North.Value = true
workspace.WaitingRoom.South.Value = true
workspace.WaitingRoom.West.Value = true
workspace.WaitingRoom.East.Value = true
for a,b in ipairs(game.Players:GetPlayers()) do
if b.TeamColor == team1.TeamColor then
b.leaderstats.Points.Value = b.leaderstats.Points.Value + (gamepoints * (_G.numonteam(team2.TeamColor) / _G.numonteam(team1.TeamColor)))
end end
_G.makeneutral()
wait(2)
for a,b in ipairs(_G.GameObjects) do
if b ~= script then
b:remove()
end end
workspace.IsGoing.Value = false
script:remove()
elseif #team1list == 0 then
hasended = true
local m = Instance.new(&quot;Message&quot;)
table.insert(_G.GameObjects,m)
m.Text = &quot;Blue Team Wins!&quot;
m.Parent = workspace
_G.killall()
_G.removetools()
workspace.WaitingRoom.North.Value = true
workspace.WaitingRoom.South.Value = true
workspace.WaitingRoom.West.Value = true
workspace.WaitingRoom.East.Value = true
for a,b in ipairs(game.Players:GetPlayers()) do
if b.TeamColor == team2.TeamColor then
b.leaderstats.Points.Value = b.leaderstats.Points.Value + (gamepoints * (_G.numonteam(team1.TeamColor) / _G.numonteam(team2.TeamColor)))
end end
_G.makeneutral()
wait(2)
for a,b in ipairs(_G.GameObjects) do
if b ~= script then
b:remove()
end end
workspace.IsGoing.Value = false
script:remove()
end

end

function permseat(guy,seat)
local h = guy:FindFirstChild(&quot;Humanoid&quot;)
local t = guy:FindFirstChild(&quot;Torso&quot;)
if h ~= nil and t ~= nil then
t.CFrame = seat.CFrame + Vector3.new(0,3,0)
local w = Instance.new(&quot;Weld&quot;)
w.Part0 = seat
w.Part1 = t
w.C0 = CFrame.new(0,2,0)
w.Parent = seat
h.Sit = true
local c = h.Changed:connect(function() if h.Sit == false then h.Health = 0 end end)
end
end

function assignteam(player)
local team1list = {}
local team2list = {}
for a,b in ipairs(game.Players:GetPlayers()) do
if b.TeamColor == team1.TeamColor then
table.insert(team1list,b)
elseif b.TeamColor == team2.TeamColor then
table.insert(team2list,b)
end end
local team = nil
if #team1list &gt; #team2list then
team = team2
elseif #team2list &gt; #team1list then
team = team1
elseif #team1list == #team2list then
if math.random(1,2) == 1 then
team = team1
else
team = team2
end
end
player.TeamColor = team.TeamColor
player.Neutral = false
return team
end

--Body

for n,p in ipairs(game.Players:GetPlayers()) do
local pinfo = _G.checkplayer(p)
if pinfo ~= 0 then

local team = assignteam(p)

local plane = nil

if team == team1 then
plane = game.Lighting.GameModels.Game4Model.RPlane:clone()

plane.Parts.BackR.BrickColor = pinfo[1].SignatureColor.Value
plane.Parts.BackL.BrickColor = pinfo[1].SignatureColor.Value

plane.Parent = pinfo[2]
plane:MakeJoints()
local op = game.Lighting.GameModels.Game4Model.RPlane.Parts.Engine.Position
plane:MoveTo(Vector3.new(math.random(op.x - 500,op.x + 500),math.random(op.y - 50,op.y + 50),op.z))
else
plane = game.Lighting.GameModels.Game4Model.BPlane:clone()

plane.Parts.BackR.BrickColor = pinfo[1].SignatureColor.Value
plane.Parts.BackL.BrickColor = pinfo[1].SignatureColor.Value

plane.Parent = pinfo[2]
plane:MakeJoints()
local op = game.Lighting.GameModels.Game4Model.BPlane.Parts.Engine.Position
plane:MoveTo(Vector3.new(math.random(op.x - 500,op.x + 500),math.random(op.y - 50,op.y + 50),op.z))
end

plane.Name = &quot;Plane&quot;

_G.teleportplayertobrick(pinfo[3],plane.Parts.Seat)

permseat(pinfo[2],plane.Parts.Seat)

local o = Instance.new(&quot;ObjectValue&quot;)
o.Value = p
o.Parent = workspace.Players
_G.givetools(pinfo[5],game.Lighting.GameTools.Game4Tools:GetChildren())
pinfo[4].Died:connect(function() if hasended == nil then o:remove() end end)
end
end 

_G.checkifnone()

workspace.Players.ChildRemoved:connect(checkwin)</ProtectedString>
