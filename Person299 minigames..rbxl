			<Item class="Script" referent="RBX11">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Globals</string>
					<ProtectedString name="Source">--Checkplayer 1 Player 2 Character 3 Torso 4 Humanoid 5 Backpack








function _G.numonteam(teamcolor)
teamnumber = 0
for a,b in ipairs(game.Players:GetPlayers()) do
if b.TeamColor == teamcolor then
teamnumber = teamnumber + 1
end
end

if teamnumber == 0 then
teamnumber = 1
end

return teamnumber
end

function _G.findifplaying(player)
for a,b in ipairs(workspace.Players:GetChildren()) do
if b.Value == player then
return true
end end
return false
end


function _G.canspawnall()
for a,b in ipairs(game.Players:GetPlayers()) do
b.CanSpawn.Value = true
end
end

function _G.makeneutral()
for a,b in ipairs(game.Players:GetPlayers()) do
b.TeamColor = BrickColor.new(1)
b.Neutral = true
end
for a,b in ipairs(game.Teams:GetChildren()) do
b:remove()
end
end

function _G.removelocalparts()
for a,b in ipairs(workspace:GetChildren()) do
if b.className == &quot;Part&quot; then
b:remove()
end end
local s = game.Lighting.SpecialScripts.RemoveLocalParts:clone()
for a,b in ipairs(game.Players:GetPlayers()) do
s:clone().Parent = b.Backpack
end
end

function _G.killall()
for a,b in ipairs(workspace.Players:GetChildren()) do
if b.Value.Character ~= nil then
local h = b.Value.Character:FindFirstChild(&quot;Humanoid&quot;)
if h ~= nil then
h.Health = 0
end
end
end
end

function _G.removetools()
for a,b in ipairs(_G.GameObjects) do
pcall(function()
if b.className == &quot;HopperBin&quot; or b.className == &quot;Tool&quot; then
b:remove()
end
end)
end
end

function _G.returnplayers()
for a,b in ipairs(workspace.Players:GetChildren()) do
if b.Value.Character ~= nil then
local h = b.Value.Character:FindFirstChild(&quot;Humanoid&quot;)
local t = b.Value.Character:FindFirstChild(&quot;Torso&quot;)
if h ~= nil and t ~= nil then
if h.Health ~= 0 then
for a=1,2 do
local bv = t:FindFirstChild(&quot;BodyVelocity&quot;)
if bv ~= nil then
bv:remove()
end end
h.Health = h.MaxHealth
_G.teleportplayertobrick(t,workspace.WaitingRoom.Floor)
_G.restorelimbs(b.Value.Character)
end end end end end

function _G.givetools(backpack,tools)
for a,b in ipairs(tools) do
local c = b:clone()
table.insert(_G.GameObjects,c)
c.Parent = backpack
end
end

function _G.checkplayer(player)
if player.className == &quot;Player&quot; then
if player.Character ~= nil then
local t = player.Character:FindFirstChild(&quot;Torso&quot;)
local h = player.Character:FindFirstChild(&quot;Humanoid&quot;)
if t ~= nil and h ~= nil then
if h.Health ~= 0 and player.IsPlaying.Value == true then
return {player,player.Character,t,h,player.Backpack}
end end end  end
return 0
end

function _G.checkifnone()
if #workspace.Players:GetChildren() == 0 or #workspace.Players:GetChildren() == 1 then
_G.cancel()
end
end

function _G.GetDescendants(object)
local list = {}
local gc = nil
gc = function(ob)
for a,b in ipairs(ob:GetChildren()) do
table.insert(list,b)
gc(b)
end end
gc(object)
return list 
end

function _G.teleportplayer(torso,position)
local oldpos = torso.Position
local newpos = torso.CFrame + (position - torso.Position)
--[[local humanoid = torso.Parent:FindFirstChild(&quot;Humanoid&quot;)
if humanoid ~= nil then
if humanoid.Sit == true then
for a,b in ipairs(GetDescendants(workspace)) do
if b.className == &quot;Weld&quot; then
if b.Part1 == torso then
b:remove()
end end end 
end end--]]

coroutine.resume(coroutine.create(function()

for a=1,5 do

wait()

if (torso.Position - oldpos).magnitude &lt; 1 then
torso.CFrame = newpos
else
return
end

end

end))

for a,b in ipairs(torso.Parent:GetChildren()) do
if b.className == &quot;Part&quot; then
b.Anchored = false
end end
for a=1,5 do
torso.CFrame = newpos
if (torso.Position - newpos.p).magnitude &lt; 1 then
return true
end
end
return false
end

function _G.teleportplayertobrick(torso,brick)

local pos = Vector3.new(math.random(brick.Position.x - (brick.Size.x / 2.2),brick.Position.x + (brick.Size.x / 2.2)),brick.Position.y + (brick.Size.y / 2) + 4,math.random(brick.Position.z - (brick.Size.z / 2.2),brick.Position.z + (brick.Size.z / 2.2)))

--[[local xlv = (brick.CFrame * CFrame.fromEulerAnglesXYZ(0,math.rad(90),0)).lookVector 
local x = math.random(brick.Position.x + (xlv * math.random(1,(brick.Size.x / 2))),brick.Position.x - (xlv * math.random(1,(brick.Size.x / 2))))
local y = brick.Position.y + (brick.Size.y / 2) + 4
local z = math.random(brick.Position.z + (brick.CFrame.lookVector.z * math.random(1,(brick.Size.z / 2))),brick.Position.z - (brick.CFrame.lookVector.z * math.random(1,(brick.Size.z / 2))))
local pos = Vector3.new(x,y,z)--]]
if _G.teleportplayer(torso,pos) == true then 
return true
else
return false
end
end



function _G.restorelimbs(p)
local torso = p:FindFirstChild(&quot;Torso&quot;)
if torso ~= nil then
local part = p:FindFirstChild(&quot;Right Arm&quot;)
if part == nil then
local a = p.Animate:clone()
p.Animate:remove()
a.Parent = p
local replacement = game.Lighting.Character[&quot;Right Arm&quot;]:clone()
replacement.Name = &quot;Right Arm&quot;
replacement.CFrame = torso.CFrame
replacement.Parent = p
local replacementlimb = game.Lighting.Character.Torso:FindFirstChild(&quot;Right Shoulder&quot;):clone()
replacementlimb.Part0 = torso
replacementlimb.Part1 = replacement
replacementlimb.Parent = torso
end
local part = p:FindFirstChild(&quot;Left Arm&quot;)
if part == nil then
local a = p.Animate:clone()
p.Animate:remove()
a.Parent = p
local replacement = game.Lighting.Character[&quot;Left Arm&quot;]:clone()
replacement.Name = &quot;Left Arm&quot;
replacement.CFrame = torso.CFrame
replacement.Parent = p
local replacementlimb = game.Lighting.Character.Torso:FindFirstChild(&quot;Left Shoulder&quot;):clone()
replacementlimb.Part0 = torso
replacementlimb.Part1 = replacement
replacementlimb.Parent = torso
end
local part = p:FindFirstChild(&quot;Left Leg&quot;)
if part == nil then
local a = p.Animate:clone()
p.Animate:remove()
a.Parent = p
local replacement = game.Lighting.Character[&quot;Left Leg&quot;]:clone()
replacement.Name = &quot;Left Leg&quot;
replacement.CFrame = torso.CFrame
replacement.Parent = p
local replacementlimb = game.Lighting.Character.Torso:FindFirstChild(&quot;Left Hip&quot;):clone()
replacementlimb.Part0 = torso
replacementlimb.Part1 = replacement
replacementlimb.Parent = torso
end
local part = p:FindFirstChild(&quot;Right Leg&quot;)
if part == nil then
local a = p.Animate:clone()
p.Animate:remove()
a.Parent = p
local replacement = game.Lighting.Character[&quot;Right Leg&quot;]:clone()
replacement.Name = &quot;Right Leg&quot;
replacement.CFrame = torso.CFrame
replacement.Parent = p
local replacementlimb = game.Lighting.Character.Torso:FindFirstChild(&quot;Right Hip&quot;):clone()
replacementlimb.Part0 = torso
replacementlimb.Part1 = replacement
replacementlimb.Parent = torso
end end end
