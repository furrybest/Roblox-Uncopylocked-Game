							<string name="Name">Script</string>
							<ProtectedString name="Source">kb = script.Parent
bp = kb.BodyPosition

bp.position = kb.Position

target = nil

script.Parent.Health.Changed:connect(function()
if script.Parent.Health.Value &lt;= 0 then
bp:remove()
wait(3)
script.Parent:remove()
else
bp.position = target.Position + Vector3.new(math.random(-20,20),math.random(15,25),math.random(-20,20))
end
end)

function fire(pos)

local s = Instance.new(&quot;Sound&quot;)
s.SoundId = &quot;http://www.roblox.com/asset/?id=2691586&quot;
s.Volume = 0.15
s.Looped = false
s.PlayOnRemove = true
s.Parent = script.Parent
s:remove()

--script.Parent.Fire:play()
local p = Instance.new(&quot;Part&quot;)
p.Shape = &quot;Ball&quot;
p.Size = Vector3.new(1,1,1)

local sm = Instance.new(&quot;SpecialMesh&quot;)
sm.MeshType = &quot;Sphere&quot;
sm.Scale = Vector3.new(0.3,0.3,0.3)
sm.Parent = p

p.BrickColor = BrickColor.new(&quot;Really black&quot;)
p.TopSurface = &quot;Smooth&quot;
p.BottomSurface = &quot;Smooth&quot;
local bv = Instance.new(&quot;BodyVelocity&quot;)
local acc = 5
bv.velocity = (CFrame.new(kb.Position,pos) * CFrame.fromEulerAnglesXYZ(math.rad(math.random(-acc,acc)),math.rad(math.random(-acc,acc)),0)).lookVector * 100
bv.maxForce = Vector3.new(math.huge,math.huge,math.huge)
bv.Parent = p
p.CFrame = kb.CFrame
pcall(function()
p.Touched:connect(function(hit)
if hit.Parent ~= nil then
local h = hit.Parent:FindFirstChild(&quot;Humanoid&quot;)
if h ~= nil then
h.Health = h.Health - 29
end
if hit.Name == &quot;Block&quot; then
hit:BreakJoints()

hit.Velocity = Vector3.new(math.random(-15,15),math.random(0,15),math.random(-15,15))

--[[
local v = Vector3.new(script.Parent.Velocity.x,0,script.Parent.Velocity.z).unit

local bv = Instance.new(&quot;BodyVelocity&quot;)
bv.velocity = Vector3.new(v.x * 25,hit.Velocity.y,v.z * 25) / hit:getMass()
bv.maxForce = Vector3.new(math.huge,0,math.huge)
bv.Parent = hit

coroutine.resume(coroutine.create(function()
local lastpos = hit.Position

while (hit.Position - lastpos).magnitude &lt; 3 do
wait()
end


bv:remove()
end))--]]

--hit.Velocity = Vector3.new(v.x * 65,hit.Velocity.y,v.z * 65) / hit:getMass()


end
if hit == kb then
return
end
p:remove()
end
end)
end)
p.Parent = workspace
coroutine.resume(coroutine.create(function()
wait(5)
p:remove()
end))
end

function findplayer()
local players = {}
for a,b in ipairs(game.Players:GetPlayers()) do

local isplaying = false
for c,d in ipairs(workspace.Players:GetChildren()) do
if d.Value == b then
isplaying = true
end end

if isplaying == true then
if b.Character ~= nil then
local h = b.Character:FindFirstChild(&quot;Humanoid&quot;)
local t = b.Character:FindFirstChild(&quot;Torso&quot;)
if h ~= nil and t ~= nil then
if h.Health ~= 0 then
table.insert(players,t)
end
end
end
end
end
target = players[math.random(1,#players)]
target.Parent.Humanoid.Died:connect(findplayer)
end 

findplayer()

coroutine.resume(coroutine.create(function()
wait(math.random(1,29) / 10)
while true do
wait(math.random(25,29) / 10)
fire(target.Position)
end
end))

wait(math.random(1,20) / 10)

while true do
bp.position = target.Position + Vector3.new(math.random(-20,20),math.random(15,25),math.random(-20,20))
wait(math.random(15,20) / 10)
end </ProtectedString>
