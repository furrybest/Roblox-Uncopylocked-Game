							<string name="Name">Script</string>
							<ProtectedString name="Source">debounce = false
function ot(hit)
if hit.Parent ~= nil then
local humanoid = hit.Parent:FindFirstChild(&quot;Humanoid&quot;)
if humanoid ~= nil then
humanoid.Health = 0
end
if debounce == false then
local cf = hit.CFrame
if hit.Name == &quot;Ball&quot; then
hit.Size = hit.Size - Vector3.new(1,1,1)
hit.CFrame = cf
debounce = true
wait(2)
debounce = false
end
end
end end

