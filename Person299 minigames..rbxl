function _G.cancel(dont)

workspace.WaitingRoom.South.Value = true
workspace.WaitingRoom.West.Value = true
workspace.WaitingRoom.East.Value = true

for a,b in ipairs(_G.GameObjects) do
if b ~= script then
b:remove()
end end

_G.canspawnall()
_G.killall()
_G.makeneutral()

workspace.IsGoing.Value = false
script:remove()

end

function permseat(guy,seat)
local h = guy:FindFirstChild(&quot;Humanoid&quot;)
local t = guy:FindFirstChild(&quot;Torso&quot;)
if h ~= nil and t ~= nil then
t.CFrame = seat.CFrame + Vector3.new(0,3,0)
local w = Instance.new(&quot;Weld&quot;)
w.Part0 = seat
w.Part1 = t
w.C0 = CFrame.new(0,2,0)
w.Parent = seat
h.Sit = true
local c = h.Changed:connect(function() if h.Sit == false then h.Health = 0 end end)
end
end

function assignteam(player)
local team1list = {}
local team2list = {}
for a,b in ipairs(game.Players:GetPlayers()) do
if b.TeamColor == team1.TeamColor then
table.insert(team1list,b)
elseif b.TeamColor == team2.TeamColor then
table.insert(team2list,b)
end end
local team = nil
if #team1list &gt; #team2list then
team = team2
elseif #team2list &gt; #team1list then
team = team1
elseif #team1list == #team2list then
if math.random(1,2) == 1 then
team = team1
else
team = team2
end
end
player.TeamColor = team.TeamColor
player.Neutral = false
return team
end

--Body

for n,p in ipairs(game.Players:GetPlayers()) do
local pinfo = _G.checkplayer(p)
if pinfo ~= 0 then

local team = assignteam(p)

if team == team1 then

giveplane(pinfo[1],gamemodel.RCarrier)

p.Changed:connect(function(pr)
if pr == &quot;Character&quot; then
if p.Character ~= nil then
wait(0.7)
if hasended == true then return end
if p.TeamColor == BrickColor.new(1) then return end
giveplane(pinfo[1],gamemodel.RCarrier)
end end end)

elseif team == team2 then

giveplane(pinfo[1],gamemodel.BCarrier)

p.Changed:connect(function(pr)
if pr == &quot;Character&quot; then
if p.Character ~= nil then
wait(0.7)
if hasended == true then return end
if p.TeamColor == BrickColor.new(1) then return end
giveplane(pinfo[1],gamemodel.BCarrier)
end end end)

end

local o = Instance.new(&quot;ObjectValue&quot;)
o.Value = p
o.Parent = workspace.Players

pinfo[1].CanSpawn.Value = false

end
end 

_G.checkifnone()

if #workspace.Players:GetChildren() == 2 then
maxhealth = 30
elseif #workspace.Players:GetChildren() == 3 then
maxhealth = 35
elseif #workspace.Players:GetChildren() == 4 then
maxhealth = 40
elseif #workspace.Players:GetChildren() == 5 then
maxhealth = 45
elseif #workspace.Players:GetChildren() == 6 then
maxhealth = 50
elseif #workspace.Players:GetChildren() == 7 then
maxhealth = 55
elseif #workspace.Players:GetChildren() == 8 then
maxhealth = 65
elseif #workspace.Players:GetChildren() == 9 then
maxhealth = 75
elseif #workspace.Players:GetChildren() == 10 then
maxhealth = 85
elseif #workspace.Players:GetChildren() == 11 then
maxhealth = 90
else
maxhealth = 50
end

print(maxhealth)

gamemodel.RCarrier.Health.Value = maxhealth
gamemodel.BCarrier.Health.Value = maxhealth

function updatemes()

local rednum = math.ceil(gamemodel.RCarrier.Health.Value * (100 / maxhealth))
if rednum &lt; 0 then
rednum = 0
end

local bluenum = math.ceil(gamemodel.BCarrier.Health.Value * (100 / maxhealth))
if bluenum &lt; 0 then
bluenum = 0
end

mes.Text = &quot;Red Hull Integrity: &quot; .. rednum .. &quot;% Blue Hull Integrity: &quot; .. bluenum .. &quot;%&quot;

end

mes = Instance.new(&quot;Hint&quot;)
table.insert(_G.GameObjects,mes)
mes.Parent = workspace
updatemes()

gamemodel.RCarrier.Health.Changed:connect(updatemes)
gamemodel.BCarrier.Health.Changed:connect(updatemes)

gamemodel.BCarrier.Sunk.Changed:connect(redwin)
gamemodel.RCarrier.Sunk.Changed:connect(bluewin)
