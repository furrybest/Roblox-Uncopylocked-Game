								<string name="Name">Script</string>
								<ProtectedString name="Source">ispunching = false
script.Parent.Selected:connect(function(m)
m.Button1Down:connect(function()
if ispunching == true then return end
ispunching = true
rs = script.Parent.Parent.Parent.Character.Torso[&quot;Right Shoulder&quot;]
ra = script.Parent.Parent.Parent.Character[&quot;Right Arm&quot;]
local raconnection = ra.Touched:connect(function(hit)
local h = hit.Parent:FindFirstChild(&quot;Humanoid&quot;)
if h ~= nil then
local t = hit.Parent:FindFirstChild(&quot;Torso&quot;)
if t ~= nil then

local bv = Instance.new(&quot;BodyVelocity&quot;)
bv.velocity = script.Parent.Parent.Parent.Character.Torso.CFrame.lookVector * 30
bv.maxForce = Vector3.new(math.huge,0,math.huge)
bv.Parent = t

local rs = game.Lighting.SpecialScripts.Removal:clone()
rs.Time.Value = 0.85
rs.Parent = bv

raconnection:disconnect()

--t.Velocity = script.Parent.Parent.Parent.Character.Torso.CFrame.lookVector * 150
end
end
end)
rs.DesiredAngle = math.rad(90) --1.6
rs.MaxVelocity = 0.6
local rschange = rs.Changed:connect(function()
rs.DesiredAngle = math.rad(90) --1.6
rs.MaxVelocity = 0.6
end)
wait(1)
rschange:disconnect()
raconnection:disconnect()
rs.MaxVelocity = 0.1
rs.DesiredAngle = math.rad(0)
wait(1)
ispunching = false
end)
end)</ProtectedString>
