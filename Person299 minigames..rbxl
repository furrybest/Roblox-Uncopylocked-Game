								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">Script</string>
								<ProtectedString name="Source">--[[function float(char)

if char:findFirstChild(&quot;Torso&quot;) == nil then
return
end

local nc = game.Lighting.SpecialObjects.DrownedCharacter:clone()
nc.Parent = script.Parent.Parent
nc:MakeJoints()
--nc.NewTorso.CFrame = char.Torso.CFrame

nc:MoveTo(char.Torso.Position)

for a,b in ipairs(char:GetChildren()) do
if b.className == &quot;BodyColors&quot; or b.className == &quot;Pants&quot; or b.className == &quot;Shirt&quot; or b.className == &quot;ShirtGraphic&quot; then
b:clone().Parent = nc
end end

local bp = Instance.new(&quot;BodyPosition&quot;)
bp.maxForce = Vector3.new(bp.maxForce.x,bp.maxForce.y * 2,bp.maxForce.z)
bp.Parent = nc.Torso

local bp2 = Instance.new(&quot;BodyPosition&quot;)
bp2.maxForce = Vector3.new(0,bp2.maxForce.y,0)
bp2.Parent = nc.HeadModel.Head

local ch = nc.HeadModel.Head

nc.HeadModel.Name = char.Name

char.Humanoid.Health = 0

for a,b in ipairs(char:GetChildren()) do
if b.className == &quot;Part&quot; then
b:remove()
end end

local pos = nc.Torso.Position

local randvel = 2.49
nc.Torso.RotVelocity = Vector3.new(math.random(-randvel,randvel),math.random(-randvel,randvel),math.random(-randvel,randvel))

while true do
bp.position = Vector3.new(pos.x,script.Parent.Position.y + 1,pos.z)
bp2.position = Vector3.new(pos.x,script.Parent.Position.y + 1,pos.z)
wait(1)
end

end

script.Parent.Touched:connect(function(hit)
if hit.Parent ~= nil then
if hit.Name == &quot;Head&quot; and hit.Parent:findFirstChild(&quot;IsDrownedChar&quot;) == nil then
local h = hit.Parent:FindFirstChild(&quot;Humanoid&quot;)
if h ~= nil then
float(hit.Parent)
h.Health = 0
end end end end)
--]]

pos = 78.9
time = 25

add = (pos - script.Parent.Position.y) / (time / 0.6)

script.Parent.Parent.WaterHeight.Value = script.Parent.Position.y

wait(5)

while true do
script.Parent.CFrame = script.Parent.CFrame + Vector3.new(0,add,0)
script.Parent.Parent.WaterHeight.Value = script.Parent.Position.y
if script.Parent.Position.y &gt;= pos then
break
end
wait(0.6)
end 

--[[while true do

for a,b in ipairs(workspace.Players:GetChildren()) do
if b.Value.Character ~= nil then
local h = b.Value.Character:FindFirstChild(&quot;Head&quot;)
local h2 = b.Value.Character:FindFirstChild(&quot;Humanoid&quot;)
if h ~= nil and h2 ~= nil then
if h.Parent ~= nil and h2.Parent ~= nil then
if h.Position.y &lt;= script.Parent.Position.y  then
h2.Health = 0
float(b.Value.Character)
end end end end end

wait(10)

end --]]
</ProtectedString>
								<bool name="archivable">true</bool>
