team2.Name = &quot;Blue Team&quot;
team2.AutoAssignable = false
team2.Parent = game.Teams

--Functions

function giveplane(player,carrier)

coroutine.resume(coroutine.create(function()

local pinfo = _G.checkplayer(player)
if pinfo ~= 0 then

if carrier == gamemodel.RCarrier then

if gamemodel.RCarrier.Used.Value == true then
while gamemodel.RCarrier.Used.Value == true do
wait(1)
end end

if hasended == true then return end

gamemodel.RCarrier.Used.Value = true

local plane = rplane:clone()
plane.Parts.RWing.BrickColor = pinfo[1].SignatureColor.Value
plane.Parts.LWing.BrickColor = pinfo[1].SignatureColor.Value
plane.Parts.Gun1.BrickColor = pinfo[1].SignatureColor.Value
plane.Parts.Gun2.BrickColor = pinfo[1].SignatureColor.Value
plane.Name = &quot;Plane&quot;
plane.Parent = pinfo[2]
plane:MakeJoints()
_G.teleportplayertobrick(pinfo[3],plane.Parts.Seat)
permseat(pinfo[2],plane.Parts.Seat)
elseif carrier == gamemodel.BCarrier then

if gamemodel.BCarrier.Used.Value == true then
while gamemodel.BCarrier.Used.Value == true do
wait(1)
end end

if hasended == true then return end

gamemodel.BCarrier.Used.Value = true

local plane = bplane:clone()
plane.Parts.RWing.BrickColor = pinfo[1].SignatureColor.Value
plane.Parts.LWing.BrickColor = pinfo[1].SignatureColor.Value
plane.Parts.Gun1.BrickColor = pinfo[1].SignatureColor.Value
plane.Parts.Gun2.BrickColor = pinfo[1].SignatureColor.Value
plane.Name = &quot;Plane&quot;
plane.Parent = pinfo[2]
plane:MakeJoints()
_G.teleportplayertobrick(pinfo[3],plane.Parts.Seat)
permseat(pinfo[2],plane.Parts.Seat)
end
end
end))
wait()
wait()
wait()
end

function redwin()
if hasended == true then return end
hasended = true

local m = Instance.new(&quot;Message&quot;)
table.insert(_G.GameObjects,m)
m.Text = &quot;Red Team Wins!&quot;
m.Parent = workspace
_G.canspawnall()
_G.killall()
_G.removetools()
for a,b in ipairs(game.Players:GetPlayers()) do
if b.TeamColor == team1.TeamColor then
b.leaderstats.Points.Value = b.leaderstats.Points.Value + (gamepoints * (_G.numonteam(team2.TeamColor) / _G.numonteam(team1.TeamColor)))
end end
_G.makeneutral()
wait(10)
workspace.WaitingRoom.South.Value = true
workspace.WaitingRoom.West.Value = true
workspace.WaitingRoom.East.Value = true
wait(2)
for a,b in ipairs(_G.GameObjects) do
if b ~= script then
b:remove()
end end
workspace.IsGoing.Value = false
script:remove()

end

function bluewin()
if hasended == true then return end
hasended = true

local m = Instance.new(&quot;Message&quot;)
table.insert(_G.GameObjects,m)
m.Text = &quot;Blue Team Wins!&quot;
m.Parent = workspace
