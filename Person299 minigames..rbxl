player:WaitForDataReady()

local numba2 = &quot;http://www.roblox.com/asset/?id=&quot; .. p:LoadNumber(&quot;LastAdBoardPost&quot;)

for a,b in ipairs(list) do
if b[1] == p then
table.remove(list,a)
end end

table.insert(list,{p,numba2})

end)

end)

while true do
