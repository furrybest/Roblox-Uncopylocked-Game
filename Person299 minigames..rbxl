			<Item class="HopperBin" referent="RBX122">
				<Properties>
					<bool name="Active">false</bool>
					<token name="BinType">0</token>
					<string name="Name">Weird Thingy</string>
					<Content name="TextureId"><null></null></Content>
					<bool name="archivable">true</bool>
				</Properties>
				<Item class="LocalScript" referent="RBX123">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">LocalScript</string>
						<ProtectedString name="Source">function computeDirection(vec)
	local lenSquared = vec.magnitude * vec.magnitude
	local invSqrt = 1 / math.sqrt(lenSquared)
	return Vector3.new(vec.x * invSqrt, vec.y * invSqrt, vec.z * invSqrt)
end

script.Parent.Selected:connect(function(mouse)
gmouse = mouse

gmouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;


mouse.Button1Down:connect(function()

local it = Instance.new(&quot;Part&quot;)
it.CanCollide = false
it.formFactor = &quot;Symmetric&quot;
it.Size = Vector3.new(1,1,1)
it.BrickColor = BrickColor.new(21)
it.TopSurface = &quot;Smooth&quot;
it.BottomSurface = &quot;Smooth&quot;
it.Name = &quot;Thingofmabob&quot;

local sm = Instance.new(&quot;SpecialMesh&quot;)
sm.MeshType = &quot;Sphere&quot;
sm.Scale = Vector3.new(5,5,1)
sm.Parent = it

local its = script.Parent.Script:clone()
its.Disabled = false
its.Parent = it

local bf = Instance.new(&quot;BodyForce&quot;)
bf.force = Vector3.new(0,it:GetMass() * 186.5,0)
bf.Parent = it

local torso = script.Parent.Parent.Parent.Character:findFirstChild(&quot;Torso&quot;)
if torso == nil then
return 
end

local humanoid = script.Parent.Parent.Parent.Character:findFirstChild(&quot;Humanoid&quot;)
if humanoid == nil then
return 
end

local dir = mouse.hit.p - torso.Position

dir = computeDirection(dir)

local pos = torso.Position + (dir * 12)
it.CFrame = CFrame.new(pos,  pos + dir)

it.Velocity = it.CFrame.lookVector * 90

it.Parent = game.Workspace

end)


end)

script.Parent.Deselected:connect(function(mouse)

end)</ProtectedString>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
				<Item class="Script" referent="RBX124">
					<Properties>
						<bool name="Disabled">true</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">script.Parent.Touched:connect(function(hit)
if hit.Parent ~= nil then 
if hit.Anchored == false then
if hit.Name ~= &quot;Thingofmabob&quot; then
hit:BreakJoints()
local pos = script.Parent.CFrame * (Vector3.new(0, 1.4, 0) * script.Parent.Size)
hit.Velocity = ((hit.Position - pos).unit + Vector3.new(0, 0.5, 0)) * 150 + hit.Velocity	
hit.RotVelocity = hit.RotVelocity + Vector3.new(hit.Position.z - pos.z, 0, pos.x - hit.Position.x).unit * 40
end end end end )


--[[for i=1,10 do
wait(1.5)
local cf = script.Parent.CFrame
script.Parent.Size = script.Parent.Size + Vector3.new(1,1,0)
script.Parent.BodyForce.force = Vector3.new(0,script.Parent:GetMass() * 186.5,0)
script.Parent.CFrame = cf
script.Parent.Velocity = script.Parent.CFrame.lookVector * 60
end --]]

wait(10)

script.Parent:remove()</ProtectedString>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
			</Item>
			<Item class="HopperBin" referent="RBX125">
				<Properties>
					<bool name="Active">false</bool>
					<token name="BinType">0</token>
					<string name="Name">Move</string>
					<Content name="TextureId"><null></null></Content>
					<bool name="archivable">true</bool>
				</Properties>
				<Item class="Script" referent="RBX126">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">part = nil
controlling = false
mdown = false


script.Parent.Selected:connect(function(m)
controlling = true
m.Button1Down:connect(function()
mdown = true
if controlling == false then return end
if m.Target ~= nil then
local targ = m.Target
if targ.Anchored == false then

bv = Instance.new(&quot;BodyVelocity&quot;)
bv.maxForce = Vector3.new(999999999,999999999,999999999)
--bv.velocity = CFrame.new(targ.Position,m.hit.p).lookVector * 50 --CFrame.new(targ.Position,script.Parent.Parent.Parent.Character.Torso.Position).lookVector * 50
bv.Parent = targ
while mdown == true do
if bv.Parent == nil then return end
if (bv.Parent.Position - m.hit.p).magnitude &lt; 5 or m.Target == bv.Parent then
bv.velocity = Vector3.new(0,0,0)
else
bv.velocity = CFrame.new(targ.Position,m.hit.p).lookVector * 50
end
wait(0.2)
end

if bv ~= nil then
bv:remove()
end

end end end)

m.Button1Up:connect(function()
mdown = false
end)

end)

script.Parent.Deselected:connect(function()
controlling = false
end)</ProtectedString>
						<bool name="archivable">true</bool>
