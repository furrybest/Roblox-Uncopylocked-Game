					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Game17Script</string>
					<ProtectedString name="Source">--Initiation
script.Name = &quot;GameScript&quot;
table.insert(_G.GameObjects,script)
gamemodel = game.Lighting.GameModels.Game17Model:clone()
table.insert(_G.GameObjects,gamemodel)
gamemodel.Name = &quot;GameModel&quot;
gamemodel.Parent = workspace
gamepoints = 35

workspace.WaitingRoom.South.Value = false

team1 = Instance.new(&quot;Team&quot;)
team1.TeamColor = BrickColor.new(21)
team1.Name = &quot;Red Team&quot;
team1.AutoAssignable = false
team1.Parent = game.Teams

team2 = Instance.new(&quot;Team&quot;)
team2.TeamColor = BrickColor.new(23)
team2.Name = &quot;Blue Team&quot;
team2.AutoAssignable = false
team2.Parent = game.Teams

--Functions

function _G.cancel(dont)

workspace.WaitingRoom.South.Value = true

for a,b in ipairs(_G.GameObjects) do
if b ~= script then
b:remove()
end end

_G.returnplayers()
_G.makeneutral()

workspace.IsGoing.Value = false
script:remove()

end

function checkwin()
local team1list = {}
local team2list = {}
for a,b in ipairs(workspace.Players:GetChildren()) do
if b.Value.TeamColor == team1.TeamColor then
table.insert(team1list,b.Value)
elseif b.Value.TeamColor == team2.TeamColor then
table.insert(team2list,b.Value)
end end

if #team2list == 0 then
hasended = true
local m = Instance.new(&quot;Message&quot;)
table.insert(_G.GameObjects,m)
m.Text = &quot;Red Team Wins!&quot;
m.Parent = workspace
_G.returnplayers()
_G.removetools()
workspace.WaitingRoom.South.Value = true
for a,b in ipairs(game.Players:GetPlayers()) do
if b.TeamColor == team1.TeamColor then
b.leaderstats.Points.Value = b.leaderstats.Points.Value + (gamepoints * (_G.numonteam(team2.TeamColor) / _G.numonteam(team1.TeamColor)))
end end
_G.makeneutral()
wait(2)
for a,b in ipairs(_G.GameObjects) do
if b ~= script then
b:remove()
end end
workspace.IsGoing.Value = false
script:remove()
elseif #team1list == 0 then
hasended = true
local m = Instance.new(&quot;Message&quot;)
table.insert(_G.GameObjects,m)
m.Text = &quot;Blue Team Wins!&quot;
m.Parent = workspace
_G.returnplayers()
_G.removetools()
workspace.WaitingRoom.South.Value = true
for a,b in ipairs(game.Players:GetPlayers()) do
if b.TeamColor == team2.TeamColor then
b.leaderstats.Points.Value = b.leaderstats.Points.Value + (gamepoints * (_G.numonteam(team1.TeamColor) / _G.numonteam(team2.TeamColor)))
end end
_G.makeneutral()
wait(2)
for a,b in ipairs(_G.GameObjects) do
if b ~= script then
b:remove()
end end
workspace.IsGoing.Value = false
script:remove()
end

end

function assignteam(player)
local team1list = {}
local team2list = {}
for a,b in ipairs(game.Players:GetPlayers()) do
if b.TeamColor == team1.TeamColor then
table.insert(team1list,b)
elseif b.TeamColor == team2.TeamColor then
table.insert(team2list,b)
end end
local team = nil
if #team1list &gt; #team2list then
team = team2
elseif #team2list &gt; #team1list then
team = team1
elseif #team1list == #team2list then
if math.random(1,2) == 1 then
team = team1
else
team = team2
end
end
player.TeamColor = team.TeamColor
player.Neutral = false
return team
end

--Body

for n,p in ipairs(game.Players:GetPlayers()) do
local pinfo = _G.checkplayer(p)
if pinfo ~= 0 then

local team = assignteam(p)

if team == team1 then
_G.teleportplayertobrick(pinfo[3],gamemodel.RedSpawn)
_G.givetools(pinfo[5],{game.Lighting.GameTools.Game17Tools.RedSword})
elseif team == team2 then
_G.teleportplayertobrick(pinfo[3],gamemodel.BlueSpawn)
_G.givetools(pinfo[5],{game.Lighting.GameTools.Game17Tools.BlueSword})
end

local o = Instance.new(&quot;ObjectValue&quot;)
o.Value = p
o.Parent = workspace.Players
pinfo[4].Died:connect(function() if hasended == nil then o:remove() end end)
end
end 

_G.checkifnone()

workspace.Players.ChildRemoved:connect(checkwin)</ProtectedString>
