			<Item class="Script" referent="RBX9">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Main</string>
					<ProtectedString name="Source">--373
_G.GameObjects = {}

minplayers = 2
testgame = 0
_G.nextgame = 0
_G.nextboughtgame = {}


last = {0,0,0,0,0,0,0}

--[[
