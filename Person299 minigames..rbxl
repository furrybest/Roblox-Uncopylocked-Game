					<Item class="Script" referent="RBX5763">
						<Properties>
							<bool name="Disabled">true</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script</string>
							<ProtectedString name="Source">Torso = script.Parent.Torso
Head = script.Parent.HeadModel
Head.Name = script.Parent.CharName.Value

BPs = {Torso.BodyPosition}

bp = Torso.BodyPosition

local w = Instance.new(&quot;Weld&quot;)
w.Part0 = Torso
w.Part1 = Head.Head
w.C0 = Torso.CFrame:inverse()
w.C1 = Head.Head.CFrame:inverse()
w.Parent = Torso

for a,b in ipairs(script.Parent:GetChildren()) do
if b.className == &quot;Part&quot; and b.Name ~= &quot;Torso&quot; then
local w = nil

if b.Name == &quot;Head&quot; then
w = Instance.new(&quot;Weld&quot;)
else
w = Instance.new(&quot;Glue&quot;)
end

w.Part0 = Torso
w.Part1 = b
w.C0 = Torso.CFrame:inverse()
w.C1 = b.CFrame:inverse()
w.Parent = Torso
end end 

script.Parent.WaterPosVal.Value.Changed:connect(function()
for a,b in ipairs(BPs) do
b.position = Vector3.new(0,script.Parent.WaterPosVal.Value.Value + 1,0)
end
end)

function floatpart(p)
local nbp = Torso.BodyPosition:clone()
nbp.Parent = p
Torso.BodyVelocity:clone().Parent = p
table.insert(BPs,nbp)
end 

Torso.ChildRemoved:connect(function(w)
if w.className == &quot;Weld&quot; then
if w.Part1.Name == &quot;Head&quot; or w.Part1.Name == &quot;Right Arm&quot; or w.Part1.Name == &quot;Left Arm&quot; or w.Part1.Name == &quot;Right Leg&quot; or w.Part1.Name == &quot;Left Leg&quot; then 
floatpart(w.Part1)
end
end
end)

local randvel = 4.99
Torso.RotVelocity = Vector3.new(math.random(-randvel,randvel),math.random(-randvel,randvel),math.random(-randvel,randvel))

bp.position = Vector3.new(0,script.Parent.WaterPosVal.Value.Value + 1,0)</ProtectedString>
							<bool name="archivable">true</bool>
						</Properties>
					</Item>
					<Item class="ObjectValue" referent="RBX5764">
						<Properties>
