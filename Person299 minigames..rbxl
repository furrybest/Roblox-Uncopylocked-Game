--Functions

function giveplane(player,carrier)

coroutine.resume(coroutine.create(function()

local pinfo = _G.checkplayer(player)
if pinfo ~= 0 then

if carrier == gamemodel.RCarrier then

if gamemodel.RCarrier.Used.Value == true then
while gamemodel.RCarrier.Used.Value == true do
wait(1)
end end

if hasended == true then return end

gamemodel.RCarrier.Used.Value = true

local plane = rplane:clone()
plane.Parts.RWing.BrickColor = pinfo[1].SignatureColor.Value
plane.Parts.LWing.BrickColor = pinfo[1].SignatureColor.Value
plane.Parts.Gun1.BrickColor = pinfo[1].SignatureColor.Value
plane.Parts.Gun2.BrickColor = pinfo[1].SignatureColor.Value
plane.Name = &quot;Plane&quot;
plane.Parent = pinfo[2]
plane:MakeJoints()
_G.teleportplayertobrick(pinfo[3],plane.Parts.Seat)
permseat(pinfo[2],plane.Parts.Seat)
elseif carrier == gamemodel.BCarrier then

if gamemodel.BCarrier.Used.Value == true then
while gamemodel.BCarrier.Used.Value == true do
wait(1)
end end

if hasended == true then return end

gamemodel.BCarrier.Used.Value = true

local plane = bplane:clone()
plane.Parts.RWing.BrickColor = pinfo[1].SignatureColor.Value
plane.Parts.LWing.BrickColor = pinfo[1].SignatureColor.Value
plane.Parts.Gun1.BrickColor = pinfo[1].SignatureColor.Value
plane.Parts.Gun2.BrickColor = pinfo[1].SignatureColor.Value
plane.Name = &quot;Plane&quot;
plane.Parent = pinfo[2]
plane:MakeJoints()
_G.teleportplayertobrick(pinfo[3],plane.Parts.Seat)
permseat(pinfo[2],plane.Parts.Seat)
end
end
end))
wait()
wait()
wait()
end

