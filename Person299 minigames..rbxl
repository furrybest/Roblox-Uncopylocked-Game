					<Item class="Script" referent="RBX476">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script</string>
							<ProtectedString name="Source">engine = script.Parent.Parts.Engine

script.Parent.Dead.Changed:connect(function()

bleh = script.Parent.BodyKit:GetChildren()

for c=1,math.random(1,3) do
local f = script.Fire:clone()
f.Enabled = true
local r = math.random(1,#bleh)
f.Parent = bleh[r]
table.remove(bleh,r)
end

bleh = script.Parent.BodyKit:GetChildren()

for c=1,math.random(1,3) do
local f = script.Smoke:clone()
f.Enabled = true
local r = math.random(1,#bleh)
f.Parent = bleh[r]
table.remove(bleh,r)
end

engine.BodyGyro.maxTorque = Vector3.new(9000,9000,9000)

for a=1,50 do
engine.BodyGyro.cframe = CFrame.new(engine.Position,engine.Position + engine.CFrame.lookVector - (Vector3.new(0,.01,0) * a))

if engine.BodyGyro.cframe.lookVector.y &lt;= -0.9 then
wait(2)
break
end

wait(.1)
end 

script.Parent.Parent.Humanoid.Health = 0

end)

ff = Instance.new(&quot;ForceField&quot;)
ff.Name = &quot;FF&quot;
table.insert(_G.GameObjects,ff)
ff.Parent = script.Parent.Parent
wait(5)
ff:remove()</ProtectedString>
							<bool name="archivable">true</bool>
