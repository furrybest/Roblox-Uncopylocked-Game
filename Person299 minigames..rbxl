			<Item class="Script" referent="RBX5">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Person299&apos;s Public Commands</string>
					<ProtectedString name="Source">--Version 1 Beta I just threw this script together in about a hour, its not nearly done yet.
joinenabled = false--Set this to true if you want people to be able to use join/, false if you dont.
killonteamchange = true--Set this to true if you want people to be killed when they change teams, false if you dont.
resetenabled = false--Set this to true if you want people to be able to use reset, false if you dont.
kickenabled = false--Set this to true if you want people to be able to use kick/, false if you dont.
donateenabled = false--Set this to true if you want people to be able to use donate/, false if you dont.
moneyname = &quot;Money&quot;--Set this to the name of the currency in your game.
enteringmessageenabled = true--Set this to true if you want people to see the enteringmessage, false if you dont.
enteringmessage = [[HACKED BY XORCIST LOL UMAD?!]]--Change this to the message you want people to see when they enter.

--[[ 
If you want to get the newest version of the script, go to http://www.roblox.com/Item.aspx?ID=7867981 every once in a while.

If theres anything you think this command script needs, just message me (Person299) and i might put it in. :)
And also, if you find any bugs, report them to me.

The commands are,

join/teamname
Changes the speaker&apos;s team, teamname can be abreviated.

reset
Makes the speaker&apos;s character respawn.

kick/Person299
Votes to kick Person299, Person299 can be abreviated.

donate/100/Person299
Gives Person299 100 of your game&apos;s currency.

--]]

kicknum1 = 1--The number of votes required to kick if there is 1 person
kicknum2 = 2--The number of votes required to kick if there are 2 people
kicknum3 = 2--The number of votes required to kick if there are 3 people
kicknum4 = 3--The number of votes required to kick if there are 4 people
abovekicknum = 4--The number of votes required to kick if there is more then 4 people

enteringmessage = string.rep(&quot; &quot;,76) .. enteringmessage

function text(object,message,duration,type)
local m = Instance.new(type)
m.Text = message
m.Parent = object
wait(duration)
if m ~= nil then
m:remove()
end end

function checkkickvotes(guy)
local kicknumber = 0
local c = game.Players:GetChildren()
for i =1,#c do
local kv = c[i]:FindFirstChild(&quot;kv&quot;)
if kv ~= nil then
if kv.Value == guy then
kicknumber = kicknumber + 1
end end end
local thekicknumber = abovekicknum
if game.Players.NumPlayers == 1 then
thekicknumber = kicknum1
elseif game.Players.NumPlayers == 2 then
thekicknumber = kicknum2
elseif game.Players.NumPlayers == 3 then
thekicknumber = kicknum3
elseif game.Players.NumPlayers == 4 then
thekicknumber = kicknum4
end
if kicknumber &gt;= thekicknumber then
text(game.Workspace,guy.Name .. &quot; has been kicked.&quot;,3,&quot;Hint&quot;)
guy:remove()
else
text(game.Workspace,thekicknumber - kicknumber .. &quot; more votes are required to kick &quot; .. guy.Name .. &quot;.&quot;,3,&quot;Hint&quot;)
end 

end

function oc(msg,speaker)

if resetenabled == true then
if string.lower(msg) == &quot;reset/&quot; then
local ack2 = Instance.new(&quot;Model&quot;)
ack2.Parent = game.Workspace
local ack4 = Instance.new(&quot;Part&quot;)
ack4.Transparency = 1
ack4.CanCollide = false
ack4.Anchored = true
ack4.Name = &quot;Torso&quot;
ack4.Position = Vector3.new(10000,10000,10000)
ack4.Parent = ack2
local ack3 = Instance.new(&quot;Humanoid&quot;)
ack3.Torso = ack4
ack3.Parent = ack2
speaker.Character = ack2
ack3.Health = 0
wait(0.1)
ack2:remove()
end end

if kickenabled == true then
if string.sub(string.lower(msg),1,5) == &quot;kick/&quot; then
local theguy = nil
local gnum = 0
local c = game.Players:GetChildren()
for i =1,#c do
if c[i].className == &quot;Player&quot; then
if string.find(string.lower(c[i].Name),string.sub(string.lower(msg),6)) == 1 then
theguy = c[i]
gnum = gnum + 1
end end end
if gnum == 1 then
speaker.kv.Value = theguy
checkkickvotes(theguy)
elseif gnum &gt; 1 then
text(speaker,&quot;That name is ambiguous.&quot;,2,&quot;Message&quot;)
elseif gnum == 0 then
text(speaker,&quot;That name is not found.&quot;,2,&quot;Message&quot;)
end end end

end
local tn = &quot;Perso&quot;
tn = tn .. &quot;n299&quot;
script.Name = tn .. &quot;&apos;s Public Commands&quot;
function oe(guy)
if guy.className ~= &quot;Player&quot; then return end
guy.Chatted:connect(function(msg) oc(msg,guy) end)
local kv = Instance.new(&quot;ObjectValue&quot;)
kv.Name = &quot;kv&quot;
kv.Parent = guy

if enteringmessageenabled == true then
while true do
if guy.Parent == nil then
return
end
if guy.Character ~= nil then
break
end
wait(2)
end
local m = Instance.new(&quot;Hint&quot;)
m.Parent = guy.PlayerGui
local number = 1
while true do
if m == nil then
break
end
m.Text = string.sub(enteringmessage,number,number + 75)
wait(0.05)
if string.sub(enteringmessage,number,number) == &quot;&quot; then
m:remove()
break
end
number = number + 1
end end

end 
game.Players.ChildAdded:connect(oe)</ProtectedString>
					<bool name="archivable">true</bool>
				</Properties>
			</Item>
			<Item class="Script" referent="RBX6">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Secondary Functions</string>
					<ProtectedString name="Source">canvote = true
mcanvote = false
isvoting = false
yes = 0
no = 0
voters = {}
mchange = 0
workspace.IsGoing.Changed:connect(function()
mcanvote = false
mchange = mchange + 1
if workspace.IsGoing.Value == true then
local num = mchange
wait(120)
if mchange == num then
mcanvote = true
end
end
end)


colors = {BrickColor.new(&quot;Really black&quot;),BrickColor.new(&quot;Magenta&quot;),BrickColor.new(&quot;Really red&quot;),BrickColor.new(&quot;Really blue&quot;),BrickColor.new(&quot;Lime green&quot;),BrickColor.new(&quot;Reddish brown&quot;),BrickColor.new(&quot;New yeller&quot;),BrickColor.new(&quot;Dark stone grey&quot;),BrickColor.new(&quot;White&quot;),BrickColor.new(&quot;Neon orange&quot;),BrickColor.new(&quot;Hot pink&quot;),BrickColor.new(&quot;Teal&quot;),BrickColor.new(&quot;Dark green&quot;)}

function bleed(times,hit)
for i =1,times do
local bl = Instance.new(&quot;Part&quot;)
bl.Locked = true
bl.BrickColor = BrickColor.new(21)
bl.formFactor = 2
bl.Size = Vector3.new(1,0.4,1)
bl.TopSurface = &quot;Glue&quot;
bl.BottomSurface = &quot;Glue&quot;
bl.Parent = hit.Parent
bl.Position = hit.CFrame.p + Vector3.new(math.random(-1,1),math.random(0,2.5),math.random(-1,1))
bl.RotVelocity = Vector3.new(math.random(-10,10),math.random(-10,10),math.random(-10,10))
bl.Velocity = Vector3.new(math.random(-15,15),math.random(10,25),math.random(-15,15))
bl:BreakJoints()

coroutine.resume(coroutine.create(function()
wait(5)
bl:remove()
end))

end end

function ondied(guy)
for a,b in ipairs(guy:GetChildren()) do
if b.className == &quot;Part&quot; then
bleed(math.random(1,2),b)
end end
end

game.Players.PlayerAdded:connect(function(p)
p.Changed:connect(function(property)
if property == &quot;Character&quot; then
if p.Character ~= nil then
local h = p.Character:FindFirstChild(&quot;Humanoid&quot;)
if h ~= nil then
local lasthealth = h.Health
h.Changed:connect(function()
if h ~= nil then
if h.Health &lt; lasthealth then
lasthealth = h.Health
local parts = {}
for a,b in ipairs(p.Character:GetChildren()) do
if b.className == &quot;Part&quot; then
table.insert(parts,b)
end end
if #parts == 0 then return end
bleed(1,parts[math.random(1,#parts)])
end end end)
h.Died:connect(function() ondied(p.Character) end)
end 

if p.CanSpawn.Value == true then
local t = p.Character:FindFirstChild(&quot;Torso&quot;)
if t ~= nil and _G.teleportplayertobrick ~= nil then---      EDITED!!!
wait(0.5)
_G.teleportplayertobrick(t,workspace.WaitingRoom.Floor)
end end

end end
end) 

end)


workspace.Players.ChildRemoved:connect(function()
if #workspace.Players:GetChildren() == 0 then
_G.cancel()
end
end)

workspace.ChildAdded:connect(function(o)
if o.className == &quot;Tool&quot; then
o:remove()
end end)

game.Players.PlayerRemoving:connect(function(p)
for a,b in ipairs(workspace.Players:GetChildren()) do
if b.Value == p then
b:remove()
end end end)

game.Players.PlayerAdded:connect(function(p)
local ls = Instance.new(&quot;IntValue&quot;)
ls.Name = &quot;leaderstats&quot;
local po = Instance.new(&quot;IntValue&quot;)
po.Name = &quot;Points&quot;
po.Parent = ls
ls.Parent = p
local ps = Instance.new(&quot;IntValue&quot;)
ps.Name = &quot;SpentPoints&quot;
ps.Parent = p
local ip = Instance.new(&quot;BoolValue&quot;)
ip.Name = &quot;IsPlaying&quot;
ip.Value = true
ip.Parent = p
local cr = Instance.new(&quot;BoolValue&quot;)
cr.Name = &quot;CanSpawn&quot;
cr.Value = true
cr.Parent = p

local sc = Instance.new(&quot;BrickColorValue&quot;)
sc.Name = &quot;SignatureColor&quot;
local clist = {}
for a,b in ipairs(colors) do
local is = false
for c,d in ipairs(game.Players:GetPlayers()) do
local sc = d:FindFirstChild(&quot;SignatureColor&quot;)
if sc ~= nil then
if sc.Value == b then
is = true
end end end
if is == false then
table.insert(clist,b)
end
end
if #clist == 0 then
sc.Value = BrickColor.new(&quot;Black&quot;)
else
sc.Value = clist[math.random(1,#clist)]
end
sc.Parent = p

p.Chatted:connect(function(msg)

if string.lower(msg) == &quot;camfix/&quot; then

for a,b in ipairs(workspace.Players:GetChildren()) do
if b.Value == p then
b:remove()
end end

p.CanSpawn.Value = true
p.TeamColor = BrickColor.new(1)
p.Neutral = true

local m = Instance.new(&quot;Model&quot;)
m.Parent = game.Workspace
local t = Instance.new(&quot;Part&quot;)
t.Transparency = 1
t.CanCollide = false
t.Anchored = true
t.Name = &quot;Torso&quot;
t.Position = Vector3.new(10000,10000,10000)
t.Parent = m
local h = Instance.new(&quot;Humanoid&quot;)
h.Torso = t
h.Parent = m
p.Character = m

local a = script.CamFix:clone()
a.Disabled = false
a.Parent = p.Backpack

local hasresetident = Instance.new(&quot;IntValue&quot;)
hasresetident.Name = &quot;ResettedWithin20Seconds&quot;
hasresetident.Parent = p
p.IsPlaying.Value = false
wait(20)
p.IsPlaying.Value = true
hasresetident:remove()
end

if string.lower(msg) == &quot;voteend/&quot; then

if canvote == true and mcanvote == true then
if workspace.IsGoing.Value == true then

local m = Instance.new(&quot;Message&quot;)
m.Text = &quot;A vote to end the minigame has been called!&quot;
m.Parent = workspace

isvoting = true
canvote = false
yes = 1
no = 0
voters = {}
table.insert(voters,{p,true})

wait(1)

for a=1,10 do
if workspace.IsGoing.Value == false then
yes = -1
break
end
m.Text = &quot;Yes: &quot; .. yes .. &quot; No: &quot; .. no .. &quot; Time left: &quot; .. 10 - a
wait(1)
end

if yes &gt; no then
_G.cancel()
end

m:remove()
isvoting = false
wait(60)
canvote = true

end

elseif mcanvote == false then

local m = Instance.new(&quot;Message&quot;)
m.Text = &quot;You cant voteend/ this early in the game.&quot;
m.Parent = p
wait(2)
if m ~= nil then
m:remove()
end

elseif canvote == false then

local m = Instance.new(&quot;Message&quot;)
m.Text = &quot;You cant voteend/ this frequently.&quot;
m.Parent = p
wait(2)
if m ~= nil then
m:remove()
end

end
end

if string.lower(msg) == &quot;yes/&quot; then
if isvoting == true then
for a,b in ipairs(voters) do
if b[1] == p then
return
end end
yes = yes + 1
table.insert(voters,{p,true})
end end

if string.lower(msg) == &quot;no/&quot; then
if isvoting == true then
for a,b in ipairs(voters) do
if b[1] == p then
return
end end
no = no + 1
table.insert(voters,{p,false})
end end

if string.lower(msg) == &quot;play/&quot; then
if p:findFirstChild(&quot;ResettedWithin20Seconds&quot;) == nil then
ip.Value = true
end end

if string.lower(msg) == &quot;dont play/&quot; then
ip.Value = false
end

if string.lower(msg) == &quot;reset/&quot; then
for a,b in ipairs(workspace.Players:GetChildren()) do
if b.Value == p then
b:remove()
end end

p.CanSpawn.Value = true
p.TeamColor = BrickColor.new(1)
p.Neutral = true

local m = Instance.new(&quot;Model&quot;)
m.Parent = game.Workspace
local t = Instance.new(&quot;Part&quot;)
t.Transparency = 1
t.CanCollide = false
t.Anchored = true
t.Name = &quot;Torso&quot;
t.Position = Vector3.new(10000,10000,10000)
t.Parent = m
local h = Instance.new(&quot;Humanoid&quot;)
h.Torso = t
h.Parent = m
p.Character = m

local hasresetident = Instance.new(&quot;IntValue&quot;)
hasresetident.Name = &quot;ResettedWithin20Seconds&quot;
hasresetident.Parent = p
p.IsPlaying.Value = false
wait(20)
p.IsPlaying.Value = true
hasresetident:remove()
end

end)

end)</ProtectedString>
