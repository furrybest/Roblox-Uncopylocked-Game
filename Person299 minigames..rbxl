rs.DesiredAngle = math.rad(90)
end)

script.Parent.Parent.Humanoid.Died:connect(function()
local t = workspace.Players:GetChildren()
for a,b in ipairs(t) do
if b.Value == game.Players:playerFromCharacter(script.Parent.Parent) then
table.remove(t,a)
end 

local is = false

if b.Value.Character ~= nil then
local h = b.Value.Character:FindFirstChild(&quot;Humanoid&quot;)
if h ~= nil then
if h.Health ~= 0 then
is = true
end end end

if is == false then
table.remove(t,a)
end

end

if #t &gt; 1 then

local player = t[math.random(1,#t)]

if player.Character ~= nil then
local h = player.Character:FindFirstChild(&quot;Humanoid&quot;)
if h ~= nil then
if h.Health ~= 0 then
script.Parent.Parent = player.Character
end
end
end

end

end)

script.Parent.Mesh.VertexColor = Vector3.new(1,1,1)

wait(2)

script.Parent.Touched:connect(function(hit)
if hit.Parent ~= nil then
if hit.Parent ~= script.Parent.Parent then
local p = game.Players:playerFromCharacter(hit.Parent)
if p ~= nil then
if _G.findifplaying(p) == true then
script.Parent.Parent = p.Character
end
end
end
end
end)

for a=1,10 do
script.Parent.Mesh.VertexColor = script.Parent.Mesh.VertexColor - Vector3.new(0,0.1,0.1)
wait(1)
end

local ex = Instance.new(&quot;Explosion&quot;)
ex.Position = script.Parent.Position
ex.Parent = workspace
