							<Item class="Script" referent="RBX592">
								<Properties>
									<bool name="Disabled">false</bool>
									<Content name="LinkedSource"><null></null></Content>
									<string name="Name">turning</string>
									<ProtectedString name="Source">while true do
wait(2.5)

if (script.Parent.Position - workspace.WaitingRoom.Floor.Position).magnitude &gt;= 1000 then
script.Parent.Parent.CanControl.Value = false
script.Parent.BodyGyro.cframe = CFrame.new(script.Parent.Position,workspace.WaitingRoom.Floor.Position)
script.Parent.BodyGyro.maxTorque = Vector3.new(1000,1000,1000)

if (script.Parent.Position - workspace.WaitingRoom.Floor.Position).magnitude &gt;= 2000 then
ex = Instance.new(&quot;Explosion&quot;)
ex.Position = script.Parent.Position
ex.Parent = workspace
end

else
script.Parent.Parent.CanControl.Value = true
end

end </ProtectedString>
									<bool name="archivable">true</bool>
								</Properties>
							</Item>
