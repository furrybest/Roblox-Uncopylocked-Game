						<ProtectedString name="Source">--Initiation
table.insert(_G.GameObjects,script)
script.Name = &quot;GameScript&quot;
gamemodel = game.Lighting.GameModels.Game5Model:clone()
table.insert(_G.GameObjects,gamemodel)
gamemodel.Name = &quot;GameModel&quot;
pbu = gamemodel.Block:clone()
pbu.Locked = false
gamemodel.Block:remove()
gamemodel.Parent = workspace
gamepoints = 35
workspace.WaitingRoom.South.Value = false

team1 = Instance.new(&quot;Team&quot;)
team1.TeamColor = BrickColor.new(21)
team1.Name = &quot;Red Team&quot;
team1.AutoAssignable = false
team1.Parent = game.Teams

team2 = Instance.new(&quot;Team&quot;)
team2.TeamColor = BrickColor.new(23)
team2.Name = &quot;Blue Team&quot;
team2.AutoAssignable = false
team2.Parent = game.Teams

isbuild = true

--Functions

function oc(msg,speaker)

if isbuild == false then
return
end

if string.sub(string.lower(msg),1,5) == &quot;part/&quot; then
local t = {}
for a=6,string.len(msg) do
if string.sub(msg,a,a) == &quot;/&quot; then
table.insert(t,a)
end
end
if #t ~= 2 then
return
end
local i1 = tonumber(string.sub(msg,6,t[1] - 1))
local i2 = tonumber(string.sub(msg,t[1] + 1,t[2] - 1))
local i3 = tonumber(string.sub(msg,t[2] + 1))
if i1 &gt; 5 then
i1 = 5
end
if i2 &gt; 5 then
i2 = 5
end
if i3 &gt; 5 then
i3 = 5
end
local a = pbu:clone()
a.Size = Vector3.new(i1,i2,i3)
if speaker.TeamColor == team1.TeamColor then
a.BrickColor = BrickColor.new(101)
a.CFrame = gamemodel.RedFloor.CFrame + Vector3.new(0,70,0)
else
a.BrickColor = BrickColor.new(107)
a.CFrame = gamemodel.BlueFloor.CFrame + Vector3.new(0,70,0)
end
a.Parent = gamemodel
table.insert(_G.GameObjects,a)
end
end

function _G.cancel()

hascancelled = true

workspace.WaitingRoom.South.Value = true

for a,b in ipairs(_G.GameObjects) do
if b ~= script then
b:remove()
end end

_G.removelocalparts()
_G.killall()
_G.makeneutral()

workspace.IsGoing.Value = false
script:remove()

end

function checkwin()

if hascancelled == true then return end

local team1list = {}
local team2list = {}
for a,b in ipairs(workspace.Players:GetChildren()) do
if b.Value.TeamColor == team1.TeamColor then
table.insert(team1list,b.Value)
elseif b.Value.TeamColor == team2.TeamColor then
table.insert(team2list,b.Value)
end end

if #team2list == 0 then
hasended = true
local m = Instance.new(&quot;Message&quot;)
table.insert(_G.GameObjects,m)
m.Text = &quot;Red Team Wins!&quot;
m.Parent = workspace
_G.killall()
_G.removetools()
_G.removelocalparts()
workspace.WaitingRoom.South.Value = true
for a,b in ipairs(game.Players:GetPlayers()) do
if b.TeamColor == team1.TeamColor then
b.leaderstats.Points.Value = b.leaderstats.Points.Value + (gamepoints * (_G.numonteam(team2.TeamColor) / _G.numonteam(team1.TeamColor)))
end end
_G.makeneutral()
wait(2)
for a,b in ipairs(_G.GameObjects) do
if b ~= script then
b:remove()
end end
workspace.IsGoing.Value = false
script:remove()
elseif #team1list == 0 then
hasended = true
local m = Instance.new(&quot;Message&quot;)
table.insert(_G.GameObjects,m)
m.Text = &quot;Blue Team Wins!&quot;
m.Parent = workspace
_G.killall()
_G.removetools()
_G.removelocalparts()
workspace.WaitingRoom.South.Value = true
for a,b in ipairs(game.Players:GetPlayers()) do
if b.TeamColor == team2.TeamColor then
b.leaderstats.Points.Value = b.leaderstats.Points.Value + (gamepoints * (_G.numonteam(team1.TeamColor) / _G.numonteam(team2.TeamColor)))
end end
_G.makeneutral()
wait(2)
for a,b in ipairs(_G.GameObjects) do
if b ~= script then
b:remove()
end end
workspace.IsGoing.Value = false
script:remove()
end

end

function assignteam(player)
local team1list = {}
local team2list = {}
for a,b in ipairs(game.Players:GetPlayers()) do
if b.TeamColor == team1.TeamColor then
table.insert(team1list,b)
elseif b.TeamColor == team2.TeamColor then
table.insert(team2list,b)
end end
local team = nil
if #team1list &gt; #team2list then
team = team2
elseif #team2list &gt; #team1list then
team = team1
elseif #team1list == #team2list then
if math.random(1,2) == 1 then
team = team1
else
team = team2
end
end
player.TeamColor = team.TeamColor
player.Neutral = false
return team
end

--Body

for n,p in ipairs(game.Players:GetPlayers()) do
local pinfo = _G.checkplayer(p)
if pinfo ~= 0 then

local team = assignteam(p)

local plane = nil

if team == team1 then

_G.teleportplayertobrick(pinfo[3],gamemodel.RedFloor)

elseif team == team2 then

_G.teleportplayertobrick(pinfo[3],gamemodel.BlueFloor)

end

local o = Instance.new(&quot;ObjectValue&quot;)
o.Value = p
o.Parent = workspace.Players

local hb = Instance.new(&quot;HopperBin&quot;)
table.insert(_G.GameObjects,hb)
hb.BinType = &quot;GameTool&quot;
hb.Parent = pinfo[5]

local hb = Instance.new(&quot;HopperBin&quot;)
table.insert(_G.GameObjects,hb)
hb.BinType = &quot;Clone&quot;
hb.Parent = pinfo[5]

pinfo[1].Chatted:connect(function(msg) oc(msg,pinfo[1]) end)

--_G.givetools(pinfo[5],game.Lighting.GameTools.Game5Tools:GetChildren())
pinfo[4].Died:connect(function() if hasended == nil then o:remove() end end)

local mes = Instance.new(&quot;Message&quot;)
table.insert(_G.GameObjects,mes)
mes.Text = &quot;Say part/xsize/ysize/zsize to create a part.&quot;
mes.Parent = pinfo[1]

coroutine.resume(coroutine.create(function()
wait(2)
mes:remove()
end))

end
end 

_G.checkifnone()

workspace.Players.ChildRemoved:connect(checkwin)

local a = pbu:clone()
a.Size = Vector3.new(5,5,5)
a.BrickColor = BrickColor.new(101)
a.CFrame = gamemodel.RedFloor.CFrame + Vector3.new(0,70,0)
a.Parent = gamemodel

local a = pbu:clone()
a.Size = Vector3.new(5,5,5)
a.BrickColor = BrickColor.new(107)
a.CFrame = gamemodel.BlueFloor.CFrame + Vector3.new(0,70,0)
a.Parent = gamemodel

workspace.ChildAdded:connect(function(p)
if p.className == &quot;Part&quot; then
if p.Name == &quot;Block&quot; then
p.Parent = gamemodel
p.CanCollide = true
end end end)

gamemodel.ChildAdded:connect(function(p)
if p.className == &quot;Part&quot; then
p.CanCollide = true
end end)

h = Instance.new(&quot;Hint&quot;)
table.insert(_G.GameObjects,h)
h.Parent = workspace
for n=1,60 do
h.Text = &quot;Time Left: &quot; .. 60 - n
wait(1)
end
h:remove()

isbuild = false

m = Instance.new(&quot;Message&quot;)
table.insert(_G.GameObjects,m)
m.Text = &quot;Fighting Time!&quot;
m.Parent = game.Workspace
wait(2.5)
m:remove()

_G.removetools()
for a,b in ipairs(gamemodel:GetChildren()) do
if b.Name == &quot;Block&quot; then
if b.className == &quot;Part&quot; then
b.Locked = true
b.CanCollide = false
b.CanCollide = true
end end end

for a,b in ipairs(workspace.Players:GetChildren()) do
game.Lighting.SpecialScripts.LockLocalParts:clone().Parent = b.Value.Backpack
end

coroutine.resume(coroutine.create(function()
for a=1,1020 do
gamemodel.Door.CFrame = gamemodel.Door.CFrame + Vector3.new(0,0.1,0)
wait(0.03)
end 
end))

for a,b in ipairs(workspace.Players:GetChildren()) do
_G.givetools(b.Value.Backpack,game.Lighting.GameTools.Game5Tools:GetChildren())
end
