							<Item class="Script" referent="RBX5150">
								<Properties>
									<bool name="Disabled">false</bool>
									<Content name="LinkedSource"><null></null></Content>
									<string name="Name">Script</string>
									<ProtectedString name="Source">reloadtime = 5
currenttime = 5

seat = script.Parent.Seat
barrel = script.Parent.Barrel
indicator = script.Parent.Indicator

isseated = false

indicator.ClickDetector.MouseClick:connect(function()

if isseated == true then
if currenttime &gt;= reloadtime then
currenttime = 0
indicator.BrickColor = BrickColor.new(&quot;Really red&quot;)

local cb = Instance.new(&quot;Part&quot;)
cb.Shape = &quot;Ball&quot;
cb.Size = Vector3.new(1,1,1)
cb.CFrame = barrel.CFrame + (barrel.CFrame.lookVector * 5)
cb.BrickColor = BrickColor.new(&quot;Really black&quot;)
cb.Velocity = barrel.CFrame.lookVector * 70
cb.TopSurface = &quot;Smooth&quot;
cb.BottomSurface = &quot;Smooth&quot;

local bf = Instance.new(&quot;BodyForce&quot;)
bf.force = Vector3.new(0,95,0)
bf.Parent = cb

cb.Parent = workspace

coroutine.resume(coroutine.create(function()
script.Parent.SmokePart.Smoke.Enabled = true
wait(0.5)
script.Parent.SmokePart.Smoke.Enabled = false
end))

local hashit = false

cb.Touched:connect(function(hit)
if hashit == true then return end
hashit = true
local h = hit.Parent:FindFirstChild(&quot;Health&quot;)
if h ~= nil then
h.Value = h.Value - 1
local e = Instance.new(&quot;Explosion&quot;)
e.Position = cb.Position
e.Parent = workspace
end 
cb:remove()
end)

end end

end)

seat.ChildAdded:connect(function(w)
if w.className == &quot;Weld&quot; then
isseated = true
end end)

seat.ChildRemoved:connect(function(w)
if w.className == &quot;Weld&quot; then
isseated = false
end end)


while true do
wait(2)
if isseated == true then
currenttime = currenttime + 1

if currenttime &gt;= reloadtime then
indicator.BrickColor = BrickColor.new(&quot;Bright green&quot;)
end

end end </ProtectedString>
									<bool name="archivable">true</bool>
								</Properties>
