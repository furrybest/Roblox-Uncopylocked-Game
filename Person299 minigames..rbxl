							<string name="Name">Splode</string>
							<ProtectedString name="Source">--[[script.Parent.Touched:connect(function(hit)
if hit.Parent ~= nil then
if hit:IsDescendantOf(script.Parent.Owner.Value) == false then
ex = Instance.new(&quot;Explosion&quot;)
ex.Position = script.Parent.Position
ex.BlastRadius = 10
ex.Parent = workspace
script.Parent:remove()
end end end)--]]

wait(3)
ex = Instance.new(&quot;Explosion&quot;)
ex.Position = script.Parent.Position
ex.BlastRadius = 13
ex.Parent = workspace
script.Parent:remove()</ProtectedString>
