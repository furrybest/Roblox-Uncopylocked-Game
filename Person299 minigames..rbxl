								<string name="Name">Script</string>
								<ProtectedString name="Source">wait(5)

targpos = script.Parent.Position.y + script.Parent.Size.y - 0.4

while true do
script.Parent.CFrame = script.Parent.CFrame + Vector3.new(0,0.2,0)
if script.Parent.Position.y &gt;= targpos then
break
end
wait()
end </ProtectedString>
