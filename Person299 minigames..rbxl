script:remove()
elseif #team1list == 0 then
hasended = true
local m = Instance.new(&quot;Message&quot;)
table.insert(_G.GameObjects,m)
m.Text = &quot;Blue Team Wins!&quot;
m.Parent = workspace
_G.killall()
_G.removetools()
workspace.WaitingRoom.South.Value = true
workspace.WaitingRoom.West.Value = true
workspace.WaitingRoom.East.Value = true
for a,b in ipairs(game.Players:GetPlayers()) do
if b.TeamColor == team2.TeamColor then
b.leaderstats.Points.Value = b.leaderstats.Points.Value + (gamepoints * (_G.numonteam(team1.TeamColor) / _G.numonteam(team2.TeamColor)))
end end
_G.makeneutral()
wait(2)
for a,b in ipairs(_G.GameObjects) do
if b ~= script then
b:remove()
end end
