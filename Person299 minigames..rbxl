				</Item>
				<Item class="Script" referent="RBX67">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">script.Parent.Parent.North.Changed:connect(function()
local it = &quot;NGlass&quot;
for i = 1,28 do
for a,b in ipairs(script.Parent.Parent:GetChildren()) do
if b.Name == it then
if script.Parent.Parent.North.Value == true then
b.Transparency = b.Transparency - 0.025
else
b.Transparency = b.Transparency + 0.025
end end end 
wait(0.06)
end 
for a,b in ipairs(script.Parent.Parent:GetChildren()) do
if b.Name == it then
if script.Parent.Parent.North.Value == true then
b.Transparency = 0
else
b.Transparency = 0.7
end end end end)

script.Parent.Parent.South.Changed:connect(function()
local it = &quot;SGlass&quot;
for i = 1,28 do
for a,b in ipairs(script.Parent.Parent:GetChildren()) do
if b.Name == it then
if script.Parent.Parent.South.Value == true then
b.Transparency = b.Transparency - 0.025
else
b.Transparency = b.Transparency + 0.025
end end end 
wait(0.06)
end 
for a,b in ipairs(script.Parent.Parent:GetChildren()) do
if b.Name == it then
if script.Parent.Parent.South.Value == true then
b.Transparency = 0
else
b.Transparency = 0.7
end end end end)

script.Parent.Parent.West.Changed:connect(function()
local it = &quot;WGlass&quot;
for i = 1,28 do
for a,b in ipairs(script.Parent.Parent:GetChildren()) do
if b.Name == it then
if script.Parent.Parent.West.Value == true then
b.Transparency = b.Transparency - 0.025
else
b.Transparency = b.Transparency + 0.025
end end end 
wait(0.06)
end 
for a,b in ipairs(script.Parent.Parent:GetChildren()) do
if b.Name == it then
if script.Parent.Parent.West.Value == true then
b.Transparency = 0
else
b.Transparency = 0.7
end end end end)

script.Parent.Parent.East.Changed:connect(function()
local it = &quot;EGlass&quot;
for i = 1,28 do
for a,b in ipairs(script.Parent.Parent:GetChildren()) do
if b.Name == it then
if script.Parent.Parent.East.Value == true then
b.Transparency = b.Transparency - 0.025
else
b.Transparency = b.Transparency + 0.025
end end end 
wait(0.06)
end 
for a,b in ipairs(script.Parent.Parent:GetChildren()) do
if b.Name == it then
if script.Parent.Parent.East.Value == true then
b.Transparency = 0
else
b.Transparency = 0.7
end end end end)

script.Parent.Parent.North.Value = true
script.Parent.Parent.South.Value = true
script.Parent.Parent.West.Value = true
script.Parent.Parent.East.Value = true





