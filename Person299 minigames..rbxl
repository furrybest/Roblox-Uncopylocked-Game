			<Item class="Script" referent="RBX17">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Shop</string>
					<ProtectedString name="Source">cost = 150

game.Players.PlayerAdded:connect(function(p)
p.Chatted:connect(function(msg)

if string.lower(msg) == &quot;unspentpoints/&quot; then
local m = Instance.new(&quot;Hint&quot;)
m.Text = &quot;You currently have &quot; .. p.leaderstats.Points.Value - p.SpentPoints.Value .. &quot; unspent points.&quot;
m.Parent = p.PlayerGui
wait(2)
m:remove()
return
end

if string.sub(string.lower(msg),1,17) == &quot;buy/nextminigame/&quot; then

local pgames = {}

for a,b in ipairs(_G.games) do
if string.find(string.lower(b),string.sub(string.lower(msg),18)) == 1 then
local can = true
for c,d in ipairs(_G.dontplay) do
if d == a then
can = false
end end

if can == true then
table.insert(pgames,{a,b})
end
end
end


if #pgames &gt; 1 then
local m = Instance.new(&quot;Hint&quot;)
m.Text = &quot;That name is ambiguous.&quot;
m.Parent = p.PlayerGui
wait(2)
m:remove()
return
elseif #pgames == 0 then
local m = Instance.new(&quot;Hint&quot;)
m.Text = &quot;That name is not found.&quot;
m.Parent = p.PlayerGui
wait(2)
m:remove()
return
elseif #pgames == 1 then
if p.leaderstats.Points.Value - p.SpentPoints.Value &gt;= cost then
p.SpentPoints.Value = p.SpentPoints.Value + cost
table.insert(_G.nextboughtgame,pgames[1][1])
local m = Instance.new(&quot;Hint&quot;)
m.Text = pgames[1][2] .. &quot; has been bought for &quot; .. cost .. &quot;.&quot;
m.Parent = p.PlayerGui
wait(2)
m.Text = &quot;You now have &quot; .. p.leaderstats.Points.Value - p.SpentPoints.Value .. &quot; unspent points left.&quot;
wait(2)
m:remove()
return
else
local m = Instance.new(&quot;Hint&quot;)
m.Text = cost .. &quot; unspent points are required, you have &quot; .. p.leaderstats.Points.Value - p.SpentPoints.Value .. &quot;.&quot;
m.Parent = p.PlayerGui
wait(2)
m:remove()
return
end
end

end

end)
end)</ProtectedString>
