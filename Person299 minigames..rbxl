					<Item class="Script" referent="RBX1203">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script</string>
							<ProtectedString name="Source">script.Parent.BodyPosition.position = script.Parent.Position
wait(3)
script.Parent.Anchored = false 

current = Vector3.new(0,0,0)

while true do
destination = Vector3.new(math.random(-20,20) / 10,math.random(-20,20) / 10,math.random(-20,20) / 10)
--destination = Vector3.new(string.sub(math.random(-15,15) / 10,1,3),string.sub(math.random(-15,15) / 10,1,3),string.sub(math.random(-15,15) / 10,1,3))

--destination = Vector3.new(tonumber(string.sub(tostring(destination.x),1,3)),tonumber(string.sub(tostring(destination.y),1,3)),tonumber(string.sub(tostring(destination.z),1,3)))

--print(destination)

while true do

move = false

if current.x &gt; destination.x then
current = current - Vector3.new( 0.1,0,0)
move = true
if current.x &lt; destination.x then
move = false
end
elseif current.x &lt; destination.x then
current = current + Vector3.new(0.1,0,0)
move = true
if current.x &gt; destination.x then
move = false
end
end

if current.y &gt; destination.y then
current = current - Vector3.new(0,0.1,0)
move = true
if current.y &lt; destination.y then
move = false
end
elseif current.y &lt; destination.y then
current = current + Vector3.new(0,0.1,0)
move = true
if current.y &gt; destination.y then
move = false
end
end

if current.z &gt; destination.z then
current = current - Vector3.new(0,0,0.1)
move = true
if current.z &lt; destination.z then
move = false
end
elseif current.z &lt; destination.z then
current = current + Vector3.new(0,0,0.1)
move = true
if current.z &gt; destination.z then
move = false
end
end

script.Parent.RotVelocity = current

wait(0.2)

if move == false then
break
end

end 

end </ProtectedString>
							<bool name="archivable">true</bool>
						</Properties>
