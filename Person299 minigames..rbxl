			<Item class="Script" referent="RBX13">
				<Properties>
					<bool name="Disabled">true</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Spectate</string>
					<ProtectedString name="Source">playerlist = {}

function text(text,parent,duration,type)
coroutine.resume(coroutine.create(function()
local m = Instance.new(type)
m.Text = text
m.Parent = parent
wait(duration)
if m ~= nil then
m:remove()
end 
end))
end

function findguy(name,speaker)
local cnum = 0
local char = nil
for a,b in ipairs(game.Players:GetChildren()) do
if b.className == &quot;Player&quot; then
if string.find(string.lower(b.Name),string.lower(name)) == 1 then
if b ~= speaker then
char = b
cnum = cnum + 1
end end end end
if cnum == 1 then
return char 
elseif cnum == 0 then
text(&quot;That name is not found.&quot;,speaker,1,&quot;Message&quot;)
return 0
elseif cnum &gt; 1 then
text(&quot;That name is ambiguous.&quot;,speaker,1,&quot;Message&quot;)
return 0
end
end


game.Players.PlayerAdded:connect(function(p)

p.Chatted:connect(function(msg)

if string.lower(msg) == &quot;unspectate/&quot; then
if playerlist[p.Name] ~= nil then
if p.Character ~= nil then
local h = p.Character:FindFirstChild(&quot;Humanoid&quot;)
if h ~= nil then
local ce = script.CamEdit:clone()
ce.Disabled = false
ce.Parent = p.Backpack
ce.DObject.Value = p.Name
playerlist[p.Name] = nil
end
end
end
end

if string.sub(string.lower(msg),1,9) == &quot;spectate/&quot; then
if p.IsPlaying.Value == false then
local player = findguy(string.sub(msg,10),p)
if player ~= 0 then
if player.Character ~= nil then
local h = player.Character:FindFirstChild(&quot;Humanoid&quot;)
if h ~= nil then
local ce = script.CamEdit:clone()
ce.Disabled = false
ce.Parent = p.Backpack
ce.DObject.Value = player.Name
playerlist[p.Name] = p
end
end

end
end
end

end)
end)

workspace.IsGoing.Changed:connect(function()
for a,b in ipairs(playerlist) do
if b.IsPlaying.Value == true then

if b.Character ~= nil then
local h = b.Character:FindFirstChild(&quot;Humanoid&quot;)
if h ~= nil then
local ce = script.CamEdit:clone()
ce.Disabled = false
ce.Parent = b.Backpack
ce.DObject.Value = b.Name
table.remove(playerlist,a)
end
end

end
end

end)
