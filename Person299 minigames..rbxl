			<Item class="Script" referent="RBX16">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">OnDied</string>
					<ProtectedString name="Source">game.Players.PlayerAdded:connect(function(p)
p.Changed:connect(function(prop)
if prop == &quot;Character&quot; then
if p.Character ~= nil then

pcall(function()

local Character = p.Character

local h = Character:FindFirstChild(&quot;Humanoid&quot;)
if h ~= nil then

h.Died:connect(function()

local torso = Character:FindFirstChild(&quot;Torso&quot;)
if torso ~= nil and torso:FindFirstChild(&quot;IsDisconnected&quot;) == nil then

local tvel = torso.Velocity

torso.Name = &quot;NewTorso&quot;

for a,b in ipairs(torso:GetChildren()) do
if b.className == &quot;Motor&quot; then
b:remove()
end
end

local part = Character:FindFirstChild(&quot;Right Arm&quot;)

if part ~= nil and part:FindFirstChild(&quot;IsDisconnected&quot;) == nil then

local m = Instance.new(&quot;Glue&quot;)
