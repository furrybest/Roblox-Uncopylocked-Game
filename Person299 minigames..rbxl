				<Item class="Script" referent="RBX5564">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Infect</string>
						<ProtectedString name="Source">script.Parent.Humanoid.WalkSpeed = 21

local bc = script.Parent:findFirstChild(&quot;Body Colors&quot;)
if bc ~= nil then
bc.HeadColor = BrickColor.new(&quot;Medium green&quot;)
bc.RightArmColor = BrickColor.new(&quot;Medium green&quot;)
bc.LeftArmColor = BrickColor.new(&quot;Medium green&quot;)
bc.TorsoColor = BrickColor.new(&quot;Reddish brown&quot;)
bc.RightLegColor = BrickColor.new(&quot;Reddish brown&quot;)
bc.LeftLegColor = BrickColor.new(&quot;Reddish brown&quot;)

end 

function ot(hit)
if hit.Parent ~= nil then
local p = game.Players:playerFromCharacter(hit.Parent)
if p ~= nil then
if hit.Parent:FindFirstChild(&quot;Infect&quot;) == nil then
local is = false
for a,b in ipairs(workspace.Players:GetChildren()) do
if b.Value == p then
is = true
end end
if is == false then return end
script:clone().Parent = hit.Parent
p.TeamColor = BrickColor.new(&quot;Medium green&quot;)
end
end
end
end

function recolor(part)
if part.Name == &quot;Head&quot; or part.Name == &quot;Left Arm&quot; or part.Name == &quot;Right Arm&quot; then
part.BrickColor = BrickColor.new(&quot;Medium green&quot;)
wait(1.5)
if part.BrickColor ~= BrickColor.new(&quot;Medium green&quot;) then
recolor(part)
return
end
elseif part.Name == &quot;Torso&quot; or part.Name == &quot;Left Leg&quot; or part.Name == &quot;Right Leg&quot; then
part.BrickColor = BrickColor.new(&quot;Reddish brown&quot;)
wait(1.5)
if part.BrickColor ~= BrickColor.new(&quot;Reddish brown&quot;) then
recolor(part)
return
end
end
end

for a,b in ipairs(script.Parent:GetChildren()) do
if b.className == &quot;Part&quot; then
coroutine.resume(coroutine.create(function()
recolor(b)
end))
b.Touched:connect(ot)
end end 

--[[script.Parent.Torso[&quot;Right Shoulder&quot;].Changed:connect(function()
