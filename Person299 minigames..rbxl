									<Item class="Script" referent="RBX4480">
										<Properties>
											<bool name="Disabled">false</bool>
											<Content name="LinkedSource"><null></null></Content>
											<string name="Name">turning</string>
											<ProtectedString name="Source">cantcontrol = false

while true do
wait(2.5)

if script.Parent.Position.y &lt; workspace.GameModel.Water.Position.y then
ex = Instance.new(&quot;Explosion&quot;)
ex.Position = script.Parent.Position
ex.Parent = workspace
end

if (script.Parent.Position - workspace.WaitingRoom.Floor.Position).magnitude &gt;= 1500 then
script.Parent.Parent.CanControl.Value = false
cantcontrol = true
script.Parent.BodyGyro.cframe = CFrame.new(script.Parent.Position,workspace.WaitingRoom.Floor.Position)
script.Parent.BodyGyro.maxTorque = Vector3.new(1000,1000,1000)

if (script.Parent.Position - workspace.WaitingRoom.Floor.Position).magnitude &gt;= 2000 then
ex = Instance.new(&quot;Explosion&quot;)
ex.Position = script.Parent.Position
ex.Parent = workspace
end

else

if cantcontrol == true then
script.Parent.Parent.CanControl.Value = true
cantcontrol = false
end

end

end </ProtectedString>
											<bool name="archivable">true</bool>
										</Properties>
									</Item>
									<Item class="Script" referent="RBX4481">
										<Properties>
											<bool name="Disabled">false</bool>
											<Content name="LinkedSource"><null></null></Content>
											<string name="Name">Script</string>
											<ProtectedString name="Source">pcall(function()
coroutine.resume(coroutine.create(function()

script.Parent.BodyGyro.cframe = script.Parent.CFrame

pt = game.Lighting.GameTools.Game16Tools.Plane:clone()
table.insert(_G.GameObjects,pt)

player = game.Players:playerFromCharacter(script.Parent.Parent.Parent.Parent)

ff = Instance.new(&quot;ForceField&quot;)
table.insert(_G.GameObjects,ff)
ff.Parent = script.Parent.Parent.Parent.Parent

for a=1,20 do
script.Parent.BodyGyro.cframe = script.Parent.BodyGyro.cframe * CFrame.fromEulerAnglesXYZ(math.rad(1),0,0)
wait(wait() * 3 )
end 

ff:remove()
pt.Parent = player.Backpack
end))
end)

for a=1,20 do
wait(wait() * 3)
end

workspace.GameModel.BCarrier.Used.Value = false </ProtectedString>
