								<Item class="BodyVelocity" referent="RBX1765">
									<Properties>
										<string name="Name">BodyVelocity</string>
										<float name="P">1250</float>
										<bool name="archivable">true</bool>
										<Vector3 name="maxForce">
											<X>8.99999949e+009</X>
											<Y>8.99999949e+009</Y>
											<Z>8.99999949e+009</Z>
										</Vector3>
