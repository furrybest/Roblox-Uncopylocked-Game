function ot(hit)
if hit.Parent ~= nil then
if game.Players:playerFromCharacter(hit.Parent) ~= nil and hit.Parent:findFirstChild(&quot;Torso&quot;) and hit.Parent:findFirstChild(&quot;Humanoid&quot;) then

local nc = game.Lighting.SpecialObjects.BurntCharacter:clone()
nc.CharName.Value = hit.Parent.Name
nc.LavaPosVal.Value = workspace.GameModel.LavaHeight
nc.Pos.Value = Vector3.new(hit.Parent.Torso.Position.x,workspace.GameModel.LavaHeight.Value,hit.Parent.Torso.Position.z)
nc.Parent = workspace.GameModel

nc.Pos.Value = hit.Parent.Torso.Position

for a,b in ipairs(hit.Parent:GetChildren()) do
if b.className == &quot;BodyColors&quot; or b.className == &quot;Pants&quot; or b.className == &quot;Shirt&quot; or b.className == &quot;ShirtGraphic&quot; then
b:clone().Parent = nc
end end

hit.Parent.Humanoid.Health = 0

for a,b in ipairs(hit.Parent:GetChildren()) do
if b.className == &quot;Part&quot; then
local acko = nc:findFirstChild(b.Name)
if acko ~= nil then
acko.BrickColor = b.BrickColor
end 
b:remove()
end end


end end end 

