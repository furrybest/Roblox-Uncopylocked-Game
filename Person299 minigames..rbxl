							<ProtectedString name="Source">ball = script.Parent

function onTouched(hit)
--local humanoid = hit.Parent:findFirstChild(&quot;Humanoid&quot;)

--if humanoid ~= nil then
--hit:breakJoints()
--end


local player = game.Players:playerFromCharacter(hit.Parent)
if player ~= nil then
if player.TeamColor ~= script.Parent.creator.Value.TeamColor then

local h = hit.Parent:FindFirstChild(&quot;Humanoid&quot;)
if h ~= nil then
h.Health = h.Health - 30
end

--hit:BreakJoints()
--hit.Velocity = script.Parent.Velocity / hit:getMass()
end
end 

connection:disconnect()
ball.Parent = nil
end

connection = ball.Touched:connect(onTouched)

wait(5)
ball.Parent = nil</ProtectedString>
