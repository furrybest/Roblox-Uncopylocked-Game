					<Item class="Script" referent="RBX5786">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script</string>
							<ProtectedString name="Source">Torso = script.Parent.Torso
Head = script.Parent.HeadModel
Head.Name = script.Parent.CharName.Value
Emitter = Torso.Emitter

plist = {}
clist = {}

for a,b in ipairs(script.Parent:GetChildren()) do
if b ~= Torso then
if b.className == &quot;Part&quot; then
table.insert(plist,b)
table.insert(clist,b.CFrame:toObjectSpace(Torso.CFrame))
end 
if b:findFirstChild(&quot;Head&quot;) then
table.insert(plist,b.Head)
table.insert(clist,b.Head.CFrame:toObjectSpace(Torso.CFrame))
end
end
end

randang = 75
Torso.CFrame = CFrame.fromEulerAnglesXYZ(math.rad(math.random(-randang,randang)),math.rad(math.random(-randang,randang)),math.rad(math.random(-randang,randang))) + script.Parent.Pos.Value

for a,b in ipairs(plist) do
b.CFrame = Torso.CFrame * clist[a]:inverse()
end 
Emitter.CFrame = CFrame.new(script.Parent.Pos.Value)
</ProtectedString>
							<bool name="archivable">true</bool>
