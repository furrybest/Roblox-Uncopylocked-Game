					<Item class="Script" referent="RBX2602">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script</string>
							<ProtectedString name="Source">script.Parent.Handle.Owner.Value = script.Parent.Parent.Parent.Character

script.Parent.Activated:connect(function()
local handle = script.Parent.Handle
local tcf = CFrame.new(handle.Position,script.Parent.Parent.Humanoid.TargetPoint)
local ss = script.Parent.Splode:clone()
ss.Disabled = false
ss.Parent = handle
handle.Parent = workspace
handle:BreakJoints()
--handle.CFrame = handle.CFrame + tcf.lookVector
handle.Velocity = tcf.lookVector * 150
handle.CanCollide = true
script.Parent:remove()
end)

</ProtectedString>
