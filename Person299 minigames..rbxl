					</Item>
					<Item class="Script" referent="RBX2611">
						<Properties>
							<bool name="Disabled">true</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">BallScript</string>
							<ProtectedString name="Source">script.Parent.BrickColor = BrickColor.new(&quot;Really red&quot;)

script.Parent.Touched:connect(function(hit)
if hit.Parent ~= nil then
local h = hit.Parent:FindFirstChild(&quot;Humanoid&quot;)
if h ~= nil then
if script.Parent.Velocity.magnitude &gt; 15 then
if hit.Parent ~= script.Parent.Owner.Value then
h.Health = 0
return
end end
if script.Parent.Velocity.magnitude &lt;= 15 then

local pl = game.Players:playerFromCharacter(hit.Parent)
if pl ~= nil then

local t = Instance.new(&quot;Tool&quot;)
t.Name = &quot;Dodgeball&quot;

local s = script:clone()
s.Disabled = true
s.Parent = t
local s = script.Parent.Script:clone()
s.Disabled = false
s.Parent = t

t.Parent = pl.Backpack

script.Parent.BrickColor = BrickColor.new(1)

script.Parent.Parent = t

end end


end end end)

wait(1)
script.Parent.Owner.Value = script.Parent

coroutine.resume(coroutine.create(function()
while true do
if script.Parent.Velocity.magnitude &gt;= 15 then
script.Parent.BrickColor = BrickColor.new(&quot;Really red&quot;)
else
script.Parent.BrickColor = BrickColor.new(1)
end
wait(0.5)
end end))</ProtectedString>
