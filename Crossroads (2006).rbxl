			<Item class="Script">
				<Properties>
					<bool name="Disabled">false</bool>
					<string name="Name">Regenerate Bunker</string>
					<string name="Source">model = game.Workspace.Bunker&#13;&#10;messageText = &quot;Regenerating Bunker...&quot;&#13;&#10;&#13;&#10;message = Instance.new(&quot;Message&quot;)&#13;&#10;message.Text = messageText&#13;&#10;backup = model:clone()&#13;&#10;&#13;&#10;while true do&#13;&#10;&#9;wait(script.Parent.RegenerationTime.Value*(1-math.random()*0.8))&#13;&#10;&#13;&#10;&#9;message.Parent = game.Workspace&#13;&#10;&#9;model:remove()&#13;&#10;&#13;&#10;&#9;wait(script.Parent.RegenerationDelay.Value)&#13;&#10;&#13;&#10;&#9;model = backup:clone()&#13;&#10;&#9;model.Parent = game.Workspace&#13;&#10;&#9;model:makeJoints()&#13;&#10;&#9;message.Parent = nil&#13;&#10;end&#13;&#10;</string>
					<bool name="archivable">true</bool>
				</Properties>
			</Item>
			<Item class="NumberValue">
				<Properties>
					<string name="Name">RegenerationTime</string>
					<float name="Value">800</float>
					<bool name="archivable">true</bool>
				</Properties>
			</Item>
			<Item class="NumberValue">
