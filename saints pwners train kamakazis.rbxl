				<Item class="Script" referent="RBX193">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">ShieldsUp</string>
						<string name="Source">teamColor = script.Parent.Color&#13;&#10;model = script.Parent&#13;&#10;&#13;&#10;function onTouched(part)&#13;&#10;&#9;local h = part.Parent:findFirstChild(&quot;Humanoid&quot;)&#13;&#10;&#9;if h~=nil then&#13;&#10;&#9;&#9;h.Torso.Color = teamColor&#13;&#10;&#9;&#9;h.Torso.Reflectance = 0.5&#13;&#10;&#9;&#9;h.LeftLeg.Color = teamColor&#13;&#10;&#9;&#9;h.LeftLeg.Reflectance = 0.5&#13;&#10;&#9;&#9;h.RightLeg.Color = teamColor&#13;&#10;&#9;&#9;h.RightLeg.Reflectance = 0.5&#13;&#10;&#9;&#9;h.MaxHealth = 100&#13;&#10;&#9;&#9;h.Health = 100&#13;&#10;&#9;&#9;backup = model:clone()&#13;&#10;&#9;&#9;script.Parent:remove()&#9;&#13;&#10;&#9;&#9;wait(30)&#13;&#10;&#9;&#9;model = backup:clone()&#13;&#10;&#9;&#9;model.Parent = game.Workspace&#13;&#10;&#9;&#9;model:makeJoints()&#13;&#10;&#9;end&#13;&#10;end&#13;&#10;&#13;&#10;script.Parent.Touched:connect(onTouched)</string>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
