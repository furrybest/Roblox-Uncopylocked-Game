				<Item class="Script" referent="RBX555">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">DoorScript</string>
						<string name="Source">print(&quot;One Way Door Script Loaded&quot;)&#13;&#10;&#13;&#10;Door = script.Parent.ButtonDoor&#13;&#10;Button = script.Parent.Button&#13;&#10;&#13;&#10;function onTouched(hit)&#13;&#10;&#9;&#13;&#10;&#9;&#9;print(&quot;Door Hit&quot;)&#13;&#10;&#9;&#9;Door.Transparency = 1&#13;&#10;&#9;&#9;Door.CanCollide = false&#13;&#10;&#13;&#10;end&#13;&#10;&#13;&#10;connection = Button.Touched:connect(onTouched)&#13;&#10;&#13;&#10;&#13;&#10;</string>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
