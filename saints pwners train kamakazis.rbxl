					<Item class="Script" referent="RBX581">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">TreeElevator</string>
							<string name="Source">&#13;&#10;local bodypos = script.Parent.BodyPosition&#13;&#10;script.Parent.BodyGyro.cframe = script.Parent.CFrame&#13;&#10;&#13;&#10;local down_pos = script.Parent.Position -- use relative positioning so that we can move the tree around and not mess things up&#13;&#10;local up_pos = Vector3.new(down_pos.x, down_pos.y + 67.2, down_pos.z)&#13;&#10;&#13;&#10;&#13;&#10;bodypos.position = down_pos&#13;&#10;&#13;&#10;local debounce = false&#13;&#10;&#13;&#10;local isDown = true&#13;&#10;&#13;&#10;function onTouched(hit)&#13;&#10;&#9;local humanoid = hit.Parent:findFirstChild(&quot;Humanoid&quot;)&#13;&#10;&#9;if humanoid~=nil and debounce == false then&#13;&#10;&#9;&#9;debounce = true&#13;&#10;&#13;&#10;&#9;&#9;script.Parent.BrickColor = BrickColor.new(21)&#13;&#10;&#9;&#9;wait(2)&#13;&#10;&#13;&#10;&#9;&#9;if isDown == true then &#13;&#10;&#9;&#9;&#9;-- going up&#13;&#10;&#9;&#9;&#9;bodypos.position = up_pos&#13;&#10;&#9;&#9;&#9;isDown = false&#13;&#10;&#9;&#9;end&#13;&#10;&#13;&#10;&#9;&#9;wait(10)&#13;&#10;&#13;&#10;&#9;&#9;-- going down&#13;&#10;&#9;&#9;bodypos.position = down_pos&#13;&#10;&#9;&#9;isDown = true&#13;&#10;&#9;&#9;wait(4)&#13;&#10;&#13;&#10;&#9;&#9;debounce = false&#13;&#10;&#9;&#9;script.Parent.BrickColor = BrickColor.new(106)&#13;&#10;&#9;end&#13;&#10;end&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;script.Parent.Touched:connect(onTouched)&#13;&#10;&#13;&#10;</string>
							<bool name="archivable">true</bool>
						</Properties>
					</Item>
					<Item class="BodyGyro" referent="RBX582">
						<Properties>
							<float name="D">1000</float>
							<string name="Name">BodyGyro</string>
							<float name="P">3000</float>
							<bool name="archivable">true</bool>
							<CoordinateFrame name="cframe">
								<X>-70.6110001</X>
								<Y>2.3939333</Y>
								<Z>91.6116638</Z>
								<R00>-1</R00>
								<R01>2.2907956e-020</R01>
								<R02>1.14426172e-020</R02>
