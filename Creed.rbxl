				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">HintChanger</string>
				<ProtectedString name="Source">h = Instance.new(&quot;Hint&quot;)
h.Parent = game.Workspace 

while true do
h.Text = &quot;Welcome to Assassin&apos;s Creed Roleplay&quot;
wait(10) 
h.Text = &quot;Vip is 10 Tix&quot; 
wait(10)
h.Text = &quot;Follow the ROBLOX rules and have fun!&quot;
wait(10)  
end


</ProtectedString>
			</Properties>
