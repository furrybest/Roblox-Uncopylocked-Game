		<Item class="Script" referent="RBX22">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">VipGiver</string>
				<ProtectedString name="Source">permission = { &quot;&quot; }
texture = &quot;http://www.roblox.com/asset/?id=28486002&quot;

function checkOkToLetIn(name)
 for i = 1,#permission do
  if (string.upper(name) == string.upper(permission[i])) then return true end
 end
 return false
end

function onPlayerEntered(newPlayer)
 wait(2)
 local human = newPlayer.Character:findFirstChild(&quot;Humanoid&quot;)
 weapons = game.Lighting:getChildren()
 if (human ~= nil ) then
  if (checkOkToLetIn(human.Parent.Name)) or newPlayer.Character:findFirstChild(&quot;Torso&quot;):findFirstChild(&quot;roblox&quot;).Texture == texture then
   for i = 1, #weapons do
    if weapons[i].className == &quot;Tool&quot; or weapons[i].className == &quot;HopperBin&quot; then
     weapons[i]:clone().Parent = newPlayer.StarterGear
     weapons[i]:clone().Parent = newPlayer.Backpack
    end
   end
  end
 end
end

game.Players.ChildAdded:connect(onPlayerEntered)</ProtectedString>
			</Properties>
		</Item>
