				<ProtectedString name="Source">model= game.Workspace.Scenery
messageText = &quot;Regenerating Scenery...&quot;

message = Instance.new(&quot;Message&quot;)
message.Text = messageText
backup = model:clone()

while true do
&#9;wait(1000) -- regenerate this model every 300 seconds

&#9;message.Parent = game.Workspace
&#9;model:remove()

&#9;wait(4) -- display regen message for 4 seconds

&#9;model = backup:clone()
&#9;model.Parent = game.Workspace
&#9;model:makeJoints()
&#9;message.Parent = nil
end</ProtectedString>
