				<Item class="Script" referent="RBX31">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<string name="Source">system = script.Parent
model = system.Plane
backup = model:Clone()
regen = system.Regen

function checkRegen()
	if regen.Value == 1 then
		model = backup:Clone()
		model.Parent = system
		model:MakeJoints()
	end
end
regen.Changed:connect(checkRegen)</string>
