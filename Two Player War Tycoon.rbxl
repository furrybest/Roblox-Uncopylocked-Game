							<string name="Name">Reset</string>
							<ProtectedString name="Source">-- Roblox Reset Gui Theme by nairod7 --

function onButtonClicked()

script.Parent.Parent.bar.ZIndex = 2
script.Parent.Parent.barRed.ZIndex = 3
script.Parent.Parent.Parent.Parent.Parent.Character.Humanoid.Health = 0
script.Parent.Parent.Parent.Parent.Parent.Character.Torso:remove()

end

