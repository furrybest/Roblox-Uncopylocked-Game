points=10000 --Change this amount to how many KO&apos;s you want for the badge..
name = &quot;Cash&quot; --Change this to the name of the Currency in the leaderboard.



--Dont mess with this below.
game.Players.ChildAdded:connect(function(player) wait(1) player.leaderstats[name].Changed:connect(function(type) if player.leaderstats[name].Value == points then game:GetService(&quot;BadgeService&quot;):AwardBadge(player.userId,badgeId) end end) end) 
