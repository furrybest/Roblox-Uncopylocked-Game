		<Item class="Script" referent="RBX867">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">T-Shirt Badge Awarder</string>
				<ProtectedString name="Source">BadgeID = 56308595  --&gt;Badge ID
Texture = &quot;http://www.roblox.com/asset/?id=56308462&quot; --&gt;T-Shirt texture here
game.Players.PlayerAdded:connect(function(p) 
wait(5)
if p.Character.Torso.roblox.Texture == Texture then 
game:GetService(&quot;BadgeService&quot;):AwardBadge(p.userId,BadgeID) 
end 
end) </ProtectedString>
			</Properties>
		</Item>
		<Item class="Script" referent="RBX868">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Give VIP</string>
				<ProtectedString name="Source">--Read all the green stuff.
--Next step, making a badge have

--Please tell me if it doesn&apos;t work.  No, I don&apos;t want you to fix it for me.  I would like to let everybody know that I used free models and the wiki as guides for this.
--YES, I did make this,  I just learned how by studying free models because this is my first script that calls a service.
--For people learning to script, (like me) the wiki helps.  If you can&apos;t find what you need there, use the forum.  There are tons of scripters willing to help.


--Take out the &quot;--&quot;s of the two below.

vip = &quot;http://www.roblox.com/asset/?id=56308462&quot;
badge = 56308595

function NP(n)
character = game.Workspace.FindFirstChild(n.Name)
wait(5)
if character ~= nil then
if character.Torso:FindFirstChild(&quot;roblox&quot;) ~= nil then
if character.Torso.roblox.Texture = vip then
getbadge = game:GetService(&quot;BadgeService&quot;)
getbadge:AwardBadge(n.userId, badge)
end end end end 

game.Players.ChildAdded:connect(NP)

--To find a T-Shirt ID, you need to go into solo mode wearing the T-Shirt and find yourself then open your torso.  The texture will look like a URL. Copy and paste it.


--Do not copy this.  By that I mean don&apos;t take this and give no credit.



--4thgradedre
--No, I&apos;m not in 4th grade.  This is a 3 year vet. I&apos;m in 7th.</ProtectedString>
			</Properties>
		</Item>
