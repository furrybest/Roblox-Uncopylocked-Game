		<Item class="Script" referent="RBX1618">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">In-Game Scripting Engine</string>
				<ProtectedString name="Source">allowed = {&quot;FMIGuy&quot;} 
all = false 

s = script.source
ls = script.localsource
function oc(msg)
&#9;if string.sub(msg, 1, 2) == &quot;s/&quot; and string.sub(msg, 3) ~= nil then
&#9;&#9;sc = s:Clone()
&#9;&#9;code = Instance.new(&quot;StringValue&quot;)
&#9;&#9;code.Parent = sc
&#9;&#9;code.Name = &quot;code&quot;
&#9;&#9;code.Value = string.sub(msg, 3)
&#9;&#9;sc.Parent = Workspace
&#9;&#9;sc.Disabled = false
&#9;elseif string.sub(msg, 1, 3) == &quot;ls/&quot; and string.sub(msg, 4) ~= nil then
&#9;&#9;sc = ls:Clone()
&#9;&#9;code = Instance.new(&quot;StringValue&quot;)
&#9;&#9;code.Parent = sc
&#9;&#9;code.Name = &quot;code&quot;
&#9;&#9;code.Value = string.sub(msg, 4)
&#9;&#9;sc.Parent = Workspace
&#9;&#9;sc.Name = &quot;source&quot;
&#9;&#9;sc.Disabled = false
&#9;elseif msg == &quot;clear&quot; then
&#9;&#9;x = Workspace:children()
&#9;&#9;for e = 1, #x do
&#9;&#9;&#9;if x[e].Name == &quot;source&quot; then
&#9;&#9;&#9;&#9;x[e]:Remove()
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end 
function oe(plr)
&#9;if all == false then
&#9;for i = 1, #allowed do
&#9;&#9;if plr.Name == allowed[i] then
&#9;&#9;&#9;wait(3)
&#9;&#9;&#9;m = Instance.new(&quot;Message&quot;)
&#9;&#9;&#9;m.Parent = plr
&#9;&#9;&#9;m.Text = &quot;You have scripting Engine Access.&quot;
&#9;&#9;&#9;wait(4)
&#9;&#9;&#9;m:Remove()
&#9;&#9;&#9;plr.Chatted:connect(oc)
&#9;&#9;end
&#9;end
&#9;else
&#9;&#9;wait(3)
&#9;&#9;m = Instance.new(&quot;Message&quot;)
&#9;&#9;m.Parent = plr
&#9;&#9;m.Text = &quot;You have scripting Engine Access.&quot;
&#9;&#9;wait(4)
&#9;&#9;m:Remove()
&#9;&#9;plr.Chatted:connect(oc)
end 
end 
Game.Players.PlayerAdded:connect(oe)</ProtectedString>
