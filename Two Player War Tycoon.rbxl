						<ProtectedString name="Source">tool = game.Lighting:findFirstChild(&quot;CaneSword&quot;) --Change IronSword to the name of the Tool/HopperBin and make sure the Tool/HopperBin is in Lighting.
cost = 50  --Change 250 to whatever you want the Weapon to cost.
--Mess with anything below this point at your own risk.
button = script.Parent
button.BrickColor = BrickColor.Green()

function onTouched(hit)
if button.BrickColor == BrickColor.Green()  then
hp = hit.Parent
hu = hp:findFirstChild(&quot;Humanoid&quot;)
if hu ~= nil then
pc = game.Players:GetPlayerFromCharacter(hp)
c = pc.leaderstats.KOs -- Change Gold to what currency your using.
if c.Value &gt;= cost then
button.BrickColor = BrickColor.Red()
c.Value = c.Value - 50
tool:clone().Parent = pc.Backpack
tool:clone().Parent = pc.StarterGear
wait(3)
button.BrickColor = BrickColor.Green()
end
end
end
end
button.Touched:connect(onTouched)</ProtectedString>
