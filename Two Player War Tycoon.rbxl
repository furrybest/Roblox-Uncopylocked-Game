				<Item class="Script" referent="RBX2723">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">tool = game.Lighting:findFirstChild(&quot;rssw&quot;) --Change IronSword to the name of the Tool/HopperBin and make sure the Tool/HopperBin is in Lighting.
cost = 12  --Change 250 to whatever you want the Weapon to cost.
--Mess with anything below this point at your own risk.
button = script.Parent
button.BrickColor = BrickColor.Green()

function onTouched(hit)
if button.BrickColor == BrickColor.Green()  then
hp = hit.Parent
hu = hp:findFirstChild(&quot;Humanoid&quot;)
if hu ~= nil then
pc = game.Players:GetPlayerFromCharacter(hp)
c = pc.leaderstats.KOs -- Change Gold to what currency your using.
if c.Value &gt;= cost then
button.BrickColor = BrickColor.Red()
c.Value = c.Value - 12
tool:clone().Parent = pc.Backpack
tool:clone().Parent = pc.StarterGear
wait(3)
button.BrickColor = BrickColor.Green()
end
end
end
end
button.Touched:connect(onTouched)</ProtectedString>
					</Properties>
				</Item>
			</Item>
			<Item class="Humanoid" referent="RBX2724">
				<Properties>
					<float name="Health">0</float>
					<float name="MaxHealth">0</float>
					<string name="Name">Humanoid</string>
