				<Item class="Script" referent="RBX1682">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">force field giver</string>
						<ProtectedString name="Source">local debounce = false 
function onTouched(part)
&#9;local h = part.Parent:findFirstChild(&quot;Humanoid&quot;)
&#9;if h~=nil and debounce == false then
&#9;&#9;debounce = true
&#9;&#9;Field = Instance.new(&quot;ForceField&quot;)
&#9;&#9;Field.Parent = part.Parent
&#9;&#9;wait(.4)
&#9;&#9;debounce = false
&#9;end
end

if (script.Parent ~= nil) and (script.Parent.className == &quot;Part&quot;) then 
&#9;connection = script.Parent.Touched:connect(onTouched)
end
</ProtectedString>
					</Properties>
