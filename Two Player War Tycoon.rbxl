						<string name="Name">IncomeDisplay</string>
						<ProtectedString name="Source">local owner = script.Parent.OwnerName
local speed = script.Speed

function Do()
while true do
wait(speed.Value)
local player = game.Players:findFirstChild(owner.Value)
if player ~= nil then
player.leaderstats.Cash.Value = player.leaderstats.Cash.Value + script.Parent.Income.Value
end
end
end

Do()</ProtectedString>
