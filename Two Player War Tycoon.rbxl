p.Material=&quot;Concrete&quot;
p.Size=Vector3.new(1,1,1)
p.Parent=m
me=Instance.new(&quot;CylinderMesh&quot;)
me.Scale=Vector3.new(0.5,0.15,0.5)
me.Parent=p
w=Instance.new(&quot;Weld&quot;)
