&#9;&#9;&#9;c.Name=&quot;creator&quot;
&#9;&#9;&#9;c.Value=Player
&#9;&#9;&#9;c.Parent=h
&#9;&#9;&#9;game:GetService(&quot;Debris&quot;):AddItem(c,.5)
