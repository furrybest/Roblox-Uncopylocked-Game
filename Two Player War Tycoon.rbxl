		<Item class="Script" referent="RBX1240">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Cash badge script</string>
				<ProtectedString name="Source">local BadgeID = 49839754 -- the badge id
local Cash = &quot;KOs&quot; -- your tycoon currency of money
local HowMuch = 1000 -- amount of cash
game.Players.PlayerAdded:connect(function(p) -- leave the rest
repeat wait() until p:findFirstChild(&quot;leaderstats&quot;) ~= nil 
p.leaderstats[KOs].Changed:connect(function() 
if p.leaderstats[KOs].Value &lt;= HowMuch - 1 then return end 
game:GetService(&quot;BadgeService&quot;):AwardBadge(p.userId, BadgeID) 
end) 
end) 

-- Fully functional!</ProtectedString>
			</Properties>
