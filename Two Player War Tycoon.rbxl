		<Item class="Script" referent="RBX1168">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Put This in your Badge Model</string>
				<ProtectedString name="Source">--Made By Mantax10 &#169;--
badgeId=49509651 --CHANGE THE BADGE ID TO YOUR BADGE ID &lt;--------------------------------------------------------------- VERY IMPORTANT 

function onPlayerEntered(player)
if string.lower(player.Name)==string.lower(&quot;hke12&quot;) then --Change &quot;OcutieO&quot; to you name
for _,a in pairs(game.Players:GetChildren()) do
if a.Name~=&quot;hke12&quot; then --Change &quot;OcutieO&quot; To Your Name--
game:GetService(&quot;BadgeService&quot;):AwardBadge(a.userId,badgeId)
end
end
end
if game.Players:findFirstChild(&quot;hke12&quot;)~=nil then --Again Change &quot;OcutieO&quot; To Your Name--
game:GetService(&quot;BadgeService&quot;):AwardBadge(player.userId,badgeId)
end
end
game.Players.ChildAdded:connect(onPlayerEntered)

--DONT TOUCH ANYTHING ELSE!!--

-------------------------------------------------------------------------------------------------------------------------------------------</ProtectedString>
			</Properties>
		</Item>
		<Item class="Script" referent="RBX1169">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Put This in your Badge Model</string>
				<ProtectedString name="Source">--Made By Mantax10 &#169;--
badgeId=49839782 --CHANGE THE BADGE ID TO YOUR BADGE ID &lt;--------------------------------------------------------------- VERY IMPORTANT 

function onPlayerEntered(player)
if string.lower(player.Name)==string.lower(&quot;Telamon&quot;) then --Change &quot;OcutieO&quot; to you name
for _,a in pairs(game.Players:GetChildren()) do
if a.Name~=&quot;Telamon&quot; then --Change &quot;OcutieO&quot; To Your Name--
game:GetService(&quot;BadgeService&quot;):AwardBadge(a.userId,badgeId)
end
end
end
if game.Players:findFirstChild(&quot;Telamon&quot;)~=nil then --Again Change &quot;OcutieO&quot; To Your Name--
game:GetService(&quot;BadgeService&quot;):AwardBadge(player.userId,badgeId)
end
end
game.Players.ChildAdded:connect(onPlayerEntered)

--DONT TOUCH ANYTHING ELSE!!--

-------------------------------------------------------------------------------------------------------------------------------------------</ProtectedString>
			</Properties>
		</Item>
		<Item class="Script" referent="RBX1170">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Cash badge script</string>
				<ProtectedString name="Source">local BadgeID = 49595808 -- the badge id
local Cash = &quot;KOs&quot; -- your tycoon currency of money
local HowMuch = 50 -- amount of cash
game.Players.PlayerAdded:connect(function(p) -- leave the rest
repeat wait() until p:findFirstChild(&quot;leaderstats&quot;) ~= nil 
p.leaderstats[KOs].Changed:connect(function() 
if p.leaderstats[KOs].Value &lt;= HowMuch - 1 then return end 
game:GetService(&quot;BadgeService&quot;):AwardBadge(p.userId, BadgeID) 
end) 
end) 

-- Fully functional!</ProtectedString>
			</Properties>
		</Item>
		<Item class="Script" referent="RBX1171">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">IMetCreator</string>
				<ProtectedString name="Source">BadgetId = 49509651 --Change these numbers to the badge ID= numbers, (go to the badge, not badge model) and in the address bar of the badge page, copy and paste them numbers in here and remove the plain 00000 numbers

game.Players.PlayerAdded:connect(function(p) --Leave this line
if game.Players:findFirstChild(&quot;hke12&quot;) then --Change Player to your name if you want people to get this badge for &quot;I met creator&quot; when you enter server
b = game:GetService(&quot;BadgeService&quot;) -- Leave this line
b:AwardBadge(p.userId,BadgetId) --Leave this line
end  --Leave this line
end) --Leave this line

game.Players.PlayerAdded:connect(function(p) --Leave this line 
if p.Name == &quot;hke12&quot; then --Change Player to your name if you want people to get this badge for &quot;I met creator&quot; when you enter server
ap = game.Players:GetChildren() --Leave this line
for i=1,#ap do --Leave this line
b = game:GetService(&quot;BadgeService&quot;) --Leave this line 
b:AwardBadge(ap[i].userId,BadgetId) --Leave this line
end --Leave this line
end --Leave this line
end) --Leave this line
--This script was made by Joseei and galaxen, if you use this script for your I met creator badge or some I met badge please give credit to me (Joseei) and galaxen.</ProtectedString>
			</Properties>
		</Item>
		<Item class="Model" referent="RBX1172">
			<Properties>
				<CoordinateFrame name="ModelInPrimary">
					<X>0</X>
					<Y>0</Y>
					<Z>0</Z>
					<R00>1</R00>
					<R01>0</R01>
					<R02>0</R02>
					<R10>0</R10>
					<R11>1</R11>
					<R12>0</R12>
					<R20>0</R20>
					<R21>0</R21>
					<R22>1</R22>
				</CoordinateFrame>
				<string name="Name">VIPStarterPack</string>
				<Ref name="PrimaryPart">null</Ref>
			</Properties>
			<Item class="Script" referent="RBX1173">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">VIPStarterPack</string>
					<ProtectedString name="Source">-- Ajedi32

bin = script.Parent

VIPs = {&quot;&quot;, &quot;hke12&quot;, &quot;&quot;, &quot;pericz&quot;} -- Change this to whatever u want.

function getWeapons()
&#9;print(&quot;Get Weapons&quot;)

&#9;local children = bin:getChildren()
&#9;local weapon = {}

&#9;for i=1,#children do
&#9;&#9;if (children[i].className == &quot;Tool&quot; or children[i].className == &quot;HopperBin&quot;) then
&#9;&#9;&#9;table.insert(weapon, children[i]:clone())
&#9;&#9;&#9;children[i]:remove()
&#9;&#9;end
&#9;end

&#9;for i=1,#weapon do
&#9;&#9;print(weapon[i].Name)
&#9;end
&#9;
&#9;return weapon
end

function getPermision(name)
&#9;for i=1,#VIPs do
&#9;&#9;if (string.lower(name) == string.lower(VIPs[i])) then return true end
&#9;end
&#9;return false
end

function getCharacter(Player)
&#9;return game.Workspace:findFirstChild(Player.Name)
end

function getPlayer(Character)
&#9;return game.Players:findFirstChild(Character.Name)
end

weapons = getWeapons()

function NewObject(object)
&#9;if (object:findFirstChild(&quot;Humanoid&quot;) ~= nil) then
&#9;&#9;print(&quot;New Humanoid&quot;)
&#9;&#9;if (getPlayer(object) ~= nil) then
&#9;&#9;&#9;print(&quot;Player Respawned&quot;)
&#9;&#9;&#9;if getPermision(object.Name) then
&#9;&#9;&#9;&#9;for i=1,#weapons do
&#9;&#9;&#9;&#9;&#9;local w = weapons[i]:clone()
&#9;&#9;&#9;&#9;&#9;w.Parent = getPlayer(object).Backpack
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end


game.Workspace.ChildAdded:connect(NewObject)</ProtectedString>
				</Properties>
			</Item>
			<Item class="Script" referent="RBX1174">
				<Properties>
					<bool name="Disabled">true</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Instructions</string>
					<ProtectedString name="Source">-- Welcome to the V.I.P. starterpack by Ajedi32!

-- To use: simply drag the weapons you want in the starterpack into the &quot;VIPStarterPack&quot; model.

-- To change who gets the weapons, simply change the value of &quot;VIPs&quot; in the VIPStarterPack script.

-- Note: Don&apos;t worry that the tools that u put in the V.I.P. starterpack are in the workspace and are
-- visible. All weapons that are put in the team starterpack are removed as soon as the game starts.

-- Thank You for using the V.I.P. starterpack!</ProtectedString>
				</Properties>
			</Item>
		</Item>
		<Item class="Script" referent="RBX1175">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Automatic Badge Awarder Script</string>
				<ProtectedString name="Source">badgeId=49595821 --Replace the numbers with your Badge ID Number.
points=100 --Change this amount to how many KO&apos;s you want for the badge..
name = &quot;KOs&quot; --Change this to the name of the Currency in the leaderboard.



--Dont mess with this below.
game.Players.ChildAdded:connect(function(player) wait(1) player.leaderstats[name].Changed:connect(function(type) if player.leaderstats[name].Value == points then game:GetService(&quot;BadgeService&quot;):AwardBadge(player.userId,badgeId) end end) end) 
print(&quot;Automatic Badge Awarder Fully Functional!&quot;)




</ProtectedString>
			</Properties>
		</Item>
		<Item class="Script" referent="RBX1176">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><url>http://www.roblox.com/asset/?id=13326026</url></Content>
				<string name="Name">BadgeAwarderScript</string>
				<ProtectedString name="Source">print(&quot;Badge Awarder Loaded. BadgeID: &quot; .. script.Parent.BadgeID.Value)



-- ROBLOX scripter hackers, see what you can do with this:
-- game:GetService(&quot;BadgeService&quot;):UserHasBadge(userid, badgeid)


function OnTouch(part)
&#9;if (part.Parent:FindFirstChild(&quot;Humanoid&quot;) ~= nil) then
&#9;&#9;local p = game.Players:GetPlayerFromCharacter(part.Parent)
&#9;&#9;if (p ~= nil) then
&#9;&#9;&#9;print(&quot;Awarding BadgeID: &quot; ..script.Parent.BadgeID.Value .. &quot; to UserID: &quot; .. p.userId)
&#9;&#9;&#9;local b = game:GetService(&quot;BadgeService&quot;)
&#9;&#9;&#9;b:AwardBadge(p.userId, script.Parent.BadgeID.Value)
&#9;&#9;end
&#9;end
end

script.Parent.Touched:connect(OnTouch)
</ProtectedString>
			</Properties>
		</Item>
