		<Item class="Script" referent="RBX1139">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">regen script</string>
				<ProtectedString name="Source">model = game.Workspace.Safep
messageText = &quot;Regenerating Stuff...&quot;

message = Instance.new(&quot;Message&quot;)
message.Text = messageText
backup = model:clone()

while true do
&#9;wait(100) -- regenerate this model every 300 seconds

&#9;message.Parent = game.Workspace
&#9;model:remove()

&#9;wait(0.2) -- display regen message for 4 seconds

&#9;model = backup:clone()
&#9;model.Parent = game.Workspace
&#9;model:makeJoints()
&#9;message.Parent = nil
end
</ProtectedString>
			</Properties>
