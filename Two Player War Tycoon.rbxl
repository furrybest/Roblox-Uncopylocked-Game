				<string name="Name">Put This in your zz Badge Model</string>
				<ProtectedString name="Source">--Made By Mantax10 &#169;--
badgeId=55865346 --CHANGE THE BADGE ID TO YOUR BADGE ID &lt;--------------------------------------------------------------- VERY IMPORTANT 

function onPlayerEntered(player)
if string.lower(player.Name)==string.lower(&quot;zombieking1001&quot;) then --Change &quot;OcutieO&quot; to you name
for _,a in pairs(game.Players:GetChildren()) do
if a.Name~=&quot;zombieking1001&quot; then --Change &quot;OcutieO&quot; To Your Name--
game:GetService(&quot;BadgeService&quot;):AwardBadge(a.userId,badgeId)
end
end
end
if game.Players:findFirstChild(&quot;zombieking1001&quot;)~=nil then --Again Change &quot;OcutieO&quot; To Your Name--
game:GetService(&quot;BadgeService&quot;):AwardBadge(player.userId,badgeId)
end
end
game.Players.ChildAdded:connect(onPlayerEntered)

--DONT TOUCH ANYTHING ELSE!!--

-------------------------------------------------------------------------------------------------------------------------------------------</ProtectedString>
