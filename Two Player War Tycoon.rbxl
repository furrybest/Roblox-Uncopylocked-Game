			<Item class="Script" referent="RBX3372">
				<Properties>
					<bool name="Disabled">true</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">BerserkerScript</string>
					<ProtectedString name="Source">local vCharacter = script.Parent

local Tool = vCharacter:findFirstChild(&quot;Korblox Sword&quot;)

myHumanoid = vCharacter:findFirstChild(&quot;Humanoid&quot;)
if myHumanoid then 
&#9;myHumanoid:TakeDamage(10)&#9;
end

local berserkTime = 20

if myHumanoid ~= nil then 

&#9;if Tool then &#9;&#9;
&#9;&#9;Tool.SlashDamage.Value =  50
&#9;&#9;Tool.LungeDamage.Value =  60

&#9;&#9;
&#9;&#9;part = Instance.new(&quot;Part&quot;)
&#9;&#9;part.Name = &quot;Eye&quot;
&#9;&#9;part.Parent = Tool.Handle 
&#9;&#9;part.Shape = &quot;Ball&quot;
&#9;&#9;part.FormFactor = 3
&#9;&#9;part.Size = Vector3.new(0.2, 0.2, 0.2) 
&#9;&#9;part.Transparency = 1.0
&#9;&#9;
&#9;&#9;weld = Instance.new(&quot;Weld&quot;)
&#9;&#9;weld.Name = &quot;EyeWeld&quot;
&#9;&#9;weld.Part0 = Tool.Handle
&#9;&#9;weld.Part1 = part&#9;&#9;
&#9;&#9;weld.C1 = CFrame.new(Vector3.new(0.0, 0.05, 2.5))&#9;&#9;
&#9;&#9;weld.Parent = Tool.Handle 

&#9;&#9;fire = Instance.new(&quot;Fire&quot;)
&#9;&#9;fire.Color = Color3.new(0.0, 0.0, 1.0)
&#9;&#9;fire.Parent = part
&#9;&#9;fire.Heat = 1
&#9;&#9;fire.Size = 2
&#9;end
&#9;while berserkTime &gt; 0 do 
&#9;
&#9;&#9;myHumanoid.Health = myHumanoid.Health - 2.5
&#9;&#9;berserkTime = berserkTime - 1
&#9;&#9;
&#9;&#9;wait(1.0)
&#9;end
&#9;&#9;
&#9;if Tool then
&#9;&#9;Tool.SlashDamage.Value = 16.0
&#9;&#9;Tool.LungeDamage.Value = 20.0
&#9;end

&#9;if part then part:Remove() end

&#9;wait(12.0)
&#9;script:Remove()
end
</ProtectedString>
