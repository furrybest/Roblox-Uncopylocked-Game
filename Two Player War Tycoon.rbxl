		<Item class="Script" referent="RBX2311">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">High Score Script</string>
				<ProtectedString name="Source">h = Instance.new(&quot;Hint&quot;) 
h.Parent = game.Workspace 
highscore = 0 
highscorename = &quot;Nobody&quot; 

while true do 
wait(0.01) 
local l = game.Players:children() 
for i=1,#l do 
local bounce = l[i].leaderstats:findFirstChild(&quot;Cash&quot;) 
if (bounce ~= nil) then 
if (bounce.Value &gt; highscore) then 
highscore = bounce.Value 
highscorename = l[i].leaderstats.Parent.Name 
h.Text = &quot;Server&apos;s best Cash: &quot;..highscore..&quot;, made by: &quot;..highscorename..&quot;!&quot; 
end 
end 
end 
end </ProtectedString>
