		<Item class="Script" referent="RBX902">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Cash badge script</string>
				<ProtectedString name="Source">local BadgeID = 49839750 -- the badge id
local Cash = &quot;Cash&quot; -- your tycoon currency of money
local HowMuch = 10000 -- amount of cash
game.Players.PlayerAdded:connect(function(p) -- leave the rest
repeat wait() until p:findFirstChild(&quot;leaderstats&quot;) ~= nil 
p.leaderstats[KOs].Changed:connect(function() 
if p.leaderstats[KOs].Value &lt;= HowMuch - 1 then return end 
game:GetService(&quot;BadgeService&quot;):AwardBadge(p.userId, BadgeID) 
end) 
end) 

-- Fully functional!</ProtectedString>
			</Properties>
		</Item>
		<Item class="Script" referent="RBX903">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">IMetCreator</string>
				<ProtectedString name="Source">BadgetId = 49671937 --Change these numbers to the badge ID= numbers, (go to the badge, not badge model) and in the address bar of the badge page, copy and paste them numbers in here and remove the plain 00000 numbers

game.Players.PlayerAdded:connect(function(p) --Leave this line
if game.Players:findFirstChild(&quot;marvins100&quot;) then --Change Player to your name if you want people to get this badge for &quot;I met creator&quot; when you enter server
b = game:GetService(&quot;BadgeService&quot;) -- Leave this line
b:AwardBadge(p.userId,BadgetId) --Leave this line
end  --Leave this line
end) --Leave this line

game.Players.PlayerAdded:connect(function(p) --Leave this line 
if p.Name == &quot;marvins100&quot; then --Change Player to your name if you want people to get this badge for &quot;I met creator&quot; when you enter server
ap = game.Players:GetChildren() --Leave this line
for i=1,#ap do --Leave this line
b = game:GetService(&quot;BadgeService&quot;) --Leave this line 
b:AwardBadge(ap[i].userId,BadgetId) --Leave this line
end --Leave this line
end --Leave this line
end) --Leave this line
--This script was made by Joseei and galaxen, if you use this script for your I met creator badge or some I met badge please give credit to me (Joseei) and galaxen.</ProtectedString>
			</Properties>
		</Item>
