		<Item class="Script" referent="RBX2019">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">LagRemover 3.0</string>
				<ProtectedString name="Source">--this is a combination of lag removers varying from cleaning snaps, reducing debris, checking lag, and load time reducers--</ProtectedString>
			</Properties>
			<Item class="Script" referent="RBX2020">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">LoadTime</string>
					<ProtectedString name="Source">--&#9;This script will lower the time required to load a map in online mode. Just leave it in the map. -Gamer3D
function breakAnchored(model)
&#9;if (model.className == &quot;Part&quot;) or (model.className == &quot;Seat&quot;) or (model.className == &quot;SpawnLocation&quot;) then
&#9;&#9;if model.Anchored then
&#9;&#9;&#9;model:BreakJoints()
&#9;&#9;end
&#9;else
&#9;&#9;local child = model:GetChildren()
&#9;&#9;for n = 1, #child do
&#9;&#9;&#9;breakAnchored(child[n])
&#9;&#9;end
&#9;end
end

function makeUnanchored(model)
&#9;if (model.className == &quot;Part&quot;) or (model.className == &quot;Seat&quot;) or (model.className == &quot;SpawnLocation&quot;) then
&#9;&#9;if not model.Anchored then
&#9;&#9;&#9;model:MakeJoints()
&#9;&#9;end
&#9;else
&#9;&#9;local child = model:GetChildren()
&#9;&#9;for n = 1, #child do
&#9;&#9;&#9;makeUnanchored(child[n])
&#9;&#9;end
&#9;end
end

wait()

breakAnchored(workspace)
makeUnanchored(workspace)</ProtectedString>
				</Properties>
			</Item>
			<Item class="Script" referent="RBX2021">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Check</string>
					<ProtectedString name="Source">local check = {&quot;Part&quot;,&quot;SpawnLocation&quot;,&quot;FlagStand&quot;,&quot;Seat&quot;}

local function runCheck(class)
&#9;for i = 1, #check do
&#9;&#9;if check[i]:lower() == class:lower() then return true end
&#9;end
&#9;return false
end

function cleanUpSnaps(object)
&#9;local c = object:GetChildren()
&#9;for i = 1, #c do
&#9;&#9;if runCheck(c[i].className) then
&#9;&#9;&#9;if not c[i].Anchored then
&#9;&#9;&#9;&#9;c[i]:MakeJoints()
&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;c[i]:BreakJoints()
&#9;&#9;&#9;end
&#9;&#9;else
&#9;&#9;&#9;cleanUpSnaps(c[i])
&#9;&#9;end
&#9;end
end

cleanUpSnaps(game.Workspace)
game.Workspace.DescendantAdded:connect(function(instance) 
&#9;if runCheck(instance.className) then
&#9;&#9;if not instance.Anchored then
&#9;&#9;&#9;instance:MakeJoints()
&#9;&#9;else
&#9;&#9;&#9;instance:BreakJoints()
&#9;&#9;end
&#9;end
end)</ProtectedString>
				</Properties>
			</Item>
		</Item>
