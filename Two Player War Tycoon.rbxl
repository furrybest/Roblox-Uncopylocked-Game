								<ProtectedString name="Source">-------------------------------------------------------------------------------------------------------------------------
model = script.Parent.Parent.Parent.hammer   --This is the WHATEVER. you made a desk in the instructions SO name the part called MODELNAME to &quot;Desk&quot;. Then change price to what you want. Type it in next to the last dot.
Upgradecost = 5   --This is what you want it to cost. the Example costs 100 cash. type it over the 100 number.
--Remove = script.Parent.Parent.Parent.WHATEVER -- if something must be removed!

-------------------------------------------------------------------------------------------------------------------------
upgradeStuff = model:clone()   --DO NOT CHANGE ANITHING DOWN HERE!!!

wait(1)

model:remove()
owner = script.Parent.Parent.Parent.OwnerName 
local ting = 0


function onTouched(hit)
&#9;if ting == 0 then
&#9;ting = 1
&#9;check = hit.Parent:FindFirstChild(&quot;Humanoid&quot;)

&#9;if check ~= nil then
&#9;if hit.Parent.Name == owner.Value then
&#9;&#9;local user = game.Players:GetPlayerFromCharacter(hit.Parent)
&#9;&#9;local stats = user:findFirstChild(&quot;leaderstats&quot;)

&#9;&#9;if stats ~= nil then
&#9;&#9;&#9;local cash = stats:findFirstChild(&quot;KOs&quot;)---But only you can change leaderstats!
&#9;&#9;&#9;if cash.Value &gt; (Upgradecost-1) then

&#9;&#9;&#9;&#9;cash.Value = cash.Value - Upgradecost
&#9;&#9;&#9;&#9;upgradeStuff.Parent = script.Parent.Parent.Parent
            --Remove:remove()
            
&#9;&#9;&#9;&#9;script.Parent.Parent:remove()

&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
&#9;end

&#9;ting = 0
&#9;end
end

