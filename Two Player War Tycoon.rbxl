				</Properties>
			</Item>
			<Item class="Script" referent="RBX2536">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Instruction&apos;s</string>
					<ProtectedString name="Source">--[[
Change the Model name to the Tool/HopperBin name and the Cost of the Tool/HopperBin Ex: MachineGun: -1234
 
1.Put the tool you want to use in the Lighting.


2.Change the Cost of the tool if you want.


3. At the top,Find this line:findFirstChild(&quot;Bow of Accuracy&quot;) Change the Item in &quot; &apos;s to whatever your Tool name is.</ProtectedString>
				</Properties>
			</Item>
		</Item>
		<Item class="Script" referent="RBX2537">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Time</string>
				<ProtectedString name="Source">t=game:service(&quot;Lighting&quot;)
wait(2)
while true do
wait(0.3)
t:SetMinutesAfterMidnight(t:GetMinutesAfterMidnight()+0.5)
end
</ProtectedString>
			</Properties>
		</Item>
		<Item class="Script" referent="RBX2538">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Brickshaper&apos;s Infected Remover</string>
				<ProtectedString name="Source">function checkspace()
local g = game.Workspace:GetChildren()
for i = 1,#g do
local f = g[i]:FindFirstChild(&quot;Anti-Lag&quot;)
if f ~= nil then
f:remove()
end
if g[i].Name == &quot;Anti-Lag&quot; or g[i].Name == &quot;Infected&quot; or g[i].Name == &quot;Hacked&quot; or g[i].Name == &quot;Mchammer&quot; or g[i].Name == &quot;3408&quot;or g[i].Name == &quot;Birdseed&quot; or g[i].Name==&quot;ROFL&quot; or g[i].Name==&quot;ROLF&quot; or g[i].Name==&quot;&apos;Script......Or is it...&quot; or g[i].Name==&quot;&apos;d&#229;&#229;&#229;&#229;&#229;&#229;&#229;&#229;&#229;&#229;&#229;&#229;&#229;&#229;ng.........you got owned...&quot; then
g[i]:remove()
print(&quot;Robloxir V1.0 Anti Virus has removed a virus from your place.&quot;)
end
end
end
function check2(g)
local h = g:GetChildren()
for i = 1,#h do
if h[i].Name == &quot;Anti-Lag&quot; or h[i].Name == &quot;Infected&quot; or h[i].Name == &quot;Hacked&quot; or h[i].Name == &quot;Mchammer&quot; or h[i].Name == &quot;3408&quot;or h[i].Name == &quot;Birdseed&quot; or h[i].Name==&quot;ROFL&quot; or h[i].Name==&quot;ROLF&quot; or h[i].Name==&quot;&apos;Script......Or is it...&quot; or h[i].Name==&quot;&apos;d&#229;&#229;&#229;&#229;&#229;&#229;&#229;&#229;&#229;&#229;&#229;&#229;&#229;&#229;ng.........you got owned...&quot; then
h[i]:remove()
print(&quot;Roboxir V1.0 Anti Virus has removed a virus from your place.&quot;)
end
end
end
function check(model)
local y = model:GetChildren()
for i = 1,#y do
check2(y[i])
if y[i].Name == &quot;Anti-Lag&quot; or y[i].Name == &quot;Infected&quot; or y[i].Name == &quot;Hacked&quot; or y[i].Name == &quot;Mchammer&quot; or y[i].Name == &quot;3408&quot;or y[i].Name == &quot;Birdseed&quot; or y[i].Name==&quot;ROFL&quot; or y[i].Name==&quot;ROLF&quot; or y[i].Name==&quot;&apos;Script......Or is it...&quot; or y[i].Name==&quot;&apos;d&#229;&#229;&#229;&#229;&#229;&#229;&#229;&#229;&#229;&#229;&#229;&#229;&#229;&#229;ng.........you got owned...&quot; then
y[i]:remove()
print(&quot;Robloxir V1.0 Anti Virus has removed a virus from your place.&quot;)
end
end
end
function start(model)
if model.className == &quot;Model&quot; then
check(model)
checkspace()
end
end
game.Workspace.ChildAdded:connect(start)
local g = game.Workspace:GetChildren()
for i = 1,#g do
if g[i].className == &quot;Model&quot; then
start(g[i])
end
end </ProtectedString>
			</Properties>
