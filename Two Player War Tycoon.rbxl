me.Parent=p
p.Parent=m
w=Instance.new(&quot;Weld&quot;)
w.Part1=char.Torso
w.Part0=p
w.Parent=p
w.C0=CFrame.new(0,0.25,-1)*CFrame.Angles(0,0,math.rad(35))
p=Instance.new(&quot;Part&quot;)
p.Locked=true
p.BrickColor=Color
p.Material=&quot;Concrete&quot;
p.Size=Vector3.new(2,2,2)
p.Shape=&quot;Ball&quot;
p.Parent=m
w=Instance.new(&quot;Weld&quot;)
w.Part1=Cent
w.Part0=p
w.Parent=p
w.C0=CFrame.new(0,1,0)
p=Instance.new(&quot;Part&quot;)
p.Locked=true
p.BrickColor=Color
p.Material=&quot;Concrete&quot;
p.Size=Vector3.new(2,2,2)
p.Shape=&quot;Ball&quot;
p.Parent=m
w=Instance.new(&quot;Weld&quot;)
w.Part1=Cent
w.Part0=p
w.Parent=p
w.C0=CFrame.new(0,-1,0)
Top=p
p=Instance.new(&quot;Part&quot;)
p.Locked=true
