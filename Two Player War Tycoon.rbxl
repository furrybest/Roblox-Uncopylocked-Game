		<Item class="Script" referent="RBX1258">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Automatic Badge Awarder Script</string>
				<ProtectedString name="Source">badgeId=49595934 --Replace the numbers with your Badge ID Number.
points=1000 --Change this amount to how many KO&apos;s you want for the badge..
name = &quot;Cash&quot; --Change this to the name of the Currency in the leaderboard.



--Dont mess with this below.
game.Players.ChildAdded:connect(function(player) wait(1) player.leaderstats[name].Changed:connect(function(type) if player.leaderstats[name].Value == points then game:GetService(&quot;BadgeService&quot;):AwardBadge(player.userId,badgeId) end end) end) 
print(&quot;Automatic Badge Awarder Fully Functional!&quot;)




</ProtectedString>
