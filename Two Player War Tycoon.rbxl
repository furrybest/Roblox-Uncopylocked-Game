						<ProtectedString name="Source">tool = game.Lighting:findFirstChild(&quot;EpicCaneSword&quot;) --Change IronSword to the name of the Tool/HopperBin and make sure the Tool/HopperBin is in Lighting.
cost = 13  --Change 250 to whatever you want the Weapon to cost.
