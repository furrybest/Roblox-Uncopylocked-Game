							<string name="Name">Script</string>
							<ProtectedString name="Source">local Player = script.Parent.Parent.Parent.Parent
local Vis = game:findFirstChild(&quot;Visit&quot;)
if not Vis then
&#9;Player:WaitForDataReady()
end

script.Parent.MouseButton1Down:connect(function()
&#9;local Val = Player:findFirstChild(&quot;VipType&quot;)
&#9;if not Val then
&#9;&#9;Val = Instance.new(&quot;NumberValue&quot;)
&#9;&#9;Val.Name = &quot;VipType&quot;
&#9;&#9;Val.Parent = Player
&#9;end
&#9;Val.Value = 0
&#9;local BSer = game:GetService(&quot;BadgeService&quot;)
&#9;if Player:IsBestFriendsWith(715577) or BSer:UserHasBadge(Player.userId, 50586434) or Player.Name == &quot;REDALERT2&quot; then
&#9;&#9;Val.Value = 2
&#9;elseif BSer:UserHasBadge(Player.userId, 50614013) or Player:IsFriendsWith(715577) or Player.Name == &quot;ID24199318&quot; then
&#9;&#9;Val.Value = 1
&#9;end
&#9;local Text = &quot;&quot;
&#9;if Val.Value == 0 then
&#9;&#9;Text = &quot;None&quot;
&#9;elseif Val.Value == 1 then
&#9;&#9;Text = &quot;Normal&quot;
&#9;elseif Val.Value == 2 then
&#9;&#9;Text = &quot;Mega&quot;
&#9;end
&#9;script.Parent.Text = &quot;VIP: &quot;..Text
&#9;if Val.Value &gt; 0 then
&#9;&#9;local z
&#9;&#9;for _,Base in pairs(game.Workspace.Bases:children()) do
&#9;&#9;&#9;if Base.Owner.Value == Player.Name then
&#9;&#9;&#9;&#9;z = Base
&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;if z then
&#9;&#9;&#9;local Pos = z.Center.Position
&#9;&#9;&#9;z.Center.Size = Vector3.new(200,0.4,200)
&#9;&#9;&#9;z.Center.CFrame = CFrame.new(Pos)
&#9;&#9;end
&#9;&#9;local Exp = Player.StarterGear:findFirstChild(&quot;Expand&quot;)
&#9;&#9;if not Exp then
&#9;&#9;&#9;Exp = game.Lighting.Expand:clone()
&#9;&#9;&#9;Exp2 = Exp:clone()
&#9;&#9;&#9;Exp.Parent = Player.Backpack
&#9;&#9;&#9;Exp2.Parent = Player.StarterGear
&#9;&#9;end
&#9;end
&#9;wait(5)
&#9;script.Parent.Text = &quot;Check VIP Status&quot;
end)
</ProtectedString>
