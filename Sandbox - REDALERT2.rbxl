										<ProtectedString name="Source">local Mod = script.Parent.Parent
wait(0.1)
local Part = Mod.Part
local Props = Mod.Properties
Part.Decal1:remove()
Part.Decal2:remove()
Part.Decal3:remove()
Part.Decal4:remove()

local Open = false

Part.Touched:connect(function(Obj)
&#9;if not Open then
&#9;&#9;Open = true
&#9;&#9;Part.Transparency = 1
&#9;&#9;local OpenTime = Props.OpenTime.Var.Value
&#9;&#9;local Trip = Props.TripPlayers.Var.Value
&#9;&#9;if Trip then
&#9;&#9;&#9;local Hum = Obj.Parent:findFirstChild(&quot;Humanoid&quot;)
&#9;&#9;&#9;if Hum then
&#9;&#9;&#9;&#9;Hum.Sit = true
&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;wait(OpenTime)
&#9;&#9;Part.Transparency = 0
&#9;&#9;Open = false
&#9;end
end)
</ProtectedString>
