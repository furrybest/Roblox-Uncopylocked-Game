							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Controle Status</string>
							<ProtectedString name="Source">local Player = script.Parent.Parent.Parent.Parent
--Player:WaitForDataReady()

local Data = script.Parent.Parent.Data

local MouseIn = false

script.Parent.Status.MouseEnter:connect(function()
--&#9;print(&quot;MouseIn&quot;)
&#9;MouseIn = true
&#9;wait(0.1)
&#9;if MouseIn == true then
&#9;&#9;if script.Parent.Status.TL.TextTransparency &gt; 0 then
&#9;&#9;for i = script.Parent.Status.TL.TextTransparency, 0, -0.1 do
&#9;&#9;&#9;if not MouseIn then break end
&#9;&#9;&#9;script.Parent.Status.TL.TextTransparency = i
&#9;&#9;&#9;wait(0.05)
&#9;&#9;end
&#9;&#9;script.Parent.Status.TL.TextTransparency = 0
&#9;&#9;end
&#9;end
end)

script.Parent.Status.MouseLeave:connect(function()
--&#9;print(&quot;MouseExit&quot;)
&#9;MouseIn = false
&#9;if script.Parent.Status.TL.TextTransparency &lt; 1 then
&#9;&#9;for i = script.Parent.Status.TL.TextTransparency, 1, 0.1 do
&#9;&#9;&#9;if MouseIn then break end
&#9;&#9;&#9;script.Parent.Status.TL.TextTransparency = i
&#9;&#9;&#9;wait(0.05)
&#9;&#9;end
&#9;&#9;script.Parent.Status.TL.TextTransparency = 1
&#9;end
end)

function SaveData()
--[[&#9;script.Parent.SaveData.Disabled = true
&#9;wait(0.5)
&#9;script.Parent.SaveData.Disabled = false]]
&#9;local Save = script.Parent.Controle.Save:clone()
&#9;Save.Parent = game.Workspace
&#9;Save.Player.Value = Player
&#9;Save.Data.Value = Data
&#9;Save.Disabled = false
end

local ConsecutiveError = 0
local ErrClick = false

while true do
&#9;local CurData = &quot;&quot;
&#9;pcall(function() CurData = Player:LoadString(&quot;Save&quot;) end)
&#9;if CurData == Data.Value then
&#9;&#9;script.Parent.Status.Image = &quot;http://www.roblox.com/asset/?id=51480487&quot;
&#9;&#9;script.Parent.Status.TL.Text = &quot;Saved&quot;
&#9;&#9;ConsecutiveError = 0
&#9;&#9;ErrClick = false
&#9;&#9;wait(10)
&#9;else
&#9;&#9;ConsecutiveError = ConsecutiveError + 1
&#9;&#9;if ConsecutiveError &lt; 5 then
&#9;&#9;&#9;script.Parent.Status.Image = &quot;http://www.roblox.com/asset/?id=51480515&quot;
&#9;&#9;&#9;script.Parent.Status.TL.Text = &quot;Pending&quot;
&#9;&#9;&#9;SaveData()
&#9;&#9;else
&#9;&#9;&#9;script.Parent.Status.Image = &quot;http://www.roblox.com/asset/?id=51480505&quot;
&#9;&#9;&#9;script.Parent.Status.TL.Text = &quot;ERROR&quot;
&#9;&#9;&#9;if not ErrClick then
&#9;&#9;&#9;&#9;script.Parent.Parent.SaveError.Visible = true
&#9;&#9;&#9;&#9;ErrClick = true
&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;wait(2)
&#9;end
end
