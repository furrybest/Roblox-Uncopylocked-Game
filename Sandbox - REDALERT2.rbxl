							<ProtectedString name="Source">wait(1)
local Player = script.Parent.Parent.Parent.Parent
local CC = game.Workspace.CurrentCamera

local Rot = 0
local Roting = false

local P1 = CC:findFirstChild(&quot;P1&quot;)
if not P1 then
&#9;P1 = Instance.new(&quot;Part&quot;)
&#9;P1.Name = &quot;P1&quot;
&#9;P1.Anchored = true
&#9;P1.CanCollide = false
&#9;P1.BrickColor = BrickColor.new(&quot;Bright red&quot;)
&#9;local M = Instance.new(&quot;BlockMesh&quot;, P1)
&#9;M.Scale = Vector3.new(0.1,100,1)
else
&#9;P1.Parent = nil
end

local P2 = CC:findFirstChild(&quot;P2&quot;)
if not P2 then
&#9;P2 = Instance.new(&quot;Part&quot;)
&#9;P2.Name = &quot;P2&quot;
&#9;P2.Anchored = true
&#9;P2.CanCollide = false
&#9;P2.BrickColor = BrickColor.new(&quot;Bright green&quot;)
&#9;local M = Instance.new(&quot;BlockMesh&quot;, P2)
&#9;M.Scale = Vector3.new(0.2,100,1.02)
else
&#9;P2.Parent = nil
end

function GetParts(Obj)
&#9;local P = {}
&#9;local z = false
&#9;for _,Class in pairs({&quot;Part&quot;,&quot;WedgePart&quot;,&quot;TrussPart&quot;,&quot;CornerWedgePart&quot;}) do
&#9;&#9;if Obj:IsA(Class) then
&#9;&#9;&#9;z = true
&#9;&#9;&#9;table.insert(P,Obj)
&#9;&#9;end
&#9;end
&#9;if not z then
&#9;&#9;for _,Child in pairs(Obj:children()) do
&#9;&#9;&#9;local Ps = GetParts(Child)
&#9;&#9;&#9;for _,child in pairs(Ps) do
&#9;&#9;&#9;&#9;table.insert(P,child)
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
&#9;return P
end

script.Parent.MouseButton1Down:connect(function()
&#9;&#9;P1.Parent = nil
&#9;&#9;P2.Parent = nil
&#9;if script.Parent.Rot.Visible then
&#9;&#9;script.Parent.Rot.Visible = false
&#9;else
&#9;&#9;script.Parent.Rot.Visible = true
&#9;&#9;local z = nil
&#9;&#9;for _,Base in pairs(game.Workspace.Bases:children()) do
&#9;&#9;&#9;if Base.Owner.Value == Player.Name then
&#9;&#9;&#9;&#9;z = Base
&#9;&#9;&#9;&#9;break
&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;if not z then return end
&#9;&#9;script.Parent.Rot.Visible = true
&#9;&#9;P1.Size = Vector3.new(1,1,z.Center.Size.z/2)
&#9;&#9;P1.CFrame = CFrame.new(z.Center.Position+Vector3.new(0,0,z.Center.Size.z/4))
&#9;&#9;P1.Parent = CC
&#9;&#9;P2.Size = Vector3.new(1,1,z.Center.Size.z/2)
&#9;&#9;P2.CFrame = CFrame.new(z.Center.Position) * CFrame.fromEulerAnglesXYZ(0,(Rot/2)*math.pi,0) * CFrame.new(0,0,z.Center.Size.z/4)
&#9;&#9;P2.Parent = CC
&#9;end
end)

