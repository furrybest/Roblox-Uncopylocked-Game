				<Item class="Script" referent="RBX154">
					<Properties>
						<bool name="Disabled">true</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">RandChat</string>
						<ProtectedString name="Source">wait(0.1)
local Figure = script.Parent
local Dialog = Figure.Head.Dialog

local PlayerChatted = false

game.Players.ChildAdded:connect(function(Player)
&#9;Player.Chatted:connect(function()
&#9;&#9;PlayerChatted = true
&#9;end)
end)

while true do
&#9;wait(math.random(90,120))
&#9;if not Dialog.InUse and PlayerChatted then
&#9;&#9;PlayerChatted = false
&#9;&#9;Dialog.Parent = nil
&#9;&#9;local Rand = math.random(1,6)
&#9;&#9;if Rand == 1 then
&#9;&#9;&#9;game.Chat:Chat(script.Parent.Head, &quot;If anyone needs help, just come chat with me.&quot;, Enum.ChatColor.Green)
&#9;&#9;elseif Rand == 2 then
&#9;&#9;&#9;game.Chat:Chat(script.Parent.Head, &quot;Some of the most asked questions are about teleporters and saving.&quot;, Enum.ChatColor.Green)
&#9;&#9;&#9;wait(4)
&#9;&#9;&#9;game.Chat:Chat(script.Parent.Head, &quot;Come chat with me to know the basics about them.&quot;, Enum.ChatColor.Green)
&#9;&#9;elseif Rand == 3 then
&#9;&#9;&#9;game.Chat:Chat(script.Parent.Head, &quot;Remember to save your creations or take a pic to show off to your friends!&quot;, Enum.ChatColor.Green)
&#9;&#9;elseif Rand == 4 then
&#9;&#9;&#9;game.Chat:Chat(script.Parent.Head, &quot;Sandbox is updated about every week, remember to check for recent updates.&quot;, Enum.ChatColor.Green)
&#9;&#9;elseif Rand == 5 then
&#9;&#9;&#9;game.Chat:Chat(script.Parent.Head, &quot;Make sure not to fall for fake VIP scams!&quot;, Enum.ChatColor.Red)
&#9;&#9;&#9;wait(4)
&#9;&#9;&#9;game.Chat:Chat(script.Parent.Head, &quot;Get a VIP link from the Sandbox description or REDALERT2&apos;s t-shirts.&quot;, Enum.ChatColor.Green)
&#9;&#9;elseif Rand == 6 then
&#9;&#9;&#9;game.Chat:Chat(script.Parent.Head, &quot;If you are looking to buy admin then look no further!&quot;, Enum.ChatColor.Green)
&#9;&#9;&#9;wait(4)
&#9;&#9;&#9;game.Chat:Chat(script.Parent.Head, &quot;There is NO admin for sale and there will NEVER be!&quot;, Enum.ChatColor.Green)
&#9;&#9;end
&#9;&#9;wait(6)
&#9;&#9;Dialog.Parent = Figure.Head
&#9;end
end
</ProtectedString>
