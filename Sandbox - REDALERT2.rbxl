&#9;&#9;&#9;&#9;&#9;elseif PartNum == 3 then
&#9;&#9;&#9;&#9;&#9;&#9;Part.Pos.z = Num
&#9;&#9;&#9;&#9;&#9;elseif PartNum == 4 then
