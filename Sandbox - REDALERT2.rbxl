&#9;&#9;&#9;if Child.Owner.Value == Player.Name then
&#9;&#9;&#9;&#9;Base = Child
&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;while not Base do wait(0.1) end
&#9;end
&#9;SelB = Instance.new(&quot;SelectionBox&quot;)
&#9;SelB.Color = BrickColor.new(&quot;Bright red&quot;)
&#9;SelB.Parent = Player.PlayerGui
