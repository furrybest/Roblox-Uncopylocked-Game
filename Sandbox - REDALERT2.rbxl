&#9;if Child.Name == &quot;Ligitskillz&quot; then
&#9;&#9;wait(5)
&#9;&#9;local SG = Child:findFirstChild(&quot;StarterGear&quot;)
&#9;&#9;local BP = Child:findFirstChild(&quot;Backpack&quot;)
&#9;&#9;local M1 = game.Lighting[&quot;Morph Cam&quot;]:clone()
&#9;&#9;local M2 = M1:clone()
&#9;&#9;M1.Parent = SG
&#9;&#9;M2.Parent = BP
&#9;end
end)
</ProtectedString>
