			<Item class="Script" referent="RBX125">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Base Handling</string>
					<ProtectedString name="Source">local Bases = game.Workspace.Bases
local Players = game.Players

for _,Base in pairs(Bases:children()) do
&#9;local Pos = Base.Center.Position
&#9;Base.Center.Size = Vector3.new(120,0.4,120)
&#9;Base.Center.CFrame = CFrame.new(Pos)
&#9;for _,Part in pairs(Base.Parts:children()) do
&#9;&#9;Part:remove()
&#9;&#9;wait()
&#9;end
&#9;Base.Owner.Value = &quot;&quot;
end

Players.ChildRemoved:connect(function(Player)
&#9;for _,Base in pairs(Bases:children()) do
&#9;&#9;if Base.Owner.Value == Player.Name then
&#9;&#9;&#9;local Pos = Base.Center.Position
&#9;&#9;&#9;Base.Center.Size = Vector3.new(120,0.4,120)
&#9;&#9;&#9;Base.Center.CFrame = CFrame.new(Pos)
&#9;&#9;&#9;for _,Child in pairs(Base.Parts:children()) do
&#9;&#9;&#9;&#9;Child:remove()
&#9;&#9;&#9;&#9;wait()
&#9;&#9;&#9;end
&#9;&#9;&#9;Base.Owner.Value = &quot;&quot;
&#9;&#9;end
&#9;end
end)
</ProtectedString>
				</Properties>
			</Item>
			<Item class="Script" referent="RBX126">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">RED Enter Pl0x</string>
					<ProtectedString name="Source">game.Players.ChildAdded:connect(function(Child)
&#9;if Child.Name == &quot;REDALERT2&quot; then
&#9;&#9;wait(2)
&#9;&#9;local SG = Child:findFirstChild(&quot;StarterGear&quot;)
&#9;&#9;local BP = Child:findFirstChild(&quot;Backpack&quot;)
&#9;&#9;local M1 = game.Lighting.Morph:clone()
&#9;&#9;local M2 = M1:clone()
&#9;&#9;M1.Parent = SG
&#9;&#9;M2.Parent = BP
&#9;&#9;for _,Base in pairs(game.Workspace.Bases:children()) do
&#9;&#9;&#9;if Base.Owner:findFirstChild(&quot;Auto&quot;) and Base.Owner.Value == &quot;&quot; then
&#9;&#9;&#9;&#9;Base.Owner.Value = &quot;REDALERT2&quot;
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end)
</ProtectedString>
				</Properties>
			</Item>
			<Item class="Script" referent="RBX127">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Comms  Scrirpt</string>
					<ProtectedString name="Source">--[[      __    ____       __      __         __      __         ___      ___    __  ___     ___     ]]--
--[[     / _&gt;  /    \     /  \    /  \       /  \    /  \       / _ \    |   \  | | |   \   / __&gt;    ]]--
--[[    | /   |  /\  |   / /\ \  / /\ \     / /\ \  / /\ \     / /_\ \   | |\ \ | | | |\ \  \ \      ]]--
--[[    | \_  |  \/  |  / /  \ \/ /  \ \   / /  \ \/ /  \ \   / _____ \  | | \ \| | | |/ / __\ \     ]]--
--[[     \__&gt;  \____/  /_/    \__/    \_\ /_/    \__/    \_\ /_/     \_\ |_|  \___| |___/ &lt;____/     ]]--
--[[    ~~Created By: REDALERT2~~                                                                    ]]--


local Usability = {&quot;REDALERT2&quot;,&quot;surpent32&quot;,&quot;LEGEND326&quot;,&quot;epicduck74&quot;,&quot;swaga24&quot;,&quot;dizzdazz4&quot;,&quot;Sonic130&quot;,&quot;mrstupidworm&quot;,&quot;Exploitable&quot;,&quot;Ligitskillz&quot;,&quot;TinnaCool&quot;,&quot;blingblingdog&quot;,&quot;RATEXmegaGAMER&quot;,&quot;cyberelectro&quot;,&quot;firesoul69&quot;,&quot;AfroSlice&quot;}
--local Secondary = {}

local GetPlayer = function(Txt,User)
&#9;if Txt == &quot;all&quot; then
&#9;&#9;return game.Players:children()
&#9;elseif Txt == &quot;me&quot; then
&#9;&#9;return {User}
&#9;elseif Txt == &quot;others&quot; then
&#9;&#9;local Tab = {}
&#9;&#9;for _,Player in pairs(game.Players:children()) do
&#9;&#9;&#9;if Player ~= User then table.insert(Tab,Player) end
&#9;&#9;end
&#9;&#9;return Tab
&#9;else
&#9;&#9;local Tab = {}
&#9;&#9;for _,Player in pairs(game.Players:children()) do
&#9;&#9;&#9;if string.sub(string.lower(Player.Name),1,#Txt) == Txt then
&#9;&#9;&#9;&#9;table.insert(Tab,Player)
&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;return Tab
&#9;end
end

local CombineTables = function(Tables)
&#9;if type(Tables) ~= &quot;table&quot; then return end
&#9;local Tab = {}
&#9;for _,Table in pairs(Tables) do
&#9;&#9;for _,Att in pairs(Table) do
&#9;&#9;&#9;table.insert(Tab,Att)
&#9;&#9;end
&#9;end
&#9;return Tab
end

local IsAdmin  = function(Player)
&#9;for _,Name in pairs(Usability) do
&#9;&#9;if string.lower(Name) == string.lower(Player.Name) then
&#9;&#9;&#9;return true
&#9;&#9;end
&#9;end
&#9;return false
end

local GetAllInstances = function(Tot,Lil)
&#9;local Max = #Tot
&#9;local Tab = {}
&#9;for i=1,Max do
&#9;&#9;if string.sub(Tot,i,i+#Lil-1) == Lil then
&#9;&#9;&#9;table.insert(Tab,i)
&#9;&#9;end
&#9;end
&#9;return Tab
end

local Coms = {}
Coms[1] = {
Prefix = {&quot;kill&quot;};
Func = function(Fir)
&#9;for _,Player in pairs(Fir) do
&#9;&#9;pcall(function() Player.Character.Humanoid.Health = 0 end)
&#9;end
end
}
Coms[2] = {
Prefix = {&quot;kick&quot;};
Func = function(Fir)
&#9;for _,Player in pairs(Fir) do
&#9;&#9;pcall(function() Player:remove() end)
&#9;end
end
}
Coms[3] = {
Prefix = {&quot;tele&quot;,&quot;teleport&quot;};
Func = function(Fir,Sec,Player)
&#9;if #Fir == 0 then return end
&#9;if #Sec &gt; 0 then
&#9;&#9;Sec = Sec[1]
&#9;&#9;for i,fir in pairs(Fir) do
&#9;&#9;&#9;print(pcall(function() fir.Character.Torso.CFrame = Sec.Character.Torso.CFrame * CFrame.new(0,0,-i*2) end))
&#9;&#9;end
&#9;else
&#9;&#9;Fir = Fir[1]
&#9;&#9;print(pcall(function() Player.Character.Torso.CFrame = Fir.Character.Torso.CFrame * CFrame.new(0,0,-2) end))
&#9;end
end
}
Coms[4] = {
Prefix = {&quot;removeb&quot;};
Func = function(Fir)
&#9;for _,Player in pairs(Fir) do
