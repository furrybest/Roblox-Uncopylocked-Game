										<ProtectedString name="Source">wait(0.1)
local Belt = script.Parent.Parent.Belt
local Speed = script.Parent.Parent.Properties.Speed.Var

Belt.Touched:connect(function(hit)
&#9;Belt.Decal.Texture = &quot;http://www.roblox.com/asset?id=45345717&quot;
&#9;wait(1)
&#9;Belt.Decal.Texture = &quot;http://www.roblox.com/asset?id=45345668&quot;
end)

Belt.Velocity = (Belt.CFrame*CFrame.fromEulerAnglesXYZ(-math.pi/4,0,0)).lookVector * -Speed.Value

Speed.Changed:connect(function(Prop)
&#9;Belt.Velocity = (Belt.CFrame*CFrame.fromEulerAnglesXYZ(-math.pi/4,0,0)).lookVector * -Speed.Value
end)</ProtectedString>
