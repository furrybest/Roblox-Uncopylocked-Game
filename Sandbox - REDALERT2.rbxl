										<ProtectedString name="Source">wait(0.1)
local Mod = script.Parent.Parent
local P = Mod.Part

P.Touched:connect(function(hit)
&#9;local Hum = hit.Parent:findFirstChild(&quot;Humanoid&quot;)
&#9;if Hum then
&#9;&#9;local Acid = script.Acid:clone()
&#9;&#9;Acid.Parent = hit
&#9;&#9;Acid.Disabled = false
&#9;end
end)
</ProtectedString>
