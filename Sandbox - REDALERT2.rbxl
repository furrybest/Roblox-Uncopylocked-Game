									<string name="UserDialog">I want more to build with.</string>
								</Properties>
							</Item>
						</Item>
						<Item class="DialogChoice" referent="RBX138">
							<Properties>
								<string name="Name">DC2</string>
								<string name="ResponseDialog">Okay, now what is your problem/question about it?</string>
								<string name="UserDialog">Config Tool</string>
							</Properties>
							<Item class="DialogChoice" referent="RBX139">
								<Properties>
									<string name="Name">DC1</string>
									<string name="ResponseDialog">This tool is used for editting special properties of certain objects. Such as moving spikes or a door.</string>
									<string name="UserDialog">What is it for?</string>
