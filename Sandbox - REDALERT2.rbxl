&#9;&#9;end
&#9;&#9;script.Parent.Parent.Wait.Lab.Text = &quot;Reading Saved Data (&quot;..((o-1)*500)..&quot;,&quot;..Tot..&quot;)&quot;
&#9;&#9;wait()
