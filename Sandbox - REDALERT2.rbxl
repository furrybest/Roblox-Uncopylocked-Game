				<Item class="LocalScript" referent="RBX28899">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Controle</string>
						<ProtectedString name="Source">local Tool = script.Parent
local Morphing = false
local Finished = false
local Turret = false
local MP = game.Lighting.Morph_Pack3
local W = nil
local Skull = nil

Tool.Selected:connect(function(M)
&#9;local Player = Tool.Parent.Parent
&#9;local Char = Player.Character
&#9;if not Char then return end
&#9;local H,T,Hum,LA,RA = Char:findFirstChild(&quot;Head&quot;), Char:findFirstChild(&quot;Torso&quot;), Char:findFirstChild(&quot;Humanoid&quot;), Char:findFirstChild(&quot;Left Arm&quot;), Char:findFirstChild(&quot;Right Arm&quot;)
&#9;if not Hum or Hum.Health &lt;= 0 then return end
&#9;if not Finished or not Morphing then
&#9;&#9;Morphing = true
&#9;&#9;for _,Child in pairs(Char:children()) do
&#9;&#9;&#9;if Child:IsA(&quot;Hat&quot;) then
&#9;&#9;&#9;&#9;local Han = Child:findFirstChild(&quot;Handle&quot;)
&#9;&#9;&#9;&#9;if Han then
&#9;&#9;&#9;&#9;&#9;for i = 0, 1, 0.1 do
&#9;&#9;&#9;&#9;&#9;&#9;wait(0.05)
&#9;&#9;&#9;&#9;&#9;&#9;Han.Transparency = i
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;Child:remove()
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;local Face = H:findFirstChild(&quot;face&quot;)
&#9;&#9;if Face then Face:remove() end
&#9;&#9;for i = 0, 1, 0.1 do
&#9;&#9;&#9;H.Transparency = i
&#9;&#9;&#9;wait(0.05)
&#9;&#9;end
&#9;&#9;Skull = MP.Skull:clone()
--&#9;&#9;local MO = MP.MysticalOrb:clone()
&#9;&#9;Skull.Parent = Char
--&#9;&#9;MO.Parent = Char
&#9;&#9;W = Instance.new(&quot;Weld&quot;)
&#9;&#9;W.Parent = T
&#9;&#9;W.Name = &quot;Head To Skull&quot;
&#9;&#9;W.Part0 = H
&#9;&#9;W.Part1 = Skull
&#9;&#9;W.C0 = CFrame.new(0.2,0.2,-0.5)
&#9;&#9;Skull.Anchored = false
--[[&#9;&#9;local W2 = Instance.new(&quot;Weld&quot;)
&#9;&#9;W2.Parent = T
&#9;&#9;W2.Name = &quot;Head To Orb&quot;
&#9;&#9;W2.Part0 = H
&#9;&#9;W2.Part1 = MO
&#9;&#9;Skull.Anchored = false
&#9;&#9;MO.Anchored = false
&#9;&#9;for i = 1, 0, -0.1 do
&#9;&#9;&#9;MO.Transparency = i
&#9;&#9;&#9;wait(0.05)
&#9;&#9;end
&#9;&#9;MO.Transparency = 0]]
&#9;&#9;for i = 1, 0, -0.1 do
&#9;&#9;&#9;Skull.Transparency = i
&#9;&#9;&#9;wait(0.05)
&#9;&#9;end
&#9;&#9;Skull.Transparency = 0
--[[&#9;&#9;local RSpike = MP.Spike:clone()
&#9;&#9;local LSpike = MP.Spike:clone()
&#9;&#9;RSpike.Parent = Char
&#9;&#9;LSpike.Parent = Char
&#9;&#9;local W3 = Instance.new(&quot;Weld&quot;)
&#9;&#9;W3.Parent = T
&#9;&#9;W3.Name = &quot;Torso To RSpike&quot;
&#9;&#9;W3.Part0 = T
&#9;&#9;W3.Part1 = RSpike
&#9;&#9;W3.C0 = CFrame.new(0.5,0.8,0) * CFrame.fromEulerAnglesXYZ(0.3*math.pi,0,-0.2*math.pi)
&#9;&#9;W3.C1 = CFrame.new(0,-1.4,0)
&#9;&#9;local W4 = Instance.new(&quot;Weld&quot;)
&#9;&#9;W4.Parent = T
&#9;&#9;W4.Name = &quot;Torso To RSpike&quot;
&#9;&#9;W4.Part0 = T
&#9;&#9;W4.Part1 = LSpike
&#9;&#9;W4.C0 = CFrame.new(-0.5,0.8,0) * CFrame.fromEulerAnglesXYZ(0.3*math.pi,0,0.2*math.pi)
&#9;&#9;W4.C1 = CFrame.new(0,-1.4,0)
&#9;&#9;RSpike.Anchored = false
&#9;&#9;LSpike.Anchored = false
&#9;&#9;for i = 1, 0, -0.1 do
&#9;&#9;&#9;RSpike.Transparency = i
&#9;&#9;&#9;LSpike.Transparency = i
&#9;&#9;&#9;wait(0.05)
&#9;&#9;end
&#9;&#9;RSpike.Transparency = 0
&#9;&#9;LSpike.Transparency = 0
&#9;&#9;local RSpike2 = MP.Spike:clone()
&#9;&#9;local LSpike2 = MP.Spike:clone()
&#9;&#9;RSpike2.Parent = Char
&#9;&#9;LSpike2.Parent = Char
&#9;&#9;local W5 = Instance.new(&quot;Weld&quot;)
&#9;&#9;W5.Parent = T
&#9;&#9;W5.Name = &quot;Torso To RSpike2&quot;
&#9;&#9;W5.Part0 = T
&#9;&#9;W5.Part1 = RSpike2
&#9;&#9;W5.C0 = CFrame.new(0.2,0.4,0) * CFrame.fromEulerAnglesXYZ(0.4*math.pi,0,-0.2*math.pi)
&#9;&#9;W5.C1 = CFrame.new(0,-1.4,0)
&#9;&#9;local W6 = Instance.new(&quot;Weld&quot;)
&#9;&#9;W6.Parent = T
&#9;&#9;W6.Name = &quot;Torso To RSpike2&quot;
&#9;&#9;W6.Part0 = T
&#9;&#9;W6.Part1 = LSpike2
&#9;&#9;W6.C0 = CFrame.new(-0.2,0.4,0) * CFrame.fromEulerAnglesXYZ(0.4*math.pi,0,0.2*math.pi)
&#9;&#9;W6.C1 = CFrame.new(0,-1.4,0)
&#9;&#9;RSpike2.Anchored = false
&#9;&#9;LSpike2.Anchored = false
&#9;&#9;for i = 1, 0, -0.1 do
&#9;&#9;&#9;RSpike2.Transparency = i
&#9;&#9;&#9;LSpike2.Transparency = i
&#9;&#9;&#9;wait(0.05)
&#9;&#9;end
&#9;&#9;RSpike2.Transparency = 0
&#9;&#9;LSpike2.Transparency = 0]]
&#9;&#9;Finished = true
&#9;end
&#9;if Finished then
&#9;&#9;M.Button1Down:connect(function()
&#9;&#9;&#9;local L1 = MP.Laser:clone()
&#9;&#9;&#9;local Num = math.random(0,1)
&#9;&#9;&#9;if Num == 0 then
&#9;&#9;&#9;&#9;L1.BrickColor = BrickColor.new(&quot;Institutional white&quot;)
&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;L1.BrickColor = BrickColor.new(&quot;Black&quot;)
&#9;&#9;&#9;end
--&#9;&#9;&#9;local L2 = MP.Laser:clone()
&#9;&#9;&#9;local CF1 = Skull.CFrame * CFrame.new(-0.2,0.2,-1)
--&#9;&#9;&#9;local CF2 = Skull.CFrame * CFrame.new(-0.3,-0.15,0)
&#9;&#9;&#9;local D1 = (Vector3.new(CF1.X,CF1.Y,CF1.Z)-M.Hit.p).magnitude
--&#9;&#9;&#9;local D2 = (Vector3.new(CF2.X,CF2.Y,CF2.Z)-M.Hit.p).magnitude
&#9;&#9;&#9;if D1 &gt; 300 then return end
&#9;&#9;&#9;L1.Size = Vector3.new(1,D1,1)
--&#9;&#9;&#9;L2.Size = Vector3.new(1,D2,1)
&#9;&#9;&#9;L1.Mesh.Scale = Vector3.new(D1/10,L1.Size.y*(26.8/20),D1/10)
--&#9;&#9;&#9;L2.Mesh.Scale = Vector3.new(0.2,D2/L2.Size.y,0.2)
&#9;&#9;&#9;L1.CFrame = CFrame.new(CF1.p,M.Hit.p) * CFrame.fromEulerAnglesXYZ(math.pi/2,0,0) * CFrame.new(0,-D1/2,0)
--&#9;&#9;&#9;L2.CFrame = CFrame.new(Vector3.new(CF2.X,CF2.Y,CF2.Z),M.Hit.p) * CFrame.fromEulerAnglesXYZ(math.pi/2,0,0) * CFrame.new(0,-D2/2,0)
&#9;&#9;&#9;L1.Parent = game.Workspace
--&#9;&#9;&#9;L2.Parent = game.Workspace
&#9;&#9;&#9;L1.Touched:connect(function(Hit)
&#9;&#9;&#9;&#9;local hum = Hit.Parent:findFirstChild(&quot;Humanoid&quot;) or Hit.Parent:findFirstChild(&quot;Zombie&quot;)
&#9;&#9;&#9;&#9;if hum:IsA(&quot;Humanoid&quot;) and hum ~= Hum then
&#9;&#9;&#9;&#9;&#9;hum.Health = hum.Health - 25
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end)
--[[&#9;&#9;&#9;L2.Touched:connect(function(Hit)
&#9;&#9;&#9;&#9;local hum = Hit.Parent:findFirstChild(&quot;Humanoid&quot;) or Hit.Parent:findFirstChild(&quot;Zombie&quot;)
&#9;&#9;&#9;&#9;if hum:IsA(&quot;Humanoid&quot;) and hum ~= Hum then
&#9;&#9;&#9;&#9;&#9;hum.Health = hum.Health - 25
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end)]]
&#9;&#9;&#9;for i = 0, 1, 0.2 do
&#9;&#9;&#9;&#9;wait(0.05)
&#9;&#9;&#9;&#9;L1.Transparency = i
--&#9;&#9;&#9;&#9;L2.Transparency = i
&#9;&#9;&#9;end
&#9;&#9;&#9;L1:remove()
--&#9;&#9;&#9;L2:remove()
&#9;&#9;end)
&#9;&#9;while true do wait(0.1)
&#9;&#9;&#9;local PosCF = H.CFrame*CFrame.new(0.2,-0.2,0)
&#9;&#9;&#9;local LookCF = CFrame.new(PosCF.p, M.Hit.p)*CFrame.new(0,0.4,-0.5)
&#9;&#9;&#9;local CJ = CFrame.new(H.Position)
&#9;&#9;&#9;local C0 = H.CFrame:inverse()*CJ
&#9;&#9;&#9;local C1 = LookCF:inverse()*CJ
&#9;&#9;&#9;W.C0 = C0
&#9;&#9;&#9;W.C1 = C1
&#9;&#9;&#9;wait(0.05)
&#9;&#9;end
&#9;end
end)

Tool.Deselected:connect(function()
&#9;if Finished then W.C0 = CFrame.new(0.2,0.2,-0.5) W.C1 = CFrame.new(0,0,0) end
&#9;Selected = false
end)
</ProtectedString>
					</Properties>
				</Item>
			</Item>
			<Item class="HopperBin" referent="RBX28900">
				<Properties>
					<bool name="Active">false</bool>
					<token name="BinType">0</token>
					<string name="Name">Expand</string>
					<Content name="TextureId"><null></null></Content>
				</Properties>
				<Item class="LocalScript" referent="RBX28901">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Controle</string>
						<ProtectedString name="Source">local Tool = script.Parent
local Player = Tool.Parent.Parent

local Base = nil
for _,Child in pairs(game.Workspace.Bases:children()) do
&#9;if Child.Owner.Value == Player.Name then
&#9;&#9;Base = Child
&#9;end
end

local Sel = nil
local SelB = nil
local SelP
local Han = nil

local Dis = 0

while not Player.Character do wait(0.1) end wait(0.5)

function Alert(Msg)
&#9;local Alerts = Player.PlayerGui:findFirstChild(&quot;Alert&quot;)
&#9;if Alerts then
&#9;&#9;local msg = Instance.new(&quot;StringValue&quot;)
&#9;&#9;msg.Name = &quot;Msg&quot;
&#9;&#9;msg.Value = Msg
&#9;&#9;msg.Parent = Alerts.Controle
&#9;end
end

function GetModelPart(Obj)
&#9;local ToReturn = nil
&#9;if Obj.Parent == Base.Parts then
&#9;&#9;ToReturn = Obj
&#9;elseif Obj.Parent == game or Obj.Parent == game.Workspace or Obj.Parent == nil then
&#9;&#9;ToReturn = nil
&#9;else
&#9;&#9;ToReturn = GetModelPart(Obj.Parent)
&#9;end
&#9;return ToReturn
end

function GetParts(Obj)
&#9;local P = {}
&#9;local z = false
&#9;for _,Class in pairs({&quot;Part&quot;,&quot;WedgePart&quot;,&quot;TrussPart&quot;,&quot;CornerWedgePart&quot;}) do
&#9;&#9;if Obj:IsA(Class) then
&#9;&#9;&#9;z = true
&#9;&#9;&#9;table.insert(P,Obj)
&#9;&#9;end
&#9;end
&#9;if not z then
&#9;&#9;for _,Child in pairs(Obj:children()) do
&#9;&#9;&#9;local Ps = GetParts(Child)
&#9;&#9;&#9;for _,child in pairs(Ps) do
&#9;&#9;&#9;&#9;table.insert(P,child)
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
&#9;return P
end

Tool.Selected:connect(function(M)
&#9;if not Base then
&#9;&#9;for _,Child in pairs(game.Workspace.Bases:children()) do
&#9;&#9;&#9;if Child.Owner.Value == Player.Name then
&#9;&#9;&#9;&#9;Base = Child
&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;if not Base then return end
&#9;end
&#9;SelB = Instance.new(&quot;SelectionBox&quot;)
&#9;SelB.Color = BrickColor.new(&quot;Black&quot;)
&#9;SelB.Parent = Player.PlayerGui
&#9;SelP = Instance.new(&quot;Part&quot;)
&#9;SelP.Anchored = true
&#9;SelP.formFactor = Enum.FormFactor.Custom
&#9;Han = Instance.new(&quot;Handles&quot;)
&#9;Han.Color = BrickColor.new(&quot;Black&quot;)
&#9;Han.Parent = Player.PlayerGui
&#9;Han.MouseButton1Down:connect(function()
&#9;&#9;Dis = 0
&#9;end)
&#9;Han.MouseDrag:connect(function(Normal, AddDis)
&#9;&#9;local Change = math.floor((AddDis-Dis)/4+0.5)*4
&#9;&#9;local LeftOver = (AddDis-Dis)-Change
&#9;&#9;local CurSize = Sel.Size.Value
&#9;&#9;local CurCent = Sel.CenterCF.Value
&#9;&#9;if Change ~= 0 then
&#9;&#9;&#9;local Face = Vector3.FromNormalId(Normal)
&#9;&#9;&#9;local CFMult = 1
&#9;&#9;&#9;if Face.x &lt; 0 or Face.y &lt; 0 or Face.z &lt; 0 then
&#9;&#9;&#9;&#9;Change = -Change
&#9;&#9;&#9;&#9;CFMult = -1
&#9;&#9;&#9;end
&#9;&#9;&#9;local z = true
&#9;&#9;&#9;if Change*CFMult &lt; 0 then
&#9;&#9;&#9;&#9;local Size = CurSize + (Face*Change)
&#9;&#9;&#9;&#9;if Size.x &gt;= 4 and Size.y &gt;= 4 and Size.z &gt;= 4 then
--&#9;&#9;&#9;&#9;&#9;print(&quot;Method 1&quot;)
&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;z = false
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;local Pos = (CurCent * CFrame.new((Face*(CurSize/2))+(Face*(Change)*CFMult)))-Base.Center.Position
&#9;&#9;&#9;&#9;local BSize = Base.Center.Size/2
&#9;&#9;&#9;&#9;if Pos.x &lt;= BSize.x and Pos.x &gt;= -BSize.x and Pos.y &gt; 0 and Pos.z &lt;= BSize.z and Pos.z &gt;= -BSize.z then
--&#9;&#9;&#9;&#9;&#9;print(&quot;Method 2&quot;)
&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;z = false
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;&#9;--Player.PlayerGui.SPL.Point = Pos.p
&#9;&#9;&#9;if z then
--&#9;&#9;&#9;&#9;&#9;local Pos = (CurCent * CFrame.new((Face*(CurSize/2))+(Face*(Change)*CFMult)))
--&#9;&#9;&#9;&#9;&#9;Player.PlayerGui.SPL.Point = Pos.p
&#9;&#9;&#9;&#9;local NewCent = CurCent * CFrame.new(Face*(Change/2)*CFMult)
&#9;&#9;&#9;&#9;local NewSize = CurSize + (Face*Change)
&#9;&#9;&#9;&#9;Dis = AddDis-LeftOver
&#9;&#9;&#9;&#9;Sel.CenterCF.Value = NewCent
&#9;&#9;&#9;&#9;Sel.Size.Value = NewSize
&#9;&#9;&#9;&#9;for _,Part in pairs(GetParts(Sel)) do
&#9;&#9;&#9;&#9;&#9;if not Sel.Resizeable:findFirstChild(&quot;Auto&quot;) then
&#9;&#9;&#9;&#9;&#9;&#9;Part.Size = NewSize
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;Part.CFrame = NewCent*Part.CF.Value
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;SelP.Size = NewSize
&#9;&#9;&#9;&#9;SelP.CFrame = NewCent
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end)
&#9;M.Move:connect(function()
&#9;&#9;local Tar = M.Target
&#9;&#9;if Sel then return end
&#9;&#9;if Tar then
&#9;&#9;&#9;if Tar:IsDescendantOf(Base.Parts) then
&#9;&#9;&#9;&#9;local Part = GetModelPart(Tar)
&#9;&#9;&#9;&#9;if Part:findFirstChild(&quot;Resizeable&quot;) then
&#9;&#9;&#9;&#9;&#9;SelP.Size = Part.Size.Value
&#9;&#9;&#9;&#9;&#9;SelP.CFrame = Part.CenterCF.Value
&#9;&#9;&#9;&#9;&#9;SelB.Adornee = SelP
&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;SelB.Adornee = nil
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;SelB.Adornee = nil
&#9;&#9;&#9;end
&#9;&#9;else
&#9;&#9;&#9;SelB.Adornee = nil
&#9;&#9;end
&#9;end)
&#9;M.Button1Down:connect(function()
&#9;&#9;local Tar = M.Target
&#9;&#9;if Tar then
&#9;&#9;&#9;if Tar:IsDescendantOf(Base.Parts) then
&#9;&#9;&#9;&#9;local Part = GetModelPart(Tar)
&#9;&#9;&#9;&#9;if Part:findFirstChild(&quot;Resizeable&quot;) and Part ~= Sel then
&#9;&#9;&#9;&#9;&#9;SelP.Size = Part.Size.Value
&#9;&#9;&#9;&#9;&#9;SelP.CFrame = Part.CenterCF.Value
&#9;&#9;&#9;&#9;&#9;SelB.Adornee = SelP
&#9;&#9;&#9;&#9;&#9;Sel = Part
&#9;&#9;&#9;&#9;&#9;Han.Adornee = SelP
&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;SelB.Adornee = nil
&#9;&#9;&#9;&#9;&#9;Sel = nil
&#9;&#9;&#9;&#9;&#9;Han.Adornee = nil
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;SelB.Adornee = nil
&#9;&#9;&#9;&#9;Sel = nil
&#9;&#9;&#9;&#9;Han.Adornee = nil
&#9;&#9;&#9;end
&#9;&#9;else
&#9;&#9;&#9;SelB.Adornee = nil
&#9;&#9;&#9;Sel = nil
&#9;&#9;&#9;Han.Adornee = nil
&#9;&#9;end
&#9;end)
end)

Tool.Deselected:connect(function()
&#9;if SelB then SelB:remove() end
&#9;if Han then Han:remove() end
&#9;Sel = nil
end)
</ProtectedString>
					</Properties>
				</Item>
			</Item>
			<Item class="HopperBin" referent="RBX28902">
				<Properties>
					<bool name="Active">false</bool>
					<token name="BinType">0</token>
					<string name="Name">Morph</string>
					<Content name="TextureId"><null></null></Content>
				</Properties>
				<Item class="LocalScript" referent="RBX28903">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Controle</string>
						<ProtectedString name="Source">local Tool = script.Parent
local Morphing = false
local Finished = false
local Turret = false
local MP = game.Lighting.Morph_Pack
local W = nil
local Skull = nil
local Ball = nil

function ArmW(LSa, RSa)
&#9;local LA,RA = Char:findFirstChild(&quot;Left Arm&quot;), Char:findFirstChild(&quot;Right Arm&quot;)
&#9;pcall(function() LA.Weld:remove() end)
&#9;pcall(function() RA.Weld:remove() end)
&#9;if LA and pcall(function() Char.Torso[&quot;Left Shoulder&quot;].Part1 = nil end) then
&#9;&#9;local w = Instance.new(&quot;Weld&quot;, LA)
&#9;&#9;w.Part0 = Char.Torso
&#9;&#9;w.Part1 = LA
&#9;&#9;w.C0 = LSa
&#9;&#9;w.C1 = Char.Torso[&quot;Left Shoulder&quot;].C1
&#9;end
&#9;if RA and pcall(function() Char.Torso[&quot;Right Shoulder&quot;].Part1 = nil end) then
&#9;&#9;local w = Instance.new(&quot;Weld&quot;, RA)
&#9;&#9;w.Part0 = Char.Torso
&#9;&#9;w.Part1 = RA
&#9;&#9;w.C0 = RSa
