						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Controle</string>
						<ProtectedString name="Source">local Alerts = {}
local AlertAction = &quot;Close&quot;
local AlertBar = script.Parent

script.ChildAdded:connect(function(Child)
&#9;if Child:IsA(&quot;StringValue&quot;) and Child.Name == &quot;Msg&quot; then
&#9;&#9;local z = true
&#9;&#9;for _,msg in pairs(Alerts) do
&#9;&#9;&#9;if msg == Child.Value then
&#9;&#9;&#9;&#9;z = false
&#9;&#9;&#9;&#9;break
&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;if AlertBar.F.Text.Text == Child.Value then
&#9;&#9;&#9;z = false
&#9;&#9;end
&#9;&#9;if z then
&#9;&#9;&#9;table.insert(Alerts, Child.Value)
&#9;&#9;end
&#9;end
&#9;wait(0.1)
&#9;Child:remove()
end)

while true do
&#9;if #Alerts &gt; 0 then
&#9;&#9;AlertBar.F.Text.Text = Alerts[1]
&#9;&#9;table.remove(Alerts,1)
&#9;&#9;if AlertAction == &quot;Close&quot; then
&#9;&#9;&#9;for i = -10, 0, 1 do
&#9;&#9;&#9;&#9;AlertBar.F.Position = UDim2.new(0,i*20,0.939,-50)
&#9;&#9;&#9;&#9;wait(0.04)
&#9;&#9;&#9;end
&#9;&#9;&#9;AlertAction = &quot;Open&quot;
&#9;&#9;end
&#9;&#9;for i = 10, 0, -1 do
&#9;&#9;&#9;AlertBar.F.Text.TextTransparency = i/10
&#9;&#9;&#9;wait(0.05)
&#9;&#9;end
&#9;&#9;wait(5)
&#9;&#9;for i = 0, 10, 1 do
&#9;&#9;&#9;AlertBar.F.Text.TextTransparency = i/10
&#9;&#9;&#9;wait(0.05)
&#9;&#9;end
&#9;&#9;AlertBar.F.Text.Text = &quot;&quot;
&#9;elseif #Alerts == 0 and AlertAction == &quot;Open&quot; then
&#9;&#9;for i = 0, -10, -1 do
&#9;&#9;&#9;AlertBar.F.Position = UDim2.new(0,i*20,0.939,-50)
&#9;&#9;&#9;wait(0.04)
&#9;&#9;end
&#9;&#9;AlertAction = &quot;Close&quot;
&#9;else
&#9;&#9;wait(1)
&#9;end
end
</ProtectedString>
					</Properties>
				</Item>
			</Item>
