&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;obj.Parent = z.Parts
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;local Scripts = obj:findFirstChild(&quot;Scripts&quot;)
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;if Scripts then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;for _,Scr in pairs(Scripts:children()) do
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;Scr.Disabled = false
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;script.Parent.Parent.Wait.Lab.Text = &quot;Loading Creation, Please Wait (&quot;..((i-1)*2)..&quot;/&quot;..Tot..&quot;)&quot;
&#9;&#9;&#9;&#9;wait()
&#9;&#9;&#9;end
&#9;&#9;&#9;Waiting = false
&#9;&#9;&#9;script.Parent.Parent.Wait.Visible = false
&#9;&#9;end
&#9;else
&#9;&#9;Alert(&quot;You don&apos;t have a base yet.&quot;)
&#9;end
end)

script.Parent.MouseButton1Down:connect(function()
&#9;LoadData()
&#9;if Waiting then return end
&#9;local z = nil
&#9;for _,Base in pairs(game.Workspace.Bases:children()) do
&#9;&#9;if Base.Owner.Value == Player.Name then
&#9;&#9;&#9;z = Base
&#9;&#9;&#9;break
&#9;&#9;end
&#9;end
&#9;if z then
&#9;&#9;if script.Parent.Parent.Table.Visible then
&#9;&#9;&#9;script.Parent.Parent.Table.Visible = false
&#9;&#9;&#9;script.Parent.Parent.DataControle.Visible = false
&#9;&#9;&#9;script.Parent.Parent.New.Visible = false
&#9;&#9;&#9;local BG = script.Parent.Parent.Parent:findFirstChild(&quot;BuildGui&quot;)
&#9;&#9;&#9;if not BG then
&#9;&#9;&#9;&#9;local Chat = script.Parent.Parent.Parent.Chat
&#9;&#9;&#9;&#9;Chat.MsgsF.Visible = true
&#9;&#9;&#9;end
&#9;&#9;else
&#9;&#9;&#9;local BG = script.Parent.Parent.Parent:findFirstChild(&quot;BuildGui&quot;)
&#9;&#9;&#9;if not BG then
&#9;&#9;&#9;&#9;script.Parent.Parent.DataControle.Visible = false
&#9;&#9;&#9;&#9;script.Parent.Parent.New.Visible = false
&#9;&#9;&#9;&#9;local Chunks = GetSaveChunks()
&#9;&#9;&#9;&#9;script.Parent.Parent.Table.Visible = true
&#9;&#9;&#9;&#9;script.Parent.Parent.Table.Size = UDim2.new(0,500,0,80+(#Chunks*15))
&#9;&#9;&#9;&#9;for _,Save in pairs(script.Parent.Parent.Table.Saves:children()) do
&#9;&#9;&#9;&#9;&#9;Save:remove()
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;local TotalSize = 0
&#9;&#9;&#9;&#9;for i,Chunk in pairs(Chunks) do
&#9;&#9;&#9;&#9;&#9;local Save = script.Parent.Parent.Save:clone()
&#9;&#9;&#9;&#9;&#9;Save.Parent = script.Parent.Parent.Table.Saves
&#9;&#9;&#9;&#9;&#9;Save.AppSize.Text = #Chunk.Text
&#9;&#9;&#9;&#9;&#9;TotalSize = TotalSize + #Chunk.Text
&#9;&#9;&#9;&#9;&#9;Save.SaveName.Text = Chunk.Name
&#9;&#9;&#9;&#9;&#9;Save.ObjNum.Text = #Chunk.Parts
&#9;&#9;&#9;&#9;&#9;Save.Position = UDim2.new(0,0,0,(i-1)*15)
&#9;&#9;&#9;&#9;&#9;Save.Visible = true
&#9;&#9;&#9;&#9;&#9;Save.Button.MouseButton1Down:connect(function()
&#9;&#9;&#9;&#9;&#9;&#9;script.Parent.Parent.Table.Visible = false
&#9;&#9;&#9;&#9;&#9;&#9;script.Parent.Parent.DataControle.Visible = true
&#9;&#9;&#9;&#9;&#9;&#9;CurrentDataChunk = Chunk
&#9;&#9;&#9;&#9;&#9;&#9;local Chat = script.Parent.Parent.Parent.Chat
&#9;&#9;&#9;&#9;&#9;&#9;Chat.MsgsF.Visible = true
&#9;&#9;&#9;&#9;&#9;end)
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;local Chat = script.Parent.Parent.Parent.Chat
&#9;&#9;&#9;&#9;Chat.MsgsF.Visible = false
&#9;&#9;&#9;&#9;script.Parent.Parent.Table.AppSize.Text = &quot;Size (Approximate) : &quot;..TotalSize..&quot;/45000&quot;
&#9;&#9;&#9;end
&#9;&#9;end
&#9;else
&#9;&#9;Alert(&quot;You don&apos;t have a base yet.&quot;)
&#9;end
end)
