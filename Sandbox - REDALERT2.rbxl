				<Item class="Script" referent="RBX155">
					<Properties>
						<bool name="Disabled">true</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Walk</string>
						<ProtectedString name="Source">local Figure = script.Parent
local Hum = Figure.Humanoid
local Tor = Figure.Torso
local Dialog = Figure.Head.Dialog

local WalkPoint = 0

Tor.Touched:connect(function(Obj)
&#9;if Obj.Name == &quot;Torso&quot; and Dialog.InUse == false then
&#9;&#9;Hum.Jump = true
&#9;end
end)

function WalkTo(Point)
&#9;local DisFromPoint = (Tor.Position-Vector3.new(Point.x,Tor.Position.y,Point.z)).magnitude
&#9;local TakenTime = 0
&#9;local LoopTime = 0
&#9;while Hum.Health &gt; 0 and Figure.Parent do wait(0.1)
&#9;&#9;if Hum.Sit then Hum.Sit = false end
&#9;&#9;if Dialog.InUse then
&#9;&#9;&#9;DisFromPoint = (Tor.Position-Vector3.new(Point.x,Tor.Position.y,Point.z)).magnitude
&#9;&#9;&#9;Hum:MoveTo(Tor.Position,Tor)
&#9;&#9;else
&#9;&#9;&#9;local Dis = (Vector3.new(Point.x,Tor.Position.y,Point.z)-Tor.Position)
&#9;&#9;&#9;TakenTime = TakenTime + 0.1
&#9;&#9;&#9;LoopTime = LoopTime + 0.1
&#9;&#9;&#9;if TakenTime &gt; 30 then
&#9;&#9;&#9;&#9;Figure:MoveTo(Point)
&#9;&#9;&#9;elseif LoopTime &gt; 2 then
&#9;&#9;&#9;&#9;LoopTime = 0
&#9;&#9;&#9;&#9;if Dis.magnitude + 1 &gt; DisFromPoint then
&#9;&#9;&#9;&#9;&#9;Figure:MoveTo(Tor.Position+(Dis.Unit*8))
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;DisFromPoint = Dis.magnitude
&#9;&#9;&#9;end
&#9;&#9;&#9;if Dis.magnitude &gt; 4 then
&#9;&#9;&#9;&#9;Hum:MoveTo(Point,game.Workspace.Base)
&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;break
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end

while Hum.Health &gt; 0 and Figure.Parent do wait(4)
&#9;if WalkPoint == 0 then
&#9;&#9;WalkPoint = 1
&#9;&#9;WalkTo(Vector3.new(-70,0,0))
&#9;elseif WalkPoint == 1 then
&#9;&#9;WalkPoint = 2
&#9;&#9;WalkTo(Vector3.new(-70,0,-70))
&#9;elseif WalkPoint == 2 then
&#9;&#9;WalkPoint = 3
&#9;&#9;WalkTo(Vector3.new(70,0,-70))
&#9;elseif WalkPoint == 3 then
&#9;&#9;WalkPoint = 4
&#9;&#9;WalkTo(Vector3.new(70,0,70))
&#9;elseif WalkPoint == 4 then
&#9;&#9;WalkPoint = 1
&#9;&#9;WalkTo(Vector3.new(-70,0,70))
&#9;end
end
</ProtectedString>
