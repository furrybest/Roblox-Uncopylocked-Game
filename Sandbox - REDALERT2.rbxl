					<Item class="Dialog" referent="RBX28786">
						<Properties>
							<float name="ConversationDistance">25</float>
							<string name="InitialPrompt">Hello, I&apos;m the Sandbox Help Bot! Do you need something?</string>
							<string name="Name">Dialog</string>
							<token name="Purpose">1</token>
							<token name="Tone">1</token>
						</Properties>
						<Item class="DialogChoice" referent="RBX28787">
							<Properties>
								<string name="Name">DC1</string>
								<string name="ResponseDialog">Sandbox is a game for building whatever you&apos;d like to.</string>
								<string name="UserDialog">What is Sandbox?</string>
							</Properties>
						</Item>
						<Item class="DialogChoice" referent="RBX28788">
							<Properties>
								<string name="Name">DC2</string>
								<string name="ResponseDialog">Select your Shovel tool. Then click on an unused base for it to be yours!</string>
								<string name="UserDialog">How would I start building?</string>
							</Properties>
						</Item>
						<Item class="DialogChoice" referent="RBX28789">
							<Properties>
								<string name="Name">DC3</string>
								<string name="ResponseDialog">Which tool do you need help with?</string>
								<string name="UserDialog">I need to know something about one of the tools.</string>
							</Properties>
							<Item class="DialogChoice" referent="RBX28790">
								<Properties>
									<string name="Name">DC1</string>
									<string name="ResponseDialog">Okay, now what is your problem/question about it?</string>
									<string name="UserDialog">Shovel Tool</string>
								</Properties>
								<Item class="DialogChoice" referent="RBX28791">
									<Properties>
										<string name="Name">DC1</string>
										<string name="ResponseDialog">That happens when you select the tool multiple times before you select a base. You can just reset to fix that.</string>
										<string name="UserDialog">The selection gui stays up when I deselect the t</string>
									</Properties>
								</Item>
								<Item class="DialogChoice" referent="RBX28792">
									<Properties>
										<string name="Name">DC2</string>
										<string name="ResponseDialog">If you have suggestions about more building objects you can make a post on the Sandbox Fan Club group wall.</string>
										<string name="UserDialog">I want more to build with.</string>
									</Properties>
								</Item>
							</Item>
							<Item class="DialogChoice" referent="RBX28793">
								<Properties>
									<string name="Name">DC2</string>
									<string name="ResponseDialog">Okay, now what is your problem/question about it?</string>
									<string name="UserDialog">Config Tool</string>
								</Properties>
								<Item class="DialogChoice" referent="RBX28794">
									<Properties>
										<string name="Name">DC1</string>
										<string name="ResponseDialog">This tool is used for editting special properties of certain objects. Such as moving spikes or a door.</string>
										<string name="UserDialog">What is it for?</string>
									</Properties>
								</Item>
								<Item class="DialogChoice" referent="RBX28795">
									<Properties>
										<string name="Name">DC2</string>
										<string name="ResponseDialog">Click on an object on your base such as a door. Anything you can configure will have a grey box around it.</string>
										<string name="UserDialog">How do I use it?</string>
									</Properties>
								</Item>
								<Item class="DialogChoice" referent="RBX28796">
									<Properties>
										<string name="Name">DC3</string>
										<string name="ResponseDialog">Okay, this is a tricky object so listen up. Also teleporting it sometimes glitchy.</string>
										<string name="UserDialog">Teleporter</string>
									</Properties>
									<Item class="DialogChoice" referent="RBX28797">
										<Properties>
											<string name="Name">DC1</string>
											<string name="ResponseDialog">This is the ID of the teleporter you are configuring. Set it for whatever you want.</string>
											<string name="UserDialog">TeleporterId</string>
										</Properties>
									</Item>
									<Item class="DialogChoice" referent="RBX28798">
										<Properties>
											<string name="Name">DC2</string>
											<string name="ResponseDialog">The TeleporterId of the teleporter this teleporter will teleport a player to.</string>
											<string name="UserDialog">TeleportToId</string>
										</Properties>
									</Item>
								</Item>
							</Item>
							<Item class="DialogChoice" referent="RBX28799">
								<Properties>
									<string name="Name">DC3</string>
									<string name="ResponseDialog">Okay, now what is your problem/question about it?</string>
									<string name="UserDialog">Expand (Resize) Tool</string>
								</Properties>
								<Item class="DialogChoice" referent="RBX28800">
									<Properties>
										<string name="Name">DC1</string>
										<string name="ResponseDialog">This tool is currently a VIP item.</string>
										<string name="UserDialog">Where do I get it?</string>
									</Properties>
								</Item>
								<Item class="DialogChoice" referent="RBX28801">
									<Properties>
										<string name="Name">DC2</string>
										<string name="ResponseDialog">Currently this tool is needing updates to work properly with resizing other objects.</string>
										<string name="UserDialog">Why can I only resize blocks and wedges with it?</string>
									</Properties>
								</Item>
							</Item>
						</Item>
						<Item class="DialogChoice" referent="RBX28802">
							<Properties>
								<string name="Name">DC4</string>
								<string name="ResponseDialog">Like what?</string>
								<string name="UserDialog">I&apos;d like to know something else.</string>
							</Properties>
							<Item class="DialogChoice" referent="RBX28803">
								<Properties>
									<string name="Name">DC1</string>
									<string name="ResponseDialog">Version: 1.3 | This fixed water loading and made more blocks resizeable.</string>
									<string name="UserDialog">What is the current server version?</string>
								</Properties>
							</Item>
							<Item class="DialogChoice" referent="RBX28804">
								<Properties>
									<string name="Name">DC2</string>
									<string name="ResponseDialog">First we start with the gui button Save/Load in the bottom right corner of your screen. You need to click that.</string>
									<string name="UserDialog">How do I save my creations?</string>
								</Properties>
								<Item class="DialogChoice" referent="RBX28805">
									<Properties>
										<string name="Name">DC1</string>
										<string name="ResponseDialog">Click on the button to create a new save. Type in the name of your creation then click Confirm.</string>
										<string name="UserDialog">[New]</string>
									</Properties>
								</Item>
								<Item class="DialogChoice" referent="RBX28806">
									<Properties>
										<string name="Name">DC2</string>
										<string name="ResponseDialog">Open the Save/Load menu and click on the save in the table. You can Save Over, Load, and Delete there.</string>
										<string name="UserDialog">How do I use a save that I already have?</string>
									</Properties>
								</Item>
								<Item class="DialogChoice" referent="RBX28807">
									<Properties>
										<string name="Name">DC3</string>
										<string name="ResponseDialog">Currently that is trying to be fixed. Many players complain that they get kicked from the game when they try to save.</string>
										<string name="UserDialog">Saving doesn&apos;t work for me.</string>
									</Properties>
								</Item>
								<Item class="DialogChoice" referent="RBX28808">
									<Properties>
										<string name="Name">DC4</string>
										<string name="ResponseDialog">That tells your save status. Put your mouse over it for about a second for it to tell you your current status.</string>
										<string name="UserDialog">What is the circle thing near the Save/Load menu</string>
									</Properties>
								</Item>
							</Item>
						</Item>
					</Item>
				</Item>
