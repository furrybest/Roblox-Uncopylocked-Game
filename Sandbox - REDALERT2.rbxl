&#9;&#9;for i = 1, math.ceil(Tot/20) do
&#9;&#9;&#9;for o = 1, 20 do
&#9;&#9;&#9;&#9;local Part = Parts[(i-1)*20+o]
&#9;&#9;&#9;&#9;if not Part then break end
&#9;&#9;&#9;&#9;local X,Y,Z = Part.CenterCF.Value.X-z.Center.Position.x,Round((Part.CenterCF.Value.Y-z.Center.Position.y)/0.1)*0.1,Part.CenterCF.Value.Z-z.Center.Position.z
&#9;&#9;&#9;&#9;local x,y,z = Part.CenterCF.Value:toEulerAnglesXYZ()
&#9;&#9;&#9;&#9;local GB
&#9;&#9;&#9;&#9;for _,Set in pairs(game.Lighting[&quot;Game Blocks&quot;]:children()) do
&#9;&#9;&#9;&#9;&#9;if GB then break end
&#9;&#9;&#9;&#9;&#9;for _,P in pairs(Set:children()) do
&#9;&#9;&#9;&#9;&#9;&#9;if P.Name == Part.Name then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;GB = P
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;local Size = &quot;&quot;
&#9;&#9;&#9;&#9;if Part:findFirstChild(&quot;Resizeable&quot;) then
&#9;&#9;&#9;&#9;&#9;if GB then
&#9;&#9;&#9;&#9;&#9;&#9;if GB.Center.Size ~= Part.Size.Value then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;Size = &quot;,S=&quot;..Part.Size.Value.x..&quot;&apos;&quot;..Part.Size.Value.y..&quot;&apos;&quot;..Part.Size.Value.z
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;local Props = &quot;&quot;
&#9;&#9;&#9;&#9;if Part:findFirstChild(&quot;Properties&quot;) then
&#9;&#9;&#9;&#9;&#9;if GB then
&#9;&#9;&#9;&#9;&#9;&#9;for _,Prop in pairs(Part.Properties:children()) do
&#9;&#9;&#9;&#9;&#9;&#9;&#9;if Prop.Value == &quot;String&quot; or Prop.Value == &quot;Number&quot; then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;if GB.Properties[Prop.Name].Var.Value ~= Prop.Var.Value then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;Props = Props..&quot;,&quot;..Prop.Name..&quot;=&quot;..Prop.Value..&quot;~&quot;..Prop.Var.Value
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;&#9;elseif Prop.Value == &quot;Boolean&quot; then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;if GB.Properties[Prop.Name].Var.Value ~= Prop.Var.Value then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;if Prop.Var.Value == true then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;Props = Props..&quot;,&quot;..Prop.Name..&quot;=&quot;..Prop.Value..&quot;~y&quot;
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;Props = Props..&quot;,&quot;..Prop.Name..&quot;=&quot;..Prop.Value..&quot;~n&quot;
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;String = String..&quot;{&quot;..Part.ObjNum.Value..&quot;/&quot;..X..&quot;,&quot;..(Y*10)..&quot;,&quot;..Z..&quot;,&quot;..(Round(((x*2)/math.pi)/0.1)*0.1)..&quot;,&quot;..(Round(((y*2)/math.pi)/0.1)*0.1)..&quot;,&quot;..(Round(((z*2)/math.pi)/0.1)*0.1)..Size..Props..&quot;}&quot;
&#9;&#9;&#9;end
&#9;&#9;&#9;script.Parent.Parent.Wait.Lab.Text = &quot;Saving Creation, Please Wait (&quot;..((i-1)*20)..&quot;/&quot;..Tot..&quot;)&quot;
&#9;&#9;&#9;wait()
&#9;&#9;end
&#9;&#9;script.Parent.Parent.Wait.Visible = false
&#9;&#9;Waiting = false
&#9;&#9;return String..&quot;|&quot;
&#9;else
&#9;&#9;Alert(&quot;You don&apos;t have a base yet.&quot;)
&#9;&#9;return nil
&#9;end
end

