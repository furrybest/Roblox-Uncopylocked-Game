									<string name="Name">Water</string>
									<ProtectedString name="Source">wait(0.1)
local Mod = script.Parent.Parent
local Water = Mod.Water
local WatLvl = Mod.Properties.WaterLevel.Var

WatLvl.Changed:connect(function()
&#9;if WatLvl.Value &gt; 4 then WatLvl.Value = 4 elseif WatLvl.Value &lt; 0 then WatLvl.Value = 0 end
&#9;Water.Mesh.Scale = Vector3.new(0,WatLvl.Value/4,1)
&#9;Water.Mesh.Offset = Vector3.new(-0.5,(WatLvl.Value-4)/2,0)
end)

if WatLvl.Value &gt; 4 then WatLvl.Value = 4 elseif WatLvl.Value &lt; 0 then WatLvl.Value = 0 end
Water.Mesh.Scale = Vector3.new(0,WatLvl.Value/4,1)
Water.Mesh.Offset = Vector3.new(-0.5,(WatLvl.Value-4)/2,0)
</ProtectedString>
