									<Content name="LinkedSource"><null></null></Content>
									<string name="Name">Tele</string>
									<ProtectedString name="Source">function waitForChild(instance, name)
&#9;while not instance:FindFirstChild(name) do
&#9;&#9;instance.ChildAdded:wait()
&#9;end
&#9;return instance:FindFirstChild(name)
end

local Props = waitForChild(script.Parent.Parent, &quot;Properties&quot;)
local TeleTo = nil
wait(0.1)

function Update()
&#9;TeleTo = nil
&#9;for _,Obj in pairs(script.Parent.Parent.Parent:children()) do
&#9;&#9;if Obj.Name == &quot;Teleporter&quot; and Obj ~= script.Parent.Parent then
&#9;&#9;&#9;if Obj.Properties.TeleporterId.Var.Value ~= &quot;&quot; and Obj.Properties.TeleporterId.Var.Value == Props.TeleportToId.Var.Value then
&#9;&#9;&#9;&#9;TeleTo = Obj
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end

Props.TeleportToId.Var.Changed:connect(function(Prop)
&#9;if Prop == &quot;Value&quot; then
&#9;&#9;Update()
&#9;end
end)

script.Parent.Parent.T.Touched:connect(function(Hit)
&#9;local H,T = Hit.Parent:findFirstChild(&quot;Humanoid&quot;),Hit.Parent:findFirstChild(&quot;Teled&quot;)
&#9;if H and H.Health &gt; 0 and not T then
&#9;&#9;if not TeleTo then
&#9;&#9;&#9;Update()
&#9;&#9;end
&#9;&#9;if TeleTo then
&#9;&#9;&#9;if TeleTo.Properties.TeleporterId.Var.Value ~= Props.TeleportToId.Var.Value then
&#9;&#9;&#9;&#9;Update()
&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;Hit.Parent:MoveTo(TeleTo.T.Position, TeleTo.T)
&#9;&#9;&#9;&#9;local t = Instance.new(&quot;StringValue&quot;)
&#9;&#9;&#9;&#9;t.Name = &quot;Teled&quot;
&#9;&#9;&#9;&#9;t.Parent = Hit.Parent
&#9;&#9;&#9;&#9;wait(1)
&#9;&#9;&#9;&#9;t:remove()
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end)
</ProtectedString>
