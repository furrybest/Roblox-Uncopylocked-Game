function IsSafeText(Text)
&#9;for i = 1, #Text do
&#9;&#9;local T = string.sub(Text,i,i)
&#9;&#9;for _,Restricted in pairs({&quot;&apos;&quot;, &quot;,&quot;, &quot;[&quot;, &quot;]&quot;, &quot;=&quot;, &quot;~&quot;, &quot;|&quot;, &quot;/&quot;, &quot;{&quot;, &quot;}&quot;}) do
