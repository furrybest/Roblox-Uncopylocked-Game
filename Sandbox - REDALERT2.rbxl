&#9;&#9;&#9;&#9;if hum:IsA(&quot;Humanoid&quot;) and hum ~= Hum then
&#9;&#9;&#9;&#9;&#9;hum.Health = hum.Health - 25
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end)
&#9;&#9;&#9;L2.Touched:connect(function(Hit)
&#9;&#9;&#9;&#9;local hum = Hit.Parent:findFirstChild(&quot;Humanoid&quot;) or Hit.Parent:findFirstChild(&quot;Zombie&quot;)
