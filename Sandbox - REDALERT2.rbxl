							<Item class="Script" referent="RBX29903">
								<Properties>
									<bool name="Disabled">true</bool>
									<Content name="LinkedSource"><null></null></Content>
									<string name="Name">Main</string>
									<ProtectedString name="Source">local Count = 0
for _,Obj in pairs(script.Parent.Parent.Parent:children()) do
&#9;if Obj.Name == &quot;Skeleton&quot; then
&#9;&#9;Count = Count+1
&#9;end
end
if Count &gt; 5 then script:remove() end
local Skel = script.Parent.Parent.Skeleton
local H = Skel.Head
local S = Skel.Skull
local Closest = nil
local Cur = 0

function GetYRot(CF)
&#9;local x = CF.lookVector.x
&#9;local z = CF.lookVector.z
&#9;if z &gt; 0 and x &gt; 0 then
&#9;&#9;return(math.atan(x/z) + math.pi)
&#9;elseif z &gt; 0 then
&#9;&#9;z = -z
&#9;&#9;return(math.atan(z/x) + math.pi/2)
&#9;else
&#9;&#9;return(math.atan(x/z))
&#9;end
end

function GetDiff()
&#9;local LookRot = GetYRot(CFrame.new(H.Position,Closest.Position))
&#9;local HeadRot = GetYRot(H.CFrame)
&#9;local Diff = LookRot - HeadRot
&#9;--print(Diff)
&#9;if Diff &lt; -math.pi then
&#9;&#9;Diff = Diff+(math.pi*2)
&#9;elseif Diff &gt; math.pi then
&#9;&#9;Diff = Diff-(math.pi*2)
&#9;end
&#9;--print(Diff)
&#9;if Diff &gt; math.pi/3 then
&#9;&#9;Diff = math.pi/3
&#9;elseif Diff &lt; -math.pi/3 then
&#9;&#9;Diff = -math.pi/3
&#9;end
&#9;return Diff
end

while true do wait(0.1)
&#9;local Dis = 20
&#9;Closest = nil
&#9;for _,Player in pairs(game.Players:children()) do
&#9;&#9;if Player.Character and Player.Character:findFirstChild(&quot;Head&quot;) then
&#9;&#9;&#9;local D = (Player.Character.Head.Position-H.Position).magnitude
&#9;&#9;&#9;if D &lt; Dis then
&#9;&#9;&#9;&#9;Dis = D
&#9;&#9;&#9;&#9;Closest = Player.Character.Head
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
&#9;if Closest then
&#9;&#9;local NDiff = GetDiff()
&#9;&#9;if Cur == NDiff then
&#9;&#9;elseif NDiff &gt; Cur then
&#9;&#9;&#9;Cur = Cur + 0.05
&#9;&#9;&#9;if Cur &gt;= NDiff then
&#9;&#9;&#9;&#9;Cur = NDiff
&#9;&#9;&#9;end
&#9;&#9;else
&#9;&#9;&#9;Cur = Cur - 0.05
&#9;&#9;end
&#9;else
&#9;&#9;if Cur == 0 then
&#9;&#9;elseif 0 &gt; Cur then
&#9;&#9;&#9;Cur = Cur + 0.05
&#9;&#9;&#9;if Cur &gt;= 0 then
&#9;&#9;&#9;&#9;Cur = 0
&#9;&#9;&#9;end
&#9;&#9;else
&#9;&#9;&#9;Cur = Cur - 0.05
&#9;&#9;end
&#9;end
&#9;S.CFrame = H.CFrame * CFrame.fromEulerAnglesXYZ(0,Cur,0)
end
</ProtectedString>
								</Properties>
							</Item>
