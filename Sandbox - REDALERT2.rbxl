									<string name="Name">Sizing</string>
									<ProtectedString name="Source">wait(0.1)
local S = script.Parent.Parent.Size
local P = script.Parent.Parent.Part
local P1 = script.Parent.Parent.Part1

S.Changed:connect(function(Prop)
&#9;local Pos = script.Parent.Parent.CenterCF.Value
&#9;P.Size = Vector3.new(S.Value.z-4,0.4,1)
&#9;P1.Size = Vector3.new(S.Value.z-4,0.4,1)
&#9;P.CFrame = Pos * P.CF.Value
&#9;P1.CFrame = Pos * P1.CF.Value
end)

local Pos = script.Parent.Parent.CenterCF.Value
P.Size = Vector3.new(S.Value.z-4,0.4,1)
P1.Size = Vector3.new(S.Value.z-4,0.4,1)
P.CFrame = Pos * P.CF.Value
P1.CFrame = Pos * P1.CF.Value
</ProtectedString>
