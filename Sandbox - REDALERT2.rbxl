&#9;&#9;&#9;L2.CFrame = CFrame.new(Vector3.new(CF2.X,CF2.Y,CF2.Z),M.Hit.p) * CFrame.fromEulerAnglesXYZ(math.pi/2,0,0) * CFrame.new(0,-D2/2,0)
