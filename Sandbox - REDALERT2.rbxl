			<Item class="HopperBin" referent="RBX28891">
				<Properties>
					<bool name="Active">false</bool>
					<token name="BinType">0</token>
					<string name="Name">Morph Duck</string>
					<Content name="TextureId"><null></null></Content>
				</Properties>
				<Item class="LocalScript" referent="RBX28892">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Controle</string>
						<ProtectedString name="Source">local Tool = script.Parent
local Morphing = false
local Finished = false
local Turret = false
local MP = game.Lighting.Morph_Pack2
local W = nil
local Skull = nil

Tool.Selected:connect(function(M)
&#9;local Player = Tool.Parent.Parent
&#9;local Char = Player.Character
&#9;if not Char then return end
&#9;local H,T,Hum,LA,RA = Char:findFirstChild(&quot;Head&quot;), Char:findFirstChild(&quot;Torso&quot;), Char:findFirstChild(&quot;Humanoid&quot;), Char:findFirstChild(&quot;Left Arm&quot;), Char:findFirstChild(&quot;Right Arm&quot;)
&#9;if not Hum or Hum.Health &lt;= 0 then return end
&#9;if not Finished or not Morphing then
&#9;&#9;Morphing = true
&#9;&#9;for _,Child in pairs(Char:children()) do
&#9;&#9;&#9;if Child:IsA(&quot;Hat&quot;) then
&#9;&#9;&#9;&#9;local Han = Child:findFirstChild(&quot;Handle&quot;)
&#9;&#9;&#9;&#9;if Han then
&#9;&#9;&#9;&#9;&#9;for i = 0, 1, 0.1 do
&#9;&#9;&#9;&#9;&#9;&#9;wait(0.05)
&#9;&#9;&#9;&#9;&#9;&#9;Han.Transparency = i
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;Child:remove()
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;local Face = H:findFirstChild(&quot;face&quot;)
&#9;&#9;if Face then Face:remove() end
&#9;&#9;for i = 0, 1, 0.1 do
&#9;&#9;&#9;H.Transparency = i
&#9;&#9;&#9;wait(0.05)
&#9;&#9;end
&#9;&#9;Skull = MP.Skull:clone()
&#9;&#9;Skull.Parent = Char
&#9;&#9;W = Instance.new(&quot;Weld&quot;)
&#9;&#9;W.Parent = T
&#9;&#9;W.Name = &quot;Head To Skull&quot;
&#9;&#9;W.Part0 = H
&#9;&#9;W.Part1 = Skull
&#9;&#9;W.C0 = CFrame.new(0,0.2,0)
&#9;&#9;Skull.Anchored = false
&#9;&#9;for i = 1, 0, -0.1 do
&#9;&#9;&#9;Skull.Transparency = i
&#9;&#9;&#9;wait(0.05)
&#9;&#9;end
&#9;&#9;Skull.Transparency = 0
&#9;&#9;Finished = true
&#9;end
&#9;if Finished then
&#9;&#9;M.Button1Down:connect(function()
&#9;&#9;&#9;local L1 = MP.Laser:clone()
&#9;&#9;&#9;local CF1 = Skull.CFrame * CFrame.new(0,0.3,-0.8)
&#9;&#9;&#9;local D1 = (Vector3.new(CF1.X,CF1.Y,CF1.Z)-M.Hit.p).magnitude
&#9;&#9;&#9;if D1 &gt; 300 then return end
&#9;&#9;&#9;L1.Size = Vector3.new(1,D1,1)
&#9;&#9;&#9;L1.Mesh.Scale = Vector3.new(0.2,D1/L1.Size.y,0.2)
&#9;&#9;&#9;L1.CFrame = CFrame.new(Vector3.new(CF1.X,CF1.Y,CF1.Z),M.Hit.p) * CFrame.fromEulerAnglesXYZ(math.pi/2,0,0) * CFrame.new(0,-D1/2,0)
&#9;&#9;&#9;L1.Parent = game.Workspace
&#9;&#9;&#9;L1.Touched:connect(function(Hit)
&#9;&#9;&#9;&#9;local hum = Hit.Parent:findFirstChild(&quot;Humanoid&quot;) or Hit.Parent:findFirstChild(&quot;Zombie&quot;)
&#9;&#9;&#9;&#9;if hum:IsA(&quot;Humanoid&quot;) and hum ~= Hum then
&#9;&#9;&#9;&#9;&#9;hum.Health = hum.Health - 25
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end)
&#9;&#9;&#9;for i = 0, 1, 0.2 do
&#9;&#9;&#9;&#9;wait(0.05)
&#9;&#9;&#9;&#9;L1.Transparency = i
&#9;&#9;&#9;end
&#9;&#9;&#9;L1:remove()
&#9;&#9;end)
--[[&#9;&#9;while true do wait(0.1)
&#9;&#9;&#9;local PosCF = H.CFrame*CFrame.new(0,0.2,0)
&#9;&#9;&#9;local LookCF = CFrame.new(Vector3.new(PosCF.x,PosCF.y,PosCF.z), M.Hit.p)
&#9;&#9;&#9;local CJ = CFrame.new(H.Position)
&#9;&#9;&#9;local C0 = H.CFrame:inverse()*CJ
&#9;&#9;&#9;local C1 = LookCF:inverse()*CJ
&#9;&#9;&#9;W.C0 = C0
&#9;&#9;&#9;W.C1 = C1
&#9;&#9;&#9;wait(0.05)
&#9;&#9;end]]
&#9;end
end)

Tool.Deselected:connect(function()
&#9;if Finished then W.C0 = CFrame.new(0,0.2,0) W.C1 = CFrame.new(0,0,0) end
&#9;Selected = false
end)
</ProtectedString>
					</Properties>
				</Item>
			</Item>
