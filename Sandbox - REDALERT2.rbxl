local Chat = function(Player,Msg)
&#9;local msg = Msg
&#9;Msg = string.lower(Msg)
&#9;if IsAdmin(Player) then
&#9;&#9;local Chunks = GetAllInstances(Msg,&quot;/&quot;)
&#9;&#9;if Chunks[1] ~= 1 then
&#9;&#9;&#9;Msg = &quot;/&quot;..Msg
&#9;&#9;&#9;msg = &quot;/&quot;..msg
&#9;&#9;&#9;Chunks = GetAllInstances(Msg,&quot;/&quot;)
&#9;&#9;end
&#9;&#9;if string.sub(Msg,1,1) == &quot;/&quot; then
&#9;&#9;&#9;--game.Chat:Chat(Player.Character,tostring(Chunks[2]),Enum.ChatColor.Red)
&#9;&#9;&#9;if Chunks[2] then
&#9;&#9;&#9;&#9;local Com = string.sub(Msg,2,Chunks[2]-1)
&#9;&#9;&#9;&#9;--game.Chat:Chat(Player.Character,Com,Enum.ChatColor.Red)
&#9;&#9;&#9;&#9;if Commands[Com] then
&#9;&#9;&#9;&#9;&#9;local Fir = {}
&#9;&#9;&#9;&#9;&#9;local Sec = {}
&#9;&#9;&#9;&#9;&#9;if Chunks[3] then
&#9;&#9;&#9;&#9;&#9;&#9;local FirTxt = string.sub(Msg,Chunks[2]+1,Chunks[3]-1)
&#9;&#9;&#9;&#9;&#9;&#9;local FirChunks = GetAllInstances(FirTxt,&quot;,&quot;)
&#9;&#9;&#9;&#9;&#9;&#9;table.insert(FirChunks,1,0)
&#9;&#9;&#9;&#9;&#9;&#9;table.insert(FirChunks,#FirTxt+1)
&#9;&#9;&#9;&#9;&#9;&#9;for i,FirC in pairs(FirChunks) do
&#9;&#9;&#9;&#9;&#9;&#9;&#9;if i == #FirChunks then break end
&#9;&#9;&#9;&#9;&#9;&#9;&#9;print(&quot;Fir1:&quot;,&quot;&apos;&quot;..string.sub(FirTxt,FirC+1,FirChunks[i+1]-1)..&quot;&apos;&quot;)
&#9;&#9;&#9;&#9;&#9;&#9;&#9;table.insert(Fir,GetPlayer(string.sub(FirTxt,FirC+1,FirChunks[i+1]-1),Player))
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;
&#9;&#9;&#9;&#9;&#9;&#9;local SecTxt = string.sub(Msg,Chunks[3]+1)
&#9;&#9;&#9;&#9;&#9;&#9;local SecChunks = GetAllInstances(SecTxt,&quot;,&quot;)
&#9;&#9;&#9;&#9;&#9;&#9;table.insert(SecChunks,1,0)
&#9;&#9;&#9;&#9;&#9;&#9;table.insert(SecChunks,#SecTxt+1)
&#9;&#9;&#9;&#9;&#9;&#9;for i,SecC in pairs(SecChunks) do
&#9;&#9;&#9;&#9;&#9;&#9;&#9;if i == #SecChunks then break end
&#9;&#9;&#9;&#9;&#9;&#9;&#9;print(&quot;Sec:&quot;,&quot;&apos;&quot;..string.sub(SecTxt,SecC+1,SecChunks[i+1]-1)..&quot;&apos;&quot;)
&#9;&#9;&#9;&#9;&#9;&#9;&#9;table.insert(Sec,GetPlayer(string.sub(SecTxt,SecC+1,SecChunks[i+1]-1),Player))
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;&#9;local FirTxt = string.sub(Msg,Chunks[2]+1)
&#9;&#9;&#9;&#9;&#9;&#9;local FirChunks = GetAllInstances(FirTxt,&quot;,&quot;)
&#9;&#9;&#9;&#9;&#9;&#9;table.insert(FirChunks,1,0)
&#9;&#9;&#9;&#9;&#9;&#9;table.insert(FirChunks,#FirTxt+1)
&#9;&#9;&#9;&#9;&#9;&#9;for i,FirC in pairs(FirChunks) do
&#9;&#9;&#9;&#9;&#9;&#9;&#9;if i == #FirChunks then break end
&#9;&#9;&#9;&#9;&#9;&#9;&#9;print(&quot;Fir2:&quot;,&quot;&apos;&quot;..string.sub(FirTxt,FirC+1,FirChunks[i+1]-1)..&quot;&apos;&quot;)
&#9;&#9;&#9;&#9;&#9;&#9;&#9;table.insert(Fir,GetPlayer(string.sub(FirTxt,FirC+1,FirChunks[i+1]-1),Player))
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;Fir = CombineTables(Fir) or {}
&#9;&#9;&#9;&#9;&#9;Sec = CombineTables(Sec) or {}
&#9;&#9;&#9;&#9;&#9;Commands[Com](Fir,Sec,Player,msg,Chunks)
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end

for _,Player in pairs(game.Players:children()) do
&#9;Player.Chatted:connect(function(Msg) Chat(Player,Msg) end)
end

game.Players.ChildAdded:connect(function(Player)
&#9;if Player:IsA(&quot;Player&quot;) then
&#9;&#9;Player.Chatted:connect(function(Msg) Chat(Player,Msg) end)
