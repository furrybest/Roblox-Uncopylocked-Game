							<Item class="Script" referent="RBX29337">
								<Properties>
									<bool name="Disabled">true</bool>
									<Content name="LinkedSource"><null></null></Content>
									<string name="Name">Movement</string>
									<ProtectedString name="Source">function waitForChild(instance, name)
&#9;while not instance:FindFirstChild(name) do
&#9;&#9;instance.ChildAdded:wait()
&#9;end
&#9;return instance:FindFirstChild(name)
end

local SpikeModel = script.Parent.Parent
local Spike = waitForChild(SpikeModel, &quot;Spike&quot;)
local Box = waitForChild(SpikeModel, &quot;Box&quot;)
local Props = waitForChild(SpikeModel, &quot;Properties&quot;)
wait(0.1)
Spike.Touched:connect(function(hit)
&#9;local human = hit.Parent:findFirstChild(&quot;Humanoid&quot;)
&#9;if human and human.Health &gt; 0 then
&#9;&#9;human.Health = 0
&#9;end
end)

while SpikeModel.Parent do
&#9;local SpikeSpeed = Props.SpikeSpeed.Var.Value/100
&#9;local WaitBetweenMovement = Props.WaitBetweenMovement.Var.Value
&#9;if SpikeSpeed &lt; 0.01 then
&#9;&#9;SpikeSpeed = 0.01
&#9;&#9;Props.SpikeSpeed.Var.Value = 1
&#9;end
&#9;for i = 0, 4,0.2 do
&#9;&#9;Spike.CFrame = Box.CFrame * CFrame.new(0,i-0.3,0)
&#9;&#9;wait(SpikeSpeed)
&#9;end
&#9;Spike.CFrame = Box.CFrame * CFrame.new(0,4-0.3,0)
&#9;wait(WaitBetweenMovement)
&#9;for i = 4, 0,-0.2 do
&#9;&#9;Spike.CFrame = Box.CFrame * CFrame.new(0,i-0.3,0)
&#9;&#9;wait(SpikeSpeed)
&#9;end
&#9;Spike.CFrame = Box.CFrame * CFrame.new(0,-0.3,0)
&#9;wait(WaitBetweenMovement)
end
</ProtectedString>
								</Properties>
							</Item>
