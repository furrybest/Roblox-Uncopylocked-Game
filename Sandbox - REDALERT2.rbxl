&#9;&#9;end
&#9;end
&#9;return true
end

function UpdateGui()
&#9;if Gui then Gui:remove() end
&#9;Gui = Tool.ConfigGui:clone()
&#9;Gui.Parent = Player.PlayerGui
&#9;if sel.Img.Value ~= &quot;&quot; then
&#9;&#9;Gui.F.Img.Image = &quot;http://www.roblox.com/Game/Tools/ThumbnailAsset.ashx?fmt=png&amp;wd=110&amp;ht=110&amp;aid=&quot;..sel.Img.Value
