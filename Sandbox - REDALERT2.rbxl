						<token name="Purpose">1</token>
						<token name="Tone">1</token>
					</Properties>
					<Item class="DialogChoice" referent="RBX132">
						<Properties>
							<string name="Name">DC1</string>
							<string name="ResponseDialog">Sandbox is a game for building whatever you&apos;d like to.</string>
