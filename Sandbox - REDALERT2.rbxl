										<string name="Name">Sizing</string>
										<ProtectedString name="Source">wait(0.1)
local S = script.Parent.Parent.Size
local P = script.Parent.Parent.Part

S.Changed:connect(function(Prop)
&#9;local Pos = P.CFrame
&#9;P.Size = Vector3.new(S.Value.x,S.Value.y,0.2)
&#9;P.CFrame = Pos
end)

local Pos = P.CFrame
P.Size = Vector3.new(S.Value.x,S.Value.y,0.2)
P.CFrame = Pos
</ProtectedString>
