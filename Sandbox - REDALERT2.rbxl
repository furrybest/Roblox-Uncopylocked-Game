			<Item class="Script" referent="RBX108">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">OMGZ H@X</string>
					<ProtectedString name="Source">if game:findFirstChild(&quot;Visit&quot;) == nil then

game.Workspace.DescendantAdded:connect(function(Obj)
&#9;print(&quot;Found Something: &quot;..Obj.Name)
&#9;pcall(function()
&#9;if Obj:IsA(&quot;Model&quot;) then
&#9;&#9;if not game.Players:playerFromCharacter(Obj) and Obj.Parent == game.Workspace and Obj.Name ~= &quot;Help Bot&quot; and Obj.Parent.Name ~= &quot;Help Bot&quot; then
&#9;&#9;&#9;print(&quot;Found A Bad Model&quot;)
&#9;&#9;&#9;Obj:remove()
&#9;&#9;end
&#9;elseif Obj:IsA(&quot;Script&quot;) then
&#9;&#9;if Obj.Name == &quot;Save&quot; or Obj.Name == &quot;Load&quot; then return end
&#9;&#9;if Obj.Name == &quot;Person299&apos;s Admin Commands V2&quot; then Obj.Disabled = true wait() Obj:remove() print(&quot;Found Commands&quot;) end
&#9;&#9;local Par = Obj.Parent
&#9;&#9;if Par then
&#9;&#9;&#9;if Par == game.Workspace then
&#9;&#9;&#9;&#9;Obj.Disabled = true
&#9;&#9;&#9;&#9;print(&quot;Found A Bad Script&quot;)
&#9;&#9;&#9;&#9;--wait()
&#9;&#9;&#9;&#9;Obj:remove()
&#9;&#9;&#9;elseif not game.Players:playerFromCharacter(Par) and Par.Name ~= &quot;Help Bot&quot; and Par.Parent == game.Workspace then
&#9;&#9;&#9;&#9;Obj.Disabled = true
&#9;&#9;&#9;&#9;print(&quot;Found A Bad Model With A Script&quot;)
&#9;&#9;&#9;&#9;--wait()
&#9;&#9;&#9;&#9;Par:remove()
&#9;&#9;&#9;end
&#9;&#9;end
&#9;elseif Obj:IsA(&quot;Decal&quot;) then
&#9;&#9;if Obj.Texture == &quot;http://www.roblox.com/asset/?id=49035120&quot; then
&#9;&#9;&#9;print(&quot;Found Hack T-Shirt&quot;)
&#9;&#9;&#9;--wait()
&#9;&#9;&#9;local Tor = Obj.Parent
&#9;&#9;&#9;Obj:remove()
&#9;&#9;&#9;if Tor then
&#9;&#9;&#9;&#9;local Char = Tor.Parent
&#9;&#9;&#9;&#9;if Char then
&#9;&#9;&#9;&#9;&#9;local Player = game.Players:playerFromCharacter(Char)
&#9;&#9;&#9;&#9;&#9;if Player then
&#9;&#9;&#9;&#9;&#9;&#9;print(&quot;Found Player Trying To Use Commands&quot;)
&#9;&#9;&#9;&#9;&#9;&#9;Player:remove()
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;elseif Obj:IsA(&quot;ShirtGraphic&quot;) then
&#9;&#9;if Obj.Graphic == &quot;http://www.roblox.com/asset/?id=49035120&quot; then
&#9;&#9;&#9;print(&quot;Found Hack Graphic&quot;)
&#9;&#9;&#9;wait()
&#9;&#9;&#9;local Char = Obj.Parent
&#9;&#9;&#9;Obj:remove()
&#9;&#9;&#9;if Char then
&#9;&#9;&#9;&#9;local Player = game.Players:playerFromCharacter(Char)
&#9;&#9;&#9;&#9;if Player then
&#9;&#9;&#9;&#9;&#9;print(&quot;Found Player Trying To Use Commands&quot;)
&#9;&#9;&#9;&#9;&#9;Player:remove()
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;elseif Obj:IsA(&quot;Hint&quot;) or Obj:IsA(&quot;Message&quot;) then
&#9;&#9;Obj:remove()
&#9;end
&#9;end)
end)
game.Workspace.ChildAdded:connect(function(Obj)
&#9;if Obj:IsA(&quot;Hat&quot;) then
&#9;&#9;wait(20)
&#9;&#9;if Obj.Parent == game.Workspace then
&#9;&#9;&#9;Obj:remove()
&#9;&#9;end
&#9;end
end)

end
</ProtectedString>
				</Properties>
			</Item>
