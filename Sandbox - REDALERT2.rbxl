&#9;&#9;end
&#9;end
&#9;if not z then
&#9;&#9;for _,Child in pairs(Obj:children()) do
&#9;&#9;&#9;local Ps = GetParts(Child)
&#9;&#9;&#9;for _,child in pairs(Ps) do
&#9;&#9;&#9;&#9;table.insert(P,child)
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
&#9;return P
end

script.Parent.Parent.DataControle.Load.MouseButton1Down:connect(function()
