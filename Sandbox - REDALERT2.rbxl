while not Player.Character do wait(0.1) end wait(0.5)

function Alert(Msg)
&#9;local Alerts = Player.PlayerGui:findFirstChild(&quot;Alert&quot;)
&#9;if Alerts then
&#9;&#9;local msg = Instance.new(&quot;StringValue&quot;)
&#9;&#9;msg.Name = &quot;Msg&quot;
&#9;&#9;msg.Value = Msg
&#9;&#9;msg.Parent = Alerts.Controle
&#9;end
end

function Round(Num)
&#9;return math.floor(Num+0.5)
end

function GetParts(Obj)
&#9;local P = {}
&#9;local z = false
&#9;for _,Class in pairs({&quot;Part&quot;,&quot;WedgePart&quot;,&quot;TrussPart&quot;,&quot;CornerWedgePart&quot;}) do
&#9;&#9;if Obj:IsA(Class) then
&#9;&#9;&#9;z = true
&#9;&#9;&#9;table.insert(P,Obj)
&#9;&#9;end
&#9;end
&#9;if not z then
&#9;&#9;for _,Child in pairs(Obj:children()) do
&#9;&#9;&#9;local Ps = GetParts(Child)
&#9;&#9;&#9;for _,child in pairs(Ps) do
&#9;&#9;&#9;&#9;table.insert(P,child)
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
&#9;return P
end

function GetModelPart(Obj)
&#9;local ToReturn = nil
&#9;if Obj.Parent == Base.Parts then
&#9;&#9;ToReturn = Obj
&#9;elseif Obj.Parent == game or Obj.Parent == game.Workspace or Obj.Parent == nil then
&#9;&#9;ToReturn = nil
&#9;else
&#9;&#9;ToReturn = GetModelPart(Obj.Parent)
&#9;end
&#9;return ToReturn
end

Tool.Selected:connect(function(M)
&#9;if not Base then
