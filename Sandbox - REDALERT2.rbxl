							<ProtectedString name="Source">wait(2)
local Player = script.Parent.Parent.Parent.Parent

function Alert(Msg)
&#9;local Alerts = script.Parent.Parent.Parent:findFirstChild(&quot;Alert&quot;)
&#9;if Alerts then
&#9;&#9;local msg = Instance.new(&quot;StringValue&quot;)
&#9;&#9;msg.Name = &quot;Msg&quot;
&#9;&#9;msg.Value = Msg
&#9;&#9;msg.Parent = Alerts.Controle
&#9;end
end

script.Parent.Yes.MouseButton1Down:connect(function()
&#9;local z = nil
&#9;for _,Base in pairs(game.Workspace.Bases:children()) do
&#9;&#9;if Base.Owner.Value == Player.Name then
&#9;&#9;&#9;z = Base
&#9;&#9;&#9;break
&#9;&#9;end
&#9;end
&#9;if z then
&#9;&#9;for _,Part in pairs(z.Parts:children()) do
&#9;&#9;&#9;Part:remove()
&#9;&#9;end
&#9;else
&#9;&#9;Alert(&quot;You don&apos;t have a base yet.&quot;)
&#9;end
&#9;script.Parent.Yes.Visible = false
&#9;script.Parent.No.Visible = false
end)

script.Parent.No.MouseButton1Down:connect(function()
&#9;script.Parent.Yes.Visible = false
&#9;script.Parent.No.Visible = false
end)

script.Parent.MouseButton1Down:connect(function()
