&#9;end
&#9;if z then
&#9;&#9;local String = &quot;[&quot;..Name..&quot;]&quot;
&#9;&#9;local Parts = z.Parts:children()
&#9;&#9;local Tot = #Parts
&#9;&#9;Waiting = true
&#9;&#9;script.Parent.Parent.Wait.Visible = true
&#9;&#9;script.Parent.Parent.Wait.Lab.Text = &quot;Saving Creation, Please Wait (0/&quot;..Tot..&quot;)&quot;
