&#9;&#9;&#9;local D2 = (Vector3.new(CF2.X,CF2.Y,CF2.Z)-M.Hit.p).magnitude
&#9;&#9;&#9;if D1 &gt; 300 or D2 &gt; 300 then return end
&#9;&#9;&#9;L1.Size = Vector3.new(1,D1,1)
&#9;&#9;&#9;L2.Size = Vector3.new(1,D2,1)
&#9;&#9;&#9;L1.Mesh.Scale = Vector3.new(0.2,D1/L1.Size.y,0.2)
