end

function MakeSaveChunk(Name)
&#9;if Waiting then return end
&#9;local z = nil
&#9;for _,Base in pairs(game.Workspace.Bases:children()) do
&#9;&#9;if Base.Owner.Value == Player.Name then
&#9;&#9;&#9;z = Base
