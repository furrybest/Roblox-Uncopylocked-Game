										<string name="Name">Script</string>
										<ProtectedString name="Source">wait(0.1)
local Mod = script.Parent.Parent
local L = Mod.Laser

L.Touched:connect(function(Hit)
&#9;if Hit.Parent then
&#9;&#9;local Hum = Hit.Parent:findFirstChild(&quot;Humanoid&quot;)
&#9;&#9;if Hum then
&#9;&#9;&#9;Hit:remove()
&#9;&#9;end
&#9;end
end)

Mod.Size.Changed:connect(function(Prop)
&#9;local S = Prop
&#9;local P = L.CFrame
&#9;L.Size = Vector3.new(1,S.y,1)
&#9;L.CFrame = P
end)

local S = Mod.Size.Value
local P = L.CFrame
L.Size = Vector3.new(1,S.y,1)
L.CFrame = P
</ProtectedString>
