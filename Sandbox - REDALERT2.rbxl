&#9;&#9;&#9;SelP.Size = Sel.Size.Value
&#9;&#9;&#9;SelP.CFrame = Sel.CenterCF.Value
&#9;&#9;&#9;SelP.Transparency = 1
&#9;&#9;&#9;SelP.Anchored = true
&#9;&#9;&#9;SelP.CanCollide = false
&#9;&#9;&#9;SelP.Parent = Player.Character
&#9;&#9;&#9;SelB.Adornee = SelP
&#9;&#9;else
&#9;&#9;&#9;SelB.Adornee = nil
&#9;&#9;end
&#9;end)
&#9;M.Button1Down:connect(function()
&#9;&#9;if SelP then SelP:remove() SelP = nil end
&#9;&#9;Sel = nil
&#9;&#9;if M.Target then
&#9;&#9;&#9;local Mod = GetModelPart(M.Target)
&#9;&#9;&#9;if Mod then
&#9;&#9;&#9;&#9;Sel = Mod
&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;if Sel then
&#9;&#9;&#9;Sel:remove()
&#9;&#9;end
&#9;&#9;SelB.Adornee = nil
&#9;end)
end)

Tool.Deselected:connect(function()
&#9;if SelB then
&#9;&#9;SelB:remove()
&#9;&#9;SelB = nil
&#9;end
&#9;&#9;if SelP then SelP:remove() SelP = nil end
end)
