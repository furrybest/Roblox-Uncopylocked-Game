				<Item class="LocalScript" referent="RBX28906">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Controle</string>
						<ProtectedString name="Source">local Tool = script.Parent
local Morphing = false
local Finished = false
local Turret = false
local MP = game.Lighting.Yoshi_Head
local W = nil
local Skull = nil
local BP = Instance.new(&quot;BodyPosition&quot;)
BP.maxForce = Vector3.new(1000000,1000000,1000000)
BP.D = 10000
local BG = Instance.new(&quot;BodyGyro&quot;)
BG.maxTorque = Vector3.new(1000000,1000000,1000000)
local Toung = Instance.new(&quot;Part&quot;)
Toung.Anchored = true
Toung.CanCollide = false
Toung.BrickColor = BrickColor.new(&quot;Bright red&quot;)
Toung.formFactor = Enum.FormFactor.Custom
local M = Instance.new(&quot;CylinderMesh&quot;,Toung)

function ConnectToung(P1, P2)
&#9;local Dis = (P1-P2).magnitude
&#9;Toung.Size = Vector3.new(1,Dis,1)
&#9;Toung.CFrame = CFrame.new(P1,P2) * CFrame.fromEulerAnglesXYZ(math.pi/2,0,0) * CFrame.new(0,-Dis/2,0)
&#9;M.Scale = Vector3.new(0.5,Dis/Toung.Size.y,0.5)
&#9;BP.position = P2
&#9;BG.cframe = CFrame.new(P1,P2)
end

Tool.Selected:connect(function(M)
&#9;Player = Tool.Parent.Parent
&#9;local Char = Player.Character
&#9;if not Char then return end
&#9;local H,T,Hum,LA,RA = Char:findFirstChild(&quot;Head&quot;), Char:findFirstChild(&quot;Torso&quot;), Char:findFirstChild(&quot;Humanoid&quot;), Char:findFirstChild(&quot;Left Arm&quot;), Char:findFirstChild(&quot;Right Arm&quot;)
&#9;if not Hum or Hum.Health &lt;= 0 then return end
&#9;if not Finished and not Morphing then
&#9;&#9;Morphing = true
&#9;&#9;for _,Child in pairs(Char:children()) do
&#9;&#9;&#9;if Child:IsA(&quot;Hat&quot;) then
&#9;&#9;&#9;&#9;local Han = Child:findFirstChild(&quot;Handle&quot;)
&#9;&#9;&#9;&#9;if Han then
&#9;&#9;&#9;&#9;&#9;for i = 0, 1, 0.1 do
&#9;&#9;&#9;&#9;&#9;&#9;wait(0.05)
&#9;&#9;&#9;&#9;&#9;&#9;Han.Transparency = i
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;Child:remove()
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;local Face = H:findFirstChild(&quot;face&quot;)
&#9;&#9;if Face then Face:remove() end
&#9;&#9;for i = 0, 1, 0.1 do
&#9;&#9;&#9;H.Transparency = i
&#9;&#9;&#9;wait(0.05)
&#9;&#9;end
&#9;&#9;Skull = MP:clone()
&#9;&#9;for _,Obj in pairs(Skull:children()) do
&#9;&#9;&#9;if Obj.Name ~= &quot;Hold&quot; then
&#9;&#9;&#9;&#9;local W = Instance.new(&quot;Weld&quot;, Part)
&#9;&#9;&#9;&#9;W.Part0 = Skull.Hold
&#9;&#9;&#9;&#9;W.Part1 = Obj
&#9;&#9;&#9;&#9;W.C0 = Skull.Hold.CFrame:inverse() * Obj.CFrame
&#9;&#9;&#9;end
&#9;&#9;&#9;Obj.Anchored = false
&#9;&#9;end
&#9;&#9;Skull.Parent = Char
&#9;&#9;W = Instance.new(&quot;Weld&quot;,Skull.Hold)
&#9;&#9;W.Part0 = H
&#9;&#9;W.Part1 = Skull.Hold
&#9;&#9;W.C0 = CFrame.new(0,-0.2,0)
&#9;&#9;Finished = true
&#9;end
&#9;if Finished then
&#9;&#9;M.Button1Down:connect(function()
&#9;&#9;&#9;if M.Target and (M.Hit.p-Skull.Mouth.Position).magnitude &lt; 300 then
&#9;&#9;&#9;&#9;local Tar = M.Target
&#9;&#9;&#9;&#9;local Vec = M.Target.CFrame:inverse() * CFrame.new(M.Hit.p)
&#9;&#9;&#9;&#9;--ConnectToung(Skull.Mouth.Position,M.Hit.p)
&#9;&#9;&#9;&#9;Toung.Parent = Player.Character
&#9;&#9;&#9;&#9;BP.Parent = Skull.Mouth
&#9;&#9;&#9;&#9;BG.Parent = T
&#9;&#9;&#9;&#9;W.C0 = CFrame.new(0,-0.2,0)
&#9;&#9;&#9;&#9;W.C1 = CFrame.new(0,0,0)
&#9;&#9;&#9;&#9;while Toung.Parent do
&#9;&#9;&#9;&#9;&#9;ConnectToung(Skull.Mouth.Position,(Tar.CFrame*Vec).p)
&#9;&#9;&#9;&#9;&#9;wait(0.05)
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end)
&#9;&#9;M.Button1Up:connect(function()
&#9;&#9;&#9;BP.Parent = nil
&#9;&#9;&#9;BG.Parent = nil
&#9;&#9;&#9;Toung.Parent = nil
&#9;&#9;end)
&#9;&#9;while true do
&#9;&#9;&#9;if not Toung.Parent then
&#9;&#9;&#9;&#9;local PosCF = H.CFrame*CFrame.new(0,-0.2,0)
&#9;&#9;&#9;&#9;local LookCF = CFrame.new(Vector3.new(PosCF.x,PosCF.y,PosCF.z), M.Hit.p)
&#9;&#9;&#9;&#9;local CJ = CFrame.new(H.Position)
&#9;&#9;&#9;&#9;local C0 = H.CFrame:inverse()*CJ
&#9;&#9;&#9;&#9;local C1 = LookCF:inverse()*CJ
&#9;&#9;&#9;&#9;W.C0 = C0
&#9;&#9;&#9;&#9;W.C1 = C1
&#9;&#9;&#9;end
&#9;&#9;&#9;wait(0.1)
&#9;&#9;end
&#9;end
end)

Tool.Deselected:connect(function()
&#9;if Finished then W.C0 = CFrame.new(0,-0.2,0) W.C1 = CFrame.new(0,0,0) end
&#9;Selected = false
&#9;BP.Parent = nil
&#9;BG.Parent = nil
&#9;Toung.Parent = nil
end)
</ProtectedString>
