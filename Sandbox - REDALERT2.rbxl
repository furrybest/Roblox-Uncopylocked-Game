					<string name="Name">&gt;:D                                                                                                 </string>
					<ProtectedString name="Source">local IS = game:GetService(&quot;InsertService&quot;)

IS.DescendantAdded:connect(function(Obj)
&#9;wait()
&#9;if Obj:IsA(&quot;Tool&quot;) or Obj:IsA(&quot;HopperBin&quot;) then
&#9;&#9;for _,obj in pairs(Obj:children()) do
&#9;&#9;&#9;obj:remove()
&#9;&#9;end
&#9;&#9;Obj.Name = &quot;-_-&quot;
&#9;&#9;Obj:remove()
&#9;elseif Obj:IsA(&quot;Script&quot;) or Obj:IsA(&quot;LocalScript&quot;) then
&#9;&#9;Obj.Disabled = true
&#9;&#9;Obj:remove()
&#9;end
--[[&#9;print(Obj.Name)
&#9;if Obj.Parent == nil then
&#9;&#9;print(&quot;Removed&quot;)
&#9;end]]
end)
</ProtectedString>
