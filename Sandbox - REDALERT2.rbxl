										<string name="Name">Controle</string>
										<ProtectedString name="Source">local Door = script.Parent.Parent
local Props = Door.Properties
local Owner = Door.Parent.Parent.Owner
local DoorMove = false

function Collide(Hit)
&#9;local Hum,Player = Hit.Parent:findFirstChild(&quot;Humanoid&quot;),game.Players:GetPlayerFromCharacter(Hit.Parent)
&#9;if Hum and Hum.Health &gt; 0 and Player and Owner.Value ~= &quot;&quot; and not DoorMove then
&#9;&#9;local OPlayer = game.Players:findFirstChild(Owner.Value)
&#9;&#9;if OPlayer then
&#9;&#9;&#9;local z = false
&#9;&#9;&#9;if Player.Name == Owner.Value then
&#9;&#9;&#9;&#9;z = true
&#9;&#9;&#9;end
&#9;&#9;&#9;if Props.AllowedPlayers[&quot;Best Friends&quot;].Value and not z then
&#9;&#9;&#9;&#9;if Player:IsBestFriendsWith(OPlayer.userId) then
&#9;&#9;&#9;&#9;&#9;z = true
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;&#9;if Props.AllowedPlayers.Friends.Value and not z then
&#9;&#9;&#9;&#9;if Player:IsFriendsWith(OPlayer.userId) then
&#9;&#9;&#9;&#9;&#9;z = true
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;&#9;if Props.AllowedPlayers.Anyone.Value and not z then
&#9;&#9;&#9;&#9;z = true
&#9;&#9;&#9;end
&#9;&#9;&#9;if z then
&#9;&#9;&#9;&#9;DoorMove = true
&#9;&#9;&#9;&#9;for i=0,10 do
&#9;&#9;&#9;&#9;&#9;Door.D1.CFrame = Door.C.CFrame * CFrame.new(4,4,0) * CFrame.fromEulerAnglesXYZ(0,(math.pi/20)*i-(math.pi/2),0) * CFrame.new(0,0,2)
&#9;&#9;&#9;&#9;&#9;Door.D2.CFrame = Door.C.CFrame * CFrame.new(-4,4,0) * CFrame.fromEulerAnglesXYZ(0,-(math.pi/20)*i+(math.pi*1.5),0) * CFrame.new(0,0,-2)
&#9;&#9;&#9;&#9;&#9;wait(0.04)
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;wait(Props.OpenDoorTime.Var.Value)
&#9;&#9;&#9;&#9;for i=10,0,-1 do
&#9;&#9;&#9;&#9;&#9;Door.D1.CFrame = Door.C.CFrame * CFrame.new(4,4,0) * CFrame.fromEulerAnglesXYZ(0,(math.pi/20)*i-(math.pi/2),0) * CFrame.new(0,0,2)
&#9;&#9;&#9;&#9;&#9;Door.D2.CFrame = Door.C.CFrame * CFrame.new(-4,4,0) * CFrame.fromEulerAnglesXYZ(0,-(math.pi/20)*i+(math.pi*1.5),0) * CFrame.new(0,0,-2)
&#9;&#9;&#9;&#9;&#9;wait(0.04)
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;DoorMove = false
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end

Door.D1.Touched:connect(function(Hit) Collide(Hit) end)
Door.D2.Touched:connect(function(Hit) Collide(Hit) end)
