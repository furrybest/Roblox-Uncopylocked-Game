											<string name="Name">Acid</string>
											<ProtectedString name="Source">hit = script.Parent
local CF = hit.CFrame
hit:BreakJoints()
hit.Anchored = true
hit.Parent = game.Workspace
hit.BrickColor = BrickColor.new(&quot;Bright red&quot;)
hit.CanCollide = false
hit.Position = Vector3.new(0,0,0)
for i = 0, 2, 0.1 do
&#9;hit.CFrame = CF + Vector3.new(0,-i,0)
&#9;hit.Transparency = i/2
&#9;wait(0.05)
end
hit:remove()</ProtectedString>
