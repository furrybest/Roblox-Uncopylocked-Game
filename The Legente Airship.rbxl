			<Item class="Script" referent="RBX8789">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<ProtectedString name="Source">function stick(x, y)
&#9;weld = Instance.new(&quot;Weld&quot;) 

&#9;weld.Part0 = x
&#9;weld.Part1 = y

&#9;local HitPos = x.Position

&#9;local CJ = CFrame.new(HitPos) 
&#9;local C0 = x.CFrame:inverse() *CJ 
&#9;local C1 = y.CFrame:inverse() * CJ 

&#9;weld.C0 = C0 
&#9;weld.C1 = C1 
&#9;
&#9;weld.Parent = x
&#9;
&#9;weld.Name = &quot;Weld&quot;
end

local Stuff = script.Parent:GetChildren()
for X = 1, # Stuff do
&#9;if Stuff[X].Name == &quot;Smooth Block Model&quot; or Stuff[X].Name == &quot;Seat&quot; then
&#9;&#9;stick(script.Parent.Main, Stuff[X])
&#9;end
end
stick(script.Parent.Main, script.Parent[&quot;Smooth Block Model&quot;])</ProtectedString>
				</Properties>
			</Item>
		</Item>
