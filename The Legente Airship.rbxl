		<Item class="Script" referent="RBX15556">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Fire Remover</string>
				<ProtectedString name="Source">--This is my anti-fire script. If it dosent work try the ltest version. if it STIll dosent work just dont use it

for i, v in pairs(script.Parent:getChildren()) do&#9;
&#9;if v:findFirstChild(&quot;Fire&quot;) ~= nil then
&#9;&#9;v.Fire:remove()
&#9;else
&#9;&#9;sub = v:getChildren()
&#9;&#9;for x = 1, #sub do
&#9;&#9;&#9;if sub[x]:findFirstChild(&quot;Fire&quot;) ~= nil then
&#9;&#9;&#9;&#9;sub[x].Fire:remove()
&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;sub_1 = sub[x]:getChildren()
&#9;&#9;&#9;&#9;for y = 1, #sub_1 do
&#9;&#9;&#9;&#9;&#9;if sub_1[y]:findFirstChild(&quot;Fire&quot;) ~= nil then
&#9;&#9;&#9;&#9;&#9;&#9;sub_1[y].Fire:remove()
&#9;&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;&#9;sub_2 = sub_1[y]:getChildren()
&#9;&#9;&#9;&#9;&#9;&#9;for z = 1, #sub_2 do
&#9;&#9;&#9;&#9;&#9;&#9;&#9;if sub_2[z]:findFirstChild(&quot;Fire&quot;) ~= nil then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;sub_2[z].Fire:remove()
&#9;&#9;&#9;&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;sub_3 = sub_2[z]:getChildren()
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;for c = 1, #sub_3 do
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;if sub_3[c]:findFirstChild(&quot;Fire&quot;) ~= nil then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;sub_3[c].Fire:remove()
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;sub_4 = sub_3[c]:getChildren()
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;for j = 1, #sub_4 do
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;if sub_4[j]:findFirstChild(&quot;Fire&quot;) ~= nil then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;sub_4[j].Fire:remove()
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;sub_5 = sub_4[j]:getChildren()
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;for s = 1, #sub_5 do
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;if sub_5[s]:findFirstChild(&quot;Fire&quot;) ~= nil then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;sub_5[s].Fire:remove()
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;end
