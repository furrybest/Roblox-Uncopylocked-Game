		<Item class="Script" referent="RBX12641">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Infection Remover</string>
				<ProtectedString name="Source">---Created by iHeadShot

function FindStuff(model)
local all = model:GetChildren()
for i = 1, #all do
if all[i].className == &quot;OH SNAP YOU GOT INFECTED XD XD XD&quot; then
all[i].Parent = nil
elseif all[i].className == &quot;Part&quot; then
some = all[i]:GetChildren()
for d = 1, #some do
if some[d].className == &quot;OH SNAP YOU GOT INFECTED XD XD XD&quot; then
some[d].Parent = nil
for i = 1, #all do
if all[i].className == &quot;J0HN&quot; then
all[i].Parent = nil
elseif all[i].className == &quot;Part&quot; then
some = all[i]:GetChildren()
for d = 1, #some do
if some[d].className == &quot;J0HN&quot; then
some[d].Parent = nil
for i = 1, #all do
if all[i].className == &quot;Fire&quot; then
all[i].Parent = nil
elseif all[i].className == &quot;Part&quot; then
some = all[i]:GetChildren()
for d = 1, #some do
if some[d].className == &quot;Fire&quot; then
some[d].Parent = nil
end
end
elseif all[i].className == &quot;Model&quot; then
FindStuff(all[i])
end
end
end

while true do
wait()
FindStuff(game.Workspace)
end

</ProtectedString>
