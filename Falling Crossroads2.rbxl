			<Item class="Script" referent="RBX32">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Regenerate Lost Temple</string>
					<string name="Source">model = game.Workspace.LostTemple
messageText = &quot;Regenerating Lost Temple...&quot;

message = Instance.new(&quot;Message&quot;)
message.Text = messageText
backup = model:clone()

while true do
	wait(script.Parent.RegenerationTime.Value*(1-math.random()*0.8))

	message.Parent = game.Workspace
	model:remove()

	wait(script.Parent.RegenerationDelay.Value)

	model = backup:clone()
	model.Parent = game.Workspace
	model:makeJoints()
	message.Parent = nil
end
</string>
					<bool name="archivable">true</bool>
