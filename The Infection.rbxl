						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Throw</string>
						<ProtectedString name="Source">u = script.Parent:clone()


function onActivated()
script.Parent.Handle.Name = &quot;Handle&quot;
b = script.Parent.Handle
n = script.Parent.Slip:clone()
n.Disabled = false
n.Parent = b
b.Parent = game.Workspace
b:BreakJoints()
b.Velocity = char[&quot;Left Arm&quot;].CFrame.lookVector * 50 + Vector3.new(0,6,0)
b.CanCollide = true
script.Parent:Remove()
wait(25)
b:Remove()
end


function onEquipped()
char = script.Parent.Parent
end


script.Parent.Activated:connect(onActivated)
script.Parent.Equipped:connect(onEquipped)





