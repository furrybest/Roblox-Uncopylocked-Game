		<Item class="Script" referent="RBX2492">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Leaderboard</string>
				<ProtectedString name="Source">print(&quot;The Undead Coming Leaderboard script version 1.0 loaded&quot;)

undead = game.Workspace.Zombies
stage = game.Workspace.Stage

weapons = game.Workspace.Weapons
playing = game.Workspace.Playing

humans = game.Teams[&quot;Humans&quot;]
zombies = game.Teams[&quot;Zombies&quot;]
shared[&quot;Zombs&quot;] = {};
shared[&quot;Weps&quot;] = {};
shared[&quot;Weps&quot;][&quot;Pistol&quot;] = weapons.Pistol:Clone();
weapons.Pistol:remove();
--[[for i, v in ipairs(undead:GetChildren()) do
Zombs[v.Name] = v:Clone();
v:remove();
end]]

function sendHint(text, player)
removeHint(player)

local msg = Instance.new(&quot;Hint&quot;)
msg.Name = &quot;LeaderHint&quot;
msg.Text = text
msg.Parent = player.PlayerGui
end

function removeHint(player)
if(player~=nil)and(player.PlayerGui:FindFirstChild(&quot;LeaderHint&quot;)~=nil)then
player.PlayerGui.LeaderHint:remove()
end
end

function sendMsg(text, player)
removeMsg(player)

local msg = Instance.new(&quot;Message&quot;)
msg.Name = &quot;LeaderMessage&quot;
msg.Text = text
msg.Parent = player.PlayerGui
end

function removeMsg(player)
if(player~=nil)and(player.PlayerGui:FindFirstChild(&quot;LeaderMessage&quot;)~=nil)then
player.PlayerGui.LeaderMessage:remove()
end
end
------------------------------ game.workspace.Players.player.PlayerGui.LeaderMessage:remove()
--------------- game.workspace.Players.player.PlayerGui.LeaderHint:remove()
function removeFumeMsg(player)
if(player~=nil)and(player.PlayerGui:FindFirstChild(&quot;FumeMessage&quot;)~=nil)then
player.PlayerGui.FumeMessage:remove()
end
end

function setCharacterZombie(zombie, player)
print(&quot;Zombiefication&quot;);
local newUndead =zombie.ZAnimate:Clone()
newUndead.Disabled = false
wait();
local char = player.Character
char[&quot;RobloxTeam&quot;]:remove();
char[&quot;Sound&quot;]:remove();
char[&quot;Animate&quot;]:remove();
newUndead.Parent = char;
wait();
char.creator.Value = player;

end

function onHumanoidDied(humanoid, player)
local stats = player:findFirstChild(&quot;leaderstats&quot;)
if stats ~= nil then
--local points = stats:findFirstChild(&quot;Points&quot;)
local dead = player:FindFirstChild(&quot;Dead&quot;)
--points.Value = points.Value - 1
dead.Value = true
player.TeamColor = zombies.TeamColor
removeFumeMsg(player)

-- do short dance to try and find the killer

local killer = getKillerOfHumanoidIfStillInGame(humanoid)

handleKillCount(humanoid, player)
end
end

function onPlayerRespawn(property, player)
-- need to connect to new humanoid

if property == &quot;Character&quot; and player.Character ~= nil and player.Character.Name == player.Name then
local stats = player:findFirstChild(&quot;leaderstats&quot;)
if stats ~= nil then
local dead = player:FindFirstChild(&quot;Dead&quot;)
local class = player:FindFirstChild(&quot;Class&quot;)
if(dead.Value==true)then
wait(1)
if(player~=nil)and(player.Character~=nil)then
setCharacterZombie(undead[class.Value], player)
else return
end
end
end

humanoid = player.Character.Humanoid

local p = player
local h = humanoid
humanoid.Died:connect(function() onHumanoidDied(h, p) end )
end
end

function getKillerOfHumanoidIfStillInGame(humanoid)
-- returns the player object that killed this humanoid
-- returns nil if the killer is no longer in the game

-- check for kill tag on humanoid - may be more than one - todo: deal with this
local tag = humanoid:findFirstChild(&quot;creator&quot;)

-- find player with name on tag
if tag ~= nil then

local killer = tag.Value
if killer.Parent ~= nil then -- killer still in game
return killer
end
end

return nil
end

function handleKillCount(humanoid, player)
local killer = getKillerOfHumanoidIfStillInGame(humanoid)
if killer ~= nil then
local stats = killer:findFirstChild(&quot;leaderstats&quot;)
if stats ~= nil then
local points = stats:findFirstChild(&quot;Points&quot;)
local dead = killer:FindFirstChild(&quot;Dead&quot;)
if killer ~= player then
if(dead.Value==false)then
points.Value = points.Value + 21
else
points.Value = points.Value + 22
end

else
points.Value = points.Value - 3

end
end
end
end

function onChatted(msg, speaker)
local class = speaker:FindFirstChild(&quot;Class&quot;)
if(class==nil)then return end

msg = string.lower(msg)

if(msg==&quot;/zombie&quot;)then
class.Value = &quot;Zombie&quot;
elseif(msg==&quot;/fastzombie&quot;)then
if(stage.Value&gt;=2)then
class.Value = &quot;FastZombie&quot;
else
sendMsg(&quot;Fast Zombie is not unlocked!&quot;, speaker)
wait(3)
removeMsg(speaker)
end
elseif(msg==&quot;/kamizombie&quot;)then
if(stage.Value&gt;=3)then
class.Value = &quot;KamiZombie&quot;
else
sendMsg(&quot;Kamikaze Zombie is not unlocked!&quot;, speaker)
wait(3)
removeMsg(speaker)
end
elseif(msg==&quot;/ghostzombie&quot;)then
if(stage.Value&gt;=4)then
class.Value = &quot;ghostzombie&quot;
else
sendMsg(&quot;Ghost zombie is not unlocked!&quot;, speaker)
wait(3)
removeMsg(speaker)
end
elseif(msg==&quot;/fastghostzombie&quot;)then
if(stage.Value&gt;=5)then
class.Value = &quot;fastghostzombie&quot;
else
sendMsg(&quot;fastghost zombie is not unlocked!&quot;, speaker)
wait(3)
removeMsg(speaker)
end
elseif(msg==&quot;/zombieboss&quot;)then
if(stage.Value&gt;=6)then
class.Value = &quot;zombieboss&quot;
else
sendMsg(&quot;ZombieBOSS! is not unlocked!&quot;, speaker)
wait(3)
removeMsg(speaker)
end
end
end

function onPlayerEntered(newPlayer)

local stats = Instance.new(&quot;IntValue&quot;)
stats.Name = &quot;leaderstats&quot;

local points = Instance.new(&quot;IntValue&quot;)
points.Name = &quot;Points&quot;
points.Value = 0

local dead = Instance.new(&quot;BoolValue&quot;)
dead.Name = &quot;Dead&quot;
dead.Value = false

local class = Instance.new(&quot;StringValue&quot;)
class.Name = &quot;Class&quot;
class.Value = &quot;Zombie&quot;

points.Parent = stats

-- VERY UGLY HACK
-- Will this leak threads?
-- Is the problem even what I think it is (player arrived before character)?
while true do
if newPlayer.Character ~= nil then break end
wait(1)
end

dead.Parent = newPlayer
class.Parent = newPlayer
stats.Parent = newPlayer

--newPlayer.Character[&quot;Health&quot;]:remove()

if(playing.Value==true)then
shared[&quot;Weps&quot;][&quot;Pistol&quot;]:Clone().Parent = newPlayer.Backpack
end

local humanoid = newPlayer.Character.Humanoid

humanoid.Died:connect(function() onHumanoidDied(humanoid, newPlayer) end )

-- start to listen for new humanoid
newPlayer.Changed:connect(function(property) onPlayerRespawn(property, newPlayer) end )
newPlayer.Chatted:connect(function(msg, recipient) onChatted(msg, newPlayer) end)
stats.Parent = newPlayer

end
game.Players.ChildAdded:connect(onPlayerEntered)


</ProtectedString>
			</Properties>
		</Item>
		<Item class="Model" referent="RBX2493">
			<Properties>
				<CoordinateFrame name="ModelInPrimary">
					<X>0</X>
					<Y>0</Y>
