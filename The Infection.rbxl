				<string name="Name">Script</string>
				<ProtectedString name="Source">textures = {&quot;http://www.roblox.com/asset/?id=542&quot;, &quot;http://www.roblox.com/asset/?id=542425&quot;}
admins = {&quot;jaredvaldez4&quot;}
currency = &quot;Points&quot;
a = 1, #textures
b = 1, #admins
game.Players.PlayerAdded:connect(function(new)
&#9;game:service&quot;BadgeService&quot;:AwardBadge(new.userId,270644042)
&#9;repeat wait() until new.Character
&#9;if new.Character.Torso.roblox.Texture == textures[a] or new.Name == admins[b] then
&#9;wait(1)
&#9;new.leaderstats[currency].Value = 100000
&#9;end
end)</ProtectedString>
