				<Item class="Sound" referent="RBX5255">
					<Properties>
						<bool name="Looped">false</bool>
						<string name="Name">Reload</string>
						<float name="Pitch">0.5</float>
						<bool name="PlayOnRemove">false</bool>
						<Content name="SoundId"><url>http://www.roblox.com/asset/?id=2920960</url></Content>
