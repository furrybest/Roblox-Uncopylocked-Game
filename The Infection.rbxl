						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">GrowScript</string>
						<ProtectedString name="Source">times=30

if script.Parent.className==&quot;Part&quot; then
for i=1, times do
script.Parent.Mesh.Scale=Vector3.new(i*.2,1,i*.2)+Vector3.new(1,0,1)
wait()
end
script.Parent:remove()
end
</ProtectedString>
