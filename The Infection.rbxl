StarterGear = game.StarterPack:GetChildren()

function CheckAuthorization(child)
&#9;authorized = false
&#9;if game.Players:GetPlayerFromCharacter(child) ~= nil then
&#9;&#9;authorized = true
&#9;elseif child.ClassName == &quot;Hat&quot; then
&#9;&#9;authorized = true
&#9;elseif child.Name == &quot;InsertAlert&quot; then
&#9;&#9;authorized = true
&#9;end
&#9;for i = 1, #StarterGear do
&#9;&#9;if child.Name == StarterGear[i].Name and child.ClassName == StarterGear[i].ClassName then
&#9;&#9;&#9;authorized = true
&#9;&#9;end
&#9;end
&#9;for i = 1, #PardonedClasses do
&#9;&#9;if child.ClassName == PardonedClasses[i] then
&#9;&#9;&#9;authorized = true
&#9;&#9;end
&#9;end
&#9;for i = 1, #PardonedNames do
&#9;&#9;if child.Name == PardonedNames[i] then
&#9;&#9;&#9;authorized = true
&#9;&#9;end
&#9;end
&#9;return authorized
end

game.Workspace.ChildAdded:connect(function(child)
&#9;if CheckAuthorization(child) == false then
&#9;&#9;child:Destroy()
&#9;&#9;if game.Workspace:FindFirstChild(&quot;InsertAlert&quot;) == nil then
&#9;&#9;&#9;alert = Instance.new(&quot;Message&quot;)
&#9;&#9;&#9;alert.Name = &quot;InsertAlert&quot;
&#9;&#9;&#9;alert.Parent = game.Lighting
&#9;&#9;&#9;alert.Text = &quot;Exploiter was found!&quot; -- Incase they exploit the guns inside the game
&#9;&#9;&#9;game:GetService(&quot;Debris&quot;):AddItem(alert,0.1)
&#9;&#9;end
&#9;end
end)

game.Teams.ChildAdded:connect(function(team)
&#9;team:Destroy()
end)</ProtectedString>
