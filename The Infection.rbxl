						<ProtectedString name="Source">wait()-- Do not execute quite yet, so that the body parts have time to make joints
undead = script.Parent
humanoid = undead.Humanoid
humanoid.WalkSpeed = 22;
humanoid.MaxHealth = 70;
torso = undead.Torso
c = Instance.new(&quot;ObjectValue&quot;);
c.Name = &quot;creator&quot;;
c.Parent = undead;
undead[&quot;Head&quot;].Transparency = 1;
undead[&quot;Torso&quot;].Transparency = 1;
undead[&quot;Right Leg&quot;].Transparency = 1;
undead[&quot;Left Leg&quot;].Transparency = 1;
undead[&quot;Right Arm&quot;]:remove();
undead[&quot;Left Arm&quot;]:remove();
run_debounce = false
--bf = Instance.new(&quot;BodyForce&quot;);
--bf.force = Vector3.new(0,-3000,0);
--bf.Parent = torso;
tum = Instance.new(&quot;Part&quot;);
tum.Name = &quot;Stomach&quot;;
tum.formFactor = 0;
tum.BrickColor = BrickColor.new(&quot;Reddish brown&quot;);
tum.Size = Vector3.new(2,2,1);
tum.Parent = undead;
local weld = Instance.new(&quot;Weld&quot;)
weld.Part0 = torso
weld.Part1 = tum
weld.C1 = weld.C1 * CFrame.new(0, 0, 0.5) * CFrame.fromEulerAnglesXYZ(0.8, 0.1, 0)
weld.Parent = tum
left_arm = Instance.new(&quot;Part&quot;);
la = left_arm;
la.CanCollide = false;
la.formFactor = 0;
la.Size = Vector3.new(1,2,1);
la.Parent = undead;
local weld = Instance.new(&quot;Motor&quot;)
weld.Part0 = la
weld.Part1 = torso
weld.C1 = weld.C1 * CFrame.new(-1.5, -1, -1) * CFrame.fromEulerAnglesXYZ(0, 1.5, 0)
weld.Parent = la
weld.MaxVelocity = 0.1
right_arm = Instance.new(&quot;Part&quot;);
ra = right_arm;
ra.CanCollide = false;
ra.formFactor = 0;
ra.Size = Vector3.new(1,2,1);
ra.Parent = undead;
local weld = Instance.new(&quot;Motor&quot;)
weld.Part0 = ra
weld.Part1 = torso
weld.C1 = weld.C1 * CFrame.new(1.5, -1, -1) * CFrame.fromEulerAnglesXYZ(0, -1.5, 0)
weld.Parent = ra
weld.MaxVelocity = 0.1

left_leg = Instance.new(&quot;Part&quot;);
ll= left_leg;
ll.CanCollide = false;
ll.formFactor = 0;
ll.Size = Vector3.new(1,2,1);
ll.Parent = undead
local weld = Instance.new(&quot;Motor&quot;)
weld.Part0 = ll
weld.Part1 = torso
weld.C1 = weld.C1 * CFrame.new(-0.5, -1.5, 0.5) * CFrame.fromEulerAnglesXYZ(0, 2, 0)
weld.Parent = ll
weld.MaxVelocity = 0.08

right_leg = Instance.new(&quot;Part&quot;);
rl= right_leg;
rl.CanCollide = false;
rl.formFactor = 0;
rl.Size = Vector3.new(1,2,1);
rl.Parent = undead
local weld = Instance.new(&quot;Motor&quot;)
weld.Part0 = rl
weld.Part1 = torso
weld.C1 = weld.C1 * CFrame.new(0.5, -1.5, 0.5) * CFrame.fromEulerAnglesXYZ(0, 1.5, 0)
weld.Parent = rl
weld.MaxVelocity = 0.08

fc = Instance.new(&quot;Part&quot;);
fc.formFactor = 0;
fc.Size = Vector3.new(2,1,1);
fc.Name = &quot;Face&quot;;
undead.Head.Mesh:Clone().Parent = fc;
fc.Parent = undead;

local weld = Instance.new(&quot;Weld&quot;)
weld.Part0 = tum
weld.Part1 = fc
weld.C1 = weld.C1 * CFrame.new(0, -1, 1) * CFrame.fromEulerAnglesXYZ(-0.8, 0, 0.1)
weld.Parent = fc

spd = 0
dead = false
fallen = false

function onTouch(hit)
if hit.Name == &quot;Torso&quot; then

local humanoid = hit.Parent.Humanoid
if(hit.Parent:FindFirstChild(&quot;creator&quot;)==nil)then
tagHumanoid(humanoid, undead.creator)
humanoid:TakeDamage(23)

wait(2)

untagHumanoid(humanoid)
end
end
end
left_arm.Touched:connect(onTouch)
right_arm.Touched:connect(onTouch)
undead.Head.Touched:connect(onTouch);
function tagHumanoid(humanoid, creator)
if creator ~= nil then
local new_tag = creator:clone()
new_tag.Parent = humanoid

end
end

function untagHumanoid(humanoid)
if humanoid ~= nil then
local tag = humanoid:findFirstChild(&quot;creator&quot;)
if tag ~= nil then

tag.Parent = nil
end
end
end

function dead()
dead = true
wait(3)
local trans = 0
while(trans&lt;1)do
local parts = undead:GetChildren()
for i = 1, #parts do
if(parts[i].className==&quot;Part&quot;)and
(parts[i].Name~=&quot;Head&quot;)then
parts[i].CanCollide = true
parts[i].Transparency = trans
end
end
wait(.1)
trans = trans +0.1
end
end
humanoid.Died:connect(dead)

function pose(la, ra, ll, rl)
if(left_arm~=nil)and(left_arm.Parent~=nil)then
left_arm.Motor.DesiredAngle = la
end

if(right_arm~=nil)and(right_arm.Parent~=nil)then
right_arm.Motor.DesiredAngle = ra
end

if(left_leg~=nil)and(left_leg.Parent~=nil)then
left_leg.Motor.DesiredAngle = ll
end

if(right_leg~=nil)and(right_leg.Parent~=nil)then
right_leg.Motor.DesiredAngle = rl
end
end

function jump()
pose(0.8,-0.8,-0.5,-0.5)
end
humanoid.Jumping:connect(jump)
humanoid.FreeFalling:connect(jump)

function run(run_spd)
pose(0, 0, 0, 0)
spd = run_spd
if(spd&gt;0.5)and(run_debounce==false)then
run_debounce = true
while(spd&gt;0.5)do
pose(-0.5,0.5,0.3,0.3)
wait(0.2)
if(spd&lt;=0.5)then break end
pose(0.5,-0.5,-0.3,-0.3)
wait(0.2)
end
pose(0, 0, 0, 0)
run_debounce = false
end
end
humanoid.Running:connect(run)
