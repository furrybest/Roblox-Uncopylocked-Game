			<Item class="LocalScript" referent="RBX4856">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Local Gui</string>
					<ProtectedString name="Source">local Tool = script.Parent;

enabled = true
function onButton1Down(mouse)
&#9;if not enabled then
&#9;&#9;return
&#9;end

&#9;enabled = false
&#9;mouse.Icon = &quot;rbxasset://textures\\GunWaitCursor.png&quot;

&#9;wait(.2)
&#9;mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
&#9;enabled = true

end

function onEquippedLocal(mouse)

&#9;if mouse == nil then
&#9;&#9;print(&quot;Mouse not found&quot;)
&#9;&#9;return 
&#9;end

&#9;mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
&#9;mouse.Button1Down:connect(function() onButton1Down(mouse) end)
end


Tool.Equipped:connect(onEquippedLocal)
</ProtectedString>
				</Properties>
			</Item>
			<Item class="Script" referent="RBX4857">
				<Properties>
					<bool name="Disabled">true</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">ProjectileScript</string>
					<ProtectedString name="Source">damage = 47

game:GetService(&quot;Debris&quot;):AddItem(script.Parent, 8)
function onTouched(hit)
&#9;if(hit.Parent==nil)then return end

&#9;if(hit.Parent:findFirstChild(&quot;Humanoid&quot;)~=nil)and
&#9;(hit.Parent:FindFirstChild(&quot;creator&quot;)~=nil)then
&#9;&#9;connection:disconnect()
&#9;&#9;hit.Parent[&quot;Humanoid&quot;]:TakeDamage(damage)

&#9;&#9;local creator = script.Parent.creator:Clone()
&#9;&#9;creator.Value = script.Parent.creator.Value
&#9;&#9;creator.Parent = hit.Parent.Humanoid

&#9;&#9;wait(.25)

&#9;&#9;creator:remove()
&#9;end
&#9;script.Parent:Remove()
end
connection = script.Parent.Touched:connect(onTouched)
</ProtectedString>
				</Properties>
			</Item>
			<Item class="SpecialMesh" referent="RBX4858">
				<Properties>
					<token name="LODX">2</token>
					<token name="LODY">2</token>
					<Content name="MeshId"><url>http://www.roblox.com/asset/?id=2697549</url></Content>
