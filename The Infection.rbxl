							<ProtectedString name="Source">--constants first
door = script.Parent
brick_name = &quot;Stomach&quot; --brick needs to hit
time = 1 --time open

--variables second
debounce = false 

function doorOpen()
&#9;door.CanCollide = false
&#9;door.Transparency = 1
end

function doorClose()
&#9;door.CanCollide = false
&#9;door.Transparency = 1
end

function onTouched(part) --- I Want it to kill the player if the brick is not a certain brick
&#9;local human = part.Parent:findFirstChild(&quot;Humanoid&quot;)
&#9;if part.Parent == nil or human == nil then return; end -- return if player or object nil.
&#9;&#9;if part.Parent:findFirstChild(&quot;Stomach&quot;) ~= nil then
&#9;&#9;&#9;if debounce == false then
&#9;&#9;&#9;&#9;debounce = true
&#9;&#9;&#9;&#9;doorOpen()
&#9;&#9;&#9;&#9;wait(time)
&#9;&#9;&#9;&#9;doorClose()
&#9;&#9;&#9;&#9;debounce = false
&#9;&#9;&#9;end
&#9;&#9;else
&#9;&#9;if human ~= nil then
&#9;&#9;&#9;doorClose()
&#9;&#9;&#9;debounce = false
&#9;&#9;end
&#9;end
end
door.Touched:connect(onTouched)</ProtectedString>
