							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Main</string>
							<ProtectedString name="Source">player = script.Parent.Parent.Parent.Parent.Parent
money = player.leaderstats.Points
price = 1500
tool = game.Lighting:findFirstChild(&quot;PaintballGun&quot;)


function buy()
if money.Value &gt;= price then
money.Value = money.Value - price
local a = tool:clone()
a.Parent = player.Backpack
local b = tool:clone()
b.Parent = player.StarterGear

end
end
script.Parent.MouseButton1Down:connect(buy)</ProtectedString>
