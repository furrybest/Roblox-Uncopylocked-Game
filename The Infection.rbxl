					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">BloodOnDeath</string>
					<ProtectedString name="Source">function onPlayerDied(dead)
local hum = script.Parent.Humanoid
if (hum.Health==0) then
wait(0.1)
h = script.Parent
t = script.Parent
i = 0
for i = 1, 10 do
local b = Instance.new(&quot;Part&quot;)
b.Parent = h
b.FormFactor = &quot;Plate&quot;
b.Shape = &quot;Ball&quot;
b.Size = Vector3.new(1, 1, 1)
b.BrickColor = BrickColor.new(21)
b.Transparency = 0.2
b.TopSurface = &quot;Smooth&quot;
b.BottomSurface = &quot;Smooth&quot;
b.Position = h.Head.Position
end
s = script.Clean:Clone()
s.Disabled = false
s.Parent = b
end
end
 
script.Parent.Humanoid.Died:connect(onPlayerDied)</ProtectedString>
