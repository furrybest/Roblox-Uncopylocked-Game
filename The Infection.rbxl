					<string name="Name">GunScript</string>
					<ProtectedString name="Source">originalAmmo = script.Parent.Ammo.Value
m = Instance.new(&quot;Message&quot;)
function computeDirection(vec)&#9;local lenSquared = vec.magnitude^2&#9;local invSqrt = 1 / math.sqrt(lenSquared)&#9;return Vector3.new(vec.x * invSqrt, vec.y * invSqrt, vec.z * invSqrt)
end
function updateAmmo()&#9;m.Text = &quot; &quot;&#9;--for i = 1,script.Parent.Ammo.Value do&#9;--&#9;m.Text = m.Text .. &quot;|&quot;&#9;--end&#9;--for i = 1, (originalAmmo - script.Parent.Ammo.Value) do&#9;--&#9;m.Text = m.Text .. &quot; &quot;&#9;--end&#9;m.Text = m.Text .. &quot; &quot; .. script.Parent.Ammo.Value.. &quot;/10&quot;end
function fire(v)&#9;for i = 1,1 do&#9;&#9;script.Parent.Handle.Fire:play()
&#9;&#9;script.Parent.Ammo.Value = script.Parent.Ammo.Value - 1&#9;&#9;updateAmmo()
&#9;&#9;local dir = v - script.Parent[&quot;Handle&quot;].Position&#9;&#9;dir = computeDirection(dir)
&#9;&#9;local pos = script.Parent[&quot;Handle&quot;].Position + (dir * 5)
&#9;&#9;local p = Instance.new(&quot;Part&quot;)
&#9;&#9;local fire = Instance.new(&quot;Fire&quot;)&#9;&#9;p.Name = &quot;Projectile&quot;&#9;&#9;p.CFrame = CFrame.new(pos, pos + dir)&#9;&#9;p.BrickColor = BrickColor.new(24)
      fire.Parent = p&#9;&#9;p.Reflectance = 0.1&#9;&#9;p.Velocity = (script.Parent.Parent[&quot;Head&quot;].Position - v).unit * -150&#9;&#9;p.Size = Vector3.new(1, 0.4, 1)&#9;&#9;p.formFactor = 2
&#9;&#9;local mesh = script.Parent.Mesh:clone()&#9;&#9;mesh.Parent = p
&#9;&#9;local upforce = Instance.new(&quot;BodyForce&quot;)&#9;&#9;upforce.force = Vector3.new(0, p:GetMass() * 196, 0)&#9;&#9;upforce.Parent = p

&#9;&#9;local creator = Instance.new(&quot;ObjectValue&quot;)
&#9;&#9;creator.Name = &quot;creator&quot;
&#9;&#9;creator.Value = game.Players:GetPlayerFromCharacter(script.Parent.Parent)
&#9;&#9;creator.Parent = p
&#9;&#9;local s = script.Parent[&quot;ProjectileScript&quot;]:Clone()&#9;&#9;s.Disabled = false&#9;&#9;s.Parent = p
&#9;&#9;p.Parent = game.Workspace
&#9;&#9;wait(00.1)
&#9;&#9;script.Parent.Handle.Fire:play()
&#9;&#9;script.Parent.Ammo.Value = script.Parent.Ammo.Value - 1
&#9;&#9;updateAmmo()
&#9;&#9;local p2 = Instance.new(&quot;Part&quot;)
&#9;&#9;local fire2 = Instance.new(&quot;Fire&quot;)
&#9;&#9;p2.Name = &quot;Projectile2&quot;
&#9;&#9;p2.CFrame = CFrame.new(pos, pos + dir)
      fire2.Parent = p2
&#9;&#9;p2.BrickColor = BrickColor.new(24)
&#9;&#9;p2.Reflectance = 0.1
&#9;&#9;p2.Velocity = (script.Parent.Parent[&quot;Head&quot;].Position - v).unit * -150
&#9;&#9;p2.Size = Vector3.new(1, 0.4, 1)
&#9;&#9;p2.formFactor = 2

&#9;&#9;local mesh = script.Parent.Mesh:clone()
&#9;&#9;mesh.Parent = p2

&#9;&#9;local upforce = Instance.new(&quot;BodyForce&quot;)
&#9;&#9;upforce.force = Vector3.new(0, p:GetMass() * 196, 0)
&#9;&#9;upforce.Parent = p2

&#9;&#9;local creator = Instance.new(&quot;ObjectValue&quot;)
&#9;&#9;creator.Name = &quot;creator&quot;
&#9;&#9;creator.Value = game.Players:GetPlayerFromCharacter(script.Parent.Parent)
&#9;&#9;creator.Parent = p2

&#9;&#9;local s2 = script.Parent[&quot;ProjectileScript&quot;]:Clone()
&#9;&#9;s2.Disabled = false
&#9;&#9;s2.Parent = p2
&#9;&#9;p2.Parent = game.Workspace

&#9;&#9;wait(00.1)

&#9;&#9;script.Parent.Handle.Fire:play()
&#9;&#9;script.Parent.Ammo.Value = script.Parent.Ammo.Value - 1
&#9;&#9;updateAmmo()
&#9;&#9;local p23 = Instance.new(&quot;Part&quot;)
&#9;&#9;local fire22 = Instance.new(&quot;Fire&quot;)
&#9;&#9;p23.Name = &quot;Projectile3&quot;
&#9;&#9;p23.CFrame = CFrame.new(pos, pos + dir)
      fire22.Parent = p23
&#9;&#9;p23.BrickColor = BrickColor.new(24)
&#9;&#9;p23.Reflectance = 0.1
&#9;&#9;p23.Velocity = (script.Parent.Parent[&quot;Head&quot;].Position - v).unit * -150
&#9;&#9;p23.Size = Vector3.new(1, 0.4, 1)
&#9;&#9;p23.formFactor = 2

&#9;&#9;local mesh = script.Parent.Mesh:clone()
&#9;&#9;mesh.Parent = p23

&#9;&#9;local upforce = Instance.new(&quot;BodyForce&quot;)
&#9;&#9;upforce.force = Vector3.new(0, p:GetMass() * 196, 0)
&#9;&#9;upforce.Parent = p23

&#9;&#9;local creator = Instance.new(&quot;ObjectValue&quot;)
&#9;&#9;creator.Name = &quot;creator&quot;
&#9;&#9;creator.Value = game.Players:GetPlayerFromCharacter(script.Parent.Parent)
&#9;&#9;creator.Parent = p23

&#9;&#9;local s23 = script.Parent[&quot;ProjectileScript&quot;]:Clone()
&#9;&#9;s23.Disabled = false
&#9;&#9;s23.Parent = p23
&#9;&#9;p23.Parent = game.Workspace
&#9;&#9;wait(00.1)

&#9;&#9;script.Parent.Handle.Fire:play()
&#9;&#9;script.Parent.Ammo.Value = script.Parent.Ammo.Value - 1
&#9;&#9;updateAmmo()
&#9;&#9;local p234 = Instance.new(&quot;Part&quot;)
&#9;&#9;local fire222 = Instance.new(&quot;Fire&quot;)
&#9;&#9;p234.Name = &quot;Projectile34&quot;
&#9;&#9;p234.CFrame = CFrame.new(pos, pos + dir)
      fire222.Parent = p234
&#9;&#9;p234.BrickColor = BrickColor.new(24)
&#9;&#9;p23.Reflectance = 0.1
&#9;&#9;p234.Velocity = (script.Parent.Parent[&quot;Head&quot;].Position - v).unit * -150
