						<string name="Name">NormalVIP</string>
						<ProtectedString name="Source">function Enter(p)
wait(1)
if p.Character.Torso.roblox.Texture == &quot;http://www.roblox.com/asset/?id=67915715&quot; then  --Texture of VIP shirt.
local c = game.Lighting:FindFirstChild(&quot;NormalVIP&quot;)      -- Refer to above.                                   
if c ~= nil then                  --TOUCH NOTHING BEYOND HERE UNLESS YOU KNOW WHAT TO DO
local d = c:GetChildren()
for i=1, #d do
d[i]:Clone().Parent = p.Backpack
d[i]:Clone().Parent = p.StarterGear
end
end
end
p.Changed:connect(function (property)    --Nothing here ethier
if (property == &quot;Character&quot;) then 
Respawn(p)
end 
end)
end 
game.Players.ChildAdded:connect(Enter)</ProtectedString>
