s.Parent = script.Parent
s.SoundId = &quot;http://roblox.com/asset/?id=10209834&quot;
s.Pitch = 1.5
s.Volume = 0.5

function hover()
s:Play()
end
script.Parent.MouseEnter:connect(hover)</ProtectedString>
