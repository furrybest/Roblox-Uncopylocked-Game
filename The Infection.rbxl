			<Item class="Script" referent="RBX5244">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Fake Arm/Leg/Torso</string>
					<ProtectedString name="Source">--100% By chris7766
--Free To use
--You Can Post this as one of your models
--But say &quot;Not Mine&quot;
--This Was A hard Script for me
--Please Dont Steal it

Tool = script.Parent
Farm = Instance.new(&quot;Part&quot;)
Farm.formFactor = &quot;Custom&quot;
Farm.Size = Vector3.new(0.99,1.99,0.99)
tor = Instance.new(&quot;Part&quot;)
tor.formFactor = &quot;Custom&quot;
tor.Size = Vector3.new(1.99,1.99,0.99)
local q = nil
local e = nil
deb1 = true
deb2 = true

function EQ(mouse)
if deb1 then
deb1 = false
print(&quot;Equipped&quot;)
player = Tool.Parent
Copyright = game.Lighting.Right:Clone()
arm1 = Farm:clone()
arm1.Parent = Tool
arm1.Name = &quot;Farm1&quot;
Copyright.Parent = arm1
arm1.Transparency = 0.5
arm1.BrickColor = player:FindFirstChild(&quot;Right Arm&quot;).BrickColor
Weld = Instance.new(&quot;Weld&quot;)
Weld.Part0 = player:FindFirstChild(&quot;Right Arm&quot;)
Weld.Part1 = arm1
Weld.Parent = arm1

arm2 = Farm:clone()
Copyright2 = game.Lighting.Left:Clone()
arm2.Parent = Tool
arm2.Name = &quot;Farm2&quot;
Copyright2.Parent = arm2
arm2.Transparency = 0.5
arm2.BrickColor = player:FindFirstChild(&quot;Left Arm&quot;).BrickColor
Weld2 = Instance.new(&quot;Weld&quot;)
Weld2.Part0 = player:FindFirstChild(&quot;Left Arm&quot;)
Weld2.Part1 = arm2
Weld2.Parent = arm2

q = arm1
e = arm2
deb1 = true
end
end

function DM()
if deb2 then
deb2 = false
q.Parent = nil
e.Parent = nil
print(&quot;Dismount&quot;)
deb2 = true
end
end

script.Parent.Equipped:connect(EQ)
script.Parent.Unequipped:connect(DM)

</ProtectedString>
				</Properties>
			</Item>
		</Item>
