		<Item class="Script" referent="RBX2340">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Auto Regen</string>
				<ProtectedString name="Source">model = game.Workspace.Stophumanzombie
messageText = &quot;&quot;

message = Instance.new(&quot;Message&quot;)
message.Text = messageText
backup = model:clone()

while true do
&#9;wait(700) -- regenerate this model every ... seconds

&#9;message.Parent = game.Workspace
&#9;model:remove()

&#9;wait() -- display regen message for ... seconds

&#9;model = backup:clone(1)
&#9;model.Parent = game.Workspace
&#9;model:makeJoints(1)
&#9;message.Parent = nil
end

</ProtectedString>
