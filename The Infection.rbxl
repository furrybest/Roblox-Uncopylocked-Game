							<string name="Name">Sell</string>
							<ProtectedString name="Source">price = 0 --Change to the price of the weapon.

n = script.Parent.Parent.Notification

function onButton1Click()
find = script.Parent.Parent.Parent.Parent.Parent.Backpack:findFirstChild(&quot;Pistol(Lvl 3)&quot;) --Change to name of the sword.
find2 = script.Parent.Parent.Parent.Parent.Parent.StarterGear:findFirstChild(&quot;Pistol(Lvl 3)&quot;) --Change to name of the sword.
if find ~= nil then
money = script.Parent.Parent.Parent.Parent.Parent.leaderstats.Points --Change &quot;Money&quot; to the name of the leaderstat.
find:Remove()
money.Value = money.Value + price
else
end
if find2 ~= nil then
money = script.Parent.Parent.Parent.Parent.Parent.leaderstats.Points --Change &quot;Money&quot; to the name of the leaderstat.
find2:Remove()
money.Value = money.Value + price
n.Visible = true
n.Text = &quot;Weapon removed just say save/ to be sure.&quot;
wait(4)
n.Visible = false
n.Text = &quot;Text&quot;
else
n.Visible = true
n.Text = &quot;No weapon was found.&quot;
wait(4)
n.Visible = false
n.Text = &quot;Text&quot;
end
end



script.Parent.MouseButton1Click:connect(onButton1Click)


</ProtectedString>
