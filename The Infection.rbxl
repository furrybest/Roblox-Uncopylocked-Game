				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">RemoveHats2112332</string>
				<ProtectedString name="Source">game.Workspace.ChildAdded:connect(function(obj)&#9;&#9;-- Track new items added to the workspace
&#9;if (obj:IsA(&quot;Hat&quot;)) then&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;-- Check to see if the object is a hat
&#9;&#9;wait(0.5)&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;-- Give the player a chance to put the hat back on
&#9;&#9;if (obj.Parent == game.Workspace) then&#9;&#9;&#9;-- If hat is still just lying around, remove it
&#9;&#9;&#9;obj:Remove()
&#9;&#9;end
&#9;end
end)</ProtectedString>
