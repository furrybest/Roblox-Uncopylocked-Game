						<X>0</X>
						<Y>0</Y>
						<Z>0</Z>
					</Vector3>
					<Vector3 name="Scale">
						<X>0.200000003</X>
						<Y>0.5</Y>
						<Z>1.59000003</Z>
					</Vector3>
