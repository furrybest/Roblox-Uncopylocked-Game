Weld2.Part1 = arm2
Weld2.Parent = arm2

q = arm1
e = arm2
deb1 = true
end
end

function DM()
if deb2 then
deb2 = false
q.Parent = nil
e.Parent = nil
print(&quot;Dismount&quot;)
deb2 = true
end
end

script.Parent.Equipped:connect(EQ)
script.Parent.Unequipped:connect(DM)

</ProtectedString>
