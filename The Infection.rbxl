							<ProtectedString name="Source">player = script.Parent.Parent.Parent.Parent.Parent
money = player.leaderstats.Points
price = 0
tool = game.Lighting:findFirstChild(&quot;ddd&quot;)


function buy()
if money.Value &gt;= price then
money.Value = money.Value - price
local a = tool:clone()
a.Parent = player.Backpack
local b = tool:clone()
b.Parent = player.StarterGear

end
end
