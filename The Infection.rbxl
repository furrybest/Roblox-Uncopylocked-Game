				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">10 Points Badge</string>
				<ProtectedString name="Source">local BadgeID = 69033661 -- the badge id
local Cash = &quot;Points&quot; -- your tycoon currency of money
local HowMuch = 10 -- amount of cash
game.Players.PlayerAdded:connect(function(p) -- leave the rest
repeat wait() until p:findFirstChild(&quot;leaderstats&quot;) ~= nil 
p.leaderstats[Cash].Changed:connect(function() 
if p.leaderstats[Cash].Value &lt;= HowMuch - 1 then return end 
game:GetService(&quot;BadgeService&quot;):AwardBadge(p.userId, BadgeID) 
end) 
end) 

-- Fully functional!</ProtectedString>
