			<Item class="Script" referent="RBX5809">
				<Properties>
					<bool name="Disabled">true</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">ProjectileScript</string>
					<ProtectedString name="Source">damage = 25

game:GetService(&quot;Debris&quot;):AddItem(script.Parent, 8)
function onTouched(hit)
&#9;if(hit.Parent==nil)then return end

&#9;if(hit.Parent:findFirstChild(&quot;Humanoid&quot;)~=nil)and
&#9;(hit.Parent:FindFirstChild(&quot;creator&quot;)~=nil)then
&#9;&#9;connection:disconnect()
&#9;&#9;hit.Parent[&quot;Humanoid&quot;]:TakeDamage(damage)

&#9;&#9;local creator = script.Parent.creator:Clone()
&#9;&#9;creator.Value = script.Parent.creator.Value
&#9;&#9;creator.Parent = hit.Parent.Humanoid

&#9;&#9;wait(.25)

&#9;&#9;creator:remove()
&#9;end
&#9;script.Parent:Remove()
end
connection = script.Parent.Touched:connect(onTouched)
</ProtectedString>
				</Properties>
			</Item>
			<Item class="BlockMesh" referent="RBX5810">
				<Properties>
					<float name="Bevel">0</float>
					<float name="Bevel Roundness">0</float>
