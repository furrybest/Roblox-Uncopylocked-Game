		<Item class="Script" referent="RBX18">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Death Script</string>
				<ProtectedString name="Source">function onPlayerRespawned(newPlayer) 
local s = script.BloodOnDeath:clone() 
local name = newPlayer.Name 
local player = script.Parent:findFirstChild(name) 
s.Parent = player 

a = script.BloodWhenShot:clone() 
local name = newPlayer.Name 
local player = script.Parent:findFirstChild(name) 
wait(1)
a:clone().Parent = player.Torso 


h = script.Headshot:clone() 

local name = newPlayer.Name 
local player = script.Parent:findFirstChild(name) 
wait(1)
h:clone().Parent = player.Head

end

script.Parent.ChildAdded:connect(onPlayerRespawned)
</ProtectedString>
			</Properties>
