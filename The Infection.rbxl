find2 = script.Parent.Parent.Parent.Parent.Parent.StarterGear:findFirstChild(&quot;NativeAmericanBow&quot;) --Change to name of the sword.
if find ~= nil then
money = script.Parent.Parent.Parent.Parent.Parent.leaderstats.Points --Change &quot;Money&quot; to the name of the leaderstat.
