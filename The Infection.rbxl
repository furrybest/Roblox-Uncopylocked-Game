			<Item class="Script" referent="RBX2300">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Fumes</string>
					<ProtectedString name="Source">--This will keep the humans inside the house. If they go outside, their health will slowly diminish until they go back inside.
--Zombies regenerate health while outside the house.

base = script.Parent
test5 = game.workspace.test5

humans = game.Teams[&quot;Humans&quot;]
zombies = game.Teams[&quot;Zombies&quot;]

function sendMsg(text, player)
local msg = nil
if(player.PlayerGui:FindFirstChild(&quot;FumeMessage&quot;)~=nil)then
msg = player.PlayerGui.FumeMessage
else
msg = Instance.new(&quot;Message&quot;)
end
msg.Name = &quot;FumeMessage&quot;
msg.Text = text
msg.Parent = player.PlayerGui
end

function removeMsg(player)
if(player.PlayerGui~=nil)and(player.PlayerGui:FindFirstChild(&quot;FumeMessage&quot;)~=nil)then
player.PlayerGui.FumeMessage:remove()
end
end

function fumes()
local player = game.Players:GetChildren()
for p = 1, #player do
removeMsg(player[p])
if(player[p].TeamColor==humans.TeamColor)and
(player[p].Character~=nil)then
local torso = player[p].Character:FindFirstChild(&quot;Torso&quot;)
local h = player[p].Character:FindFirstChild(&quot;Humanoid&quot;)
if(torso~=nil)and(h~=nil)then
if(torso.Position.x&gt;base.Position.x +base.Size.x/2)or
  (torso.Position.x&lt;base.Position.x -base.Size.x/2)or
  (torso.Position.z&gt;base.Position.z +base.Size.z/2)or
  (torso.Position.z&lt;base.Position.z -base.Size.z/2) or (torso.Position.y &gt; 448.3 ) then
if(torso.Position.x&gt;test5.Position.x +test5.Size.x/2)or
  (torso.Position.x&lt;test5.Position.x -test5.Size.x/2)or
  (torso.Position.z&gt;test5.Position.z +test5.Size.z/2)or
  (torso.Position.z&lt;test5.Position.z -test5.Size.z/2) or (torso.Position.y &gt; 312.5 ) then 

h:TakeDamage(5)
sendMsg(&quot;Gases are bad, get in the house!&quot;, player[p])
else
h.Health = h.Health +0
removeMsg(player[p])
end
end
end
elseif(player[p].TeamColor==zombies.TeamColor)and
(player[p].Character~=nil)then
local torso = player[p].Character:FindFirstChild(&quot;Torso&quot;)
local h = player[p].Character:FindFirstChild(&quot;Humanoid&quot;)
if(torso~=nil)and(h~=nil)then
if(torso.Position.x&gt;base.Position.x +base.Size.x/2)or
  (torso.Position.x&lt;base.Position.x -base.Size.x/2)or
  (torso.Position.z&gt;base.Position.z +base.Size.z/2)or
  (torso.Position.z&lt;base.Position.z -base.Size.z/2) or (torso.Position.y &gt; 424.9 ) then
if(torso.Position.x&gt;test5.Position.x +test5.Size.x/2)or
  (torso.Position.x&lt;test5.Position.x -test5.Size.x/2)or
  (torso.Position.z&gt;test5.Position.z +test5.Size.z/2)or
  (torso.Position.z&lt;test5.Position.z -test5.Size.z/2) or (torso.Position.y &gt; 312.5 ) then
h.Health = h.Health +0
end
end
end
end
end
end

while true do
wait(.95)
fumes()
end
</ProtectedString>
				</Properties>
			</Item>
