							<string name="Name">FixCheck</string>
							<ProtectedString name="Source">--constants first
door = script.Parent
brick_name = &quot;Stomach&quot; --brick needs to hit
time = 1 --time open

--variables second
debounce = false 

function doorOpen()
&#9;door.CanCollide = false
&#9;door.Transparency = 1
end

function doorClose()
&#9;door.CanCollide = false
&#9;door.Transparency = 1
end

function onTouched(part) --- I Want it to kill the player if the brick is not a certain brick
&#9;local human = part.Parent:findFirstChild(&quot;Humanoid&quot;)
&#9;if part.Parent == nil or human == nil then return; end -- return if player or object nil.
&#9;&#9;if part.Parent:findFirstChild(&quot;Stomach&quot;) ~= nil then
&#9;&#9;&#9;if debounce == false then
&#9;&#9;&#9;&#9;debounce = true
&#9;&#9;&#9;&#9;doorOpen()
&#9;&#9;&#9;&#9;wait(time)
&#9;&#9;&#9;&#9;doorClose()
&#9;&#9;&#9;&#9;debounce = false
&#9;&#9;&#9;end
&#9;&#9;else
&#9;&#9;if human ~= nil then
&#9;&#9;&#9;doorClose()
&#9;&#9;&#9;debounce = false
&#9;&#9;&#9;human.Health = 0
&#9;&#9;end
&#9;end
end
door.Touched:connect(onTouched)</ProtectedString>
						</Properties>
					</Item>
					<Item class="Script" referent="RBX2419">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><url>http://www.roblox.com/asset/?id=13326026</url></Content>
							<string name="Name">BadgeAwarderScript</string>
							<ProtectedString name="Source">print(&quot;Badge Awarder Loaded. BadgeID: &quot; .. script.Parent.BadgeID.Value)



-- ROBLOX scripter hackers, see what you can do with this:
-- game:GetService(&quot;BadgeService&quot;):UserHasBadge(userid, badgeid)


function OnTouch(part)
&#9;if (part.Parent:FindFirstChild(&quot;Humanoid&quot;) ~= nil) then
&#9;&#9;local p = game.Players:GetPlayerFromCharacter(part.Parent)
&#9;&#9;if (p ~= nil) then
&#9;&#9;&#9;print(&quot;Awarding BadgeID: &quot; ..script.Parent.BadgeID.Value .. &quot; to UserID: &quot; .. p.userId)
&#9;&#9;&#9;local b = game:GetService(&quot;BadgeService&quot;)
&#9;&#9;&#9;b:AwardBadge(p.userId, script.Parent.BadgeID.Value)
&#9;&#9;end
&#9;end
end

script.Parent.Touched:connect(OnTouch)
</ProtectedString>
