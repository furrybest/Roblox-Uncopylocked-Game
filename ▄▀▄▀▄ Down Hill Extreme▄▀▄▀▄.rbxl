					<Item class="Script" referent="RBX1131">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Buy</string>
							<string name="Source">amnt = 10&#13;&#10;state = 0&#13;&#10;hold = false&#13;&#10;prt = script.Parent&#13;&#10;&#13;&#10;function GiveProduct(human)&#13;&#10;&#9;local teamColor = Color3.new(1,1,0)&#13;&#10;&#9;human.Torso.Color = teamColor&#13;&#10;end&#13;&#10;&#13;&#10;function onTouched(part)&#13;&#10;&#9;local h = part.Parent:findFirstChild(&quot;Humanoid&quot;)&#13;&#10;&#9;if (h~=nil and hold==false) then&#13;&#10;&#9;&#9;hold=true&#13;&#10;&#9;&#9;state=state+1&#13;&#10;&#9;&#9;prt.Color = Color3.new(0,0,0)&#13;&#10;&#9;&#9;wait(3)&#13;&#10;&#9;&#9;if (state==1) then&#13;&#10;&#9;&#9;&#9;prt.Color = Color3.new(1,1,0)&#13;&#10;&#9;&#9;end&#13;&#10;&#9;&#9;if (state==2) then&#13;&#10;&#9;&#9;&#9;prt.Color = Color3.new(1,0,0)&#13;&#10;&#9;&#9;&#9;local thisplr = game.Players:findFirstChild(h.Parent.Name)&#13;&#10;&#9;&#9;&#9;if (thisplr~=nil) then&#13;&#10;&#9;&#9;&#9;&#9;local stats = thisplr:findFirstChild(&quot;leaderstats&quot;)&#13;&#10;&#9;&#9;&#9;&#9;if (stats~=nil) then&#13;&#10;&#9;&#9;&#9;&#9;&#9;local score = stats:findFirstChild(&quot;Point&quot;)&#13;&#10;&#9;&#9;&#9;&#9;&#9;if (score~=nil) then&#13;&#10;&#9;&#9;&#9;&#9;&#9;&#9;if (score.Value &gt;=amnt) then&#13;&#10;&#9;&#9;&#9;&#9;&#9;&#9;&#9;score.Value = score.Value - amnt&#13;&#10;&#9;&#9;&#9;&#9;&#9;&#9;&#9;GiveProduct(h)&#13;&#10;&#9;&#9;&#9;&#9;&#9;&#9;end&#13;&#10;&#9;&#9;&#9;&#9;&#9;end&#13;&#10;&#9;&#9;&#9;&#9;end&#13;&#10;&#9;&#9;&#9;end&#13;&#10;&#9;&#9;&#9;wait(3)&#13;&#10;&#9;&#9;&#9;prt.Color = Color3.new(0,1,0)&#13;&#10;&#9;&#9;&#9;state=0&#13;&#10;&#9;&#9;end&#13;&#10;&#9;&#9;hold=false&#13;&#10;&#9;end&#13;&#10;end&#13;&#10;&#13;&#10;script.Parent.Touched:connect(onTouched)</string>
							<bool name="archivable">true</bool>
						</Properties>
					</Item>
				</Item>
