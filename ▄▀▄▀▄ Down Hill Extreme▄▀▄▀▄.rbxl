		<Item class="Script" referent="RBX79">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Leaderboard</string>
				<string name="Source">print(&quot;Custom Leaderboard running!&quot;)&#13;&#10;&#13;&#10;function onPlayerEntered(newPlayer)&#13;&#10;&#13;&#10;&#9;local stats = Instance.new(&quot;IntValue&quot;)&#13;&#10;&#9;stats.Name = &quot;leaderstats&quot;&#13;&#10;&#13;&#10;&#9;local mins = Instance.new(&quot;IntValue&quot;)&#13;&#10;&#9;mins.Name = &quot;Mins.&quot;&#13;&#10;&#9;mins.Value = 0&#13;&#10;&#13;&#10;&#9;local cash = Instance.new(&quot;IntValue&quot;)&#13;&#10;&#9;cash.Name = &quot;Point&quot;&#13;&#10;&#9;cash.Value = 0&#13;&#10;&#13;&#10;&#9;mins.Parent = stats&#13;&#10;&#9;cash.Parent = stats&#13;&#10;&#9;&#13;&#10;&#9;stats.Parent = newPlayer&#13;&#10;&#13;&#10;&#9;while true do&#13;&#10;&#9;&#9;wait(60)&#13;&#10;&#9;&#9;mins.Value = mins.Value + 1&#13;&#10;&#9;end&#13;&#10;end&#13;&#10;&#13;&#10;game.Players.ChildAdded:connect(onPlayerEntered)</string>
				<bool name="archivable">true</bool>
			</Properties>
		</Item>
		<Item class="Script" referent="RBX80">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Regenerate</string>
				<string name="Source">model = game.Workspace.Regen&#13;&#10;messageText = &quot;Regenerate Buggys Trucks off Roaders...&quot;&#13;&#10;&#13;&#10;message = Instance.new(&quot;Hint&quot;)&#13;&#10;message.Text = messageText&#13;&#10;backup = model:clone()&#13;&#10;&#13;&#10;while true do&#13;&#10;&#9;wait(80) -- regenerate this model every 300 seconds&#13;&#10;&#13;&#10;&#9;message.Parent = game.Workspace&#13;&#10;&#9;model:remove()&#13;&#10;&#13;&#10;&#9;wait(6) -- display regen message for 4 seconds&#13;&#10;&#13;&#10;&#9;model = backup:clone()&#13;&#10;&#9;model.Parent = game.Workspace&#13;&#10;&#9;model:makeJoints()&#13;&#10;&#9;message.Parent = nil&#13;&#10;end&#13;&#10;</string>
				<bool name="archivable">true</bool>
			</Properties>
		</Item>
