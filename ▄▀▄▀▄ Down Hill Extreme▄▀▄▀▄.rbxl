			<Item class="Script" referent="RBX3528">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">SeekAsylum</string>
					<string name="Source">print(&quot;SouAsylum Loaded&quot;)&#13;&#10;bin = script.Parent&#13;&#10;&#13;&#10;function TeleportPlayer(player)&#13;&#10;&#9;&#13;&#10;&#13;&#10;&#13;&#10;&#9;local char = player.Character.Torso&#13;&#10;&#13;&#10;&#9;local cf = char.CFrame&#13;&#10;&#13;&#10;&#9;local lx = 0&#13;&#10;&#9;local ly = y&#13;&#10;&#9;local lz = 0&#13;&#10;&#13;&#10;&#9;char.CFrame = CFrame.new(Vector3.new(&#13;&#10;&#9;game.Workspace.SpawnPad.Position.x,&#13;&#10;&#9;game.Workspace.SpawnPad.Position.y + 20,&#13;&#10;&#9;game.Workspace.SpawnPad.Position.z)&#13;&#10;&#9;, Vector3.new(lx,ly,lz))&#9;&#13;&#10;end&#13;&#10;&#13;&#10;&#13;&#10;enabled = true&#13;&#10;function onButton1Down(mouse)&#13;&#10;&#9;if not enabled then&#13;&#10;&#9;&#9;return&#13;&#10;&#9;end&#13;&#10;&#13;&#10;&#9;enabled = false&#13;&#10;&#9;mouse.Icon = &quot;rbxasset://textures\\ArrowFarCursor.png&quot;&#13;&#10;&#13;&#10;&#9;sound = Instance.new(&quot;Sound&quot;)&#13;&#10;&#9;&#9;sound.SoundId = &quot;rbxasset://sounds\\Launching rocket.wav&quot;&#13;&#10;&#9;&#9;sound.Parent = game.Workspace&#13;&#10;&#9;&#9;sound:play()&#13;&#10;&#13;&#10;&#9;TeleportPlayer(game.Players.LocalPlayer)&#13;&#10;&#13;&#10;&#9;wait(5)&#13;&#10;&#9;mouse.Icon = &quot;rbxasset://textures\\ArrowCursor.png&quot;&#13;&#10;&#9;enabled = true&#13;&#10;&#13;&#10;end&#13;&#10;&#13;&#10;function onSelected(mouse)&#13;&#10;&#9;print(&quot;asylum selected&quot;)&#13;&#10;&#9;mouse.Icon = &quot;rbxasset://textures\\ArrowCursor.png&quot;&#13;&#10;&#9;mouse.Button1Down:connect(function() onButton1Down(mouse) end)&#13;&#10;end&#13;&#10;&#13;&#10;bin.Selected:connect(onSelected)</string>
					<bool name="archivable">true</bool>
				</Properties>
			</Item>
		</Item>
		<Item class="HopperBin" referent="RBX3529">
			<Properties>
				<token name="BinType">0</token>
				<string name="Name">Reset</string>
				<Content name="TextureId"><null></null></Content>
				<bool name="archivable">true</bool>
