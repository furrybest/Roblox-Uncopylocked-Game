					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Deanimator</string>
					<string name="Source">function onTouched(h)&#13;&#10;&#13;&#10;&#9;local lhip=h.Parent.Torso:findFirstChild(&quot;Left Hip&quot;)&#13;&#10;&#9;local rhip=h.Parent.Torso:findFirstChild(&quot;Right Hip&quot;)&#13;&#10;&#9;local lsho=h.Parent.Torso:findFirstChild(&quot;Left Shoulder&quot;)&#13;&#10;&#9;local rsho=h.Parent.Torso:findFirstChild(&quot;Right Shoulder&quot;)&#13;&#10;&#13;&#10;&#9;h.Parent.Animate:remove()&#13;&#10;&#9;lhip.DesiredAngle = 0&#13;&#10;&#9;lhip.CurrentAngle = 0&#13;&#10;&#9;lhip.MaxVelocity = 0&#13;&#10;&#9;rhip.DesiredAngle = 0&#13;&#10;&#9;rhip.CurrentAngle = 0&#13;&#10;&#9;rhip.MaxVelocity = 0&#13;&#10;&#9;lsho.DesiredAngle = 0&#13;&#10;&#9;lsho.CurrentAngle = 0&#13;&#10;&#9;lsho.MaxVelocity = 0&#13;&#10;&#9;rsho.DesiredAngle = 0&#13;&#10;&#9;rsho.CurrentAngle = 0&#13;&#10;&#9;rsho.MaxVelocity = 0&#13;&#10;end&#13;&#10;&#13;&#10;script.Parent.Touched:connect(onTouched)</string>
