			<Item class="Script" referent="RBX2095">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<string name="Source">function onTouch(part) &#13;&#10;local human = part.Parent:findFirstChild(&quot;Humanoid&quot;) &#13;&#10;if human ~= nil then &#13;&#10;part.Parent:findFirstChild(&quot;Head&quot;).Transparency = .3&#13;&#10;part.Parent:findFirstChild(&quot;Torso&quot;).Transparency = .3 &#13;&#10;part.Parent:findFirstChild(&quot;Left Arm&quot;).Transparency = .3 &#13;&#10;part.Parent:findFirstChild(&quot;Right Arm&quot;).Transparency = .3&#13;&#10;part.Parent:findFirstChild(&quot;Left Leg&quot;).Transparency = .3&#13;&#10;part.Parent:findFirstChild(&quot;Right Leg&quot;).Transparency = .3&#13;&#10;if part.Parent:findFirstChild(&quot;Head&quot;):findFirstChild(&quot;face&quot;) == nil then return end&#13;&#10;part.Parent:findFirstChild(&quot;Head&quot;):findFirstChild(&quot;face&quot;):remove()&#13;&#10;if part.Parent:findFirstChild(&quot;Torso&quot;):findFirstChild(&quot;roblox&quot;) == nil then return end&#13;&#10;part.Parent:findFirstChild(&quot;Torso&quot;):findFirstChild(&quot;roblox&quot;):remove()&#13;&#10;end &#13;&#10;end &#13;&#10;script.Parent.Touched:connect(onTouch) &#13;&#10;</string>
