				</Item>
				<Item class="Script" referent="RBX1913">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">ToolThing</string>
						<ProtectedString name="Source">for _,seat in pairs(script.Parent:GetChildren()) do
if seat:IsA(&quot;Seat&quot;) then

if seat:FindFirstChild(&quot;LastTool&quot;) == nil then
local LastTool = Instance.new(&quot;ObjectValue&quot;,seat)
LastTool.Name = &quot;LastTool&quot; end

seat.ChildAdded:connect(function(child) if tostring(child):lower() == &quot;seatweld&quot; then
if child.Part1 ~= nil then
local Torso = child.Part1
local player = game.Players:GetPlayerFromCharacter(Torso.Parent)
if player ~= nil then

local Tool = game.Lighting.Tools:FindFirstChild(&quot;Command&quot;)
if Tool ~= nil then
Tool = Tool:Clone()
Tool.Parent = player.Backpack
seat.LastTool.Value = Tool end
end end end end)

seat.ChildRemoved:connect(function(child) if tostring(child):lower() == &quot;seatweld&quot; then
if seat.LastTool.Value ~= nil then
seat.LastTool.Value:Remove()
seat.LastTool.Value = nil end end end) end end
</ProtectedString>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
			</Item>
			<Item class="Script" referent="RBX1914">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">ThroneSetScriptzorz</string>
					<ProtectedString name="Source">local SledPosition = script.Parent.Sled.Slider.Position
if game.Lighting.Models:FindFirstChild(&quot;Sled&quot;) == nil then
script.Parent.Sled:Clone().Parent = game.Lighting.Models end
local KingTeam = game.Teams[&quot;King/Queen&quot;]

function inZone(part,szone)
local x1 = szone.Position.x - (szone.Size.x / 2)
local x2 = szone.Position.x + (szone.Size.x / 2)

local z1 = szone.Position.z - (szone.Size.z / 2)
local z2 = szone.Position.z + (szone.Size.z / 2)

return part.Position.x &gt; x1 and part.Position.x &lt; x2 and part.Position.z &gt; z1 and part.Position.z &lt; z2

end
--wld
function Weld(x,y)
	local W = Instance.new(&quot;Weld&quot;,x)
	W.Part0 = x
	W.Part1 = y
	local CJ = CFrame.new(x.Position)
	local C0 = x.CFrame:inverse()*CJ
	local C1 = y.CFrame:inverse()*CJ
	W.C0 = C0
	W.C1 = C1
	W.Name = &quot;SledWeld&quot;
end
--wld

function Destroy(thingy)
Game:GetService(&quot;Debris&quot;):AddItem(thingy,5)
thingy:BreakJoints() end

function Unanchor(Model)
for _,stuff in pairs(Model:GetChildren()) do
if stuff:IsA(&quot;BasePart&quot;) then

if tostring(stuff):lower() ~= &quot;slider&quot; then
Weld(Model.Slider,stuff) end

stuff.Anchored = false end end
Model:MakeJoints()
end

function cntSled(sld)
sld:MakeJoints()
sld.Seat.ChildAdded:connect(function(child)
if tostring(child):lower() == &quot;seatweld&quot; then
Unanchor(sld) end end)
sld.Seat.ChildRemoved:connect(function(child)
if tostring(child):lower() == &quot;seatweld&quot; then
Destroy(sld) end end)

for _,stuff in pairs(sld:GetChildren()) do
if stuff:IsA(&quot;BasePart&quot;) then
stuff.Touched:connect(function(hit)
if tostring(hit):lower() == &quot;crash&quot; then
Destroy(sld) end end) end end end

cntSled(script.Parent.Sled)

function Fallthingy(brick,narb)
coroutine.resume(coroutine.create(function()
brick.Transparency = 1
brick.CanCollide = false
script.Parent.Trapdoor.CanCollide = false
narb:MoveTo(script.Parent.Trapdoor.Position)
wait(2)
script.Parent.Trapdoor.CanCollide = true
wait(4)
brick.Transparency = 0
brick.CanCollide = true
end))
end

function FinishGui(Gui,n)
Game:GetService(&quot;Debris&quot;):AddItem(Gui,10)
Gui.Cancel.MouseButton1Down:connect(function()
Gui:Remove() end)

Gui.Exit.MouseButton1Down:connect(function()
Fallthingy(script.Parent.Falls.ExitFall,n)
Gui:Remove() end)
Gui.Jail.MouseButton1Down:connect(function()
Fallthingy(script.Parent.Falls.JailFall,n)
Gui:Remove() end)

end

function SitAttack(hit)
wait(.2) if hit.Parent ~= nil then
if hit.Parent:IsA(&quot;Model&quot;) and hit.Parent:FindFirstChild(&quot;Humanoid&quot;) ~= nil then
hit.Parent.Humanoid.Sit = true end end end

function SeatedChanger(seat)
local SeatWeld = seat:FindFirstChild(&quot;SeatWeld&quot;)
if SeatWeld == nil then seat.Seated.Value = nil
elseif SeatWeld ~= nil then
seat.Seated.Value = game.Players:GetPlayerFromCharacter(SeatWeld.Part1.Parent) end end

script.Parent.ThroneSeats.Seat1.ChildAdded:connect(function() SeatedChanger(script.Parent.ThroneSeats.Seat1) end)
script.Parent.ThroneSeats.Seat1.ChildRemoved:connect(function() SeatedChanger(script.Parent.ThroneSeats.Seat1) end)
script.Parent.ThroneSeats.Seat2.ChildAdded:connect(function() SeatedChanger(script.Parent.ThroneSeats.Seat2) end)
script.Parent.ThroneSeats.Seat2.ChildRemoved:connect(function() SeatedChanger(script.Parent.ThroneSeats.Seat2) end)

script.Parent.Falls.ExitFall.Touched:connect(SitAttack)
script.Parent.Falls.JailFall.Touched:connect(SitAttack)

script.Parent.JailDoor.Touched:connect(function(hit)
wait(.2) if hit.Parent ~= nil then
if hit.Parent:IsA(&quot;Model&quot;) and hit.Parent:FindFirstChild(&quot;Humanoid&quot;) ~= nil then
local pl = game.Players:GetPlayerFromCharacter(hit.Parent)
if pl ~= nil then
if pl.PlayerGui:FindFirstChild(&quot;DoorGui&quot;) == nil and script.Parent.JailDoor.CanCollide then
local dGui = script.DoorGui:Clone()
dGui.Door.Value = script.Parent.JailDoor
dGui.Parent = pl.PlayerGui end end end end end)

while script.Parent ~= nil do wait()

if (script.Parent.Sled.Slider.Position - SledPosition).magnitude &gt; 20 then
script.Parent.Sled.Parent = game.Workspace
local sld = game.Lighting.Models.Sled:Clone()
sld.Parent = script.Parent
sld:MakeJoints()

sld.Seat.ChildAdded:connect(function(child)
if tostring(child):lower() == &quot;seatweld&quot; then
Unanchor(sld) end end)
sld.Seat.ChildRemoved:connect(function(child)
if tostring(child):lower() == &quot;seatweld&quot; then
Destroy(sld) end end)

for _,stuff in pairs(sld:GetChildren()) do
if stuff:IsA(&quot;BasePart&quot;) then
stuff.Touched:connect(function(hit)
if tostring(hit):lower() == &quot;crash&quot; then
Destroy(sld) end end) end end end


for _,player in pairs(game.Players:GetPlayers()) do
if player.Character ~= nil then
local Torso = player.Character:FindFirstChild(&quot;Torso&quot;)
if Torso ~= nil then
if inZone(Torso,script.Parent.Trapdoor) and script:FindFirstChild(tostring(player)) == nil then

local Adress = Instance.new(&quot;BoolValue&quot;,script)
Adress.Name = tostring(player)
Game:GetService(&quot;Debris&quot;):AddItem(Adress,10)

local s1 = script.Parent.ThroneSeats.Seat1.Seated
local s2 = script.Parent.ThroneSeats.Seat2.Seated

if s1.Value ~= nil then
if s1.Value.TeamColor == KingTeam.TeamColor then
local pg1 = s1.Value.PlayerGui:FindFirstChild(&quot;TrapFall&quot;)
if pg1 == nil then pg1 = script.TrapFall:Clone()
pg1.Parent = s1.Value.PlayerGui
FinishGui(pg1,player.Character) end end end

if s2.Value ~= nil then
if s2.Value.TeamColor == KingTeam.TeamColor then
local pg2 = s2.Value.PlayerGui:FindFirstChild(&quot;TrapFall&quot;)
if pg2 == nil then pg2 = script.TrapFall:Clone()
pg2.Parent = s2.Value.PlayerGui
FinishGui(pg2,player.Character) end end
end end end end end end
</ProtectedString>
