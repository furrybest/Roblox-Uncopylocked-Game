					<R00>-0.00353434728</R00>
					<R01>0.928546786</R01>
					<R02>0.371198475</R02>
					<R10>-0.999956429</R10>
					<R11>-7.37361624e-005</R11>
					<R12>-0.00933658332</R12>
					<R20>-0.00864208397</R20>
					<R21>-0.371215284</R21>
					<R22>0.928506613</R22>
				</CoordinateFrame>
				<string name="Name">SnowBall</string>
				<Content name="TextureId"><url>http://www.roblox.com/asset/?id=19326518</url></Content>
