			<Item class="LocalScript" referent="RBX9691">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Local Gui</string>
					<ProtectedString name="Source">local Tool = script.Parent;
local anim = nil
local mouse = nil

Tool.Enable.Changed:connect(function()
	if mouse then
		if Tool.Enable.Value == true then
			mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
		else
			mouse.Icon = &quot;rbxasset://textures\\GunWaitCursor.png&quot;
		end
	end
end)

function onButton1Down(mouser)
	mouse = mouser
	if not Tool.Enable.Value then
		return
	end

	Tool.Enable.Value = false
	wait(3)
	if anim then
		anim:Play(0.1,1,2)
	end
	wait(8)
	mouse = mouser
	Tool.Enable.Value = true
end

function resetIcon()
	mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
end

function onEquippedLocal(mouser)
	
	mouse = mouser
	if mouse == nil then
		print(&quot;Mouse not found&quot;)
		return 
	end

	if Tool.Enable.Value == true then
		mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
	else
		mouse.Icon = &quot;rbxasset://textures\\GunWaitCursor.png&quot;
		delay(8,resetIcon)
	end
	mouse.Button1Down:connect(function() onButton1Down(mouser) end)
	anim = script.Parent.Parent.Humanoid:LoadAnimation(Tool.kickback)

end

function onUnequippedLocal()

	if anim then
		anim:Stop()
		anim:remove()
		anim = nil
	end

end


Tool.Unequipped:connect(onUnequippedLocal)
Tool.Equipped:connect(onEquippedLocal)


</ProtectedString>
