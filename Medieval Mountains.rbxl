				</Properties>
			</Item>
		</Item>
		<Item class="Tool" referent="RBX10049">
			<Properties>
				<bool name="Enabled">true</bool>
				<CoordinateFrame name="Grip">
					<X>0.100000001</X>
					<Y>0</Y>
					<Z>0.200000003</Z>
					<R00>-0.00353434728</R00>
					<R01>0.928546786</R01>
