function refreshData()
if #Selection.Get()==1 then
p=Selection.Get()[1]
x,y,z,r00,r01,r02,r10,r11,r12,r20,r21,r22=p.CFrame:components()
v=p.Size
round_off=.001
obj39.Text=tostring(round(x,round_off))..&quot;, &quot;..tostring(round(y,round_off))..&quot;, &quot;..tostring(round(z,round_off))
obj41.Text=tostring(round(r00,round_off))..&quot;, &quot;..tostring(round(r01,round_off))..&quot;, &quot;..tostring(round(r02,round_off))
obj42.Text=tostring(round(r10,round_off))..&quot;, &quot;..tostring(round(r11,round_off))..&quot;, &quot;..tostring(round(r12,round_off))
obj43.Text=tostring(round(r20,round_off))..&quot;, &quot;..tostring(round(r21,round_off))..&quot;, &quot;..tostring(round(r22,round_off))
obj45.Text=tostring(round(v.x,round_off))..&quot;, &quot;..tostring(round(v.y,round_off))..&quot;, &quot;..tostring(round(v.z,round_off))
else
obj39.Text=&quot;?, ?, ?&quot;
obj41.Text=&quot;?, ?, ?&quot;
obj42.Text=&quot;?, ?, ?&quot;
obj43.Text=&quot;?, ?, ?&quot;
obj45.Text=&quot;?, ?, ?&quot;
end
end

round=function(number,multiple)
return math.floor(number/multiple+.5)*multiple
end

append_distance=0
handles.MouseDrag:connect(function(side,distance)
if handles.Color.Name==&quot;Bright orange&quot; then
x=(side==Enum.NormalId.Left or side==Enum.NormalId.Right) and 1 or 0
y=(side==Enum.NormalId.Top or side==Enum.NormalId.Bottom) and 1 or 0
z=(side==Enum.NormalId.Front or side==Enum.NormalId.Back) and 1 or 0
v=(side==Enum.NormalId.Right or side==Enum.NormalId.Top or side==Enum.NormalId.Back) and 1 or -1
d=round(distance-append_distance,movement_int)
append_distance=append_distance+d
if (axis_mode==&quot;X&quot;) then
for i,p in pairs(Selection.Get()) do
p.CFrame=p.CFrame*CFrame.new(x*d*v,y*d*v,z*d*v)
end
refreshHandles()
--[[AABB.CFrame=AABB.CFrame*CFrame.new(x*d*v,y*d*v,z*d*v)
axis_x.CFrame=axis_x.CFrame*CFrame.new(x*d*v,y*d*v,z*d*v)
axis_y.CFrame=axis_y.CFrame*CFrame.new(x*d*v,y*d*v,z*d*v)
axis_z.CFrame=axis_z.CFrame*CFrame.new(x*d*v,y*d*v,z*d*v)]]
else
for i,p in pairs(Selection.Get()) do
p.CFrame=CFrame.new(x*d*v,y*d*v,z*d*v)*p.CFrame
end
refreshHandles()
--[[AABB.CFrame=CFrame.new(x*d*v,y*d*v,z*d*v)*AABB.CFrame
axis_x.CFrame=CFrame.new(x*d*v,y*d*v,z*d*v)*axis_x.CFrame
axis_y.CFrame=CFrame.new(x*d*v,y*d*v,z*d*v)*axis_y.CFrame
axis_z.CFrame=CFrame.new(x*d*v,y*d*v,z*d*v)*axis_z.CFrame]]
end
elseif handles.Color.Name==&quot;Cyan&quot; then
if #Selection.Get()==1 then
x=(side==Enum.NormalId.Left or side==Enum.NormalId.Right) and 1 or 0
y=(side==Enum.NormalId.Top or side==Enum.NormalId.Bottom) and 1 or 0
z=(side==Enum.NormalId.Front or side==Enum.NormalId.Back) and 1 or 0
v=(side==Enum.NormalId.Right or side==Enum.NormalId.Top or side==Enum.NormalId.Back) and 1 or -1
d=round(distance-append_distance,1)
if (Selection.Get()[1].Size.x+d&lt;1 and x==1) then d=1-Selection.Get()[1].Size.x end
if (Selection.Get()[1].Size.y+d&lt;1 and y==1) then d=1-Selection.Get()[1].Size.y end
if (Selection.Get()[1].Size.z+d&lt;1 and z==1) then d=1-Selection.Get()[1].Size.z end
append_distance=append_distance+d
cf=Selection.Get()[1].CFrame
Selection.Get()[1].Size=Selection.Get()[1].Size+Vector3.new(x*d,y*d,z*d)
Selection.Get()[1].CFrame=cf*CFrame.new(x*d*v/2,y*d*v/2,z*d*v/2)

p=Selection.Get()[1]
refreshHandles()
--[[axis_x.Parent=LocalMsg
axis_x.Mesh.Scale=Vector3.new(.5,2,.5)
axis_x.CFrame=p.CFrame*CFrame.Angles(0,0,-math.pi/2)*CFrame.new(0,1+p.Size.x/2,0)
axis_y.Parent=LocalMsg
axis_y.Mesh.Scale=Vector3.new(.5,2,.5)
axis_y.CFrame=p.CFrame*CFrame.new(0,1+p.Size.y/2,0)
axis_z.Parent=LocalMsg
axis_z.Mesh.Scale=Vector3.new(.5,2,.5)
axis_z.CFrame=p.CFrame*CFrame.Angles(math.pi/2,0,0)*CFrame.new(0,1+p.Size.z/2,0)]]

end
end
end)
handles.MouseButton1Down:connect(function()
append_distance=0
end)

archandles.MouseDrag:connect(function(axis,relativeAngle,radius)

if #Selection.Get()==1 then
d=round(relativeAngle-append_distance,math.rad(rotate_rounding))
append_distance=append_distance+d
local x=(axis==Enum.Axis.X) and 1 or 0
local y=(axis==Enum.Axis.Y) and 1 or 0
local z=(axis==Enum.Axis.Z) and 1 or 0
p=Selection.Get()[1]
p.CFrame=p.CFrame*CFrame.Angles(x*d,y*d,z*d)
elseif #Selection.Get()&gt;1 then

d=round(relativeAngle-append_distance,math.rad(rotate_rounding))
append_distance=append_distance+d
local x=(axis==Enum.Axis.X) and 1 or 0
local y=(axis==Enum.Axis.Y) and 1 or 0
local z=(axis==Enum.Axis.Z) and 1 or 0
m1,m2=getAABB(Selection.Get())
center=CFrame.new(m1:lerp(m2,.5))
--the segment below was ripped from a script by Anaminus. Thank him for your being able to rotate multiple parts. ;)
local origin={}
for i,p in pairs(Selection.Get()) do
origin[p]=center:toObjectSpace(p.CFrame)
end
center=center*CFrame.Angles(x*d,y*d,z*d)
for p,cf in pairs(origin) do
p.CFrame=center:toWorldSpace(cf)
end

end
end)
archandles.MouseButton1Down:connect(function()
append_distance=0
end)

for i,v in pairs(obj2:GetChildren()) do
if v~=obj6 and v~=obj19 and v~=obj20 then
v.BackgroundColor3=Color3.new(1,204/255,0)
end
end

obj9.BackgroundColor3=Color3.new(102/255,1,51/255)

--NOTE: All of the labels below that say obj7 is the Image and obj8 is the TextButton are wrong.
--The reverse is actually true. I managed to wipe out the need for obj8 (the image), though.
mode=&quot;Mode01&quot;
function onModeClick(modeButton)
	if modeButton~=nil then
		if mode~=modeButton.Name then
			for i,v in pairs(modeButtons) do
				v.BackgroundColor3=Color3.new(1,204/255,0)
			end
			modeButton.BackgroundColor3=Color3.new(102/255,1,51/255)
			mode=modeButton.Name
			if mode==&quot;Mode01&quot; then --Move
				if advsimp==&quot;Simple&quot; then
					obj7.Visible=false
				else
					obj6.Text=rememberPosition.x
					obj19.Text=rememberPosition.y
					obj20.Text=rememberPosition.z
					obj6.BackgroundColor3=Color3.new(1,0,0)
					obj7.Visible=false --InputImage
					obj8.Visible=false --InputButton
					obj6.Visible=true --InputText1
					obj19.Visible=true --InputText2
					obj20.Visible=true --InputText3
					obj24.Visible=false --constant rotate
					obj21.Visible=true --RelativeX
					obj22.Visible=false --RelativeY
					obj23.Visible=false --RelativeZ
					obj5.Text=&quot;Vector: &quot;
					obj30.Visible=false
				end
			elseif mode==&quot;Mode02&quot; then --Rotate
				if advsimp==&quot;Simple&quot; then
					obj7.Visible=false
				else
					obj6.Text=rememberRotate.x
					obj19.Text=rememberRotate.y
					obj20.Text=rememberRotate.z
					obj6.BackgroundColor3=Color3.new(1,0,0)
					obj7.Visible=false --InputImage
					obj8.Visible=false --InputButton
					obj6.Visible=true --InputText1
					obj19.Visible=true --InputText2
					obj20.Visible=true --InputText3
					obj24.Visible=true --constant rotate
					obj21.Visible=false --RelativeX
					obj22.Visible=false --RelativeY
					obj23.Visible=false --RelativeZ
					obj5.Text=&quot;Vector: &quot;
					obj30.Visible=true
				end
			elseif mode==&quot;Mode03&quot; then --Color
				if advsimp==&quot;Simple&quot; then
					obj7.Visible=true
				else
					obj7.Visible=true --InputImage
					obj7.BackgroundColor3=rememberColor.Color
					obj7.Text=rememberColor.Name
					obj8.Visible=false --InputButton
					obj6.Visible=false --InputText1
					obj19.Visible=false --InputText2
					obj20.Visible=false --InputText3
					obj24.Visible=false --constant rotate
					obj21.Visible=false --RelativeX
					obj22.Visible=false --RelativeY
					obj23.Visible=false --RelativeZ
					obj5.Text=&quot;Color: &quot;
					obj30.Visible=false
				end
			elseif mode==&quot;Mode04&quot; then --Size
				if advsimp==&quot;Simple&quot; then
					obj7.Visible=false
				else
					obj6.Text=rememberSize.x
					obj19.Text=rememberSize.y
					obj20.Text=rememberSize.z
					obj6.BackgroundColor3=Color3.new(1,0,0)
					obj7.Visible=false --InputImage
					obj8.Visible=false --InputButton
					obj6.Visible=true --InputText1
					obj19.Visible=true --InputText2
					obj20.Visible=true --InputText3
					obj24.Visible=true --constant rotate
					obj21.Visible=false --RelativeX
					obj22.Visible=false --RelativeY
					obj23.Visible=false --RelativeZ
					obj5.Text=&quot;Vector: &quot;
					obj30.Visible=false
				end
			elseif mode==&quot;Mode05&quot; then --Anchor
				obj7.Text=anchor[rememberAnchor+1]
				obj7.BackgroundColor3=Color3.new(255/255,204/255,0/255)
				obj7.Visible=true --InputImage
				obj8.Visible=false --InputButton
				obj6.Visible=false --InputText1
				obj19.Visible=false --InputText2
				obj20.Visible=false --InputText3
				obj24.Visible=false --constant rotate
				obj21.Visible=false --RelativeX
				obj22.Visible=false --RelativeY
				obj23.Visible=false --RelativeZ
				obj5.Text=&quot;Value: &quot;
				obj30.Visible=false
			elseif mode==&quot;Mode06&quot; then --Lock
				obj7.Text=lock[rememberLock+1]
				obj7.BackgroundColor3=Color3.new(255/255,204/255,0/255)
				obj7.Visible=true --InputImage
				obj8.Visible=false --InputButton
				obj6.Visible=false --InputText1
				obj19.Visible=false --InputText2
				obj20.Visible=false --InputText3
				obj24.Visible=false --constant rotate
				obj21.Visible=false --RelativeX
				obj22.Visible=false --RelativeY
				obj23.Visible=false --RelativeZ
				obj5.Text=&quot;Value: &quot;
				obj30.Visible=false
			elseif mode==&quot;Mode07&quot; then --Material
				obj7.Text=rememberMaterial
				obj7.BackgroundColor3=Color3.new(255/255,204/255,0/255)
				obj7.Visible=true --InputImage
				obj8.Visible=false --InputButton
				obj6.Visible=false --InputText1
				obj19.Visible=false --InputText2
				obj20.Visible=false --InputText3
				obj24.Visible=false --constant rotate
				obj21.Visible=false --RelativeX
				obj22.Visible=false --RelativeY
				obj23.Visible=false --RelativeZ
				obj5.Text=&quot;Material: &quot;
				obj30.Visible=false
			elseif mode==&quot;Mode08&quot; then --Surface
				obj7.Text=rememberSurface
				obj7.BackgroundColor3=Color3.new(255/255,204/255,0/255)
				obj7.Visible=true --InputImage
				obj8.Visible=false --InputButton
				obj6.Visible=false --InputText1
				obj19.Visible=false --InputText2
				obj20.Visible=false --InputText3
				obj24.Visible=false --constant rotate
				obj21.Visible=false --RelativeX
				obj22.Visible=false --RelativeY
				obj23.Visible=false --RelativeZ
				obj5.Text=&quot;Surface: &quot;
				obj30.Visible=false
			elseif mode==&quot;Mode09&quot; then --Transparency
				obj6.BackgroundColor3=Color3.new(255/255,204/255,0)
				obj6.Text=rememberTransparency
				obj7.Visible=false--InputImage
				obj8.Visible=false --InputButton
				obj6.Visible=true --InputText1
				obj19.Visible=false --InputText2
				obj20.Visible=false --InputText3
				obj24.Visible=false --constant rotate
				obj21.Visible=true --RelativeX
				obj22.Visible=true --RelativeY
				obj23.Visible=false --RelativeZ
				obj5.Text=&quot;Value: &quot;
			elseif mode==&quot;Mode10&quot; then --Reflectance
				obj6.BackgroundColor3=Color3.new(102/255,1,51/255)
				obj6.Text=rememberReflectance
				obj7.Visible=false--InputImage
				obj8.Visible=false --InputButton
				obj6.Visible=true --InputText1
				obj19.Visible=false --InputText2
				obj20.Visible=false --InputText3
				obj24.Visible=false --constant rotate
				obj21.Visible=true --RelativeX
				obj22.Visible=true --RelativeY
				obj23.Visible=false --RelativeZ
				obj5.Text=&quot;Value: &quot;
				obj30.Visible=false
			end
		end
	end
end

function GetAllParts(root)
for i,v in pairs(root:GetChildren()) do
if v:IsA(&quot;BasePart&quot;) then
table.insert(parts,v)
end
GetAllParts(v)
end
end

--The two functions below and the math stuff related to it was made by Weaselman50, so if
--you&apos;re snooping around through my scripts, don&apos;t PM me to ask how the following makes sense. :P
function check(rel, slope1, slope2, Axis)
	if rel[Axis]&gt;slope2[Axis]*-rel.z and slope1[Axis]&gt;slope2[Axis] then 
		return rel[Axis]&lt;slope1[Axis]*-rel.z
	elseif slope1[Axis]&lt;slope2[Axis] and rel[Axis]&lt;slope2[Axis]*-rel.z then
		return rel[Axis]&gt;slope1[Axis]*-rel.z
	else
		return false
	end
end
function search()
parts={}
GetAllParts(workspace)
	for i, v in pairs(parts) do
		if hasPermission(v,&quot;Drag&quot;) then
			local rel=(workspace.CurrentCamera.CoordinateFrame:inverse()*CFrame.new(v.Position)).p
			if rel.z&lt;0 and check(rel, slope1, slope2, &quot;x&quot;) and check(rel, slope1, slope2, &quot;y&quot;) then
					Selection.Add(v)
			end
		end
	end
end

playersInGame={}
for i,v in pairs(game.Players:GetChildren()) do table.insert(playersInGame,v.Name) end
game.Players.ChildAdded:connect(function(player) table.insert(playersInGame,player.Name) end)
game.Players.ChildRemoved:connect(function(player) wait(60)
deleted=false
for i=#playersInGame,1,-1 do
if playersInGame[i]==player.Name and not deleted then
table.remove(playersInGame,i)
deleted=true
end
end
end)

function hasPermission(part,action)
--All permissions will be saved in the player whom it pertains to. For example, if blobbyblob allows
--farinhimlich to color his parts, the value &quot;CanColor_blobbyblob&quot; will be saved inside farinhimlich&apos;s
--player object under &quot;BlobbyblobBuildToolStats&quot;.
--[[Actions will be:
Drag: clicking and dragging to move the part around
Save: saving their bricks
Move: using the tool and pressing tab to move a part
And more self-explanatory ones: Color, Size, Rotate, Anchor, Lock, Material, Surface, Transparency
and Reflectance.
]]
if part==nil then return false end
--if action==&quot;Drag&quot; and (not part.Locked or (part.Locked and keys.check(52))) and player.Name==&quot;Player&quot; then return true end
if string.sub(part.Name,1,16)==&quot;BlobbyblobBuild_&quot; then
local owner=string.sub(part.Name,17)
pig=false for i,v in pairs(playersInGame) do if owner==v then pig=true end end
if string.sub(part.Name,1,16)==&quot;BlobbyblobBuild_&quot; and not pig then return true end --player is not in the game, nor has been in the last minute, so their parts are free game
local stats=player:findFirstChild(&quot;BlobbyblobBuildToolStats&quot;)
local permissions=stats:findFirstChild(&quot;Can&quot;..action..&quot;_&quot;..owner)
if ((not part.Locked or (part.Locked and keys.check(52))) and action==&quot;Drag&quot;) or action~=&quot;Drag&quot; then
if permissions then
if permissions.Value then
return true
end
end
end
end
return false
end

function onButton1Down(mouse)
	if obj1:findFirstChild(&quot;ColorPicker&quot;) then
		obj1.ColorPicker:remove()
	end
	if centerPointExpected then
		centerPoint=mouse.Target
		centerPointExpected=false
		obj30.BackgroundColor3=Color3.new(255/255,208/255,0/255)
		SelectionBox.Adornee=nil
		return
	end
	if not mouseDown then
		dontDragPl0x=false
		if mouse.Target~=nil then
			if (string.sub(mouse.Target.Name,1,16)==&quot;BlobbyblobBuild_&quot; or not mouse.Target.Locked) then
				if string.sub(mouse.Target.Name,1,16)==&quot;BlobbyblobBuild_&quot; and obj33.BackgroundColor3==Color3.new(102/255,1,51/255) and (not mouse.Target.Locked or keys.check(52)) then
					if keys.check(48) or keys.check(50) then
						if Selection.Check(mouse.Target) then
							Selection.Remove(mouse.Target)
							dontDragPl0x=true
						else
							Selection.Add(mouse.Target)
						end
					else
						if not Selection.Check(mouse.Target) then
							Selection.Clear()
							Selection.Add(mouse.Target)
						end
					end
				end
				offset=(mouse.Target.CFrame:inverse()*CFrame.new(mouse.Hit.p)).p
				if (mouse.Target~=nil and (not hasPermission(mouse.Target,&quot;Drag&quot;) and mouse.Target.Locked==false and string.sub(mouse.Target.Name,1,16)~=&quot;BlobbyblobBuild_&quot;)) or (hasPermission(mouse.Target,&quot;Drag&quot;) and obj32.BackgroundColor3==Color3.new(102/255,1,51/255) and (not mouse.Target.Locked or keys.check(52))) then
					Selection.Clear()
					p=mouse.Target:clone()
					local targ=mouse.Target.Position+Vector3.new(0,.1,0)
					p.Parent=workspace
					p.Name=&quot;BlobbyblobBuild_&quot;..player.Name
					p.Position=targ
					Selection.Add(p)
					Dragger:MouseDown(p,offset,Selection.Get())
					mouse.Icon=&quot;rbxasset://textures\\GrabRotateCursor.png&quot;
					mouseDown=true
				elseif (mouse.Target~=nil and hasPermission(mouse.Target,&quot;Drag&quot;)) and not dontDragPl0x and Selection.Check(mouse.Target) then
					Dragger:MouseDown(mouse.Target,offset,Selection.Get())
					mouse.Icon=&quot;rbxasset://textures\\GrabRotateCursor.png&quot;
					mouseDown=true
				end
			else
				if not (keys.check(48) or keys.check(50)) then
					Selection.Clear()
					Highlight.Size=UDim2.new()
					Highlight.Visible=true
					Highlight.Position=UDim2.new(0, mouse.X, 0, mouse.Y-20)
					p1=Vector2.new(mouse.X, mouse.Y)
					local rel=(workspace.CurrentCamera.CoordinateFrame:inverse()*CFrame.new(mouse.Hit.p)).p
					slope1=Vector2.new(rel.x/-rel.z, rel.y/-rel.z)
				end
			end
		else
			if not (keys.check(48) or keys.check(50)) then
				Selection.Clear()
				Highlight.Size=UDim2.new()
				Highlight.Visible=true
				Highlight.Position=UDim2.new(0, mouse.X, 0, mouse.Y-20)
				p1=Vector2.new(mouse.X, mouse.Y)
				local rel=(workspace.CurrentCamera.CoordinateFrame:inverse()*CFrame.new(mouse.Hit.p)).p
				slope1=Vector2.new(rel.x/-rel.z, rel.y/-rel.z)
			end
		end
	end
end

function getAABB(parts)
if type(parts)~=&quot;table&quot; then return Vector3.new(0,0,0), Vector3.new(0,0,0) end
if #parts==0 then return Vector3.new(0,0,0), Vector3.new(0,0,0) end
local min=parts[1].Position
local max=parts[1].Position
for i,v in pairs(parts) do
for x=-1,1,2 do
for y=-1,1,2 do
for z=-1,1,2 do
local s=v.Size/2
local p = ((v.CFrame-v.CFrame.p) * CFrame.new(x*s.x, y*s.y, z*s.z)).p + v.Position 
min=Vector3.new(math.min(p.x,min.x),math.min(p.y,min.y),math.min(p.z,min.z))
max=Vector3.new(math.max(p.x,max.x),math.max(p.y,max.y),math.max(p.z,max.z))
end
end
end
end
return min,max
end

function onButton1Up(mouse)
AABB.Parent=nil
if mouseDown then
Dragger:MouseUp()
mouseDown=false
mouse.Icon=&quot;&quot;
end
if Highlight.Visible then
			local rel=(workspace.CurrentCamera.CoordinateFrame:inverse()*CFrame.new(mouse.Hit.p)).p 
			slope2=Vector2.new(rel.x/-rel.z, rel.y/-rel.z) 
			search()
			Highlight.Visible=false
end
refreshData()
refreshHandles()
end

function refreshHandles()
parts={}
for i,v in pairs(Selection.Get()) do
if (hasPermission(v,&quot;Move&quot;) and mode==&quot;Mode01&quot;) or (hasPermission(v,&quot;Rotate&quot;) and mode==&quot;Mode02&quot;) or (hasPermission(v,&quot;Size&quot;) and mode==&quot;Mode04&quot;) then
table.insert(parts,v)
end
end
if mode~=&quot;Mode02&quot; or #parts==0 then archandles.Parent=nil end
if (mode~=&quot;Mode01&quot; and mode~=&quot;Mode04&quot;) or #parts==0 then handles.Parent=nil end
if #Selection.Get()==0 then return end
if mode==&quot;Mode01&quot; then --move
if obj21.Text==&quot;&quot; or #parts&gt;1 then
min,max=getAABB(parts)
AABB.Size=max-min
AABB.CFrame=CFrame.new(min:lerp(max,.5))
AABB.Parent=LocalMsg
axis_mode=&quot;&quot;
handles.Parent=obj1
handles.Adornee=AABB
handles.Color=BrickColor.new(&quot;Bright orange&quot;)
if display_axes then
axis_x.Parent=LocalMsg
axis_x.Mesh.Scale=Vector3.new(.5,2,.5)
axis_x.CFrame=AABB.CFrame*CFrame.Angles(0,0,-math.pi/2)*CFrame.new(0,1+AABB.Size.x/2,0)
axis_y.Parent=LocalMsg
axis_y.Mesh.Scale=Vector3.new(.5,2,.5)
axis_y.CFrame=AABB.CFrame*CFrame.new(0,1+AABB.Size.y/2,0)
axis_z.Parent=LocalMsg
axis_z.Mesh.Scale=Vector3.new(.5,2,.5)
axis_z.CFrame=AABB.CFrame*CFrame.Angles(math.pi/2,0,0)*CFrame.new(0,1+AABB.Size.z/2,0)
end
elseif #parts==1 then
axis_mode=&quot;X&quot;
handles.Parent=obj1
handles.Adornee=parts[1]
handles.Color=BrickColor.new(&quot;Bright orange&quot;)
p=parts[1]
if display_axes then
axis_x.Parent=LocalMsg
axis_x.Mesh.Scale=Vector3.new(.5,2,.5)
axis_x.CFrame=p.CFrame*CFrame.Angles(0,0,-math.pi/2)*CFrame.new(0,1+p.Size.x/2,0)
axis_y.Parent=LocalMsg
axis_y.Mesh.Scale=Vector3.new(.5,2,.5)
axis_y.CFrame=p.CFrame*CFrame.new(0,1+p.Size.y/2,0)
axis_z.Parent=LocalMsg
axis_z.Mesh.Scale=Vector3.new(.5,2,.5)
axis_z.CFrame=p.CFrame*CFrame.Angles(math.pi/2,0,0)*CFrame.new(0,1+p.Size.z/2,0)
end
else
handles.Adornee=nil
axis_x.Parent=nil
axis_y.Parent=nil
axis_z.Parent=nil
end
elseif mode==&quot;Mode02&quot; then
if #parts&gt;1 then
min,max=getAABB(parts)
AABB.Size=max-min
AABB.CFrame=CFrame.new(min:lerp(max,.5))
AABB.Parent=LocalMsg
archandles.Parent=obj1
archandles.Adornee=AABB
if display_axes then
axis_x.Parent=LocalMsg
axis_x.Mesh.Scale=Vector3.new(.5,2,.5)
axis_x.CFrame=AABB.CFrame*CFrame.Angles(0,0,-math.pi/2)*CFrame.new(0,1+AABB.Size.x/2,0)
axis_y.Parent=LocalMsg
axis_y.Mesh.Scale=Vector3.new(.5,2,.5)
axis_y.CFrame=AABB.CFrame*CFrame.new(0,1+AABB.Size.y/2,0)
axis_z.Parent=LocalMsg
axis_z.Mesh.Scale=Vector3.new(.5,2,.5)
axis_z.CFrame=AABB.CFrame*CFrame.Angles(math.pi/2,0,0)*CFrame.new(0,1+AABB.Size.z/2,0)
end
elseif #parts==1 then
archandles.Parent=obj1
archandles.Adornee=parts[1]
p=parts[1]
if display_axes then
axis_x.Parent=LocalMsg
axis_x.Mesh.Scale=Vector3.new(.5,2,.5)
axis_x.CFrame=p.CFrame*CFrame.Angles(0,0,-math.pi/2)*CFrame.new(0,1+p.Size.x/2,0)
axis_y.Parent=LocalMsg
axis_y.Mesh.Scale=Vector3.new(.5,2,.5)
axis_y.CFrame=p.CFrame*CFrame.new(0,1+p.Size.y/2,0)
axis_z.Parent=LocalMsg
axis_z.Mesh.Scale=Vector3.new(.5,2,.5)
axis_z.CFrame=p.CFrame*CFrame.Angles(math.pi/2,0,0)*CFrame.new(0,1+p.Size.z/2,0)
end
else
archandles.Adornee=nil
axis_x.Parent=nil
axis_y.Parent=nil
axis_z.Parent=nil
end
elseif mode==&quot;Mode04&quot; then
if #parts==1 then
handles.Parent=obj1
handles.Adornee=parts[1]
handles.Color=BrickColor.new(&quot;Cyan&quot;)
p=parts[1]
if display_axes then
axis_x.Parent=LocalMsg
axis_x.Mesh.Scale=Vector3.new(.5,2,.5)
axis_x.CFrame=p.CFrame*CFrame.Angles(0,0,-math.pi/2)*CFrame.new(0,1+p.Size.x/2,0)
axis_y.Parent=LocalMsg
axis_y.Mesh.Scale=Vector3.new(.5,2,.5)
axis_y.CFrame=p.CFrame*CFrame.new(0,1+p.Size.y/2,0)
axis_z.Parent=LocalMsg
axis_z.Mesh.Scale=Vector3.new(.5,2,.5)
axis_z.CFrame=p.CFrame*CFrame.Angles(math.pi/2,0,0)*CFrame.new(0,1+p.Size.z/2,0)
end
else
handles.Adornee=nil
end
end
refreshData()
end

shortcuts_active=true
function onKeyDown(key,mouse)
if shortcuts_active then
if key==&quot;q&quot; then
onModeClick(obj9)
elseif key==&quot;e&quot; then
onModeClick(obj11)
elseif key==&quot;z&quot; then
onModeClick(obj10)
end
end
keys.down(string.byte(key))
if keys.check(48) and string.byte(key)==8 then
for i,v in pairs(Selection.Get()) do
if hasPermission(v,&quot;Delete&quot;) then
v:remove()
end
end
Selection.Clear()
end
if keys.check(48) and string.byte(key)==99 then
cloned={}
tallest=0
for i,v in pairs(Selection.Get()) do
if hasPermission(v,&quot;Drag&quot;) then
c=v:clone()
c.Parent=workspace
table.insert(cloned,c)
if v.Size.y&gt;tallest then tallest=v.Size.y end
end
end
Selection.Clear()
for i,v in pairs(cloned) do
v.CFrame=v.CFrame+Vector3.new(0,tallest,0)
Selection.Add(v)
end
end
if string.byte(key)==13 then
setMeshScale()
end
if mouseDown then
if key==&quot;r&quot; then
Dragger:AxisRotate(Enum.Axis.Y)
elseif key==&quot;t&quot; then
Dragger:AxisRotate(Enum.Axis.X)
end
end
if string.byte(key)==9 and (advsimp==&quot;Advanced&quot; or mode==&quot;Mode03&quot;) then
rx=obj21.Text==&quot;X&quot; and 1 or 0
ry=obj21.Text==&quot;X&quot; and 1 or 0
rz=obj21.Text==&quot;X&quot; and 1 or 0
if mode==&quot;Mode01&quot; then
for i,v in pairs(Selection.Get()) do
if hasPermission(v,&quot;Move&quot;) then
v.CFrame=CFrame.new((1-rx)*(tonumber(obj6.Text) or 0),(1-ry)*(tonumber(obj19.Text) or 0),(1-rz)*(tonumber(obj20.Text) or 0))*v.CFrame*CFrame.new(rx*(tonumber(obj6.Text) or 0),ry*(tonumber(obj19.Text) or 0),rz*(tonumber(obj20.Text) or 0))
end
end
elseif mode==&quot;Mode02&quot; then
for i,v in pairs(Selection.Get()) do
if hasPermission(v,&quot;Rotate&quot;) then

if centerPoint then
center=centerPoint.CFrame
SelectionBox.Adornee=centerPoint
Delay(.25,function() SelectionBox.Adornee=nil end)
local origin={}
for i,p in pairs(Selection.Get()) do
origin[p]=center:toObjectSpace(p.CFrame)
end
center=center*CFrame.Angles(math.rad(tonumber(obj6.Text) or 0),math.rad(tonumber(obj19.Text) or 0),math.rad(tonumber(obj20.Text) or 0))
for p,cf in pairs(origin) do
p.CFrame=center:toWorldSpace(cf)
end
else
if obj24.BackgroundColor3==Color3.new(1,204/255,0) then
v.CFrame=v.CFrame*CFrame.Angles(math.rad(tonumber(obj6.Text) or 0),math.rad(tonumber(obj19.Text) or 0),math.rad(tonumber(obj20.Text) or 0))
else
v.CFrame=CFrame.new(v.CFrame.p.x,v.CFrame.p.y,v.CFrame.p.z)*CFrame.Angles(math.rad(tonumber(obj6.Text) or 0),math.rad(tonumber(obj19.Text) or 0),math.rad(tonumber(obj20.Text) or 0))
end
end

end
end
elseif mode==&quot;Mode03&quot; then
for i,v in pairs(Selection.Get()) do
if hasPermission(v,&quot;Color&quot;) then
v.BrickColor=rememberColor
end
end
elseif mode==&quot;Mode04&quot; then
for i,v in pairs(Selection.Get()) do
if hasPermission(v,&quot;Size&quot;) then
c=v.CFrame
v.Size=v.Size+Vector3.new((tonumber(obj6.Text) or 0),(tonumber(obj19.Text) or 0),(tonumber(obj20.Text) or 0))
v.CFrame=c
end
end
elseif mode==&quot;Mode05&quot; then
for i,v in pairs(Selection.Get()) do
if hasPermission(v,&quot;Anchor&quot;) then
if rememberAnchor==0 then
v.Anchored=true
elseif rememberAnchor==1 then
v.Anchored=false
elseif rememberAnchor==2 then
v.Anchored=not v.Anchored
end
end
end
elseif mode==&quot;Mode06&quot; then
for i,v in pairs(Selection.Get()) do
if hasPermission(v,&quot;Lock&quot;) then
if rememberLock==0 then
v.Locked=true
elseif rememberLock==1 then
v.Locked=false
elseif rememberLock==2 then
v.Locked=not v.Locked
end
end
end
elseif mode==&quot;Mode07&quot; then
for i,v in pairs(Selection.Get()) do
if hasPermission(v,&quot;Material&quot;) then
v.Material=Enum.Material[rememberMaterial]
end
end
elseif mode==&quot;Mode08&quot; then
surface=mouse.TargetSurface
if surface==Enum.NormalId.Right then mouse.Target.RightSurface=Enum.SurfaceType[rememberSurface] end
if surface==Enum.NormalId.Left then mouse.Target.LeftSurface=Enum.SurfaceType[rememberSurface] end
if surface==Enum.NormalId.Top then mouse.Target.TopSurface=Enum.SurfaceType[rememberSurface] end
if surface==Enum.NormalId.Bottom then mouse.Target.BottomSurface=Enum.SurfaceType[rememberSurface] end
if surface==Enum.NormalId.Front then mouse.Target.FrontSurface=Enum.SurfaceType[rememberSurface] end
if surface==Enum.NormalId.Back then mouse.Target.BackSurface=Enum.SurfaceType[rememberSurface] end
elseif mode==&quot;Mode09&quot; then --Transparency
for i,v in pairs(Selection.Get()) do
if hasPermission(v,&quot;Transparency&quot;) then
if obj21.Text==&quot;X&quot; then
val=v.Transparency+tonumber(obj6.Text)
else
val=tonumber(obj6.Text)
end
if obj22.Text==&quot;X&quot; then
v.Transparency=math.max(0,math.min(val or 0,1))
else
v.Transparency=val
end
end
end
elseif mode==&quot;Mode10&quot; then --Reflectance
for i,v in pairs(Selection.Get()) do
if hasPermission(v,&quot;Reflectance&quot;) then
if obj21.Text==&quot;X&quot; then
val=v.Reflectance+tonumber(obj6.Text)
else
val=tonumber(obj6.Text)
end
if obj22.Text==&quot;X&quot; then
v.Reflectance=math.max(0,math.min(val or 0,1))
else
v.Reflectance=val
end
end
end
end
end
refreshHandles()
end

function onKeyUp(key,mouse)
keys.up(string.byte(key))
end

function onMove(mouse)
if not mouseDown then
if hasPermission(mouse.Target,&quot;Drag&quot;) and obj33.BackgroundColor3==Color3.new(102/255,1,51/255) then
mouse.Icon=&quot;rbxasset://textures\\DragCursor.png&quot;
elseif (mouse.Target~=nil and (not hasPermission(mouse.Target,&quot;Drag&quot;) and mouse.Target.Locked==false and string.sub(mouse.Target.Name,1,16)~=&quot;BlobbyblobBuild_&quot;)) or (hasPermission(mouse.Target,&quot;Drag&quot;) and obj32.BackgroundColor3==Color3.new(102/255,1,51/255)) then
mouse.Icon=&quot;http://www.roblox.com/asset/?id=25794664&quot;
else
mouse.Icon=&quot;&quot;
end
if mode==&quot;Mode08&quot; then
if hasPermission(mouse.Target,&quot;Surface&quot;) then
SurfaceSelection.Adornee=mouse.Target
SurfaceSelection.TargetSurface=mouse.TargetSurface
SurfaceSelection.Visible=true
else
SurfaceSelection.Visible=false
end
end
else
AABB.Parent=nil
handles.Adornee=nil
archandles.Adornee=nil
axis_x.Parent=nil
axis_y.Parent=nil
axis_z.Parent=nil
Dragger:MouseMove(mouse.UnitRay)
end
if Highlight.Visible then
Highlight.Size=UDim2.new(0, mouse.X-p1.x, 0, mouse.Y-p1.y)
end
if centerPointExpected then
SelectionBox.Adornee=mouse.Target
end
end

function onObj3Down()
if advsimp==&quot;Advanced&quot; then
obj3.Text=&quot;Advanced&quot;
for i=25,-25,-2 do
if i==0 then
ind=0
else
ind=((math.abs(i)^(1/2)*(math.abs(i)/i))+5)/10
end
for i,v in pairs(positions) do
item=obj2:findFirstChild(v[1])
