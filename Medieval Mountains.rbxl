				<Item class="LocalScript" referent="RBX10501">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Local Gui</string>
						<ProtectedString name="Source">local Tool = script.Parent

local swingWithOut = nil
local swingJump = nil
local swordThrust = nil

local humanoid = nil

enabled = true
function onButton1Down(mouse)
	if not enabled then
		return
	end

	enabled = false

	wait()

	if Tool.Lunge.Value == true then
		humanoid.Jump = true
		swingJump:Play()
		wait(0.8)
		Tool.Lunge.Value = false
	else
		local anim = math.random(2,3)
		if anim == 2 then
			swingWithOut:Play()
		else
			swordThrust:Play()
		end
	end

	enabled = true

end

function onEquippedLocal(mouse)

	if mouse == nil then
		print(&quot;Mouse not found&quot;)
		return 
	end

	mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
	mouse.Button1Down:connect(function() onButton1Down(mouse) end)
	
	humanoid = Tool.Parent:FindFirstChild(&quot;Humanoid&quot;)

	swingWithOut = humanoid:LoadAnimation(Tool.twohandswordwithswingout)
	swingJump = humanoid:LoadAnimation(Tool.swordswingjump)
	swordThrust = humanoid:LoadAnimation(Tool.swordthrust)

end

function onUnequippedLocal()

	swingWithOut:remove()
	swingJump:remove()
	swordThrust:remove()

end

Tool.Equipped:connect(onEquippedLocal)
Tool.Unequipped:connect(onUnequippedLocal)
</ProtectedString>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
				<Item class="BoolValue" referent="RBX10502">
					<Properties>
						<string name="Name">Lunge</string>
						<bool name="Value">false</bool>
