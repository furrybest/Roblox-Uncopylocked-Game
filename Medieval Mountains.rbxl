						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">EatScript</string>
						<ProtectedString name="Source">local enabled = true
local transfer = {&quot;Goblet2&quot;,&quot;Cake&quot;,&quot;EpicSauce&quot;}

script.Parent.Selected:connect(function(m)

m.Button1Down:connect(function() if enabled then enabled = false
if m.Target ~= nil then
if m.Target:FindFirstChild(&quot;ServeMDL&quot;) ~= nil or m.Target.Parent.Name == &quot;ServeMDL&quot; then

for i = 1, #transfer do
local Tool = game.Lighting.Tools:FindFirstChild(tostring(transfer[i]))
if Tool ~= nil then
Tool:Clone().Parent = game.Players.LocalPlayer.Backpack end end

script.Parent:Remove()
assert(false, &quot;got fewd&quot;) end end end end) end)
</ProtectedString>
