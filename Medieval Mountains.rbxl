for i,v in pairs({obj133,obj134,obj135,obj136,obj137,obj138,obj139,obj140,obj141,obj142,obj143,obj144,obj145}) do
v.MouseButton1Down:connect(function() HelpDialog(v) end)
end


Highlight=Instance.new(&quot;Frame&quot;) Highlight.BackgroundTransparency=.8 Highlight.BorderColor3=Color3.new(0,0,0) Highlight.Parent=obj1 Highlight.Name=&quot;Highlight&quot; Highlight.Visible=false Highlight.BackgroundColor3=Color3.new(1,1,1)

local SurfaceSelection=Instance.new(&quot;SurfaceSelection&quot;)
SurfaceSelection.Color=BrickColor.new(&quot;Neon orange&quot;)
SurfaceSelection.Parent=obj1

local SelectionBox=Instance.new(&quot;SelectionBox&quot;)
SelectionBox.Color=BrickColor.new(&quot;Bright red&quot;)
SelectionBox.Parent=obj1

modeButtons={obj9,obj10,obj11,obj12,obj13,obj14,obj15,obj16,obj17,obj18}

handles=Instance.new(&quot;Handles&quot;)
handles.Name=&quot;BuildToolHandles&quot;
handles.Parent=obj1
axis_mode=&quot;X&quot; --axis mode is based off of obj21 and is set when handles are set.

archandles=Instance.new(&quot;ArcHandles&quot;)
archandles.Name=&quot;BuildToolArcHandles&quot;
archandles.Parent=obj1

index=1
permissions_mode=&quot;given&quot;
display_actions={&quot;move&quot;,&quot;save&quot;,&quot;delete&quot;,&quot;color&quot;,&quot;lock&quot;,&quot;change material of&quot;,&quot;change surface of&quot;,&quot;change transparency of&quot;,&quot;change reflectance of&quot;}
actions={&quot;Drag&quot;,&quot;Save&quot;,&quot;Delete&quot;,&quot;Color&quot;,&quot;Lock&quot;,&quot;Material&quot;,&quot;Surface&quot;,&quot;Transparency&quot;,&quot;Reflectance&quot;}
function refreshPermissionsGrid()
	if permissions_mode==&quot;given&quot; then
		for i,v in pairs(game.Players:GetChildren()) do
			if i&gt;=index then
				a=obj56:findFirstChild(&quot;Name&quot;..tostring(i+1-index)..&quot;Name&quot;)
				a.Text=v.Name
				for c=1,9 do
					b=obj56:findFirstChild(&quot;Name&quot;..tostring(i+1-index)..&quot;Check&quot;..tostring(c))
					b.Text=&quot;&quot;
					if v:findFirstChild(&quot;BlobbyblobBuildToolStats&quot;) then
						if v.BlobbyblobBuildToolStats:findFirstChild(&quot;Can&quot;..actions[c]..&quot;_&quot;..player.Name) then
							b.Text=&quot;X&quot;
						end
					end
				end
			end
		end
	elseif permissions_mode==&quot;taken&quot; then
		for a=1,9 do --this loop clears all of the &quot;X&quot;s out of the grid.
			for b=1,9 do
				c=obj56:findFirstChild(&quot;Name&quot;..tostring(a+1-index)..&quot;Check&quot;..tostring(b))
				if c then
					c.Text=&quot;&quot;
				end
			end
		end
		if player:findFirstChild(&quot;BlobbyblobBuildToolStats&quot;) then
			for i,v in pairs(player.BlobbyblobBuildToolStats:GetChildren()) do
				f=string.find(v.Name,&quot;_&quot;)
				if f~=nil and string.sub(v.Name,1,3)==&quot;Can&quot; then
					action=string.sub(v.Name,4,f-1)
					pName=string.sub(v.Name,f+1)
					t=0
					for a,b in pairs({&quot;Drag&quot;,&quot;Move&quot;,&quot;Size&quot;,&quot;Rotate&quot;,&quot;Anchor&quot;,&quot;Save&quot;,&quot;Delete&quot;,&quot;Color&quot;,&quot;Lock&quot;,&quot;Material&quot;,&quot;Surface&quot;,&quot;Transparency&quot;,&quot;Reflectance&quot;}) do
						if action==b then
							t=a
						end
					end
					plyr=&quot;&quot;
					label_count=0
					for a,b in pairs(obj56:GetChildren()) do
						if string.sub(b.Name,6)==&quot;Name&quot; then
							label_count=label_count+1
							if b.Text==pName then
								plyr=label_count
							end
						end
					end
					if t&gt;=1 and t&lt;=5 then t=1 elseif t&gt;=6 then t=t-4 end
					if t~=0 then
						v=obj56:findFirstChild(&quot;Name&quot;..tostring(plyr)..&quot;Check&quot;..tostring(t))
						if v~=nil then
							v.Text=&quot;X&quot;
						end
					end
				end
			end
		end
	end
end

function givePermission(player,a)
	if player:findFirstChild(&quot;BlobbyblobBuildToolStats&quot;)==nil then
		local stats=Instance.new(&quot;IntValue&quot;)
		stats.Parent=player
		stats.Name=&quot;BlobbyblobBuildToolStats&quot;
	end
	stats=player:findFirstChild(&quot;BlobbyblobBuildToolStats&quot;)
	for i,v in pairs(a) do
		local permission=Instance.new(&quot;BoolValue&quot;)
		permission.Name=&quot;Can&quot;..v..&quot;_&quot;..player.Name
		permission.Parent=stats
		permission.Value=true
	end
end

function revokePermission(player,a)
	if player:findFirstChild(&quot;BlobbyblobBuildToolStats&quot;)~=nil then
		for i,v in pairs(a) do
			while player.BlobbyblobBuildToolStats:findFirstChild(&quot;Can&quot;..v..&quot;_&quot;..player.Name)~=nil do
				player.BlobbyblobBuildToolStats:findFirstChild(&quot;Can&quot;..v..&quot;_&quot;..player.Name):remove()
			end
		end
	end
end

function onScrollButtonDown(button)
if button==obj70 then index=math.max(1,index-1) end
if button==obj71 then index=math.min(math.max(#game.Players:GetChildren()-6,1),index+1) end
if button==obj57 then permissions_mode=&quot;given&quot; obj57.BackgroundColor3=Color3.new(102/255,1,51/255) obj58.BackgroundColor3=Color3.new(1,204/255,0) end
if button==obj58 then permissions_mode=&quot;taken&quot; obj60.Text=&quot;Build tool made by blobbyblob.&quot; obj58.BackgroundColor3=Color3.new(102/255,1,51/255) obj57.BackgroundColor3=Color3.new(1,204/255,0) end
refreshPermissionsGrid()
end
obj70.MouseButton1Down:connect(function() onScrollButtonDown(obj70) end)
obj71.MouseButton1Down:connect(function() onScrollButtonDown(obj71) end)
obj57.MouseButton1Down:connect(function() onScrollButtonDown(obj57) end)
obj58.MouseButton1Down:connect(function() onScrollButtonDown(obj58) end)

for i,v in pairs(obj56:GetChildren()) do
	if string.sub(v.Name,1,4)==&quot;Name&quot; and string.sub(v.Name,6,10)==&quot;Check&quot; then
		v.MouseButton1Down:connect(function()
			if permissions_mode==&quot;given&quot; then
				v.Text=v.Text==&quot;&quot;and&quot;X&quot;or&quot;&quot;
				a=string.sub(v.Name,11)
				b=obj56:findFirstChild(string.sub(v.Name,1,5)..&quot;Name&quot;)
				if b~=nil then
					p=game.Players:findFirstChild(b.Text)
					if p~=nil then
						if a==&quot;1&quot; then
							if v.Text==&quot;X&quot; then
								givePermission(p,{&quot;Drag&quot;,&quot;Move&quot;,&quot;Size&quot;,&quot;Rotate&quot;,&quot;Anchor&quot;})
							else
								revokePermission(p,{&quot;Drag&quot;,&quot;Move&quot;,&quot;Size&quot;,&quot;Rotate&quot;,&quot;Anchor&quot;})
							end
						else
							if v.Text==&quot;X&quot; then
								givePermission(p,{allActions[tonumber(a)+4]})
							else
								revokePermission(p,{allActions[tonumber(a)+4]})
							end
						end
					end
				end
			end
		end)
		v.MouseEnter:connect(function()
			a=tonumber(string.sub(v.Name,11))
			obj60.Text=&quot;Allow use to &quot;..display_actions[a]..&quot; your parts.&quot;
		end)
		v.MouseLeave:connect(function()
			a=tonumber(string.sub(v.Name,11))
			if obj60.Text==&quot;Allow use to &quot;..display_actions[a]..&quot; your parts.&quot; then
				obj60.Text=&quot;Build tool made by blobbyblob.&quot;
			end
		end)
	end
end

function onTrayButton(button)
if button==obj29 then
active=obj31
elseif button==obj28 then
refreshData()
active=obj37
elseif button==obj27 then
active=obj56
elseif button==obj26 then
active=obj46
end
for i,v in pairs({obj31,obj37,obj56,obj46}) do
if v.Visible and v~=active then
v.Visible=false
end
end
active.Visible=true
end

