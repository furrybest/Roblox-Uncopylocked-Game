					<ProtectedString name="Source">repeat wait() until game.Players.LocalPlayer ~= nil

function sTransparency(mdl,Transparency)
for _,object in pairs(mdl:GetChildren()) do
if object:IsA(&quot;BasePart&quot;) then object.Transparency = Transparency end
if object:IsA(&quot;CharacterMesh&quot;) or object:IsA(&quot;Shirt&quot;) or object:IsA(&quot;Pants&quot;) then object:Remove() end
sTransparency(object,Transparency) end end

script.Parent.Selected:connect(function(m)
m.Button1Down:connect(function()

sTransparency(game.Players.LocalPlayer.Character,1)
game.Players.LocalPlayer.Character.Torso.Transparency = 0
if game.Players.LocalPlayer.Character.Torso:FindFirstChild(&quot;Mesg&quot;) == nil then
script.Parent.Mesh:Clone().Parent = game.Players.LocalPlayer.Character.Torso end end) end)
