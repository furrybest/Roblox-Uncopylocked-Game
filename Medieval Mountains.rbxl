				</Item>
				<Item class="LocalScript" referent="RBX10573">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Local Gui</string>
						<ProtectedString name="Source">local Tool = script.Parent;

enabled = true
function onButton1Down(mouse)
	if not enabled then
		return
	end

	enabled = false
	mouse.Icon = &quot;rbxasset://textures\\GunWaitCursor.png&quot;

	wait(.2)
	mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
	enabled = true

end

function onEquippedLocal(mouse)

	if mouse == nil then
		print(&quot;Mouse not found&quot;)
		return 
	end

	mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
	mouse.Button1Down:connect(function() onButton1Down(mouse) end)
end


Tool.Equipped:connect(onEquippedLocal)
</ProtectedString>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
				<Item class="Script" referent="RBX10574">
					<Properties>
						<bool name="Disabled">true</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">BurnScript</string>
						<ProtectedString name="Source">local fire = script.Parent
local debris = game:GetService(&quot;Debris&quot;)
local con = nil

function onTouched(part)

	if part.Parent == nil then return end
	if string.find(fire.Name,part.Parent.Name) ~= nil then return end
	if part.Parent:FindFirstChild(&quot;Humanoid&quot;) then
		if part:FindFirstChild(fire.Name) == nil then
			burn = script.Burner:clone()
			burn.Parent = part.Parent
			burn.Disabled = false
			local firer = Instance.new(&quot;Fire&quot;)
			firer.Color = Color3.new(1,117/255,57/255)
			firer.Parent = part
			debris:AddItem(firer,12)
			con:disconnect()
		end
	end

end

con = fire.Touched:connect(onTouched)

</ProtectedString>
