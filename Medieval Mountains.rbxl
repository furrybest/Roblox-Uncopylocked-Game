		<Item class="LocalScript" referent="RBX10178">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">_WinterTheme</string>
				<ProtectedString name="Source">repeat wait() until game.Players.LocalPlayer ~= nil

function FadeIn(button)
for i = 1,0,-.1 do wait()
button.TextTransparency = i
button.BackgroundTransparency = i end end

function SnowBall(Player,Value)
if Value then script.SnowBall:Clone().Parent = Player.Backpack
else for _,object in pairs(Player.Backpack:GetChildren()) do
if tostring(object) == &quot;SnowBall&quot; then object:Remove() end end
for _,object in pairs(Player.Character:GetChildren()) do
if tostring(object) == &quot;SnowBall&quot; then object:Remove() end end end end

function slTeleButton()
local vButton = {normal = &quot;http://www.roblox.com/asset?id=42496542&quot;, hover = &quot;http://www.roblox.com/asset?id=42496535&quot;, down = &quot;http://www.roblox.com/asset?id=42496535&quot;}
local sButton = {normal = &quot;http://www.roblox.com/asset?id=42487931&quot;, hover = &quot;http://www.roblox.com/asset?id=42487933&quot;, down = &quot;http://www.roblox.com/asset?id=42487933&quot;}
local inSnow = false

--local CoreGui = game:GetService(&quot;CoreGui&quot;)
local ToolButton = script:FindFirstChild(&quot;ToolButton&quot;)
local TeleButton = ToolButton:Clone()
local initialposition = Vector3.new(99999,99999,99999)

local ScreenGui = Instance.new(&quot;ScreenGui&quot;, game.Players.LocalPlayer.PlayerGui)
ScreenGui.Name = &quot;LolThisIsTheSnowlandGui&quot;
TeleButton.Name = &quot;TeleButton&quot;
ToolButton.Visible = false
TeleButton.Parent = ScreenGui
TeleButton.ToolTip.Text = &quot;Go to Snowland.&quot;
TeleButton.Image = vButton.normal

local posBin = game.Players.LocalPlayer:FindFirstChild(&quot;posBin&quot;)
if posBin == nil then
posBin = Instance.new(&quot;BoolValue&quot;,game.Players.LocalPlayer)
posBin.Name = &quot;posBin&quot;
local SnowlandValue = Instance.new(&quot;Vector3Value&quot;, posBin)
local VillageValue = Instance.new(&quot;Vector3Value&quot;, posBin)
SnowlandValue.Name = &quot;SnowlandValue&quot;
VillageValue.Name = &quot;VillageValue&quot;
SnowlandValue.Value = initialposition
VillageValue.Value = initialposition
local vUsed = Instance.new(&quot;BoolValue&quot;,posBin) vUsed.Name = &quot;vUsed&quot;
local sUsed = Instance.new(&quot;BoolValue&quot;,posBin) sUsed.Name = &quot;sUsed&quot; end

local hideNote = function()
TeleButton.Note.Visible = false
--TeleButton.nT.Visible = false
if posBin:FindFirstChild(&quot;hideNote&quot;) == nil then
Instance.new(&quot;BoolValue&quot;,posBin).Name = &quot;hideNote&quot; end end

TeleButton.Note.Visible = posBin:FindFirstChild(&quot;hideNote&quot;) == nil
--TeleButton.nT.Visible = posBin:FindFirstChild(&quot;hideNote&quot;) == nil

TeleButton.Note.MouseButton1Down:connect(function() hideNote() end)

TeleButton.MouseEnter:connect(function() hideNote()
TeleButton.ToolTip.Visible = true
coroutine.resume(coroutine.create(function() FadeIn(TeleButton.ToolTip) end))
if inSnow then TeleButton.Image = sButton.hover
else TeleButton.Image = vButton.hover end end)

TeleButton.MouseLeave:connect(function()
TeleButton.ToolTip.Visible = false
if inSnow then TeleButton.Image = sButton.normal
else TeleButton.Image = vButton.normal end end)

TeleButton.MouseButton1Down:connect(function()
if inSnow then
inSnow = false --[[posBin.sUsed.Value = true]] TeleButton.Image = vButton.hover SnowBall(game.Players.LocalPlayer,false)
posBin.SnowlandValue.Value = game.Players.LocalPlayer.Character.Torso.CFrame.p
TeleButton.ToolTip.Text = &quot;Go to Snowland.&quot;
if posBin.vUsed.Value then
game.Players.LocalPlayer.Character:MoveTo(posBin.VillageValue.Value)
else game.Players.LocalPlayer.Character:MoveTo(Workspace:FindFirstChild(&quot;_Village&quot;).Position + Vector3.new(0,8,0)) end

else inSnow = true --[[posBin.vUsed.Value = true]] TeleButton.Image = sButton.hover SnowBall(game.Players.LocalPlayer,true)
posBin.VillageValue.Value = game.Players.LocalPlayer.Character.Torso.CFrame.p
TeleButton.ToolTip.Text = &quot;Go to Village.&quot;
if posBin.sUsed.Value then
game.Players.LocalPlayer.Character:MoveTo(posBin.SnowlandValue.Value)
else game.Players.LocalPlayer.Character:MoveTo(Workspace:FindFirstChild(&quot;_Snowland&quot;).Position + Vector3.new(0,8,0)) end end end)
end

--[[function winterGui()
local CoreGui = game:GetService(&quot;CoreGui&quot;)
local RobloxGui = CoreGui:FindFirstChild(&quot;RobloxGui&quot;)
local &quot;http://www.roblox.com/asset?id=&quot; = &quot;http://www.roblox.com/asset?id=&quot;

local BottomLeftControl = &quot;42487898&quot;
local BottomRightControl = &quot;42487912&quot;

RobloxGui.BottomLeftControl.Image = &quot;http://www.roblox.com/asset?id=&quot; .. BottomLeftControl
RobloxGui.BottomRightControl.Image = &quot;http://www.roblox.com/asset?id=&quot; .. BottomRightControl end]]--

if game:FindFirstChild(&quot;NetworkServer&quot;) ~= nil or script:FindFirstChild(&quot;Override&quot;) ~= nil then
slTeleButton() --[[winterGui()]] end
</ProtectedString>
