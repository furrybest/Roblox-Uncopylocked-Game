			<Item class="Script" referent="RBX141">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Boater</string>
					<ProtectedString name="Source">local Boat = script.Parent.Boat
local Backup = {Boat = Boat:Clone()}
local oldPosition = Boat.Base.Position
local bParent = Boat.Parent

function Weld(P0,P1) pcall(function()
	if P0 ~= nil and P1 ~= nil and P0 ~= P1 then
	local W = Instance.new(&quot;Weld&quot;,P0)
	W.Part0 = P0
	W.Part1 = P1
	local CJ = CFrame.new(P0.Position)
	local C0 = P0.CFrame:inverse()*CJ
	local C1 = P1.CFrame:inverse()*CJ
	W.C0 = C0
	W.C1 = C1
	W.Name = &quot;SledWeld&quot;
end end) end

function WeldModel(Model)
for _,object in pairs(Model:GetChildren()) do
if tostring(object):lower() ~= &quot;base&quot; then
Weld(Model.Base,object) end
end end

function Unanchor(Model)
for _,object in pairs(Model:GetChildren()) do
if object:IsA(&quot;BasePart&quot;) then object.Anchored = false end
end end

function regen()
Boat = Backup.Boat:Clone()
Boat.Parent = script.Parent
connectBoat(Boat)
end

function connectBoat(nBoat)

nBoat.Base.pos.position = nBoat.Base.Position
nBoat.Base.gyro.cframe = nBoat.Base.CFrame

nBoat.bSeat.ChildAdded:connect(function(child)
if tostring(child):lower() == &quot;seatweld&quot; then
local player = game.Players:GetPlayerFromCharacter(child.Part1.Parent)
if player ~= nil then
local scr = script.LocalBoat:Clone()
scr.Seat.Value = nBoat.bSeat
scr.CamBrick.Value = nBoat:FindFirstChild(&quot;Cam&quot;)
scr.Disabled = false
scr.Parent = player.Character
nBoat.Parent = scr.Parent
nBoat.ConnectedScript.Value = scr
if nBoat.Base:FindFirstChild(&quot;SledWeld&quot;) == nil then WeldModel(nBoat) end
Unanchor(nBoat)
end end end)

nBoat.bSeat.ChildRemoved:connect(function(child)
if tostring(child):lower() == &quot;seatweld&quot; then
nBoat.ConnectedScript.Value.Kill.Value = true end end)

end

connectBoat(Boat)

while wait(5) do
if Boat.Parent ~= bParent then regen() end end
</ProtectedString>
					<bool name="archivable">true</bool>
				</Properties>
				<Item class="LocalScript" referent="RBX142">
					<Properties>
						<bool name="Disabled">true</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">LocalBoat</string>
						<ProtectedString name="Source">repeat wait() until game.Players.LocalPlayer ~= nil

local CamBrick = script.CamBrick.Value
local Kill = script.Kill
local Seat = script.Seat.Value
local Boat = Seat.Parent
local SeaBrick = Workspace.SeaBrick

Kill.Changed:connect(function(val)
if val then script:Remove() assert(false,&quot;PWN&quot;) end end)

Boat.Base.pos.position = Vector3.new(Boat.Base.Position.x,SeaBrick.Position.y,Boat.Base.Position.z)
Boat.Base.gyro.cframe = Boat.Base.CFrame

while wait() do
Boat.Base.velo.velocity = Boat.Base.CFrame.lookVector * Seat.MaxSpeed * Seat.Throttle
Boat.Base.gyro.cframe = Boat.Base.gyro.cframe * CFrame.Angles(0,(Seat.Steer / 10) * -1,0)
end
</ProtectedString>
