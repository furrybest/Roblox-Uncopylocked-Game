			<Item class="LocalScript" referent="RBX10824">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">BlobbyblobBuild</string>
					<ProtectedString name="Source">function HelpDialog(button)
while obj1:findFirstChild(&quot;HelpDialog&quot;)~=nil do obj1.HelpDialog:remove() end
if button.Name==&quot;Mode01&quot; then
obj200=Instance.new(&quot;Frame&quot;) obj200.BackgroundColor3=Color3.new(255/255,176/255,0/255) obj200.BorderColor3=Color3.new(27/255,42/255,53/255) obj200.Name=&quot;HelpDialog&quot; obj200.Position=UDim2.new(0.5,-100,0.5,-59) obj200.Size=UDim2.new(0,200,0,118)
obj201=Instance.new(&quot;TextLabel&quot;) obj201.Active=false obj201.BackgroundColor3=Color3.new(172/255,174/255,173/255) obj201.BackgroundTransparency=1 obj201.BorderColor3=Color3.new(27/255,42/255,53/255) obj201.Name=&quot;Title&quot; obj201.Parent=obj200 obj201.Position=UDim2.new(0,5,0,5) obj201.Size=UDim2.new(1,-10,0,13) obj201.Text=&quot;Move&quot; obj201.TextColor3=Color3.new(27/255,42/255,53/255) obj201.TextTransparency=1 obj201.TextXAlignment=Enum.TextXAlignment.Left
obj202=Instance.new(&quot;TextLabel&quot;) obj202.Active=false obj202.BackgroundColor3=Color3.new(255/255,176/255,0/255) obj202.BackgroundTransparency=1 obj202.BorderColor3=Color3.new(27/255,42/255,53/255) obj202.Name=&quot;Text&quot; obj202.Parent=obj200 obj202.Position=UDim2.new(0,5,0,23) obj202.Size=UDim2.new(1,-10,0,74) obj202.Text=&quot;The one key thing to remember when moving bricks is that if you have the checkbox under the Help button toggled, the brick will move relative to its own rotation. Otherwise, it will move along the world&apos;s x, y, and z axes.&quot; obj202.TextColor3=Color3.new(27/255,42/255,53/255) obj202.TextTransparency=1 obj202.TextWrap=true obj202.TextXAlignment=Enum.TextXAlignment.Left obj202.TextYAlignment=Enum.TextYAlignment.Top
obj203=Instance.new(&quot;TextButton&quot;) obj203.BackgroundColor3=Color3.new(255/255,176/255,0/255) obj203.BorderColor3=Color3.new(27/255,42/255,53/255) obj203.Name=&quot;Return&quot; obj203.Parent=obj200 obj203.Position=UDim2.new(0,5,0,100) obj203.Size=UDim2.new(1,-10,0,13) obj203.Text=&quot;Close the Window&quot; obj203.TextColor3=Color3.new(27/255,42/255,53/255)
obj203.MouseButton1Down:connect(function() while obj1:findFirstChild(&quot;HelpDialog&quot;)~=nil do obj1.HelpDialog:remove() end end)
obj200.Parent=obj1
elseif button.Name==&quot;Mode02&quot; then
obj200=Instance.new(&quot;Frame&quot;) obj200.BackgroundColor3=Color3.new(255/255,165/255,0/255) obj200.BorderColor3=Color3.new(27/255,42/255,53/255) obj200.Name=&quot;HelpDialog&quot; obj200.Position=UDim2.new(0.5,-100,0.5,-59) obj200.Size=UDim2.new(0,200,0,118)
obj201=Instance.new(&quot;TextLabel&quot;) obj201.Active=false obj201.BackgroundColor3=Color3.new(175/255,174/255,177/255) obj201.BackgroundTransparency=1 obj201.BorderColor3=Color3.new(27/255,42/255,53/255) obj201.Name=&quot;Title&quot; obj201.Parent=obj200 obj201.Position=UDim2.new(0,5,0,5) obj201.Size=UDim2.new(1,-10,0,13) obj201.Text=&quot;Rotate&quot; obj201.TextColor3=Color3.new(27/255,42/255,53/255) obj201.TextXAlignment=Enum.TextXAlignment.Left
obj202=Instance.new(&quot;TextLabel&quot;) obj202.Active=false obj202.BackgroundColor3=Color3.new(255/255,216/255,0/255) obj202.BackgroundTransparency=1 obj202.BorderColor3=Color3.new(27/255,42/255,53/255) obj202.Name=&quot;Text&quot; obj202.Parent=obj200 obj202.Position=UDim2.new(0,5,0,23) obj202.Size=UDim2.new(1,-10,0,74) obj202.Text=&quot;If you wish to rotate all of your bricks around a single point, click the button at the bottom of the Gui that says &apos;Around&apos; and then click the brick that you want to rotate everything around. To clear this, press the &quot;Around&quot; button twice.&quot; obj202.TextColor3=Color3.new(27/255,42/255,53/255) obj202.TextWrap=true obj202.TextXAlignment=Enum.TextXAlignment.Left obj202.TextYAlignment=Enum.TextYAlignment.Top
obj203=Instance.new(&quot;TextButton&quot;) obj203.BackgroundColor3=Color3.new(255/255,217/255,0/255) obj203.BorderColor3=Color3.new(27/255,42/255,53/255) obj203.Name=&quot;Return&quot; obj203.Parent=obj200 obj203.Position=UDim2.new(0,5,0,100) obj203.Size=UDim2.new(1,-10,0,13) obj203.Text=&quot;Close the Window&quot; obj203.TextColor3=Color3.new(27/255,42/255,53/255)
obj203.MouseButton1Down:connect(function() while obj1:findFirstChild(&quot;HelpDialog&quot;)~=nil do obj1.HelpDialog:remove() end end)
obj200.Parent=obj1
elseif button.Name==&quot;Mode03&quot; then
obj200=Instance.new(&quot;Frame&quot;) obj200.BackgroundColor3=Color3.new(255/255,160/255,0/255) obj200.BorderColor3=Color3.new(27/255,42/255,53/255) obj200.Name=&quot;HelpDialog&quot; obj200.Position=UDim2.new(0.5,-100,0.5,-59) obj200.Size=UDim2.new(0,200,0,118)
obj201=Instance.new(&quot;TextLabel&quot;) obj201.Active=false obj201.BackgroundColor3=Color3.new(170/255,169/255,172/255) obj201.BackgroundTransparency=1 obj201.BorderColor3=Color3.new(27/255,42/255,53/255) obj201.Name=&quot;Title&quot; obj201.Parent=obj200 obj201.Position=UDim2.new(0,5,0,5) obj201.Size=UDim2.new(1,-10,0,13) obj201.Text=&quot;Color&quot; obj201.TextColor3=Color3.new(27/255,42/255,53/255) obj201.TextXAlignment=Enum.TextXAlignment.Left
obj202=Instance.new(&quot;TextLabel&quot;) obj202.Active=false obj202.BackgroundColor3=Color3.new(255/255,211/255,0/255) obj202.BackgroundTransparency=1 obj202.BorderColor3=Color3.new(27/255,42/255,53/255) obj202.Name=&quot;Text&quot; obj202.Parent=obj200 obj202.Position=UDim2.new(0,5,0,23) obj202.Size=UDim2.new(1,-10,0,74) obj202.Text=&quot;To color a part, click the button next to the word &apos;Color&apos; and then select the color you want from the palette above. To apply the color, select the parts you wish to color and press Tab.&quot; obj202.TextColor3=Color3.new(27/255,42/255,53/255) obj202.TextWrap=true obj202.TextXAlignment=Enum.TextXAlignment.Left obj202.TextYAlignment=Enum.TextYAlignment.Top
