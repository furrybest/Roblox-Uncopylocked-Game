				<Item class="Script" referent="RBX211">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">(VIP) Door Script</string>
						<ProtectedString name="Source">permission = { &quot;crosboow&quot;,&quot;brinker7&quot;,&quot;12milky&quot;,&quot;buildthomas&quot;,&quot;SethiXzon&quot;,&quot;twannie1995&quot;, }
texture = &quot;http://www.roblox.com/asset/?id=35754445&quot; 
function checkOkToLetIn(name) 
	for i = 1,#permission do 
		if (string.upper(name) == string.upper(permission[i])) then return true end 
	end 
	return false 
end 

local Door = script.Parent

function onTouched(hit) 
		if not hit.Parent then return end
		if not hit.Parent:FindFirstChild(&quot;Torso&quot;) then return end
		if not hit.Parent.Torso:FindFirstChild(&quot;roblox&quot;) then return end
	print(&quot;Door Hit&quot;) 
	local human = hit.Parent:findFirstChild(&quot;Humanoid&quot;) 
	if (human ~= nil and human.className == &quot;Humanoid&quot; and human.Health &gt; 0) then 
		if human.Parent.Torso.roblox.Texture == texture then
			Door.Transparency = 0.4 
			Door.CanCollide = false 
			wait(4)
			Door.CanCollide = true 
			Door.Transparency = 0 
			print(&quot;Human touched door&quot;)  
		elseif (checkOkToLetIn(human.Parent.Name)) then 
			Door.Transparency = 0.4
			Door.CanCollide = false 
			wait(4)
			Door.CanCollide = true 
			Door.Transparency = 0 
		else human.Health = 0 -- Kills if not VIP
		end 
	end 
end 

script.Parent.Touched:connect(onTouched)</ProtectedString>
						<bool name="archivable">true</bool>
					</Properties>
