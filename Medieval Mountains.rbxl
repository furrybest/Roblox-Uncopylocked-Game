						<string name="Name">HorseSpawner</string>
						<ProtectedString name="Source">repeat wait() until game.Players.LocalPlayer ~= nil

local Steer = 0
local Throttle = 0
local MaxSpeed = 25
local logHealth = false
local oldHealth = 0
local newHealth = 0
local updateHealth = 0
local currentHorse = nil
local damage = 0
local st00f = {Model = Instance.new(&quot;Model&quot;)}
local bin = st00f.Model
local gui = script.Guide:Clone()
gui.Parent = bin

local mouseCon = nil
local touchCon = nil

function checkHorse(Character)
local Horse = Character:FindFirstChild(&quot;Horse&quot;)
return Horse ~= nil end

function onHorse(Character)
local SledWeld = Character:FindFirstChild(&quot;SledWeld&quot;)
return SledWeld ~= nil end

function weldOn(Horse,Torso)
local _weld = &quot;Weld&quot;
_weld = Instance.new(_weld, Torso.Parent)

_weld.Name = &quot;SledWeld&quot;
script.onHorse.Value = onHorse(Torso.Parent)

_weld.Part0 = Torso
_weld.Part1 = Horse

_weld.C0 = CFrame.new(Vector3.new(0,-1.3,-.8)) * CFrame.Angles(0,math.rad(-90),0)
end

function spawnHorse(Character)
if not checkHorse(Character) then

local Horse = script.Parent:FindFirstChild(&quot;Horse&quot;)
if Horse ~= nil then Horse = Horse:Clone()
Horse.Parent = Character
Horse.Tool.Value = script.Parent
Horse.Gui.Value = gui

Horse.Kill.Changed:connect(function(Value)
if Value then touchCon:disconnect() mouseCon:disconnect() end end)

Horse.Position = Character.Torso.Position - Vector3.new(-10,0,-10)
Horse.pos.position = Horse.Position

touchCon = Horse.Touched:connect(function(hit)
wait(.1) if hit.Parent ~= nil then
local player = Game.Players:GetPlayerFromCharacter(hit.Parent)
if player ~= nil and Horse.Enabled.Value then

if tostring(player) == tostring(Game.Players.LocalPlayer) then
if player.Character:FindFirstChild(&quot;Torso&quot;) ~= nil then
player.Character.Humanoid.Sit = true
weldOn(Horse,player.Character.Torso) end end end end end)
logHealth = true
end

else print(&quot;repos&quot;) if not script.onHorse.Value then
Character:FindFirstChild(&quot;Horse&quot;).Position = Character.Torso.Position - Vector3.new(-10,0,-10)
Character:FindFirstChild(&quot;Horse&quot;).pos.position = Character:FindFirstChild(&quot;Horse&quot;).Position
print(&quot;repossed&quot;)
end end end

script.Parent.Selected:connect(function() gui.Parent = game.Players.LocalPlayer.PlayerGui
mouseCon = game.Players.LocalPlayer:FindFirstChild(&quot;PlayerMouse&quot;).Button1Down:connect(function()
spawnHorse(game.Players.LocalPlayer.Character) end) end)

script.Parent.Deselected:connect(function() gui.Parent = bin if mouseCon ~= nil then mouseCon:disconnect() mouseCon = nil end end)
</ProtectedString>
