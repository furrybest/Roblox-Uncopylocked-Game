					<Item class="LocalScript" referent="RBX10762">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">HorseController</string>
							<ProtectedString name="Source">repeat wait() until game.Players.LocalPlayer ~= nil
local doJump = true
local heightOfJump = 10
local durationOfJump = 0.5
local jumpReload = .25
local died = false

local Horse = script.Parent
Boat = {Base = Horse} SeaBrick = Horse
Seat = {Steer = 0, Throttle = 0, MaxSpeed = 25}
local PlayerMouse = Game.Players.LocalPlayer:FindFirstChild(&quot;PlayerMouse&quot;)
local mouseConnections = {}
local oldPosition = Vector3.new(0,0,0)

function killHorse()
died = true
Horse.Tool.Value.Active = false
Horse.Tool.Value.HorseSpawner.Disabled = true
Horse.Tool.Value:Remove()
wait()
Horse.Tool:Remove()
Horse.Gui.Value:Remove()
for i = 1, #mouseConnections do
mouseConnections[i]:disconnect() end
mouseConnections = {}
coroutine.resume(coroutine.create(function()
wait(.4)
Horse:Remove()
assert(&quot;HorseScript Pwn&quot;)
end)) end

function activateHorse()
if PlayerMouse ~= nil then
script.Parent.Enabled.Value = false
Horse.Tool.Value.HorseSpawner.onHorse.Value = true
oldPosition = Horse.Position
mouseConnections[#mouseConnections + 1] = PlayerMouse.KeyDown:connect(function(stringKeyStroke)
print(stringKeyStroke)
if stringKeyStroke == &quot;w&quot; then Seat.Throttle = 1
elseif stringKeyStroke == &quot;s&quot; then Seat.Throttle = -1
elseif stringKeyStroke == &quot;a&quot; then Seat.Steer = -1
elseif stringKeyStroke == &quot;d&quot; then Seat.Steer = 1
elseif stringKeyStroke == &quot;e&quot; and doJump then doJump = false
Boat.Base.pos.position = Vector3.new(Boat.Base.Position.x, SeaBrick.Position.y + ((oldPosition.y - Horse.Position.y) - 2) + heightOfJump, Boat.Base.Position.z)
coroutine.resume(coroutine.create(function() wait(durationOfJump)
Boat.Base.pos.position = Vector3.new(Boat.Base.Position.x, SeaBrick.Position.y + ((oldPosition.y - Horse.Position.y) - 2) + ((math.abs(heightOfJump) / 2) * -1), Boat.Base.Position.z)
wait(jumpReload)
doJump = true end))

elseif stringKeyStroke == &quot;q&quot; then stopHorse() end end)

mouseConnections[#mouseConnections + 1] = PlayerMouse.KeyUp:connect(function(stringKeyStroke)
if stringKeyStroke ==&quot;w&quot; then Seat.Throttle = 0
elseif stringKeyStroke == &quot;a&quot; then Seat.Steer = 0
elseif stringKeyStroke == &quot;s&quot; then Seat.Throttle = 0
elseif stringKeyStroke == &quot;d&quot; then Seat.Steer = 0 end end) end end

function stopHorse()
local wld = Horse.Parent:FindFirstChild(&quot;SledWeld&quot;)
if wld ~= nil then wld:Remove() end
local figure = Horse.Parent

for i = 1, #mouseConnections do
mouseConnections[i]:disconnect() end
mouseConnections = {}

Seat.Throttle = 0
Seat.Steer = 0

figure.Humanoid.Sit = false
figure.Humanoid.Jump = true
Horse.Tool.Value.HorseSpawner.onHorse.Value = false
coroutine.resume(coroutine.create(function() wait(1) Horse.Enabled.Value = true end))
end

script.Parent.Tool.Value.HorseSpawner.onHorse.Changed:connect(function(Value)
if Value then activateHorse()
else stopHorse() end end)

Boat.Base.pos.position = Vector3.new(Boat.Base.Position.x,SeaBrick.Position.y,Boat.Base.Position.z)
Boat.Base.gyro.cframe = Boat.Base.CFrame

coroutine.resume(coroutine.create(function() while wait() do
if not died then
Boat.Base.velo.velocity = (Boat.Base.CFrame * CFrame.Angles(0,math.rad(90),0)).lookVector * Seat.MaxSpeed * Seat.Throttle
Boat.Base.gyro.cframe = Boat.Base.gyro.cframe * CFrame.Angles(0,(Seat.Steer / 10) * -1,0)
local veloAdd = 0
veloAdd = game.Players.LocalPlayer.Character.Torso.Velocity.y * .23
if doJump then
if Horse.Parent.Humanoid.Jump then veloAdd = 5 end
if Horse.Tool.Value.HorseSpawner.onHorse.Value == true then
Boat.Base.pos.position = Vector3.new(Boat.Base.Position.x, SeaBrick.Position.y + ((oldPosition.y - Horse.Position.y) - 2) + veloAdd, Boat.Base.Position.z)
else
Boat.Base.pos.position = Vector3.new(Boat.Base.Position.x, SeaBrick.Position.y, Boat.Base.Position.z) end end
if Horse.Tool.Value.HorseSpawner.onHorse.Value == true and Horse.Parent.Humanoid.Sit == false then
Horse.Parent.Humanoid.Sit = true end
oldPosition = Horse.Position
end end end))

wait(.5)
Horse.Kill.Changed:connect(function(Value)
if Value then killHorse() end end)
</ProtectedString>
							<bool name="archivable">true</bool>
						</Properties>
