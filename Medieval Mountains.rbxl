				</Item>
			</Item>
			<Item class="HopperBin" referent="RBX10719">
				<Properties>
					<bool name="Active">false</bool>
					<token name="BinType">0</token>
					<string name="Name">Loot</string>
					<Content name="TextureId"><null></null></Content>
					<bool name="archivable">true</bool>
				</Properties>
				<Item class="LocalScript" referent="RBX10720">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">LootScript</string>
						<ProtectedString name="Source">local idk = {Model = Instance.new(&quot;Model&quot;), stuff = nil}
local bin = idk.Model
local hint = Instance.new(&quot;Hint&quot;,bin)
hint.Name = &quot;LootHint&quot;

function CountLoot(rem)
local cnt = 0
for _,obj in pairs(game.Players.LocalPlayer.Backpack:GetChildren()) do
if obj.Name:lower() == script.Parent.Name:lower() then cnt = cnt + 1
if rem and cnt &gt; 1 and obj ~= script.Parent then obj:Remove() end
if game.Players.LocalPlayer.TeamColor ~= game.Teams.Travelers.TeamColor and obj ~= nil then obj:Remove() end end end
return cnt end

function inZone(part,szone)
local x1 = szone.Position.x - (szone.Size.x / 2)
local x2 = szone.Position.x + (szone.Size.x / 2)

local z1 = szone.Position.z - (szone.Size.z / 2)
local z2 = szone.Position.z + (szone.Size.z / 2)

return part.Position.x &gt; x1 and part.Position.x &lt; x2 and part.Position.z &gt; z1 and part.Position.z &lt; z2

end

function remHints()
for _,obj in pairs(game.Players.LocalPlayer:GetChildren()) do
if obj:IsA(&quot;Hint&quot;) and tostring(obj):lower() == &quot;loothint&quot; and obj ~= hint then
obj:Remove() end end end

function avg(...)
local tab = {...}
local c = 0
for i = 1, #tab do
c = c + tonumber(tab[i]) end
return c / #tab end


function AwardMoney(mVal)
local c1 = math.random (0,1)
local c2 = math.random (0,1)
local c3 = math.random (0,1)
local c4 = math.random (0,1)
local c5 = math.random (0,1)
local add = 0
if avg(c1,c2,c4,c4,c5) &gt;= 1 then
add = math.random (500,2000)
elseif avg(c2,c1,c3,c4) &gt;= 1 then
add = math.random (500,1500)
elseif avg(c1,c2,c3) &gt;= 1 then
add = math.random (500,1000)
else if avg(c1,c2) &gt;= 1 then add = math.random (500,600)
else add = math.random (500,1000) end end

if add == 0 then add = math.random (500,1000) end
mVal.Value = mVal.Value + add
end

script.Parent.Selected:connect(function(m)
CountLoot(true)
remHints()
hint.Parent = game.Players.LocalPlayer

m.Move:connect(function()
if tostring(m.Target):lower() == &quot;chest&quot; and inZone(game.Players.LocalPlayer.Character:FindFirstChild(&quot;Torso&quot;),{Position = m.Target.Position, Size = Vector3.new(20,20,20)}) then
if m.Target:FindFirstChild(&quot;Looted&quot;) == nil then
hint.Text = &quot;Filled chest&quot;
else hint.Text = &quot;Looted chest&quot; end
else hint.Text = &quot;Nothing&quot; end end)

m.Button1Down:connect(function()
if tostring(m.Target):lower() == &quot;chest&quot; and inZone(game.Players.LocalPlayer.Character:FindFirstChild(&quot;Torso&quot;),{Position = m.Target.Position, Size = Vector3.new(20,20,20)}) then
if m.Target:FindFirstChild(&quot;Looted&quot;) == nil then
local Looted = Instance.new(&quot;BoolValue&quot;,m.Target)
Looted.Name = &quot;Looted&quot;
Game:service(&quot;Debris&quot;):AddItem(Looted,600)
local Money = game.Players.LocalPlayer.leaderstats.Money
AwardMoney(Money)
end end end)
end)

script.Parent.Deselected:connect(function()
hint.Parent = bin
remHints() end)
</ProtectedString>
