				<string name="Name">_ServerMain</string>
				<ProtectedString name="Source">--owee als je hier rondkloot...

wait(1)

local ownerName = &quot;twannie1995&quot;
local ownerBadgeID = 38110385
local BadgeService = Game:GetService(&quot;BadgeService&quot;)
local mVals = {[&quot;Wizard/Witch(VIP)&quot;] = 500,
[&quot;King/Queen&quot;] = 300,
[&quot;Prince/Princesss&quot;] = 200,
Knight = 150,
Archer = 150,
Rebels = 75,
Bandits = 75,
Travelers = 35,
Innkeeper = 35,
Farmer = 35,
Villagers = 35,
Priest = 35,
Servant = 35}
vipcon = nil

function _G.ServerMainVer()
local msg = Instance.new(&quot;Message&quot;,game.Workspace)
msg.Text = &quot;1.3.3&quot;
Game:GetService(&quot;Debris&quot;):AddItem(msg) end

function CHRBadge(player)
if BadgeService:UserHasBadge(player.userId,42506242) then
game.Lighting.Tools.ChristmasGhost:Clone().Parent = player.Backpack
game.Lighting.Tools.ChristmasGhost:Clone().Parent = player.StarterGear
game.Lighting.Tools.SnowBall:Clone().Parent = player.Backpack
game.Lighting.Tools.SnowBall:Clone().Parent = player.StarterGear end end

local AllKillers = {&quot;Wizard/Witch(VIP)&quot;,&quot;Rebels&quot;,&quot;Bandits&quot;,&quot;Travelers&quot;}

local Givers = _G.Givers
local BuyButtons = _G.BuyButtons
local MoneyButtons  = _G.MoneyButtons
local VipSpawn = _G.VipSpawn
local BroomGiver = _G.BroomGiver

function WaitForInstance(I,S)
repeat wait() until I ~= nil
S = I
return true
end

function lbadd()
for _,player in pairs(game.Players:GetChildren()) do
if player:FindFirstChild(&quot;leaderstats&quot;) == nil then
local lb = Instance.new(&quot;IntValue&quot;)
local moneh = lb:Clone()

lb.Name = &quot;leaderstats&quot;
moneh.Name = &quot;Money&quot;
moneh.Parent = lb
lb.Parent = player end end end

function AllLocals()
if Givers == nil then Givers = _G.Givers end
if BuyButtons == nil then BuyButtons = _G.BuyButtons end
if MoneyButtons == nil then MoneyButtons = _G.MoneyButtons end
if VipSpawn == nil then VipSpawn = _G.VipSpawn end
if BroomGiver == nil then BroomGiver = _G.BroomGiver end
return Givers ~= nil and BuyButtons ~= nil and MoneyButtons ~= nil and VipSpawn ~= nil and BroomGiver ~= nil
end

repeat wait() until AllLocals()
lbadd()
print(&quot;_ServerMain loaded succesfullly&quot;)

function gtc(n)
return game.Teams:FindFirstChild(n).TeamColor end

function cTeam(p,c)
if p ~= nil then
if p.TeamColor == c then return true else return false end end end

--_Badges
local _Badges = Workspace:FindFirstChild(&quot;_Badges&quot;)
if _Badges ~= nil then
for _,_BadgeAwarder in pairs(_Badges:GetChildren()) do
local Platform = _BadgeAwarder:FindFirstChild(&quot;Platform&quot;)
if Platform ~= nil then
local BadgeID = Platform:FindFirstChild(&quot;BadgeID&quot;)
if BadgeID ~= nil then

local _ev = Platform:FindFirstChild(&quot;Enabled&quot;)
if _ev == nil then
_ev = Instance.new(&quot;BoolValue&quot;,Platform)
_ev.Name = &quot;Enabled&quot;
_ev.Value = true end

Platform.Touched:connect(function(hit)
wait() if hit.Parent ~= nil and Platform.Enabled.Value then Platform.Enabled.Value = false
local Character = hit.Parent
local tPlayer = game.Players:GetPlayerFromCharacter(Character)
if tPlayer ~= nil then
if not BadgeService:UserHasBadge(tPlayer.userId,BadgeID.Value) then
BadgeService:AwardBadge(tPlayer.userId,BadgeID.Value) CHRBadge(tPlayer) end end end wait(2) Platform.Enabled.Value = true end) end end end end

--VipSpawn
VipSpawn.Touched:connect(function(hit)
wait()
if hit.Parent ~= nil then
if hit.Parent:IsA(&quot;Model&quot;) and Game.Players:FindFirstChild(hit.Parent.Name) ~= nil then
local player = Game.Players:GetPlayerFromCharacter(hit.Parent)
if player ~= nil then

local eVal2 = VipSpawn:FindFirstChild(&quot;Enabled&quot;)
if eVal2 == nil then
eVal2 = Instance.new(&quot;BoolValue&quot;)
eVal2.Name = &quot;Enabled&quot;
eVal2.Value = true
eVal2.Parent = VipSpawn end

if VipSpawn.Enabled.Value then VipSpawn.Enabled.Value = false
local Graphic = player.Character:FindFirstChild(&quot;Shirt Graphic&quot;)
if Graphic ~= nil then
if Graphic.Graphic == &quot;http://www.roblox.com/asset/?id=35754445&quot; or Graphic.Graphic == &quot;http://www.roblox.com/asset/?id=000000000&quot; then
player.TeamColor = game.Teams[&quot;Wizard/Witch(VIP)&quot;].TeamColor end end
wait(2) VipSpawn.Enabled.Value = true end
end end end end)

--BroomGiver
BroomGiver.Touched:connect(function(hit)

local eVal2 = BroomGiver:FindFirstChild(&quot;Enabled&quot;)
if eVal2 == nil then
eVal2 = Instance.new(&quot;BoolValue&quot;)
eVal2.Name = &quot;Enabled&quot;
eVal2.Value = true
eVal2.Parent = BroomGiver end

if hit.Parent ~= nil then
if hit.Parent:IsA(&quot;Model&quot;) and Game.Players:FindFirstChild(hit.Parent.Name) ~= nil and BroomGiver.Enabled.Value then BroomGiver.Enabled.Value = false
local player = Game.Players:GetPlayerFromCharacter(hit.Parent)
if player ~= nil then

local Tool = game.Lighting.Tools:FindFirstChild(&quot;Broom&quot;)
local Graphic = player.Character:FindFirstChild(&quot;Shirt Graphic&quot;)
if Graphic ~= nil and Tool ~= nil then
if Graphic.Graphic == &quot;http://www.roblox.com/asset/?id=36185490&quot; or Graphic.Graphic == &quot;http://www.roblox.com/asset/?id=35754445&quot; or Graphic.Graphic == &quot;http://www.roblox.com/asset/?id=000000000&quot; or Graphic.Graphic == &quot;http://www.roblox.com/asset/?id=000000001&quot; then
Tool:Clone().Parent = player.Backpack end end end
end end
wait(2) if not BroomGiver.Enabled.Value then BroomGiver.Enabled.Value = true end
end)

function IsAllKiller(player)
local r = false
for i = 1, #AllKillers do
if tostring(TeamFromColor(player.TeamColor)):lower() == AllKillers[i]:lower() then
r = true end end
return r end


--Keelz
function lKill(killer,player)
local r = false
if IsAllKiller(killer) then r = true end
if not IsAllKiller(killer) and killer.TeamColor ~= player.TeamColor then r = true end
return r end

function TeamFromColor(c)
local r = nil
for _,team in pairs(game.Teams:GetChildren()) do
if team.TeamColor == c then
r = team break end end
return r end

Game.Players.PlayerAdded:connect(function(player)

local awardOwnerBadge = false
for _,nooby in pairs(game.Players:GetPlayers()) do
if tostring(nooby):lower() == tostring(ownerName):lower() then
awardOwnerBadge = true end end
for _,nooby in pairs(game.Players:GetPlayers()) do
if awardOwnerBadge and not BadgeService:UserHasBadge(nooby.userId,ownerBadgeID) then
BadgeService:AwardBadge(nooby.userId,ownerBadgeID) end end

CHRBadge(player)

local lb = Instance.new(&quot;IntValue&quot;)
local Money = lb:Clone()
lb.Name = &quot;leaderstats&quot;
lb.Parent = player

Money.Name = &quot;Money&quot;
Money.Parent = lb

player.CharacterAdded:connect(function(character)

player.Character.ChildAdded:connect(function(child)
if child:IsA(&quot;Tool&quot;) then
for _,obj in pairs(character:GetChildren()) do
if obj:IsA(&quot;ForceField&quot;) then obj:Remove() end end end end)

character.Humanoid.Died:connect(function(somethingIDKwhatitis)
local human = character:FindFirstChild(&quot;Humanoid&quot;)
if human ~= nil then local tag = human:FindFirstChild(&quot;creator&quot;)
if tag ~= nil then
if tag:IsA(&quot;ObjectValue&quot;) then
if tag.Value ~= nil then
local killer = tag.Value

Game:GetService(&quot;Debris&quot;):AddItem((function() local k = Instance.new(&quot;BoolValue&quot;, killer) k.Name = &quot;killer&quot; return k end)(),300)

if lKill(killer,player) then
rMoney(killer,mVals[tostring(TeamFromColor(killer.TeamColor))],1)
else rMoney(killer,10,-1) end

end end end end end) end) end)

--MoneyButtons
for _,MoneyModel in pairs(MoneyButtons:GetChildren()) do
local Button = MoneyModel:FindFirstChild(&quot;Button&quot;)
if Button ~= nil and MoneyModel:IsA(&quot;Model&quot;) then

local eVal2 = Button:FindFirstChild(&quot;Enabled&quot;)
if eVal2 == nil then
eVal2 = Instance.new(&quot;BoolValue&quot;)
eVal2.Name = &quot;Enabled&quot;
eVal2.Value = true
eVal2.Parent = Button end

Button.Touched:connect(function(hit)
if hit.Parent ~= nil then
if hit.Parent:IsA(&quot;Model&quot;) and Game.Players:FindFirstChild(hit.Parent.Name) ~= nil then
local player = Game.Players:GetPlayerFromCharacter(hit.Parent)
if player ~= nil then

local tColor = Button.TeamColor.Value
if player.TeamColor == tColor and Button.Enabled.Value then
Button.Enabled.Value = false
player.leaderstats.Money.Value = player.leaderstats.Money.Value + Button.Add.Value
wait(Button.InterVal.Value) Button.Enabled.Value = true
end end end end end) end end

--BuyButtons
for _,BuyModel in pairs(BuyButtons:GetChildren()) do
if BuyModel:IsA(&quot;Model&quot;) then
local Button = BuyModel:FindFirstChild(&quot;Head&quot;)
if Button ~= nil then
BuyModel.Name = Button.N.Value .. &quot; : &quot; .. Button.Price.Value

local eVal2 = Button:FindFirstChild(&quot;Enabled&quot;)
if eVal2 == nil then
eVal2 = Instance.new(&quot;BoolValue&quot;)
eVal2.Name = &quot;Enabled&quot;
eVal2.Value = true
eVal2.Parent = Button end

Button.Touched:connect(function(hit)
if hit.Parent ~= nil then
if hit.Parent:IsA(&quot;Model&quot;) and Game.Players:FindFirstChild(hit.Parent.Name) ~= nil then
local player = Game.Players:GetPlayerFromCharacter(hit.Parent)
if player ~= nil then

local mVal = player:FindFirstChild(&quot;leaderstats&quot;):FindFirstChild(&quot;Money&quot;)
if Button.Enabled.Value then Button.Enabled.Value = false
if mVal.Value &gt;= 0 and mVal.Value &gt;= Button.Price.Value then

local Backpack = player.Backpack
local Tool = Game.Lighting.Tools:FindFirstChild(Button.Tool.Value)
if Tool ~= nil and Button:FindFirstChild(&quot;TeamColor&quot;) == nil then
Tool:Clone().Parent = Backpack
Tool:Clone().Parent = player.StarterGear
mVal.Value = mVal.Value - Button.Price.Value
else if Tool ~= nil and player.TeamColor == Button.TeamColor.Value then
Tool:Clone().Parent = Backpack
Tool:Clone().Parent = player.StarterGear
mVal.Value = mVal.Value - Button.Price.Value end end

end end
wait(2) Button.Enabled.Value = true
end end end end) end end end

--Givers
for _,mdl in pairs(Givers:GetChildren()) do
if mdl:IsA(&quot;Model&quot;) then
local touch = mdl:FindFirstChild(&quot;Giver&quot;)
if touch ~= nil then

local ToolString = touch:FindFirstChild(&quot;Tool&quot;)
if ToolString.Value ~= &quot;&quot; then

if touch:FindFirstChild(&quot;Enabled&quot;) == nil then eVal = Instance.new(&quot;BoolValue&quot;)
eVal.Name = &quot;Enabled&quot; eVal.Value = true eVal.Parent = touch end

touch.Touched:connect(function(hit)
if hit.Parent ~= nil then
if hit.Parent:IsA(&quot;Model&quot;) and Game.Players:FindFirstChild(hit.Parent.Name) ~= nil then
if Game.Players:GetPlayerFromCharacter(hit.Parent) ~= nil then
if touch.Enabled.Value then touch.Enabled.Value = false


local Backpack = Game.Players:GetPlayerFromCharacter(hit.Parent).Backpack
local Tool = Game.Lighting.Tools:FindFirstChild(ToolString.Value)
if Tool ~= nil and touch:FindFirstChild(&quot;TeamColor&quot;) == nil then Tool:Clone().Parent = Backpack
else if Backpack.Parent.TeamColor == touch:FindFirstChild(&quot;TeamColor&quot;).Value and Tool ~= nil then Tool:Clone().Parent = Backpack end end

wait(2)
touch.Enabled.Value = true end end end end end) end end end end

--Chest/Table fixzorz
for _,Chest in pairs(Game.Workspace.Chests:GetChildren()) do
if Chest:IsA(&quot;BasePart&quot;) then
Chest.ChildAdded:connect(function(child)
if tostring(child):lower() == &quot;looted&quot; then Game:GetService(&quot;Debris&quot;):AddItem(child,600) end end) end end

for _,TavernTable in pairs(Workspace.TavernTables:GetChildren()) do
local srv = TavernTable:FindFirstChild(&quot;Serve&quot;)
if TavernTable:IsA(&quot;Model&quot;) and srv ~= nil then
srv.ChildAdded:connect(function(child)
if tostring(child):lower() == &quot;servemdl&quot; then
Game:GetService(&quot;Debris&quot;):AddItem(child,60) end end) end end

--Church Rope
Workspace.ChurchRope.Touched:connect(function(hit)

if Workspace.ChurchRope:FindFirstChild(&quot;Enabled&quot;) == nil then
local eVal = Instance.new(&quot;BoolValue&quot;,Workspace.ChurchRope)
eVal.Name = &quot;Enabled&quot; eVal.Value = true end

wait(.2) if hit.Parent ~= nil then
if hit.Parent:IsA(&quot;Model&quot;) and game.Players:FindFirstChild(tostring(hit.Parent)) ~= nil then
local tPlayer = game.Players:GetPlayerFromCharacter(hit.Parent)
if tPlayer ~= nil then

if tPlayer.TeamColor == game.Teams.Priest.TeamColor then
if Workspace.ChurchRope.Enabled.Value then Workspace.ChurchRope.Enabled.Value = false
rMoney(tPlayer,5,2) wait(5) Workspace.ChurchRope.Enabled.Value = true end end end end end end)

--Random stuff
function rMoney(player,amount,m)
player.leaderstats.Money.Value = player.leaderstats.Money.Value + (amount * m)
end

coroutine.resume(coroutine.create(function()
while wait(2) do
for _,player in pairs(game.Players:GetPlayers()) do
if player.TeamColor == Game.Teams.Servant.TeamColor then
local m = player.leaderstats.Money
m.Value = m.Value + 1 end end end end))

coroutine.resume(coroutine.create(function()
while wait() do
for _,player in pairs(game.Players:GetPlayers()) do
local BodyParts = {&quot;Head&quot;, &quot;Left Arm&quot;, &quot;Left Leg&quot;, &quot;Right Arm&quot;, &quot;Right Leg&quot;, &quot;Torso&quot;}
local BodyColors = {&quot;HeadColor&quot;, &quot;LeftArmColor&quot;, &quot;LeftLegColor&quot;, &quot;RightArmColor&quot;, &quot;RightLegColor&quot;, &quot;TorsoColor&quot;}
if player.Character ~= nil then
local BodyColorz = player.Character:FindFirstChild(&quot;Body Colors&quot;)
if BodyColorz ~= nil then

for key,Color in pairs(BodyParts) do
local Part = player.Character:FindFirstChild(Color)
if Part ~= nil then
if Part.BrickColor ~= BodyColorz[BodyColors[key]] then
Part.BrickColor = BodyColorz[BodyColors[key]] end end end end end end end end))
</ProtectedString>
