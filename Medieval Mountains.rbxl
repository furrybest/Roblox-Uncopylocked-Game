							<ProtectedString name="Source">local AddVal = script.Parent.Bar.Size.X.Scale / 60
local oldWalkSpeed = game.Players.LocalPlayer.Character.Humanoid.WalkSpeed
script.Parent.Bar.Size = UDim2.new(0,0,script.Parent.Bar.Size.Y.Scale,0)

game.Players.LocalPlayer.Character.Humanoid.WalkSpeed = 0
for i = 0, 60 do
wait(1)
script.Parent.Bar.Size = UDim2.new(i * AddVal,0,script.Parent.Bar.Size.Y.Scale,0) end

script.Parent.Door.Value.CanCollide = false
script.Parent.Door.Value.Transparency = 1
game.Players.LocalPlayer.Character.Humanoid.WalkSpeed = oldWalkSpeed
script.Parent.BG:Remove()
script.Parent.Bar:Remove()
wait(3)
script.Parent.Door.Value.CanCollide = true
script.Parent.Door.Value.Transparency = 0

script.Parent:Remove()
assert(false,&quot;Door Opened&quot;)
