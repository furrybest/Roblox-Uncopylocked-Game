				<Item class="LocalScript" referent="RBX10715">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">TreasureCompass</string>
						<ProtectedString name="Source">local enabled = true
local reload = 2

function CreateArrow(pointAt)
debris = game:GetService(&quot;Debris&quot;)
local Torso = game.Players.LocalPlayer.Character:FindFirstChild(&quot;Torso&quot;)
if Torso ~= nil then

local p = Instance.new(&quot;Part&quot;,game.Workspace)
p.formFactor = 2
p.Anchored = true
p.Size = Vector3.new(1,.4,1)
p.Transparency = .5
p.BrickColor = BrickColor.new(21)
p.CanCollide = false
p.Locked = true
local lookVector = Torso.CFrame.lookVector
local denom = math.abs(lookVector.x) + math.abs(lookVector.z)
local posX = (5 * (lookVector.x/denom)) + Torso.CFrame.p.x
local posZ = (5 * (lookVector.z/denom)) + Torso.CFrame.p.z

p.CFrame = CFrame.new(Vector3.new(posX,Torso.CFrame.p.y,posZ))
p.CFrame = CFrame.new(p.CFrame.p,pointAt)

local m = script.ArrowMesh:Clone()
m.Parent = p
debris:AddItem(p,5) end end

script.Parent.Equipped:connect(function(m)

m.Button1Down:connect(function()if enabled then enabled = false
script.Parent.Handle.OpenSound:Play()

local ClosestChest = nil
local cMagnitude = 20e+1000

for _,chest in pairs(Workspace.Chests:GetChildren()) do
if chest.Name == &quot;Chest&quot; and chest:FindFirstChild(&quot;Looted&quot;) == nil then
local Torso = game.Players.LocalPlayer.Character:FindFirstChild(&quot;Torso&quot;)
if Torso ~= nil then
local magnitude = math.abs((Torso.Position - chest.Position).magnitude)
if magnitude &lt; cMagnitude then
cMagnitude = magnitude ClosestChest = chest end end end end

if ClosestChest ~= nil then
CreateArrow(ClosestChest.Position) end
wait(reload) enabled = true end end) end)
</ProtectedString>
