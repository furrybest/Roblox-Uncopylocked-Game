				<Item class="LocalScript" referent="RBX10707">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">IceBarrage</string>
						<ProtectedString name="Source">local deb = true
local burnSound = Instance.new(&quot;Sound&quot;,script.Parent.Handle)
burnSound.SoundId = &quot;http://www.roblox.com/asset/?id=32788904&quot;
burnSound.archivable = false

function FireAt(pos)
local Missile = Instance.new(&quot;Part&quot;)
local BodyPosition = Instance.new(&quot;BodyPosition&quot;,Missile)
Instance.new(&quot;Sparkles&quot;,Missile).Name = &quot;Ooooh :o&quot;

BodyPosition.position = pos

Missile.Size = Vector3.new(2,2,2)
Missile.Material = Enum.Material.Ice
Missile.BrickColor = BrickColor.new(&quot;Medium blue&quot;)
Missile.Parent = game.Workspace
Missile.Shape = 0
Missile.TopSurface = &quot;Smooth&quot;
Missile.BottomSurface = &quot;Smooth&quot;

local lookVector = game.Players.LocalPlayer.Character.Torso.CFrame.lookVector
local denom = math.abs(lookVector.x) + math.abs(lookVector.z)
local posX = (2 * (lookVector.x/denom)) + game.Players.LocalPlayer.Character.Torso.CFrame.p.x
local posZ = (2 * (lookVector.z/denom)) + game.Players.LocalPlayer.Character.Torso.CFrame.p.z

Missile.Position = Vector3.new(posX,game.Players.LocalPlayer.Character.Torso.CFrame.p.y,posZ)

Missile.Touched:connect(function(hit) if Missile ~= nil then
if hit.Parent:FindFirstChild(&quot;Humanoid&quot;) ~= nil then
if hit.Parent ~= script.Parent.Parent then
Missile:Remove()
Missile = nil
local Ice = Instance.new(&quot;Part&quot;)
Ice.TopSurface = &quot;Smooth&quot;
Ice.BottomSurface = &quot;Smooth&quot;
Ice.BrickColor = BrickColor.new(&quot;Medium blue&quot;)
Ice.Size = Vector3.new(5,8,5)
Ice.Transparency = .5
Ice.Reflectance = .3
Ice.Anchored = true
Ice.Position = hit.Parent:FindFirstChild(&quot;Torso&quot;).Position
Ice.Parent = game.Workspace

local shieldSound = Instance.new(&quot;Sound&quot;,Ice)
shieldSound.SoundId = &quot;http://www.roblox.com/asset/?id=32788850&quot;
shieldSound:Play()
hit.Parent:FindFirstChild(&quot;Humanoid&quot;):TakeDamage(50)
local tag = Instance.new(&quot;ObjectValue&quot;,hit.Parent:FindFirstChild(&quot;Humanoid&quot;))
tag.Name = &quot;creator&quot;
tag.Value = game.Players.LocalPlayer
Game:GetService(&quot;Debris&quot;):AddItem(tag,1)

local wld = Instance.new(&quot;Weld&quot;,Ice)
wld.Part0 = hit.Parent:FindFirstChild(&quot;Torso&quot;)
wld.Part1 = Ice

Game:GetService(&quot;Debris&quot;):AddItem(Ice,4) end end end end)
Game:GetService(&quot;Debris&quot;):AddItem(Missile,2) end

script.Parent.Equipped:connect(function(m)
m.Icon = &quot;http://www.roblox.com/asset/?id=36092804&quot;

m.Button1Down:connect(function()
if deb then deb = false
m.Icon = &quot;http://www.roblox.com/asset/?id=36092804&quot;
if m.Target == nil then
FireAt(m.Hit.p)
elseif m.Target ~= nil then
if m.Target.Parent:IsA(&quot;Model&quot;) or m.Target.Parent:IsA(&quot;Hat&quot;) then
if m.Target.Parent:FindFirstChild(&quot;Humanoid&quot;) ~= nil and m.Target:FindFirstChild(&quot;Torso&quot;) ~= nil or m.Target.Parent:IsA(&quot;Hat&quot;) then FireAt(m.Target.Position)
else FireAt(m.Hit.p)
end end end
burnSound:Play()
wait()
m.Icon = &quot;http://www.roblox.com/asset/?id=36092813&quot;
wait(2) deb = true
m.Icon = &quot;http://www.roblox.com/asset/?id=36092804&quot;
end end)

end)
</ProtectedString>
