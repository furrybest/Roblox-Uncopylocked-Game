				<CoordinateFrame name="Grip">
					<X>0.200000003</X>
					<Y>-1</Y>
					<Z>-1.5</Z>
					<R00>1</R00>
					<R01>0</R01>
					<R02>0</R02>
					<R10>0</R10>
					<R11>1</R11>
					<R12>0</R12>
					<R20>0</R20>
					<R21>0</R21>
					<R22>1</R22>
				</CoordinateFrame>
				<string name="Name">ChristmasGhost</string>
