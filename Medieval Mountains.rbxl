					<string name="Name">FriendlyGhost</string>
					<ProtectedString name="Source">repeat wait() until game.Players.LocalPlayer ~= nil

local _Transparent = false
local __T = .5
local enabled = game.Players.LocalPlayer:FindFirstChild(&quot;killer&quot;) == nil
local Selected = false

function sTransparency(mdl,Transparency)
for _,object in pairs(mdl:GetChildren()) do
if object:IsA(&quot;BasePart&quot;) then object.Transparency = Transparency end

if mdl:FindFirstChild(&quot;Humanoid&quot;) ~= nil then
if Transparency &gt; 0 then
mdl.Humanoid.MaxHealth = 99999 wait()
mdl.Humanoid.Health = 99999
else mdl.Humanoid.MaxHealth = 100 wait()
mdl.Humanoid.Health = 100 end end

sTransparency(object,Transparency) end end

function _Set()
if enabled then
if _Transparent then _Transparent = false
sTransparency(game.Players.LocalPlayer.Character,0)
else _Transparent = true
sTransparency(game.Players.LocalPlayer.Character,__T) end end end

game.Players.LocalPlayer.ChildAdded:connect(function(child)
if tostring(child):lower() == &quot;killer&quot; then enabled = false
sTransparency(game.Players.LocalPlayer.Character,0) end end)

game.Players.LocalPlayer.ChildRemoved:connect(function(child)
if tostring(child):lower() == &quot;killer&quot; then enabled = true end end)

script.Parent.Equipped:connect(function(m) Selected = true
m.Button1Down:connect(function()
_Set() end) end)

script.Parent.Unequipped:connect(function() sTransparency(game.Players.LocalPlayer.Character,0) Selected = false end)
</ProtectedString>
