						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">ServeTool</string>
						<ProtectedString name="Source">local reload = 5
local enabled = true

function CountServe(rem)
local cnt = 0
for _,obj in pairs(game.Players.LocalPlayer.Backpack:GetChildren()) do
if obj.Name:lower() == script.Parent.Name:lower() then cnt = cnt + 1
if rem and cnt &gt; 1 and obj ~= script.Parent then obj:Remove() end
if game.Players.LocalPlayer.TeamColor ~= game.Teams.Innkeeper.TeamColor and obj ~= nil then obj:Remove() end end end
return cnt end

script.Parent.Selected:connect(function(m)
CountServe(true)

m.Button1Down:connect(function() if enabled then enabled = false
if m.Target ~= nil and game.Players.LocalPlayer.TeamColor == game.Teams.Innkeeper.TeamColor then
if m.Target.Name:lower() == &quot;serve&quot; and m.Target:FindFirstChild(&quot;ServeMDL&quot;) == nil then

local ServeMDL = game.Lighting.Models:FindFirstChild(&quot;ServeMDL&quot;)
if ServeMDL ~= nil then
ServeMDL = ServeMDL:Clone()
ServeMDL.Parent = m.Target

ServeMDL.Base.CFrame = m.Target.CFrame

for _,object in pairs(ServeMDL:GetChildren()) do
if object:FindFirstChild(&quot;Offset&quot;) ~= nil and object:IsA(&quot;BasePart&quot;) then
object.CFrame = ServeMDL.Base.CFrame + object.Offset.Value end 
if object.Name == &quot;Goblet&quot; then
object.CFrame = object.CFrame + Vector3.new(0,-.1,0) end end

Game:service(&quot;Debris&quot;):AddItem(ServeMDL,60)

local Money = game.Players.LocalPlayer.leaderstats.Money
Money.Value = Money.Value + 20

end end end end
wait(tonumber(reload)) enabled = true end) end)
</ProtectedString>
