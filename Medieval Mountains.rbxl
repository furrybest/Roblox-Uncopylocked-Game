						<string name="Name">BakeToolScript</string>
						<ProtectedString name="Source">repeat wait() until game.Players.LocalPlayer ~= nil

local BakingPie = script:FindFirstChild(&quot;BakingPie&quot;)
local TimeLeft = nil
local BakeTime = 40
local Pies = game.Players.LocalPlayer.Backpack:FindFirstChild(&quot;Pies&quot;)
local BakeGui = game.Players.LocalPlayer.PlayerGui:FindFirstChild(&quot;BakeGui&quot;)
local PieCount = nil
local ProgressBar = script.ProgressBar:Clone()
local AddValue = ProgressBar.Bar.Size.X.Scale / BakeTime
local idk = {Model = Instance.new(&quot;Model&quot;)}
local bin = idk.Model

function CountBakepie(rem)
local cnt = 0
for _,obj in pairs(game.Players.LocalPlayer.Backpack:GetChildren()) do
if obj.Name:lower() == script.Parent.Name:lower() then cnt = cnt + 1
if rem and cnt &gt; 1 and obj ~= script.Parent then obj:Remove() end
if game.Players.LocalPlayer.TeamColor ~= game.Teams.Servant.TeamColor and obj ~= nil then obj:Remove() end end end
return cnt end

function ini()
if BakingPie == nil then BakingPie = Instance.new(&quot;BoolValue&quot;,script)
BakingPie.Name = &quot;BakingPie&quot; end
if TimeLeft == nil then TimeLeft = Instance.new(&quot;NumberValue&quot;,BakingPie)
TimeLeft.Name = &quot;TimeLeft&quot; end
if Pies == nil then Pies = Instance.new(&quot;NumberValue&quot;,game.Players.LocalPlayer.Backpack)
Pies.Name = &quot;Pies&quot; end
if BakeGui == nil then BakeGui = script.BakeGui:Clone()
BakeGui.Parent = game.Players.LocalPlayer.PlayerGui
PieCount = BakeGui:FindFirstChild(&quot;PieCount&quot;) end
if PieCount ~= nil then PieCount.Text = tostring(Pies.Value)
else
BakeGui.Parent = game.Players.LocalPlayer.PlayerGui
PieCount = BakeGui:FindFirstChild(&quot;PieCount&quot;)
PieCount.Text = tostring(Pies.Value) end
end
ini()

function Deselect()
BakeGui.Parent = bin
for _,gui in pairs(game.Players.LocalPlayer.PlayerGui:GetChildren()) do
if tostring(gui):lower() == tostring(BakeGui):lower() then gui:Remove() end end
end

function Select()
BakeGui.Parent = game.Players.LocalPlayer.PlayerGui
end

Deselect()

script.Parent.Selected:connect(function(m) CountBakepie(true)
Select()

m.Button1Down:connect(function()

if m.Target ~= nil then
if tostring(m.Target.Parent):lower() == &quot;range&quot; and not BakingPie.Value and game.Players.LocalPlayer.Backpack:FindFirstChild(&quot;BP&quot;) == nil then
BakingPie.Value = true
coroutine.resume(coroutine.create(function()
local blk = Instance.new(&quot;BoolValue&quot;,game.Players.LocalPlayer.Backpack)
blk.Name = &quot;BP&quot;

local PieProgress = ProgressBar:Clone()
PieProgress.Parent = BakeGui
PieProgress.Bar.Size = UDim2.new(0,0,PieProgress.Bar.Size.Y.Scale,0)
for i = 0,BakeTime do TimeLeft.Value = i
PieProgress.Bar.Size = UDim2.new(i * AddValue,0,PieProgress.Bar.Size.Y.Scale,0) wait(1) end

Pies.Value = Pies.Value + 1
local ls = game.Players.LocalPlayer.leaderstats
ls.Money.Value = ls.Money.Value + 80
BakingPie.Value = false blk:Remove()
PieProgress:Remove() end)) end

if tostring(m.Target):lower() == &quot;plate&quot; then
if Pies.Value &gt;= 1 and m.Target:FindFirstChild(&quot;pBrick&quot;) == nil then
Pies.Value = Pies.Value - 1
local pBrick = script.pBrick:Clone()
pBrick.Parent = m.Target
pBrick.CFrame = CFrame.new(m.Target.CFrame.p + Vector3.new(0,pBrick.Size.z * 2)) * CFrame.Angles(math.rad(90),0,0)
Game:GetService(&quot;Debris&quot;):AddItem(pBrick,60)

local ls = game.Players.LocalPlayer.leaderstats
ls.Money.Value = ls.Money.Value + 40 end end end end) end)

script.Parent.Deselected:connect(function() Deselect() end)

Pies.Changed:connect(function(val)
PieCount.Text = tostring(val) end)
</ProtectedString>
