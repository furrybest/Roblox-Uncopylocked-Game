						<string name="Name">HealthController</string>
						<ProtectedString name="Source">local Humanoid = script.Parent.Parent.Humanoid
local updateHealth = 0
local damage = 0
local Horse = script.Parent
local currentHorse = Horse
local oldHealth = 0
local addHealth = 100

oldHealth = Humanoid.Health
local cHealth = Humanoid.Health + addHealth
local cMaxHealth = Humanoid.MaxHealth + addHealth
Humanoid.MaxHealth = cMaxHealth
wait() Humanoid.Health = cHealth
newHealth = cHealth
updateHealth = newHealth

Humanoid.HealthChanged:connect(function(Value)
if Value &lt;= updateHealth then
local DeltaHealth = updateHealth - Value
damage = damage + DeltaHealth
DeltaHealth = math.abs(DeltaHealth)
damage = math.abs(damage)
if damage &gt;= addHealth then

Humanoid.MaxHealth = newHealth - addHealth
if Humanoid.Health &gt; Humanoid.MaxHealth
then Humanoid.Health = Humanoid.MaxHealth end

local SledWeld = Humanoid.Parent:FindFirstChild(&quot;SledWeld&quot;)
if SledWeld ~= nil then SledWeld:Remove() end
Humanoid.Jump = true
currentHorse.Kill.Value = true end end

updateHealth = Value end)
