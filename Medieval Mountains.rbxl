		<Item class="Script" referent="RBX234">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">SnapRemover</string>
				<ProtectedString name="Source">function Scan(input)
for _,output in pairs(input:GetChildren()) do
if output:IsA(&quot;JointInstance&quot;) and tostring(output):lower() ~= &quot;seatweld&quot; and tostring(output):lower() ~= &quot;sledweld&quot; then output:Remove()
else
if output:IsA(&quot;Model&quot;) or not output:IsA(&quot;Model&quot;) then
if Game.Players:FindFirstChild(tostring(output)) == nil then Scan(output) end end end
wait() end end

Scan(game.Workspace)
while wait(300) do
Scan(game.Workspace)
end</ProtectedString>
				<bool name="archivable">true</bool>
			</Properties>
		</Item>
