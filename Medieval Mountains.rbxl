					<Item class="ObjectValue" referent="RBX1911">
						<Properties>
							<string name="Name">Seated</string>
							<Ref name="Value">null</Ref>
							<bool name="archivable">true</bool>
						</Properties>
					</Item>
					<Item class="ObjectValue" referent="RBX1912">
						<Properties>
							<string name="Name">LastTool</string>
							<Ref name="Value">null</Ref>
							<bool name="archivable">true</bool>
						</Properties>
