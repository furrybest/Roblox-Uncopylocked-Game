				<Item class="LocalScript" referent="RBX10722">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">TransformTool</string>
						<ProtectedString name="Source">local wBin = Instance.new(&quot;Model&quot;,Workspace)
wBin.Name = &quot;wBin: &quot; .. tostring(game.Players.LocalPlayer)

function ScanModel(Model,sMode)
for _,object in pairs(Model:GetChildren()) do
if sMode:lower() == &quot;visible&quot; and object:IsA(&quot;BasePart&quot;) then
object.Transparency = 0
elseif sMode:lower() == &quot;invisible&quot; and object:IsA(&quot;BasePart&quot;) then
object.Transparency = 1
elseif sMode:lower() == &quot;goldcopy&quot; and object:IsA(&quot;BasePart&quot;) then
local copy = object:Clone()
copy.Anchored = false
copy.CanCollide = false
copy.Reflectance = .5
copy.BrickColor = BrickColor.new(1,1,0)
copy.Parent = wBin
Weld(copy,object)
elseif sMode:lower() == &quot;freeze&quot; and object:IsA(&quot;BasePart&quot;) then
object.Anchored = true
elseif sMode:lower() == &quot;thaw&quot; and object:IsA(&quot;BasePart&quot;) then
object.Anchored = false end
ScanModel(object,sMode) end end

function Weld(x,y)
local wld = Instance.new(&quot;Weld&quot;,x)
wld.Part0 = x
wld.Part1 = y end

function CountBless(rem)
local cnt = 0
for _,obj in pairs(game.Players.LocalPlayer.Backpack:GetChildren()) do
if obj.Name:lower() == script.Parent.Name:lower() then cnt = cnt + 1
if rem and cnt &gt; 1 and obj ~= script.Parent then obj:Remove() end
if game.Players.LocalPlayer.TeamColor ~= game.Teams[&quot;Wizard/Witch(VIP)&quot;].TeamColor and obj ~= nil then obj:Remove() end end end
return cnt end

function inZone(part,szone)
local x1 = szone.Position.x - (szone.Size.x / 2)
local x2 = szone.Position.x + (szone.Size.x / 2)

local z1 = szone.Position.z - (szone.Size.z / 2)
local z2 = szone.Position.z + (szone.Size.z / 2)

return part.Position.x &gt; x1 and part.Position.x &lt; x2 and part.Position.z &gt; z1 and part.Position.z &lt; z2

end

script.Parent.Selected:connect(function(m)
CountBless(true)

m.Button1Down:connect(function()
if m.Target ~= nil then
if m.Target.Parent:IsA(&quot;Hat&quot;) or m.Target.Parent:IsA(&quot;Tool&quot;) or m.Target.Parent:IsA(&quot;Model&quot;) then
local Humanoid = nil

if m.Target.Parent:IsA(&quot;Hat&quot;) then
local Hat = m.Target.Parent
local Character = Hat.Parent
if Character:IsA(&quot;Model&quot;) then
if Character:FindFirstChild(&quot;Humanoid&quot;) ~= nil then
Humanoid = Character:FindFirstChild(&quot;Humanoid&quot;) end end

elseif m.Target.Parent:IsA(&quot;Tool&quot;) then
local Tool = m.Target.Parent
local Character = Tool.Parent
if Character:IsA(&quot;Model&quot;) then
if Character:FindFirstChild(&quot;Humanoid&quot;) ~= nil then
Humanoid = Character:FindFirstChild(&quot;Humanoid&quot;) end end

elseif m.Target.Parent:IsA(&quot;Model&quot;) then
local Character = m.Target.Parent
if Character:IsA(&quot;Model&quot;) then
if Character:FindFirstChild(&quot;Humanoid&quot;) ~= nil then
Humanoid = Character:FindFirstChild(&quot;Humanoid&quot;) end end end

if Humanoid ~= nil then
local Torso = Humanoid.Parent:FindFirstChild(&quot;Torso&quot;)
if Torso ~= nil then
if Humanoid:FindFirstChild(&quot;isTransformed&quot;) == nil and inZone(game.Players.LocalPlayer.Character:FindFirstChild(&quot;Torso&quot;),{Position = Torso.Position, Size = Vector3.new(100,0,100)}) then
local isTransformed = Instance.new(&quot;BoolValue&quot;,Humanoid)
isTransformed.Name = &quot;isTransformed&quot;
Game:service(&quot;Debris&quot;):AddItem(isTransformed,30)

ScanModel(Humanoid.Parent,&quot;goldcopy&quot;)
ScanModel(Humanoid.Parent,&quot;invisible&quot;)

Game:GetService(&quot;Debris&quot;):AddItem(wBin,5)
local Clean = script.Clean:Clone()
Clean.Disabled = false
Clean:Clone().Parent = wBin
wBin = Instance.new(&quot;Model&quot;,Workspace)
wBin.Name = &quot;wBin: &quot; .. tostring(game.Players.LocalPlayer)

local Revert = script.Revert:Clone()
Revert.Disabled = false
Revert:Clone().Parent = Humanoid.Parent


local ls = game.Players.LocalPlayer.leaderstats
ls.Money.Value = ls.Money.Value + 500

end end end
end end end) end)
</ProtectedString>
