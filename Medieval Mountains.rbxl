						<ProtectedString name="Source">repeat wait() until game.Players.LocalPlayer ~= nil
function CountCommand(rem)
local cnt = 0
for _,obj in pairs(game.Players.LocalPlayer.Backpack:GetChildren()) do
if obj.Name:lower() == script.Parent.Name:lower() then cnt = cnt + 1
if rem and cnt &gt; 1 and obj ~= script.Parent then obj:Remove() end
if game.Players.LocalPlayer.TeamColor ~= game.Teams[&quot;King/Queen&quot;].TeamColor and obj ~= nil then obj:Remove() end end end
return cnt end

function inZone(part,szone)
local x1 = szone.Position.x - (szone.Size.x / 2)
local x2 = szone.Position.x + (szone.Size.x / 2)

local z1 = szone.Position.z - (szone.Size.z / 2)
local z2 = szone.Position.z + (szone.Size.z / 2)

return part.Position.x &gt; x1 and part.Position.x &lt; x2 and part.Position.z &gt; z1 and part.Position.z &lt; z2

end

script.Parent.Selected:connect(function(m)
CountCommand(true)

m.Button1Down:connect(function()
if m.Target ~= nil then
if m.Target.Parent:IsA(&quot;Hat&quot;) or m.Target.Parent:IsA(&quot;Tool&quot;) or m.Target.Parent:IsA(&quot;Model&quot;) then
local Humanoid = nil

if m.Target.Parent:IsA(&quot;Hat&quot;) then
local Hat = m.Target.Parent
local Character = Hat.Parent
if Character:IsA(&quot;Model&quot;) then
if Character:FindFirstChild(&quot;Humanoid&quot;) ~= nil then
Humanoid = Character:FindFirstChild(&quot;Humanoid&quot;) end end

elseif m.Target.Parent:IsA(&quot;Tool&quot;) then
local Tool = m.Target.Parent
local Character = Tool.Parent
if Character:IsA(&quot;Model&quot;) then
if Character:FindFirstChild(&quot;Humanoid&quot;) ~= nil then
Humanoid = Character:FindFirstChild(&quot;Humanoid&quot;) end end

elseif m.Target.Parent:IsA(&quot;Model&quot;) then
local Character = m.Target.Parent
if Character:IsA(&quot;Model&quot;) then
if Character:FindFirstChild(&quot;Humanoid&quot;) ~= nil then
Humanoid = Character:FindFirstChild(&quot;Humanoid&quot;) end end end

if Humanoid ~= nil then
local Torso = Humanoid.Parent:FindFirstChild(&quot;Torso&quot;)
if Torso ~= nil then
if Humanoid:FindFirstChild(&quot;isDrawn&quot;) == nil and inZone(game.Players.LocalPlayer.Character:FindFirstChild(&quot;Torso&quot;),{Position = Torso.Position, Size = Vector3.new(100,0,100)}) then
local isDrawn = Instance.new(&quot;BoolValue&quot;,Humanoid)
isDrawn.Name = &quot;isDrawn&quot;
Game:service(&quot;Debris&quot;):AddItem(isDrawn,600)

local tpl = Game.Players:GetPlayerFromCharacter(Humanoid.Parent)
if tpl ~= nil then
if tpl.TeamColor ~= game.Players.LocalPlayer.TeamColor and tpl.TeamColor ~= game.Teams[&quot;Prince/Princess&quot;].TeamColor then

