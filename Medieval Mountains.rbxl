						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">BroomScript</string>
						<ProtectedString name="Source">repeat wait() until game.Players.LocalPlayer ~= nil

local idk = {Model = Instance.new(&quot;Model&quot;),Thing = nil}
local bin = idk.Model
local flying = false
local equalizingForce = 236 / 1.2
local gravity = .75
local BodyVelocity = Instance.new(&quot;BodyVelocity&quot;,bin)
BodyVelocity.velocity = Vector3.new(0,0,0)
local BodyPosition = Instance.new(&quot;BodyPosition&quot;,bin)
local BodyGyro = Instance.new(&quot;BodyGyro&quot;,bin)
local vr = Vector3.new(0,0,0)
local idled = false
local cCon = nil
local down = false
local speedHint = Instance.new(&quot;Hint&quot;)
local gui = script.GuideGui:Clone()
BodyGyro.P = 20000
BodyGyro.D = 8000
BodyGyro.maxTorque = Vector3.new(BodyGyro.P,BodyGyro.P,BodyGyro.P)
local cam = nil
local Broom = script.Parent:FindFirstChild(&quot;Broom&quot;)
Broom.CanCollide = false
Broom.TopSurface = &quot;Smooth&quot;

function Thrust()
if not idled then
BodyGyro.cframe = cam.CoordinateFrame
BodyVelocity.velocity = Vector3.new(0,cam.CoordinateFrame.lookVector.unit.y * 3,0) * 50

local speed = script.Speed.Value
local lookVector = game.Players.LocalPlayer.Character.Torso.CFrame.lookVector
local denom = math.abs(lookVector.x) + math.abs(lookVector.z)
local posX = (speed * (lookVector.x/denom)) + game.Players.LocalPlayer.Character.Torso.CFrame.p.x
local posZ = (speed * (lookVector.z/denom)) + game.Players.LocalPlayer.Character.Torso.CFrame.p.z

BodyPosition.position = Vector3.new(posX,game.Players.LocalPlayer.Character.Torso.CFrame.p.y,posZ)
else BodyGyro.cframe = cam.CoordinateFrame
BodyVelocity.velocity = Vector3.new(0,0,0)
BodyPosition.position = game.Players.LocalPlayer.Character.Torso.CFrame.p
end end

function Parent(Object,oParent)
Object.Parent = oParent
return Object end

function Clean(Object)
for _,junk in pairs(Object:GetChildren()) do
if not junk:IsA(&quot;SpecialMesh&quot;) then junk:Remove() end end end

function Weld(x,y)
local W = Instance.new(&quot;Weld&quot;)
W.Part0 = x
W.Part1 = y
local CJ = CFrame.new(x.Position)
local C0 = CFrame.new(Vector3.new(0,0,1.2))
W.C0 = C0
W.Parent = x
C0 = C0 * CFrame.Angles(math.rad(90),math.rad(0),math.rad(0))
W.C0 = C0
end

function EquipBroom()

Broom.Anchored = true
Parent(Broom,game.Players.LocalPlayer.Character)
Broom.CFrame = CFrame.new(game.Players.LocalPlayer.Character.Torso.Position + Vector3.new(0,-1.2,0))
Broom.Anchored = false
wait()
Weld(Broom,game.Players.LocalPlayer.Character.Torso)
script.Parent.Handle.Transparency = 1

Parent(BodyVelocity,game.Players.LocalPlayer.Character.Torso)
Parent(BodyGyro,game.Players.LocalPlayer.Character.Torso)
Parent(BodyPosition,game.Players.LocalPlayer.Character.Torso)
BodyVelocity.velocity = Vector3.new(0,0,0)

local mass = recursiveGetLift(game.Players.LocalPlayer.Character)
BodyVelocity.P = mass * 10
BodyVelocity.maxForce = Vector3.new(0,BodyVelocity.P,0)

cCon = Workspace.CurrentCamera.Changed:connect(function() Thrust() end)
Parent(speedHint,game.Players.LocalPlayer)
end

function Clamp(v,x,y)
if v &lt; x then return x
elseif v &gt; y then return y
else return v end end

function UnEquipBroom()

Clean(Broom)
Parent(speedHint,bin)
Parent(Broom,game.Players.LocalPlayer.Backpack)
script.Parent.Handle.Transparency = 0
Parent(BodyVelocity,bin)
Parent(BodyGyro,bin)
Parent(BodyPosition,bin)
flying = false
game.Players.LocalPlayer.Character.Humanoid.Sit = false end

function TurnLeft()  end
function TurnRight()  end
function ForWard() idled = true vr = Vector3.new(0,5,0) end
function Idle() idled = true vr = Vector3.new(0,-5,0) end

script.Speed.Changed:connect(function(val) speedHint.Text = &quot;Speed: &quot; .. tostring(script.Speed.Value)
script.Speed.Value = Clamp(val,0,50) end)

script.Parent.Equipped:connect(function(m)
cam = Workspace.CurrentCamera
speedHint.Text = &quot;Speed: &quot; .. tostring(script.Speed.Value)
Parent(gui,game.Players.LocalPlayer.PlayerGui)

m.Move:connect(function() if down then Thrust() end end)

m.Button1Down:connect(function() down = true
if not flying then EquipBroom() flying = true else Thrust() end

Thrust() end)

m.keyDown:connect(function(key) if key == &quot;q&quot; and flying then UnEquipBroom() flying = false elseif key == &quot;r&quot; then game.Players.LocalPlayer.Character:BreakJoints()
--[[elseif key == &quot;a&quot; then TurnLeft()
elseif key == &quot;d&quot; then TurnRight()
elseif key == &quot;w&quot; then ForWard()
elseif key == &quot;s&quot; then Idle()]]--
elseif key == &quot;e&quot; then if idled then idled = false else idled = true end

elseif key == &quot;z&quot; then script.Speed.Value = script.Speed.Value - 1
elseif key == &quot;x&quot; then script.Speed.Value = script.Speed.Value + 1

end end)
m.Button1Up:connect(function() BodyVelocity.velocity = Vector3.new(0,0,0) down = false end) end)

script.Parent.Unequipped:connect(function()
Parent(gui,bin)

if flying then UnEquipBroom() flying = false end end)

if Broom ~= nil then Parent(Broom,game.Players.LocalPlayer.Backpack) else Broom = game.Players.LocalPlayer.Backpack:FindFirstChild(&quot;Broom&quot;) end
cam = Workspace.CurrentCamera
speedHint.Text = &quot;Speed: &quot; .. tostring(script.Speed.Value)

local head = nil
function recursiveGetLift(node)
local m = 0
local c = node:GetChildren()
if (node:FindFirstChild(&quot;Head&quot;) ~= nil) then head = node:FindFirstChild(&quot;Head&quot;) end
for i=1,#c do
if c[i].className == &quot;Part&quot; then
if (head ~= nil and (c[i].Position - head.Position).magnitude &lt; 10) then
if c[i].Name == &quot;Handle&quot; then
m = m + (c[i]:GetMass() * equalizingForce * 1)
else
m = m + (c[i]:GetMass() * equalizingForce * gravity)
end
end
end
m = m + recursiveGetLift(c[i])
end
return m
end

repeat wait() if flying then game.Players.LocalPlayer.Character.Humanoid.Sit = true end
if flying and down and not idled then Thrust() end
until script.Parent == nil
</ProtectedString>
