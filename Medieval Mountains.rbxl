gui_parts={}
text=[[]]

function allowed(part)
if string.len(part.Name)&gt;=17 then
if string.sub(part.Name,1,16)==&quot;BlobbyblobBuild_&quot; then
p=string.sub(part.Name,17)
if game.Players.LocalPlayer:findFirstChild(&quot;BlobbyblobBuildToolStats&quot;) then
if game.Players.LocalPlayer.BlobbyblobBuildToolStats:findFirstChild(&quot;CanSave_&quot;..p) then
return true
end
end
end
end
if game.Players.LocalPlayer.Name==&quot;blobbyblob&quot; then return true end
return false
end

function recursive(root)
for count,a in pairs(root:GetChildren()) do
if (allowed(a) and (a:IsA(&quot;Part&quot;) or a:IsA(&quot;BlockMesh&quot;) or a:IsA(&quot;WedgePart&quot;) or a:IsA(&quot;TrussPart&quot;))) or (allowed(a.Parent) and a:IsA(&quot;DataModelMesh&quot;)) then
table.insert(gui_parts,a)
end
if #a:GetChildren()&gt;0 then recursive(a) end
end
end
recursive(workspace)
q=[[&quot;]]
end_line_chunk=&quot;   &quot;
start_at=1
round=function(number,multiple)
return math.floor(number/multiple+.5)*multiple
end
for _,a in pairs(gui_parts) do
text=text..&quot;obj&quot;..tostring(_-1+start_at)..&quot;=Instance.new(&quot;..q..a.className..q..&quot;)&quot;..end_line_chunk
if classes[a.className]~=nil then
for b,c in pairs(classes[a.className]) do
dont_do_this_one=false
if c[3]~=nil then
 if type(a[c[1]])==&quot;string&quot; then
  if c[3]==a[c[1]] then
dont_do_this_one=true
  end
 else
  if c[3]==tostring(a[c[1]]) then
   dont_do_this_one=true
  end
 end
end
if not dont_do_this_one then
if c[2]==&quot;boolean&quot; then
text=text..&quot;obj&quot;..tostring(_-1+start_at)..&quot;.&quot;..c[1]..&quot;=&quot;..tostring(a[c[1]])..end_line_chunk
elseif c[2]==&quot;number&quot; then
text=text..&quot;obj&quot;..tostring(_-1+start_at)..&quot;.&quot;..c[1]..&quot;=&quot;..tostring(a[c[1]])..end_line_chunk
elseif c[2]==&quot;text&quot; or c[2]==&quot;string&quot; then
text=text..&quot;obj&quot;..tostring(_-1+start_at)..&quot;.&quot;..c[1]..[[=&quot;]]..tostring(a[c[1]])..[[&quot;]]..end_line_chunk
elseif c[2]==&quot;brickcolor&quot; then
text=text..&quot;obj&quot;..tostring(_-1+start_at)..&quot;.&quot;..c[1]..[[=BrickColor.new(&quot;]]..tostring(a[c[1]])..[[&quot;)]]..end_line_chunk
elseif c[2]==&quot;udim2&quot; then
text=text..&quot;obj&quot;..tostring(_-1+start_at)..&quot;.&quot;..c[1]..[[=UDim2.new(]]..tostring(a[c[1]].X.Scale)..&quot;,&quot;..tostring(a[c[1]].X.Offset)..&quot;,&quot;..tostring(a[c[1]].Y.Scale)..&quot;,&quot;..tostring(a[c[1]].Y.Offset)..[[)]]..end_line_chunk
elseif c[2]==&quot;object&quot; then
foundparent=false
 for d,e in pairs(gui_parts) do
  if a.Parent==e then
   text=text..&quot;obj&quot;..tostring(_-1+start_at)..&quot;.&quot;..c[1]..&quot;=&quot;..&quot;obj&quot;..tostring(d)..end_line_chunk
   foundparent=true
  end
 end
if not foundparent then
 text=text..&quot;obj&quot;..tostring(_-1+start_at)..&quot;.&quot;..c[1]..&quot;=&quot;..&quot;workspace&quot;..end_line_chunk
end
elseif c[2]==&quot;color3&quot; then
text=text..&quot;obj&quot;..tostring(_-1+start_at)..&quot;.&quot;..c[1]..[[=Color3.new(]]..tostring(round(a[c[1]].r*255,1))..&quot;/255,&quot;..tostring(round(a[c[1]].g*255,1))..&quot;/255,&quot;..tostring(round(a[c[1]].b*255,1))..&quot;/255&quot;..[[)]]..end_line_chunk
elseif c[2]==&quot;enum&quot; then
text=text..&quot;obj&quot;..tostring(_-1+start_at)..&quot;.&quot;..c[1]..[[=]]..tostring(a[c[1]])..end_line_chunk
elseif c[2]==&quot;vector3&quot; then
text=text..&quot;obj&quot;..tostring(_-1+start_at)..&quot;.&quot;..c[1]..[[=Vector3.new(]]..tostring(a[c[1]])..[[)]]..end_line_chunk
elseif c[2]==&quot;cframe&quot; then
text=text..&quot;obj&quot;..tostring(_-1+start_at)..&quot;.&quot;..c[1]..[[=CFrame.new(]]..tostring(a[c[1]])..[[)]]..end_line_chunk
end
end
end
