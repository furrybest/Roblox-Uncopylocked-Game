			<Item class="Script" referent="RBX7646">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">SeatEat</string>
					<ProtectedString name="Source">for _,seat in pairs(script.Parent:GetChildren()) do
if seat:IsA(&quot;Seat&quot;) then

if seat:FindFirstChild(&quot;LastTool&quot;) == nil then
local LastTool = Instance.new(&quot;ObjectValue&quot;,seat)
LastTool.Name = &quot;LastTool&quot; end

seat.ChildAdded:connect(function(child) if tostring(child):lower() == &quot;seatweld&quot; then
if child.Part1 ~= nil then
local Torso = child.Part1
local player = game.Players:GetPlayerFromCharacter(Torso.Parent)
if player ~= nil then

local Tool = game.Lighting.Tools:FindFirstChild(&quot;Eat&quot;)
if Tool ~= nil then
Tool = Tool:Clone()
Tool.Parent = player.Backpack
seat.LastTool.Value = Tool end
end end end end)

seat.ChildRemoved:connect(function(child) if tostring(child):lower() == &quot;seatweld&quot; then
if seat.LastTool.Value ~= nil then
seat.LastTool.Value:Remove()
seat.LastTool.Value = nil end end end) end end
</ProtectedString>
					<bool name="archivable">true</bool>
				</Properties>
			</Item>
		</Item>
