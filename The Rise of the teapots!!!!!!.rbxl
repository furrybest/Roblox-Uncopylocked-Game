							<string name="Name">Script</string>
							<string name="Source">--robot spawn&#13;&#10;name=&quot;Blue1&quot;&#13;&#10;&#13;&#10;wait(1)&#13;&#10;robo=game.Workspace:findFirstChild(name):clone()&#13;&#10;&#13;&#10;while true do&#13;&#10;&#9;wait(5)&#13;&#10;&#9;if game.Workspace:findFirstChild(name)==nil then&#13;&#10;&#9;&#9;robot=robo:clone()&#13;&#10;&#9;&#9;robot.Parent=game.Workspace&#13;&#10;&#9;end&#13;&#10;&#9;if game.Workspace:findFirstChild(name):findFirstChild(&quot;Humanoid&quot;)==nil then&#13;&#10;&#9;&#9;game.Workspace:findFirstChild(name):remove()&#13;&#10;&#9;&#9;robot=robo:clone()&#13;&#10;&#9;&#9;robot.Parent=game.Workspace&#13;&#10;&#9;end&#13;&#10;&#9;if game.Workspace:findFirstChild(name).Humanoid.Health&lt;1 then&#13;&#10;&#9;&#9;game.Workspace:findFirstChild(name):remove()&#13;&#10;&#9;&#9;robot=robo:clone()&#13;&#10;&#9;&#9;robot.Parent=game.Workspace&#13;&#10;&#9;end&#13;&#10;end&#13;&#10;&#9;&#9;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;</string>
