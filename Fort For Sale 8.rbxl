										<Item class="Script" referent="RBX2474">
											<Properties>
												<bool name="Disabled">false</bool>
												<Content name="LinkedSource"><null></null></Content>
												<string name="Name">OnSeated</string>
												<ProtectedString name="Source">position = script.Parent.Engine.Position
local frame = Instance.new(&quot;CFrameValue&quot;)
frame.Name = &quot;OriginCFrame&quot;
frame.Value = script.Parent.Engine.CFrame
frame.Parent = script.Parent

local object = Instance.new(&quot;ObjectValue&quot;)
object.Value = script.Parent.Parent.Parent


seat = script.Parent.Seat

function onChildAdded(part)
&#9;if part.className == &quot;Weld&quot; then
&#9;&#9;local torso = part.Part1
&#9;&#9;if torso ~= nil then
&#9;&#9;&#9;local parent = torso.Parent
&#9;&#9;&#9;if parent ~= nil then
&#9;&#9;&#9;&#9;script.Parent.Parent.Parent = parent
&#9;&#9;&#9;&#9;script.Parent.Latch:Remove()
&#9;&#9;&#9;&#9;while true do
&#9;&#9;&#9;&#9;&#9;wait(2)
&#9;&#9;&#9;&#9;&#9;local pos = script.Parent.Engine.Position
&#9;&#9;&#9;&#9;&#9;if (position - pos).magnitude &gt; 30 then
&#9;&#9;&#9;&#9;&#9;&#9;if object.Value ~= nil then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;object.Value.Regen.Value = 1
&#9;&#9;&#9;&#9;&#9;&#9;&#9;wait(.5)
&#9;&#9;&#9;&#9;&#9;&#9;&#9;object.Value.Regen.Value = 0
&#9;&#9;&#9;&#9;&#9;&#9;&#9;object.Value = nil
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;break end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;while true do
&#9;&#9;&#9;&#9;&#9;print(&quot;Loop&quot;)
&#9;&#9;&#9;&#9;&#9;wait(2)
&#9;&#9;&#9;&#9;&#9;if part == nil then
&#9;&#9;&#9;&#9;&#9;&#9;script.Parent.Parent.Parent = game.Workspace
&#9;&#9;&#9;&#9;&#9;&#9;script.Parent.Parent:MakeJoints()
&#9;&#9;&#9;&#9;&#9;break end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end
seat.ChildAdded:connect(onChildAdded)</ProtectedString>
											</Properties>
										</Item>
										<Item class="Script" referent="RBX2475">
											<Properties>
												<bool name="Disabled">false</bool>
												<Content name="LinkedSource"><null></null></Content>
												<string name="Name">Camera</string>
												<ProtectedString name="Source">seat = script.Parent.Seat

function onChildAdded(part)
&#9;if part.className == &quot;Weld&quot; then
&#9;&#9;local torso = part.Part1
&#9;&#9;if torso ~= nil then
&#9;&#9;&#9;local parent = torso.Parent
&#9;&#9;&#9;if parent ~= nil then
&#9;&#9;&#9;&#9;local CamChange = script.AttachCam:clone()
&#9;&#9;&#9;&#9;CamChange.Parent = parent
&#9;&#9;&#9;&#9;script.Parent.Parent.Parent = parent
&#9;&#9;&#9;end
&#9;
&#9;&#9;end
&#9;end
end
function onChildRem(part)
&#9;if part.className == &quot;Weld&quot; then
&#9;&#9;local torso = part.Part1
&#9;&#9;if torso ~= nil then
&#9;&#9;&#9;local parent = torso.Parent
&#9;&#9;&#9;if parent ~= nil then
&#9;&#9;&#9;&#9;local CamRem = script.RemCam:clone()
&#9;&#9;&#9;&#9;CamRem.Parent = parent
&#9;&#9;&#9;&#9;script.Parent.Parent.Parent = parent
&#9;&#9;&#9;end
&#9;
&#9;&#9;end
&#9;end
end
seat.ChildAdded:connect(onChildAdded)
seat.ChildRemoved:connect(onChildRem)</ProtectedString>
											</Properties>
											<Item class="LocalScript" referent="RBX2476">
												<Properties>
													<bool name="Disabled">false</bool>
													<Content name="LinkedSource"><null></null></Content>
													<string name="Name">AttachCam</string>
													<ProtectedString name="Source">if(script.Parent.className == &quot;Model&quot;) then
&#9;wait(1)
&#9;local Plane = script.Parent:findFirstChild(&quot;Plane&quot;)
&#9;if (Plane ~= nil) then
&#9;&#9;local Engine = Plane.Parts:findFirstChild(&quot;Engine&quot;)
&#9;&#9;if(Engine ~= nil) then
&#9;&#9;&#9;local cam = game.Workspace.CurrentCamera
&#9;&#9;&#9;cam.CameraSubject = Plane.Parts.UAV.Head
&#9;&#9;&#9;cam.CameraType = Enum.CameraType.Track
&#9;&#9;end
&#9;end
&#9;wait(.1)
&#9;script:remove()
end
</ProtectedString>
												</Properties>
											</Item>
											<Item class="LocalScript" referent="RBX2477">
												<Properties>
													<bool name="Disabled">false</bool>
													<Content name="LinkedSource"><null></null></Content>
													<string name="Name">RemCam</string>
													<ProtectedString name="Source">if(script.Parent.className == &quot;Model&quot;) then
&#9;local cam = game.Workspace.CurrentCamera
&#9;cam.CameraSubject = script.Parent.Head
&#9;cam.CameraType = Enum.CameraType.Track
&#9;wait(.1)
&#9;script:remove()
end
</ProtectedString>
