&#9;&#9;if (hit.Parent) then
&#9;&#9;&#9;if (game.Players:GetPlayerFromCharacter(hit.Parent)) then
&#9;&#9;&#9;&#9;if (game.Players:GetPlayerFromCharacter(hit.Parent):IsInGroup(131688)) then
&#9;&#9;&#9;&#9;&#9;debounce = true
&#9;&#9;&#9;&#9;&#9;script.Parent.Transparency = 0.5
&#9;&#9;&#9;&#9;&#9;wait(0.2)
&#9;&#9;&#9;&#9;&#9;script.Parent.Transparency = 0.6
