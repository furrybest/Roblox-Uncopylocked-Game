														<ProtectedString name="Source">debounce = false

function activate(hit)
&#9;if (script.Parent.Active.Value ~= true) then
&#9;&#9;return
&#9;end
&#9;if (debounce == true) then
&#9;&#9;return
&#9;end
&#9;debounce = true
&#9;script.Parent.Anchored = true
&#9;wait(0.05)
&#9;Boom2 = Instance.new(&quot;Explosion&quot;)
&#9;Boom2.BlastRadius = 12
&#9;Boom2.Parent = game.Workspace
&#9;Boom2.Position = script.Parent.Position
&#9;wait(0.5)
&#9;Boom2:Remove()
&#9;Boom = Instance.new(&quot;Part&quot;)
&#9;Boom.Parent = game.Workspace
&#9;Boom.formFactor = 0
&#9;Boom.Shape = 0
&#9;Boom.BrickColor = BrickColor.new(&quot;Br. yellowish orange&quot;)
&#9;Boom.Position = script.Parent.Position
&#9;Boom.Transparency = 0.5
&#9;Boom.Size = Vector3.new(4, 1, 4)
&#9;Boom.Anchored = true
&#9;Boom.CanCollide = false
&#9;Boom.TopSurface = &quot;Smooth&quot;
&#9;Boom.BottomSurface = &quot;Smooth&quot;
&#9;script.Parent.Transparency = 1
&#9;Script = script.Parent.Explosion
&#9;SC = Script:clone()
&#9;SC.Disabled = false
&#9;SC.Parent = Boom
&#9;Grow = script.Parent.Grow
&#9;GC = Grow:clone()
&#9;GC.Disabled = false
&#9;GC.Parent = Boom
&#9;Stay = script.Parent.Stay
&#9;SC = Stay:clone()
&#9;SC.Disabled = false
&#9;SC.Parent = Boom
&#9;Boom2 = Instance.new(&quot;Explosion&quot;)
&#9;Boom2.BlastRadius = 12
&#9;Boom2.Position = script.Parent.Position
&#9;wait(0.5)
&#9;Boom2:Remove()
&#9;wait(5)
&#9;script.Parent.Parent:Remove()
&#9;debounce = false
end

script.Parent.Touched:connect(activate)
</ProtectedString>
