					<ProtectedString name="Source">bin=script.Parent
player = bin.Parent.Parent
lastblock = nil
hold=false

function onMove(mouse)
targ = mouse.Target
if targ==nil then return end
if targ.Locked==true then return end
end

function onButton1Down(mouse)
if (hold == true) then
local no_no = bin.error
no_no:play()
else
local no_no = bin.error
local part = mouse.Target
if (part ~= nil) then
local lock = part.Locked
if (lock ==  false) then
local boom = bin.Explosion
part.Parent = player[&quot;Deleted_Bricks&quot;]
part.Name = player.leaderstats.Deletes.Value + 1
explosion = Instance.new(&quot;Explosion&quot;)
explosion.Position = part.Position
explosion.BlastRadius = 1
explosion.BlastPressure = 0
explosion.Parent = game.Workspace
boom:play()
player.leaderstats.Deletes.Value = player.leaderstats.Deletes.Value + 1
BrickDeleted(part.Position)
--PlayMessage()
else
no_no:play()
end
end
mouse.Icon = &quot;rbxasset://textures\\HammerCursor.png&quot;
hold = false
end
end

function onSelected(mouse)

mouse.Icon = &quot;rbxasset://textures\\HammerCursor.png&quot;
mouse.Button1Down:connect(function() onButton1Down(mouse) end)
mouse.KeyDown:connect(onKeyDown)

local h = Instance.new(&quot;Hint&quot;)
h.Parent = script.Parent.Parent.Parent
h.Text = &quot;Press U to undo your last delete&quot; 
h.Name = &quot;Hint&quot;
wait (2)
h.Parent = nil

end

function onKeyDown(key)
if (key ~= nil) then
key = key:lower()
if (key == &quot;u&quot;) then
z = player[&quot;Deleted_Bricks&quot;]:getChildren()
if #z == 0 then return end
b = 0
for i = 1,#z do
if tonumber(z[i].Name) &gt; b then
b = tonumber(z[i].Name)
end
end
c = player[&quot;Deleted_Bricks&quot;][b]
c.Name = &quot;Smooth Block Model&quot;
c.Parent = Workspace
c:makeJoints()
end
end
end

function onDeselected()
if plane ~= nil then
plane = nil
end
end

--[[function PlayMessage()
g = game.Players:GetChildren()
for i = 1,#g do
if g[i].className == &quot;Player&quot; then
local h = Instance.new(&quot;Hint&quot;)
h.Text = script.Parent.Parent.Parent.Name .. &quot; has deleted a brick&quot;
h.Parent = g[i]
wait(2)
h.Parent = nil
end
end
end]]

function BrickDeleted(pos)
local model = Instance.new(&quot;Model&quot;)
model.Name = &quot;Brick Deleted by &quot;..player.Name
model.Parent = Workspace

local humanoid = Instance.new(&quot;Humanoid&quot;)
humanoid.MaxHealth = 0
humanoid.Parent = model

local head = Instance.new(&quot;Part&quot;)
head.Anchored = true
head.Locked = true
head.CanCollide = false
head.Name = &quot;Head&quot;
head.size = Vector3.new(1,1,1)
head.CFrame = CFrame.new(pos)
head.Parent = model

local mesh = Instance.new(&quot;BlockMesh&quot;)
mesh.Scale = Vector3.new(0,0,0)
mesh.Parent = head
wait(2)
model.Parent = nil
end

bin.Equipped:connect(onSelected)
bin.Unequipped:connect(onDeselected)</ProtectedString>
