targ = mouse.Target
if targ==nil then return end
if targ.Name ~= (&quot;Smooth Block Model&quot;) then
script.Parent.Parent.Parent.Message.Text = &quot;Your not supposed to Unlock that!&quot;
return end
if targ.Locked == true then
targ.Locked = false
local a = targ.Transparency
targ.Reflectance = 1
wait(0.1)
targ.Reflectance = a
else targ.Locked = true
local b = targ.Reflectance
targ.Reflectance = 1
wait(0.1)
targ.Reflectance = b
end
end

