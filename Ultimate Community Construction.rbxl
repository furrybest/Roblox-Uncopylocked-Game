						<ProtectedString name="Source">--B0BBA, http://www.roblox.com/Item.aspx?ID=3354216

bin = script.Parent
player = game.Players.LocalPlayer

function onButton1Down(mouse)

	if player == nil then return end
	if player.Character.Humanoid.WalkSpeed~=40 then
	player.Character.Humanoid.WalkSpeed=40
	script.Parent.Name = &quot;Walk&quot;
	mouse.Icon = &quot;rbxasset://textures\\ArrowCursor.png&quot;
	else
	player.Character.Humanoid.WalkSpeed=16
	script.Parent.Name = &quot;Run&quot;
	mouse.Icon = &quot;rbxasset://textures\\ArrowCursor.png&quot;
	end
end

function onSelected(mouse)	
	if player.Character.Humanoid.WalkSpeed~=16 then
	script.Parent.Name = &quot;Walk&quot;
	else
	script.Parent.Name = &quot;Run&quot;
	end
	mouse.Icon = &quot;rbxasset://textures\\ArrowCursor.png&quot;
	mouse.Button1Down:connect(function() onButton1Down(mouse) end)
end

function onDeS(mouse) 
script.Parent.Name = &quot;Speed&quot;
end 
script.Parent.Deselected:connect(onDeS)

bin.Selected:connect(onSelected)

