								<ProtectedString name="Source">local x = Vector3.new(-8000, 0, 0)
local z = Vector3.new(0, 0, 0)
local a = BrickColor.new(&quot;Black&quot;)
local b = BrickColor.new(&quot;Bright red&quot;)

