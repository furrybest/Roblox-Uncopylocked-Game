		<Item class="HopperBin" referent="RBX4087">
			<Properties>
				<bool name="Active">false</bool>
				<token name="BinType">0</token>
				<string name="Name">Clone</string>
				<Content name="TextureId"><url>rbxasset://Textures\Clone.png</url></Content>
