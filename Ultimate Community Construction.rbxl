						<ProtectedString name="Source">-- zipperipper&apos;s script
Bin = script.Parent

mode = &quot;free&quot;


function onKeyDown(key) -- key functions

	if (key~=nil) then



		if (key==&quot;z&quot;) then -- mode button

			mode = &quot;Red&quot;

			Bin.Name = &quot;Red&quot;

		end



		if (key==&quot;x&quot;) then -- mode button

			mode = &quot;Blue&quot;

			Bin.Name = &quot;Blue&quot;

		end



		if (key==&quot;c&quot;) then -- mode button

			mode = &quot;Green&quot;

			Bin.Name = &quot;Green&quot;

		end



		if (key==&quot;v&quot;) then -- mode button
			mode = &quot;Yellow&quot;

			Bin.Name = &quot;Yellow&quot;

		end


		if (key==&quot;b&quot;) then -- mode button

			mode = &quot;Purple&quot;

			Bin.Name = &quot;Purple&quot;

		end



		if (key==&quot;n&quot;) then -- mode button

			mode = &quot;Black&quot;

			Bin.Name = &quot;Black&quot;

		end



		if (key==&quot;m&quot;) then -- mode button

			mode = &quot;White&quot;

			Bin.Name = &quot;White&quot;

		end



		if (key==&quot;k&quot;) then -- mode button

			mode = &quot;Orange&quot;

			Bin.Name = &quot;Orange&quot;

		end



		if (key==&quot;l&quot;) then -- mode button

			mode = &quot;Grey&quot;

			Bin.Name = &quot;Grey&quot;

		end



		if (key==&quot;j&quot;) then -- mode button

			mode = &quot;Brown&quot;

			Bin.Name = &quot;Brown&quot;

		end



		if (key==&quot;h&quot;) then -- mode button

			mode = &quot;Pink&quot;

			Bin.Name = &quot;Pink&quot;

		end





	end

end







function onButton1Down(mouse)

	mt = mouse.Target

	mts = mt.Size	if mt.Locked == false then

		if mode == &quot;Red&quot; then

			mt.BrickColor = BrickColor.new(21)

		end



		if mode == &quot;Blue&quot; then

			mt.BrickColor = BrickColor.new(23)

		end



		if mode == &quot;Green&quot; then

			mt.BrickColor = BrickColor.new(37)

		end



		if mode == &quot;Yellow&quot; then

			mt.BrickColor = BrickColor.new(24)

		end



		if mode == &quot;Purple&quot; then

			mt.BrickColor = BrickColor.new(104)

		end



		if mode == &quot;Black&quot; then

			mt.BrickColor = BrickColor.new(26)

		end



		if mode == &quot;White&quot; then

			mt.BrickColor = BrickColor.new(1)

		end



		if mode == &quot;Orange&quot; then

			mt.BrickColor = BrickColor.new(105)

		end



		if mode == &quot;Grey&quot; then

			mt.BrickColor = BrickColor.new(194)

		end

		if mode == &quot;Brown&quot; then

			mt.BrickColor = BrickColor.new(38)

		end


		if mode == &quot;Pink&quot; then

			mt.BrickColor = BrickColor.new(9)

		end

	end

end




function onSelected(mouse)
	 --b = Instance.new(&quot;Message&quot;)
             --  b.Parent = script.Parent.Parent.Parent
             --  b.Text = &quot;Color tool&quot;
     
        h = Instance.new(&quot;Hint&quot;)
               h.Parent = script.Parent.Parent.Parent
               h.Text = &quot;press z, x, c, v, b, n, m, h, j, k or l to change color mode&quot; 
               h.Name = &quot;Hint&quot;
	if mode~=&quot;free&quot; then
	script.Parent.Name = mode
	end

	mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
	mouse.Button1Down:connect(function() onButton1Down(mouse) end)
	mouse.KeyDown:connect(onKeyDown)

end

function onDeS(mouse) 
script.Parent.Parent.Parent.Hint:remove()
script.Parent.Name = &quot;ColorTool&quot;
--script.Parent.Parent.Parent.Message:remove() 
end 
script.Parent.Deselected:connect(onDeS)
Bin.Selected:connect(onSelected)



