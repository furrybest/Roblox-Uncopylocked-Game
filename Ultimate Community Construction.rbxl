						<string name="Name">Tool Script</string>
						<ProtectedString name="Source">m = Instance.new(&quot;Message&quot;)
mode = 0
speed = 20
torque = 10
function Selected(mouse)
funny = 1
m.Parent = script.Parent.Parent.Parent
message()
Bin = script.Parent
Player = Bin.Parent.Parent.Character
print(&quot;Selected&quot;)
mouse.Button1Down:connect(function() onButton1Down(mouse) end)
mouse.Button1Up:connect(function() onButton1Up(mouse) end)
mouse.KeyDown:connect(onKeyDown)
end

function message()
if mode == 0 then
m.Text = &quot;Press Q or E to change modes&quot;
end
if mode == 1 then
m.Text = &quot;Use Z or X to change MaxSpeed&quot;
end
if mode == 2 then
m.Text = &quot;Use Z or X to change Torque&quot;
end
end

function onKeyDown(key)
if (key~=nil) then
if ((key == &quot;q&quot;)) then
if mode == 0 then mode = 2 message() return end
if mode == 2 then mode = 1 message() return end
if mode == 1 then mode = 2 message() return end
end
if ((key == &quot;e&quot;)) then
if mode == 2 then mode = 1 message() return end
if mode == 1 then mode = 2 message() return end
if mode == 0 then mode = 2 message() return end
end
if ((key == &quot;x&quot;)) then
if mode == 1 then
speed = speed - 5
m.Text = &quot;Max Speed:&quot;..speed
end
if mode == 2 then
torque = torque - 5
m.Text = &quot;Max Torque:&quot;..torque
end
end
if ((key == &quot;z&quot;)) then
if mode == 1 then
speed = speed + 5
m.Text = &quot;Max Speed:&quot;..speed
end
if mode == 2 then
torque = torque + 5
m.Text = &quot;Max Torque:&quot;..torque
end
end
end
end

function onButton1Down(mouse)
if mouse.Target.className == &quot;VehicleSeat&quot; then
mouse.Target.MaxSpeed = speed
mouse.Target.Torque = torque
m.Text = &quot;VehicleSeat Changed&quot;
end
end

function onButton1Up(mouse)
end

function Deselected()
m.Parent = nil
print(&quot;Deselected&quot;)
end


script.Parent.Selected:connect(Selected)
script.Parent.Deselected:connect(Deselected)
