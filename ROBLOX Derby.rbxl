								<string name="Name">LevelCheck</string>
								<ProtectedString name="Source">local Require = script.Parent.Parent.Parent.Parent.leaderstats.Level
Sounds = Instance.new(&quot;Sound&quot;)
Sounds.SoundId = &quot;rbxasset://sounds//Victory.wav&quot;

script.Parent.Parent.Parent.Parent.leaderstats.Level.Changed:connect(function(LevelCheck)
local check = script.Parent:GetChildren()
for i = 1, #check do
if check[i]:IsA(&quot;ImageButton&quot;) then
if Require.Value == check[i].LevelRequire.Value then
Sounds.Parent = script.Parent.Parent.Parent.Parent
script.Parent.Parent.Parent.CarWin.BG.Visible = true
script.Parent.Parent.Parent.CarWin.Car.Visible = true
