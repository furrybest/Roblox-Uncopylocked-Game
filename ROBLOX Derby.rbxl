								<Item class="Script" referent="RBX13083">
									<Properties>
										<bool name="Disabled">false</bool>
										<Content name="LinkedSource"><null></null></Content>
										<string name="Name">Script</string>
										<ProtectedString name="Source">PointsP = script.Parent.Parent.Parent.Parent.Parent.Parent.leaderstats.Points
Player = script.Parent.Parent.Parent.Parent.Parent.Parent
local parent = script.Parent
local children = parent:GetChildren()

for _,v in pairs(children) do
if v:findFirstChild(&quot;Price&quot;) then
v.MouseButton1Down:connect(function(Click)
local value = v.wat.Value
local Cost = v:FindFirstChild(&quot;Price&quot;)
local Buy = v:FindFirstChild(&quot;Bought&quot;)
if PointsP.Value &lt; Cost.Value then 
return end
if Player:IsInGroup(171508) then
NewCost = Cost.Value/2
PointsP.Value = PointsP.Value -NewCost
Player[value].Value = Player[value].Value -Buy.Value
else
PointsP.Value = PointsP.Value -Cost.Value
Player[value].Value = Player[value].Value -Buy.Value
end
end)
end
end </ProtectedString>
