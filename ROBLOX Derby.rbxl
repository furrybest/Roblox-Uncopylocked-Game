								<ProtectedString name="Source">Debounce = true
Table = {&quot;Shine2&quot;, &quot;Shine2&quot;, &quot;Shine3&quot;, &quot;Shine4&quot;, &quot;Shine5&quot;, &quot;Shine6&quot;, &quot;Shine7&quot;, &quot;Shine8&quot;, &quot;Shine9&quot;, &quot;Shine10&quot;}
function Click()

if not Debounce then return end
Debounce = false
if script.Parent.Value.Value == 1 then
script.Parent.Parent.Holder.Visible = true
script.Parent.Text = &quot;Regen Cars&quot;
script.Parent.Value.Value = 0
for i = 1,#Table do
script.Parent.Parent[Table[i]].Visible = true
end
Debounce = true
elseif script.Parent.Value.Value == 0 then --Closed 
script.Parent.Parent.Holder.Visible = false
script.Parent.Text = &quot;Regen Cars&quot;
script.Parent.Value.Value = 1 
for i = 1,#Table do
script.Parent.Parent[Table[i]].Visible = false
end
Debounce = true
end
end

