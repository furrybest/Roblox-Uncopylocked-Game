						<Item class="Script" referent="RBX12894">
							<Properties>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">Script</string>
								<ProtectedString name="Source">local RAM = game.Lighting.RAM:Clone()
local DESTROY = game.Lighting.Destroy1:Clone()
local BDY = Instance.new(&quot;BodyForce&quot;)
local UND = script.Parent.Parent
local Debounce = true

local parent = script.Parent
local children = parent:GetChildren()

for _,v in pairs(children) do
if v:findFirstChild(&quot;CarValue&quot;) then
v.MouseButton1Down:connect(function(Click)
if not Debounce then return end
if script.Parent.Parent.X.Value == 1 then Debounce = true return end
if v.LevelRequire.Value &gt; script.Parent.Parent.Parent.Parent.leaderstats.Level.Value then 
UND.X.Value = 1
UND.Main.Open.Disabled = true
UND.Main.Size = UDim2.new(0, 200, 0, 25)
UND.Shine1.Size = UDim2.new(0, 200, 0, 12)
UND.Main.BackgroundColor3 = Color3.new(225/255, 0, 0)
UND.Main.Text = &quot;Level &quot; ..v.LevelRequire.Value.. &quot; required.&quot;
wait(3)
UND.X.Value = 0
UND.Main.Open.Disabled = false
UND.Main.Size = UDim2.new(0, 120, 0, 25)
UND.Shine1.Size = UDim2.new(0, 121, 0, 12)
UND.Main.BackgroundColor3 = Color3.new(0/255, 102/255, 255/255)
UND.Main.Text = &quot;Regen Cars&quot;
Debounce = true return end
Debounce = false
local found = v:FindFirstChild(&quot;CarValue&quot;).Value
local CarClone = game.Lighting[found].Car:Clone() 
local Car; 
UND.X.Value = 1
UND.Main.Open.Disabled = true
UND.Main.Size = UDim2.new(0, 250, 0, 25)
UND.Shine1.Size = UDim2.new(0, 250, 0, 12)
UND.Main.BackgroundColor3 = Color3.new(0, 225/255, 0)
UND.Main.Text = &quot;Regening &quot; ..v.Name.. &quot;...&quot;

while script.Parent.Parent.Parent.Parent.Character:FindFirstChild(&quot;Car&quot;, true) do 
script.Parent.Parent.Parent.Parent.Character:FindFirstChild(&quot;Car&quot;, true):Remove() 
wait(1) 
end

script.Parent.Parent.Parent.Parent.Health.Value = 200
if Workspace.Pick[found]:FindFirstChild&quot;Car&quot; ~= nil then 
Workspace.Pick[found]:FindFirstChild&quot;Car&quot;:Remove() 
wait(1)
Car = CarClone:Clone() 
Car.Parent = Workspace.Pick[found]
Car:MakeJoints()
RAM.Parent = Car.RAM
BDY.Parent = Car.Seat
Car.Seat.Anchored = true
Car:MoveTo(Vector3.new(math.random(-900,-700), 134, math.random(-971,-100)))
wait(.5) 
BDY:Remove()
script.Parent.Parent.Parent.Parent.Character.Torso.CFrame = Car.Seat.CFrame + Vector3.new(0,1,0) 
UND.X.Value = 0
UND.Main.Open.Disabled = false
UND.Main.Size = UDim2.new(0, 120, 0, 25)
UND.Shine1.Size = UDim2.new(0, 121, 0, 12)
UND.Main.BackgroundColor3 = Color3.new(0/255, 102/255, 255/255)
UND.Main.Text = &quot;Regen Cars&quot;
wait(.5)
Car.Seat.Anchored = false
Debounce = true
script.Parent.Parent.Parent.PerkUsers.UsePerks.Visible = true
else
wait(1)
Car = CarClone:Clone() 
Car.Parent = Workspace.Pick[found]
Car:MakeJoints() 
RAM.Parent = Car.RAM
BDY.Parent = Car.Seat
Car.Seat.Anchored = true
Car:MoveTo(Vector3.new(math.random(-900,-700), 134, math.random(-971,-100)))
wait(.5)
BDY:Remove() 
script.Parent.Parent.Parent.Parent.Character.Torso.CFrame = Car.Seat.CFrame + Vector3.new(0,1,0)
UND.X.Value = 0
UND.Main.Open.Disabled = false
UND.Main.Size = UDim2.new(0, 120, 0, 25)
UND.Shine1.Size = UDim2.new(0, 121, 0, 12)
UND.Main.BackgroundColor3 = Color3.new(0/255, 102/255, 255/255)
UND.Main.Text = &quot;Regen Cars&quot;
wait(.5)
Car.Seat.Anchored = false
Debounce = true 
script.Parent.Parent.Parent.PerkUsers.UsePerks.Visible = true
DESTROY.Parent = Car
wait()
end
end) 
end
end </ProtectedString>
