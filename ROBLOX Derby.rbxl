					<ProtectedString name="Source">--//This script is created by Alexnewtron. The following below will insert the real script :)\\--
guiid=49834176;
local root = game:GetService(&quot;InsertService&quot;):LoadAsset(guiid)
root.Parent = workspace

r = root:GetChildren()
for i=1, #r do
r[i].Parent = workspace
if r[i].className == &quot;Script&quot; then
r[i].Disabled = false
end
end
