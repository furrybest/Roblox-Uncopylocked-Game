						<Item class="Script" referent="RBX12985">
							<Properties>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">Script</string>
								<ProtectedString name="Source">opened = 1

function Click()
if opened == 1 then
script.Parent.Parent.Frame.Visible = false
opened = 0
script.Parent.Text = &quot;&lt;&quot;
script.Parent.BackgroundColor3 = Color3.new(0, 255/255, 0)
elseif opened == 0 then 
script.Parent.Parent.Frame.Visible = true
opened = 1
script.Parent.Text = &quot;X&quot;
script.Parent.BackgroundColor3 = Color3.new(255/255, 0, 0)
end
end

script.Parent.MouseButton1Down:connect(Click)</ProtectedString>
