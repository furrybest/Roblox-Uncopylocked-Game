								<ProtectedString name="Source">opened = 0

function Click()
if opened == 0 then
script.Parent.Parent.Frame.Visible = true
script.Parent.Text = &quot;&gt;CLOSE&lt;&quot;
opened = 1
elseif opened == 1 then 
script.Parent.Parent.Frame.Visible = false
script.Parent.Text = &quot;&gt;RBD VERSIONS&lt;&quot;
opened = 0
end
end

