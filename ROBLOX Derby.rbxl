				<Item class="Script" referent="RBX2089">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Destroy1</string>
						<ProtectedString name="Source">Kid = game.Players:GetPlayerFromCharacter(script.Parent.Parent)

repeat wait(1) until Kid.Health.Value &lt;= 0
script.Parent:BreakJoints()
if script.Parent.Seat ~=nil then
Exp = Instance.new(&quot;Explosion&quot;)
Exp.BlastRadius = 5
Exp.BlastPressure = 0
Exp.Parent = script.Parent.Seat
end
wait(2)
Kid.Character.Torso.CFrame = workspace.Replace.CFrame +Vector3.new(0,2,0)
Kid.Health.Value = 200
script.Parent:Remove()</ProtectedString>
					</Properties>
				</Item>
				<Item class="Script" referent="RBX2090">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">RAM</string>
						<ProtectedString name="Source">Sound = Instance.new(&quot;Sound&quot;)
Sound.SoundId = &quot;http://www.roblox.com/asset/?id=31173799&quot;
Sound.Pitch = 0.3
Sound.Looped = false
Value1 = Instance.new(&quot;BoolValue&quot;)
Value1.Name = &quot;HasHit&quot;

done = true
function Touched(HitConnection)
if HitConnection:FindFirstChild(&quot;HasHit&quot;) ~= nil then return end
if script.Parent.Parent.Parent:FindFirstChild(&quot;Humanoid&quot;) == nil then return end
if not done then return end
done = false
if HitConnection.Name == &quot;Seat&quot; then
HitConnection:Remove()
end
if HitConnection.Name ~= &quot;Part&quot; then done = true
return end
Value1.Parent = HitConnection
Explosion = Instance.new(&quot;Explosion&quot;)
Explosion.Parent = HitConnection
Explosion.BlastRadius = 2 
Explosion.BlastPressure = 0
Explosion.Position = HitConnection.Position
Sound.Parent = HitConnection
Sound:Play()
HitPlayer = game.Players:GetPlayerFromCharacter(HitConnection.Parent.Parent.Parent)
PTS = game.Players:GetPlayerFromCharacter(script.Parent.Parent.Parent)
if PTS == nil then return end
if HitConnection:FindFirstChild(&quot;Burning&quot;) ~= nil then done = true
return end
if HitConnection.Parent.Parent:FindFirstChild(&quot;Seat&quot;) ~= nil then
if script.Parent.Parent.Parent:FindFirstChild(&quot;Shirt Graphic&quot;) == nil or script.Parent.Parent.Parent:FindFirstChild(&quot;Shirt Graphic&quot;).Graphic ~= &quot;http://www.roblox.com/asset/?id=36115609&quot;then
PTS.leaderstats.Points.Value = PTS.leaderstats.Points.Value +1
PTS.TestPoints.Value = PTS.TestPoints.Value +1
elseif script.Parent.Parent.Parent:FindFirstChild(&quot;Shirt Graphic&quot;).Graphic == &quot;http://www.roblox.com/asset/?id=36115609&quot; or PTS.TeamColor == BrickColor.new(&quot;Bright red&quot;)then
PTS.leaderstats.Points.Value = PTS.leaderstats.Points.Value +2
PTS.TestPoints.Value = PTS.TestPoints.Value +2
end
else
PTS.leaderstats.Points.Value = PTS.leaderstats.Points.Value +5
PTS.TestPoints.Value = PTS.TestPoints.Value +5
end
wait()
done = true
HitConnection:BreakJoints()
wait(1.5) HitConnection:Remove()
end

script.Parent.Touched:connect(Touched)</ProtectedString>
					</Properties>
				</Item>
