								<string name="Name">Script</string>
								<ProtectedString name="Source">info = script.Parent[&quot;Info&quot;]

function ME(GUI)
info.Visible = true
end

script.Parent.MouseEnter:connect(ME)

function MExit(GUI)
info.Visible = false
end

script.Parent.MouseLeave:connect(MExit)
</ProtectedString>
