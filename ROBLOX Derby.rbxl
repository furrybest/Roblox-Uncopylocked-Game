				<Item class="Script" referent="RBX368">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">BonusRoundScript</string>
						<ProtectedString name="Source">Time = 600

while true do
--~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
--Countdown:

&#9;&#9;for i = Time, 1, -1 do
&#9;&#9;wait(1)
&#9;&#9;game.Workspace.Hint.Text = &quot;&quot; ..i.. &quot; Seconds left until the next bonus round! Keep DERBYING!&quot;
&#9;&#9;end

--_____________________________________________________________________________________________________




--~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
--Picking the bonus round:
&#9;&#9;local Selection = game.Lighting.BonusRound
      local S = Selection:GetChildren()
&#9;&#9;local SNUM = #S
&#9;&#9;GameNum = math.random(1,SNUM)
&#9;&#9;currentGame = S[GameNum] 
&#9;&#9;CGame = currentGame:clone() 

&#9;&#9;CGame.Parent = workspace 
&#9;&#9;CGame:MakeJoints() 
&#9;&#9;
&#9;&#9;game.Workspace.Hint.Text = &quot;Bonus Round chosen: &quot; ..CGame.Name.. &quot;&quot;
&#9;&#9;wait(3)
&#9;&#9;game.Workspace.Message1.Text = &quot;&quot;..CGame.Description.Value..&quot;&quot;
&#9;&#9;wait(5)
&#9;&#9;game.Workspace.Message1.Text = &quot;&quot;
--_____________________________________________________________________________________________________




--~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
--Checking the Bonus Round has finished:

&#9;&#9;repeat wait(2) until
&#9;&#9;CGame.Complete.Value == true
&#9;&#9;Workspace.Music:Stop()
&#9;&#9;CGame:Remove()
&#9;&#9;game.Workspace.Hint.Text = &quot;Bonus round is over!&quot;
&#9;&#9;wait(3)
&#9;&#9;game.Workspace.Hint.Text = &quot;Well done to all players!&quot;
&#9;&#9;wait(3)
&#9;&#9;end

--_____________________________________________________________________________________________________</ProtectedString>
					</Properties>
				</Item>
				<Item class="Script" referent="RBX369">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Points</string>
						<ProtectedString name="Source">game.Players.PlayerAdded:connect(function(Player) 
local Leaderstats = Instance.new(&quot;IntValue&quot;) 
Leaderstats.Name = &quot;leaderstats&quot; 
Leaderstats.Parent = Player 

local Points = Instance.new(&quot;IntValue&quot;, Player) 
Points.Name = &quot;TestPoints&quot; 
Points.Value = 0

local Health = Instance.new(&quot;IntValue&quot;, Player) 
Health.Name = &quot;Health&quot; 
Health.Value = 200

local GamePoints = Instance.new(&quot;IntValue&quot;, Leaderstats) 
GamePoints.Name = &quot;Points&quot; 
GamePoints.Value = 0

local Speed = Instance.new(&quot;IntValue&quot;, Player) 
Speed.Name = &quot;Speed&quot; 
Speed.Value = 0

local Turn = Instance.new(&quot;IntValue&quot;, Player) 
Turn.Name = &quot;Turn&quot; 
Turn.Value = 0

local Torque = Instance.new(&quot;IntValue&quot;, Player) 
Torque.Name = &quot;Torque&quot; 
Torque.Value = 0

local Level = Instance.new(&quot;IntValue&quot;, Leaderstats) 
Level.Name = &quot;Level&quot; 
Level.Value = 1 

wait(1)
    Player:WaitForDataReady()
    Player.TestPoints.Value = Player:LoadNumber(&quot;TestPoints-RBD&quot;)
    Player.leaderstats.Points.Value = Player:LoadNumber(&quot;Points-RBD&quot;)
    Player.leaderstats.Level.Value = Player:LoadNumber(&quot;Level-RBD&quot;)
&#9; Player.Speed.Value = Player:LoadNumber(&quot;Speed-RBD&quot;)
&#9; Player.Turn.Value = Player:LoadNumber(&quot;Turn-RBD&quot;)
&#9; Player.Torque.Value = Player:LoadNumber(&quot;Torque-RBD&quot;)

wait(.5)
&#9; if Player.leaderstats.Level.Value &lt;= 0 then
&#9; Player.leaderstats.Level.Value = Player.leaderstats.Level.Value +1
&#9;end


local OneHundred = 100
local RealPoints = 0
local OldPoints = Player.TestPoints.Value 
Player.TestPoints.Changed:connect(function(Val) 
RealPoints = RealPoints + (Val - OldPoints) 
OldPoints = Val 
Player.PlayerGui.PerkUsers.PTS.Text = &quot;Points until next level: &quot; ..OneHundred-RealPoints.. &quot;&quot;
if RealPoints &gt;= 100 then 
RealPoints = RealPoints - 100 
Level.Value = Level.Value + 1 
end 
end) 
end)</ProtectedString>
