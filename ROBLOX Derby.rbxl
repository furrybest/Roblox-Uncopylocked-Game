								<ProtectedString name="Source">d = true
script.Parent.MouseButton1Click:connect(function() 
if not d then return end
d = false

Plyrr = script.Parent.Parent.Parent.Parent
    Plyrr:WaitForDataReady()
    Plyrr:SaveNumber(&quot;TestPoints-RBD&quot;, Plyrr.TestPoints.Value)
    Plyrr:SaveNumber(&quot;Points-RBD&quot;, Plyrr.leaderstats.Points.Value)
    Plyrr:SaveNumber(&quot;Level-RBD&quot;, Plyrr.leaderstats.Level.Value)
    Plyrr:SaveNumber(&quot;Speed-RBD&quot;, Plyrr.Speed.Value)
    Plyrr:SaveNumber(&quot;Turn-RBD&quot;, Plyrr.Turn.Value)
    Plyrr:SaveNumber(&quot;Torque-RBD&quot;, Plyrr.Torque.Value)

script.Parent.Saved.Visible = true
wait(2)
script.Parent.Saved.Visible = false
d = true
end)</ProtectedString>
