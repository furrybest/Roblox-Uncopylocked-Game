						<Item class="Script" referent="RBX12964">
							<Properties>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">Teleport</string>
								<ProtectedString name="Source">done = true 
DefineCar = script.Parent.Parent.Parent.Parent.Character

function Click() 
if not done then return end
done = false
if DefineCar:FindFirstChild(&quot;Car&quot;) ~= nil then
while DefineCar:findFirstChild(&quot;Car&quot;, true) do 
DefineCar:findFirstChild(&quot;Car&quot;, true):remove() 
wait(.5) 
end
end
wait(1)
script.Parent.Parent.Parent.Parent.Character.Torso.CFrame = Workspace.Replace.CFrame +Vector3.new(0,2,0)
wait(5)
done = true
end

script.Parent.MouseButton1Click:connect(Click)</ProtectedString>
