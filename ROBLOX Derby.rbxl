&#9;wait(5)
&#9;Crates = game.Lighting.Part
&#9;Fall = Crates:Clone()
&#9;Fall.Parent = script.Parent.Parent
&#9;Fall.Position = script.Parent.Position + Vector3.new(math.random(-script.Parent.Size.x/2, script.Parent.Size.x/2), math.random(0,10), math.random(-script.Parent.Size.z/2,script.Parent.Size.z/2))
&#9;Fall.Velocity = Vector3.new(math.random(-50,50),math.random(-50,50),math.random(-50,50))
&#9;script.Parent.Parent.Value.Value = script.Parent.Parent.Value.Value +1
&#9;end

</ProtectedString>
								</Properties>
							</Item>
						</Item>
						<Item class="Script" referent="RBX4738">
							<Properties>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">Clean</string>
								<ProtectedString name="Source">script.Parent.Value.Changed:connect(function (Touch)
if script.Parent.Value.Value == 200 then
while script.Parent:findFirstChild(&quot;Crate&quot;, true) do 
script.Parent:findFirstChild(&quot;Crate&quot;, true):remove() 
wait(.2) 
end
script.Parent.Value.Value = 0
end
end)</ProtectedString>
