								<ProtectedString name="Source">local CFramey = Instance.new(&quot;Part&quot;)
CFramey.Transparency = 1
CFramey.CanCollide = false
CFramey.Anchored = true
debounce = true
function BoardC(GUI) 
local player = script.Parent.Parent.Parent.Parent
&#9;&#9;if player.Character ~= nil and debounce == true then
&#9;&#9;&#9;debounce = false
&#9;&#9;&#9;local board = player.Character:findFirstChild(&quot;Car&quot;)
&#9;&#9;&#9;if board ~= nil then 
&#9;&#9;&#9;if board.Seat:FindFirstChild(&quot;BodyVelocity&quot;) ~= nil then debounce = true return end
&#9;&#9;&#9;&#9;CFramey.Position = board.Seat.Position
&#9;&#9;&#9;&#9;local bp = Instance.new(&quot;BodyPosition&quot;)
&#9;&#9;&#9;&#9;bp.maxForce = Vector3.new(400000000000,400000000000,400000000000)
&#9;&#9;&#9;&#9;bp.position = board:findFirstChild(&quot;Seat&quot;).Position + Vector3.new(0,5,0)
&#9;&#9;&#9;&#9;bp.Parent = board.Seat 
&#9;&#9;&#9;&#9;local bg = Instance.new(&quot;BodyGyro&quot;)
&#9;&#9;&#9;&#9;bg.maxTorque = Vector3.new(4e+009, 0, 4e+009)
&#9;&#9;&#9;&#9;bg.cframe = CFramey.CFrame
&#9;&#9;&#9;&#9;bg.Parent = board.Seat 
&#9;&#9;&#9;&#9;bp.maxForce = Vector3.new(5400,800000000000,5400) 
&#9;&#9;&#9;&#9;wait(2)
&#9;&#9;&#9;&#9;bg.maxTorque = Vector3.new(0,0,0)
&#9;&#9;&#9;&#9;bp:remove()
&#9;&#9;&#9;&#9;wait(0.5)
&#9;&#9;&#9;&#9;bg:remove()
&#9;&#9;&#9;&#9;wait(5)
&#9;&#9;&#9;&#9;debounce = true
&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;debounce = true
&#9;&#9;&#9;end
&#9;&#9;else
&#9;&#9;&#9;debounce = true
&#9;&#9;end

end

script.Parent.MouseButton1Click:connect(BoardC)

</ProtectedString>
							</Properties>
						</Item>
