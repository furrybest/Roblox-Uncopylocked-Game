								<string name="Name">Script</string>
								<ProtectedString name="Source">Kid = script.Parent.Parent.Parent.Parent

function Click()
if Kid.Character:findFirstChild(&quot;Car&quot;) ==nil then return end
Kid.Character:findFirstChild(&quot;Car&quot;).Seat.MaxSpeed = Kid.Character:findFirstChild(&quot;Car&quot;).Seat.MaxSpeed +Kid.Speed.Value
Kid.Character:findFirstChild(&quot;Car&quot;).Seat.TurnSpeed = Kid.Character:findFirstChild(&quot;Car&quot;).Seat.TurnSpeed +Kid.Turn.Value
Kid.Character:findFirstChild(&quot;Car&quot;).Seat.Torque = Kid.Character:findFirstChild(&quot;Car&quot;).Seat.Torque +Kid.Torque.Value

script.Parent.Visible = false
end

script.Parent.MouseButton1Down:connect(Click)</ProtectedString>
