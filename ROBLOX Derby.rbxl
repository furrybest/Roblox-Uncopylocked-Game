							<Item class="Script" referent="RBX8108">
								<Properties>
									<bool name="Disabled">false</bool>
									<Content name="LinkedSource"><null></null></Content>
									<string name="Name">Premium</string>
									<ProtectedString name="Source">Speed = script.Parent.MaxSpeed
Turn = script.Parent.TurnSpeed
Tor = script.Parent.Torque
Kid = game.Players:GetPlayerFromCharacter(script.Parent.Parent.Parent)
function onTouched(part)
if part.Parent:FindFirstChild(&quot;Humanoid&quot;) == nil then return end
Car = script.Parent.Parent
Car.Parent = part.Parent
if script.Parent.Parent.Parent:FindFirstChild(&quot;Shirt Graphic&quot;) == nil or script.Parent.Parent.Parent:FindFirstChild(&quot;Shirt Graphic&quot;).Graphic ~= &quot;http://www.roblox.com/asset/?id=36115609&quot; then
script.Parent.MaxSpeed = Speed
script.Parent.TurnSpeed = Turn
script.Parent.Torque = Tor
elseif part.Parent:FindFirstChild(&quot;Shirt Graphic&quot;).Graphic == &quot;http://www.roblox.com/asset/?id=36115609&quot; or Kid.TeamColor == BrickColor.new(&quot;Bright red&quot;) then
script.Parent.MaxSpeed = script.Parent.MaxSpeed +10
script.Parent.TurnSpeed = script.Parent.TurnSpeed +5
script.Parent.Torque = script.Parent.Torque +2
end
end

script.Parent.Touched:connect(onTouched)</ProtectedString>
								</Properties>
							</Item>
						</Item>
					</Item>
				</Item>
