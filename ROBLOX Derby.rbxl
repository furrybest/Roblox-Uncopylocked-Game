							<Item class="Script" referent="RBX13115">
								<Properties>
									<bool name="Disabled">false</bool>
									<Content name="LinkedSource"><null></null></Content>
									<string name="Name">Script</string>
									<ProtectedString name="Source">--[[MARIOSTAR6464&apos;s next-gen music loader]]
wait(2)
Kid = script.Parent.Parent.Parent.Parent.Parent
if Kid:FindFirstChild(&quot;Seen&quot;, true) then script.Parent.Parent.Parent:Remove() end
Music = Instance.new(&quot;Sound&quot;)
Music.Parent = Kid
Music.SoundId = &quot;http://www.roblox.com/asset/?id=27697735&quot;
Music:Play()
Music:Stop()
wait()
Music.SoundId = &quot;http://www.roblox.com/asset/?id=11420933&quot;
Music:Play()
Music:Stop()
wait()
Music.SoundId = &quot;http://www.roblox.com/asset/?id=8610025&quot;
Music:Play()
Music:Stop()
wait()
Music.SoundId = &quot;http://www.roblox.com/asset/?id=27697298&quot;
Music:Play()
Music:Stop()
wait()
Music:Remove()
repeat
wait(.03)
script.Parent.Load.Value = script.Parent.Load.Value + 1
script.Parent.Parent.LoadBar.Size = script.Parent.Parent.LoadBar.Size +UDim2.new(0,2,0,0)
script.Parent.Text = &quot;&quot;..script.Parent.Load.Value.. &quot;% Loaded&quot; until
script.Parent.Load.Value == 100
script.Parent.Parent.LoadBar.Size = script.Parent.Parent.LoadBar.Size -UDim2.new(0,1,0,0)
g = script.Parent.Parent:GetChildren()
for i = 1,#g do
if g[i]:IsA(&quot;ImageLabel&quot;) then
g[i].BackgroundTransparency = 1
elseif g[i]:IsA(&quot;TextLabel&quot;) then
g[i].BackgroundTransparency = 1
g[i].TextTransparency = 1
wait()
end
end
wait(1)
val = Instance.new(&quot;IntValue&quot;)
val.Name = &quot;Seen&quot;
val.Parent = Kid
script.Parent.Parent.Parent.BG.Visible = false 
script.Parent.Parent.Visible = false </ProtectedString>
								</Properties>
