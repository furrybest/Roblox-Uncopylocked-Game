								<string name="Name">Script</string>
								<ProtectedString name="Source">Time = 300

&#9;&#9;Workspace.Music.SoundId = &quot;http://www.roblox.com/asset/?id=27697298&quot;
&#9;&#9;Workspace.Music:Play()
--~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

&#9;&#9;for i = Time, 1, -1 do
&#9;&#9;wait(1)
&#9;&#9;game.Workspace.Hint.Text = &quot;&quot; ..i.. &quot; Seconds left until &quot; ..script.Parent.Name.. &quot; Ends!&quot;
&#9;&#9;end

--_____________________________________________________________________________________________________

