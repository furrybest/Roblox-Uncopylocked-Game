						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">PlayerHasEnteredMainScript</string>
						<ProtectedString name="Source">function PlayerEnterNew(ply)
if ply == nil then return end
plyget = ply
if plyget:IsInGroup(171508) then
plyget.TeamColor = BrickColor.new(&quot;Bright red&quot;)
wait(1)
end
end

game.Players.ChildAdded:connect(PlayerEnterNew)</ProtectedString>
