					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Relist</string>
						<ProtectedString name="Source">game.Players.PlayerAdded:connect(function(p)
p.CharacterAdded:connect(function(c)
local Kid = p
local PerkDetails = Kid.PlayerGui.PerkDetails
PerkDetails.Frame.Speed.Text = &quot;Speed: &quot; ..Kid.Speed.Value.. &quot;&quot;
PerkDetails.Frame.Turn.Text = &quot;Turn: &quot; ..Kid.Turn.Value.. &quot;&quot;
PerkDetails.Frame.Torque.Text = &quot;Troque: &quot; ..Kid.Torque.Value.. &quot;&quot;
wait(1)
end)
end)
</ProtectedString>
					</Properties>
