&#9;local headWeld = Instance.new(&quot;Weld&quot;, head)
&#9;headWeld.Name = &quot;Head Weld&quot;
&#9;headWeld.Part0 = head
&#9;headWeld.Part1 = newHead
&#9;local newTorso = Instance.new(&quot;Part&quot;, character)
