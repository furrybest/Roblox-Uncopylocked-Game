&#9;&#9;rightHip.C0 = CFrame.new(1.3, -0.1, 0.1) * CFrame.Angles(0, math.rad(45), math.rad(-20))
&#9;&#9;local leftHip = torso[&quot;Left Hip&quot;]
&#9;&#9;leftHip.C0 = rightHip.C0 * CFrame.new(0, 0, -2) * CFrame.Angles(0, math.rad(180), 0)
&#9;&#9;rest.CanCollide = true
