&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;if (distance &lt; range) and (humanoid.Health &gt; 0) then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;_G.updateFeed(player.Name..&quot; captured &quot;..script.Parent.Name, player.TeamColor.Color)
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;_G.updateExperience(player, 150, &quot;You captured &quot;..script.Parent.Name)
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;else
&#9;&#9;&#9;flag.Transparency = 0.5
&#9;&#9;end
