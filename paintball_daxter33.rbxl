local firing = false
local bulletSpeed = 100
local bulletDrop = 15

_G.shooterSelected = (function(mouse)
&#9;mouse.Icon = &quot;http://www.roblox.com/asset/?id=15324984&quot;
&#9;mouse.Button1Down:connect(function()
&#9;&#9;clicked(mouse)
&#9;end)
