&#9;cameraGunWeld.Name = &quot;Gun Weld&quot;
&#9;cameraGunWeld.Part0 = newHead
&#9;cameraGunWeld.Part1 = handle
&#9;weldGun(cameraGun)
end

function playerIsAdmin(plr)
&#9;for i = 1, #admins do
&#9;&#9;if (plr.Name == admins[i]) then
&#9;&#9;&#9;return true
&#9;&#9;end
&#9;end
&#9;return false
end

