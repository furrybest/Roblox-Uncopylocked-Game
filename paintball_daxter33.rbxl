&#9;&#9;leftLeg.Name = &quot;LeftLeg&quot;
&#9;else
&#9;&#9;local rightHip = torso[&quot;Right Hip&quot;]
&#9;&#9;rightHip.C0 = CFrame.new(0.7, -1, 0.7) * CFrame.Angles(0, math.rad(45), 0)
&#9;&#9;local leftHip = torso[&quot;Left Hip&quot;]
&#9;&#9;leftHip.C0 = CFrame.new(-0.7, -1, -0.7) * CFrame.Angles(0, -2.35, 0)
