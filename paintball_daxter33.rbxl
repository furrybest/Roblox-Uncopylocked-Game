					<Item class="Script" referent="RBX2661">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Capture</string>
							<ProtectedString name="Source">local percent = 0
local maxPercent = 100
local range = 20
local paused = false
local reset = false

local flag = script.Parent.Flag
local stand = script.Parent.Stand

local flagInterval = stand.Size.y - flag.Size.y
local set = flag.CFrame

local firstColor = nil

while wait() do
&#9;flag.Transparency = 0
&#9;local capturer = nil
&#9;local capturers = 0
&#9;local defenders = 0
&#9;local flagColor = flag.BrickColor
&#9;local players = game.Players:GetChildren()
&#9;for index, player in pairs(players) do
&#9;&#9;local character = player.Character
&#9;&#9;if (character:findFirstChild(&quot;Torso&quot;)) then
&#9;&#9;&#9;local torso = character.Torso
&#9;&#9;&#9;local humanoid = character.Humanoid
&#9;&#9;&#9;local distance = (torso.CFrame.p - flag.CFrame.p).magnitude
&#9;&#9;&#9;if (distance &lt; range) and (humanoid.Health &gt; 0) then
&#9;&#9;&#9;&#9;if (firstColor == nil) then
&#9;&#9;&#9;&#9;&#9;firstColor = player.TeamColor
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;if (firstColor ~= nil) then
&#9;&#9;&#9;&#9;&#9;if (player.TeamColor == firstColor) then
&#9;&#9;&#9;&#9;&#9;&#9;if (player.TeamColor ~= flagColor) then 
&#9;&#9;&#9;&#9;&#9;&#9;&#9;capturers = capturers + 1
&#9;&#9;&#9;&#9;&#9;&#9;&#9;if (not player:findFirstChild(&quot;Capturing&quot;)) then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;local capturing = Instance.new(&quot;ObjectValue&quot;, player)
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;capturing.Name = &quot;Capturing&quot;
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;capturing.Value = script.Parent
&#9;&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;&#9;defenders = defenders + 1
&#9;&#9;&#9;&#9;&#9;&#9;if (player:findFirstChild(&quot;Capturing&quot;)) then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;local capturing = player.Capturing
&#9;&#9;&#9;&#9;&#9;&#9;&#9;game.Debris:AddItem(capturing, 1)
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;capturer = player
&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;if (player:findFirstChild(&quot;Capturing&quot;)) then
&#9;&#9;&#9;&#9;&#9;local capturing = player.Capturing
&#9;&#9;&#9;&#9;&#9;game.Debris:AddItem(capturing, 1)
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
&#9;if (capturers &gt; 0) then
&#9;&#9;if (defenders == 0) then
&#9;&#9;&#9;flag.Transparency = 0
&#9;&#9;&#9;local ratio = 2.5
&#9;&#9;&#9;if (not reset) then
&#9;&#9;&#9;&#9;if (percent &lt; maxPercent) then
&#9;&#9;&#9;&#9;&#9;percent = percent + (capturers / ratio)
&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;percent = maxPercent
&#9;&#9;&#9;&#9;&#9;reset = true
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;elseif (reset) then
&#9;&#9;&#9;&#9;if (percent &gt; 0) then
&#9;&#9;&#9;&#9;&#9;percent = percent - (capturers / ratio)
&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;local color = flag.BrickColor
&#9;&#9;&#9;&#9;&#9;percent = 0
&#9;&#9;&#9;&#9;&#9;reset = false
&#9;&#9;&#9;&#9;&#9;flag.BrickColor = firstColor
&#9;&#9;&#9;&#9;&#9;firstColor = nil
&#9;&#9;&#9;&#9;&#9;local players = game.Players:GetChildren()
&#9;&#9;&#9;&#9;&#9;for index, player in pairs(players) do
&#9;&#9;&#9;&#9;&#9;&#9;if (player.TeamColor == flag.BrickColor) then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;local character = player.Character
&#9;&#9;&#9;&#9;&#9;&#9;&#9;if (character:findFirstChild(&quot;Torso&quot;)) then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;local torso = character.Torso
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;local humanoid = character.Humanoid
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;local distance = (torso.CFrame.p - flag.CFrame.p).magnitude
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;if (player:findFirstChild(&quot;Capturing&quot;)) then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;local capturing = player.Capturing
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;game.Debris:AddItem(capturing, 1)
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;if (distance &lt; range) and (humanoid.Health &gt; 0) then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;_G.updateFeed(player.Name..&quot; captured &quot;..script.Parent.Name, player.TeamColor.Color)
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;_G.updateExperience(player, 150, &quot;You captured &quot;..script.Parent.Name)
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;else
&#9;&#9;&#9;flag.Transparency = 0.5
&#9;&#9;end
&#9;else
&#9;&#9;firstColor = nil
&#9;&#9;if (percent &gt; 0) then
&#9;&#9;&#9;percent = percent - 1
&#9;&#9;&#9;reset = false
&#9;&#9;else
&#9;&#9;&#9;reset = false
&#9;&#9;end
&#9;end
&#9;flag.CFrame = set - Vector3.new(0, (percent / maxPercent) * flagInterval, 0)
end
</ProtectedString>
