&#9;&#9;rightLeg.Name = &quot;Right Leg&quot;
&#9;&#9;leftLeg.Name = &quot;Left Leg&quot;
&#9;end
end

function doProne()
&#9;local rest = character.Rest
&#9;local torsoWeld = torso[&quot;Torso Weld&quot;]
&#9;local restWeld = torso[&quot;Rest Weld&quot;]
&#9;restWeld.C0 = CFrame.new(0, 0, 0)
&#9;torsoWeld.C0 = CFrame.new(0, 0, 0) * CFrame.Angles(0, math.rad(-45), 0)
&#9;local neck = torso.Neck
&#9;if (prone) then
&#9;&#9;torsoWeld.C0 = CFrame.new(0, 0.5, 0) * CFrame.Angles(math.rad(-90), 0, 0)
&#9;&#9;local rightHip = torso[&quot;Right Hip&quot;]
