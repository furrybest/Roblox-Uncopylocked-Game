			<Item class="LocalScript" referent="RBX516">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Raycast</string>
					<ProtectedString name="Source">_G.castRay = (function(start, target, ignore)
&#9;local dir = (target - start).unit
&#9;local ray = Ray.new(start, dir.unit * 999)
&#9;local hit, endPos = workspace:FindPartOnRay(ray, ignore)
&#9;return hit, endPos
end)</ProtectedString>
				</Properties>
			</Item>
			<Item class="LocalScript" referent="RBX517">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">KillCam</string>
					<ProtectedString name="Source">local player = game.Players.LocalPlayer
local character = player.Character
local humanoid = character.Humanoid
local camera = workspace.CurrentCamera

humanoid.Died:connect(function()
&#9;wait(0.1)
&#9;camera.FieldOfView = 60
&#9;if (workspace:findFirstChild(player.Name..&quot;&apos;s Path&quot;)) then
&#9;&#9;workspace[player.Name..&quot;&apos;s Path&quot;]:remove()
&#9;end
&#9;local killer = player.Killer.Value
&#9;if (killer ~=  nil) then
&#9;&#9;if (killer.Character:findFirstChild(&quot;Torso&quot;)) then
&#9;&#9;&#9;local killerHumanoid = killer.Character.Humanoid
&#9;&#9;&#9;camera.CameraSubject = killerHumanoid
&#9;&#9;end
&#9;end
&#9;player.Killer.Value = nil
end)</ProtectedString>
				</Properties>
			</Item>
			<Item class="LocalScript" referent="RBX518">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Animator</string>
					<ProtectedString name="Source">local camera = workspace.CurrentCamera
local player = game.Players.LocalPlayer
local character = player.Character
local head = character.Head
local torso = character.Torso
local formed = false
local neckOrigin = 0
local pathWalk = false
local prone = false
local crouch = false
local sprint = false
local sighted = false
local sighting = false
local sprinting = false
local throwing = false
local throw = true
local rightLeg = nil
local leftLeg = nil

local path = Instance.new(&quot;Part&quot;)
path.Anchored = true
path.Size = Vector3.new(4, 1, 8)
path.BrickColor = BrickColor.new(&quot;Really red&quot;)
path.TopSurface = &quot;Smooth&quot;
path.BottomSurface = &quot;Smooth&quot;
path.Name = player.Name..&quot;&apos;s Path&quot;

local admins = {&quot;daxter33&quot;, &quot;Shredder&quot;, &quot;Player&quot;}

_G.sighted = false

function animateSelected(mouse)
&#9;if (not formed) then
&#9;&#9;formed = true
&#9;&#9;formCharacter()
&#9;&#9;coroutine.resume(coroutine.create(function()
&#9;&#9;&#9;while wait(0.1) do
&#9;&#9;&#9;&#9;getLimbs()
&#9;&#9;&#9;&#9;getWalkSpeeds()
&#9;&#9;&#9;&#9;getFirstPerson()
&#9;&#9;&#9;&#9;getWeldDirection(mouse)
&#9;&#9;&#9;&#9;if (pathWalk) then
&#9;&#9;&#9;&#9;&#9;local torso = character.Torso
&#9;&#9;&#9;&#9;&#9;path.CFrame = torso.CFrame - Vector3.new(0, 3, 0)
&#9;&#9;&#9;&#9;&#9;path.CFrame = CFrame.new(path.CFrame.p, path.CFrame.p + camera.CoordinateFrame.lookVector)
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end))
&#9;end
end

_G.animateKeyPressed = (function(key)
&#9;local newHead = character[&quot;New Head&quot;]
&#9;local headWeld = head[&quot;Head Weld&quot;]
&#9;local gunWeld = newHead[&quot;Gun Weld&quot;]
&#9;if (key == &quot;p&quot;) then
&#9;&#9;local playerGui = player.PlayerGui
&#9;&#9;local hud = playerGui.HUD
&#9;&#9;local menu = hud.Menu
&#9;&#9;local info = menu.Info
&#9;&#9;menu.Visible = not menu.Visible
&#9;&#9;info.Text = &quot;&quot;
&#9;elseif (key == &quot;q&quot;) then
&#9;&#9;if (not sighting) and (not throwing) then
&#9;&#9;&#9;enterSights(gunWeld)
&#9;&#9;end
&#9;elseif (key == &quot;f&quot;) then
&#9;&#9;if (throw) then
&#9;&#9;&#9;throw = false
&#9;&#9;&#9;if (not sighting) and (not throwing) then
&#9;&#9;&#9;&#9;if (_G.sighted) then
&#9;&#9;&#9;&#9;&#9;enterSights(gunWeld)
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;throwGrenade(gunWeld)
&#9;&#9;&#9;end
&#9;&#9;&#9;delay(1, (function() throw = true end))
&#9;&#9;end
&#9;elseif (key == &quot;c&quot;) then
&#9;&#9;prone = false
&#9;&#9;crouch = not crouch
&#9;&#9;doCrouch()
&#9;elseif (key == &quot;x&quot;) then
&#9;&#9;crouch = false
&#9;&#9;prone = not prone
&#9;&#9;doProne()
&#9;elseif (key == &quot;e&quot;) then
&#9;&#9;if (playerIsAdmin(player)) then
&#9;&#9;&#9;pathWalk = not pathWalk
&#9;&#9;&#9;path.Parent = (pathWalk) and workspace or nil
&#9;&#9;end
&#9;end
end)

function getLimbs()
&#9;local limbs = character:GetChildren()
&#9;for index, object in pairs(limbs) do
&#9;&#9;if (object.Name == &quot;Right Leg&quot;) or (object.Name == &quot;RightLeg&quot;) then
&#9;&#9;&#9;rightLeg = object
&#9;&#9;elseif (object.Name == &quot;Left Leg&quot;) or (object.Name == &quot;LeftLeg&quot;) then
&#9;&#9;&#9;leftLeg = object
&#9;&#9;end
&#9;end
end

function getWeldDirection(mouse)
&#9;local newHead = character[&quot;New Head&quot;]
&#9;local headWeld = head[&quot;Head Weld&quot;]
&#9;local gunWeld = newHead[&quot;Gun Weld&quot;]
&#9;if (not _G.sighted) then
&#9;&#9;if (not sighting) and (not throwing) then
&#9;&#9;&#9;camera.FieldOfView = 60
&#9;&#9;&#9;gunWeld.C0 = CFrame.new(0.75, -0.75, -0.75) * CFrame.Angles(math.rad(90), 0, 0)
&#9;&#9;end
&#9;&#9;mouse.Icon = &quot;http://www.roblox.com/asset/?id=15324984&quot;
&#9;else
&#9;&#9;if (not sighting) and (not throwing) then
&#9;&#9;&#9;camera.FieldOfView = 40
&#9;&#9;&#9;gunWeld.C0 = CFrame.new(0.14, -0.425, -1) * CFrame.Angles(math.rad(88), 0, 0)
&#9;&#9;end
&#9;&#9;mouse.Icon = &quot;http://www.roblox.com/asset/?id=22416261&quot;
&#9;end
&#9;local target = camera.CoordinateFrame * CFrame.new(0, 0, -100)
&#9;headWeld.C0 = CFrame.new(0, 0, 0)
&#9;headWeld.C1 = (CFrame.new(head.CFrame.p, target.p) - head.CFrame.p):inverse() * (head.CFrame - head.Position)
end
&#9;

function getFirstPerson()
&#9;local playerGui = player.PlayerGui
&#9;local gui = playerGui.ScreenGui
&#9;local hud = playerGui.HUD
&#9;local menu = hud.Menu
&#9;local blocker = gui.Blocker
&#9;local limbTransparency = 0
&#9;local distance = (camera.Focus.p - camera.CoordinateFrame.p).magnitude
&#9;if (distance &gt; 1) then
&#9;&#9;if (not menu.Visible) then
&#9;&#9;&#9;blocker.Visible = true
&#9;&#9;&#9;limbTransparency = 0
&#9;&#9;else
&#9;&#9;&#9;blocker.Visible = false
&#9;&#9;&#9;limbTransparency = 1
&#9;&#9;end
&#9;else
&#9;&#9;blocker.Visible = false
&#9;&#9;limbTransparency = 0
&#9;end
&#9;local limbs = camera:GetChildren()
&#9;for index, limb in pairs(limbs) do
&#9;&#9;if (limb.className == &quot;Part&quot;) then
&#9;&#9;&#9;limb.Transparency = limbTransparency
&#9;&#9;end
&#9;end
end

function getWalkSpeeds()
&#9;local humanoid = character.Humanoid
&#9;if (not sprint) then
&#9;&#9;if (crouch) then
&#9;&#9;&#9;humanoid.WalkSpeed = 8
&#9;&#9;else
&#9;&#9;&#9;if (prone) then
&#9;&#9;&#9;&#9;humanoid.WalkSpeed = 2
&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;humanoid.WalkSpeed = 16
&#9;&#9;&#9;end
&#9;&#9;end
&#9;else
&#9;&#9;humanoid.WalkSpeed = 24
&#9;end
end

function enterSights(gunWeld)
&#9;_G.sighted = not _G.sighted
&#9;sighting = true&#9;local time = 0.5
&#9;local intervals = 10
&#9;local startPos = gunWeld.C0
&#9;local startZoom = 0
&#9;local endPos = nil
&#9;local endZoom = 0
&#9;if (not _G.sighted) then
&#9;&#9;endPos = CFrame.new(0.75, -0.75, -0.75) * CFrame.Angles(math.rad(90), 0, 0)
&#9;&#9;startZoom = 40
&#9;&#9;endZoom = 60
&#9;else
&#9;&#9;endPos = CFrame.new(0.15, -0.425, -1) * CFrame.Angles(math.rad(88), 0, 0)
&#9;&#9;startZoom = 60
&#9;&#9;endZoom = 40
&#9;end
&#9;local dir = (endPos.p - startPos.p).unit / intervals
&#9;for i = 1, intervals - 3 do
&#9;&#9;wait(time / intervals)
&#9;&#9;gunWeld.C0 = startPos + (dir * i)
&#9;&#9;camera.FieldOfView = startZoom + ((endZoom - startZoom) / intervals) * i
&#9;end
&#9;sighting = false
end

function throwGrenade(gunWeld)
&#9;throwing = true
&#9;local time = 0.1
&#9;local intervals = 10
&#9;local downOffset = 1.5
&#9;local tilt = math.rad(-60)
&#9;local arm = camera[&quot;Left Arm&quot;]
&#9;local armWeld = gunWeld.Part1[&quot;Left Arm Weld&quot;]
&#9;local armWeldPos = armWeld.C0
&#9;for i = 1, downOffset * intervals do
&#9;&#9;wait(time / intervals)
&#9;&#9;gunWeld.C0 = gunWeld.C0 - Vector3.new(0, downOffset / intervals, 0)
&#9;&#9;gunWeld.C0 = gunWeld.C0 * CFrame.Angles(tilt / intervals, 0, 0)
&#9;end
&#9;local grenade = Instance.new(&quot;Part&quot;, camera)
&#9;grenade.CanCollide = false
&#9;grenade.Shape = &quot;Ball&quot;
&#9;grenade.BrickColor = player.TeamColor
&#9;grenade.Size = Vector3.new(1, 1, 1)
&#9;local mesh = Instance.new(&quot;SpecialMesh&quot;, grenade)
&#9;mesh.MeshType = &quot;Sphere&quot;
&#9;mesh.Scale = Vector3.new(0.5, 0.5, 0.5)
&#9;local grenadeWeld = Instance.new(&quot;Weld&quot;, arm)
&#9;grenadeWeld.Part0 = arm
&#9;grenadeWeld.Part1 = grenade
&#9;grenadeWeld.C0 = CFrame.new(0, -1.5, 0)
&#9;local upOffset = 1.55
&#9;local forwardOffset = 0.15
&#9;local time = 0.1
&#9;armWeld.C0 = armWeld.C0 * CFrame.Angles(0, 0, math.rad(270))
&#9;for i = 1, upOffset * intervals do
&#9;&#9;wait(time / intervals)
&#9;&#9;armWeld.C0 = armWeld.C0 + Vector3.new(0, upOffset / intervals, -forwardOffset / intervals)
&#9;end
&#9;local rotation = math.rad(70)
&#9;local intervals = 5
&#9;local forwardOffset = 1.5
&#9;local leftOffset = 1.25
&#9;local time = 0.1
&#9;for i = 1, rotation * intervals do
&#9;&#9;wait(time / intervals)
&#9;&#9;armWeld.C0 = armWeld.C0 * CFrame.Angles(0, rotation / intervals, 0)
&#9;&#9;armWeld.C0 = armWeld.C0 + Vector3.new(0, 0, -forwardOffset / intervals)
&#9;&#9;armWeld.C0 = armWeld.C0 - Vector3.new(leftOffset / intervals, 0, 0)
&#9;end&#9;
&#9;local velocity = 100
&#9;local fuseTime = 1.5
&#9;local startPos = grenade.CFrame.p
&#9;local endPos = (camera.CoordinateFrame * CFrame.new(0, 0, -100)).p
&#9;local direction = (endPos - startPos).unit
&#9;grenade.Parent = workspace
&#9;grenadeWeld:remove()
&#9;grenade.CanCollide = true
&#9;grenade.Velocity = direction * velocity
&#9;armWeld.C0 = armWeldPos
&#9;delay(fuseTime, (function() explodeGrenade(grenade) end))
&#9;throwing = false
end

function explodeGrenade(grenade)
&#9;local blastSize = 10
&#9;local position = grenade.Position
&#9;grenade:remove()
&#9;local blast = Instance.new(&quot;Part&quot;, workspace.Bullets)
&#9;blast.BottomSurface = &quot;Smooth&quot;
&#9;blast.TopSurface = &quot;Smooth&quot;
&#9;blast.BrickColor = player.TeamColor
&#9;blast.Size = Vector3.new(blastSize, blastSize, blastSize)
&#9;blast.Anchored = true
&#9;blast.CanCollide = false
&#9;blast.Shape = &quot;Ball&quot;
&#9;local mesh = Instance.new(&quot;SpecialMesh&quot;, blast)
&#9;mesh.MeshType = &quot;Sphere&quot;
&#9;mesh.Scale = Vector3.new(1, 1, 1)
&#9;blast.CFrame = CFrame.new(position)
&#9;game.Debris:AddItem(blast, 1)
&#9;coroutine.resume(coroutine.create(function()
&#9;&#9;for i = 1, 10 do
