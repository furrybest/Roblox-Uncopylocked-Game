					<string name="Name">Bullet</string>
					<ProtectedString name="Source">function checkDamage(object, position, color, damage, weapon)
&#9;if (weapon ~= &quot;Grenade Launcher&quot;) then
&#9;&#9;local playerHit = false
&#9;&#9;local players = game.Players:GetChildren()
&#9;&#9;for index, player in pairs(players) do
&#9;&#9;&#9;if (player.Character ~= nil) then
&#9;&#9;&#9;&#9;if (object:isDescendantOf(player.Character)) then
&#9;&#9;&#9;&#9;&#9;playerHit = true
&#9;&#9;&#9;&#9;&#9;local self = game.Players.LocalPlayer
&#9;&#9;&#9;&#9;&#9;if (player ~= self) and (player.TeamColor ~= self.TeamColor) then
&#9;&#9;&#9;&#9;&#9;&#9;local creator = Instance.new(&quot;ObjectValue&quot;)
&#9;&#9;&#9;&#9;&#9;&#9;creator.Name = &quot;creator&quot;
&#9;&#9;&#9;&#9;&#9;&#9;creator.Value = self
&#9;&#9;&#9;&#9;&#9;&#9;creator.Parent = player.Character.Humanoid
&#9;&#9;&#9;&#9;&#9;&#9;player.Character.Humanoid:TakeDamage(damage)
&#9;&#9;&#9;&#9;&#9;&#9;local marker = game.Lighting.Guis[&quot;Hit Marker&quot;]:clone()
&#9;&#9;&#9;&#9;&#9;&#9;local gui = self.PlayerGui.ScreenGui
&#9;&#9;&#9;&#9;&#9;&#9;marker.Parent = gui
&#9;&#9;&#9;&#9;&#9;&#9;game.Debris:AddItem(marker, 1)
&#9;&#9;&#9;&#9;&#9;&#9;if (player.Character.Humanoid.Health &lt;= 0) then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;player.Killer.Value = self
&#9;&#9;&#9;&#9;&#9;&#9;&#9;player.Killed.Value = weapon
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;if (not playerHit) then
&#9;&#9;&#9;local splat = Instance.new(&quot;Part&quot;, workspace.Bullets)
&#9;&#9;&#9;splat.BrickColor = color
&#9;&#9;&#9;splat.Anchored = true
&#9;&#9;&#9;splat.CanCollide = false
&#9;&#9;&#9;splat.Shape = &quot;Ball&quot;
&#9;&#9;&#9;splat.Size = Vector3.new(1, 1, 1)
&#9;&#9;&#9;splat.CFrame = CFrame.new(position)
&#9;&#9;&#9;local mesh = Instance.new(&quot;SpecialMesh&quot;, splat)
&#9;&#9;&#9;mesh.MeshType = &quot;Sphere&quot;
&#9;&#9;&#9;mesh.Scale = Vector3.new(0.5, 0.5, 0.5)
&#9;&#9;&#9;game.Debris:AddItem(splat, 1)
&#9;&#9;end
&#9;end
end

function explodeGrenade(position, damage, blastSize)
&#9;local player = game.Players.LocalPlayer
&#9;local blast = Instance.new(&quot;Part&quot;, workspace.Bullets)
&#9;blast.BottomSurface = &quot;Smooth&quot;
&#9;blast.TopSurface = &quot;Smooth&quot;
&#9;blast.BrickColor = player.TeamColor
&#9;blast.Size = Vector3.new(blastSize, blastSize, blastSize)
&#9;blast.Anchored = true
&#9;blast.CanCollide = false
&#9;blast.Shape = &quot;Ball&quot;
&#9;local mesh = Instance.new(&quot;SpecialMesh&quot;, blast)
&#9;mesh.MeshType = &quot;Sphere&quot;
&#9;mesh.Scale = Vector3.new(1, 1, 1)
&#9;blast.CFrame = CFrame.new(position)
&#9;game.Debris:AddItem(blast, 1)
&#9;coroutine.resume(coroutine.create(function()
&#9;&#9;for i = 1, 10 do
&#9;&#9;&#9;wait(0.1)
&#9;&#9;&#9;blast.Transparency = blast.Transparency + 0.1
&#9;&#9;&#9;mesh.Scale = mesh.Scale + Vector3.new(0.2, 0.2, 0.2)
&#9;&#9;end
&#9;end))
&#9;local players = game.Players:GetChildren()
&#9;for index, enemy in pairs(players) do
&#9;&#9;if (enemy.TeamColor ~= player.TeamColor) then
&#9;&#9;&#9;if (enemy.Character:findFirstChild(&quot;Torso&quot;)) then
&#9;&#9;&#9;&#9;local endPos = enemy.Character.Torso.CFrame.p
&#9;&#9;&#9;&#9;local distance = (endPos - position).magnitude
&#9;&#9;&#9;&#9;if (distance &lt; blastSize) then
&#9;&#9;&#9;&#9;&#9;local hit, endPos = _G.castRay(position, endPos, workspace.Bullets)
&#9;&#9;&#9;&#9;&#9;if (hit ~= nil) then
&#9;&#9;&#9;&#9;&#9;&#9;if (hit:isDescendantOf(enemy.Character)) then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;local creator = Instance.new(&quot;ObjectValue&quot;)
&#9;&#9;&#9;&#9;&#9;&#9;&#9;creator.Name = &quot;creator&quot;
&#9;&#9;&#9;&#9;&#9;&#9;&#9;creator.Value = self
&#9;&#9;&#9;&#9;&#9;&#9;&#9;creator.Parent = player.Character.Humanoid
&#9;&#9;&#9;&#9;&#9;&#9;&#9;enemy.Character.Humanoid:TakeDamage(damage)
&#9;&#9;&#9;&#9;&#9;&#9;&#9;local marker = game.Lighting.Guis[&quot;Hit Marker&quot;]:clone()
&#9;&#9;&#9;&#9;&#9;&#9;&#9;local gui = player.PlayerGui.ScreenGui
&#9;&#9;&#9;&#9;&#9;&#9;&#9;marker.Parent = gui
&#9;&#9;&#9;&#9;&#9;&#9;&#9;game.Debris:AddItem(marker, 1)
&#9;&#9;&#9;&#9;&#9;&#9;&#9;if (enemy.Character.Humanoid.Health &lt;= 0) then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;enemy.Killer.Value = player
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;enemy.Killed.Value = &quot;Grenade Launcher&quot;
&#9;&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end

function projectile(weapon, start, target, damage, speed, drop, color, ignore)
&#9;local collide = nil
&#9;local collidePos = nil
&#9;local ratio = 10
&#9;local dir = (target - start).unit
&#9;local hit, endPos = _G.castRay(start, target, ignore)
&#9;local distance = (endPos - start).magnitude
&#9;local bulletDrop = (drop / ratio) / 250
&#9;local length = speed / ratio
&#9;local prevPosition = start
&#9;local bullet = Instance.new(&quot;Part&quot;, ignore)
&#9;bullet.BrickColor = color
&#9;bullet.formFactor = &quot;Custom&quot;
&#9;bullet.Anchored = true
&#9;bullet.CanCollide = false
&#9;bullet.CFrame = CFrame.new(start, endPos)
&#9;game.Debris:AddItem(bullet, 5)
&#9;if (distance &gt; length) then
&#9;&#9;while true do
&#9;&#9;&#9;local bulletFront = (bullet.CFrame * CFrame.new(0, 0, -1)).p - Vector3.new(0, bulletDrop, 0)
&#9;&#9;&#9;local dir = (bulletFront - bullet.CFrame.p).unit
&#9;&#9;&#9;local position = prevPosition + (dir * length)
&#9;&#9;&#9;local hit, endPos = _G.castRay(bullet.CFrame.p, bulletFront, ignore)
&#9;&#9;&#9;local newDistance = (endPos - prevPosition).magnitude
&#9;&#9;&#9;collidePos = endPos
&#9;&#9;&#9;collide = hit
&#9;&#9;&#9;if (newDistance &lt; length) then
&#9;&#9;&#9;&#9;break
&#9;&#9;&#9;end
&#9;&#9;&#9;local bulletDistance = (position - prevPosition).magnitude
&#9;&#9;&#9;bullet.Size = Vector3.new(0.05, 0.05, 5)
&#9;&#9;&#9;bullet.CFrame = CFrame.new(prevPosition, position) * CFrame.new(0, 0, -bulletDistance / 2)
&#9;&#9;&#9;prevPosition = position
&#9;&#9;&#9;wait()
&#9;&#9;end
&#9;&#9;bullet:Remove()
&#9;else
&#9;&#9;local position = prevPosition + (dir * length)
&#9;&#9;local hit, endPos = _G.castRay(start, position, ignore)
&#9;&#9;local distance = (endPos - start).magnitude
&#9;&#9;local newDistance = (position - start).magnitude
&#9;&#9;bullet.Size = Vector3.new(0.1, 0.1, distance)
&#9;&#9;bullet.CFrame = CFrame.new(start, endPos) * CFrame.new(0, 0, -distance / 2)
&#9;&#9;game.Debris:AddItem(bullet, 0.1)
&#9;&#9;collidePos = endPos
&#9;&#9;collide = hit
&#9;end
&#9;checkDamage(collide, collidePos, color, damage, weapon)
&#9;return collidePos
end

_G.fireBullet = (function(weapon, start, target, damage, speed, drop, color, ignore)
&#9;coroutine.resume(coroutine.create(function()
&#9;&#9;projectile(weapon, start, target, damage, speed, drop, color, ignore)
&#9;end))
end)

_G.fireGrenade = (function(weapon, start, target, damage, blastSize, speed, drop, color, ignore)
&#9;local collidePos = projectile(weapon, start, target, 0, speed, drop, color, ignore)
&#9;explodeGrenade(collidePos, damage, blastSize)
end)</ProtectedString>
