			<Item class="Script" referent="RBX9">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Elimination</string>
					<ProtectedString name="Source">_G.eliminationRound = (function()
&#9;local gameEnd = false
&#9;local roundTime = 2
&#9;local redPlayers = 0
&#9;local bluePlayers = 0
&#9;for minutes = roundTime - 1, 0, -1 do
&#9;&#9;if (gameEnd) then
&#9;&#9;&#9;break
&#9;&#9;end
&#9;&#9;for seconds = 59, 0, -1 do
&#9;&#9;&#9;wait(1)
&#9;&#9;&#9;if (gameEnd) then
&#9;&#9;&#9;&#9;break
&#9;&#9;&#9;end
&#9;&#9;&#9;redPlayers = 0
&#9;&#9;&#9;bluePlayers = 0
&#9;&#9;&#9;seconds = (seconds &gt;= 10) and seconds or &quot;0&quot;..seconds
&#9;&#9;&#9;local players = game.Players:GetChildren()
&#9;&#9;&#9;for index, player in pairs(players) do
&#9;&#9;&#9;&#9;if (player.TeamColor == game.Teams.Red.TeamColor) then
&#9;&#9;&#9;&#9;&#9;redPlayers = redPlayers + 1
&#9;&#9;&#9;&#9;elseif (player.TeamColor == game.Teams.Blue.TeamColor) then
&#9;&#9;&#9;&#9;&#9;bluePlayers = bluePlayers + 1
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;&#9;for index, player in pairs(players) do
&#9;&#9;&#9;&#9;updateHUD(player, minutes..&quot;:&quot;..seconds, redPlayers, bluePlayers)
&#9;&#9;&#9;end
&#9;&#9;&#9;if (redPlayers &lt;= 0) and (bluePlayers &gt; 0) then
&#9;&#9;&#9;&#9;_G.endGame(game.Teams.Blue, &quot;Red players eliminated! Blue wins!&quot;)
&#9;&#9;&#9;&#9;gameEnd = true
&#9;&#9;&#9;elseif (bluePlayers &lt;= 0) and (redPlayers &gt; 0) then
&#9;&#9;&#9;&#9;_G.endGame(game.Teams.Red, &quot;Blue players eliminated! Red wins!&quot;)
&#9;&#9;&#9;&#9;gameEnd = true
&#9;&#9;&#9;elseif (redPlayers &lt;= 0) and (bluePlayers &lt;= 0) then
&#9;&#9;&#9;&#9;_G.endGame(nil, &quot;Both teams eliminated! It&apos;s a draw!&quot;)
&#9;&#9;&#9;&#9;gameEnd = true
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
&#9;if (not gameEnd) then
&#9;&#9;if (redPlayers &gt; bluePlayers) then
&#9;&#9;&#9;local playerWord = (redPlayers &gt; 1) and &quot;players&quot; or &quot;player&quot;
&#9;&#9;&#9;_G.endGame(game.Teams.Red, &quot;Time&apos;s up! Red wins with &quot;..redPlayers..&quot; &quot;..playerWord..&quot; alive!&quot;)
&#9;&#9;elseif (bluePlayers &gt; redPlayers) then
&#9;&#9;&#9;local playerWord = (bluePlayers &gt; 1) and &quot;players&quot; or &quot;player&quot;
&#9;&#9;&#9;_G.endGame(game.Teams.Blue, &quot;Time&apos;s up! Blue wins with &quot;..bluePlayers..&quot; &quot;..playerWord..&quot; alive!&quot;)
&#9;&#9;else
&#9;&#9;&#9;local playerWord = (redPlayers &gt; 1) and &quot;players&quot; or &quot;player&quot;
&#9;&#9;&#9;_G.endGame(nil, &quot;Time&apos;s up! It&apos;s a draw! Both teams had &quot;..redPlayers..&quot; &quot;..playerWord..&quot; alive!&quot;)
&#9;&#9;end
&#9;end
end)

function updateHUD(player, timeLeft, redStat, blueStat)
&#9;local playerGui = player.PlayerGui
&#9;local HUD = playerGui.HUD
&#9;local top = HUD.Top
&#9;local mode = top.Mode
&#9;local time = top.Time
&#9;local red = top.Red
&#9;local blue = top.Blue
&#9;top.Visible = true
&#9;mode.Text = &quot;Elimination&quot;
&#9;time.Text = timeLeft
&#9;red.Score.Text = redStat
&#9;red.Title.Text = &quot;Red players&quot;
&#9;blue.Score.Text = blueStat
&#9;blue.Title.Text = &quot;Blue players&quot;
end
&#9;</ProtectedString>
				</Properties>
			</Item>
			<Item class="Script" referent="RBX10">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Deathmatch</string>
					<ProtectedString name="Source">_G.deathmatchRound = (function()
&#9;game.Teams[&quot;Spectators&quot;].AutoAssignable = false
&#9;game.Teams.Red.AutoAssignable = true
&#9;game.Teams.Blue.AutoAssignable = true
&#9;local gameEnd = false
&#9;local roundTime = 5
&#9;local killLimit = 30
&#9;local redKills = 0
&#9;local blueKills = 0
&#9;for minutes = roundTime - 1, 0, -1 do
&#9;&#9;if (gameEnd) then
&#9;&#9;&#9;break
&#9;&#9;end
&#9;&#9;for seconds = 59, 0, -1 do
&#9;&#9;&#9;wait(1)
&#9;&#9;&#9;if (gameEnd) then
&#9;&#9;&#9;&#9;break
&#9;&#9;&#9;end
&#9;&#9;&#9;redKills = 0
&#9;&#9;&#9;blueKills = 0
&#9;&#9;&#9;seconds = (seconds &gt;= 10) and seconds or &quot;0&quot;..seconds
&#9;&#9;&#9;local players = game.Players:GetChildren()
&#9;&#9;&#9;for index, player in pairs(players) do
&#9;&#9;&#9;&#9;local kills = player.Kills.Value
&#9;&#9;&#9;&#9;if (player.TeamColor == game.Teams.Red.TeamColor) then
&#9;&#9;&#9;&#9;&#9;redKills = redKills + kills
&#9;&#9;&#9;&#9;elseif (player.TeamColor == game.Teams.Blue.TeamColor) then
&#9;&#9;&#9;&#9;&#9;blueKills = blueKills + kills
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;&#9;for index, player in pairs(players) do
&#9;&#9;&#9;&#9;updateHUD(player, minutes..&quot;:&quot;..seconds, redKills, blueKills)
&#9;&#9;&#9;end
&#9;&#9;&#9;if (redKills &gt;= killLimit) and (blueKills &lt; killLimit) then
&#9;&#9;&#9;&#9;_G.endGame(game.Teams.Red, &quot;Score limit reached! Red wins with &quot;..killLimit..&quot; kills!&quot;)
&#9;&#9;&#9;&#9;gameEnd = true
&#9;&#9;&#9;elseif (blueKills &gt;= killLimit) and (redKills &lt; killLimit) then
&#9;&#9;&#9;&#9;_G.endGame(game.Teams.Blue, &quot;Score limit reached! Blue wins with &quot;..killLimit..&quot; kills!&quot;)
&#9;&#9;&#9;&#9;gameEnd = true
&#9;&#9;&#9;elseif (blueKills &gt;= killLimit) and (redKills &gt;= killLimit) then
&#9;&#9;&#9;&#9;_G.endGame(nil, &quot;Score limit reached! It&apos;s a draw! Both teams reached &quot;..killLimit..&quot; kills!&quot;)
&#9;&#9;&#9;&#9;gameEnd = true
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
&#9;if (not gameEnd) then
&#9;&#9;if (redKills &gt; blueKills) then
&#9;&#9;&#9;local killWord = (redKills &gt; 1) and &quot;kills&quot; or &quot;kill&quot;
&#9;&#9;&#9;_G.endGame(game.Teams.Red, &quot;Time&apos;s up! Red wins with &quot;..redKills..&quot; &quot;..killWord..&quot;!&quot;)
&#9;&#9;elseif (blueKills &gt; redKills) then
&#9;&#9;&#9;local killWord = (blueKills &gt; 1) and &quot;kills&quot; or &quot;kill&quot;
&#9;&#9;&#9;_G.endGame(game.Teams.Blue, &quot;Time&apos;s up! Blue wins with &quot;..blueKills..&quot; &quot;..killWord..&quot;!&quot;)
&#9;&#9;else
&#9;&#9;&#9;local killWord = (redKills &gt; 1) and &quot;kills&quot; or &quot;kill&quot;
&#9;&#9;&#9;_G.endGame(nil, &quot;Time&apos;s up! It&apos;s a draw! Both teams had &quot;..redKills..&quot; &quot;..killWord..&quot;!&quot;)
&#9;&#9;end
&#9;end
end)

function updateHUD(player, timeLeft, redStat, blueStat)
&#9;local playerGui = player.PlayerGui
&#9;local HUD = playerGui.HUD
&#9;local top = HUD.Top
&#9;local mode = top.Mode
&#9;local time = top.Time
&#9;local red = top.Red
&#9;local blue = top.Blue
&#9;top.Visible = true
&#9;mode.Text = &quot;Deathmatch&quot;
&#9;time.Text = timeLeft
&#9;red.Score.Text = redStat
&#9;red.Title.Text = &quot;Red kills&quot;
&#9;blue.Score.Text = blueStat
&#9;blue.Title.Text = &quot;Blue kills&quot;
end
</ProtectedString>
