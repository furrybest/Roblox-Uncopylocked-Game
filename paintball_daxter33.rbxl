				<Item class="LocalScript" referent="RBX492">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Choose</string>
						<ProtectedString name="Source">local player = game.Players.LocalPlayer
local menu = script.Parent

function weaponSelected(weapon)
&#9;local class = player.Class
&#9;class.Value = weapon
&#9;menu.Visible = false
&#9;local info = menu.Info
&#9;info.Text = &quot;&quot;
end

local guis = menu:GetChildren()
for index, gui in pairs(guis) do
&#9;if (gui.className == &quot;TextButton&quot;) then
&#9;&#9;gui.MouseButton1Click:connect(function()
&#9;&#9;&#9;if (gui.Active) then
&#9;&#9;&#9;&#9;weaponSelected(gui.Name)
&#9;&#9;&#9;end
&#9;&#9;end)
&#9;&#9;gui.MouseEnter:connect(function()
&#9;&#9;&#9;if (not gui.Active) then
&#9;&#9;&#9;&#9;local info = menu.Info
&#9;&#9;&#9;&#9;info.Text = gui.Name..&quot; unlocked at rank &quot;..gui.Rank.Value
&#9;&#9;&#9;end
&#9;&#9;end)
&#9;&#9;gui.MouseLeave:connect(function()
&#9;&#9;&#9;local info = menu.Info
&#9;&#9;&#9;info.Text = &quot;&quot;
&#9;&#9;end)
&#9;end
end

while wait() do
&#9;local stats = player:findFirstChild(&quot;leaderstats&quot;)
&#9;if (stats ~= nil) then
&#9;&#9;local rank = stats.Rank
&#9;&#9;local guis = menu:GetChildren()
&#9;&#9;for index, gui in pairs(guis) do
&#9;&#9;&#9;if (gui.className == &quot;TextButton&quot;) then
&#9;&#9;&#9;&#9;local rankValue = gui.Rank
&#9;&#9;&#9;&#9;if (rank.Value &lt; rankValue.Value) then
&#9;&#9;&#9;&#9;&#9;gui.TextTransparency = 0.75
&#9;&#9;&#9;&#9;&#9;gui.AutoButtonColor = false
&#9;&#9;&#9;&#9;&#9;gui.Active = false
&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;gui.TextTransparency = 0
&#9;&#9;&#9;&#9;&#9;gui.AutoButtonColor = true
&#9;&#9;&#9;&#9;&#9;gui.Active = true
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end
</ProtectedString>
					</Properties>
