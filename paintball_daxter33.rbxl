&#9;mouse.KeyDown:connect(_G.animateKeyPressed)
end)

function clicked(mouse)
&#9;local gun = camera.Gun
&#9;if (character.Humanoid.Health &gt; 0) then
&#9;&#9;if (not fire) then
&#9;&#9;&#9;fire = true
&#9;&#9;&#9;firing = true
&#9;&#9;&#9;while (firing) do
&#9;&#9;&#9;&#9;local head = character.Head
&#9;&#9;&#9;&#9;local startPos = (gun.CFrame * CFrame.new(0, -2, 0)).p
&#9;&#9;&#9;&#9;local endPos = (camera.CoordinateFrame * CFrame.new(0, 0, -100)).p
&#9;&#9;&#9;&#9;local distance = (endPos - startPos).magnitude
&#9;&#9;&#9;&#9;local random = Vector3.new((math.random(-spread, spread) / 250) * distance, (math.random(-spread, spread) / 250) * distance, (math.random(-spread, spread) / 250) * distance)
&#9;&#9;&#9;&#9;local shot = gun.Fire
