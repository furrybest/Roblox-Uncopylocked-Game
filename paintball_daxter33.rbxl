		<Item class="Script" referent="RBX14">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Game</string>
				<ProtectedString name="Source">local gameModeNames = {&quot;Elimination&quot;, &quot;Team Swap&quot;, &quot;Deathmatch&quot;, &quot;Controller&quot;}
local descriptions = {
&#9;{
&#9;&#9;&quot;Eliminate all enemy opposition&quot;,
&#9;&#9;&quot;Last team standing wins&quot;
&#9;},
&#9;{
&#9;&#9;&quot;Kill an enemy and they will join your team&quot;,
&#9;&#9;&quot;Last team standing wins&quot;
&#9;},
&#9;{
&#9;&#9;&quot;Eliminate all enemy opposition&quot;,
&#9;&#9;&quot;Team with the most kills wins&quot;
&#9;},
&#9;{
&#9;&#9;&quot;Capture as many flags possible&quot;,
&#9;&#9;&quot;Team with most flags captured wins&quot;
&#9;}
}

local gameStarted = false
local roundType = nil
local minPlayers = 2
local maxRank = 100
local bonusPoints = 50

function playerEntered(player)
&#9;local killer = Instance.new(&quot;ObjectValue&quot;, player)
&#9;killer.Name = &quot;Killer&quot;
&#9;local killed = Instance.new(&quot;StringValue&quot;, player)
&#9;killed.Name = &quot;Killed&quot;
&#9;local kills = Instance.new(&quot;NumberValue&quot;, player)
&#9;kills.Name = &quot;Kills&quot;
&#9;local class = Instance.new(&quot;StringValue&quot;, player)
&#9;class.Name = &quot;Class&quot;
&#9;class.Value = &quot;Starter&quot;
&#9;player.Changed:connect(function(property)
&#9;&#9;if (property == &quot;Character&quot;) then
&#9;&#9;&#9;playerSpawned(player)
&#9;&#9;end
&#9;end)
&#9;player:WaitForDataReady()
&#9;local rank = player:LoadNumber(&quot;Rank&quot;)
&#9;if (rank == 0) then
&#9;&#9;player:SaveNumber(&quot;Rank&quot;, 1)
&#9;end
&#9;if (player.Name == &quot;daxter33&quot;) then
&#9;&#9;player:SaveNumber(&quot;Rank&quot;, 1337)
&#9;end
&#9;local rank = player:LoadNumber(&quot;Rank&quot;)
&#9;local exp = player:LoadNumber(&quot;Experience&quot;)
&#9;local stats = Instance.new(&quot;IntValue&quot;, player)
&#9;stats.Name = &quot;leaderstats&quot;
&#9;local rankValue = Instance.new(&quot;IntValue&quot;, stats)
&#9;rankValue.Name = &quot;Rank&quot;
&#9;rankValue.Value = rank
&#9;local expValue = Instance.new(&quot;IntValue&quot;, stats)
&#9;expValue.Name = &quot;Exp&quot;
&#9;expValue.Value = exp
end

function playerSpawned(player)
&#9;wait(1)
&#9;local character = player.Character
&#9;local humanoid = character.Humanoid
&#9;if (player.TeamColor ~= game.Teams[&quot;Spectators&quot;].TeamColor) then
&#9;&#9;teleportPlayer(player)
&#9;end
&#9;humanoid.Died:connect(function()
&#9;&#9;if (player.Killer.Value ~= nil) then
&#9;&#9;&#9;handleKills(player.Killer.Value, player)
&#9;&#9;end
&#9;&#9;if (roundType == &quot;Elimination&quot;) then
&#9;&#9;&#9;player.TeamColor = game.Teams[&quot;Spectators&quot;].TeamColor
&#9;&#9;elseif (roundType == &quot;Team Swap&quot;) then
&#9;&#9;&#9;local red = game.Teams.Red.TeamColor
&#9;&#9;&#9;local blue = game.Teams.Blue.TeamColor
&#9;&#9;&#9;if (player.TeamColor == red) then
&#9;&#9;&#9;&#9;player.TeamColor = blue
&#9;&#9;&#9;elseif (player.TeamColor == blue) then
&#9;&#9;&#9;&#9;player.TeamColor = red
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end)
end

function handleKills(killer, player)
&#9;local killed = player.Killed.Value
&#9;local kills = killer.Kills
&#9;kills.Value = kills.Value + 1
&#9;local points = 100
&#9;local text = &quot;You killed &quot;..player.Name
&#9;local feedText = killer.Name..&quot; killed &quot;..player.Name..&quot; with &quot;..killed
&#9;if (roundType == &quot;Elimination&quot;) then
&#9;&#9;points = 500
&#9;&#9;text = &quot;You eliminated &quot;..player.Name
&#9;&#9;feedText = killer.Name..&quot; eliminated &quot;..player.Name
&#9;end
&#9;local bonuses = getKillBonuses(killer, player)
&#9;_G.updateFeed(feedText, killer.TeamColor.Color)
&#9;_G.updateExperience(killer, points, text, bonuses)
end

function getKillBonuses(killer, player)
&#9;local bonuses = {}
&#9;local recentKills = 0
&#9;local objects = killer:GetChildren()
&#9;for index, object in pairs(objects) do
&#9;&#9;if (object.Name == &quot;Recent Kill&quot;) then
&#9;&#9;&#9;recentKills = recentKills + 1
&#9;&#9;end
&#9;end
&#9;local multiKillBonus = recentKills * 100
&#9;local multiKillReason = nil
&#9;if (recentKills == 1) then
&#9;&#9;multiKillReason = &quot;Double kill&quot;
&#9;elseif (recentKills == 2) then
&#9;&#9;multiKillReason = &quot;Triple kill&quot;
&#9;elseif (recentKills &gt;= 3) then
&#9;&#9;multiKillReason = &quot;Multi kill&quot;
&#9;end
&#9;local longshotBonus = 0
&#9;local longshotReason = nil
&#9;local playerChar = player.Character
&#9;local killerChar = killer.Character
&#9;local killDistance = (playerChar.Torso.Position - killerChar.Torso.Position).magnitude
&#9;if (killDistance &gt;= 150) then
&#9;&#9;longshotBonus = 100
&#9;&#9;longshotReason = &quot;Longshot&quot;
&#9;end
&#9;local avengerBonus = 0
&#9;local avengerReason = nil
&#9;if (player:findFirstChild(&quot;Recent Kill&quot;)) then
&#9;&#9;local recentKill = player[&quot;Recent Kill&quot;].Value
&#9;&#9;if (recentKill ~= nil) then
&#9;&#9;&#9;if (recentKill.TeamColor == killer.TeamColor) then
&#9;&#9;&#9;&#9;avengerBonus = 100
&#9;&#9;&#9;&#9;avengerReason = &quot;Avenging &quot;..recentKill.Name
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
&#9;local defenseBonus = 0
&#9;local defenseReason = nil
&#9;if (player:findFirstChild(&quot;Capturing&quot;)) then
&#9;&#9;defenseBonus = 100
&#9;&#9;defenseReason = &quot;Defensive kill&quot;
&#9;end
&#9;local offenseBonus = 0
&#9;local offenseReason = nil
&#9;if (killer:findFirstChild(&quot;Capturing&quot;)) then
&#9;&#9;offenseBonus = 100
&#9;&#9;offenseReason = &quot;Offensive kill&quot;
&#9;end
&#9;local recentKill = Instance.new(&quot;ObjectValue&quot;, killer)
&#9;recentKill.Name = &quot;Recent Kill&quot;
&#9;recentKill.Value = player
&#9;game.Debris:AddItem(recentKill, 2)
&#9;bonuses = {
&#9;&#9;{multiKillBonus, multiKillReason},
&#9;&#9;{longshotBonus, longshotReason},
&#9;&#9;{avengerBonus, avengerReason},
&#9;&#9;{defenseBonus, defenseReason},
&#9;&#9;{offenseBonus, offenseReason}
&#9;}
&#9;return bonuses
end&#9;
&#9;&#9;
function startGame()
&#9;gameStarted = true
&#9;local gameMap = getRandomMap()
&#9;wait(3)
&#9;local gameMode = getRandomMode()
&#9;wait(3)
&#9;local mapClone = gameMap:clone()
&#9;mapClone.Parent = workspace
&#9;mapClone.Name = &quot;Map&quot;
&#9;if (roundType ~= &quot;Controller&quot;) then
&#9;&#9;mapClone[&quot;Flag A&quot;]:remove()
&#9;&#9;mapClone[&quot;Flag B&quot;]:remove()
&#9;&#9;mapClone[&quot;Flag C&quot;]:remove()
&#9;end
&#9;organizeTeams()
&#9;gameMode()
end

_G.endGame = (function(winner, reason)
&#9;game.Teams[&quot;Spectators&quot;].AutoAssignable = true
&#9;game.Teams.Red.AutoAssignable = false
&#9;game.Teams.Blue.AutoAssignable = false
&#9;local color = nil
&#9;if (winner ~= nil) then
&#9;&#9;color = winner.TeamColor.Color
&#9;else
&#9;&#9;color = Color3.new(0, 0, 0)
&#9;end
&#9;local players = game.Players:GetChildren()
&#9;for index, player in pairs(players) do
&#9;&#9;if (player.TeamColor.Color == color) then
&#9;&#9;&#9;_G.updateExperience(player, 250, &quot;Your team won the game!&quot;)
&#9;&#9;end
&#9;end
&#9;_G.announce(reason, color, 2)
&#9;wait(1)
&#9;_G.announce(&quot;Starting new game&quot;, color, 2)
&#9;local players = game.Players:GetChildren()
&#9;for index, player in pairs(players) do
&#9;&#9;player.Killer.Value = nil
&#9;&#9;if (player.TeamColor ~= game.Teams[&quot;Spectators&quot;].TeamColor) then
&#9;&#9;&#9;player.TeamColor = game.Teams[&quot;Spectators&quot;].TeamColor
&#9;&#9;&#9;player.Character:BreakJoints()
&#9;&#9;end
&#9;&#9;player.Kills.Value = 0
&#9;end
&#9;wait(5)
&#9;_G.cleanup()
&#9;workspace.Map:remove()
&#9;wait(1)
&#9;gameStarted = false
end)

_G.announce = (function(text, color, time)
&#9;local players = game.Players:GetChildren()
&#9;for index, player in pairs(players) do
&#9;&#9;coroutine.resume(coroutine.create(function()
&#9;&#9;&#9;local playerGui = player.PlayerGui
&#9;&#9;&#9;local HUD = playerGui.HUD
&#9;&#9;&#9;local shout = HUD.Announcement
&#9;&#9;&#9;local length = string.len(text)
&#9;&#9;&#9;shout.TextColor3 = color
&#9;&#9;&#9;for i = 1, length do
&#9;&#9;&#9;&#9;wait(time / length)
&#9;&#9;&#9;&#9;local subText = string.sub(text, 1, i)
&#9;&#9;&#9;&#9;shout.Text = subText
&#9;&#9;&#9;end
&#9;&#9;&#9;wait(1)
&#9;&#9;&#9;shout.Text = &quot;&quot;
&#9;&#9;end))
&#9;end
&#9;local length = string.len(text)
&#9;for i = 1, length do
&#9;&#9;wait(time / length)
&#9;end
end)

_G.notify = (function(text, player, color, time)
&#9;local playerGui = player.PlayerGui
&#9;local Hud = playerGui.HUD
&#9;local notifyGui = Hud.Notification
&#9;coroutine.resume(coroutine.create(function()
&#9;&#9;local length = string.len(text)
&#9;&#9;notifyGui.TextColor3 = color
&#9;&#9;for i = 1, length do
&#9;&#9;&#9;wait(time / length)
&#9;&#9;&#9;local subText = string.sub(text, 1, i)
&#9;&#9;&#9;notifyGui.Text = subText
&#9;&#9;end
&#9;&#9;wait(1)
&#9;&#9;notifyGui.Text = &quot;&quot;
&#9;end))
&#9;local length = string.len(text)
&#9;for i = 1, length do
&#9;&#9;wait(time / length)
&#9;end
end)

_G.updateFeed = (function(text, color)
&#9;local maxGui = 5
&#9;local players = game.Players:GetChildren()
&#9;for index, player in pairs(players) do
&#9;&#9;local playerGui = player.PlayerGui
&#9;&#9;local hud = playerGui.HUD
&#9;&#9;local feed = hud.Feed
&#9;&#9;local guis = feed:GetChildren()
&#9;&#9;local textNum = 0
&#9;&#9;for index, gui in pairs(guis) do
&#9;&#9;&#9;if (gui.Text ~= &quot;&quot;) then
&#9;&#9;&#9;&#9;textNum = textNum + 1
&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;for index = textNum, 1, -1 do
&#9;&#9;&#9;if (index &lt; maxGui) then
&#9;&#9;&#9;&#9;feed[index + 1].Text = feed[index].Text
&#9;&#9;&#9;&#9;feed[index + 1].TextColor3 = feed[index].TextColor3
&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;feed[1].Text = text
&#9;&#9;feed[1].TextColor3 = color
&#9;end
end)&#9;

_G.updateExperience = (function(player, points, reason, bonuses)
&#9;coroutine.resume(coroutine.create(function()
&#9;&#9;local bonusID = 57951583
&#9;&#9;if (playerHasShirt(player, bonusID)) then
&#9;&#9;&#9;points = points + bonusPoints
&#9;&#9;end
&#9;&#9;displayPoints(player, points, reason)
&#9;&#9;wait(2.5)
&#9;&#9;if (bonuses ~= nil) then
&#9;&#9;&#9;for index = 1, #bonuses do
&#9;&#9;&#9;&#9;local bonusPoints = bonuses[index][1]
&#9;&#9;&#9;&#9;local bonusReason = bonuses[index][2]
&#9;&#9;&#9;&#9;if (bonusReason ~= nil) then
&#9;&#9;&#9;&#9;&#9;displayPoints(player, bonusPoints, bonusReason)
&#9;&#9;&#9;&#9;&#9;wait(2.5)
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;local rank = player:LoadNumber(&quot;Rank&quot;)
&#9;&#9;local exp = player:LoadNumber(&quot;Experience&quot;)
&#9;&#9;exp = exp + points
&#9;&#9;local expNeeded = ((rank * 2) - 1) * 300
&#9;&#9;if (exp &gt;= expNeeded) then
&#9;&#9;&#9;if (rank &lt; maxRank) then
&#9;&#9;&#9;&#9;rank = rank + 1
&#9;&#9;&#9;&#9;exp = exp - expNeeded
&#9;&#9;&#9;&#9;_G.updateFeed(player.Name..&quot; has ranked up to rank &quot;..rank, player.TeamColor.Color)
&#9;&#9;&#9;&#9;_G.notify(&quot;You have ranked up to rank &quot;..rank..&quot;!&quot;, player, Color3.new(0, 0, 0), 2)
&#9;&#9;&#9;&#9;local unlockedWeapon = nil
&#9;&#9;&#9;&#9;if (rank == 10) then
&#9;&#9;&#9;&#9;&#9;unlockedWeapon = &quot;Shotgun&quot;
&#9;&#9;&#9;&#9;elseif (rank == 20) then
&#9;&#9;&#9;&#9;&#9;unlockedWeapon = &quot;Rifle&quot;
&#9;&#9;&#9;&#9;elseif (rank == 30) then
&#9;&#9;&#9;&#9;&#9;unlockedWeapon = &quot;Burst&quot;
&#9;&#9;&#9;&#9;elseif (rank == 40) then
&#9;&#9;&#9;&#9;&#9;unlockedWeapon = &quot;Sniper&quot;
&#9;&#9;&#9;&#9;elseif (rank == 50) then
&#9;&#9;&#9;&#9;&#9;unlockedWeapon = &quot;Automatic&quot;
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;if (unlockedWeapon ~= nil) then
&#9;&#9;&#9;&#9;&#9;wait(1)
&#9;&#9;&#9;&#9;&#9;_G.notify(&quot;You have unlocked &quot;..unlockedWeapon, player, Color3.new(0, 0, 0), 2)
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;player:SaveNumber(&quot;Rank&quot;, rank)
&#9;&#9;player:SaveNumber(&quot;Experience&quot;, exp)
&#9;&#9;player.leaderstats.Rank.Value = rank
&#9;&#9;player.leaderstats.Exp.Value = exp
&#9;end))
end)

_G.cleanup = (function()
&#9;local model = workspace.Bullets
&#9;local parts = model:GetChildren()
&#9;for index, part in pairs(parts) do
&#9;&#9;if (part.className == &quot;Part&quot;) then
&#9;&#9;&#9;part:remove()
&#9;&#9;end
&#9;end
end)

function displayPoints(player, points, reason)
&#9;local gui = game.Lighting.Guis.Points:clone()
&#9;local playerGui = player.PlayerGui
&#9;local hud = playerGui.HUD
&#9;gui.Text = &quot;+&quot;..points..&quot; Exp!&quot;
&#9;gui.Exp.Value = points
&#9;gui.TextColor3 = player.TeamColor.Color
&#9;gui.Reason.Text = reason
&#9;gui.Reason.TextColor3 = gui.TextColor3
&#9;if (hud:findFirstChild(&quot;Points&quot;)) then
&#9;&#9;gui:remove()
&#9;&#9;local pointsGui = hud.Points
&#9;&#9;pointsGui.Exp.Value = pointsGui.Exp.Value + points
&#9;&#9;pointsGui.Text = &quot;+&quot;..pointsGui.Exp.Value..&quot; Exp!&quot;
&#9;&#9;pointsGui.Reason.Text = reason
&#9;&#9;pointsGui.Time.Value = 2
&#9;else
&#9;&#9;gui.Parent = hud
&#9;&#9;gui.Time.Value = 2
&#9;&#9;coroutine.resume(coroutine.create(function()
&#9;&#9;&#9;repeat wait(0.1)
&#9;&#9;&#9;&#9;gui.Time.Value = gui.Time.Value - 0.1
&#9;&#9;&#9;until (gui.Time.Value &lt;= 0)
&#9;&#9;&#9;gui:remove()
&#9;&#9;end))
&#9;end
end

function teleportPlayer(player)
&#9;local shieldDuration = 5
&#9;local character = player.Character
&#9;local spawn = getRandomSpawn(player.TeamColor)
&#9;local torso = character.Torso
&#9;torso.CFrame = spawn.CFrame + Vector3.new(0, 2, 0)
&#9;local shield = Instance.new(&quot;ForceField&quot;, character)&#9;
&#9;game.Debris:AddItem(shield, shieldDuration)
&#9;local backpack = player.Backpack
&#9;local class = player.Class.Value
&#9;local gun = game.Lighting.Guns.Tools[class]
&#9;local gunHopperbin = gun.Gun:clone()
&#9;gunHopperbin.Parent = backpack
&#9;local playerScripts = game.Lighting.Scripts:GetChildren()
&#9;for index, object in pairs(playerScripts) do
&#9;&#9;object:clone().Parent = backpack
&#9;end
end

function getRandomMode()
&#9;local gameModes = {_G.eliminationRound, _G.teamSwapRound, _G.deathmatchRound, _G.controllerRound}
&#9;local randomSlot = math.random(1, #gameModes)
&#9;local randomMode = gameModes[randomSlot]
&#9;roundType = gameModeNames[randomSlot]
&#9;_G.announce(&quot;Round chosen: &quot;..gameModeNames[randomSlot], Color3.new(0, 0, 0), 2)
&#9;wait(1)
&#9;local description = descriptions[randomSlot]
&#9;for index, text in pairs(description) do
&#9;&#9;_G.announce(text, Color3.new(0, 0, 0), 2)
&#9;&#9;wait(1)
&#9;end
&#9;return randomMode
end

function getRandomMap()
&#9;local gameMaps = game.Lighting.Maps:GetChildren()
&#9;local randomMap = gameMaps[math.random(1, #gameMaps)]
&#9;_G.announce(&quot;Map chosen: &quot;..randomMap.Name, Color3.new(0, 0, 0), 2)
&#9;return randomMap
end

function getRandomSpawn(teamColor)
&#9;if (workspace:findFirstChild(&quot;Map&quot;)) then
&#9;&#9;local spawns = {}
&#9;&#9;if (teamColor == game.Teams.Red.TeamColor) then
&#9;&#9;&#9;spawns = workspace.Map.Red:GetChildren()
&#9;&#9;else
&#9;&#9;&#9;spawns = workspace.Map.Blue:GetChildren()
&#9;&#9;end
&#9;&#9;local spawn = spawns[math.random(1, #spawns)]
&#9;&#9;return spawn
&#9;end
&#9;return nil
end

function playerHasShirt(player, shirtID)
&#9;local badgeService = game:GetService(&quot;BadgeService&quot;)
&#9;if (badgeService:UserHasBadge(player.userId, shirtID)) then
&#9;&#9;return true
&#9;else
&#9;&#9;return false
&#9;end
end

function organizeTeams()
&#9;local teamNum = 1
&#9;repeat wait()&#9;&#9;
&#9;&#9;local spectators = {}
&#9;&#9;local teams = {&quot;Red&quot;, &quot;Blue&quot;}
&#9;&#9;local players = game.Players:GetChildren()
&#9;&#9;for index, player in pairs(players) do
&#9;&#9;&#9;if (player.TeamColor == game.Teams[&quot;Spectators&quot;].TeamColor) then
&#9;&#9;&#9;&#9;if (player.Character:findFirstChild(&quot;Torso&quot;)) then
&#9;&#9;&#9;&#9;&#9;table.insert(spectators, player)
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;local randomPlayer = spectators[math.random(1, #spectators)]
&#9;&#9;randomPlayer.TeamColor = game.Teams[teams[teamNum]].TeamColor
&#9;&#9;teleportPlayer(randomPlayer)
&#9;&#9;local spectatorNum = 0
&#9;&#9;local players = game.Players:GetChildren()
&#9;&#9;for index, player in pairs(players) do
&#9;&#9;&#9;if (player.TeamColor == game.Teams[&quot;Spectators&quot;].TeamColor) then
&#9;&#9;&#9;&#9;if (player.Character:findFirstChild(&quot;Torso&quot;)) then
&#9;&#9;&#9;&#9;&#9;spectatorNum = spectatorNum + 1
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;teamNum = (teamNum == 1) and 2 or 1
&#9;until (spectatorNum == 0)
end

workspace.ChildAdded:connect(function(child)
&#9;if (child.className == &quot;Script&quot;) or (child.className == &quot;LocalScript&quot;) then
&#9;&#9;child:remove()
&#9;end
end)

game.Players.ChildAdded:connect(playerEntered)

workspace.Showcase:remove()

while wait(1) do
&#9;local numPlayers = game.Players.NumPlayers
&#9;if (numPlayers &gt;= minPlayers) then
&#9;&#9;if (not gameStarted) then
&#9;&#9;&#9;startGame()
&#9;&#9;end
&#9;else
&#9;&#9;local difference = minPlayers - numPlayers
&#9;&#9;local playerWord = (difference &gt; 1) and &quot;players&quot; or &quot;player&quot;
&#9;&#9;_G.announce(&quot;Waiting for &quot;..difference..&quot; more &quot;..playerWord, Color3.new(0, 0, 0), 2)
&#9;end
end
