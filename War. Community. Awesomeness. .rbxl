					</Properties>
				</Item>
			</Item>
			<Item class="Tool" referent="RBX1162">
				<Properties>
					<int name="ActivationState">0</int>
					<int name="BackendToolState">2</int>
					<bool name="Enabled">true</bool>
					<CoordinateFrame name="Grip">
						<X>-0.75</X>
						<Y>-0.5</Y>
						<Z>0.100000001</Z>
						<R00>0</R00>
						<R01>0</R01>
						<R02>1</R02>
						<R10>0</R10>
						<R11>1</R11>
						<R12>-0</R12>
						<R20>-1</R20>
						<R21>0</R21>
						<R22>-0</R22>
					</CoordinateFrame>
					<string name="Name">Multiple</string>
					<Content name="TextureId"><null></null></Content>
