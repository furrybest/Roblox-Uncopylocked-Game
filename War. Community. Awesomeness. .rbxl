							<string name="Name">SlingshotSound</string>
							<int name="PlayCount">75</int>
							<bool name="PlayOnRemove">false</bool>
							<Content name="SoundId"><url>rbxasset://sounds\\Rubber band sling shot.wav</url></Content>
