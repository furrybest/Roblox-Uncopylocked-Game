						<string name="Name">BrickCleanup</string>
						<string name="Source">-- this script removes its parent from the workspace after 24 seconds&#13;&#10;&#13;&#10;wait(120)&#13;&#10;script.Parent.Parent = nil&#13;&#10;</string>
						<bool name="archivable">true</bool>
					</Properties>
