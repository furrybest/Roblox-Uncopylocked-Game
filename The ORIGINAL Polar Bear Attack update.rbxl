					<string name="Source">running=false&#13;&#10;while true do&#13;&#10;&#9;if (running==true) then&#13;&#10;&#9;&#9;wait(math.random()/2)&#13;&#10;&#9;&#9;local fire = script.Parent.Fire:children()&#13;&#10;&#9;&#9;for i = 1, #fire do&#13;&#10;&#9;&#9;&#9;fire[i].Transparency = math.random()&#13;&#10;&#9;&#9;end&#13;&#10;&#9;else&#13;&#10;&#9;&#9;wait(1)&#13;&#10;&#9;end&#13;&#10;end&#13;&#10;&#13;&#10;wait=false&#13;&#10;function onTouched(part)&#13;&#10;&#9;local h = part.Parent:findFirstChild(&quot;Humanoid&quot;)&#13;&#10;&#9;if (h~=nil and wait==false) then&#13;&#10;&#9;&#9;wait=true&#13;&#10;&#9;&#9;if (running==true) then&#13;&#10;&#9;&#9;&#9;running=false&#13;&#10;&#9;&#9;&#9;local fire = script.Parent.Fire:children()&#13;&#10;&#9;&#9;&#9;for i = 1, #fire do&#13;&#10;&#9;&#9;&#9;&#9;fire[i].Transparency = 1&#13;&#10;&#9;&#9;&#9;end&#13;&#10;&#9;&#9;else&#13;&#10;&#9;&#9;&#9;running=true&#13;&#10;&#9;&#9;end&#13;&#10;&#9;&#9;delay(3)&#13;&#10;&#9;&#9;wait=false&#13;&#10;&#9;end&#13;&#10;end&#13;&#10;script.Parent.On.Touched:connect(onTouched)&#13;&#10;</string>
					<bool name="archivable">true</bool>
				</Properties>
