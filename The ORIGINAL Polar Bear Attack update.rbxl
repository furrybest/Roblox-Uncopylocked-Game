			<Item class="Script" referent="RBX3037">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">BulletConductor</string>
					<string name="Source">print(&quot;RobloxPolice&apos;s BULLET Train Started!&quot;)&#13;&#10;&#13;&#10;part=script.Parent&#13;&#10;&#13;&#10;eng1=part.Engine1.BodyVelocity&#13;&#10;eng2=part.Engine2.BodyVelocity&#13;&#10;eng3=part.Engine3.BodyVelocity&#13;&#10;eng4=part.Engine4.BodyVelocity&#13;&#10;&#13;&#10;start=part.StartSw&#13;&#10;stop=part.StopSw&#13;&#10;trans=part.TransSw&#13;&#10;engr=part.EngnrSw&#13;&#10;doors=part.DoorSw&#13;&#10;&#13;&#10;spdlt=part.SpeedLt&#13;&#10;trnlt=part.TransLt&#13;&#10;&#13;&#10;engrDr=part.EgnrDr&#13;&#10;Door1=part.Door1&#13;&#10;Door2=part.Door2&#13;&#10;&#13;&#10;spd=0&#13;&#10;maxspd=75&#13;&#10;func=0&#13;&#10;direct=1&#13;&#10;&#13;&#10;engrpos=0&#13;&#10;doorpos=0&#13;&#10;&#13;&#10;transfunc=0&#13;&#10;engrfunc=0&#13;&#10;doorfunc=0&#13;&#10;&#13;&#10;function SetSpeed(vel)&#13;&#10;&#9;eng1.velocity=Vector3.new(-vel,0,0)&#13;&#10;&#9;eng2.velocity=Vector3.new(-vel,0,0)&#13;&#10;&#9;eng3.velocity=Vector3.new(-vel,0,0)&#13;&#10;&#9;eng4.velocity=Vector3.new(-vel,0,0)&#13;&#10;end&#13;&#10;&#13;&#10;function StartUp()&#13;&#10;&#9;while (spd&lt;maxspd) do&#13;&#10;&#9;&#9;wait(.1)&#13;&#10;&#9;&#9;spd=spd+10&#13;&#10;&#9;&#9;SetSpeed(spd)&#13;&#10;&#9;end&#13;&#10;&#9;SetSpeed(maxspd)&#13;&#10;end&#13;&#10;&#13;&#10;function StartUpRev()&#13;&#10;&#9;while (spd&gt;-maxspd) do&#13;&#10;&#9;&#9;wait(.1)&#13;&#10;&#9;&#9;spd=spd-10&#13;&#10;&#9;&#9;SetSpeed(spd)&#13;&#10;&#9;end&#13;&#10;&#9;SetSpeed(-maxspd)&#13;&#10;end&#13;&#10;&#13;&#10;function SlowDown()&#13;&#10;&#9;while (spd&gt;0) do&#13;&#10;&#9;&#9;wait(.1)&#13;&#10;&#9;&#9;spd=spd-10&#13;&#10;&#9;&#9;SetSpeed(spd)&#13;&#10;&#9;end&#13;&#10;&#9;SetSpeed(0)&#13;&#10;end&#13;&#10;&#13;&#10;function SlowDownRev()&#13;&#10;&#9;while (spd&lt;0) do&#13;&#10;&#9;&#9;wait(.1)&#13;&#10;&#9;&#9;spd=spd+10&#13;&#10;&#9;&#9;SetSpeed(spd)&#13;&#10;&#9;end&#13;&#10;&#9;SetSpeed(0)&#13;&#10;end&#13;&#10;&#13;&#10;function onTouchedStart(part)&#13;&#10;&#9;local h = part.Parent:findFirstChild(&quot;Humanoid&quot;)&#13;&#10;&#9;if h~=nil then&#13;&#10;&#9;&#9;if (func==0) then&#13;&#10;&#9;&#9;&#9;spdlt.Color = Color3.new(0,1,0)&#13;&#10;&#9;&#9;&#9;if (direct==1) then&#13;&#10;&#9;&#9;&#9;&#9;StartUp()&#13;&#10;&#9;&#9;&#9;end&#13;&#10;&#9;&#9;&#9;if (direct==-1) then&#13;&#10;&#9;&#9;&#9;&#9;StartUpRev()&#13;&#10;&#9;&#9;&#9;end&#13;&#10;&#9;&#9;&#9;func=1&#13;&#10;&#9;&#9;end&#13;&#10;&#9;end&#13;&#10;end&#13;&#10;&#13;&#10;function onTouchedStop(part)&#13;&#10;&#9;local h = part.Parent:findFirstChild(&quot;Humanoid&quot;)&#13;&#10;&#9;if h~=nil then&#13;&#10;&#9;&#9;if (func==1) then&#13;&#10;&#9;&#9;&#9;if (direct==1) then&#13;&#10;&#9;&#9;&#9;&#9;SlowDown()&#13;&#10;&#9;&#9;&#9;end&#13;&#10;&#9;&#9;&#9;if (direct==-1) then&#13;&#10;&#9;&#9;&#9;&#9;SlowDownRev()&#13;&#10;&#9;&#9;&#9;end&#13;&#10;&#9;&#9;&#9;spdlt.Color = Color3.new(1,0,0)&#13;&#10;&#9;&#9;&#9;func=0&#13;&#10;&#9;&#9;end&#13;&#10;&#9;end&#13;&#10;end&#13;&#10;&#13;&#10;function onTouchedTrans(part)&#13;&#10;&#9;local h = part.Parent:findFirstChild(&quot;Humanoid&quot;)&#13;&#10;&#9;if h~=nil then&#13;&#10;&#9;&#9;if (func==0 and transfunc==0) then&#13;&#10;&#9;&#9;&#9;local bypass=false&#13;&#10;&#9;&#9;&#9;if (direct==1) then&#13;&#10;&#9;&#9;&#9;&#9;direct=-1&#13;&#10;&#9;&#9;&#9;&#9;bypass=true&#13;&#10;&#9;&#9;&#9;&#9;trnlt.Color = Color3.new(0,0,0)&#13;&#10;&#9;&#9;&#9;end&#13;&#10;&#9;&#9;&#9;if (bypass==false) then&#13;&#10;&#9;&#9;&#9;&#9;if (direct==-1) then&#13;&#10;&#9;&#9;&#9;&#9;&#9;direct=1&#13;&#10;&#9;&#9;&#9;&#9;&#9;trnlt.Color = Color3.new(1,1,1)&#13;&#10;&#9;&#9;&#9;&#9;end&#13;&#10;&#9;&#9;&#9;end&#13;&#10;&#9;&#9;&#9;trans.Color=Color3.new(0,0,0)&#13;&#10;&#9;&#9;&#9;transfunc=1&#13;&#10;&#9;&#9;&#9;wait(3)&#13;&#10;&#9;&#9;&#9;trans.Color=Color3.new(1,1,0)&#13;&#10;&#9;&#9;&#9;transfunc=0&#13;&#10;&#9;&#9;end&#13;&#10;&#9;end&#13;&#10;end&#13;&#10;&#13;&#10;function onTouchedEngr(part)&#13;&#10;&#9;local h = part.Parent:findFirstChild(&quot;Humanoid&quot;)&#13;&#10;&#9;if (h~=nil and engrfunc==0) then&#13;&#10;&#9;&#9;local bypass=false&#13;&#10;&#9;&#9;if (engrpos==0) then&#13;&#10;&#9;&#9;&#9;engrpos=1&#13;&#10;&#9;&#9;&#9;bypass=1&#13;&#10;&#13;&#10;&#9;&#9;&#9;engrDr.CanCollide=true&#13;&#10;&#9;&#9;&#9;engrDr.Transparency=0.5&#13;&#10;&#9;&#9;&#9;engr.Color = Color3.new(0.5,0.5,0.5)&#13;&#10;&#9;&#9;&#9;engrfunc=1&#13;&#10;&#9;&#9;&#9;wait(2)&#13;&#10;&#9;&#9;&#9;engr.Color = Color3.new(1,0,1)&#13;&#10;&#9;&#9;&#9;engrfunc=0&#13;&#10;&#9;&#9;end&#13;&#10;&#9;&#9;if (engrpos==1 and bypass==false) then&#13;&#10;&#9;&#9;&#9;engrpos=0&#13;&#10;&#9;&#9;&#9;bypass=0&#13;&#10;&#13;&#10;&#9;&#9;&#9;engrDr.CanCollide=false&#13;&#10;&#9;&#9;&#9;engrDr.Transparency=1&#13;&#10;&#9;&#9;&#9;engr.Color = Color3.new(0.5,0.5,0.5)&#13;&#10;&#9;&#9;&#9;engrfunc=1&#13;&#10;&#9;&#9;&#9;wait(2)&#13;&#10;&#9;&#9;&#9;engr.Color = Color3.new(1,0,1)&#13;&#10;&#9;&#9;&#9;engrfunc=0&#13;&#10;&#9;&#9;end&#13;&#10;&#9;end&#13;&#10;end&#13;&#10;&#13;&#10;function onTouchedDoor(part)&#13;&#10;&#9;local h = part.Parent:findFirstChild(&quot;Humanoid&quot;)&#13;&#10;&#9;if (h~=nil and engrfunc==0) then&#13;&#10;&#9;&#9;local bypass=false&#13;&#10;&#9;&#9;if (engrpos==0) then&#13;&#10;&#9;&#9;&#9;engrpos=1&#13;&#10;&#9;&#9;&#9;bypass=1&#13;&#10;&#13;&#10;&#9;&#9;&#9;Door1.CanCollide=true&#13;&#10;&#9;&#9;&#9;Door1.Transparency=0.5&#13;&#10;&#9;&#9;&#9;Door2.CanCollide=true&#13;&#10;&#9;&#9;&#9;Door2.Transparency=0.5&#13;&#10;&#9;&#9;&#9;doors.Color = Color3.new(0.5,0.5,0.5)&#13;&#10;&#9;&#9;&#9;doorfunc=1&#13;&#10;&#9;&#9;&#9;wait(2)&#13;&#10;&#9;&#9;&#9;doors.Color = Color3.new(0,0,1)&#13;&#10;&#9;&#9;&#9;doorfunc=0&#13;&#10;&#9;&#9;end&#13;&#10;&#9;&#9;if (engrpos==1 and bypass==false) then&#13;&#10;&#9;&#9;&#9;engrpos=0&#13;&#10;&#9;&#9;&#9;bypass=0&#13;&#10;&#13;&#10;&#9;&#9;&#9;Door1.CanCollide=false&#13;&#10;&#9;&#9;&#9;Door1.Transparency=1&#13;&#10;&#9;&#9;&#9;Door2.CanCollide=false&#13;&#10;&#9;&#9;&#9;Door2.Transparency=1&#13;&#10;&#9;&#9;&#9;doors.Color = Color3.new(0.5,0.5,0.5)&#13;&#10;&#9;&#9;&#9;doorfunc=1&#13;&#10;&#9;&#9;&#9;wait(2)&#13;&#10;&#9;&#9;&#9;doors.Color = Color3.new(0,0,1)&#13;&#10;&#9;&#9;&#9;doorfunc=0&#13;&#10;&#9;&#9;end&#13;&#10;&#9;end&#13;&#10;end&#13;&#10;&#13;&#10;start.Touched:connect(onTouchedStart)&#13;&#10;stop.Touched:connect(onTouchedStop)&#13;&#10;trans.Touched:connect(onTouchedTrans)&#13;&#10;engr.Touched:connect(onTouchedEngr)&#13;&#10;doors.Touched:connect(onTouchedDoor)&#13;&#10;</string>
					<bool name="archivable">true</bool>
				</Properties>
			</Item>
