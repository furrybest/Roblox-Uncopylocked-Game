			<Item class="Script" referent="RBX330">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">MessageBox</string>
					<string name="Source">local debounce = false&#13;&#10;&#13;&#10;&#13;&#10;function onHit(hit)&#13;&#10;&#9;local human = hit.Parent:findFirstChild(&quot;Humanoid&quot;)&#13;&#10;&#9;if (human ~= nil) and debounce == false then&#13;&#10;&#13;&#10;                debounce = true&#13;&#10;&#13;&#10;&#9;&#9;local message = Instance.new(&quot;Message&quot;)&#13;&#10;&#9;&#9;message.Text = &quot;After Crashing, you hear something&#13;&#10; moving in the bushes nearby&quot;&#13;&#10;&#9;&#9;message.Parent = game.Players:playerFromCharacter(hit.Parent)&#13;&#10;&#9;&#9;wait(5)&#13;&#10;end&#13;&#10;&#13;&#10;script.Parent.Touched:connect(onHit)</string>
					<bool name="archivable">true</bool>
				</Properties>
			</Item>
		</Item>
