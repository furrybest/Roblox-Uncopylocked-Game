		<Item class="HopperBin" referent="RBX3081">
			<Properties>
				<token name="BinType">0</token>
				<string name="Name">Dive</string>
				<Content name="TextureId"><null></null></Content>
				<bool name="archivable">true</bool>
			</Properties>
			<Item class="Script" referent="RBX3082">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Dive</string>
					<string name="Source">--if game.Workspace.Player:findFirstChild(&quot;Humanoid&quot;)~=nil then print(&quot;hi&quot;) end&#13;&#10;bin = script.Parent&#13;&#10;power=100&#13;&#10;enabled=true&#13;&#10;&#9;dude=script.Parent.Parent.Parent.Name&#13;&#10;&#9;pl=game.Workspace:findFirstChild(dude)&#13;&#10;&#13;&#10;function onButton1Down(mouse)&#13;&#10;&#9;if not enabled then&#13;&#10;&#9;&#9;return&#13;&#10;&#9;end&#13;&#10;&#13;&#10;&#9;enabled = false&#13;&#10;&#9;mouse.Icon = &quot;rbxasset://textures\\GunWaitCursor.png&quot;&#13;&#10;&#13;&#10;&#9;local hit = mouse.Hit&#13;&#10;&#9;local part=mouse.Target&#13;&#10;&#9;dude=script.Parent.Parent.Parent.Name&#13;&#10;&#9;pl=game.Workspace:findFirstChild(dude)&#13;&#10;&#9;if hit==nil or part==nil or dude==nil or pl==nil then &#13;&#10;&#9;wait(0.3)&#13;&#10;&#9;mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;&#13;&#10;&#9;enabled = true&#13;&#10;&#9;return &#13;&#10;&#9;end&#13;&#10;&#9;&#13;&#10;&#13;&#10;&#13;&#10;&#9;if pl.Torso.Position~=nil then&#13;&#10;&#9;&#9;local vertdist=hit.p.y-pl.Torso.Position.y&#13;&#10;&#9;&#9;if vertdist&gt;14 or vertdist&lt;-10 then&#13;&#10;&#9;&#9;&#9;wait(0.3)&#13;&#10;&#9;&#9;&#9;mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;&#13;&#10;&#9;&#9;&#9;enabled = true&#13;&#10;&#9;&#9;&#9;return&#13;&#10;&#9;&#9;end&#13;&#10;&#13;&#10;&#9;&#9;local e=hit.p.x-pl.Torso.Position.x&#13;&#10;&#9;&#9;local f=hit.p.z-pl.Torso.Position.z&#13;&#10;&#9;&#9;local mult=1/(math.sqrt((e^2)+(f^2)))&#13;&#10;&#9;&#9;e=e*mult&#13;&#10;&#9;&#9;f=f*mult&#13;&#10;&#9;&#9;&#13;&#10;&#9;&#9;local factorx=1&#13;&#10;&#9;&#9;local factory=1&#13;&#10;&#9;&#9;if part.Name==&quot;Ball&quot; then&#13;&#10;&#9;&#9;&#9;local factory=6&#13;&#10;&#9;&#9;end&#13;&#10;&#9;&#9;if part.Parent:findFirstChild(&quot;Humanoid&quot;)~=nil then&#13;&#10;&#9;&#9;&#9;local factorx=2&#13;&#10;&#9;&#9;end&#13;&#10;&#9;&#9;&#13;&#10;&#9;&#9;pl.Torso.Velocity=Vector3.new(e*power*factorx,25*factory,f*power*factorx)&#13;&#10;&#9;&#9;pl.Torso.RotVelocity=Vector3.new(0.5*f*power*factorx,0,-0.5*e*power*factorx)&#13;&#10;&#13;&#10;&#9;end&#13;&#10;&#13;&#10;&#9;pl.Humanoid.Health=pl.Humanoid.Health-7&#13;&#10;&#9;wait(3)&#13;&#10;&#9;mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;&#13;&#10;&#9;enabled = true&#13;&#10;&#13;&#10;end&#13;&#10;&#13;&#10;function onSelected(mouse)&#13;&#10;&#9;mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;&#13;&#10;&#9;mouse.Button1Down:connect(function() onButton1Down(mouse) end)&#13;&#10;end&#13;&#10;&#13;&#10;bin.Selected:connect(onSelected)&#13;&#10;</string>
					<bool name="archivable">true</bool>
				</Properties>
			</Item>
		</Item>
