				<string name="Source">l = game:service(&quot;Lighting&quot;) &#13;&#10;while true do &#13;&#10;-- increment the time of day and then wait for a while &#13;&#10;l:SetMinutesAfterMidnight(l:GetMinutesAfterMidnight()+1) &#13;&#10;wait(1) &#13;&#10;end </string>
