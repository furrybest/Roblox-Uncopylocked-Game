			<Item class="Script" referent="RBX3091">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">CarTool</string>
					<string name="Source">print(&quot;RobloxPolice&apos;s Drive Action Tool!&quot;)&#13;&#10;&#13;&#10;shooting = false&#13;&#10;reloadtime = 0&#13;&#10;time = 0&#13;&#10;dir=1&#13;&#10;turning=false&#13;&#10;lastPiece=nil&#13;&#10;bin=script.Parent&#13;&#10;&#13;&#10;function CheckDistance(part1,part2)&#13;&#10;&#9;if (part1~=nil and part2~=nil) then&#13;&#10;&#9;&#9;local x1=part1.Position.x&#13;&#10;&#9;&#9;local y1=part1.Position.y&#13;&#10;&#9;&#9;local z1=part1.Position.z&#13;&#10;&#9;&#9;local x2=part2.Position.x&#13;&#10;&#9;&#9;local y2=part2.Position.y&#13;&#10;&#9;&#9;local z2=part2.Position.z&#13;&#10;&#9;&#9;local dist=(math.abs(x1-x2)+math.abs(y1-y2)+math.abs(z1-z2))/3 --Average Position?&#13;&#10;&#9;&#9;if (dist&lt;=8) then&#13;&#10;&#9;&#9;&#9;return true&#13;&#10;&#9;&#9;else&#13;&#10;&#9;&#9;&#9;return false&#13;&#10;&#9;&#9;end&#13;&#10;&#9;else&#13;&#10;&#9;&#9;return false&#13;&#10;&#9;end&#13;&#10;end&#13;&#10;&#13;&#10;function SetSpeed(car,spd,spd2)&#13;&#10;&#9;car.FL.RightParamA = -spd&#13;&#10;&#9;car.FL.RightParamB = spd&#13;&#10;&#9;car.BL.RightParamA = -spd&#13;&#10;&#9;car.BL.RightParamB = spd&#13;&#10;&#9;car.FR.LeftParamA = spd2&#13;&#10;&#9;car.FR.LeftParamB = -spd2&#13;&#10;&#9;car.BR.LeftParamA = spd2&#13;&#10;&#9;car.BR.LeftParamB = -spd2&#13;&#10;end&#13;&#10;&#13;&#10;function Execute(piece, com)&#13;&#10;&#9;com = com:lower()&#13;&#10;&#9;if (com==&quot;go&quot;) then&#13;&#10;&#9;&#9;local car = piece.Parent&#13;&#10;&#9;&#9;local gear = car.Gear&#13;&#10;&#9;&#9;if (car~=nil and gear~=nil) then&#13;&#10;&#9;&#9;&#9;dir=1&#13;&#10;&#9;&#9;&#9;if (gear.Value==true) then&#13;&#10;&#9;&#9;&#9;&#9;dir=-0.5&#13;&#10;&#9;&#9;&#9;end&#13;&#10;&#9;&#9;&#9;SetSpeed(car,0.5*dir,0.5*dir)&#13;&#10;&#9;&#9;end&#13;&#10;&#9;&#9;time=4&#13;&#10;&#9;end&#13;&#10;&#9;if (com==&quot;stop&quot;) then&#13;&#10;&#9;&#9;local car = piece.Parent&#13;&#10;&#9;&#9;if (car~=nil) then&#13;&#10;&#9;&#9;&#9;SetSpeed(car,0,0)&#13;&#10;&#9;&#9;end&#13;&#10;&#9;&#9;time=4&#13;&#10;&#9;end&#13;&#10;&#9;if (com==&quot;left&quot;) then&#13;&#10;&#9;&#9;local car = piece.Parent&#13;&#10;&#9;&#9;local gear = car.Gear&#13;&#10;&#9;&#9;if (car~=nil and gear~=nil) then&#13;&#10;&#9;&#9;&#9;dir=1&#13;&#10;&#9;&#9;&#9;if (gear.Value==true) then&#13;&#10;&#9;&#9;&#9;&#9;dir=-0.5&#13;&#10;&#9;&#9;&#9;end&#13;&#10;&#9;&#9;&#9;SetSpeed(car,0,0.5*dir)&#13;&#10;&#9;&#9;&#9;turning=true&#13;&#10;&#9;&#9;end&#13;&#10;&#9;end&#13;&#10;&#9;if (com==&quot;right&quot;) then&#13;&#10;&#9;&#9;local car = piece.Parent&#13;&#10;&#9;&#9;local gear = car.Gear&#13;&#10;&#9;&#9;if (car~=nil and gear~=nil) then&#13;&#10;&#9;&#9;&#9;dir=1&#13;&#10;&#9;&#9;&#9;if (gear.Value==true) then&#13;&#10;&#9;&#9;&#9;&#9;dir=-0.5&#13;&#10;&#9;&#9;&#9;end&#13;&#10;&#9;&#9;&#9;SetSpeed(car,0.5*dir,0)&#13;&#10;&#9;&#9;&#9;turning=true&#13;&#10;&#9;&#9;end&#13;&#10;&#9;end&#13;&#10;&#9;if (com==&quot;shift&quot;) then&#13;&#10;&#9;&#9;local car = piece.Parent&#13;&#10;&#9;&#9;if (car.Gear~=nil) then&#13;&#10;&#9;&#9;&#9;if (car.Gear.Value==false) then&#13;&#10;&#9;&#9;&#9;&#9;car.Gear.Value=true&#13;&#10;&#9;&#9;&#9;else&#13;&#10;&#9;&#9;&#9;&#9;car.Gear.Value=false&#13;&#10;&#9;&#9;&#9;end&#13;&#10;&#9;&#9;end&#13;&#10;&#9;&#9;time=4&#13;&#10;&#9;end&#13;&#10;end&#13;&#10;&#13;&#10;function onButton1Down(mouse)&#13;&#10;&#9;if reloadtime &gt; 0 then return end&#13;&#10;&#9;if shooting == true then return end&#13;&#10;&#9;reloadtime = 1.0&#13;&#10;&#9;shooting = true&#13;&#10;&#13;&#10;&#9;time = 0&#13;&#10;&#9;while shooting == true do&#13;&#10;&#9;&#9;--FIRE MECHANISM&#13;&#10;&#9;&#9;local part = mouse.Target&#13;&#10;&#9;&#9;local act = part:findFirstChild(&quot;Action&quot;)&#13;&#10;&#9;&#9;if (act~=nil) then&#13;&#10;&#9;&#9;&#9;lastPiece=part&#13;&#10;&#9;&#9;&#9;local body = bin.Parent.Parent.Character.Torso&#13;&#10;&#9;&#9;&#9;if (CheckDistance(part,body)==true) then&#13;&#10;&#9;&#9;&#9;&#9;local val = act.Value&#13;&#10;&#9;&#9;&#9;&#9;if (val~=nil) then&#13;&#10;&#9;&#9;&#9;&#9;&#9;Execute(part, val)&#13;&#10;&#9;&#9;&#9;&#9;end&#13;&#10;&#9;&#9;&#9;end&#13;&#10;&#9;&#9;end&#13;&#10;&#13;&#10;&#9;&#9;wait(.03)&#13;&#10;&#9;&#9;time = time + .1&#13;&#10;&#9;&#9;if time &gt; 3.5 then shooting = false end&#13;&#10;&#9;end&#13;&#10;&#9;mouse.Icon = &quot;rbxasset://textures\\GunWaitCursor.png&quot;&#13;&#10;&#9;wait(0.5)&#13;&#10;&#9;reloadtime = 0&#13;&#10;&#9;mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;&#13;&#10;end&#13;&#10;&#13;&#10;function onButton1Up(mouse)&#13;&#10;&#9;shooting = false&#13;&#10;&#9;if (turning==true) then&#13;&#10;&#9;&#9;turning=false&#13;&#10;&#9;&#9;local car = lastPiece.Parent&#13;&#10;&#9;&#9;if (car~=nil) then&#13;&#10;&#9;&#9;&#9;SetSpeed(car,0.5*dir,0.5*dir)&#13;&#10;&#9;&#9;end&#13;&#10;&#9;end&#13;&#10;end&#13;&#10;&#13;&#10;function onSelected(mouse)&#13;&#10;&#9;if reloadtime &gt; 0 then&#13;&#10;&#9;&#9;mouse.Icon = &quot;rbxasset://textures\\GunWaitCursor.png&quot;&#13;&#10;&#9;else&#13;&#10;&#9;&#9;mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;&#13;&#10;&#9;end&#13;&#10;&#9;mouse.Button1Down:connect(function() onButton1Down(mouse) end)&#13;&#10;&#9;mouse.Button1Up:connect(function() onButton1Up(mouse) end)&#13;&#10;end&#13;&#10;&#13;&#10;bin.Selected:connect(onSelected)&#13;&#10;</string>
					<bool name="archivable">true</bool>
				</Properties>
			</Item>
		</Item>
