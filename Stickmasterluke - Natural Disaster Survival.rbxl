			<Item class="LocalScript" referent="RBX38">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">CharacterScript</string>
					<ProtectedString name="Source">--Made by Stickmasterluke



sp=script.Parent

fatalthreshhold=400

safethreshhold=65

lastvelocity=0

while true do
&#9;wait()
&#9;local t=sp:FindFirstChild(&quot;Torso&quot;)
&#9;if t~=nil then
&#9;&#9;local currentvelocity=(t.Velocity).magnitude
&#9;&#9;--print(math.floor(currentvelocity),&quot;Velocity&quot;)
&#9;&#9;local pain=currentvelocity-safethreshhold
&#9;&#9;--print(math.floor(pain),&quot;Pain&quot;)
&#9;&#9;if pain&gt;0 then
&#9;&#9;&#9;local damage = pain/(fatalthreshhold-safethreshhold)*100
&#9;&#9;&#9;local h=sp:FindFirstChild(&quot;Humanoid&quot;)
&#9;&#9;&#9;if h then
&#9;&#9;&#9;&#9;h.Health=h.Health-damage
&#9;&#9;&#9;end&#9;
&#9;&#9;end
&#9;&#9;lastvelocity=currentvelocity
&#9;end
end



</ProtectedString>
				</Properties>
