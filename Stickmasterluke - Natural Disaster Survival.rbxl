					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Useful</string>
					<ProtectedString name="Source">--Stickmasterluke


function a(m) if m.Name==&quot;Wall&quot; then m.Transparency=.25 end for i,v in ipairs(m:GetChildren()) do a(v) end end a(game.Workspace.Building2)

--[[How to use
#1 Resize the brick to where you want the ramp. The ramp will slope downward to the size that has the hindge on it.
#2 Uncheck the Disabled property of this script
#3 cut and paste this script back into this brick. The brick should now be a ramp. Feel free to delete the script now.
]]


sp=script.Parent
angle=math.atan2(sp.Size.y,sp.size.x)
cf=sp.CFrame
sp.Size=Vector3.new(math.sqrt(((sp.Size.x^2)+(sp.Size.y^2))),sp.Size.y,sp.Size.z)
sp.CFrame=cf*CFrame.fromEulerAnglesXYZ(0,0,angle)*CFrame.new(0,sp.Size.y*-.5,0)
script.Disabled=true



--command prompt form--

--sp=game.Workspace.OBJECTZ angle=math.atan2(sp.Size.y,sp.size.x) cf=sp.CFrame sp.Size=Vector3.new(math.sqrt(((sp.Size.x^2)+(sp.Size.y^2))),sp.Size.y,sp.Size.z) sp.CFrame=cf*CFrame.fromEulerAnglesXYZ(0,0,angle)*CFrame.new(0,sp.Size.y*-.5,0)
</ProtectedString>
