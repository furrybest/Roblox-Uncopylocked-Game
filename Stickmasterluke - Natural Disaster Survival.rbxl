			<Item class="Script" referent="RBX402">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<ProtectedString name="Source">--Made by Stickmasterluke


sp=script.Parent
spf=sp.StatsPage.Frame
sps=sp.SurviversPage.Frame

testing=false

disasters={&quot;Meteor Shower&quot;,&quot;Flash Flood&quot;,&quot;Thunder Storm&quot;,&quot;Fire&quot;,&quot;Tornado&quot;,&quot;Tsunami&quot;}


function loadlist(plr)
&#9;if plr and plr~=nil and plr.Parent==game.Players and (plr.DataReady or testing) then
&#9;&#9;for i,v in ipairs(spf.List:GetChildren()) do
&#9;&#9;&#9;v:remove()
&#9;&#9;end
&#9;&#9;list1={}
&#9;&#9;list2={}
&#9;&#9;if spf.CategoryButton.Text==&quot;Disaster&quot; then
&#9;&#9;&#9;local masterdisasterbadge=0
&#9;&#9;&#9;for i,v in ipairs(disasters) do
&#9;&#9;&#9;&#9;if spf.StatTypeButton.Text==&quot;Percent&quot; then
&#9;&#9;&#9;&#9;&#9;list1[i]=v
&#9;&#9;&#9;&#9;&#9;local scs=plr:LoadNumber(&quot;Survived&quot;..v) or 0
&#9;&#9;&#9;&#9;&#9;local scp=plr:LoadNumber(&quot;Played&quot;..v) or 0
&#9;&#9;&#9;&#9;&#9;fscp=1
&#9;&#9;&#9;&#9;&#9;if scp&gt;0 and scs&lt;=scp then
&#9;&#9;&#9;&#9;&#9;&#9;fscp=scs/scp
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;list2[i]=fscp
&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;list1[i]=v
&#9;&#9;&#9;&#9;&#9;list2[i]=plr:LoadNumber(spf.StatTypeButton.Text..v) or 0
&#9;&#9;&#9;&#9;&#9;if spf.StatTypeButton.Text==&quot;Survived&quot; and list2[i]&gt;=1 then
&#9;&#9;&#9;&#9;&#9;&#9;masterdisasterbadge=masterdisasterbadge+1
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;&#9;if masterdisasterbadge==#disasters then
&#9;&#9;&#9;&#9;game:GetService(&quot;BadgeService&quot;):AwardBadge(plr.userId,66918887)
&#9;&#9;&#9;end
&#9;&#9;elseif spf.CategoryButton.Text==&quot;Map&quot; then
&#9;&#9;&#9;local travelerbadge=0
&#9;&#9;&#9;for i,v in ipairs(game.Lighting.Structures:GetChildren()) do
&#9;&#9;&#9;&#9;if spf.StatTypeButton.Text==&quot;Percent&quot; then
&#9;&#9;&#9;&#9;&#9;list1[i]=v.Name
&#9;&#9;&#9;&#9;&#9;local scs=plr:LoadNumber(&quot;Survived&quot;..v.Name) or 0
&#9;&#9;&#9;&#9;&#9;local scp=plr:LoadNumber(&quot;Played&quot;..v.Name) or 0
&#9;&#9;&#9;&#9;&#9;fscp=1
&#9;&#9;&#9;&#9;&#9;if scp&gt;0 and scs&lt;=scp then
&#9;&#9;&#9;&#9;&#9;&#9;fscp=scs/scp
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;list2[i]=fscp
&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;list1[i]=v.Name
&#9;&#9;&#9;&#9;&#9;list2[i]=plr:LoadNumber(spf.StatTypeButton.Text..v.Name) or 0
&#9;&#9;&#9;&#9;&#9;if spf.StatTypeButton.Text==&quot;Played&quot; and list2[i]&gt;=1 then
&#9;&#9;&#9;&#9;&#9;&#9;travelerbadge=travelerbadge+1
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;&#9;if travelerbadge==#(game.Lighting.Structures:GetChildren()) then
&#9;&#9;&#9;&#9;game:GetService(&quot;BadgeService&quot;):AwardBadge(plr.userId,66919189)
&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;n=0
&#9;&#9;--lis=spf.NameLabel.Size.Y.Offset
&#9;&#9;lis=math.floor(spf.List.AbsoluteSize.Y/(#list1))
&#9;&#9;for i,v in ipairs(list1) do
&#9;&#9;&#9;n=n+1
&#9;&#9;&#9;local nl=spf.NameLabel:clone()
&#9;&#9;&#9;nl.Text=v
&#9;&#9;&#9;nl.Size=UDim2.new(0,135,0,lis)
&#9;&#9;&#9;nl.Position=UDim2.new(0,10,0,(lis*n)-lis)
&#9;&#9;&#9;nl.Parent=spf.List
&#9;&#9;&#9;nl.Visible=true
&#9;&#9;&#9;local sl=spf.StatLabel:clone()
&#9;&#9;&#9;if spf.StatTypeButton.Text==&quot;Percent&quot; then
&#9;&#9;&#9;&#9;sl.Text=tostring(math.floor((list2[i]*100)+.5))..&quot;%&quot;
&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;sl.Text=tostring(list2[i])
&#9;&#9;&#9;end
&#9;&#9;&#9;sl.Position=UDim2.new(1,-62,0,(lis*n)-lis)
&#9;&#9;&#9;sl.Parent=spf.List
&#9;&#9;&#9;sl.Visible=true
&#9;&#9;end
&#9;end
end

function loadstats(plr)
&#9;if plr and plr~=nil and plr.Parent==game.Players and (plr.DataReady or testing) then
&#9;&#9;lastplayer=plr
&#9;&#9;spf.PlayerButton.Text=plr.Name
&#9;&#9;spf.PlayerImage.Image=&quot;http://www.roblox.com/Thumbs/Avatar.ashx?x=200&amp;y=200&amp;Format=Png&amp;id=&quot;..tostring(plr.userId)
&#9;&#9;loadlist(plr)
&#9;&#9;sp.StatsPage.Visible=true
&#9;end
end

sp.StatsButton.MouseButton1Click:connect(function()
&#9;if sp.StatsPage.Visible then
&#9;&#9;sp.StatsPage.Visible=false
&#9;else
&#9;&#9;loadstats(sp.Parent.Parent)
&#9;end
end)

spf.CategoryButton.MouseButton1Click:connect(function()
&#9;if spf.CategoryButton.Text==&quot;Disaster&quot; then
&#9;&#9;spf.CategoryButton.Text=&quot;Map&quot;
&#9;elseif spf.CategoryButton.Text==&quot;Map&quot; then
&#9;&#9;spf.CategoryButton.Text=&quot;Disaster&quot;
&#9;end
&#9;loadlist(lastplayer)
end)

spf.StatTypeButton.MouseButton1Click:connect(function()
&#9;if spf.StatTypeButton.Text==&quot;Survived&quot; then
&#9;&#9;spf.StatTypeButton.Text=&quot;Played&quot;
&#9;elseif spf.StatTypeButton.Text==&quot;Played&quot; then
&#9;&#9;spf.StatTypeButton.Text=&quot;Percent&quot;
&#9;elseif spf.StatTypeButton.Text==&quot;Percent&quot; then
&#9;&#9;spf.StatTypeButton.Text=&quot;Survived&quot;
&#9;end
&#9;loadlist(lastplayer)
end)

status=game.Workspace.Script.Status
status.Changed:connect(function()
&#9;if status.Value==&quot;Survivers&quot; then
&#9;&#9;for i5,v5 in ipairs(sps.List:GetChildren()) do
&#9;&#9;&#9;v5:remove()
&#9;&#9;end
&#9;&#9;survivers=game.Workspace.Script.Survivers:GetChildren()
&#9;&#9;for i6,v6 in ipairs(survivers) do
&#9;&#9;&#9;local nnt=sps.NameLabel:clone()
&#9;&#9;&#9;if #survivers&lt;=10 then
&#9;&#9;&#9;&#9;nnt.Size=UDim2.new(1,0,0,25)
&#9;&#9;&#9;&#9;nnt.Position=UDim2.new(0,0,0,25*((i6-1)%10))
&#9;&#9;&#9;elseif #survivers&lt;=20 then
&#9;&#9;&#9;&#9;nnt.Size=UDim2.new(.5,0,0,25)
&#9;&#9;&#9;&#9;nnt.Position=UDim2.new(math.floor((i6-1)/10)/2,0,0,25*((i6-1)%10))
&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;nnt.Size=UDim2.new(.33,0,0,25)
&#9;&#9;&#9;&#9;nnt.Position=UDim2.new(math.floor((i6-1)/10)/3,0,0,25*((i6-1)%10))
&#9;&#9;&#9;end
&#9;&#9;&#9;nnt.Text=v6.Name
&#9;&#9;&#9;nnt.Parent=sps.List
&#9;&#9;&#9;nnt.Visible=true
&#9;&#9;end
&#9;&#9;sp.SurviversPage.Visible=true
&#9;&#9;sp.NextMapPage.Visible=false
&#9;&#9;wait(10)
&#9;&#9;sp.SurviversPage.Visible=false
&#9;elseif status.Value==&quot;New Map&quot; then
&#9;&#9;sp.NextMapPage.Frame.List.MapTitle.Text=game.Workspace.Script.Information.Value
&#9;&#9;sp.NextMapPage.Visible=true
&#9;&#9;sp.SurviversPage.Visible=false
&#9;&#9;wait(5)
&#9;&#9;sp.NextMapPage.Visible=false
&#9;end
end)


