		<Item class="Model" referent="RBX631D7B57CCEE418E9A9F4216FAEDD85D">
			<Properties>
				<CoordinateFrame name="ModelInPrimary">
					<X>0</X>
					<Y>0</Y>
					<Z>0</Z>
					<R00>1</R00>
