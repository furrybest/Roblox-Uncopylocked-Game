			<Item class="Script" referent="RBXE4B45001C8E043C59CA747293A15CA72">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Regenerate Castle</string>
					<ProtectedString name="Source">model = game.Workspace.Regen
messageText = &quot;Regenerating Bridges...&quot;

message = Instance.new(&quot;Message&quot;)
message.Text = messageText
backup = model:clone()

while true do
&#9;wait(300)

&#9;message.Parent = game.Workspace
&#9;model:remove()

&#9;wait(4)

&#9;model = backup:clone()
&#9;model.Parent = game.Workspace
&#9;model:makeJoints()
&#9;message.Parent = nil
end
</ProtectedString>
