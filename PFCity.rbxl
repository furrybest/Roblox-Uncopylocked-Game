		<Item class="Script" referent="RBX1216">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Leaderboard</string>
				<string name="Source">print(&quot;Community Leaderboard script loaded&quot;)


function onPlayerEntered(newPlayer)

	local stats = Instance.new(&quot;IntValue&quot;)
	stats.Name = &quot;leaderstats&quot;

	local mins = Instance.new(&quot;IntValue&quot;)
	mins.Name = &quot;Minutes Exploreing&quot;
	mins.Value = 0


	mins.Parent = stats
	
	stats.Parent = newPlayer

	while true do
		wait(60)
		mins.Value = mins.Value + 1
	end
end



game.Players.ChildAdded:connect(onPlayerEntered)</string>
				<bool name="archivable">true</bool>
