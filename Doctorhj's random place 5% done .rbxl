					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<string name="Source">model = script.Parent&#13;&#10;floor = script.Parent.Parent.Floor&#13;&#10;messageText = &quot;Oh noes! People in the house are going to die! :O&quot;&#13;&#10;message = Instance.new(&quot;Message&quot;)&#13;&#10;message.Text = messageText&#13;&#10;backup = model:clone()&#13;&#10;&#13;&#10;function onTouched(part)&#13;&#10;&#9;local h = part.Parent:findFirstChild(&quot;Humanoid&quot;)&#13;&#10;&#9;if h~=nil then&#13;&#10;&#9;&#9;script.Parent.BrickColor = BrickColor.new(21)&#13;&#10;floor.BodyVelocity.velocity = Vector3.new(0,28,0)&#13;&#10;&#13;&#10;wait(60)&#13;&#10;message.Parent = game.Workspace&#13;&#10;wait(10)&#13;&#10;explosion = Instance.new(&quot;Explosion&quot;)&#13;&#10;  explosion.BlastRadius = 48&#13;&#10;  explosion.BlastPressure = 2000&#13;&#10;  explosion.Position = floor.Position&#13;&#10;  explosion.Parent = game.Workspace&#13;&#10;floor:remove()&#13;&#10;message.Parent = nil&#13;&#10;&#9;end&#13;&#10;end&#13;&#10;&#13;&#10;script.Parent.Touched:connect(onTouched)&#13;&#10;</string>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
			</Item>
