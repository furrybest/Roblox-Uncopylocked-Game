			<Item class="Script" referent="RBX3268">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<string name="Source">--[[&#13;&#10;Instructions coming soon.&#13;&#10;&#13;&#10;Newer versions of this pet will have:&#13;&#10;Better guard dog - does a search for anyone nearby. At the moment you need to touch to get him to chase you.&#13;&#10;Make him your friend by feeding him&#13;&#10;Teach him new tricks&#13;&#10;Play games (fetch in paticular, also tag)&#13;&#10;suggestions? send them to me!&#13;&#10;&#13;&#10;-miked 2007&#13;&#10;--]]&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;--game.Workspace.dog.RotVelocity=Vector3.new(0, 0, 60)&#13;&#10;--=backflip&#13;&#10;humanoid = nil&#13;&#10;dogisattacking=0&#13;&#10;dogawake=1&#13;&#10;wait(10)&#13;&#10;function onTouched(part)&#13;&#10;&#9;if part.Parent ~= nil then&#13;&#10;&#9;local h = part.Parent:findFirstChild(&quot;Humanoid&quot;)&#13;&#10;&#9;&#9;if h~=nil then&#13;&#10;&#9;&#9;&#9;&#9;if dogisattacking==1 then&#13;&#10;&#9;&#9;&#9;&#9;&#9;h.Health=h.Health-(script.Parent.Aggression.Value*4)&#13;&#10;&#9;&#9;&#9;&#9;end&#13;&#10;&#9;&#9;&#9;if dogawake~=0 then&#13;&#10;&#9;&#9;&#9;&#9;if h==humanoid then&#13;&#10;&#9;&#9;&#9;&#9;&#9;return&#13;&#10;&#9;&#9;&#9;&#9;end&#13;&#10;&#9;&#9;&#9;&#9;&#13;&#10;&#9;&#9;&#9;&#9;local dog=script.Parent&#13;&#10;&#9;&#9;&#9;&#9;local owner=dog.Owner.Value&#13;&#10;&#9;&#9;&#9;&#9;local agg=dog.Aggression.Value&#13;&#10;&#9;&#9;&#9;&#9;local agi=dog.Agility.Value&#13;&#10;&#9;&#9;&#9;&#9;local hap=dog.Happiness.Value&#13;&#10;&#9;&#9;&#9;&#9;local hun=dog.Hunger.Value&#13;&#10;&#13;&#10;&#9;&#9;&#9;&#9;if h.Parent.Name==owner then&#13;&#10;&#9;&#9;&#9;&#9;&#9;--dog.RotVelocity=Vector3.new(0, 0, 60)&#13;&#10;&#9;&#9;&#9;&#9;&#9;--dogcelebrate()&#13;&#10;&#9;&#9;&#9;&#9;&#9;dogisfollowing=1&#13;&#10;&#9;&#9;&#9;&#9;&#9;dogawake=0&#13;&#10;&#9;&#9;&#9;&#9;&#9;wait(2)&#13;&#10;&#9;&#9;&#9;&#9;&#9;print(&quot;woof! my owner is here, i think i will follow him&quot;)&#13;&#10;&#9;&#9;&#9;&#9;&#9;dogfollowowner(h)&#13;&#10;&#9;&#9;&#9;&#9;&#9;dogisfollowing=0&#13;&#10;&#9;&#9;&#9;&#9;&#9;print(&quot;woof! ill stop&quot;)&#13;&#10;&#9;&#9;&#9;&#9;&#9;script.Parent.BodyVelocity.velocity=Vector3.new(0,-20,0)&#13;&#10;&#9;&#9;&#9;&#9;else&#13;&#10;&#9;&#9;&#9;&#9;&#9;if agg&gt;4 then&#13;&#10;&#9;&#9;&#9;&#9;&#9;&#9;print(&quot;touched!&quot;)&#13;&#10;&#9;&#9;&#9;&#9;&#9;&#9;dogisfollowing=1&#13;&#10;&#9;&#9;&#9;&#9;&#9;&#9;dogawake=0&#13;&#10;&#9;&#9;&#9;&#9;&#9;&#9;wait(2)&#13;&#10;&#9;&#9;&#9;&#9;&#9;&#9;dogkill(h)&#13;&#10;&#9;&#9;&#9;&#9;&#9;&#9;dogisfollowing=0&#13;&#10;&#9;&#9;&#9;&#9;&#9;&#9;print(&quot;woof! ill stop attacking now&quot;)&#13;&#10;&#9;&#9;&#9;&#9;&#9;&#9;script.Parent.BodyVelocity.velocity=Vector3.new(0,-20,0)&#13;&#10;&#9;&#9;&#9;&#9;&#9;else&#13;&#10;&#9;&#9;&#9;&#9;&#9;&#9;if hap&gt;4 then&#13;&#10;&#9;&#9;&#9;&#9;&#9;&#9;&#9;--dogcelebrate()&#13;&#10;&#9;&#9;&#9;&#9;&#9;&#9;&#9;--dog.RotVelocity=Vector3.new(0, 0, 60)&#13;&#10;&#9;&#9;&#9;&#9;&#9;&#9;&#9;print(&quot;touched!&quot;)&#13;&#10;&#9;&#9;&#9;&#9;&#9;&#9;&#9;dogisfollowing=1&#13;&#10;&#9;&#9;&#9;&#9;&#9;&#9;&#9;dogawake=0&#13;&#10;&#9;&#9;&#9;&#9;&#9;&#9;&#9;wait(2)&#13;&#10;&#9;&#9;&#9;&#9;&#9;&#9;&#9;dogfollowowner(h)&#13;&#10;&#9;&#9;&#9;&#9;&#9;&#9;&#9;dogisfollowing=0&#13;&#10;&#9;&#9;&#9;&#9;&#9;&#9;&#9;print(&quot;woof! ill stop&quot;)&#13;&#10;&#9;&#9;&#9;&#9;&#9;&#9;&#9;script.Parent.BodyVelocity.velocity=Vector3.new(0,-20,0)&#13;&#10;&#9;&#9;&#9;&#9;&#9;&#9;end&#13;&#10;&#9;&#9;&#9;&#9;&#9;end&#13;&#10;&#9;&#9;&#9;&#9;&#9;print(&quot;bark&quot;)&#13;&#10;&#9;&#9;&#9;&#9;&#9;dogawake=1&#13;&#10;&#9;&#9;&#9;&#9;&#9;doggo()&#13;&#10;&#9;&#9;&#9;&#9;end&#13;&#10;&#9;&#9;&#9;end&#13;&#10;&#9;&#9;end&#13;&#10;&#9;end&#13;&#10;if part.Name==&quot;toast&quot; then&#13;&#10;script.Parent.Hunger.Value=script.Parent.Hunger.Value-1&#13;&#10;part:remove()&#13;&#10;end&#13;&#10;end&#13;&#10;&#13;&#10;script.Parent.Touched:connect(onTouched)&#13;&#10;&#13;&#10;&#13;&#10;function dogfollowowner(h)&#13;&#10;&#13;&#10;if h.Parent.Torso.Position~=nil then&#13;&#10;&#9;local goto=h.Parent.Torso.Position&#13;&#10;&#9;local vertdist=goto.y-script.Parent.Position.y&#13;&#10;&#9;if vertdist&gt;14 or vertdist&lt;-10 then&#13;&#10;&#9;&#9;return&#13;&#10;&#9;end&#13;&#10;&#13;&#10;&#9;local from=script.Parent.Position&#13;&#10;&#9;local e=(goto.x-from.x)*(goto.x-from.x)&#13;&#10;&#9;local f=(goto.z-from.z)*(goto.z-from.z)&#13;&#10;&#9;local waittime=math.sqrt(e+f)&#13;&#10;&#9;if waittime&gt;40 then&#13;&#10;&#9;&#9;return&#13;&#10;&#9;end&#13;&#10;&#9;if waittime&gt;15 then&#13;&#10;&#9;&#9;script.Parent.BodyVelocity.velocity=Vector3.new(goto.x-from.x,20,goto.z-from.z)&#13;&#10;&#9;&#9;wait(waittime/40)&#13;&#10;&#9;&#9;--script.Parent.BodyVelocity.velocity=Vector3.new(0,-20,0)&#13;&#10;&#9;&#9;dogfollowowner(h)&#13;&#10;&#9;else&#13;&#10;&#9;&#9;script.Parent.BodyVelocity.velocity=Vector3.new(0,-20,0)&#13;&#10;&#9;&#9;wait(1)&#13;&#10;&#9;&#9;dogfollowowner(h)&#13;&#10;&#9;&#9;--dogisfollowing=0&#13;&#10;&#9;&#9;--dogawake=1&#13;&#10;&#9;end&#13;&#10;else&#13;&#10;&#9;script.Parent.BodyVelocity.velocity=Vector3.new(0,-20,0)&#13;&#10;&#9;--doggohome()&#13;&#10;end&#13;&#10;&#13;&#10;end&#13;&#10;&#13;&#10;&#13;&#10;function dogcelebrate()&#13;&#10;dogawake=0&#13;&#10;local radom=math.random(1,2)&#13;&#10;if radom==1 then&#13;&#10;script.Parent.RotVelocity=Vector3.new(0, 0, script.Parent.Happiness.Value*8)&#13;&#10;else&#13;&#10;script.Parent.RotVelocity=Vector3.new(script.Parent.Happiness.Value*5, script.Parent.Happiness.Value*5, 0)&#13;&#10;end&#13;&#10;script.Parent.Happiness.Value=script.Parent.Happiness.Value+1&#13;&#10;dogawake=1&#13;&#10;end&#13;&#10;&#13;&#10;function dogroam()&#13;&#10;wait(1)&#13;&#10;script.Parent.BodyVelocity.velocity=Vector3.new((0.8*script.Parent.Agility.Value+9)*(math.sin(math.rad(math.random(0,360)))),20,(0.8*script.Parent.Agility.Value+9)*(math.sin(math.rad(math.random(0,360)))))&#13;&#10;wait(2)&#13;&#10;script.Parent.BodyVelocity.velocity=Vector3.new(0,20,0)&#13;&#10;wait(1)&#13;&#10;script.Parent.BodyVelocity.velocity=Vector3.new((0.8*script.Parent.Agility.Value+9)*(math.sin(math.rad(math.random(0,360)))),20,(0.8*script.Parent.Agility.Value+9)*(math.sin(math.rad(math.random(0,360)))))&#13;&#10;wait(2)&#13;&#10;script.Parent.BodyVelocity.velocity=Vector3.new(0,20,0)&#13;&#10;wait(1)&#13;&#10;script.Parent.BodyVelocity.velocity=Vector3.new((0.8*script.Parent.Agility.Value+9)*(math.sin(math.rad(math.random(0,360)))),20,(0.8*script.Parent.Agility.Value+9)*(math.sin(math.rad(math.random(0,360)))))&#13;&#10;wait(2)&#13;&#10;script.Parent.BodyVelocity.velocity=Vector3.new(0,20,0)&#13;&#10;wait(1)&#13;&#10;end&#13;&#10;&#13;&#10;function doggohome()&#13;&#10;&#9;local goto=script.Parent.Parent.DogHouse.DogBowl.Position&#13;&#10;&#9;local vertdist=goto.y-script.Parent.Position.y&#13;&#10;&#9;local from=script.Parent.Position&#13;&#10;&#13;&#10;&#9;local e=(goto.x-from.x)*(goto.x-from.x)&#13;&#10;&#9;local f=(goto.z-from.z)*(goto.z-from.z)&#13;&#10;&#9;local distance=math.sqrt(e+f)&#13;&#10;&#13;&#10;if distance&lt;14 then&#13;&#10;return&#13;&#10;end&#13;&#10;&#9;--get a good ratio.&#13;&#10;local xa=goto.x-from.x&#13;&#10;local za=goto.z-from.z&#13;&#10;if xa&gt;30 or za&gt;30 then&#13;&#10;&#9;xa=xa/1.3&#13;&#10;&#9;za=za/1.3&#13;&#10;end&#13;&#10;if xa&gt;30 or za&gt;30 then&#13;&#10;&#9;xa=xa/1.3&#13;&#10;&#9;za=za/1.3&#13;&#10;end&#13;&#10;if xa&gt;30 or za&gt;30 then&#13;&#10;&#9;xa=xa/1.3&#13;&#10;&#9;za=za/1.3&#13;&#10;end&#13;&#10;if xa&gt;30 or za&gt;30 then&#13;&#10;&#9;xa=xa/1.3&#13;&#10;&#9;za=za/1.3&#13;&#10;end&#13;&#10;if xa&gt;30 or za&gt;30 then&#13;&#10;&#9;xa=xa/1.3&#13;&#10;&#9;za=za/1.3&#13;&#10;end&#13;&#10;if xa&gt;30 or za&gt;30 then&#13;&#10;&#9;xa=xa/1.3&#13;&#10;&#9;za=za/1.3&#13;&#10;end&#13;&#10;if xa&gt;30 or za&gt;30 then&#13;&#10;&#9;xa=xa/1.3&#13;&#10;&#9;za=za/1.3&#13;&#10;end&#13;&#10;if xa&gt;30 or za&gt;30 then&#13;&#10;&#9;xa=xa/1.3&#13;&#10;&#9;za=za/1.3&#13;&#10;end&#13;&#10;if xa&gt;30 or za&gt;30 then&#13;&#10;&#9;xa=xa/1.3&#13;&#10;&#9;za=za/1.3&#13;&#10;end&#13;&#10;if xa&gt;30 or za&gt;30 then&#13;&#10;&#9;xa=xa/1.3&#13;&#10;&#9;za=za/1.3&#13;&#10;end&#13;&#10;if xa&gt;30 or za&gt;30 then&#13;&#10;&#9;xa=xa/1.3&#13;&#10;&#9;za=za/1.3&#13;&#10;end&#13;&#10;if xa&gt;30 or za&gt;30 then&#13;&#10;&#9;xa=xa/1.3&#13;&#10;&#9;za=za/1.3&#13;&#10;end&#13;&#10;if xa&gt;30 or za&gt;30 then&#13;&#10;&#9;xa=xa/1.3&#13;&#10;&#9;za=za/1.3&#13;&#10;end&#13;&#10;if xa&gt;30 or za&gt;30 then&#13;&#10;&#9;xa=xa/1.3&#13;&#10;&#9;za=za/1.3&#13;&#10;end&#13;&#10;&#9;script.Parent.BodyVelocity.velocity=Vector3.new(xa,20,za)&#13;&#10;&#13;&#10;wait((math.sqrt(xa*xa+za*za))/40)&#13;&#10;doggohome()&#13;&#10;end&#13;&#10;&#13;&#10;function dogfindfood()&#13;&#10;&#9;local goto=script.Parent.Parent.DogHouse.DogBowl.Position&#13;&#10;&#9;local vertdist=goto.y-script.Parent.Position.y&#13;&#10;&#9;if vertdist&gt;14 or vertdist&lt;-10 then&#13;&#10;&#9;&#9;print(&quot;My food is miles away! im starving!&quot;)&#13;&#10;&#9;&#9;return&#13;&#10;&#9;end&#13;&#10;&#9;local from=script.Parent.Position&#13;&#10;&#13;&#10;&#9;local e=(goto.x-from.x)*(goto.x-from.x)&#13;&#10;&#9;local f=(goto.z-from.z)*(goto.z-from.z)&#13;&#10;&#9;local distance=math.sqrt(e+f)&#13;&#10;&#13;&#10;if distance&lt;7 then&#13;&#10;script.Parent.Hunger.Value=0&#13;&#10;return&#13;&#10;end&#13;&#10;&#9;--get a good ratio.&#13;&#10;local xa=goto.x-from.x&#13;&#10;local za=goto.z-from.z&#13;&#10;if xa&gt;30 or za&gt;30 then&#13;&#10;&#9;xa=xa/1.3&#13;&#10;&#9;za=za/1.3&#13;&#10;end&#13;&#10;if xa&gt;30 or za&gt;30 then&#13;&#10;&#9;xa=xa/1.3&#13;&#10;&#9;za=za/1.3&#13;&#10;end&#13;&#10;if xa&gt;30 or za&gt;30 then&#13;&#10;&#9;xa=xa/1.3&#13;&#10;&#9;za=za/1.3&#13;&#10;end&#13;&#10;if xa&gt;30 or za&gt;30 then&#13;&#10;&#9;xa=xa/1.3&#13;&#10;&#9;za=za/1.3&#13;&#10;end&#13;&#10;if xa&gt;30 or za&gt;30 then&#13;&#10;&#9;xa=xa/1.3&#13;&#10;&#9;za=za/1.3&#13;&#10;end&#13;&#10;if xa&gt;30 or za&gt;30 then&#13;&#10;&#9;xa=xa/1.3&#13;&#10;&#9;za=za/1.3&#13;&#10;end&#13;&#10;if xa&gt;30 or za&gt;30 then&#13;&#10;&#9;xa=xa/1.3&#13;&#10;&#9;za=za/1.3&#13;&#10;end&#13;&#10;if xa&gt;30 or za&gt;30 then&#13;&#10;&#9;xa=xa/1.3&#13;&#10;&#9;za=za/1.3&#13;&#10;end&#13;&#10;if xa&gt;30 or za&gt;30 then&#13;&#10;&#9;xa=xa/1.3&#13;&#10;&#9;za=za/1.3&#13;&#10;end&#13;&#10;if xa&gt;30 or za&gt;30 then&#13;&#10;&#9;xa=xa/1.3&#13;&#10;&#9;za=za/1.3&#13;&#10;end&#13;&#10;if xa&gt;30 or za&gt;30 then&#13;&#10;&#9;xa=xa/1.3&#13;&#10;&#9;za=za/1.3&#13;&#10;end&#13;&#10;if xa&gt;30 or za&gt;30 then&#13;&#10;&#9;xa=xa/1.3&#13;&#10;&#9;za=za/1.3&#13;&#10;end&#13;&#10;if xa&gt;30 or za&gt;30 then&#13;&#10;&#9;xa=xa/1.3&#13;&#10;&#9;za=za/1.3&#13;&#10;end&#13;&#10;if xa&gt;30 or za&gt;30 then&#13;&#10;&#9;xa=xa/1.3&#13;&#10;&#9;za=za/1.3&#13;&#10;end&#13;&#10;&#9;script.Parent.BodyVelocity.velocity=Vector3.new(xa,20,za)&#13;&#10;&#13;&#10;wait((math.sqrt(xa*xa+za*za))/40)&#13;&#10;dogfindfood()&#13;&#10;&#9;&#13;&#10;end&#13;&#10;&#13;&#10;function dogkill(h)&#13;&#10;&#13;&#10;if h.Parent.Torso.Position~=nil then&#13;&#10;&#9;local goto=h.Parent.Torso.Position&#13;&#10;&#9;local vertdist=goto.y-script.Parent.Position.y&#13;&#10;&#9;if vertdist&gt;14 or vertdist&lt;-10 then&#13;&#10;&#9;&#9;return&#13;&#10;&#9;end&#13;&#10;&#13;&#10;&#9;local from=script.Parent.Position&#13;&#10;&#9;local e=(goto.x-from.x)*(goto.x-from.x)&#13;&#10;&#9;local f=(goto.z-from.z)*(goto.z-from.z)&#13;&#10;&#9;local waittime=math.sqrt(e+f)&#13;&#10;&#9;if waittime&gt;script.Parent.Aggression.Value*10 then&#13;&#10;&#9;&#9;return&#13;&#10;&#9;end&#13;&#10;&#9;if waittime&gt;18 then&#13;&#10;&#9;&#9;script.Parent.BodyVelocity.velocity=Vector3.new(goto.x-from.x,20,goto.z-from.z)&#13;&#10;&#9;&#9;wait(waittime/40)&#13;&#10;&#9;&#9;--script.Parent.BodyVelocity.velocity=Vector3.new(0,-20,0)&#13;&#10;&#9;&#9;dogkill(h)&#13;&#10;&#9;else&#13;&#10;&#9;--&#13;&#10;&#9;--leap and attack&#13;&#10;&#9;&#9;print(&quot;attack!&quot;)&#13;&#10;&#9;&#9;wait(.3)&#13;&#10;&#9;&#9;dogisattacking=1&#13;&#10;&#9;&#9;script.Parent.RotVelocity=Vector3.new(0, 0, 40)&#13;&#10;&#9;&#9;wait(.3)&#13;&#10;&#9;&#9;script.Parent.BodyVelocity.velocity=Vector3.new(6*(goto.x-from.x),130,6*(goto.z-from.z))&#13;&#10;&#9;&#9;wait(.7)&#13;&#10;&#9;&#9;script.Parent.BodyVelocity.velocity=Vector3.new(0,-20,0)&#13;&#10;&#9;&#9;dogisattacking=0&#13;&#10;&#9;&#9;if h.Health&lt;1 then&#13;&#10;&#9;&#9;&#9;return&#13;&#10;&#9;&#9;end&#13;&#10;&#9;&#9;if h.Health==nil then&#13;&#10;&#9;&#9;&#9;return&#13;&#10;&#9;&#9;end&#13;&#10;&#9;&#9;dogkill(h)&#13;&#10;&#9;&#9;--dogisfollowing=0&#13;&#10;&#9;&#9;--dogawake=1&#13;&#10;&#9;end&#13;&#10;else&#13;&#10;&#9;script.Parent.BodyVelocity.velocity=Vector3.new(0,-20,0)&#13;&#10;&#9;--doggohome()&#13;&#10;end&#13;&#10;end&#13;&#10;&#13;&#10;&#13;&#10;function agilchange()&#13;&#10;local agilforce=script.Parent.Agility.Value*125+2000&#13;&#10;script.Parent.BodyVelocity.maxForce=Vector3.new(agilforce,200,agilforce)&#13;&#10;end&#13;&#10;script.Parent.Agility.Changed:connect(agilchange)&#13;&#10;&#13;&#10;function hungchanged()&#13;&#10;local hunger=script.Parent.Hunger.Value&#13;&#10;script.Parent.Agility.Value=10 - hunger&#13;&#10;script.Parent.Happiness.Value=8 - hunger&#13;&#10;end&#13;&#10;script.Parent.Hunger.Changed:connect(hungchange)&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;function doggo()&#13;&#10;wait(2)&#13;&#10;if script.Parent.Hunger.Value&gt;7 then&#13;&#10;&#9;dogfindfood()&#13;&#10;else&#13;&#10;&#9;local ran=math.random(1,50)&#13;&#10;&#9;if ran&lt;5 then&#13;&#10;&#9;&#9;dogcelebrate()&#13;&#10;&#9;else&#13;&#10;&#9;&#9;if ran&lt;43 then&#13;&#10;&#9;&#9;&#9;dogroam()&#13;&#10;&#9;&#9;else&#9;&#13;&#10;&#9;&#9;&#9;if ran&lt;48 then&#13;&#10;&#9;&#9;&#9;&#9;doggohome()&#13;&#10;&#9;&#9;&#9;end&#13;&#10;&#9;&#9;&#9;script.Parent.Hunger.Value=script.Parent.Hunger.Value+1&#13;&#10;&#9;&#9;end&#13;&#10;&#9;end&#13;&#10;end&#13;&#10;wait(1)&#13;&#10;if dogawake==1 then&#13;&#10;&#9;doggo()&#13;&#10;end&#13;&#10;end&#13;&#10;&#13;&#10;script.Parent.Hunger.Value=0&#13;&#10;script.Parent.Agility.Value=8&#13;&#10;script.Parent.Happiness.Value=8&#13;&#10;&#13;&#10;doggo()</string>
