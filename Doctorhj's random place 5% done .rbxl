		<Item class="Script" referent="RBX3200">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">boom door script</string>
				<string name="Source">-- list of account names allowed to go through the door. &#13;&#10;permission = { &quot;MrSabatini&quot;, &quot;tallcore&quot;, &quot;gylfbird&quot;, &quot;blox8&quot;} -- array of humans with permission to enter. &#13;&#10;Door = script.Parent  --define the object of contact in the variable called Door&#13;&#10;&#13;&#10;function checkOkToLetIn(name) &#13;&#10;&#9;for i = 1,#permission do -- repeat for the number of humans in the list&#13;&#10;&#9;-- convert strings to all upper case, otherwise we will let in &#13;&#10;&#9;-- &quot;Telamon&quot; but not &quot;telamon&quot; or &quot;tELAMON&quot; &#13;&#10;&#9;&#9;if (string.upper(name) == string.upper(permission[i])) then -- check for a match&#13;&#10;&#9;&#9;&#9;print(&quot;You have been identified.&quot;) -- print to the output window&#13;&#10;&#9;&#9;&#9;return true end -- we have a match, let them through.&#13;&#10;&#9;&#9;else&#13;&#10;&#9;&#9;&#9;return false -- no match, no entry( dispose of them )&#13;&#10;&#9;&#9;end &#13;&#10;&#9;end&#13;&#10;end&#13;&#10;&#13;&#10;function blow(hit)&#13;&#10;   local h = hit.Parent:FindFirstChild(&quot;Humanoid&quot;)--The Humanoid&#13;&#10;&#13;&#10;   if (h ~= nil) then --Check If The Humanoid Is There&#13;&#10;   explosion = Instance.new(&quot;Explosion&quot;)--Create An Explosion&#13;&#10;   explosion.Position = script.Parent.Position --The Explosions Position Is The Parent&#13;&#10;   explosion.BlastRadius = 5 --A 5 by 5 Explosion.&#13;&#10;   explosion.Parent = game.Workspace --You got to be able to see it.&#13;&#10;   end&#13;&#10;&#13;&#10;end&#13;&#10;&#13;&#10;function onTouched(hit) &#13;&#10;&#9;print(&quot;Door Hit&quot;) -- print to the output window&#13;&#10;&#9;local human = hit.Parent:findFirstChild(&quot;Humanoid&quot;) &#13;&#10;&#9;if (human ~= nil ) then -- check to see if we have a humanoid&#13;&#10;&#9;&#9;if (checkOkToLetIn(human.Parent.Name)) then &#13;&#10;&#9;&#9;&#9;print(&quot;Human passed test&quot;) -- print to the output window&#13;&#10;&#9;&#9;&#9;Door.Transparency = 0.5 -- make the door semi-transparent&#13;&#10;&#9;&#9;&#9;Door.CanCollide = false -- open the door&#13;&#10;&#9;&#9;&#9;wait(1) -- allow one second to enter&#13;&#10;&#9;&#9;&#9;Door.CanCollide = true -- close the door&#13;&#10;&#9;&#9;&#9;Door.Transparency = 0 -- make the door look solid again&#13;&#10;&#9;&#9;else -- else this is an intruder (GO BOOM!)&#13;&#10;&#9;&#9;&#9;print(&quot;You cannot pass.&quot;)&#13;&#10;&#9;&#9;&#9;human.Health = 0&#13;&#10;&#9;&#9;&#9;Door.Touched:connect(blow)&#13;&#10;&#9;&#9;end &#13;&#10;&#9;end &#13;&#10;end &#13;&#10;Door.Touched:connect(onTouched)&#13;&#10;</string>
				<bool name="archivable">true</bool>
			</Properties>
		</Item>
