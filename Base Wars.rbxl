			<Item class="Script" referent="RBX3639">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">ClassSystem</string>
					<ProtectedString name="Source">player = script.Parent.Parent.Parent
backpack = player.Backpack
permission = {&quot;darksword793&quot;,&quot;antfile&quot;,&quot;newbierr&quot;,&quot;thedestroyerofdoom&quot;,&quot;thch&quot;,&quot;hotdog64&quot;,&quot;sparkyw9&quot;,&quot;886lab&quot;,&quot;soldier4425&quot;,&quot;d4rk886&quot;,&quot;688kard&quot;,&quot;LazyDemon&quot;,&quot;ArmoredHeavyGunner&quot;,&quot;o0Harris0o&quot;,&quot;jhuber817&quot;,&quot;juno12345&quot;,&quot;Terminator855&quot;,&quot;secondaaannn&quot;,&quot;Brokenblock23&quot;,&quot;Bloxerfan099&quot;,&quot;Viner90&quot;,&quot;Eseth2&quot;}
local clicked = false

if player.TeamColor == BrickColor.new(&quot;Really black&quot;) then
&#9;script.Parent:remove()
end

viptexture = &quot;http://www.roblox.com/asset/?id=16966401&quot;
mviptexture = &quot;http://www.roblox.com/asset/?id=21982726&quot;

function check(name)
&#9;for i = 1,#permission do 
&#9;&#9;if (string.upper(name) == string.upper(permission[i])) then return true end 
&#9;end 
&#9;return false 
end 

function chooseClass(class)
&#9;if clicked == false then
&#9;clicked = true
&#9;if class.Name == &quot;VIP&quot; then 
&#9;&#9;vip(class)
&#9;&#9;return
&#9;end
&#9;if class.Name == &quot;MVIP&quot; then
&#9;&#9;mvip(class)
&#9;&#9;return 
&#9;end
&#9;needcash = class:findFirstChild(&quot;Cash&quot;)
&#9;needspree = class:findFirstChild(&quot;Spree&quot;)
&#9;speed = class:findFirstChild(&quot;Speed&quot;)
&#9;&#9;ls = player:findFirstChild(&quot;leaderstats&quot;)
&#9;&#9;cash = ls:findFirstChild(&quot;Cash&quot;)
&#9;&#9;spree = ls:findFirstChild(&quot;KOs&quot;)
&#9;&#9;&#9;&#9;if cash.Value &gt;= needcash.Value then
&#9;&#9;&#9;&#9;&#9;cash.Value = cash.Value - needcash.Value
&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;if not check(player.Name) then
&#9;&#9;&#9;&#9;&#9;&#9;clicked = false
&#9;&#9;&#9;&#9;&#9;&#9;return 
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;if spree.Value &gt;= needspree.Value then
&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;if not check(player.Name) then
&#9;&#9;&#9;&#9;&#9;&#9;clicked = false
&#9;&#9;&#9;&#9;&#9;&#9;return
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;for i, v in pairs(class:GetChildren()) do
&#9;&#9;&#9;&#9;&#9;if v.className == &quot;StringValue&quot; then
&#9;&#9;&#9;&#9;&#9;&#9;game.Lighting:findFirstChild(v.Name):clone().Parent = backpack
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;if speed then
&#9;&#9;&#9;&#9;&#9;player.Character.Humanoid.WalkSpeed=speed.Value
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;script.Parent:remove()
&#9;end
end

function vip(class)
&#9;if player.Character.Torso.roblox.Texture == viptexture or check(player.Name) then
&#9;&#9;for i, v in pairs(class:GetChildren()) do
&#9;&#9;&#9;if v.className == &quot;StringValue&quot; then
&#9;&#9;&#9;&#9;game.Lighting:findFirstChild(v.Name):clone().Parent = backpack
&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;script.Parent.Main.Visible = false
&#9;else 
&#9;&#9;clicked = false
&#9;end
end

function mvip(class)
&#9;if player.Character.Torso.roblox.Texture == mviptexture or check(player.Name) then
&#9;&#9;for i, v in pairs(class:GetChildren()) do
&#9;&#9;&#9;if v.className == &quot;StringValue&quot; then
&#9;&#9;&#9;&#9;game.Lighting:findFirstChild(v.Name):clone().Parent = backpack
&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;script.Parent.Main.Visible = false
&#9;else
&#9;&#9;clicked = false
&#9;end
end

for i, v in pairs(script.Parent.Main:GetChildren()) do
&#9;if v:IsA(&quot;TextButton&quot;) then
&#9;&#9;v.MouseButton1Down:connect(function () chooseClass(v) end)
&#9;end
end

wait(2)
script.Parent.Main.Visible = true

print(&quot;class system by dark886 loaded&quot;)</ProtectedString>
