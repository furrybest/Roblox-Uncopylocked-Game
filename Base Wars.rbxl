			<Item class="Script" referent="RBX3642">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<ProtectedString name="Source">main = script.Main

closea = main.Title.TextButton
opena = script.Parent.Open
note = main.Note

line = {note[&quot;01&quot;],note[&quot;02&quot;],note[&quot;03&quot;],note[&quot;04&quot;],note[&quot;05&quot;],note[&quot;06&quot;],note[&quot;07&quot;],note[&quot;08&quot;],note[&quot;09&quot;],note[&quot;10&quot;],note[&quot;11&quot;],note[&quot;12&quot;],note[&quot;13&quot;],note[&quot;14&quot;],note[&quot;15&quot;],note[&quot;16&quot;],note[&quot;17&quot;],note[&quot;18&quot;],note[&quot;19&quot;]}

page1 = {
&quot;Welcome , This is a game scripted and builded by darksword793 , If you like it , please fav this game&quot;,
&quot;Here will teach you how to play this game and how to fix that problem you may face &quot;,
&quot;First , this is a war game, You need weapon to play.&quot;,
&quot;You will see a gui with many colorful button, right ? This is a class/weapon chooser&quot;,
&quot;Some of the class need cash or ko to choose. Just read the button then you will know what required for that class&quot;,
&quot;Just choose a class to start, If it broke, Just simply reset by using reset gui at LEFT side of SCREEN&quot;,
&quot;You can find many information in these gui, Just read it when you need &quot;,
&quot;Cursor color : Red = enemy , Yellow = non-player , Green = Teammate&quot;,
&quot;Always remember do not team killing, Because team killing will -1 KOs , -120 Cash and +1 WOs&quot;,
&quot;Maybe you will wondering why there don&apos;t have tool for vehicle. There is auto give tool when you need&quot;,
&quot;Just simply sit on the Driver seat and you will get the tool you need &quot;,
&quot;If you don&apos;t know how to control the vehicle or turret, Just read the gui near the top of screen. &quot;,
&quot;If you can&apos;t get the tool or the gun not working , that mean you got weak connection or delay , Rejoin to fix it&quot;,
&quot;If you got killed , you may check out the &apos;Last 3 Killing Display Board&apos; to check out who owned you&quot;,
&quot;How to use the Ammo giver : hold weapon and move yourself near to ammo box,wait 2 second &quot;,
&quot;then reload your weapon. It will fill up your ammo of that gun, If it not work,use Mouse click on the purple button&quot;,
&quot;Regen : Use mouse to click on the purple button , It is not step on the weapon .&quot;,
&quot;Artillery set up: Set up it before use , use the tool that given by car , press &apos;C&apos; to set up&quot;,
&quot;That all, If you still got anyone problem or question , send pm to dark886 or ask other player &quot;}

function printnote()
&#9;for i=1 , #line do
&#9;&#9;line[i].Text = page1[i]
&#9;end
end

function close()
&#9;main.Parent = script
end
closea.MouseButton1Down:connect(close)

function open()
&#9;printnote()
&#9;main.Parent = script.Parent
end
opena.MouseButton1Down:connect(open)
&#9;</ProtectedString>
