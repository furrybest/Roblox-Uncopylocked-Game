			<Item class="Script" referent="RBX3745">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<ProtectedString name="Source">Tool = script.Parent

function fire(mouse_pos)
local house = game.Lighting.SupplyHouse:clone()
house.Parent = Tool.Parent
house:MoveTo(mouse_pos)
Tool:remove()
end

Tool.Enabled = true
function onActivated()

&#9;if not Tool.Enabled then
&#9;&#9;return
&#9;end

&#9;Tool.Enabled = false

&#9;local character = Tool.Parent;
&#9;local humanoid = character.Humanoid
&#9;if humanoid == nil then
&#9;&#9;print(&quot;Humanoid not found&quot;)
&#9;&#9;return 
&#9;end

&#9;local targetPos = humanoid.TargetPoint
&#9;if (targetPos - character.Head.Position).magnitude &lt; 50 then
&#9;&#9;fire(targetPos)
&#9;end

&#9;wait(.2)

&#9;Tool.Enabled = true
end

script.Parent.Activated:connect(onActivated)</ProtectedString>
