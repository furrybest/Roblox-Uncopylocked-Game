			<Item class="LocalScript" referent="RBX4185">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">FireMode</string>
					<ProtectedString name="Source">on = 0
Tool = script.Parent
welds = {}
sh = {}
arms = nil
torso = nil
f = nil
function Crouch(ison)
if arms == nil and torso == nil then
arms = {Tool.Parent:FindFirstChild(&quot;Left Leg&quot;), Tool.Parent:FindFirstChild(&quot;Right Leg&quot;)}
torso = Tool.Parent:FindFirstChild(&quot;Torso&quot;)
end
if arms ~= nil and torso ~= nil then
sh = {torso:FindFirstChild(&quot;Left Hip&quot;), torso:FindFirstChild(&quot;Right Hip&quot;)}
if sh ~= nil then
local yes = true
if yes then
yes = false
if ison == 1 then
sh[1].Part1 = nil
sh[2].Part1 = nil
local weld1 = Instance.new(&quot;Weld&quot;)
weld1.Part0 = torso
weld1.Parent = torso
weld1.Part1 = arms[1]
weld1.C1 = CFrame.new(-0.5, 1.5, 0.2) * CFrame.fromEulerAnglesXYZ(math.rad(40), 0, math.rad(0))
arms[1].Name = &quot;LDave&quot;
arms[1].CanCollide = true
welds[1] = weld1
-------------------------------------------
local weld2 = Instance.new(&quot;Weld&quot;)
weld2.Part0 = torso
weld2.Parent = torso
weld2.Part1 = arms[2]
weld2.C1 = CFrame.new(0.5, 1.5, -0.2) * CFrame.fromEulerAnglesXYZ(math.rad(-40), math.rad(0), 0)
arms[2].Name = &quot;RDave&quot;
arms[2].CanCollide = true
welds[2] = weld2
Tool.FireMode.Value = true 
ws = script.WalkSpeed
ws.Value = Tool.Parent.Humanoid.WalkSpeed
Tool.Parent.Humanoid.WalkSpeed = 0.1
Equip(mouse)
FireOn()

---------------------------------
local force = Instance.new(&quot;BodyForce&quot;)
force.Parent = torso
f = force
wait(0.01)
elseif ison == 0 then
if arms then
sh[1].Part1 = arms[1]
sh[2].Part1 = arms[2]
f.Parent = nil
arms[2].Name = &quot;Right Leg&quot;
arms[1].Name = &quot;Left Leg&quot;
Tool.FireMode.Value = false
welds[1].Parent = nil
welds[2].Parent = nil
Unequip(mouse)
FireOff()
Tool.Parent.Humanoid.WalkSpeed = ws.Value
end
end
--
end
else
print(&quot;sh&quot;)
end
else
print(&quot;arms&quot;)
end
end
function Key(key)
if key then
key = string.lower(key)
if (key==&quot;c&quot;) then
if on == 1 then
on = 0
elseif on == 0 then
on = 1
end
Crouch(on)
end
end
end
function Equip(mouse)
mouse.KeyDown:connect(Key)
end
script.Parent.Equipped:connect(Equip)

function FireOn()
&#9;Tool.Handle.Decal.Parent = Tool
&#9;Tool.Handle.Decal1.Parent = Tool


&#9;Tool.GripForward = Vector3.new(-0.196, 0.981, -0)
&#9;Tool.GripPos = Vector3.new(0.5, 0.5, -0.8)
&#9;Tool.GripRight = Vector3.new(0.981, 0.196, -0)
&#9;Tool.GripUp = Vector3.new(0, 0, 1)

&#9;Tool.Handle.Transparency = 1

&#9;p= Tool:GetChildren() 
&#9;for i= 1, #p do 
&#9;if p[i].className == &quot;Part&quot; and p[i].Name ~= &quot;Handle&quot; then 
&#9;p[i].Transparency = 0
&#9;end 
&#9;end 
end 

function FireOff()
&#9;Tool.Decal.Parent = Tool.Handle
&#9;Tool.Decal1.Parent = Tool.Handle

&#9;Tool.GripForward = Vector3.new(-0, 1, -0)
&#9;Tool.GripPos = Vector3.new(0, 0, 1)
&#9;Tool.GripRight = Vector3.new(1, 0, -0)
&#9;Tool.GripUp = Vector3.new(0, 0, 1)

&#9;Tool.Handle.Transparency = 0

&#9;p= Tool:GetChildren() 
&#9;for i= 1, #p do 
&#9;if p[i].className == &quot;Part&quot; and p[i].Name ~= &quot;Handle&quot; then 
&#9;p[i].Transparency = 1
&#9;end 
&#9;end 
end 

local arms = nil
local torso = nil
local welds = {}

function Equip(mouse)
wait(0.01)
arms = {Tool.Parent:FindFirstChild(&quot;Left Arm&quot;), Tool.Parent:FindFirstChild(&quot;Right Arm&quot;)}
torso = Tool.Parent:FindFirstChild(&quot;Torso&quot;)
if arms ~= nil and torso ~= nil then
local sh = {torso:FindFirstChild(&quot;Left Shoulder&quot;), torso:FindFirstChild(&quot;Right Shoulder&quot;)}
if sh ~= nil then
local yes = true
if yes then
yes = false
sh[1].Part1 = nil
sh[2].Part1 = nil
local weld1 = Instance.new(&quot;Weld&quot;)
weld1.Part0 = torso
weld1.Parent = torso
weld1.Part1 = arms[1]
weld1.C1 = CFrame.new(-0.5, 0.8, .9)* CFrame.fromEulerAnglesXYZ(math.rad(290), 0, math.rad(-90))
welds[1] = weld1
local weld2 = Instance.new(&quot;Weld&quot;)
weld2.Part0 = torso
weld2.Parent = torso
weld2.Part1 = arms[2]
weld2.C1 = CFrame.new(-1, 0.8, 0.5) * CFrame.fromEulerAnglesXYZ(math.rad(-90), math.rad(-15), 0)
welds[2] = weld2
end
else
print(&quot;sh&quot;)
end
else
print(&quot;arms&quot;)
end
end

function Unequip(mouse)
if arms ~= nil and torso ~= nil then
local sh = {torso:FindFirstChild(&quot;Left Shoulder&quot;), torso:FindFirstChild(&quot;Right Shoulder&quot;)}
if sh ~= nil then
local yes = true
if yes then
yes = false
sh[1].Part1 = arms[1]
sh[2].Part1 = arms[2]
welds[1].Parent = nil
welds[2].Parent = nil
end
else
print(&quot;sh&quot;)
end
else
print(&quot;arms&quot;)
end
end

Tool.Unequipped:connect(Unequip)


</ProtectedString>
