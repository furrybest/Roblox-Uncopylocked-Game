			<Item class="LocalScript" referent="RBX4743">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Local Gui ADD-ON</string>
					<ProtectedString name="Source">--This is the Local Gui add-On. Cursor on enemy = Cursor choose red. Cursor on teammate = Cursor choose green.
--Cursor on Brick = Cursor choose grey. You should have a real Local Gui script because this has NO RELOAD CURSOR!
--This shows the playername in hint format, too. Works great with this leaderboard together.
--This is made by Alextomcool. I did just edit it. He make great add-Ons for weapons. Look at his site and pick some up!

print(&quot;LocalGui Add-On loaded&quot;)

bin = script.Parent
normel = &quot;http://www.roblox.com/asset/?id=16110835&quot;
friendly = &quot;http://www.roblox.com/asset/?id=16110837&quot;
enemy = &quot;http://www.roblox.com/asset/?id=16110845&quot;
function Run(mouse)
&#9;mouse.Icon = normel
        person = script.Parent.Parent.Parent
        local hint = Instance.new(&quot;Hint&quot;)
        hint.Parent = nil
        hint.Name = &quot;hint&quot;
&#9;local hit = mouse.Target
&#9;if (hit == nil) then return end
        h = hit.Parent:FindFirstChild(&quot;Humanoid&quot;)
        if h ~= nil then
        player = game.Players:GetPlayerFromCharacter(hit.Parent)
        if player ~= nil then
        if h.Health &gt; 0 then
&#9;if (player.TeamColor == person.TeamColor) then
        mouse.Icon = friendly
        if person:FindFirstChild(&quot;hint&quot;) == nil then
        hint.Text = player.Name
        hint.Parent = person
        else
        hint.Text = player.Name       
        end
        elseif player.TeamColor ~= person.TeamColor then
        mouse.Icon = enemy
        end
        end
        else
        nuh = person:FindFirstChild(&quot;hint&quot;)
        if nuh ~= nil then
        nuh.Parent = nil
        end
        end
        else
        nuh = person:FindFirstChild(&quot;hint&quot;)
        if nuh ~= nil then
        nuh.Parent = nil
        end
&#9;end
end







function on(mouse)
        while true do
&#9;if script.Parent.Active == false then break end 
        wait()
&#9;Run(mouse)
        end
end



script.Parent.Selected:connect(on)

</ProtectedString>
				</Properties>
			</Item>
		</Item>
		<Item class="HopperBin" referent="RBX4744">
			<Properties>
				<bool name="Active">false</bool>
				<token name="BinType">0</token>
				<string name="Name">Zombie Delete</string>
				<Content name="TextureId"><null></null></Content>
			</Properties>
			<Item class="Script" referent="RBX4745">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<ProtectedString name="Source">local bin = script.Parent
local type = &quot;Cash&quot;
local donate = 240

function onButton1Down(mouse)
&#9;local hit = mouse.Target
&#9;if hit == nil then return end
&#9;if hit.Parent:findFirstChild(&quot;Zombie&quot;) ~= nil then
&#9;&#9;hit.Parent:remove()
&#9;&#9;local player = game.Players.LocalPlayer
&#9;&#9;local cash = player.leaderstats:findFirstChild(type)
&#9;&#9;cash.Value = cash.Value + donate 
&#9;end
end

function onDeselected(mouse)

end 

function onSelected(mouse)
&#9;m=Instance.new(&quot;Message&quot;)
&#9;m.Text = &quot;Easter Zombie Delete Tool&quot;
&#9;m.Parent = game.Players.LocalPlayer
&#9;game.Debris:AddItem(m,6)
&#9;mouse.Icon = &quot;rbxasset://textures\\HammerCursor.png&quot;
&#9;mouse.Button1Down:connect(function() onButton1Down(mouse) end)
end

bin.Selected:connect(onSelected)
bin.Deselected:connect(onDeselected)</ProtectedString>
				</Properties>
			</Item>
