			<Item class="Script" referent="RBX4728">
				<Properties>
					<bool name="Disabled">true</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">LaserBlast</string>
					<ProtectedString name="Source">ball = script.Parent
damage = 11

function onTouched(hit)
&#9;if hit.Name == &quot;Bullet&quot; then return end
&#9;if script.Parent.Position.Y &lt; 15 then return end 
&#9;local humanoid = hit.Parent:findFirstChild(&quot;Humanoid&quot;) or hit.Parent.Parent:findFirstChild(&quot;Humanoid&quot;)
&#9;connection:disconnect()
&#9;if humanoid ~= nil then
&#9;&#9;hitted = game.Players:findFirstChild(humanoid.Parent.Name)
&#9;&#9;owner = ball:findFirstChild(&quot;creator&quot;).Value
&#9;&#9;if hitted ~= nil then
&#9;&#9;&#9;if hitted.TeamColor == owner.TeamColor then
&#9;&#9;&#9;&#9;ball:remove()
&#9;&#9;&#9;&#9;return
&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;tagHumanoid(humanoid)
&#9;&#9;if hit.Name == &quot;Head&quot; then damage = damage * 2 end  
&#9;&#9;&#9;if not humanoid.Parent:findFirstChild(&quot;ForceField&quot;) then
&#9;&#9;&#9;&#9;humanoid.Health = humanoid.Health - damage
&#9;&#9;&#9;end
&#9;&#9;wait(1)
&#9;&#9;untagHumanoid(humanoid)
&#9;else
&#9;&#9;if hit.Anchored == false and hit.Parent.className == &quot;Model&quot; then 
&#9;&#9;&#9;if hit:findFirstChild(&quot;damaged&quot;) then
&#9;&#9;&#9;&#9;if hit.Parent:findFirstChild(&quot;Boat&quot;) then
&#9;&#9;&#9;&#9;&#9;hit.damaged.Value = hit.damaged.Value + 1
&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;hit.damaged.Value = hit.damaged.Value + 6
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;if hit.damaged.Value &gt;= 20 then 
&#9;&#9;&#9;&#9;&#9;hit:BreakJoints()
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;local p = Instance.new(&quot;IntValue&quot;)
&#9;&#9;&#9;&#9;p.Name = &quot;damaged&quot;
&#9;&#9;&#9;&#9;if hit.Parent:findFirstChild(&quot;Boat&quot;) then
&#9;&#9;&#9;&#9;&#9;p.Value = 1
&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;p.Value = 6
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;p.Parent = hit
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
&#9;ball:remove()
end

function tagHumanoid(humanoid)
&#9;-- todo: make tag expire
&#9;local tag = ball:findFirstChild(&quot;creator&quot;)
&#9;if tag ~= nil then
&#9;&#9;local new_tag = tag:clone()
&#9;&#9;new_tag.Parent = humanoid
&#9;end
end

function untagHumanoid(humanoid)
&#9;if humanoid ~= nil then
&#9;&#9;local tag = humanoid:findFirstChild(&quot;creator&quot;)
&#9;&#9;if tag ~= nil then
&#9;&#9;&#9;tag.Parent = nil
&#9;&#9;end
&#9;end
end



connection = ball.Touched:connect(onTouched)
wait(5)
script.Parent:remove()</ProtectedString>
				</Properties>
			</Item>
			<Item class="LocalScript" referent="RBX4729">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Local Gui ADD-ON</string>
					<ProtectedString name="Source">--This is the Local Gui add-On. Cursor on enemy = Cursor choose red. Cursor on teammate = Cursor choose green.
--Cursor on Brick = Cursor choose grey. You should have a real Local Gui script because this has NO RELOAD CURSOR!
--This shows the playername in hint format, too. Works great with this leaderboard together.
--This is made by Alextomcool. I did just edit it. He make great add-Ons for weapons. Look at his site and pick some up!

print(&quot;LocalGui Add-On loaded&quot;)

bin = script.Parent
normel = &quot;http://www.roblox.com/asset/?id=16110835&quot;
friendly = &quot;http://www.roblox.com/asset/?id=16110837&quot;
enemy = &quot;http://www.roblox.com/asset/?id=16110845&quot;
function Run(mouse)
&#9;mouse.Icon = normel
        person = script.Parent.Parent.Parent
        local hint = Instance.new(&quot;Hint&quot;)
        hint.Parent = nil
        hint.Name = &quot;hint&quot;
&#9;local hit = mouse.Target
&#9;if (hit == nil) then return end
        h = hit.Parent:FindFirstChild(&quot;Humanoid&quot;)
        if h ~= nil then
        player = game.Players:GetPlayerFromCharacter(hit.Parent)
        if player ~= nil then
        if h.Health &gt; 0 then
&#9;if (player.TeamColor == person.TeamColor) then
        mouse.Icon = friendly
        if person:FindFirstChild(&quot;hint&quot;) == nil then
        hint.Text = player.Name
        hint.Parent = person
        else
        hint.Text = player.Name       
        end
        elseif player.TeamColor ~= person.TeamColor then
        mouse.Icon = enemy
        end
        end
        else
        nuh = person:FindFirstChild(&quot;hint&quot;)
        if nuh ~= nil then
        nuh.Parent = nil
        end
        end
        else
        nuh = person:FindFirstChild(&quot;hint&quot;)
        if nuh ~= nil then
        nuh.Parent = nil
        end
&#9;end
end







function on(mouse)
        while true do
&#9;if script.Parent.Active == false then break end 
        wait()
&#9;Run(mouse)
        end
end



script.Parent.Selected:connect(on)

