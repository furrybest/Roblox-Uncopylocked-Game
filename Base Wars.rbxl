		<Item class="HopperBin" referent="RBX4635">
			<Properties>
				<bool name="Active">false</bool>
				<token name="BinType">0</token>
				<string name="Name">AATurret</string>
				<Content name="TextureId"><null></null></Content>
			</Properties>
			<Item class="Script" referent="RBX4636">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">PlaneFlyer</string>
					<ProtectedString name="Source">bin=script.Parent
plane=nil
hold=false
local debounce = false
local planedebounce = false
local stuntdebounce = false
local controlling = false

function fire(pln,spn,mouse)
&#9;&#9;local p = Instance.new(&quot;Part&quot;)
&#9;&#9;p.Name = &quot;Bullet&quot;
&#9;&#9;p.CFrame = spn.CFrame + (spn.CFrame.lookVector * 50)
&#9;&#9;p.BrickColor = BrickColor.new(&quot;Bright orange&quot;)
&#9;&#9;p.Reflectance = 0.1
&#9;&#9;p.Size = Vector3.new(1, 1,20)
&#9;&#9;p.formFactor = 2
&#9;&#9;p.CanCollide = false
&#9;&#9;local upforce = Instance.new(&quot;BodyForce&quot;)
&#9;&#9;upforce.force = Vector3.new(0, p:GetMass() * 196, 0)
&#9;&#9;upforce.Parent = p
&#9;&#9;p.Velocity = spn.CFrame.lookVector * 600
&#9;&#9;local new_script = script.Parent.LaserBlast:clone()
&#9;&#9;new_script.Disabled = false
&#9;&#9;new_script.Parent = p
&#9;&#9;script.Parent.Mesh:clone().Parent= p
&#9;&#9;local creator_tag = Instance.new(&quot;ObjectValue&quot;)
&#9;&#9;creator_tag.Value = game.Players.LocalPlayer
&#9;&#9;creator_tag.Name = &quot;creator&quot;
&#9;&#9;creator_tag.Parent = p
&#9;&#9;spn.Fire:Play()
&#9;&#9;p.Parent = game.Workspace
--[[
&#9;local missile = bin.Rocket:clone()
--&#9;if mouse.Target ~= nil then
--&#9;&#9;if mouse.Target.Parent.Name == &quot;Parts&quot; then
--&#9;&#9;&#9;tart = Instance.new(&quot;ObjectValue&quot;)
--&#9;&#9;&#9;tart.Value = mouse.Target
--&#9;&#9;&#9;tart.Name = &quot;target&quot;
--&#9;&#9;&#9;tart.Parent = missile
--&#9;&#9;end
--&#9;end
&#9;missile.CFrame = spn.CFrame * CFrame.new(0, 0, -30)
&#9;missile.RocketScript.Disabled = false
&#9;missile.Parent = game.Workspace
&#9;local creator_tag = Instance.new(&quot;ObjectValue&quot;)
&#9;creator_tag.Value = game.Players.LocalPlayer
&#9;creator_tag.Name = &quot;creator&quot;
&#9;creator_tag.Parent = missile
&#9;missile.Owner.Value = pln]]
end

function computeDirection(vec)
&#9;local lenSquared = vec.magnitude * vec.magnitude
&#9;local invSqrt = 1 / math.sqrt(lenSquared)
&#9;return Vector3.new(vec.x * invSqrt, vec.y * invSqrt, vec.z * invSqrt)
end

function move(target, engine)
&#9;if bin.Parent == nil then return end 
&#9;local origincframe = engine:findFirstChild(&quot;BodyGyro&quot;).cframe
&#9;local dir = (target - engine.Position).unit
&#9;local spawnPos = engine.Position

&#9;local pos = spawnPos + (dir * 1)

&#9;engine:findFirstChild(&quot;BodyGyro&quot;).maxTorque = Vector3.new(9000, 9000, 9000)
&#9;engine:findFirstChild(&quot;BodyGyro&quot;).cframe = CFrame.new(pos,  pos + dir)
--&#9;wait(0.1)
--&#9;engine:findFirstChild(&quot;BodyGyro&quot;).maxTorque = Vector3.new(0, 0, 0)
--&#9;engine:findFirstChild(&quot;BodyGyro&quot;).cframe = origincframe
end

function findPlane(player)
&#9;local list = player.Character:GetChildren()
&#9;for x = 1, #list do
&#9;&#9;if (list[x].Name == &quot;AA&quot;) then
&#9;&#9;&#9;local weld = list[x]:FindFirstChild(&quot;Parts&quot;):FindFirstChild(&quot;Seat&quot;):FindFirstChild(&quot;SeatWeld&quot;)
&#9;&#9;&#9;if (weld ~= nil) and (weld.Part1 == player.Character:FindFirstChild(&quot;Torso&quot;)) then
&#9;&#9;&#9;&#9;return list[x]
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
&#9;return nil
end

function onButton1Down(mouse)
&#9;if bin.Parent == nil then return end 
&#9;local vehicle = findPlane(script.Parent.Parent.Parent)
&#9;if vehicle ~= nil and debounce == false and planedebounce == false then
&#9;debounce = true
&#9;controlling = true

&#9;while true do
&#9;&#9;wait()
&#9;&#9;if bin.Parent == nil then return end 
&#9;&#9;local engine = vehicle.Parts.GunEngine
&#9;&#9;local position = mouse.Hit
&#9;&#9;local target = position.p
&#9;&#9;move(target, engine)
&#9;&#9;if planedebounce == true or
&#9;&#9;controlling == false then break end
&#9;end
&#9;wait(.1)
&#9;debounce = false
&#9;end
end

function onButton1Up(mouse)
&#9;controlling = false
end

function onSelected(mouse)
&#9;mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
&#9;mouse.Button1Down:connect(function() onButton1Down(mouse) end)
&#9;mouse.Button1Up:connect(function() onButton1Up(mouse) end)
&#9;mouse.KeyDown:connect(function (key) onKeyDown(key,mouse) end)
&#9;mouse.KeyUp:connect(onKeyUp)
&#9;--mouse.Move:connect(function () onMouseMove(mouse) end)
&#9;message = game.Players.LocalPlayer.PlayerGui.help.Vehicle
&#9;message.Text = &quot;AAGun control ---  Gun Direction Control : [MouseClick] , Fire the gun : F &quot;
end

function onMouseMove(mouse)
&#9;--print(mouse.Target.Name)
end

function onKeyDown(key,mouse)
&#9;if (key~=nil) then
&#9;&#9;key = key:lower()
&#9;&#9;local vehicle = findPlane(script.Parent.Parent.Parent)
&#9;&#9;if (vehicle==nil) then return end
&#9;&#9;plane = vehicle.Parts
&#9;&#9;local engine = vehicle.Parts.GunEngine
&#9;&#9;&#9;if (key==&quot;f&quot;) then
&#9;&#9;&#9;&#9;bin.Reload.Value = 1
&#9;&#9;&#9;&#9;while true do
&#9;&#9;&#9;&#9;&#9;if bin.Reload.Value == 0 then break end
&#9;&#9;&#9;&#9;&#9;fire(vehicle,plane.Gun1,mouse)
&#9;&#9;&#9;&#9;&#9;fire(vehicle,plane.Gun2,mouse)
&#9;&#9;&#9;&#9;&#9;wait(0.2)
&#9;&#9;&#9;&#9;end

&#9;&#9;&#9;end
&#9;end
end

function onKeyUp(key)
&#9;key:lower()
&#9;if key == &quot;f&quot; then
&#9;&#9;if bin.Reload.Value == 1 then 
&#9;&#9;&#9;bin.Reload.Value = 0
&#9;&#9;end
&#9;end
end


bin.Selected:connect(onSelected)
</ProtectedString>
				</Properties>
				<Item class="Script" referent="RBX4637">
					<Properties>
						<bool name="Disabled">true</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">FlyScript</string>
						<ProtectedString name="Source">local engine = script.Parent.Parent.Engine
local spd = 3
local position = engine.Position

while true do
&#9;wait(.1)
&#9;direction = engine.CFrame.lookVector 
&#9;position = position + spd*3*direction
&#9;error = position - engine.Position
&#9;engine.Velocity = spd*error
&#9;engine.RotVelocity = Vector3.new(0, 0, 0)
end 
</ProtectedString>
					</Properties>
				</Item>
			</Item>
			<Item class="IntValue" referent="RBX4638">
				<Properties>
					<string name="Name">Reload</string>
					<int name="Value">0</int>
				</Properties>
			</Item>
			<Item class="SpecialMesh" referent="RBX4639">
				<Properties>
					<token name="LODX">2</token>
					<token name="LODY">2</token>
					<Content name="MeshId"><null></null></Content>
					<token name="MeshType">3</token>
					<string name="Name">Mesh</string>
					<Vector3 name="Offset">
						<X>0</X>
						<Y>0</Y>
						<Z>0</Z>
					</Vector3>
					<Vector3 name="Scale">
						<X>0.200000003</X>
						<Y>0.200000003</Y>
						<Z>1</Z>
					</Vector3>
					<Content name="TextureId"><null></null></Content>
					<Vector3 name="VertexColor">
						<X>1</X>
						<Y>1</Y>
						<Z>1</Z>
					</Vector3>
				</Properties>
			</Item>
			<Item class="Script" referent="RBX4640">
				<Properties>
					<bool name="Disabled">true</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">LaserBlast</string>
					<ProtectedString name="Source">ball = script.Parent
damage = 15

function onTouched(hit)
&#9;if hit.Name == &quot;Bullet&quot; then return end
&#9;if script.Parent.Position.Y &lt; 15 then return end 
&#9;local humanoid = hit.Parent:findFirstChild(&quot;Humanoid&quot;) or hit.Parent.Parent:findFirstChild(&quot;Humanoid&quot;)
&#9;connection:disconnect()
&#9;if humanoid ~= nil then
&#9;&#9;hitted = game.Players:findFirstChild(humanoid.Parent.Name)
&#9;&#9;owner = ball:findFirstChild(&quot;creator&quot;).Value
&#9;&#9;if hitted ~= nil then
&#9;&#9;&#9;if hitted.TeamColor == owner.TeamColor then
&#9;&#9;&#9;&#9;ball:remove()
&#9;&#9;&#9;&#9;return
&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;tagHumanoid(humanoid)
&#9;&#9;if hit.Name == &quot;Head&quot; then damage = damage * 2 end  
&#9;&#9;&#9;if not humanoid.Parent:findFirstChild(&quot;ForceField&quot;) then
&#9;&#9;&#9;&#9;humanoid.Health = humanoid.Health - damage
&#9;&#9;&#9;end
&#9;&#9;wait(1)
&#9;&#9;untagHumanoid(humanoid)
&#9;else
&#9;&#9;if hit.Anchored == false and hit.Parent.className == &quot;Model&quot; then 
&#9;&#9;&#9;if hit:findFirstChild(&quot;damaged&quot;) then
&#9;&#9;&#9;&#9;if hit.Parent:findFirstChild(&quot;Boat&quot;) then
&#9;&#9;&#9;&#9;&#9;hit.damaged.Value = hit.damaged.Value + 2
&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;hit.damaged.Value = hit.damaged.Value + 20
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;if hit.damaged.Value &gt;= 20 then 
&#9;&#9;&#9;&#9;&#9;hit:BreakJoints()
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;local p = Instance.new(&quot;IntValue&quot;)
&#9;&#9;&#9;&#9;p.Name = &quot;damaged&quot;
&#9;&#9;&#9;&#9;if hit.Parent:findFirstChild(&quot;Boat&quot;) then
&#9;&#9;&#9;&#9;&#9;p.Value = 2
&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;p.Value = 20
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;p.Parent = hit
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
&#9;ball:remove()
end

function tagHumanoid(humanoid)
&#9;-- todo: make tag expire
&#9;local tag = ball:findFirstChild(&quot;creator&quot;)
&#9;if tag ~= nil then
&#9;&#9;local new_tag = tag:clone()
&#9;&#9;new_tag.Parent = humanoid
&#9;end
end

function untagHumanoid(humanoid)
&#9;if humanoid ~= nil then
&#9;&#9;local tag = humanoid:findFirstChild(&quot;creator&quot;)
&#9;&#9;if tag ~= nil then
&#9;&#9;&#9;tag.Parent = nil
&#9;&#9;end
&#9;end
end

connection = ball.Touched:connect(onTouched)
wait(5)
script.Parent:remove()</ProtectedString>
				</Properties>
			</Item>
			<Item class="LocalScript" referent="RBX4641">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Local Gui ADD-ON</string>
					<ProtectedString name="Source">--This is the Local Gui add-On. Cursor on enemy = Cursor choose red. Cursor on teammate = Cursor choose green.
--Cursor on Brick = Cursor choose grey. You should have a real Local Gui script because this has NO RELOAD CURSOR!
--This shows the playername in hint format, too. Works great with this leaderboard together.
--This is made by Alextomcool. I did just edit it. He make great add-Ons for weapons. Look at his site and pick some up!

print(&quot;LocalGui Add-On loaded&quot;)

bin = script.Parent
normel = &quot;http://www.roblox.com/asset/?id=16110835&quot;
friendly = &quot;http://www.roblox.com/asset/?id=16110837&quot;
enemy = &quot;http://www.roblox.com/asset/?id=16110845&quot;
function Run(mouse)
&#9;mouse.Icon = normel
        person = script.Parent.Parent.Parent
        local hint = Instance.new(&quot;Hint&quot;)
        hint.Parent = nil
        hint.Name = &quot;hint&quot;
&#9;local hit = mouse.Target
&#9;if (hit == nil) then return end
        h = hit.Parent:FindFirstChild(&quot;Humanoid&quot;)
        if h ~= nil then
        player = game.Players:GetPlayerFromCharacter(hit.Parent)
        if player ~= nil then
        if h.Health &gt; 0 then
&#9;if (player.TeamColor == person.TeamColor) then
        mouse.Icon = friendly
        if person:FindFirstChild(&quot;hint&quot;) == nil then
        hint.Text = player.Name
        hint.Parent = person
        else
        hint.Text = player.Name       
        end
        elseif player.TeamColor ~= person.TeamColor then
        mouse.Icon = enemy
        end
        end
        else
        nuh = person:FindFirstChild(&quot;hint&quot;)
        if nuh ~= nil then
        nuh.Parent = nil
        end
        end
        else
        nuh = person:FindFirstChild(&quot;hint&quot;)
        if nuh ~= nil then
        nuh.Parent = nil
        end
&#9;end
end







function on(mouse)
        while true do
&#9;if script.Parent.Active == false then break end 
        wait()
&#9;Run(mouse)
        end
end



script.Parent.Selected:connect(on)

</ProtectedString>
				</Properties>
			</Item>
		</Item>
		<Item class="HopperBin" referent="RBX4642">
			<Properties>
				<bool name="Active">false</bool>
				<token name="BinType">0</token>
				<string name="Name">AK47 soldier</string>
				<Content name="TextureId"><null></null></Content>
			</Properties>
			<Item class="Script" referent="RBX4643">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<ProtectedString name="Source">local bin = script.Parent
local player = bin.Parent.Parent
tooget = game:GetService(&quot;InsertService&quot;):LoadAsset(script.Parent.AI.Value)

function spawnaisoldier()
&#9;if script.Parent.Code.Value == 1 then
&#9;&#9;for i,v in pairs(tooget:GetChildren()) do &#9;
&#9;&#9;&#9;get1 = player.PlayerGui[&quot;AI system&quot;].TheMain.Value:findFirstChild(&quot;AI1&quot;).Obj
&#9;&#9;&#9;get1.Value = v
&#9;&#9;&#9;v.Animate.Disabled = false
&#9;&#9;&#9;v.Follow.Disabled = false
&#9;&#9;&#9;v.Owner.Value = player
&#9;&#9;&#9;v.Code.Value = script.Parent.Code.Value
&#9;&#9;&#9;weld = Instance.new(&quot;Weld&quot;)
&#9;&#9;&#9;weld.Parent = v.Head
&#9;&#9;&#9;weld.Part0 = v.Torso
&#9;&#9;&#9;weld.Part1  = v.Head
&#9;&#9;&#9;weld.C1 = CFrame.new(0,-1.5,0)
&#9;&#9;&#9;weld.Name = &quot;Head Weld&quot;
&#9;&#9;&#9;v.Parent = game.Workspace
&#9;&#9;&#9;v:MakeJoints()
&#9;&#9;&#9;wait(2)
&#9;&#9;&#9;v:MoveTo(player.Character.Torso.Position + Vector3.new(0,0,6))
&#9;&#9;&#9;break
&#9;&#9;end
&#9;end

&#9;if script.Parent.Code.Value == 2 then
&#9;&#9;wait(3)
&#9;&#9;for i,v in pairs(tooget:GetChildren()) do &#9;
&#9;&#9;&#9;get2 = player.PlayerGui[&quot;AI system&quot;].TheMain.Value:findFirstChild(&quot;AI2&quot;).Obj
&#9;&#9;&#9;get2.Value = v
&#9;&#9;&#9;v.Animate.Disabled = false
&#9;&#9;&#9;v.Follow.Disabled = false
&#9;&#9;&#9;v.Owner.Value = player
&#9;&#9;&#9;v.Code.Value = script.Parent.Code.Value
&#9;&#9;&#9;weld = Instance.new(&quot;Weld&quot;)
&#9;&#9;&#9;weld.Parent = v.Head
&#9;&#9;&#9;weld.Part0 = v.Torso
&#9;&#9;&#9;weld.Part1  = v.Head
&#9;&#9;&#9;weld.C1 = CFrame.new(0,-1.5,0)
&#9;&#9;&#9;weld.Name = &quot;Head Weld&quot;
&#9;&#9;&#9;v.Parent = game.Workspace
&#9;&#9;&#9;v:MakeJoints()
&#9;&#9;&#9;wait(2)
&#9;&#9;&#9;v:MoveTo(player.Character.Torso.Position + Vector3.new(0,0,-6))
&#9;&#9;&#9;break
&#9;&#9;end
&#9;end
&#9;bin:remove()
end
spawnaisoldier()

function onDeselected(mouse)
&#9;spawnaisoldier()
end 

function onSelected(mouse)
&#9;spawnaisoldier()
end

bin.Selected:connect(onSelected)
bin.Deselected:connect(onDeselected)</ProtectedString>
				</Properties>
			</Item>
