							<Item class="Script" referent="RBX3430">
								<Properties>
									<bool name="Disabled">false</bool>
									<Content name="LinkedSource"><null></null></Content>
									<string name="Name">Script</string>
									<ProtectedString name="Source">mainsc = script.BuyScreen
main = script.Parent.Parent.Parent
gui = main.Parent.Parent
player = gui.Parent.Parent

buy = {mainsc[&quot;1&quot;],mainsc[&quot;2&quot;],mainsc[&quot;3&quot;],mainsc[&quot;4&quot;]}
sell = mainsc[&quot;Sell&quot;]

function toBuy(button)
&#9;local price = button[&quot;Price&quot;]
&#9;local type = button[&quot;Type&quot;]
&#9;local ls = player.leaderstats
&#9;local cash = ls.Cash
&#9;if cash.Value &gt;= price.Value then
&#9;&#9;if player.AI[&quot;1&quot;].Value == &quot;&quot; then
&#9;&#9;&#9;player.AI[&quot;1&quot;].Value = type.Value
&#9;&#9;&#9;cash.Value = cash.Value - price.Value
&#9;&#9;end
&#9;end
end
for i= 1 ,#buy do
&#9;buy[i].MouseButton1Down:connect(function () toBuy(buy[i]) end)
end

function tosell()
&#9;for i=1 ,#buy do
&#9;&#9;if buy[i].type.Value == main.AI1.Obj.Value then
&#9;&#9;&#9;local ls = player.leaderstats
&#9;&#9;&#9;local cash = ls.Cash
&#9;&#9;&#9;cash.Value = cash.Value + (buy[i].price.Value /2 )
&#9;&#9;&#9;player.AI[&quot;1&quot;].Value = &quot;&quot;
&#9;&#9;&#9;break
&#9;&#9;end
&#9;end
end

function openlist()
&#9;if mainsc.Parent == script then
&#9;&#9;mainsc.Parent = script.Parent.Parent
&#9;else
&#9;&#9;mainsc.Parent = script
&#9;end
end
&#9;
script.Parent.MouseButton1Down:connect(openlist)
</ProtectedString>
