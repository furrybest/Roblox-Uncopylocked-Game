				</CoordinateFrame>
				<string name="Name">dka16</string>
				<Content name="TextureId"><url>http://www.roblox.com/asset/?id=16877546</url></Content>
				<string name="ToolTip"></string>
			</Properties>
			<Item class="LocalScript" referent="RBX4440">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Local Gui</string>
					<ProtectedString name="Source">local tool = script.Parent
local enabled = true
local kReload = 1
local kBulletSpacing = 0.05
local Damage = 200
local kWepRange = 5000
local KeepFiring = false

function fire(hit)

&#9;local Damage = 200
&#9;
&#9;if hit.Parent == nil then return end

&#9;if hit.Parent:findFirstChild(&quot;ForceField&quot;) ~= nil then return end

&#9;if hit.Anchored == false then 

&#9;&#9;hit:BreakJoints()

&#9;&#9;hit.Velocity = Vector3.new((hit.Position - tool.Handle.Position).unit.x*300,(hit.Position - tool.Handle.Position).unit.y*300,(hit.Position - tool.Handle.Position).unit.z*300) 

&#9;end
&#9;&#9;&#9;
--[[&#9;local health = hit.Parent:findFirstChild(&quot;Health&quot;)

&#9;if health then 
&#9;&#9;local targDist = (hit.Position - tool.Handle.Position).magnitude
&#9;&#9;if targDist &gt; 2*kWepRange then return end

&#9;&#9;if targDist &gt; kWepRange then
&#9;&#9;&#9;hitChance = math.random(0,1)
&#9;&#9;&#9;if hitChance == 0 then return end
&#9;&#9;end
&#9;&#9;if hit.Name == &quot;Engine&quot; then 
&#9;&#9;&#9;Damage = Damage*2
&#9;&#9;&#9;health.Value = health.Value - Damage
&#9;&#9;else
&#9;&#9;&#9;health.Value = health.Value - Damage
&#9;&#9;end
&#9;&#9;return
&#9;end]]

&#9;local tHumanoid = hit.Parent:findFirstChild(&quot;Humanoid&quot;)
&#9;if tHumanoid == nil then return end

&#9;local targDist = (hit.Parent.Torso.Position - tool.Handle.Position).magnitude

&#9;if targDist &gt; 2*kWepRange then return end

&#9;if targDist &gt; kWepRange then
&#9;&#9;hitChance = math.random(0,1)
&#9;&#9;if hitChance == 0 then return end
&#9;end

&#9;local vCharacter = tool.Parent
&#9;local vPlayer = game.Players:playerFromCharacter(vCharacter)

&#9;local CreatorTag = Instance.new(&quot;ObjectValue&quot;)
&#9;CreatorTag.Value = vPlayer
&#9;CreatorTag.Name = &quot;creator&quot;
&#9;CreatorTag.Parent = tHumanoid

&#9;if hit.Name == &quot;Head&quot; then 
&#9;&#9;Damage = Damage*2
&#9;&#9;tHumanoid.Health = tHumanoid.Health - Damage
&#9;&#9;if hit.Parent.Humanoid.Health &lt; 1 then
&#9;&#9;&#9;game.Workspace.headshot:Play()
&#9;&#9;end
&#9;else
&#9;&#9;tHumanoid.Health = tHumanoid.Health - Damage
&#9;end

end

function onButton1Down(mouse)

&#9;KeepFiring = true

&#9;if not enabled then return end
&#9;enabled = false

&#9;while ( KeepFiring == true ) do

&#9;&#9;local Character = tool.Parent

&#9;&#9;local Humanoid = Character:findFirstChild(&quot;Humanoid&quot;)
&#9;&#9;if Humanoid == nil then return end

&#9;&#9;local hit = mouse.Target

&#9;&#9;tool.Handle.Fire:play()

&#9;&#9;if hit ~= nil then
&#9;&#9;&#9;fire(hit)
&#9;&#9;end

&#9;&#9;wait(kBulletSpacing)

&#9;end

&#9;mouse.Icon = &quot;http://www.roblox.com/asset/?id=16110835&quot;
&#9;wait(kReload)
&#9;enabled = true
&#9;mouse.Icon = &quot;http://www.roblox.com/asset/?id=16110835&quot;

end

function onButton1Up()

&#9;KeepFiring = false

end

function onEquippedLocal(mouse)

&#9;if mouse == nil then return end

&#9;mouse.Icon = &quot;http://www.roblox.com/asset/?id=16110835&quot;
&#9;mouse.Button1Down:connect(function() onButton1Down(mouse) end)
&#9;mouse.Button1Up:connect(function() onButton1Up() end)


end

tool.Equipped:connect(onEquippedLocal)</ProtectedString>
				</Properties>
			</Item>
			<Item class="Script" referent="RBX4441">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">WeldArm</string>
					<ProtectedString name="Source">Tool = script.Parent;
local arms = nil
local torso = nil
local welds = {}

function Equip(mouse)
wait(0.01)
arms = {Tool.Parent:FindFirstChild(&quot;Left Arm&quot;), Tool.Parent:FindFirstChild(&quot;Right Arm&quot;)}
torso = Tool.Parent:FindFirstChild(&quot;Torso&quot;)
if arms ~= nil and torso ~= nil then
local sh = {torso:FindFirstChild(&quot;Left Shoulder&quot;), torso:FindFirstChild(&quot;Right Shoulder&quot;)}
if sh ~= nil then
local yes = true
if yes then
yes = false
sh[1].Part1 = nil
sh[2].Part1 = nil
local weld1 = Instance.new(&quot;Weld&quot;)
weld1.Part0 = torso
weld1.Parent = torso
weld1.Part1 = arms[1]
weld1.C1 = CFrame.new(-0.249, 1.35, 0.6) * CFrame.fromEulerAnglesXYZ(math.rad(290), 0, math.rad(-90))
welds[1] = weld1
local weld2 = Instance.new(&quot;Weld&quot;)
weld2.Part0 = torso
weld2.Parent = torso
weld2.Part1 = arms[2]
weld2.C1 = CFrame.new(-1, -0.2, 0.35) * CFrame.fromEulerAnglesXYZ(math.rad(-90), math.rad(-15), 0)
welds[2] = weld2
end
else
print(&quot;sh&quot;)
end
else
print(&quot;arms&quot;)
end
end

function Unequip(mouse)
if arms ~= nil and torso ~= nil then
local sh = {torso:FindFirstChild(&quot;Left Shoulder&quot;), torso:FindFirstChild(&quot;Right Shoulder&quot;)}
if sh ~= nil then
local yes = true
if yes then
yes = false
sh[1].Part1 = arms[1]
sh[2].Part1 = arms[2]
welds[1].Parent = nil
welds[2].Parent = nil
end
else
print(&quot;sh&quot;)
end
else
print(&quot;arms&quot;)
end
end
Tool.Equipped:connect(Equip)
Tool.Unequipped:connect(Unequip)
</ProtectedString>
				</Properties>
			</Item>
