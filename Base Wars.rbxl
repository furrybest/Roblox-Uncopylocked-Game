&#9;&#9;weld2.C1 = CFrame.new(-1, 0.8, 0.5) * CFrame.fromEulerAnglesXYZ(math.rad(-120), math.rad(-15), 0)
&#9;&#9;wait(0.0001)
&#9;&#9;weld1.C1 = CFrame.new(-0.5, 1.3, .9)* CFrame.fromEulerAnglesXYZ(math.rad(290), 0.6, math.rad(-90))
