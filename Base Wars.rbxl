						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">CHECK</string>
							<ProtectedString name="Source">function onTouched(hit)
&#9;if (hit.Parent == nil) then return end
&#9;player = game.Players:findFirstChild(hit.Parent.Name)
&#9;if player then
&#9;&#9;script.Parent.Parent[&quot;Team&quot;].Value = player.TeamColor 
&#9;end
end 

script.Parent.Touched:connect(onTouched)</ProtectedString>
						</Properties>
					</Item>
					<Item class="Script" referent="RBX1226">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">regen</string>
							<ProtectedString name="Source">oldparent = script.Parent.Parent
p=script.Parent
backup = p:clone()

script.Parent.ClickDetector.MouseButton1Down:connect(function ()
&#9;p:remove()
&#9;p=backup:clone()
&#9;p.Parent = oldparent
end)

</ProtectedString>
						</Properties>
					</Item>
