			<Item class="LocalScript" referent="RBX4391">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">AnimateScript</string>
					<ProtectedString name="Source">local arms = nil
local torso = nil
local welds = {}
local Tool = script.Parent

function Equip(mouse)
wait(0.01)
arms = {Tool.Parent:FindFirstChild(&quot;Left Arm&quot;), Tool.Parent:FindFirstChild(&quot;Right Arm&quot;)}
torso = Tool.Parent:FindFirstChild(&quot;Torso&quot;)
if arms ~= nil and torso ~= nil then
local sh = {torso:FindFirstChild(&quot;Left Shoulder&quot;), torso:FindFirstChild(&quot;Right Shoulder&quot;)}
if sh ~= nil then
local yes = true
if yes then
yes = false
sh[1].Part1 = nil
sh[2].Part1 = nil
local weld1 = Instance.new(&quot;Weld&quot;)
weld1.Part0 = torso
weld1.Parent = torso
weld1.Part1 = arms[1]
weld1.C1 = CFrame.new(-0.249, 1.35, 0.6) * CFrame.fromEulerAnglesXYZ(math.rad(290), 0, math.rad(-90))
welds[1] = weld1
local weld2 = Instance.new(&quot;Weld&quot;)
weld2.Part0 = torso
weld2.Parent = torso
weld2.Part1 = arms[2]
weld2.C1 = CFrame.new(-1, -0.2, 0.35) * CFrame.fromEulerAnglesXYZ(math.rad(-90), math.rad(-15), 0)
welds[2] = weld2
end
else
print(&quot;sh&quot;)
end
else
print(&quot;arms&quot;)
end
end

function Unequip(mouse)
if arms ~= nil and torso ~= nil then
local sh = {torso:FindFirstChild(&quot;Left Shoulder&quot;), torso:FindFirstChild(&quot;Right Shoulder&quot;)}
if sh ~= nil then
local yes = true
if yes then
yes = false
sh[1].Part1 = arms[1]
sh[2].Part1 = arms[2]
welds[1].Parent = nil
welds[2].Parent = nil
end
else
print(&quot;sh&quot;)
end
else
print(&quot;arms&quot;)
end
end
Tool.Equipped:connect(Equip)
Tool.Unequipped:connect(Unequip)

function Animate()
arms = {Tool.Parent:FindFirstChild(&quot;Left Arm&quot;), Tool.Parent:FindFirstChild(&quot;Right Arm&quot;)}
&#9;if Tool.AnimateValue.Value == &quot;Shoot&quot; then 
&#9;&#9;local weld1 = Instance.new(&quot;Weld&quot;)
&#9;&#9;weld1.Part0 = torso
&#9;&#9;weld1.Parent = torso
&#9;&#9;weld1.Part1 = Tool.Parent:findFirstChild(&quot;Left Arm&quot;)
&#9;&#9;weld1.C1 = CFrame.new(-0.249, 1.35, 0.6) * CFrame.fromEulerAnglesXYZ(math.rad(290), 0.1, math.rad(-90))
&#9;&#9;welds[1] = weld1
&#9;&#9;local weld2 = Instance.new(&quot;Weld&quot;)
&#9;&#9;weld2.Part0 = torso
&#9;&#9;weld2.Parent = torso
&#9;&#9;weld2.Part1 = Tool.Parent:findFirstChild(&quot;Right Arm&quot;)
&#9;&#9;weld2.C1 = CFrame.new(-1, -0.2, 0.35) * CFrame.fromEulerAnglesXYZ(math.rad(-100), math.rad(-15), 0)
&#9;&#9;welds[2] = weld2
&#9;&#9;print(&quot;Boom&quot;)
&#9;&#9;wait(0.2) 
&#9;&#9;weld1.C1 = CFrame.new(-0.249, 1.35, 0.6) * CFrame.fromEulerAnglesXYZ(math.rad(290), 0, math.rad(-90))
&#9;&#9;weld2.C1 = CFrame.new(-1, -0.2, 0.35) * CFrame.fromEulerAnglesXYZ(math.rad(-90), math.rad(-15), 0)
&#9;&#9;wait(0.01)
&#9;&#9;print(&quot;Start Reload&quot;)
&#9;&#9;weld1.C1 = CFrame.new(-0.249, 1.2, 0.5) * CFrame.fromEulerAnglesXYZ(math.rad(290), 0, math.rad(-90))
&#9;&#9;weld2.C1 = CFrame.new(-1, -0.2, 0.35) * CFrame.fromEulerAnglesXYZ(math.rad(-90), math.rad(-15), 0)
&#9;&#9;Tool.Handle2.Mesh.Offset = Vector3.new(0,0,0.1)
&#9;&#9;wait(0.01)
&#9;&#9;weld1.C1 = CFrame.new(-0.249, 0.8, 0.45) * CFrame.fromEulerAnglesXYZ(math.rad(290), 0, math.rad(-90))
&#9;&#9;weld2.C1 = CFrame.new(-1, -0.2, 0.35) * CFrame.fromEulerAnglesXYZ(math.rad(-90), math.rad(-15), 0)
&#9;&#9;Tool.Handle2.Mesh.Offset = Vector3.new(0,0,0.2)
&#9;&#9;wait(0.01)
&#9;&#9;weld1.C1 = CFrame.new(-0.249, 0.6, 0.4) * CFrame.fromEulerAnglesXYZ(math.rad(290), 0, math.rad(-90))
&#9;&#9;weld2.C1 = CFrame.new(-1, -0.2, 0.35) * CFrame.fromEulerAnglesXYZ(math.rad(-90), math.rad(-15), 0)
&#9;&#9;Tool.Handle2.Mesh.Offset = Vector3.new(0,0,0.3)
&#9;&#9;wait(0.01)
&#9;&#9;weld1.C1 = CFrame.new(-0.249, 0.4, 0.35) * CFrame.fromEulerAnglesXYZ(math.rad(290), 0, math.rad(-90))
&#9;&#9;weld2.C1 = CFrame.new(-1, -0.2, 0.35) * CFrame.fromEulerAnglesXYZ(math.rad(-90), math.rad(-15), 0)
&#9;&#9;Tool.Handle2.Mesh.Offset = Vector3.new(0,0,0.4)
&#9;&#9;wait(0.01)
&#9;&#9;print(&quot;Reload Done 50%&quot;)
&#9;&#9;weld1.C1 = CFrame.new(-0.249, 0.2, 0.32) * CFrame.fromEulerAnglesXYZ(math.rad(290), 0, math.rad(-90))
&#9;&#9;weld2.C1 = CFrame.new(-1, -0.2, 0.35) * CFrame.fromEulerAnglesXYZ(math.rad(-90), math.rad(-15), 0)
&#9;&#9;Tool.Handle2.Mesh.Offset = Vector3.new(0,0,0.5)
&#9;&#9;wait(0.01)
&#9;&#9;weld1.C1 = CFrame.new(-0.249, 0.4, 0.35) * CFrame.fromEulerAnglesXYZ(math.rad(290), 0, math.rad(-90))
&#9;&#9;weld2.C1 = CFrame.new(-1, -0.2, 0.35) * CFrame.fromEulerAnglesXYZ(math.rad(-90), math.rad(-15), 0)
&#9;&#9;Tool.Handle2.Mesh.Offset = Vector3.new(0,0,0.4)
&#9;&#9;wait(0.01)
&#9;&#9;weld1.C1 = CFrame.new(-0.249, 0.6, 0.4) * CFrame.fromEulerAnglesXYZ(math.rad(290), 0, math.rad(-90))
&#9;&#9;weld2.C1 = CFrame.new(-1, -0.2, 0.35) * CFrame.fromEulerAnglesXYZ(math.rad(-90), math.rad(-15), 0)
&#9;&#9;Tool.Handle2.Mesh.Offset = Vector3.new(0,0,0.3)
&#9;&#9;wait(0.01)
&#9;&#9;weld1.C1 = CFrame.new(-0.249, 0.8, 0.45) * CFrame.fromEulerAnglesXYZ(math.rad(290), 0, math.rad(-90))
&#9;&#9;weld2.C1 = CFrame.new(-1, -0.2, 0.35) * CFrame.fromEulerAnglesXYZ(math.rad(-90), math.rad(-15), 0)
&#9;&#9;Tool.Handle2.Mesh.Offset = Vector3.new(0,0,0.2)
&#9;&#9;wait(0.01)
&#9;&#9;weld1.C1 = CFrame.new(-0.249, 1.2, 0.5) * CFrame.fromEulerAnglesXYZ(math.rad(290), 0, math.rad(-90))
&#9;&#9;weld2.C1 = CFrame.new(-1, -0.2, 0.35) * CFrame.fromEulerAnglesXYZ(math.rad(-90), math.rad(-15), 0)
&#9;&#9;Tool.Handle2.Mesh.Offset = Vector3.new(0,0,0.1)
&#9;&#9;wait(0.01)
&#9;&#9;print(&quot;Reloaded&quot;)
&#9;&#9;weld1.C1 = CFrame.new(-0.249, 1.35, 0.6) * CFrame.fromEulerAnglesXYZ(math.rad(290), 0, math.rad(-90))
&#9;&#9;weld2.C1 = CFrame.new(-1, -0.2, 0.35) * CFrame.fromEulerAnglesXYZ(math.rad(-90), math.rad(-15), 0)
&#9;&#9;Tool.Handle2.Mesh.Offset = Vector3.new(0,0,0)
&#9;&#9;Tool.AnimateValue.Value = &quot;None&quot;
&#9;end 
&#9;if Tool.AnimateValue.Value == &quot;Reload&quot; then 
&#9;&#9;arms = {Tool.Parent:FindFirstChild(&quot;Left Arm&quot;), Tool.Parent:FindFirstChild(&quot;Right Arm&quot;)}
&#9;&#9;local weld1 = Instance.new(&quot;Weld&quot;)
&#9;&#9;weld1.Part0 = torso
&#9;&#9;weld1.Parent = torso
&#9;&#9;weld1.Part1 = arms[1]
&#9;&#9;weld1.C1 = CFrame.new(-0.249, 1.35, 0.6) * CFrame.fromEulerAnglesXYZ(math.rad(290), 0, math.rad(-90))
&#9;&#9;welds[1] = weld1
&#9;&#9;local weld2 = Instance.new(&quot;Weld&quot;)
&#9;&#9;weld2.Part0 = torso
&#9;&#9;weld2.Parent = torso
&#9;&#9;weld2.Part1 = arms[2]
&#9;&#9;weld2.C1 = CFrame.new(-1, -0.2, 0.35) * CFrame.fromEulerAnglesXYZ(math.rad(-90), math.rad(-15), 0)
&#9;&#9;welds[2] = weld2
&#9;&#9;wait(0.005)
&#9;&#9;weld1.C1 = CFrame.new(-0.249, 1.35, 0.6) * CFrame.fromEulerAnglesXYZ(math.rad(290), -0.1, math.rad(-90))
&#9;&#9;weld2.C1 = CFrame.new(-1, -0.2, 0.35) * CFrame.fromEulerAnglesXYZ(math.rad(-90), math.rad(-25), 0)
&#9;&#9;wait(0.005)
&#9;&#9;weld1.C1 = CFrame.new(-0.249, 1.35, 0.6) * CFrame.fromEulerAnglesXYZ(math.rad(290), -0.3, math.rad(-90))
&#9;&#9;weld2.C1 = CFrame.new(-1, -0.2, 0.35) * CFrame.fromEulerAnglesXYZ(math.rad(-90), math.rad(-25), 0)
&#9;&#9;wait(0.005)
&#9;&#9;weld1.C1 = CFrame.new(-0.249, 1.35, 0.6) * CFrame.fromEulerAnglesXYZ(math.rad(290), -0.2, math.rad(-90))
&#9;&#9;weld2.C1 = CFrame.new(-1, -0.2, 0.35) * CFrame.fromEulerAnglesXYZ(math.rad(-90), math.rad(-25), 0)
&#9;&#9;wait(0.005)
&#9;&#9;weld1.C1 = CFrame.new(-0.249, 1.35, 0.6) * CFrame.fromEulerAnglesXYZ(math.rad(290),-0, math.rad(-90))
&#9;&#9;weld2.C1 = CFrame.new(-1, -0.2, 0.35) * CFrame.fromEulerAnglesXYZ(math.rad(-90), math.rad(-25), 0)
&#9;&#9;wait(0.005)
&#9;&#9;weld1.C1 = CFrame.new(-0.249, 1.35, 0.6) * CFrame.fromEulerAnglesXYZ(math.rad(290), 0, math.rad(-90))
&#9;&#9;weld2.C1 = CFrame.new(-1, -0.2, 0.35) * CFrame.fromEulerAnglesXYZ(math.rad(-90), math.rad(-25), 0)
&#9;&#9;wait(0.005)
&#9;&#9;weld1.C1 = CFrame.new(-0.249, 1.35, 0.6) * CFrame.fromEulerAnglesXYZ(math.rad(290), 0, math.rad(-90))
&#9;&#9;weld2.C1 = CFrame.new(-1, -0.2, 0.35) * CFrame.fromEulerAnglesXYZ(math.rad(-90), math.rad(-25), 0)
&#9;&#9;wait(0.005)
&#9;&#9;weld1.C1 = CFrame.new(-0.249, 1.35, 0.6) * CFrame.fromEulerAnglesXYZ(math.rad(290), 0, math.rad(-90))
&#9;&#9;weld2.C1 = CFrame.new(-1, -0.2, 0.35) * CFrame.fromEulerAnglesXYZ(math.rad(-90), math.rad(-25), 0)
&#9;&#9;wait(0.005)
&#9;&#9;weld1.C1 = CFrame.new(-0.249, 1.35, 0.6) * CFrame.fromEulerAnglesXYZ(math.rad(290), 0, math.rad(-90))
&#9;&#9;weld2.C1 = CFrame.new(-1, -0.2, 0.35) * CFrame.fromEulerAnglesXYZ(math.rad(-90), math.rad(-15), 0)
&#9;end 
end 

Tool.AnimateValue.Changed:connect(Animate)
</ProtectedString>
				</Properties>
			</Item>
			<Item class="LocalScript" referent="RBX4392">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Local Gui ADD-ON</string>
					<ProtectedString name="Source">--This is the Local Gui add-On. Cursor on enemy = Cursor choose red. Cursor on teammate = Cursor choose green.
--Cursor on Brick = Cursor choose grey. You should have a real Local Gui script because this has NO RELOAD CURSOR!
--This shows the playername in hint format, too. Works great with this leaderboard together.
--This is made by Alextomcool. I did just edit it. He make great add-Ons for weapons. Look at his site and pick some up!

print(&quot;LocalGui Add-On loaded&quot;)

bin = script.Parent
normel = &quot;http://www.roblox.com/asset/?id=16110835&quot;
friendly = &quot;http://www.roblox.com/asset/?id=16110837&quot;
enemy = &quot;http://www.roblox.com/asset/?id=16110845&quot;
function Run(mouse)
&#9;mouse.Icon = normel
        person = game.Players:GetPlayerFromCharacter(script.Parent.Parent)
        local hint = Instance.new(&quot;Hint&quot;)
        hint.Parent = nil
        hint.Name = &quot;hint&quot;
&#9;local hit = mouse.Target
&#9;if (hit == nil) then return end
        h = hit.Parent:FindFirstChild(&quot;Humanoid&quot;)
        if h ~= nil then
        player = game.Players:GetPlayerFromCharacter(hit.Parent)
        if player ~= nil then
        if h.Health &gt; 0 then
&#9;if (player.TeamColor == person.TeamColor) then
        mouse.Icon = friendly
        if person:FindFirstChild(&quot;hint&quot;) == nil then
        hint.Text = player.Name
        hint.Parent = person
        else
        hint.Text = player.Name       
        end
        elseif player.TeamColor ~= person.TeamColor then
        mouse.Icon = enemy
        end
        end
        else
        nuh = person:FindFirstChild(&quot;hint&quot;)
        if nuh ~= nil then
        nuh.Parent = nil
        end
        end
        else
        nuh = person:FindFirstChild(&quot;hint&quot;)
        if nuh ~= nil then
        nuh.Parent = nil
        end
&#9;end
end

function on(mouse)
        while true do
&#9;&#9;if script.Parent.Parent ~= game.Players.LocalPlayer.Character then break end
&#9;&#9;wait()
&#9;&#9;Run(mouse)
        end
end



script.Parent.Equipped:connect(on)

</ProtectedString>
				</Properties>
			</Item>
		</Item>
