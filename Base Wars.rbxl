				<Item class="Script" referent="RBX2263">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">system = script.Parent
model = system.Station1
backup = model:Clone()
regen = system.Regen

function checkRegen()&#9;checkmodel=model:GetChildren()

&#9;if regen.Value == 1 and #checkmodel &lt; 1 then

&#9;&#9;model:remove()

&#9;&#9;wait(1)
&#9;&#9;model = backup:Clone()
&#9;&#9;model.Parent = system
&#9;&#9;model:MakeJoints()
&#9;end
end
regen.Changed:connect(checkRegen)</ProtectedString>
