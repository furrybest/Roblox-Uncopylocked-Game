			<Item class="Script" referent="RBX4003">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">WeldScript</string>
					<ProtectedString name="Source">print(&quot;This Weld Script Generated With Farvei&apos;s Instant Weld Script&quot;) 
local tool = script.Parent
local parts = {}
local c = tool:GetChildren()
for i = 1, #c do
if c[i].className == &quot;Part&quot; and c[i].Name ~= &quot;Handle&quot; and c[i].Anchored == false then
table.insert(parts, c[i])
end
end
function onWeld()
local c = tool.Handle:GetChildren()
for i = 1, #c do
if c[i].className == &quot;Weld&quot; then
c[i]:Remove()
end
end
for i = 1, #parts do
parts[i].Parent = tool
local w = Instance.new(&quot;Weld&quot;)
w.Parent = tool.Handle
w.Part0 = w.Parent
w.Part1 = parts[i]
w.C0 = script[parts[i].Name .. &quot;C0&quot;].Value
w.C1 = script[parts[i].Name .. &quot;C1&quot;].Value
end
end

onWeld()

script.Parent.Equipped:connect(onWeld)
script.Parent.Unequipped:connect(onWeld)</ProtectedString>
				</Properties>
			</Item>
			<Item class="StringValue" referent="RBX4004">
				<Properties>
					<string name="Name">AnimateValue</string>
					<string name="Value">None</string>
				</Properties>
			</Item>
			<Item class="Script" referent="RBX4005">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">RayGun</string>
					<ProtectedString name="Source">local Tool = script.Parent;
local range
function computeDirection(vec)
&#9;local lenSquared = vec.magnitude^2
&#9;local invSqrt = 1 / math.sqrt(lenSquared)
&#9;return Vector3.new(vec.x * invSqrt, vec.y * invSqrt, vec.z * invSqrt)
end


enabled = true

function fire(v)

&#9;v = Vector3.new(v.X + math.random(-300,300) * (range*0.01) * 0.01 ,v.Y + math.random(-300,300) * (range*0.01) *  0.01 ,v.Z + math.random(-300,300) * (range*0.01) *  0.01)

&#9;local vCharacter = Tool.Parent
&#9;local vPlayer = game.Players:playerFromCharacter(vCharacter)

&#9;local spawnPos = vCharacter.PrimaryPart.Position
&#9;
&#9;local PewPew = Tool.Handle:FindFirstChild(&quot;Fire&quot;)

&#9;if (PewPew == nil) then
&#9;&#9;PewPew = Instance.new(&quot;Sound&quot;)
&#9;&#9;PewPew.Name = &quot;PewPew&quot;
&#9;&#9;PewPew.SoundId = &quot;http://www.roblox.com/asset/?id=13510352&quot;
&#9;&#9;PewPew.Parent = Tool.Handle
&#9;&#9;PewPew.Pitch = .85
&#9;&#9;PewPew.Volume = 1
&#9;end

&#9;&#9;local dir = v - script.Parent.Parent[&quot;Head&quot;].Position
&#9;&#9;dir = computeDirection(dir)
&#9;&#9;local pos = script.Parent.Parent[&quot;Head&quot;].Position + (dir * 18)
&#9;&#9;local p = Instance.new(&quot;Part&quot;)
&#9;&#9;p.Name = &quot;Bullet&quot;
&#9;&#9;p.CFrame = CFrame.new(pos, pos + dir)
&#9;&#9;p.BrickColor = BrickColor.new(&quot;Bright orange&quot;)
&#9;&#9;p.Reflectance = 0.1
&#9;&#9;p.Velocity = (script.Parent.Parent[&quot;Head&quot;].Position - v).unit * - 600
&#9;&#9;p.Size = Vector3.new(1, 1,20)
&#9;&#9;p.formFactor = 2
&#9;&#9;p.CanCollide = false
&#9;&#9;local mesh = script.Parent.Mesh:clone()
&#9;&#9;mesh.Parent = p
&#9;&#9;local upforce = Instance.new(&quot;BodyForce&quot;)
&#9;&#9;upforce.force = Vector3.new(0, p:GetMass() * 196, 0)
&#9;&#9;upforce.Parent = p
&#9;&#9;local new_script = script.Parent.LaserBlast:clone()
&#9;&#9;new_script.Disabled = false
&#9;&#9;new_script.Parent = p
&#9;&#9;local creator_tag = Instance.new(&quot;ObjectValue&quot;)
&#9;&#9;creator_tag.Value = vPlayer
&#9;&#9;creator_tag.Name = &quot;creator&quot;
&#9;&#9;creator_tag.Parent = p
&#9;&#9;p.Parent = game.Workspace
&#9;&#9;Tool.AnimateValue.Value = &quot;Shoot&quot;
&#9;&#9;wait(0)

end


function gunUp()
&#9;Tool.GripForward = Vector3.new(0,.981,-.196)
&#9;Tool.GripRight = Vector3.new(1,0,0)
&#9;Tool.GripUp = Vector3.new(0,.196,.981)
end

function gunOut()
&#9;Tool.GripForward = Vector3.new(0,1,0)
&#9;Tool.GripRight = Vector3.new(1,0,0)
&#9;Tool.GripUp = Vector3.new(0,0,1)
end

function isTurbo(character)
&#9;return character:FindFirstChild(&quot;BoltHelm&quot;) ~= nil
end


function onActivated()
&#9;if not enabled  then
&#9;&#9;return
&#9;end
&#9;if script.Parent.Ammo.Value &lt; 1 then
&#9;&#9;return
&#9;end
&#9;enabled = false


&#9;local character = Tool.Parent;
&#9;local humanoid = character.Humanoid
&#9;if humanoid == nil then
&#9;&#9;print(&quot;Humanoid not found&quot;)
&#9;&#9;return 
&#9;end
&#9;&#9;&#9;local hum = script.Parent.Parent:findFirstChild(&quot;Humanoid&quot;)
&#9;&#9;&#9;if hum.Health &lt; 1 then return end 
&#9;local targetPos = humanoid.TargetPoint
&#9;local lookAt = (targetPos - character.Head.Position).unit
&#9;range = (script.Parent.Parent[&quot;Humanoid&quot;].TargetPoint - Tool.Parent.Head.Position).magnitude
&#9;local reload = 0.15

--&#9;gunUp()
&#9;script.Parent.Handle.Fire:play()
&#9;if (script.Parent.Parent[&quot;Humanoid&quot;].TargetPoint - Tool.Parent.Head.Position).magnitude &gt; 50 then
&#9;&#9;script.Parent.Ammo.Value = script.Parent.Ammo.Value - 1
&#9;&#9;message.Text = &quot;Current Ammo : &quot;..script.Parent.Ammo.Value..&quot;/&quot;..script.Parent.Total.Value
&#9;&#9;fire(script.Parent.Parent[&quot;Humanoid&quot;].TargetPoint)
&#9;end
&#9;wait(reload)
--&#9;gunOut()
&#9;wait(reload)

&#9;enabled = true

end

function onEquipped()
&#9;Tool.Handle.Locked = true
&#9;message = game.Players:findFirstChild(script.Parent.Parent.Name).PlayerGui.help.text
&#9;--Tool.Handle.EquipSound:play()
end

script.Parent.Activated:connect(onActivated)
script.Parent.Equipped:connect(onEquipped)
</ProtectedString>
				</Properties>
			</Item>
			<Item class="LocalScript" referent="RBX4006">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Local Gui</string>
					<ProtectedString name="Source">local Tool=script.Parent;
local tool = script.Parent
local enabled = true
local Damage = 34

enabled = true

function fire(hit)

&#9;local Damage = 34
&#9;
&#9;if hit.Parent == nil then return end

&#9;if hit.Parent:findFirstChild(&quot;ForceField&quot;) ~= nil then return end -- anit spawn killing !
&#9;if hit.Parent.Parent:findFirstChild(&quot;ForceField&quot;) ~= nil then return end


&#9;local vCharacter = tool.Parent
&#9;local vPlayer = game.Players:playerFromCharacter(vCharacter)

&#9;local tHumanoid = hit.Parent:findFirstChild(&quot;Humanoid&quot;) or hit.Parent.Parent:findFirstChild(&quot;Humanoid&quot;)
&#9;if tHumanoid ~= nil then&#9;
&#9;&#9;local CreatorTag = Instance.new(&quot;ObjectValue&quot;)
&#9;&#9;CreatorTag.Value = vPlayer
&#9;&#9;CreatorTag.Name = &quot;creator&quot;
&#9;&#9;CreatorTag.Parent = tHumanoid
&#9;&#9;hitted = game.Players:findFirstChild(tHumanoid.Parent.Name)
&#9;&#9;if hitted ~= nil and hitted.TeamColor == vPlayer.TeamColor then return end
&#9;&#9;if hit.Name == &quot;Head&quot; then Damage = Damage * 3 end  
&#9;&#9;tHumanoid.Health = tHumanoid.Health - Damage
&#9;end


end

function reload()
&#9;&#9;enabled = false
&#9;&#9;if script.Parent.Total.Value &lt;= 0 then enabled = true return end
&#9;&#9;message.Text = &quot;Current Ammo : RELOADING...&quot;
&#9;&#9;tool.Handle.Reload:play()
&#9;&#9;Tool.AnimateValue.Value = &quot;Reload&quot;
&#9;&#9;wait(1.2)
&#9;&#9;if script.Parent.Total.Value &lt;= script.Parent.MAX.Value - script.Parent.Ammo.Value then 
&#9;&#9;&#9;script.Parent.Ammo.Value = script.Parent.Total.Value + script.Parent.Ammo.Value
&#9;&#9;&#9;script.Parent.Total.Value = 0
&#9;&#9;else
&#9;&#9;&#9;script.Parent.Total.Value = script.Parent.Total.Value - (script.Parent.MAX.Value - script.Parent.Ammo.Value)
&#9;&#9;&#9;script.Parent.Ammo.Value = script.Parent.MAX.Value
&#9;&#9;end
&#9;&#9;message.Text = &quot;Current Ammo : &quot;..script.Parent.Ammo.Value..&quot;/&quot;..script.Parent.Total.Value
&#9;&#9;enabled = true
end

function onButton1Down(mouse)

&#9;if not enabled then return end
&#9;if script.Parent.Ammo.Value &lt; 1 then
&#9;&#9;reload()
&#9;end
&#9;enabled = false

&#9;local Character = tool.Parent

&#9;local Humanoid = Character:findFirstChild(&quot;Humanoid&quot;)
&#9;if Humanoid == nil then return end
&#9;&#9;&#9;local hum = script.Parent.Parent:findFirstChild(&quot;Humanoid&quot;)
&#9;&#9;&#9;if hum.Health &lt; 1 then return end 
&#9;local hit = mouse.Target
&#9;if hit ~= nil then
&#9;&#9;if (mouse.hit.p - Tool.Parent.Head.Position).magnitude &lt; 50 and (Tool.Parent.Humanoid.TargetPoint - Tool.Parent.Head.Position).magnitude &lt; 50 then
&#9;&#9;&#9;script.Parent.Ammo.Value = script.Parent.Ammo.Value - 1
message.Text = &quot;Current Ammo : &quot;..script.Parent.Ammo.Value..&quot;/&quot;..script.Parent.Total.Value
&#9;&#9;&#9;fire(hit)
&#9;&#9;&#9;print(&quot;close shot&quot;)
&#9;&#9;end
&#9;end

&#9;mouse.Icon = &quot;http://www.roblox.com/asset/?id=16110835&quot;
&#9;wait(0.3)
&#9;enabled = true
&#9;mouse.Icon = &quot;http://www.roblox.com/asset/?id=16110835&quot;

end
function onKeyDown(key)
&#9;if key == &quot;R&quot; or key == &quot;r&quot; then
&#9;&#9;if not enabled then return end
&#9;&#9;reload()
&#9;end
end
function onEquippedLocal(mouse)

&#9;if mouse == nil then
&#9;&#9;print(&quot;Mouse not found&quot;)
&#9;&#9;return 
&#9;end

&#9;mouse.Icon = &quot;http://www.roblox.com/asset/?id=16110845&quot;
&#9;message = game.Players:findFirstChild(script.Parent.Parent.Name).PlayerGui.help.text
&#9;message.Text = &quot;Current Ammo : &quot;..script.Parent.Ammo.Value..&quot;/&quot;..script.Parent.Total.Value
&#9;mouse.Button1Down:connect(function() onButton1Down(mouse) end)
&#9;mouse.KeyDown:connect(onKeyDown)
end


Tool.Equipped:connect(onEquippedLocal)
</ProtectedString>
				</Properties>
			</Item>
			<Item class="LocalScript" referent="RBX4007">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">AnimateScript</string>
					<ProtectedString name="Source">local arms = nil
local torso = nil
local welds = {}
local Tool = script.Parent

function Equip(mouse)
wait(0.01)
arms = {Tool.Parent:FindFirstChild(&quot;Left Arm&quot;), Tool.Parent:FindFirstChild(&quot;Right Arm&quot;)}
torso = Tool.Parent:FindFirstChild(&quot;Torso&quot;)
if arms ~= nil and torso ~= nil then
local sh = {torso:FindFirstChild(&quot;Left Shoulder&quot;), torso:FindFirstChild(&quot;Right Shoulder&quot;)}
if sh ~= nil then
local yes = true
if yes then
yes = false
sh[1].Part1 = nil
sh[2].Part1 = nil
local weld1 = Instance.new(&quot;Weld&quot;)
weld1.Part0 = torso
weld1.Parent = torso
weld1.Part1 = arms[1]
weld1.C1 = CFrame.new(-0.5, 0.8, .9)* CFrame.fromEulerAnglesXYZ(math.rad(290), 0, math.rad(-90))
welds[1] = weld1
local weld2 = Instance.new(&quot;Weld&quot;)
weld2.Part0 = torso
weld2.Parent = torso
weld2.Part1 = arms[2]
weld2.C1 = CFrame.new(-1, 0.8, 0.5) * CFrame.fromEulerAnglesXYZ(math.rad(-90), math.rad(-15), 0)
welds[2] = weld2
end
else
print(&quot;sh&quot;)
end
else
print(&quot;arms&quot;)
end
end

function Unequip(mouse)
if arms ~= nil and torso ~= nil then
local sh = {torso:FindFirstChild(&quot;Left Shoulder&quot;), torso:FindFirstChild(&quot;Right Shoulder&quot;)}
if sh ~= nil then
local yes = true
if yes then
yes = false
sh[1].Part1 = arms[1]
sh[2].Part1 = arms[2]
welds[1].Parent = nil
welds[2].Parent = nil
end
else
print(&quot;sh&quot;)
end
else
print(&quot;arms&quot;)
end
end
Tool.Equipped:connect(Equip)
Tool.Unequipped:connect(Unequip)

function Animate()
arms = {Tool.Parent:FindFirstChild(&quot;Left Arm&quot;), Tool.Parent:FindFirstChild(&quot;Right Arm&quot;)}
&#9;if Tool.AnimateValue.Value == &quot;Shoot&quot; then 
&#9;&#9;local weld1 = Instance.new(&quot;Weld&quot;)
&#9;&#9;weld1.Part0 = torso
&#9;&#9;weld1.Parent = torso
&#9;&#9;weld1.Part1 = arms[1]
&#9;&#9;weld1.C1 = CFrame.new(-0.5, 0.8, .9)* CFrame.fromEulerAnglesXYZ(math.rad(290), 0, math.rad(-90))
&#9;&#9;welds[1] = weld1
&#9;&#9;local weld2 = Instance.new(&quot;Weld&quot;)
&#9;&#9;weld2.Part0 = torso
&#9;&#9;weld2.Parent = torso
&#9;&#9;weld2.Part1 = arms[2]
&#9;&#9;weld2.C1 = CFrame.new(-1, 0.8, 0.5) * CFrame.fromEulerAnglesXYZ(math.rad(-90), math.rad(-15), 0)
&#9;&#9;welds[2] = weld2
&#9;&#9;wait(0.00001)
&#9;&#9;weld1.C1 = CFrame.new(-0.5, 0.8, .9)* CFrame.fromEulerAnglesXYZ(math.rad(290), 0.05, math.rad(-90))
&#9;&#9;weld2.C1 = CFrame.new(-1, 0.8, 0.5) * CFrame.fromEulerAnglesXYZ(math.rad(-90), math.rad(-15), 0)
&#9;&#9;wait(0.00001)
&#9;&#9;weld1.C1 = CFrame.new(-0.5, 0.8, .9)* CFrame.fromEulerAnglesXYZ(math.rad(290), 0.1, math.rad(-90))
&#9;&#9;weld2.C1 = CFrame.new(-1, 0.8, 0.5) * CFrame.fromEulerAnglesXYZ(math.rad(-95), math.rad(-15), 0)
&#9;&#9;wait(0.00001)
&#9;&#9;weld1.C1 = CFrame.new(-0.5, 0.8, .9)* CFrame.fromEulerAnglesXYZ(math.rad(290), 0.3, math.rad(-90))
&#9;&#9;weld2.C1 = CFrame.new(-1, 0.8, 0.5) * CFrame.fromEulerAnglesXYZ(math.rad(-110), math.rad(-15), 0)
&#9;&#9;wait(0.00001)
&#9;&#9;weld1.C1 = CFrame.new(-0.5, 0.8, .9)* CFrame.fromEulerAnglesXYZ(math.rad(290), 0.35, math.rad(-90))
&#9;&#9;weld2.C1 = CFrame.new(-1, 0.8, 0.5) * CFrame.fromEulerAnglesXYZ(math.rad(-115), math.rad(-15), 0)
&#9;&#9;wait(0.00001)
&#9;&#9;weld1.C1 = CFrame.new(-0.5, 0.8, .9)* CFrame.fromEulerAnglesXYZ(math.rad(290), 0.4, math.rad(-90))
&#9;&#9;weld2.C1 = CFrame.new(-1, 0.8, 0.5) * CFrame.fromEulerAnglesXYZ(math.rad(-120), math.rad(-15), 0)
&#9;&#9;wait(0.00001)
&#9;&#9;weld1.C1 = CFrame.new(-0.5, 0.8, .9)* CFrame.fromEulerAnglesXYZ(math.rad(290), 0, math.rad(-90))
&#9;&#9;weld2.C1 = CFrame.new(-1, 0.8, 0.5) * CFrame.fromEulerAnglesXYZ(math.rad(-90), math.rad(-15), 0)&#9;
&#9;&#9;Tool.AnimateValue.Value = &quot;None&quot;
&#9;end 
&#9;if Tool.AnimateValue.Value == &quot;Reload&quot; then 
&#9;&#9;local weld1 = Instance.new(&quot;Weld&quot;)
&#9;&#9;weld1.Part0 = torso
&#9;&#9;weld1.Parent = torso
&#9;&#9;weld1.Part1 = arms[1]
&#9;&#9;weld1.C1 = CFrame.new(-0.5, 0.8, .9)* CFrame.fromEulerAnglesXYZ(math.rad(290), 0, math.rad(-90))
&#9;&#9;welds[1] = weld1
&#9;&#9;local weld2 = Instance.new(&quot;Weld&quot;)
&#9;&#9;weld2.Part0 = torso
&#9;&#9;weld2.Parent = torso
&#9;&#9;weld2.Part1 = arms[2]
&#9;&#9;weld2.C1 = CFrame.new(-1, 0.8, 0.5) * CFrame.fromEulerAnglesXYZ(math.rad(-90), math.rad(-15), 0)
&#9;&#9;welds[2] = weld2
&#9;&#9;wait(0.0001)
&#9;&#9;weld1.C1 = CFrame.new(-0.5, 0.8, .9)* CFrame.fromEulerAnglesXYZ(math.rad(290), 0.4, math.rad(-90))
&#9;&#9;weld2.C1 = CFrame.new(-1, 0.8, 0.5) * CFrame.fromEulerAnglesXYZ(math.rad(-90), math.rad(-15), 0)
&#9;&#9;wait(0.0001)
&#9;&#9;weld1.C1 = CFrame.new(-0.5, 0.8, .9)* CFrame.fromEulerAnglesXYZ(math.rad(290), 0.4, math.rad(-90))
&#9;&#9;weld2.C1 = CFrame.new(-1, 0.8, 0.5) * CFrame.fromEulerAnglesXYZ(math.rad(-95), math.rad(-15), 0)
&#9;&#9;wait(0.0001)
&#9;&#9;weld1.C1 = CFrame.new(-0.5, 0.8, .9)* CFrame.fromEulerAnglesXYZ(math.rad(290), 0.4, math.rad(-90))
&#9;&#9;weld2.C1 = CFrame.new(-1, 0.8, 0.5) * CFrame.fromEulerAnglesXYZ(math.rad(-100), math.rad(-15), 0)
&#9;&#9;wait(0.0001)
&#9;&#9;weld1.C1 = CFrame.new(-0.5, 0.8, .9)* CFrame.fromEulerAnglesXYZ(math.rad(290), 0.4, math.rad(-90))
&#9;&#9;weld2.C1 = CFrame.new(-1, 0.8, 0.5) * CFrame.fromEulerAnglesXYZ(math.rad(-105), math.rad(-15), 0)
&#9;&#9;wait(0.0001)
&#9;&#9;weld1.C1 = CFrame.new(-0.5, 0.8, .9)* CFrame.fromEulerAnglesXYZ(math.rad(290), 0.4, math.rad(-90))
&#9;&#9;weld2.C1 = CFrame.new(-1, 0.8, 0.5) * CFrame.fromEulerAnglesXYZ(math.rad(-110), math.rad(-15), 0)
&#9;&#9;wait(0.0001)
&#9;&#9;weld1.C1 = CFrame.new(-0.5, 0.8, .9)* CFrame.fromEulerAnglesXYZ(math.rad(290), 0.4, math.rad(-90))
&#9;&#9;weld2.C1 = CFrame.new(-1, 0.8, 0.5) * CFrame.fromEulerAnglesXYZ(math.rad(-115), math.rad(-15), 0)
&#9;&#9;wait(0.0001)
&#9;&#9;weld1.C1 = CFrame.new(-0.5, 0.8, .9)* CFrame.fromEulerAnglesXYZ(math.rad(290), 0.45, math.rad(-90))
&#9;&#9;weld2.C1 = CFrame.new(-1, 0.8, 0.5) * CFrame.fromEulerAnglesXYZ(math.rad(-120), math.rad(-15), 0)
&#9;&#9;wait(0.0001)
&#9;&#9;weld1.C1 = CFrame.new(-0.5, 0.9, .9)* CFrame.fromEulerAnglesXYZ(math.rad(290), 0.5, math.rad(-90))
&#9;&#9;weld2.C1 = CFrame.new(-1, 0.8, 0.5) * CFrame.fromEulerAnglesXYZ(math.rad(-120), math.rad(-15), 0)
&#9;&#9;wait(0.0001)
&#9;&#9;weld1.C1 = CFrame.new(-0.5, 1, .9)* CFrame.fromEulerAnglesXYZ(math.rad(290), 0.55, math.rad(-90))
&#9;&#9;weld2.C1 = CFrame.new(-1, 0.8, 0.5) * CFrame.fromEulerAnglesXYZ(math.rad(-120), math.rad(-15), 0)
&#9;&#9;wait(0.0001)
&#9;&#9;weld1.C1 = CFrame.new(-0.5, 1.1, .9)* CFrame.fromEulerAnglesXYZ(math.rad(290), 0.57, math.rad(-90))
&#9;&#9;weld2.C1 = CFrame.new(-1, 0.8, 0.5) * CFrame.fromEulerAnglesXYZ(math.rad(-120), math.rad(-15), 0)
&#9;&#9;wait(0.0001)
