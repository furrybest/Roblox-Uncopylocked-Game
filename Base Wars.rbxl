				</Properties>
				<Item class="LocalScript" referent="RBX3677">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">ResetScript</string>
						<ProtectedString name="Source">Open=false
function kill()
&#9;game.Workspace.CurrentCamera:remove()
&#9;local player = game.Players.LocalPlayer
&#9;player.Character:BreakJoints()
&#9;player.leaderstats.WOs.Value = player.leaderstats.WOs.Value - 1
&#9;script.Parent.Parent:remove()
end

function dkill()
&#9;script.Parent.Parent[&quot;Yes/No&quot;]:remove()
&#9;script.Parent.Text=&quot;Reset&quot;
&#9;script.Parent.BackgroundColor=Color3.new(255,255,0)
&#9;Open=false
end

function h(obj)
&#9;obj.BackgroundColor=BrickColor.Blue()
end

function uh(obj)
&#9;obj.BackgroundColor=BrickColor.White()
end

function onButton1Down()
&#9;if Open==true then
&#9;&#9;dkill()
&#9;&#9;return
&#9;end
&#9;Open=true
&#9;--Start
&#9;local nbm=Instance.new(&quot;GuiMain&quot;)
&#9;nbm.Name=&quot;Yes/No&quot;
&#9;nbm.Parent=script.Parent.Parent

&#9;script.Parent.BackgroundColor=BrickColor.Blue()
&#9;script.Parent.Text=&quot;Are You Sure?&quot;

&#9;--YES
&#9;local nbutton=Instance.new(&quot;TextButton&quot;)
&#9;nbutton.Size=script.Parent.Size
&#9;nbutton.AutoButtonColor=true
&#9;nbutton.BackgroundColor=BrickColor.White()
&#9;nbutton.Position=UDim2.new(0, 90, .3, 0)
&#9;nbutton.Text=&quot;Yes&quot;
&#9;nbutton.Name=[[Yes_Button]]
&#9;nbutton.Parent=nbm
&#9;nbutton.MouseButton1Down:connect(kill)
&#9;nbutton.MouseEnter:connect(function() h(nbutton) end)
&#9;nbutton.MouseLeave:connect(function() uh(nbutton) end)

&#9;--NO
&#9;local nnbutton=Instance.new(&quot;TextButton&quot;)
&#9;nnbutton.Size=script.Parent.Size
&#9;nnbutton.AutoButtonColor=true
&#9;nnbutton.BackgroundColor=BrickColor.White()
&#9;nnbutton.Position=UDim2.new(0, 90, .3, 23)
&#9;nnbutton.Text=&quot;No&quot;
&#9;nnbutton.Name=[[Yes_Button]]
&#9;nnbutton.Parent=nbm
&#9;nnbutton.MouseButton1Down:connect(dkill)
&#9;nnbutton.MouseEnter:connect(function() h(nnbutton) end)
&#9;nnbutton.MouseLeave:connect(function() uh(nnbutton) end)

&#9;--End
end

script.Parent.MouseButton1Down:connect(onButton1Down)

</ProtectedString>
					</Properties>
				</Item>
			</Item>
		</Item>
