			<Item class="LocalScript" referent="RBX4666">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Local Gui ADD-ON</string>
					<ProtectedString name="Source">--This is the Local Gui add-On. Cursor on enemy = Cursor choose red. Cursor on teammate = Cursor choose green.
--Cursor on Brick = Cursor choose grey. You should have a real Local Gui script because this has NO RELOAD CURSOR!
--This shows the playername in hint format, too. Works great with this leaderboard together.
--This is made by Alextomcool. I did just edit it. He make great add-Ons for weapons. Look at his site and pick some up!

print(&quot;LocalGui Add-On loaded&quot;)

bin = script.Parent
normel = &quot;http://www.roblox.com/asset/?id=16110835&quot;
friendly = &quot;http://www.roblox.com/asset/?id=16110837&quot;
enemy = &quot;http://www.roblox.com/asset/?id=16110845&quot;
function Run(mouse)
&#9;mouse.Icon = normel
        person = script.Parent.Parent.Parent
        local hint = Instance.new(&quot;Hint&quot;)
        hint.Parent = nil
        hint.Name = &quot;hint&quot;
&#9;local hit = mouse.Target
&#9;if (hit == nil) then return end
        h = hit.Parent:FindFirstChild(&quot;Humanoid&quot;)
        if h ~= nil then
        player = game.Players:GetPlayerFromCharacter(hit.Parent)
        if player ~= nil then
        if h.Health &gt; 0 then
&#9;if (player.TeamColor == person.TeamColor) then
        mouse.Icon = friendly
        if person:FindFirstChild(&quot;hint&quot;) == nil then
        hint.Text = player.Name
        hint.Parent = person
        else
        hint.Text = player.Name       
        end
        elseif player.TeamColor ~= person.TeamColor then
        mouse.Icon = enemy
        end
        end
        else
        nuh = person:FindFirstChild(&quot;hint&quot;)
        if nuh ~= nil then
        nuh.Parent = nil
        end
        end
        else
        nuh = person:FindFirstChild(&quot;hint&quot;)
        if nuh ~= nil then
        nuh.Parent = nil
        end
&#9;end
end







function on(mouse)
        while true do
&#9;if script.Parent.Active == false then break end 
        wait()
&#9;Run(mouse)
        end
end



script.Parent.Selected:connect(on)

</ProtectedString>
				</Properties>
			</Item>
		</Item>
		<Item class="HopperBin" referent="RBX4667">
			<Properties>
				<bool name="Active">false</bool>
				<token name="BinType">0</token>
				<string name="Name">Boat</string>
				<Content name="TextureId"><null></null></Content>
			</Properties>
			<Item class="Script" referent="RBX4668">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">PlaneFlyer</string>
					<ProtectedString name="Source">bin=script.Parent
plane=nil
hold=false
local debounce = false
local planedebounce = false
local stuntdebounce = false
local controlling = false

function fire(pln,gun)
&#9;&#9;local p = Instance.new(&quot;Part&quot;)
&#9;&#9;p.Name = &quot;Bullet&quot;
&#9;&#9;p.CFrame = gun.CFrame + (gun.CFrame.lookVector * 50)
&#9;&#9;p.BrickColor = BrickColor.new(&quot;Bright orange&quot;)
&#9;&#9;p.Reflectance = 0.1
&#9;&#9;p.Size = Vector3.new(1, 1,20)
&#9;&#9;p.formFactor = 2
&#9;&#9;p.CanCollide = false
&#9;&#9;local upforce = Instance.new(&quot;BodyForce&quot;)
&#9;&#9;upforce.force = Vector3.new(0, p:GetMass() * 196, 0)
&#9;&#9;upforce.Parent = p
&#9;&#9;p.Velocity = gun.CFrame.lookVector * 600
&#9;&#9;local new_script = script.Parent.LaserBlast:clone()
&#9;&#9;new_script.Disabled = false
&#9;&#9;new_script.Parent = p
&#9;&#9;script.Parent.Mesh:clone().Parent= p
&#9;&#9;local creator_tag = Instance.new(&quot;ObjectValue&quot;)
&#9;&#9;creator_tag.Value = game.Players.LocalPlayer
&#9;&#9;creator_tag.Name = &quot;creator&quot;
&#9;&#9;creator_tag.Parent = p
&#9;&#9;gun.Fire:Play()
&#9;&#9;p.Parent = game.Workspace
--[[
&#9;local missile = bin.Rocket:clone()
&#9;missile.CFrame = spn.CFrame * CFrame.new(0, 0, -35)
&#9;missile.RocketScript.Disabled = false
&#9;missile.Parent = game.Workspace

&#9;local creator_tag = Instance.new(&quot;ObjectValue&quot;)
&#9;creator_tag.Value = game.Players.LocalPlayer
&#9;creator_tag.Name = &quot;creator&quot;
&#9;creator_tag.Parent = missile

&#9;missile.Owner.Value = pln]]
end

function computeDirection(vec)
&#9;local lenSquared = vec.magnitude * vec.magnitude
&#9;local invSqrt = 1 / math.sqrt(lenSquared)
&#9;return Vector3.new(vec.x * invSqrt, vec.y * invSqrt, vec.z * invSqrt)
end

function move(target, engine)
&#9;if bin.Parent == nil then return end 
&#9;local origincframe = engine:findFirstChild(&quot;BodyGyro&quot;).cframe
&#9;local dir = (target - engine.Position).unit
&#9;local spawnPos = engine.Position

&#9;local pos = spawnPos + (dir * 1)

&#9;engine:findFirstChild(&quot;BodyGyro&quot;).maxTorque = Vector3.new(20000, 20000, 20000)
&#9;engine:findFirstChild(&quot;BodyGyro&quot;).cframe = CFrame.new(pos,  pos + dir)
end

function findPlane(player)
&#9;local list = player.Character:GetChildren()
&#9;for x = 1, #list do
&#9;&#9;if (list[x].Name == &quot;boat&quot;) then
&#9;&#9;&#9;local weld = list[x]:FindFirstChild(&quot;Parts&quot;):FindFirstChild(&quot;Seat&quot;):FindFirstChild(&quot;SeatWeld&quot;)
&#9;&#9;&#9;if (weld ~= nil) and (weld.Part1 == player.Character:FindFirstChild(&quot;Torso&quot;)) then
&#9;&#9;&#9;&#9;return list[x]
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
&#9;return nil
end

function onButton1Down(mouse)
&#9;if bin.Parent == nil then return end 
&#9;local vehicle = findPlane(script.Parent.Parent.Parent)
&#9;if vehicle ~= nil and debounce == false and planedebounce == false then
&#9;debounce = true

&#9;controlling = true

&#9;while true do
&#9;&#9;wait()
&#9;if bin.Parent == nil then return end 
&#9;&#9;local engine = vehicle.Parts.GunEngine
&#9;&#9;local position = mouse.Hit
&#9;&#9;local target = position.p
&#9;&#9;move(target, engine)
&#9;&#9;if planedebounce == true or
&#9;&#9;controlling == false then break end
&#9;end
&#9;wait(.1)
&#9;debounce = false
&#9;end
end

function onButton1Up(mouse)
&#9;controlling = false
end

function onSelected(mouse)
&#9;mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
&#9;mouse.Button1Down:connect(function() onButton1Down(mouse) end)
&#9;mouse.Button1Up:connect(function() onButton1Up(mouse) end)
&#9;mouse.KeyDown:connect(onKeyDown)
&#9;mouse.KeyUp:connect(onKeyUp)
&#9;message = game.Players.LocalPlayer.PlayerGui.help.Vehicle
&#9;message.Text = &quot;Jeep control --- Move : W/A/S/D , Jeep Gun Direction Control : [MouseClick] , Fire the gun : hold F &quot;
end

function onKeyDown(key)
&#9;if (key~=nil) then
&#9;&#9;key = key:lower()
&#9;&#9;local vehicle = findPlane(script.Parent.Parent.Parent)
&#9;&#9;if (vehicle==nil) then return end
&#9;&#9;plane = vehicle.Parts
&#9;&#9;local engine = vehicle.Parts.Engine
&#9;&#9;&#9;if (key==&quot;f&quot;) then
&#9;&#9;&#9;&#9;bin.Reload.Value = 1
&#9;&#9;&#9;&#9;while true do
&#9;&#9;&#9;&#9;&#9;if bin.Reload.Value == 0 then break end
&#9;&#9;&#9;&#9;&#9;fire(vehicle,plane.Gun1)
&#9;&#9;&#9;&#9;&#9;fire(vehicle,plane.Gun2)
&#9;&#9;&#9;&#9;&#9;wait(0.3)
&#9;&#9;&#9;&#9;end

&#9;&#9;&#9;end
&#9;end
end

function onKeyUp(key)
&#9;key:lower()
&#9;if key == &quot;f&quot; then
&#9;&#9;if bin.Reload.Value == 1 then 
&#9;&#9;&#9;bin.Reload.Value = 0
&#9;&#9;end
&#9;end
end

bin.Selected:connect(onSelected)
</ProtectedString>
				</Properties>
				<Item class="Script" referent="RBX4669">
					<Properties>
						<bool name="Disabled">true</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">FlyScript</string>
						<ProtectedString name="Source">local engine = script.Parent.Parent.Engine
local spd = 3
local position = engine.Position

while true do
&#9;wait(.1)
&#9;direction = engine.CFrame.lookVector 
&#9;position = position + spd*3*direction
&#9;error = position - engine.Position
&#9;engine.Velocity = spd*error
&#9;engine.RotVelocity = Vector3.new(0, 0, 0)
end 
</ProtectedString>
