					<Item class="ClickDetector" referent="RBX3011">
						<Properties>
							<float name="MaxActivationDistance">100</float>
							<string name="Name">ClickDetector</string>
						</Properties>
					</Item>
					<Item class="Script" referent="RBX3012">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Activate</string>
							<ProtectedString name="Source">button = script.Parent
regen = button.Parent.Regen

local debounce = false

function onTouch(hit)
&#9;if debounce == false then
&#9;&#9;debounce = true
&#9;&#9;button.BrickColor = BrickColor.Black()
&#9;&#9;regen.Value = 1
&#9;&#9;wait()
&#9;&#9;regen.Value = 0
&#9;&#9;wait(5)
&#9;&#9;button.BrickColor = BrickColor.new(104)
&#9;&#9;debounce = false
&#9;end
end
button.ClickDetector.MouseClick:connect(onTouch)</ProtectedString>
						</Properties>
					</Item>
				</Item>
				<Item class="Script" referent="RBX3013">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">system = script.Parent
model = system.Station1
backup = model:Clone()
regen = system.Regen

function checkRegen()
&#9;if regen.Value == 1 then

&#9;&#9;model:remove()

&#9;&#9;wait(1)
&#9;&#9;model = backup:Clone()
