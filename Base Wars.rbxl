						</Vector3>
						<float name="TargetRadius">4</float>
						<float name="ThrustD">0.00100000005</float>
						<float name="ThrustP">5</float>
						<float name="TurnD">500</float>
						<float name="TurnP">3000</float>
					</Properties>
