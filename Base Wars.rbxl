								<string name="Name">Decals</string>
								<ProtectedString name="Source">debounce = true

function onTouched(hit)
&#9;if (hit.Parent:findFirstChild(&quot;Humanoid&quot;) ~= nil and debounce == true) then
&#9;&#9;local t = hit.Parent.Torso -- change the last part to which place the decal go.
&#9;&#9;debounce = false
&#9;&#9;d = Instance.new(&quot;Decal&quot;)
&#9;&#9;d.Name = &quot;soldier&quot; -- name the decal
&#9;&#9;d.Face = 5 --insert here which face and here is the codes &quot;http://wiki.roblox.com/index.php?title=Face&quot;. Five is an unused number.
&#9;&#9;d.Texture = &quot;http://www.roblox.com/asset/?id=15946096&quot; --insert here the link of the decal
&#9;&#9;d.Parent = t
&#9;&#9;wait(1)
&#9;&#9;debounce = true
&#9;end
end

