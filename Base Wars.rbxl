								<string name="Name">regen</string>
								<ProtectedString name="Source">-- dark886&apos;s click regen script
-- just place this script to the button

location = script.Parent.Parent.Parent
regen = script.Parent.Parent
save = regen:clone()

function onClicked()
&#9;regen:remove()
&#9;back = save:clone()
&#9;back.Parent = location
&#9;back:MakeJoints()
end 

script.Parent.ClickDetector.MouseClick:connect(onClicked)</ProtectedString>
