			<Item class="Script" referent="RBX3415">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">AIGuiScript</string>
					<ProtectedString name="Source">player = script.Parent.Parent.Parent
character = player.Character

main = script.Main
script.Parent.TheMain.Value = main
bin1 = main.AI1
bin2 = main.AI2

ai1hp = bin1[&quot;Health&quot;][&quot;HealthBar&quot;]
ai1 = {bin1[&quot;Regroup&quot;],bin1[&quot;Fire&quot;],bin1[&quot;Respawn&quot;],bin1[&quot;Rush&quot;],bin1[&quot;AIName&quot;]}
ai1obj = bin1[&quot;Obj&quot;]

ai2hp = bin2[&quot;Health&quot;][&quot;HealthBar&quot;]
ai2 = {bin2[&quot;Regroup&quot;],bin2[&quot;Fire&quot;],bin2[&quot;Respawn&quot;],bin2[&quot;Rush&quot;],bin2[&quot;AIName&quot;]}
ai2obj = bin2[&quot;Obj&quot;]

function getAI1()
&#9;local typebin = player:findFirstChild(&quot;AI&quot;)
&#9;while typebin == nil do
&#9;&#9;wait(1)
&#9;&#9;typebin = player:findFirstChild(&quot;AI&quot;)
&#9;end
&#9;local ai1type = typebin[&quot;1&quot;].Value
&#9;local get1 = game.Lighting:findFirstChild(ai1type)
&#9;if get1 ~= nil then 
&#9;&#9;get1 = get1:clone()
&#9;&#9;get1.Code.Value = 1
&#9;&#9;get1.Parent = player.Backpack
&#9;end
end
getAI1()
player:findFirstChild(&quot;AI&quot;)[&quot;1&quot;].Changed:connect(getAI1)

function getAI2()
&#9;local typebin = player:findFirstChild(&quot;AI&quot;)
&#9;while typebin == nil do
&#9;&#9;wait(1)
&#9;&#9;typebin = player:findFirstChild(&quot;AI&quot;)
&#9;end
&#9;wait(4)
&#9;local ai2type = typebin[&quot;2&quot;].Value
&#9;local get2 = game.Lighting:findFirstChild(ai2type)
&#9;if get2 ~= nil then
&#9;&#9;get2=get2:clone()
&#9;&#9;get2.Code.Value = 2
&#9;&#9;get2.Parent = player.Backpack
&#9;end
end
getAI2()
player:findFirstChild(&quot;AI&quot;)[&quot;2&quot;].Changed:connect(getAI2)

function getnew()
&#9;if ai1obj.Value ~= nil then
&#9;&#9;ai1[5].Text = ai1obj.Value.Name
&#9;end
&#9;if ai2obj.Value ~= nil then
&#9;&#9;ai2[5].Text = ai2obj.Value.Name
&#9;end
end
getnew()
ai1obj.Changed:connect(getnew)
ai2obj.Changed:connect(getnew)

function regroup(obj)
&#9;if obj.Value ~= nil then 
&#9;&#9;obj.Value.Action.Value = &quot;Regroup&quot;
&#9;end
end


ai1[1].MouseButton1Down:connect(function () regroup(ai1obj) end) 
ai2[1].MouseButton1Down:connect(function () regroup(ai2obj) end) 

ai1[3].MouseButton1Down:connect(function () if ai1obj.Value == nil then getAI1() else ai1obj.Value.Parent = nil ai1obj.Value = nil getAI1() end end) 
ai2[3].MouseButton1Down:connect(function () if ai2obj.Value == nil then getAI2() else ai2obj.Value.Parent = nil ai2obj.Value = nil getAI2() end end) 

function fire(obj)
&#9;if obj.Value ~= nil then 
&#9;&#9;obj.Value.Action.Value = &quot;Fire&quot;
&#9;end
end
ai1[2].MouseButton1Down:connect(function () fire(ai1obj) end) 
ai2[2].MouseButton1Down:connect(function () fire(ai2obj) end) 


function rush(obj)
&#9;if obj.Value ~= nil then 
&#9;&#9;obj.Value.Action.Value = &quot;Rush&quot;
&#9;end
end
ai1[4].MouseButton1Down:connect(function () rush(ai1obj) end) 
ai2[4].MouseButton1Down:connect(function () rush(ai2obj) end) 

script.Parent.Open1.MouseButton1Down:connect(function ()
&#9;if main.Parent == script.Parent then
&#9;&#9;main.Parent = script
&#9;&#9;getnew()
&#9;else
&#9;&#9;main.Parent = script.Parent
&#9;&#9;getnew()
&#9;end
end)
for i = 1 , 10 do
&#9;wait(0.25)
&#9;script.Parent.Open1.BackgroundColor3 = script[&quot;1&quot;].Value
&#9;wait(0.25)
&#9;script.Parent.Open1.BackgroundColor3 = script[&quot;2&quot;].Value
end

</ProtectedString>
