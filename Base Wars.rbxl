										<string name="Name">FlyScript</string>
										<ProtectedString name="Source">MaxSpeed=script.Parent.MaxSpeed

function constant(engine)
&#9;if (script.Parent:FindFirstChild(&quot;SeatWeld&quot;)) then
&#9;&#9;if (script.Parent.Throttle == 1) then
&#9;&#9;script.Parent.Parent.Engine.Push.velocity=engine.CFrame.lookVector*MaxSpeed
&#9;&#9;end
&#9;&#9;if (script.Parent.Throttle == 0) then
&#9;&#9;script.Parent.Parent.Engine.Push.velocity=engine.CFrame.lookVector*0
&#9;&#9;end
&#9;&#9;if (script.Parent.Throttle == -1) then
&#9;&#9;script.Parent.Parent.Engine.Push.velocity=engine.CFrame.lookVector*-(MaxSpeed)
&#9;&#9;end
&#9;end
end

function check()
&#9;pcall(function()
&#9;&#9;bg = script.Parent.Parent:findFirstChild(&quot;Check&quot;).BodyGyro
&#9;&#9;bg.maxTorque = Vector3.new(1000000,1000000,1000000)
&#9;&#9;bg.cframe = script.Parent.Parent:findFirstChild(&quot;Check&quot;).CFrame
&#9;&#9;if (script.Parent:FindFirstChild(&quot;SeatWeld&quot;)) then
&#9;&#9;&#9;if (script.Parent.Steer==-1) then
&#9;&#9;&#9;--[[&#9;for _, v in pairs(script.Parent.Parent:children()) do
&#9;&#9;&#9;&#9;&#9;v.CFrame=v.CFrame*CFrame.fromEulerAnglesXYZ(0,math.pi/100,0)
&#9;&#9;&#9;&#9;end]]
&#9;&#9;&#9;&#9;if script.Parent.Parent:findFirstChild(&quot;Check&quot;) then
&#9;&#9;&#9;&#9;&#9;bg.cframe = bg.cframe *CFrame.fromEulerAnglesXYZ(0,math.pi/25,0)
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;elseif (script.Parent.Steer==1) then
&#9;&#9;&#9;--[[&#9;for _, v in pairs(script.Parent.Parent:children()) do
&#9;&#9;&#9;&#9;&#9;v.CFrame=v.CFrame*CFrame.fromEulerAnglesXYZ(0,math.pi/-100,0)
&#9;&#9;&#9;&#9;end]]
&#9;&#9;&#9;&#9;if script.Parent.Parent:findFirstChild(&quot;Check&quot;) then
&#9;&#9;&#9;&#9;&#9;bg.cframe = bg.cframe *CFrame.fromEulerAnglesXYZ(0,math.pi/-25,0)
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end)
end

while true do
&#9;wait()
&#9;check()
&#9;constant(script.Parent)
end


</ProtectedString>
									</Properties>
