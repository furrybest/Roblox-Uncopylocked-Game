			<Item class="Script" referent="RBX4367">
				<Properties>
					<bool name="Disabled">true</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">LaserBlast</string>
					<ProtectedString name="Source">ball = script.Parent
damage = 11

function onTouched(hit)
&#9;if hit.Name == &quot;Bullet&quot; then return end
&#9;if script.Parent.Position.Y &lt; 15 then return end 
&#9;local humanoid = hit.Parent:findFirstChild(&quot;Humanoid&quot;) or hit.Parent.Parent:findFirstChild(&quot;Humanoid&quot;)
&#9;connection:disconnect()
&#9;if humanoid ~= nil then
&#9;&#9;hitted = game.Players:findFirstChild(humanoid.Parent.Name)
&#9;&#9;owner = ball:findFirstChild(&quot;creator&quot;).Value
&#9;&#9;if hitted ~= nil then
&#9;&#9;&#9;if hitted.TeamColor == owner.TeamColor then
&#9;&#9;&#9;&#9;ball:remove()
&#9;&#9;&#9;&#9;return
&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;tagHumanoid(humanoid)
&#9;&#9;if hit.Name == &quot;Head&quot; then damage = damage * 3 end  
&#9;&#9;--if hit.Name == &quot;Armor&quot; then damage = damage * 2 end
&#9;&#9;&#9;if not humanoid.Parent:findFirstChild(&quot;ForceField&quot;) then
&#9;&#9;&#9;&#9;humanoid.Health = humanoid.Health - damage
&#9;&#9;&#9;end
&#9;&#9;wait(1)
&#9;&#9;untagHumanoid(humanoid)
&#9;else

&#9;&#9;if hit.Anchored == false and hit.Parent.className == &quot;Model&quot; then 
&#9;&#9;&#9;if hit:findFirstChild(&quot;damaged&quot;) then
&#9;&#9;&#9;&#9;hit.damaged.Value = hit.damaged.Value + 10
&#9;&#9;&#9;&#9;if hit.damaged.Value &gt;= 20 then 
&#9;&#9;&#9;&#9;&#9;hit:BreakJoints()
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;local p = Instance.new(&quot;IntValue&quot;)
&#9;&#9;&#9;&#9;p.Value = 10
&#9;&#9;&#9;&#9;p.Name = &quot;damaged&quot;
&#9;&#9;&#9;&#9;p.Parent = hit
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
&#9;ball:remove()
end

function tagHumanoid(humanoid)
&#9;-- todo: make tag expire
&#9;local tag = ball:findFirstChild(&quot;creator&quot;)
&#9;if tag ~= nil then
&#9;&#9;local new_tag = tag:clone()
&#9;&#9;new_tag.Parent = humanoid
&#9;end
end


function untagHumanoid(humanoid)
&#9;if humanoid ~= nil then
&#9;&#9;local tag = humanoid:findFirstChild(&quot;creator&quot;)
&#9;&#9;if tag ~= nil then
&#9;&#9;&#9;tag.Parent = nil
&#9;&#9;end
&#9;end
end


connection = ball.Touched:connect(onTouched)
wait(5)
script.Parent:remove()</ProtectedString>
				</Properties>
			</Item>
			<Item class="LocalScript" referent="RBX4368">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Local Gui</string>
					<ProtectedString name="Source">local tool = script.Parent
local Tool=script.Parent
local enabled = true
local kReload = 0.8
local Damage = 90
local kWepRange = 60

function fire(hit)

&#9;local Damage = 90
&#9;
&#9;if hit.Parent == nil then return end

&#9;if hit.Parent:findFirstChild(&quot;ForceField&quot;) ~= nil then return end -- anit spawn killing !
&#9;if hit.Parent.Parent:findFirstChild(&quot;ForceField&quot;) ~= nil then return end

&#9;local vCharacter = tool.Parent
&#9;local vPlayer = game.Players:playerFromCharacter(vCharacter)

&#9;local tHumanoid = hit.Parent:findFirstChild(&quot;Humanoid&quot;) or hit.Parent.Parent:findFirstChild(&quot;Humanoid&quot;)
&#9;if tHumanoid ~= nil then&#9;
&#9;&#9;local CreatorTag = Instance.new(&quot;ObjectValue&quot;)
&#9;&#9;CreatorTag.Value = vPlayer
&#9;&#9;CreatorTag.Name = &quot;creator&quot;
&#9;&#9;CreatorTag.Parent = tHumanoid
&#9;&#9;hitted = game.Players:findFirstChild(tHumanoid.Parent.Name)
&#9;&#9;if hitted ~= nil and hitted.TeamColor == vPlayer.TeamColor then return end
&#9;&#9;if hit.Name == &quot;Head&quot; then Damage = Damage * 2 end  
&#9;&#9;tHumanoid.Health = tHumanoid.Health - Damage
&#9;end



end

function reload()
&#9;&#9;for i = 1, script.Parent.MAX.Value do
&#9;&#9;&#9;wait(0.3)
&#9;&#9;&#9;if script.Parent.Total.Value &lt;= 0 then break end
&#9;&#9;&#9;script.Parent.Ammo.Value = script.Parent.Ammo.Value + 1
&#9;&#9;&#9;script.Parent.Total.Value = script.Parent.Total.Value - 1
&#9;&#9;&#9;tool.AnimateValue.Value = &quot;Reload&quot; 
&#9;&#9;&#9;message.Text = &quot;Current Ammo : &quot;..script.Parent.Ammo.Value..&quot;/&quot;..script.Parent.Total.Value
&#9;&#9;&#9;if enabled == false then break end
&#9;&#9;&#9;if script.Parent.Ammo.Value &gt; script.Parent.MAX.Value - 1 then
&#9;&#9;&#9;&#9;break
&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;message.Text = &quot;Current Ammo : &quot;..script.Parent.Ammo.Value..&quot;/&quot;..script.Parent.Total.Value
end

function onButton1Down(mouse)

&#9;if not enabled then return end
&#9;if script.Parent.Ammo.Value &lt; 1 then
&#9;&#9;reload(mouse)
&#9;end
&#9;&#9;enabled = false

&#9;&#9;local Character = tool.Parent

&#9;&#9;local Humanoid = Character:findFirstChild(&quot;Humanoid&quot;)
&#9;&#9;if Humanoid == nil then return end
&#9;&#9;&#9;local hum = script.Parent.Parent:findFirstChild(&quot;Humanoid&quot;)
&#9;&#9;&#9;if hum.Health &lt; 1 then return end 
&#9;&#9;local hit = mouse.Target

&#9;&#9;if hit ~= nil then
&#9;&#9;&#9;if (mouse.hit.p - Tool.Parent.Head.Position).magnitude &lt; 50 and (Tool.Parent.Humanoid.TargetPoint - Tool.Parent.Head.Position).magnitude &lt; 50 then
&#9;&#9;&#9;&#9;if script.Parent.Ammo.Value &gt; 0 then
&#9;&#9;&#9;&#9;script.Parent.Ammo.Value = script.Parent.Ammo.Value - 1
message.Text = &quot;Current Ammo : &quot;..script.Parent.Ammo.Value..&quot;/&quot;..script.Parent.Total.Value
&#9;&#9;&#9;&#9;fire(hit)
&#9;&#9;&#9;&#9;print(&quot;close shot&quot;)
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end

&#9;&#9;mouse.Icon = &quot;http://www.roblox.com/asset/?id=16110835&quot;
&#9;&#9;wait(kReload)
&#9;&#9;enabled = true
&#9;&#9;mouse.Icon = &quot;http://www.roblox.com/asset/?id=16110845&quot;

end

function onKeyDown(key)
&#9;if key == &quot;R&quot; or key == &quot;r&quot; then
&#9;&#9;reload()
&#9;end
end

function onEquippedLocal(mouse)

&#9;if mouse == nil then return end
&#9;message = game.Players:findFirstChild(script.Parent.Parent.Name).PlayerGui.help.text
&#9;message.Text = &quot;Current Ammo : &quot;..script.Parent.Ammo.Value..&quot;/&quot;..script.Parent.Total.Value
&#9;mouse.Icon = &quot;http://www.roblox.com/asset/?id=16110845&quot;
&#9;mouse.Button1Down:connect(function() onButton1Down(mouse) end)
&#9;mouse.KeyDown:connect(onKeyDown)
end

function onUnequippedLocal()
end


tool.Unequipped:connect(onUnequippedLocal)
tool.Equipped:connect(onEquippedLocal)</ProtectedString>
				</Properties>
			</Item>
			<Item class="LocalScript" referent="RBX4369">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">crough</string>
					<ProtectedString name="Source">on = 0
Tool = script.Parent
welds = {}
sh = {}
arms = nil
torso = nil
f = nil
function Crouch(ison)
if arms == nil and torso == nil then
arms = {Tool.Parent:FindFirstChild(&quot;Left Leg&quot;), Tool.Parent:FindFirstChild(&quot;Right Leg&quot;)}
torso = Tool.Parent:FindFirstChild(&quot;Torso&quot;)
end
if arms ~= nil and torso ~= nil then
sh = {torso:FindFirstChild(&quot;Left Hip&quot;), torso:FindFirstChild(&quot;Right Hip&quot;)}
if sh ~= nil then
local yes = true
if yes then
yes = false
if ison == 1 then
sh[1].Part1 = nil
sh[2].Part1 = nil
local weld1 = Instance.new(&quot;Weld&quot;)
weld1.Part0 = torso
weld1.Parent = torso
weld1.Part1 = arms[1]
weld1.C1 = CFrame.new(-0.5, 0.75, 1)
arms[1].Name = &quot;LDave&quot;
arms[1].CanCollide = true
welds[1] = weld1
-------------------------------------------
local weld2 = Instance.new(&quot;Weld&quot;)
weld2.Part0 = torso
weld2.Parent = torso
weld2.Part1 = arms[2]
weld2.C1 = CFrame.new(0.5,0.495,1.25) * CFrame.fromEulerAnglesXYZ(math.rad(90),0,0)
arms[2].Name = &quot;RDave&quot;
arms[2].CanCollide = true
welds[2] = weld2
---------------------------------
local force = Instance.new(&quot;BodyForce&quot;)
force.Parent = torso
f = force
wait(0.01)
elseif ison == 0 then
if arms then
sh[1].Part1 = arms[1]
sh[2].Part1 = arms[2]
f.Parent = nil
arms[2].Name = &quot;Right Leg&quot;
arms[1].Name = &quot;Left Leg&quot;
welds[1].Parent = nil
welds[2].Parent = nil
end
end
--
end
else
print(&quot;sh&quot;)
end
else
print(&quot;arms&quot;)
end
end
function Key(key)
if key then
key = string.lower(key)
if (key==&quot;c&quot;) then
if on == 1 then
on = 0
elseif on == 0 then
on = 1
end
Crouch(on)
end
end
end
function Equip(mouse)
mouse.KeyDown:connect(Key)
end
function onUnequippedLocal()
on = 0
Crouch(on)
end


script.Parent.Unequipped:connect(onUnequippedLocal)
script.Parent.Equipped:connect(Equip)

</ProtectedString>
