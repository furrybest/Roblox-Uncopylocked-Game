									<ProtectedString name="Source">while true do
&#9;if script.Parent:findFirstChild(&quot;Check&quot;) then
&#9;&#9;py = script.Parent.Check.Position.Y
&#9;&#9;if py &lt; 12 then 
&#9;&#9;&#9;script.Parent.Parent:BreakJoints()
&#9;&#9;&#9;wait(2)
&#9;&#9;&#9;script.Parent.Parent:remove()
&#9;&#9;end
&#9;else
&#9;&#9;script.Parent.Parent:BreakJoints()
&#9;&#9;wait(2)
&#9;&#9;script.Parent.Parent:remove()
&#9;end
&#9;wait(1)
end

</ProtectedString>
