			<Item class="LocalScript" referent="RBX3697">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">MainScript</string>
					<ProtectedString name="Source">player = script.Parent.Parent.Parent

function saveRecord()
&#9;local ls = player:findFirstChild(&quot;leaderstats&quot;)
&#9;if ls then
&#9;&#9;local ko= ls:findFirstChild(&quot;KOs&quot;)
&#9;&#9;local wo = ls:findFirstChild(&quot;WOs&quot;)
&#9;&#9;local cash = ls:findFirstChild(&quot;Cash&quot;) 
&#9;&#9;if ko and wo and cash then
&#9;&#9;&#9;code = tostring(player.userId*7)..&quot;/&quot;..tostring(ko.Value*7)..&quot;/&quot;..tostring(wo.Value*7)..&quot;/&quot;..tostring(cash.Value*7)
&#9;&#9;&#9;a = &quot;&quot;
&#9;&#9;&#9;for i=1,code:len() do
&#9;&#9;&#9;&#9;if string.sub(code,i,i) == &quot;/&quot; then
&#9;&#9;&#9;&#9;&#9;a=a..&quot;/&quot;
&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;a=a..string.byte(string.sub(code,i,i))
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;&#9;script.Parent:findFirstChild(&quot;PrintCode&quot;).Text = a..&quot;/&quot;..tostring(ko.Value+wo.Value+(cash.Value/2))
&#9;&#9;else
&#9;&#9;&#9;script.Parent:findFirstChild(&quot;PrintCode&quot;).Text = &quot;Can&apos;t print due to object lose.&quot;
&#9;&#9;end
&#9;end
end
script.Parent[&quot;Save&quot;].MouseButton1Down:connect(saveRecord)

function loadRecord()
&#9;local ls = player:findFirstChild(&quot;leaderstats&quot;)
&#9;local inputcode = script.Parent:findFirstChild(&quot;InputCode&quot;) 
&#9;local idmem = {}
&#9;local idprint = &quot;&quot;
&#9;local komem = {}
&#9;local koprint = &quot;&quot;
&#9;local womem = {}
&#9;local woprint = &quot;&quot;
&#9;local cashmem = {} 
&#9;local cashprint = &quot;&quot;
&#9;local secretprint = &quot;&quot;
&#9;local shortmem = &quot;&quot;
&#9;if ls and inputcode then
&#9;&#9;pcall(function ()
&#9;&#9;&#9;local type = 0
&#9;&#9;&#9;local count = 0
&#9;&#9;&#9;code = inputcode.Text
&#9;&#9;&#9;for i=1,code:len() do
&#9;&#9;&#9;&#9;if string.sub(code,i,i) == &quot;/&quot; then
&#9;&#9;&#9;&#9;&#9;type = type + 1
&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;if count == 0 then
&#9;&#9;&#9;&#9;&#9;&#9;count = 1
&#9;&#9;&#9;&#9;&#9;&#9;shortmem = string.sub(code,i,i)
&#9;&#9;&#9;&#9;&#9;else 
&#9;&#9;&#9;&#9;&#9;&#9;count = 0
&#9;&#9;&#9;&#9;&#9;&#9;if type == 0 then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;table.insert(idmem,shortmem..string.sub(code,i,i))
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;if type == 1 then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;table.insert(komem,shortmem..string.sub(code,i,i))
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;if type == 2 then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;table.insert(womem,shortmem..string.sub(code,i,i))
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;if type == 3 then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;table.insert(cashmem,shortmem..string.sub(code,i,i))
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;if type == 4 then
&#9;&#9;&#9;&#9;&#9;&#9;secretprint = secretprint..string.sub(code,i,i)
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;&#9;print(secretprint)
&#9;&#9;&#9;for i=1 ,#idmem do
&#9;&#9;&#9;&#9;idprint = idprint..string.char(idmem[i]) 
&#9;&#9;&#9;end
&#9;&#9;&#9;for i=1 ,#komem do
&#9;&#9;&#9;&#9;koprint = koprint..string.char(komem[i]) 
&#9;&#9;&#9;end
&#9;&#9;&#9;for i=1 ,#womem do
&#9;&#9;&#9;&#9;woprint = woprint..string.char(womem[i]) 
&#9;&#9;&#9;end
&#9;&#9;&#9;for i=1 ,#cashmem do
&#9;&#9;&#9;&#9;cashprint = cashprint..string.char(cashmem[i]) 
&#9;&#9;&#9;end
&#9;&#9;&#9;if tonumber(idprint/7) == player.userId then
&#9;&#9;&#9;&#9;if tonumber((koprint/7)+(woprint/7)+(cashprint/7/2)) == tonumber(secretprint) then
&#9;&#9;&#9;&#9;&#9;local ls = player:findFirstChild(&quot;leaderstats&quot;)
&#9;&#9;&#9;&#9;&#9;if ls then
&#9;&#9;&#9;&#9;&#9;&#9;local ko= ls:findFirstChild(&quot;KOs&quot;)
&#9;&#9;&#9;&#9;&#9;&#9;local wo = ls:findFirstChild(&quot;WOs&quot;)
&#9;&#9;&#9;&#9;&#9;&#9;local cash = ls:findFirstChild(&quot;Cash&quot;) 
&#9;&#9;&#9;&#9;&#9;&#9;ko.Value = tonumber(koprint/7)
&#9;&#9;&#9;&#9;&#9;&#9;wo.Value = tonumber(woprint/7)
&#9;&#9;&#9;&#9;&#9;&#9;cash.Value = tonumber(cashprint/7)
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end)
&#9;end
end
script.Parent[&quot;Load&quot;].MouseButton1Down:connect(loadRecord)
