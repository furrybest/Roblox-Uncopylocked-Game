&#9;&#9;weld1.C1 = CFrame.new(-0.5, 0.8, .9)* CFrame.fromEulerAnglesXYZ(math.rad(290), -0.5, math.rad(-90))
&#9;&#9;weld2.C1 = CFrame.new(-1, 0.8, 0.5) * CFrame.fromEulerAnglesXYZ(math.rad(-100), math.rad(-15), 0)
