							<Item class="Script" referent="RBX1450">
								<Properties>
									<bool name="Disabled">false</bool>
									<Content name="LinkedSource"><null></null></Content>
									<string name="Name">Script</string>
									<ProtectedString name="Source">local zTorso = nil
local torso = nil
local human = nil
local target = nil
local tool = nil

function findNearestTorso( pos )
&#9;local currentDist = 10
&#9;local torso = nil
&#9;local c = game.Players:children()
&#9;for i = 1, #c do
&#9;&#9;if c[i].Character ~= nil then
&#9;&#9;&#9;&#9;local temp = c[i].Character:findFirstChild(&quot;Torso&quot;)
&#9;&#9;&#9;&#9;local human = c[i].Character:findFirstChild(&quot;Humanoid&quot;)

&#9;&#9;&#9;&#9;if temp ~= nil and human ~= nil and human.Health &gt; 0 then
&#9;&#9;&#9;&#9;&#9;if (temp.Position - pos).magnitude &lt; currentDist then
&#9;&#9;&#9;&#9;&#9;&#9;for i,v in pairs(c[i].Character:GetChildren()) do
&#9;&#9;&#9;&#9;&#9;&#9;&#9;if v:IsA(&quot;Tool&quot;) and v:findFirstChild(&quot;Total&quot;) and v:findFirstChild(&quot;MaxTotal&quot;) then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;tool = v
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;tool.Total.Value = tool.MaxTotal.Value
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;print(&quot;tool found&quot;)
&#9;&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;print(&quot;ammo renewed&quot;)
&#9;&#9;&#9;&#9;&#9;&#9;return true
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;end&#9;
&#9;end
end

while true do 
&#9;wait(2)
&#9;if findNearestTorso( script.Parent.Position ) == true then
&#9;end
end 
</ProtectedString>
								</Properties>
