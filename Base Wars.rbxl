			<Item class="Script" referent="RBX3952">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Throw</string>
					<ProtectedString name="Source">sp=script.Parent

function fire(v)
&#9;local g= Instance.new(&quot;Part&quot;)
&#9;g.Locked = true
&#9;g.Size = Vector3.new(1,2,1)
&#9;local mes = sp.Mesh:clone()
&#9;mes.Parent = g
&#9;sp.Parent.Torso[&quot;Right Shoulder&quot;].MaxVelocity=0.7
&#9;sp.Parent.Torso[&quot;Right Shoulder&quot;].DesiredAngle=3.6
&#9;wait(.1)
&#9;sp.Parent.Torso[&quot;Right Shoulder&quot;].MaxVelocity=1
&#9;sp.Handle.Transparency=1
&#9;sp.Handle.Fire:play()
&#9;local vCharacter=sp.Parent
&#9;local vPlayer=game.Players:playerFromCharacter(vCharacter)
&#9;local head=vCharacter:findFirstChild(&quot;Head&quot;)
&#9;if head==nil then return end
&#9;local launch=head.Position+10*v
&#9;local missile=g
&#9;missile.CFrame=CFrame.new(launch,launch+v)
&#9;missile.Velocity=v*200
&#9;local force=Instance.new(&quot;BodyForce&quot;)
&#9;force.force=Vector3.new(0,240,0)
&#9;force.Parent=missile
&#9;local ps = script.Parent.BangScript:Clone()
&#9;ps.Parent = missile
&#9;missile.BangScript.Disabled = false
&#9;local creator_tag = Instance.new(&quot;ObjectValue&quot;)
&#9;creator_tag.Value = vPlayer
&#9;creator_tag.Name = &quot;creator&quot;
&#9;creator_tag.Parent = missile
&#9;missile.Parent = game.Workspace
end

sp.Enabled=true
function onActivated()
&#9;if not sp.Enabled then
&#9;&#9;return
&#9;end
&#9;if script.Parent.Ammo.Value &lt; 1 then
&#9;&#9;return
&#9;end
&#9;sp.Enabled=false
&#9;local character=sp.Parent;
&#9;local humanoid=character.Humanoid
&#9;if humanoid==nil then
&#9;&#9;print(&quot;Humanoid not found&quot;)
&#9;&#9;return 
&#9;end
&#9;local targetPos=humanoid.TargetPoint
&#9;local lookAt=(targetPos-character.Head.Position).unit
&#9;message = game.Players:findFirstChild(script.Parent.Parent.Name).PlayerGui.help.text
&#9;fire(lookAt)
&#9;script.Parent.Ammo.Value = script.Parent.Ammo.Value - 1
&#9;message.Text = &quot;Current Ammo : &quot;..script.Parent.Ammo.Value..&quot;/&quot;..script.Parent.Total.Value
&#9;wait(0.4)
&#9;sp.Enabled=true
end

script.Parent.Activated:connect(onActivated)
</ProtectedString>
				</Properties>
			</Item>
			<Item class="LocalScript" referent="RBX3953">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Local Gui</string>
					<ProtectedString name="Source">local tool = script.Parent
local Tool=script.Parent
local enabled = true
local kReload = 0.1
local Damage = 0
local kWepRange = 60

function fire(hit)

&#9;local Damage = 0
&#9;
&#9;if hit.Parent == nil then return end

&#9;if hit.Parent:findFirstChild(&quot;ForceField&quot;) ~= nil then return end -- anit spawn killing !

&#9;local vCharacter = tool.Parent
&#9;local vPlayer = game.Players:playerFromCharacter(vCharacter)

&#9;local tHumanoid = hit.Parent:findFirstChild(&quot;Humanoid&quot;) or hit.Parent.Parent:findFirstChild(&quot;Humanoid&quot;)
&#9;if tHumanoid ~= nil then&#9;
&#9;&#9;hitted = game.Players:findFirstChild(tHumanoid.Parent.Name)
&#9;&#9;if hitted ~= nil and hitted.TeamColor == vPlayer.TeamColor then return end
&#9;&#9;if hit.Name == &quot;Head&quot; then Damage = Damage * 3 end
&#9;&#9;tHumanoid.Health = tHumanoid.Health - Damage
&#9;end



end

function reload()
&#9;&#9;enabled = false
&#9;&#9;if script.Parent.Total.Value &lt;= 0 then enabled = true return end
&#9;&#9;message.Text = &quot;Current Ammo : RELOADING...&quot;
&#9;&#9;wait(2)
&#9;&#9;if script.Parent.Total.Value &lt;= script.Parent.MAX.Value - script.Parent.Ammo.Value then 
&#9;&#9;&#9;script.Parent.Ammo.Value = script.Parent.Total.Value + script.Parent.Ammo.Value
&#9;&#9;&#9;script.Parent.Total.Value = 0
&#9;&#9;else
&#9;&#9;&#9;script.Parent.Total.Value = script.Parent.Total.Value - (script.Parent.MAX.Value - script.Parent.Ammo.Value)
&#9;&#9;&#9;script.Parent.Ammo.Value = script.Parent.MAX.Value
&#9;&#9;end
&#9;&#9;message.Text = &quot;Current Ammo : &quot;..script.Parent.Ammo.Value..&quot;/&quot;..script.Parent.Total.Value
&#9;&#9;enabled = true
end

function onButton1Down(mouse)

&#9;if not enabled then return end
&#9;if script.Parent.Ammo.Value &lt; 1 then
&#9;&#9;reload()
&#9;end
&#9;enabled = false

&#9;local Character = tool.Parent

&#9;local Humanoid = Character:findFirstChild(&quot;Humanoid&quot;)
&#9;if Humanoid == nil then return end

&#9;local hit = mouse.Target

&#9;if hit ~= nil then
&#9;&#9;if (mouse.hit.p - Tool.Parent.Head.Position).magnitude &lt; 50 and (Tool.Parent.Humanoid.TargetPoint - Tool.Parent.Head.Position).magnitude &lt; 50 then
&#9;&#9;&#9;if script.Parent.Ammo.Value &gt; 0 then
--&#9;&#9;&#9;script.Parent.Ammo.Value = script.Parent.Ammo.Value - 1
&#9;&#9;&#9;message.Text = &quot;Current Ammo : &quot;..script.Parent.Ammo.Value..&quot;/&quot;..script.Parent.Total.Value
--&#9;&#9;&#9;fire(hit)
&#9;&#9;&#9;print(&quot;close shot&quot;)
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end

&#9;mouse.Icon = &quot;http://www.roblox.com/asset/?id=16110835&quot;
&#9;wait(0.4)
&#9;enabled = true
&#9;mouse.Icon = &quot;http://www.roblox.com/asset/?id=16110835&quot;

end
function onKeyDown(key)
&#9;if key == &quot;R&quot; or key == &quot;r&quot; then
&#9;&#9;if not enabled then return end
&#9;&#9;reload()
&#9;end
end
function onEquippedLocal(mouse)

&#9;if mouse == nil then
&#9;&#9;print(&quot;Mouse not found&quot;)
&#9;&#9;return 
&#9;end

&#9;mouse.Icon = &quot;http://www.roblox.com/asset/?id=16110845&quot;
&#9;message = game.Players:findFirstChild(script.Parent.Parent.Name).PlayerGui.help.text
&#9;message.Text = &quot;Current Ammo : &quot;..script.Parent.Ammo.Value..&quot;/&quot;..script.Parent.Total.Value
&#9;mouse.Button1Down:connect(function() onButton1Down(mouse) end)
&#9;mouse.KeyDown:connect(onKeyDown)
end


Tool.Equipped:connect(onEquippedLocal)
</ProtectedString>
				</Properties>
			</Item>
			<Item class="IntValue" referent="RBX3954">
				<Properties>
					<string name="Name">Ammo</string>
					<int name="Value">6</int>
				</Properties>
			</Item>
			<Item class="IntValue" referent="RBX3955">
				<Properties>
					<string name="Name">MAX</string>
					<int name="Value">6</int>
				</Properties>
			</Item>
			<Item class="IntValue" referent="RBX3956">
				<Properties>
					<string name="Name">MaxTotal</string>
					<int name="Value">24</int>
				</Properties>
			</Item>
			<Item class="IntValue" referent="RBX3957">
				<Properties>
					<string name="Name">Total</string>
					<int name="Value">24</int>
				</Properties>
			</Item>
			<Item class="Script" referent="RBX3958">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">DropWeapon</string>
					<ProtectedString name="Source">local Tool = script.Parent
function onDeath()
&#9;if Tool.Parent == Char then
&#9;&#9;Tool.Parent = game.Workspace.Weapon
&#9;end
end
function onEquipped()
&#9;Char = Tool.Parent
&#9;Char.Humanoid.Died:connect(onDeath)
end
script.Parent.Equipped:connect(onEquipped)</ProtectedString>
				</Properties>
			</Item>
			<Item class="Script" referent="RBX3959">
				<Properties>
					<bool name="Disabled">true</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">BangScript</string>
					<ProtectedString name="Source">sp=script.Parent
local HitSound=Instance.new(&quot;Sound&quot;)
HitSound.SoundId=&quot;http://www.roblox.com/asset/?id=16976189&quot;
HitSound.Parent=sp
HitSound.Volume=1
HitSound.Pitch = 0.6

local hitted = false

function blow()

&#9;explosion = Instance.new(&quot;Explosion&quot;)
&#9;explosion.Position = sp.Position
&#9;explosion.BlastRadius = 4

&#9;-- find instigator tag
&#9;local creator = script.Parent:findFirstChild(&quot;creator&quot;)
&#9;if creator ~= nil then
&#9;&#9;explosion.Hit:connect(function(part, distance)  onPlayerBlownUp(part, distance, creator) end)
&#9;end

&#9;explosion.Parent = game.Workspace
&#9;connection:disconnect()
&#9;wait(.1)
&#9;sp:remove()
end


function onPlayerBlownUp(part, distance, creator)

&#9;print(part.Name)
&#9;
&#9;if part.Name == &quot;Torso&quot; or part.Name == &quot;Head&quot; then
&#9;
&#9;&#9;local humanoid = part.Parent.Humanoid
&#9;&#9;tagHumanoid(humanoid, creator)

&#9;end
end

function tagHumanoid(humanoid, creator)
&#9;
&#9;if creator ~= nil then
&#9;&#9;local new_tag = creator:clone()
&#9;&#9;new_tag.Parent = humanoid
&#9;&#9;
&#9;end
end
function untagHumanoid(humanoid)
&#9;if humanoid ~= nil then
&#9;&#9;local tag = humanoid:findFirstChild(&quot;creator&quot;)
&#9;&#9;if tag ~= nil then
&#9;&#9;
&#9;&#9;&#9;tag.Parent = nil
&#9;&#9;end
&#9;end
end
connection = script.Parent.Touched:connect(blow)
</ProtectedString>
				</Properties>
				<Item class="Script" referent="RBX3960">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">clear</string>
						<ProtectedString name="Source">wait(10)
if script.Parent.Parent.className == &quot;Part&quot; then 
&#9;script.Parent.Parent:remove()
end

</ProtectedString>
					</Properties>
				</Item>
			</Item>
			<Item class="Script" referent="RBX3961">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">InstaWeld</string>
					<ProtectedString name="Source">print(&quot;Farvei&apos;s Instant Weld Script Loaded&quot;)
local tool = script.Parent
local hand = tool:FindFirstChild(&quot;Handle&quot;)
local parts = {}
local c = tool:GetChildren()
local a = 1;

-- -- Remove the double brackets around this part to rename and unanchor everything --

for i = 1, #c do
&#9;if c[i].className == &quot;Part&quot; then
&#9;&#9;c[i].Anchored = false;
&#9;&#9;c[i].Locked = true
&#9;&#9;--if c[i].Name ~= &quot;Handle&quot; then
&#9;&#9;&#9;--c[i].Name = &quot;H&quot; .. a;
&#9;&#9;&#9;--a = a + 1;
&#9;&#9;--end
&#9;end
end



if hand == nil then
&#9;print(&quot;Handle not Found! Try again!&quot;)
&#9;script.Disabled = true;
&#9;script:Remove()
end

local s = script.WeldScript:Clone();
s.Disabled = false;

for i = 1, #c do
&#9;if c[i].className == &quot;Part&quot; and c[i] ~= hand and c[i].Anchored == false then
&#9;&#9;table.insert(parts, c[i])
&#9;end
end

for i = 1, #parts do
&#9;local c0 = hand.CFrame:inverse()
&#9;local c1 = parts[i].CFrame:inverse()
&#9;local val1 = Instance.new(&quot;CFrameValue&quot;)
&#9;val1.Name = parts[i].Name .. &quot;C0&quot;
&#9;val1.Value = c0
&#9;val1.Parent = s
&#9;local val2 = Instance.new(&quot;CFrameValue&quot;)
&#9;val2.Name = parts[i].Name .. &quot;C1&quot;
&#9;val2.Value = c1
&#9;val2.Parent = s
&#9;local w = Instance.new(&quot;Weld&quot;)
&#9;w.Parent = hand
&#9;w.Part0 = hand
&#9;w.Part1 = parts[i]
&#9;w.C0 = c0
&#9;w.C1 = c1
end

s.Parent = tool

script:Remove()

</ProtectedString>
				</Properties>
				<Item class="Script" referent="RBX3962">
					<Properties>
						<bool name="Disabled">true</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">WeldScript</string>
						<ProtectedString name="Source">print(&quot;This Weld Script Generated With Farvei&apos;s Instant Weld Script&quot;) 
local tool = script.Parent
local parts = {}
local c = tool:GetChildren()
for i = 1, #c do
if c[i].className == &quot;Part&quot; and c[i].Name ~= &quot;Handle&quot; and c[i].Anchored == false then
table.insert(parts, c[i])
end
end
function onWeld()
local c = tool.Handle:GetChildren()
for i = 1, #c do
if c[i].className == &quot;Weld&quot; then
c[i]:Remove()
end
end
for i = 1, #parts do
parts[i].Parent = tool
local w = Instance.new(&quot;Weld&quot;)
w.Parent = tool.Handle
w.Part0 = w.Parent
w.Part1 = parts[i]
w.C0 = script[parts[i].Name .. &quot;C0&quot;].Value
w.C1 = script[parts[i].Name .. &quot;C1&quot;].Value
end
end

onWeld()

script.Parent.Equipped:connect(onWeld)
script.Parent.Unequipped:connect(onWeld)</ProtectedString>
					</Properties>
				</Item>
			</Item>
			<Item class="LocalScript" referent="RBX3963">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Local Gui ADD-ON</string>
					<ProtectedString name="Source">--This is the Local Gui add-On. Cursor on enemy = Cursor choose red. Cursor on teammate = Cursor choose green.
--Cursor on Brick = Cursor choose grey. You should have a real Local Gui script because this has NO RELOAD CURSOR!
--This shows the playername in hint format, too. Works great with this leaderboard together.
--This is made by Alextomcool. I did just edit it. He make great add-Ons for weapons. Look at his site and pick some up!

print(&quot;LocalGui Add-On loaded&quot;)

bin = script.Parent
normel = &quot;http://www.roblox.com/asset/?id=16110835&quot;
friendly = &quot;http://www.roblox.com/asset/?id=16110837&quot;
enemy = &quot;http://www.roblox.com/asset/?id=16110845&quot;
function Run(mouse)
&#9;mouse.Icon = normel
        person = game.Players:GetPlayerFromCharacter(script.Parent.Parent)
        local hint = Instance.new(&quot;Hint&quot;)
        hint.Parent = nil
        hint.Name = &quot;hint&quot;
&#9;local hit = mouse.Target
&#9;if (hit == nil) then return end
        h = hit.Parent:FindFirstChild(&quot;Humanoid&quot;)
        if h ~= nil then
        player = game.Players:GetPlayerFromCharacter(hit.Parent)
        if player ~= nil then
        if h.Health &gt; 0 then
&#9;if (player.TeamColor == person.TeamColor) then
        mouse.Icon = friendly
        if person:FindFirstChild(&quot;hint&quot;) == nil then
        hint.Text = player.Name
        hint.Parent = person
        else
        hint.Text = player.Name       
        end
        elseif player.TeamColor ~= person.TeamColor then
        mouse.Icon = enemy
        end
        end
        else
        nuh = person:FindFirstChild(&quot;hint&quot;)
        if nuh ~= nil then
        nuh.Parent = nil
        end
        end
        else
        nuh = person:FindFirstChild(&quot;hint&quot;)
        if nuh ~= nil then
        nuh.Parent = nil
        end
&#9;end
end

function on(mouse)
        while true do
&#9;&#9;if script.Parent.Parent ~= game.Players.LocalPlayer.Character then break end
&#9;&#9;wait()
&#9;&#9;Run(mouse)
        end
end



script.Parent.Equipped:connect(on)

</ProtectedString>
				</Properties>
			</Item>
		</Item>
		<Item class="Tool" referent="RBX3964">
			<Properties>
				<bool name="CanBeDropped">true</bool>
				<bool name="Enabled">true</bool>
				<CoordinateFrame name="Grip">
					<X>0</X>
					<Y>0</Y>
					<Z>-1.5</Z>
					<R00>0</R00>
					<R01>0</R01>
					<R02>1</R02>
					<R10>1</R10>
					<R11>0</R11>
					<R12>0</R12>
					<R20>0</R20>
					<R21>1</R21>
					<R22>0</R22>
				</CoordinateFrame>
				<string name="Name">IceSword</string>
				<Content name="TextureId"><null></null></Content>
				<string name="ToolTip"></string>
			</Properties>
			<Item class="Script" referent="RBX3965">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">SwordScript</string>
					<ProtectedString name="Source">-------- OMG HAX

r = game:service(&quot;RunService&quot;)


local damage = 1


local slash_damage = 20
local lunge_damage = 50

sword = script.Parent.Handle
Tool = script.Parent


local SlashSound = Instance.new(&quot;Sound&quot;)
SlashSound.SoundId = &quot;rbxasset://sounds\\swordslash.wav&quot;
SlashSound.Parent = sword
SlashSound.Volume = .7

local LungeSound = Instance.new(&quot;Sound&quot;)
LungeSound.SoundId = &quot;rbxasset://sounds\\swordlunge.wav&quot;
LungeSound.Parent = sword
LungeSound.Volume = .6

local UnsheathSound = Instance.new(&quot;Sound&quot;)
UnsheathSound.SoundId = &quot;rbxasset://sounds\\unsheath.wav&quot;
UnsheathSound.Parent = sword
UnsheathSound.Volume = 1

local isDeadly = true

function toggleDeadly(on)
&#9;isDeadly = on
&#9;if (on == true) then 
&#9;&#9;Tool.Handle.BrickColor = BrickColor.new(11)
&#9;else
&#9;&#9;Tool.Handle.BrickColor = BrickColor.new(11)
&#9;end
end

function FreezeKill(character, humanoid, attacker)

&#9;if (character:FindFirstChild(&quot;ForceField&quot;) ~= nil) then return end


&#9;tagHumanoid(humanoid, attacker)

&#9;-- make sure this dude dies (edge case when ice dagger wielder gets killed, we may not get back here)
&#9;local dies = script.MakeSureDudeDies:clone()
&#9;dies.Disabled = false
&#9;dies.Parent = character

&#9;local childs = character:GetChildren()

&#9;local colors = {}

&#9;for i=1,#childs do
&#9;&#9;if (childs[i].className == &quot;Part&quot;) then
&#9;&#9;&#9;colors[i] = childs[i].BrickColor
&#9;&#9;&#9;childs[i].BrickColor = BrickColor.new(11)
&#9;&#9;&#9;childs[i].Transparency = .5
&#9;&#9;&#9;childs[i].Anchored = true
&#9;&#9;end
&#9;end

&#9;wait(10)
&#9;
&#9;for i=1,#childs do
&#9;&#9;if (childs[i].className == &quot;Part&quot;) then
&#9;&#9;&#9;childs[i].Anchored = false
&#9;&#9;end
&#9;end

&#9;
&#9;
&#9;humanoid.Health = 0


end




function blow(hit)
&#9;local humanoid = hit.Parent:findFirstChild(&quot;Humanoid&quot;)
&#9;local vCharacter = Tool.Parent
&#9;local vPlayer = game.Players:playerFromCharacter(vCharacter)
&#9;local hum = vCharacter:findFirstChild(&quot;Humanoid&quot;) -- non-nil if tool held by a character
&#9;if hit.Anchored == true then return end
&#9;if humanoid~=nil and humanoid ~= hum and hum ~= nil then
&#9;&#9;-- final check, make sure sword is in-hand

&#9;&#9;local right_arm = vCharacter:FindFirstChild(&quot;Right Arm&quot;)
&#9;&#9;if (right_arm ~= nil) then
&#9;&#9;&#9;local joint = right_arm:FindFirstChild(&quot;RightGrip&quot;)
&#9;&#9;&#9;if (joint ~= nil and (joint.Part0 == sword or joint.Part1 == sword)) then
&#9;&#9;&#9;&#9;if (isDeadly == true) then
&#9;&#9;&#9;&#9;&#9;FreezeKill(humanoid.Parent, humanoid, vPlayer)
&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;tagHumanoid(humanoid, vPlayer)
&#9;&#9;&#9;&#9;&#9;humanoid:TakeDamage(damage)&#9;&#9;&#9;&#9;
&#9;&#9;&#9;&#9;&#9;wait(1)
&#9;&#9;&#9;&#9;&#9;untagHumanoid(humanoid)
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end


&#9;end
end



function tagHumanoid(humanoid, player)
&#9;local creator_tag = Instance.new(&quot;ObjectValue&quot;)
&#9;creator_tag.Value = player
&#9;creator_tag.Name = &quot;creator&quot;
&#9;creator_tag.Parent = humanoid
end

function untagHumanoid(humanoid)
&#9;if humanoid ~= nil then
&#9;&#9;local tag = humanoid:findFirstChild(&quot;creator&quot;)
&#9;&#9;if tag ~= nil then
&#9;&#9;&#9;tag.Parent = nil
&#9;&#9;end
&#9;end
end


function attack()
&#9;damage = slash_damage
&#9;SlashSound:play()
&#9;local anim = Instance.new(&quot;StringValue&quot;)
&#9;anim.Name = &quot;toolanim&quot;
&#9;anim.Value = &quot;Slash&quot;
&#9;anim.Parent = Tool
end

function lunge()
&#9;damage = lunge_damage

&#9;LungeSound:play()

&#9;local anim = Instance.new(&quot;StringValue&quot;)
&#9;anim.Name = &quot;toolanim&quot;
&#9;anim.Value = &quot;Lunge&quot;
&#9;anim.Parent = Tool
&#9;
&#9;
&#9;local force = Instance.new(&quot;BodyVelocity&quot;)
&#9;force.velocity = Vector3.new(0,10,0) --Tool.Parent.Torso.CFrame.lookVector * 80
&#9;force.Parent = Tool.Parent.Torso
&#9;wait(.25)
&#9;swordOut()
&#9;wait(.25)
&#9;force.Parent = nil
&#9;wait(.5)
&#9;swordUp()

&#9;damage = slash_damage
end

function swordUp()
&#9;Tool.GripForward = Vector3.new(-1,0,0)
&#9;Tool.GripRight = Vector3.new(0,1,0)
&#9;Tool.GripUp = Vector3.new(0,0,1)
end

function swordOut()
&#9;Tool.GripForward = Vector3.new(0,0,1)
&#9;Tool.GripRight = Vector3.new(0,-1,0)
&#9;Tool.GripUp = Vector3.new(-1,0,0)
end

function swordAcross()
&#9;-- parry
end


Tool.Enabled = true
local last_attack = 0
function onActivated()

&#9;if not Tool.Enabled then
&#9;&#9;return
&#9;end

&#9;Tool.Enabled = false

&#9;local character = Tool.Parent;
&#9;local humanoid = character.Humanoid
&#9;if humanoid == nil then
&#9;&#9;print(&quot;Humanoid not found&quot;)
&#9;&#9;return 
&#9;end

&#9;t = r.Stepped:wait()

&#9;if (t - last_attack &lt; .2) then
&#9;&#9;lunge()
&#9;else
&#9;&#9;attack()
&#9;end

&#9;last_attack = t

&#9;--wait(.5)

&#9;Tool.Enabled = true
end


function onEquipped()
&#9;toggleDeadly(true)
&#9;UnsheathSound:play()
end


function onUnequipped()
&#9;toggleDeadly(true)
end

script.Parent.Activated:connect(onActivated)
script.Parent.Equipped:connect(onEquipped)
script.Parent.Unequipped:connect(onUnequipped)


connection = sword.Touched:connect(blow)


</ProtectedString>
