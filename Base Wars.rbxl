			<Item class="Script" referent="RBX4008">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">DropWeapon</string>
					<ProtectedString name="Source">local Tool = script.Parent
function onDeath()
&#9;if Tool.Parent == Char then
&#9;&#9;Tool.Parent = game.Workspace.Weapon
&#9;end
end
function onEquipped()
&#9;Char = Tool.Parent
&#9;Char.Humanoid.Died:connect(onDeath)
end
script.Parent.Equipped:connect(onEquipped)</ProtectedString>
				</Properties>
			</Item>
			<Item class="LocalScript" referent="RBX4009">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Local Gui ADD-ON</string>
					<ProtectedString name="Source">--This is the Local Gui add-On. Cursor on enemy = Cursor choose red. Cursor on teammate = Cursor choose green.
--Cursor on Brick = Cursor choose grey. You should have a real Local Gui script because this has NO RELOAD CURSOR!
--This shows the playername in hint format, too. Works great with this leaderboard together.
--This is made by Alextomcool. I did just edit it. He make great add-Ons for weapons. Look at his site and pick some up!

print(&quot;LocalGui Add-On loaded&quot;)

bin = script.Parent
normel = &quot;http://www.roblox.com/asset/?id=16110835&quot;
friendly = &quot;http://www.roblox.com/asset/?id=16110837&quot;
enemy = &quot;http://www.roblox.com/asset/?id=16110845&quot;
function Run(mouse)
&#9;mouse.Icon = normel
        person = game.Players:GetPlayerFromCharacter(script.Parent.Parent)
        local hint = Instance.new(&quot;Hint&quot;)
        hint.Parent = nil
        hint.Name = &quot;hint&quot;
&#9;local hit = mouse.Target
&#9;if (hit == nil) then return end
        h = hit.Parent:FindFirstChild(&quot;Humanoid&quot;)
        if h ~= nil then
        player = game.Players:GetPlayerFromCharacter(hit.Parent)
        if player ~= nil then
        if h.Health &gt; 0 then
&#9;if (player.TeamColor == person.TeamColor) then
        mouse.Icon = friendly
        if person:FindFirstChild(&quot;hint&quot;) == nil then
        hint.Text = player.Name
        hint.Parent = person
        else
        hint.Text = player.Name       
        end
        elseif player.TeamColor ~= person.TeamColor then
        mouse.Icon = enemy
        end
        end
        else
        nuh = person:FindFirstChild(&quot;hint&quot;)
        if nuh ~= nil then
        nuh.Parent = nil
        end
        end
        else
        nuh = person:FindFirstChild(&quot;hint&quot;)
        if nuh ~= nil then
        nuh.Parent = nil
        end
&#9;end
end

function on(mouse)
        while true do
&#9;&#9;if script.Parent.Parent ~= game.Players.LocalPlayer.Character then break end
&#9;&#9;wait()
&#9;&#9;Run(mouse)
        end
end



script.Parent.Equipped:connect(on)

</ProtectedString>
				</Properties>
			</Item>
		</Item>
		<Item class="Tool" referent="RBX4010">
			<Properties>
				<bool name="CanBeDropped">true</bool>
				<bool name="Enabled">true</bool>
				<CoordinateFrame name="Grip">
					<X>0.100000001</X>
					<Y>0.5</Y>
					<Z>0.400000006</Z>
					<R00>0.980582833</R00>
					<R01>3.16649675e-006</R01>
					<R02>0.196105212</R02>
					<R10>-0.196105212</R10>
					<R11>3.20076942e-005</R11>
