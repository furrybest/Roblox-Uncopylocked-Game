			<Item class="LocalScript" referent="RBX4708">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Local Gui ADD-ON</string>
					<ProtectedString name="Source">--This is the Local Gui add-On. Cursor on enemy = Cursor choose red. Cursor on teammate = Cursor choose green.
--Cursor on Brick = Cursor choose grey. You should have a real Local Gui script because this has NO RELOAD CURSOR!
--This shows the playername in hint format, too. Works great with this leaderboard together.
--This is made by Alextomcool. I did just edit it. He make great add-Ons for weapons. Look at his site and pick some up!

print(&quot;LocalGui Add-On loaded&quot;)

bin = script.Parent
normel = &quot;http://www.roblox.com/asset/?id=16110835&quot;
friendly = &quot;http://www.roblox.com/asset/?id=16110837&quot;
enemy = &quot;http://www.roblox.com/asset/?id=16110845&quot;
function Run(mouse)
&#9;mouse.Icon = normel
        person = script.Parent.Parent.Parent
        local hint = Instance.new(&quot;Hint&quot;)
        hint.Parent = nil
        hint.Name = &quot;hint&quot;
&#9;local hit = mouse.Target
&#9;if (hit == nil) then return end
        h = hit.Parent:FindFirstChild(&quot;Humanoid&quot;)
        if h ~= nil then
        player = game.Players:GetPlayerFromCharacter(hit.Parent)
        if player ~= nil then
        if h.Health &gt; 0 then
&#9;if (player.TeamColor == person.TeamColor) then
        mouse.Icon = friendly
        if person:FindFirstChild(&quot;hint&quot;) == nil then
        hint.Text = player.Name
        hint.Parent = person
        else
        hint.Text = player.Name       
        end
        elseif player.TeamColor ~= person.TeamColor then
        mouse.Icon = enemy
        end
        end
        else
        nuh = person:FindFirstChild(&quot;hint&quot;)
        if nuh ~= nil then
        nuh.Parent = nil
        end
        end
        else
        nuh = person:FindFirstChild(&quot;hint&quot;)
        if nuh ~= nil then
        nuh.Parent = nil
        end
&#9;end
end







function on(mouse)
        while true do
&#9;if script.Parent.Active == false then break end 
        wait()
&#9;Run(mouse)
        end
end



script.Parent.Selected:connect(on)

</ProtectedString>
				</Properties>
			</Item>
		</Item>
		<Item class="HopperBin" referent="RBX4709">
			<Properties>
				<bool name="Active">false</bool>
				<token name="BinType">0</token>
				<string name="Name">Plane</string>
				<Content name="TextureId"><null></null></Content>
			</Properties>
			<Item class="Script" referent="RBX4710">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Flier</string>
					<ProtectedString name="Source">fly = false
turn = false
fire = true
a = 80
hover = false
bin = script.Parent


function fire(pln,spn)
&#9;local missile = bin.Rocket:clone()
&#9;missile.CFrame = spn.CFrame * CFrame.new(0, 0, -(a*1.2) )

&#9;missile.RocketScript.Disabled = false
&#9;missile.Parent = game.Workspace

&#9;local creator_tag = Instance.new(&quot;ObjectValue&quot;)
&#9;creator_tag.Value = game.Players.LocalPlayer
&#9;creator_tag.Name = &quot;creator&quot;
&#9;creator_tag.Parent = missile

&#9;missile.Owner.Value = pln
end

function onMiniGun(gun)
&#9;&#9;local p = Instance.new(&quot;Part&quot;)
&#9;&#9;p.Name = &quot;Bullet&quot;
&#9;&#9;p.CFrame = gun.CFrame + (gun.CFrame.lookVector * 50)
&#9;&#9;p.BrickColor = BrickColor.new(&quot;Bright orange&quot;)
&#9;&#9;p.Reflectance = 0.1
&#9;&#9;p.Size = Vector3.new(1, 1,20)
&#9;&#9;p.formFactor = 2
&#9;&#9;p.CanCollide = false
&#9;&#9;local upforce = Instance.new(&quot;BodyForce&quot;)
&#9;&#9;upforce.force = Vector3.new(0, p:GetMass() * 196, 0)
&#9;&#9;upforce.Parent = p
&#9;&#9;p.Velocity = gun.CFrame.lookVector * 600
&#9;&#9;local new_script = script.Parent.LaserBlast:clone()
&#9;&#9;new_script.Disabled = false
&#9;&#9;new_script.Parent = p
&#9;&#9;script.Parent.Mesh:clone().Parent= p
&#9;&#9;local creator_tag = Instance.new(&quot;ObjectValue&quot;)
&#9;&#9;creator_tag.Value = game.Players.LocalPlayer
&#9;&#9;creator_tag.Name = &quot;creator&quot;
&#9;&#9;creator_tag.Parent = p
&#9;&#9;gun.Fire:Play()
&#9;&#9;p.Parent = game.Workspace
end

function bomb(pln,spn)
&#9;local missile = bin.Bomb:clone()
&#9;missile.CFrame = spn.CFrame * CFrame.new(0, -4, 0)

&#9;missile.RocketScript.Disabled = false
&#9;missile.Parent = game.Workspace

&#9;local creator_tag = Instance.new(&quot;ObjectValue&quot;)
&#9;creator_tag.Value = game.Players.LocalPlayer
&#9;creator_tag.Name = &quot;creator&quot;
&#9;creator_tag.Parent = missile

&#9;missile.Owner.Value = pln
end

function move(target, engine)
&#9;local origincframe = engine:findFirstChild(&quot;BodyGyro&quot;).cframe
&#9;local dir = (target - engine.Position).unit
&#9;local spawnPos = engine.Position

&#9;local pos = spawnPos + (dir * 1)

&#9;engine:findFirstChild(&quot;BodyGyro&quot;).maxTorque = Vector3.new(90000, 90000, 90000)
&#9;engine:findFirstChild(&quot;BodyGyro&quot;).cframe = CFrame.new(pos,  pos + dir)
&#9;wait(0.1)
--&#9;engine:findFirstChild(&quot;BodyGyro&quot;).maxTorque = Vector3.new(0, 0, 0)
--&#9;engine:findFirstChild(&quot;BodyGyro&quot;).cframe = origincframe
end

function onButton1Down(mouse)
&#9;if fly == true then
&#9;&#9;turn = true
&#9;&#9;while turn == true do
&#9;&#9;&#9;if heli ~= nil then
&#9;&#9;&#9;&#9;local engine = heli.Parts.Engine
&#9;&#9;&#9;&#9;local position = mouse.Hit
&#9;&#9;&#9;&#9;local target = position.p
&#9;&#9;&#9;&#9;move(target, engine)
&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;break
&#9;&#9;&#9;end
&#9;&#9;&#9;wait(0.1)
&#9;&#9;end
&#9;end
end

function onButton1Up()
&#9;turn = false
end

function onKeyDown(key)
&#9;key:lower()
&#9;if key == &quot;y&quot; and script.Parent.Parent.Parent.Character:FindFirstChild(&quot;Plane&quot;) ~= nil then
&#9;&#9;fly = true
&#9;&#9;heli = script.Parent.Parent.Parent.Character:FindFirstChild(&quot;Plane&quot;)
&#9;&#9;while fly == true do
&#9;&#9;&#9;if hover == false then
&#9;&#9;&#9;&#9;if heli ~= nil then
&#9;&#9;&#9;&#9;&#9;if heli.Parts:FindFirstChild(&quot;Engine&quot;) ~= nil then
&#9;&#9;&#9;&#9;&#9;&#9;heli.Parts.Engine.BodyVelocity.maxForce = Vector3.new(1e+030,1e+030,1e+030)
&#9;&#9;&#9;&#9;&#9;&#9;heli.Parts.Engine.BodyVelocity.velocity = heli.Parts.Engine.CFrame.lookVector * a
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;&#9;wait(0.1)
&#9;&#9;end
&#9;elseif key == &quot;x&quot; and fly == true then
&#9;&#9;fly = false
&#9;&#9;if heli ~= nil then
&#9;&#9;&#9;if heli.Parts:FindFirstChild(&quot;Engine&quot;) ~= nil then
&#9;&#9;&#9;&#9;heli.Parts.Engine.BodyVelocity.maxForce = Vector3.new(0,0,0)
&#9;&#9;&#9;&#9;heli.Parts.Engine.BodyVelocity.velocity = Vector3.new(0,0,0)
&#9;&#9;&#9;&#9;heli.Parts.Engine:findFirstChild(&quot;BodyGyro&quot;).maxTorque = Vector3.new(0, 0, 0)
&#9;&#9;&#9;end
&#9;&#9;end
&#9;elseif key == &quot;d&quot; then
&#9;&#9;if a &lt; 80 then
&#9;&#9;&#9;a = a + 20
&#9;&#9;end
&#9;elseif key == &quot;a&quot; then
&#9;&#9;if a &gt; 40 then
&#9;&#9;&#9;a = a - 20
&#9;&#9;end
&#9;elseif (key==&quot;r&quot;) and (bin.Reload.Value == 0) and fly == true then
&#9;&#9;&#9;local gun1 = heli.Parts:FindFirstChild(&quot;Gun1&quot;)
&#9;&#9;&#9;local gun2 = heli.Parts:FindFirstChild(&quot;Gun2&quot;)
&#9;&#9;&#9;fire(heli,gun1)
&#9;&#9;&#9;fire(heli,gun2)
&#9;&#9;&#9;bin.Reload.Value = 1
&#9;&#9;&#9;gun1.Transparency = 1
&#9;&#9;&#9;gun2.Transparency = 1
&#9;&#9;&#9;wait(10)
&#9;&#9;&#9;gun1.Transparency = 0
&#9;&#9;&#9;gun2.Transparency = 0
&#9;&#9;&#9;bin.Reload.Value = 0
&#9;elseif (key==&quot;b&quot;) and (bin.Reload1.Value == 0) and fly == true then
&#9;&#9;&#9;local engine = heli.Parts:FindFirstChild(&quot;Engine&quot;)
&#9;&#9;&#9;bomb(heli,engine)
&#9;&#9;&#9;bin.Reload1.Value = 1
--&#9;&#9;&#9;wait(10)
--&#9;&#9;&#9;bin.Reload1.Value = 0
&#9;elseif (key==&quot;f&quot;) and (bin.Reload2.Value == 0) and fly == true then
&#9;&#9;&#9;bin.Reload2.Value = 1
&#9;&#9;&#9;while true do
&#9;&#9;&#9;&#9;if bin.Reload2.Value == 0 then break end
&#9;&#9;&#9;&#9;if fly == false then break end
&#9;&#9;&#9;&#9;local mgun1 = heli.Parts:FindFirstChild(&quot;MGun1&quot;)
&#9;&#9;&#9;&#9;local mgun2 = heli.Parts:FindFirstChild(&quot;MGun2&quot;)
&#9;&#9;&#9;&#9;onMiniGun(mgun1)
&#9;&#9;&#9;&#9;onMiniGun(mgun2)
&#9;&#9;&#9;&#9;wait(0.2)
&#9;&#9;&#9;end
&#9;end
end

function onKeyUp(key)
&#9;key:lower()
&#9;if key == &quot;f&quot; then
&#9;&#9;bin.Reload2.Value = 0
&#9;end
end

function onSelect(mouse)
&#9;mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
&#9;mouse.Button1Down:connect(function() onButton1Down(mouse) end)
&#9;mouse.Button1Up:connect(onButton1Up)
&#9;mouse.KeyDown:connect(onKeyDown)
&#9;mouse.KeyUp:connect(onKeyUp)
&#9;message = game.Players.LocalPlayer.PlayerGui.help.Vehicle
&#9;message.Text = &quot;Jet control ---  Start/Stop : Y/X , Direction control : [Mouse Click] , Speed Setting : D/A , Rocket : R , MiniGun : hold F , Bomb(1 time) : B&quot;
end

script.Parent.Selected:connect(onSelect)
</ProtectedString>
