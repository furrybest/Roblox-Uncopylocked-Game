						<Item class="Script" referent="RBX1736">
							<Properties>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">Hat</string>
								<ProtectedString name="Source">debounce = true

function onTouched(hit)
&#9;if (hit.Parent:findFirstChild(&quot;Humanoid&quot;) ~= nil and debounce == true) then
&#9;&#9;local g = script.Parent.Parent:findFirstChild(&quot;Soldier&quot;) -- The name of your template
&#9;&#9;debounce = false
&#9;&#9;wait(0.2)
&#9;&#9;h = Instance.new(&quot;Hat&quot;)
&#9;&#9;p = Instance.new(&quot;Part&quot;)
&#9;&#9;h.Name = &quot;Hat&quot; --- Name of the Hat on the toucher
&#9;&#9;p.Parent = h
&#9;&#9;p.Position = hit.Parent:findFirstChild(&quot;Head&quot;).Position
&#9;&#9;p.Name = &quot;Handle&quot; 
&#9;&#9;p.formFactor = 0
&#9;&#9;p.Size = Vector3.new(2, 1, 1) 
&#9;&#9;p.BottomSurface = 0 
&#9;&#9;p.TopSurface = 0 
&#9;&#9;p.Locked = true 
&#9;&#9;g.HAT.Mesh:clone().Parent = p -- HAT is the model HAT in the costume make sure both names are the same
&#9;&#9;h.Parent = hit.Parent
&#9;&#9;h.AttachmentPos = Vector3.new(0, -0.15, 0.03)
&#9;&#9;wait(0.8)
&#9;&#9;debounce = true
&#9;end
end

script.Parent.Touched:connect(onTouched)</ProtectedString>
							</Properties>
						</Item>
						<Item class="Script" referent="RBX1737">
							<Properties>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">PantRemover</string>
								<ProtectedString name="Source">debounce = true

function onTouched(hit)
&#9;if (hit.Parent:findFirstChild(&quot;Humanoid&quot;) ~= nil and debounce == true) then
&#9;&#9;debounce = false
&#9;&#9;if not (hit.Parent.Pants == nil) then
&#9;&#9;&#9;hit.Parent.Pants:remove() --deletes pants of the toucher
&#9;&#9;end
&#9;&#9;wait(1)
&#9;&#9;debounce = true
&#9;end
end

script.Parent.Touched:connect(onTouched)</ProtectedString>
							</Properties>
						</Item>
						<Item class="Script" referent="RBX1738">
							<Properties>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">ShirtRemover</string>
								<ProtectedString name="Source">debounce = true

function onTouched(hit)
&#9;if (hit.Parent:findFirstChild(&quot;Humanoid&quot;) ~= nil and debounce == true) then
&#9;&#9;debounce = false
&#9;&#9;if not (hit.Parent.Shirt == nil) then
&#9;&#9;&#9;hit.Parent.Shirt:remove()&#9;-- deletes shirt on toucher
&#9;&#9;end
&#9;&#9;wait(1)
&#9;&#9;debounce = true
&#9;end
end

script.Parent.Touched:connect(onTouched)</ProtectedString>
							</Properties>
						</Item>
						<Item class="Script" referent="RBX1739">
							<Properties>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">Debounce</string>
								<ProtectedString name="Source">debounce = true
button = script.Parent

function onTouched(hit)
&#9;if (hit.Parent:findFirstChild(&quot;Humanoid&quot;) ~= nil and debounce == true) then
&#9;&#9;debounce = false
&#9;&#9;button.BrickColor = BrickColor.Red()
&#9;&#9;wait(1)
&#9;&#9;button.BrickColor = BrickColor.Green()
&#9;&#9;debounce = true
&#9;end
end


button.Touched:connect(onTouched)

--makes the button colors when touch like a button--</ProtectedString>
							</Properties>
						</Item>
						<Item class="Script" referent="RBX1740">
							<Properties>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">Colors</string>
								<ProtectedString name="Source">debounce = true

function onTouched(hit)
&#9;local h = hit.Parent:findFirstChild(&quot;Humanoid&quot;)
&#9;local p = game.Players:GetPlayerFromCharacter(h.Parent) 
&#9;if (h ~= nil and debounce == true) then
&#9;&#9;local g = script.Parent.Parent:findFirstChild(&quot;Soldier&quot;) --change this to the template name
&#9;&#9;local b = g:findFirstChild(&quot;Body Colors&quot;)
&#9;&#9;local c = hit.Parent:findFirstChild(&quot;Body Colors&quot;)
&#9;&#9;debounce = false
&#9;&#9;c:remove()
&#9;&#9;t = b:clone() -- insert this &quot;t.TorsoColor = p.TeamColor&quot; if you want to be a team uniform
&#9;&#9;t.Parent = hit.Parent
&#9;&#9;wait(1)
&#9;&#9;debounce = true
&#9;end
end

script.Parent.Touched:connect(onTouched)</ProtectedString>
							</Properties>
						</Item>
						<Item class="Script" referent="RBX1741">
							<Properties>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">HatRemover</string>
								<ProtectedString name="Source">function onTouched(hit) 
&#9;local d = hit.Parent:GetChildren() 
&#9;for i=1, #d do 
&#9;&#9;if (d[i].className == &quot;Hat&quot;) then 
&#9;&#9;&#9;d[i]:remove() 
&#9;&#9;end 
&#9;end
end 

script.Parent.Touched:connect(onTouched) </ProtectedString>
							</Properties>
						</Item>
						<Item class="Script" referent="RBX1742">
							<Properties>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">Decals</string>
								<ProtectedString name="Source">debounce = true

function onTouched(hit)
&#9;if (hit.Parent:findFirstChild(&quot;Humanoid&quot;) ~= nil and debounce == true) then
&#9;&#9;local t = hit.Parent.Torso -- change the last part to which place the decal go.
&#9;&#9;debounce = false
&#9;&#9;d = Instance.new(&quot;Decal&quot;)
&#9;&#9;d.Name = &quot;soldier&quot; -- name the decal
&#9;&#9;d.Face = 5 --insert here which face and here is the codes &quot;http://wiki.roblox.com/index.php?title=Face&quot;. Five is an unused number.
&#9;&#9;d.Texture = &quot;http://www.roblox.com/asset/?id=15946096&quot; --insert here the link of the decal
&#9;&#9;d.Parent = t
&#9;&#9;wait(1)
&#9;&#9;debounce = true
&#9;end
end

script.Parent.Touched:connect(onTouched)</ProtectedString>
