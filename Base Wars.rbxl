					<Item class="Script" referent="RBX3168">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Activate</string>
							<ProtectedString name="Source">button = script.Parent
regen = button.Parent.Regen

local debounce = false

function onTouch(hit)
&#9;if debounce == false then
&#9;&#9;debounce = true
&#9;&#9;button.BrickColor = BrickColor.Black()
&#9;&#9;regen.Value = 1
&#9;&#9;wait()
&#9;&#9;regen.Value = 0
&#9;&#9;wait(5)
&#9;&#9;button.BrickColor = BrickColor.new(104)
&#9;&#9;debounce = false
&#9;end
end
button.ClickDetector.MouseClick:connect(onTouch)</ProtectedString>
						</Properties>
					</Item>
					<Item class="ClickDetector" referent="RBX3169">
						<Properties>
							<float name="MaxActivationDistance">100</float>
							<string name="Name">ClickDetector</string>
						</Properties>
					</Item>
				</Item>
				<Item class="Script" referent="RBX3170">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">system = script.Parent
model = system.Station1
backup = model:Clone()
regen = system.Regen

function checkRegen()&#9;checkmodel=model:GetChildren()

&#9;if regen.Value == 1 and #checkmodel &lt; 1 then

&#9;&#9;model:remove()

&#9;&#9;wait(1)
&#9;&#9;model = backup:Clone()
&#9;&#9;model.Parent = system
&#9;&#9;model:MakeJoints()
&#9;end
end
regen.Changed:connect(checkRegen)</ProtectedString>
					</Properties>
				</Item>
			</Item>
