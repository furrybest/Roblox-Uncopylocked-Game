			<Item class="LocalScript" referent="RBX3691">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">run</string>
					<ProtectedString name="Source">c1x = game.Workspace.kill.c1
b1x = game.Workspace.kill.b1
a1x = game.Workspace.kill.a1


while true do 
&#9;&#9;wait(2)
&#9;&#9;script.Parent.Frame.c1.Text = c1x.Value
&#9;&#9;wait(0.05)
&#9;&#9;script.Parent.Frame.b1.Text = b1x.Value
&#9;&#9;wait(0.05)
&#9;&#9;script.Parent.Frame.a1.Text = a1x.Value
&#9;&#9;wait(0.05)
end

</ProtectedString>
				</Properties>
			</Item>
