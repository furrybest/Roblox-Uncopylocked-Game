texture2 = &quot;http://www.roblox.com/asset/?id=21982726&quot;
regen = game.Workspace.AdminRoom
backup = game.Workspace.AdminRoom:clone()

function check(player)
        for i = 1,#permission do
                if string.lower(player.Name)==string.lower(permission[i]) then return true end
        end
        return false
end

function onChatted(msg, recipient, speaker) 

local source = string.lower(speaker.Name) 

&#9;if (string.lower(msg) == &quot;join/yellow&quot;) then 
&#9;&#9;local yellow = 0
&#9;&#9;local green = 0
&#9;&#9;for i,v in pairs(game.Players:GetChildren()) do
&#9;&#9;&#9;if v.TeamColor == BrickColor.new(&quot;Bright yellow&quot;) then
&#9;&#9;&#9;&#9;yellow = yellow + 1
&#9;&#9;&#9;end
&#9;&#9;&#9;if v.TeamColor == BrickColor.new(&quot;Bright green&quot;) then
&#9;&#9;&#9;&#9;green = green + 1
&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;if speaker.TeamColor == BrickColor.new(&quot;Bright yellow&quot;) then
&#9;&#9;&#9;yellow = yellow - 1
&#9;&#9;end
&#9;&#9;if speaker.TeamColor == BrickColor.new(&quot;Bright green&quot;) then
&#9;&#9;&#9;green = green - 1
&#9;&#9;end
&#9;&#9;if yellow &lt;= green then
&#9;&#9;&#9;speaker.TeamColor=BrickColor.new(&quot;Bright yellow&quot;) 
&#9;&#9;&#9;speaker.Character:BreakJoints()
&#9;&#9;&#9;speaker.leaderstats.WOs.Value = speaker.leaderstats.WOs.Value - 1
&#9;&#9;else
&#9;&#9;&#9;local m = Instance.new(&quot;Message&quot;) 
&#9;&#9;&#9;m.Parent = speaker
&#9;&#9;&#9;m.Text = &quot;Can&apos;t unbalance team!&quot;
&#9;&#9;&#9;game.Debris:AddItem(m,3)
&#9;&#9;end

&#9;end 

&#9;if (string.lower(msg) == &quot;join/green&quot;) then 
&#9;&#9;local yellow = 0
&#9;&#9;local green = 0
&#9;&#9;for i,v in pairs(game.Players:GetChildren()) do
&#9;&#9;&#9;if v.TeamColor == BrickColor.new(&quot;Bright yellow&quot;) then
&#9;&#9;&#9;&#9;yellow = yellow + 1
&#9;&#9;&#9;end
&#9;&#9;&#9;if v.TeamColor == BrickColor.new(&quot;Bright green&quot;) then
&#9;&#9;&#9;&#9;green = green + 1
&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;if speaker.TeamColor == BrickColor.new(&quot;Bright yellow&quot;) then
&#9;&#9;&#9;yellow = yellow - 1
&#9;&#9;end
&#9;&#9;if speaker.TeamColor == BrickColor.new(&quot;Bright green&quot;) then
&#9;&#9;&#9;green = green - 1
&#9;&#9;end
&#9;&#9;if yellow &gt;= green then
&#9;&#9;&#9;speaker.TeamColor=BrickColor.new(&quot;Bright green&quot;) 
&#9;&#9;&#9;speaker.Character:BreakJoints() 
&#9;&#9;&#9;speaker.leaderstats.WOs.Value = speaker.leaderstats.WOs.Value - 1
&#9;&#9;else
&#9;&#9;&#9;local m = Instance.new(&quot;Message&quot;) 
&#9;&#9;&#9;m.Parent = speaker
&#9;&#9;&#9;m.Text = &quot;Can&apos;t unbalance team!&quot;
&#9;&#9;&#9;game.Debris:AddItem(m,3)
&#9;&#9;end
&#9;end 

&#9;if (string.lower(msg) == &quot;reset&quot;) then 
&#9;&#9;speaker.Character:BreakJoints() 
&#9;&#9;speaker.leaderstats.WOs.Value = speaker.leaderstats.WOs.Value - 1
&#9;end 

&#9;if (string.lower(msg) == &quot;kill me&quot;) then 
&#9;&#9;speaker.Character:BreakJoints() 
&#9;&#9;speaker.leaderstats.WOs.Value = speaker.leaderstats.WOs.Value - 1
&#9;end 

&#9;if (string.lower(msg) == &quot;fix cam&quot;) then 
&#9;&#9;local showstat = Instance.new(&quot;Message&quot;)
&#9;&#9;showstat.Parent = speaker
&#9;&#9;showstat.Text = &quot; plz use reset button gui ! &quot;
&#9;&#9;game.Debris:AddItem(showstat,5)
&#9;end 

&#9;if (string.lower(msg) == &quot;oh &quot;) and check(speaker) then
&#9;&#9;if regen.Parent ~= nil then
&#9;&#9;&#9;regen:remove()
&#9;&#9;end
&#9;&#9;regen = backup:clone()
&#9;&#9;regen.Parent= game.Workspace
&#9;end
end 

function onPlayerEntered(newPlayer) 
local showstat = Instance.new(&quot;Message&quot;)
showstat.Parent = newPlayer
showstat.Text = &quot;Welcome ! Read the gui for more information !&quot;
wait(4)
showstat:remove()
newPlayer.Chatted:connect(function(msg, recipient) onChatted(msg, recipient, newPlayer) end) 
end 

game.Players.ChildAdded:connect(onPlayerEntered) </ProtectedString>
