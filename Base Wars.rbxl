			<Item class="Script" referent="RBX4760">
				<Properties>
					<bool name="Disabled">true</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">LaserBlast</string>
					<ProtectedString name="Source">ball = script.Parent
damage = 16

function onTouched(hit)
&#9;if hit.Name == &quot;Bullet&quot; then return end
&#9;local humanoid = hit.Parent:findFirstChild(&quot;Humanoid&quot;) or hit.Parent.Parent:findFirstChild(&quot;Humanoid&quot;)
&#9;connection:disconnect()
&#9;if humanoid ~= nil then
&#9;&#9;hitted = game.Players:findFirstChild(humanoid.Parent.Name)
&#9;&#9;owner = ball:findFirstChild(&quot;creator&quot;).Value
&#9;&#9;if hitted ~= nil then
&#9;&#9;&#9;if hitted.TeamColor == owner.TeamColor then
&#9;&#9;&#9;&#9;ball:remove()
&#9;&#9;&#9;&#9;return
&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;tagHumanoid(humanoid)
&#9;&#9;if hit.Name == &quot;Head&quot; then damage = damage * 2 end  
&#9;&#9;&#9;if not humanoid.Parent:findFirstChild(&quot;ForceField&quot;) then
&#9;&#9;&#9;&#9;humanoid.Health = humanoid.Health - damage
&#9;&#9;&#9;end
&#9;&#9;wait(1)
&#9;&#9;untagHumanoid(humanoid)
&#9;else
&#9;&#9;if hit.Anchored == false and hit.Parent.className == &quot;Model&quot; then 
&#9;&#9;&#9;if hit:findFirstChild(&quot;damaged&quot;) then
&#9;&#9;&#9;&#9;if hit.Parent:findFirstChild(&quot;Boat&quot;) then
&#9;&#9;&#9;&#9;&#9;hit.damaged.Value = hit.damaged.Value + 1
&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;hit.damaged.Value = hit.damaged.Value + 3
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;if hit.damaged.Value &gt;= 20 then 
&#9;&#9;&#9;&#9;&#9;hit:BreakJoints()
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;local p = Instance.new(&quot;IntValue&quot;)
&#9;&#9;&#9;&#9;p.Name = &quot;damaged&quot;
&#9;&#9;&#9;&#9;if hit.Parent:findFirstChild(&quot;Boat&quot;) then
&#9;&#9;&#9;&#9;&#9;p.Value = 1
&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;p.Value = 3
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;p.Parent = hit
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
&#9;ball:remove()
end

function tagHumanoid(humanoid)
&#9;-- todo: make tag expire
&#9;local tag = ball:findFirstChild(&quot;creator&quot;)
&#9;if tag ~= nil then
&#9;&#9;local new_tag = tag:clone()
&#9;&#9;new_tag.Parent = humanoid
&#9;end
end

function untagHumanoid(humanoid)
&#9;if humanoid ~= nil then
&#9;&#9;local tag = humanoid:findFirstChild(&quot;creator&quot;)
&#9;&#9;if tag ~= nil then
&#9;&#9;&#9;tag.Parent = nil
&#9;&#9;end
&#9;end
end



connection = ball.Touched:connect(onTouched)
wait(5)
script.Parent:remove()</ProtectedString>
