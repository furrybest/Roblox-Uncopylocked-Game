			<Item class="Script" referent="RBX3920">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Throw</string>
					<ProtectedString name="Source">sp=script.Parent

loaded=false
local g=sp.Handle:Clone()

function fire(v)
&#9;sp.Parent.Torso[&quot;Right Shoulder&quot;].MaxVelocity=0.7
&#9;sp.Parent.Torso[&quot;Right Shoulder&quot;].DesiredAngle=3.6
&#9;wait(.1)
&#9;sp.Parent.Torso[&quot;Right Shoulder&quot;].MaxVelocity=1
&#9;sp.Handle.Transparency=1
&#9;sp.Handle.Fire:play()
&#9;local vCharacter=sp.Parent
&#9;local vPlayer=game.Players:playerFromCharacter(vCharacter)
&#9;local head=vCharacter:findFirstChild(&quot;Head&quot;)
&#9;if head==nil then return end
&#9;local launch=head.Position+10*v
&#9;local missile=g:clone()
&#9;missile.CFrame=CFrame.new(launch,launch+v)
&#9;missile.Velocity=v*70
&#9;local force=Instance.new(&quot;BodyForce&quot;)
&#9;force.force=Vector3.new(0,240,0)
&#9;force.Parent=missile
&#9;local ps = script.Parent.BangScript:Clone()
&#9;ps.Parent = missile
&#9;missile.BangScript.Disabled = false
&#9;local creator_tag = Instance.new(&quot;ObjectValue&quot;)
&#9;creator_tag.Value =vPlayer
&#9;creator_tag.Name = &quot;creator&quot;
&#9;creator_tag.Parent = missile
&#9;missile.Parent = game.Workspace
&#9;sp:remove()
end

sp.Enabled=true
function onActivated()
&#9;if not sp.Enabled then
&#9;&#9;return
&#9;end
&#9;sp.Enabled=false
&#9;local character=sp.Parent;
&#9;local humanoid=character.Humanoid
&#9;if humanoid==nil then
&#9;&#9;print(&quot;Humanoid not found&quot;)
&#9;&#9;return 
&#9;end
&#9;if loaded then
&#9;&#9;loaded=false
&#9;&#9;local targetPos=humanoid.TargetPoint
&#9;&#9;local lookAt=(targetPos-character.Head.Position).unit
&#9;&#9;fire(lookAt)
&#9;&#9;wait(2)
&#9;&#9;sp.Enabled=true
&#9;elseif not loaded then
&#9;&#9;sp.Parent.Torso[&quot;Right Shoulder&quot;].MaxVelocity=0.6
&#9;&#9;sp.Parent.Torso[&quot;Right Shoulder&quot;].DesiredAngle=-3.6
&#9;&#9;wait(.1)
&#9;&#9;sp.Handle.Transparency=0
&#9;&#9;wait(.1)
&#9;&#9;loaded=true
&#9;end
&#9;sp.Enabled=true
end

script.Parent.Activated:connect(onActivated)
</ProtectedString>
