							<Item class="Script" referent="RBX3309">
								<Properties>
									<bool name="Disabled">false</bool>
									<Content name="LinkedSource"><null></null></Content>
									<string name="Name">che</string>
									<ProtectedString name="Source">while true do
&#9;if script.Parent == nil then break end 
&#9;if script.Parent:findFirstChild(&quot;Engine&quot;) then
&#9;&#9;py = script.Parent.Engine.Position.Y
&#9;&#9;if py &lt; 120 then 
&#9;&#9;&#9;p=Instance.new(&quot;Explosion&quot;)
&#9;&#9;&#9;p.Position=script.Parent.Engine.Position
&#9;&#9;&#9;p.BlastRadius=14
&#9;&#9;&#9;p.Parent=game.Workspace
&#9;&#9;&#9;wait(2)
&#9;&#9;&#9;script.Parent.Parent:remove()
&#9;&#9;&#9;break
&#9;&#9;end
&#9;else
&#9;&#9;script.Parent.Parent:BreakJoints()
&#9;&#9;wait(2)
&#9;&#9;script.Parent.Parent:remove()
&#9;&#9;break
&#9;end
&#9;wait(1)
end

</ProtectedString>
								</Properties>
