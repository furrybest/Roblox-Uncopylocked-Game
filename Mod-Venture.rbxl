&#9;&#9;&#9;end
&#9;&#9;&#9;MainGui.BlackScreen.BackgroundTransparency = 0
&#9;&#9;&#9;wait()
&#9;&#9;&#9;func()
&#9;&#9;&#9;wait(1)
&#9;&#9;&#9;for i = 0, 1, .05 do
&#9;&#9;&#9;&#9;MainGui.BlackScreen.BackgroundTransparency = i
&#9;&#9;&#9;&#9;wait(0.03)
&#9;&#9;&#9;end
&#9;&#9;&#9;MainGui.BlackScreen.BackgroundTransparency = 1
&#9;&#9;&#9;bls_thread = false
&#9;&#9;end)
&#9;end
end

function Preload()
&#9;local assets = {43783818, 43783843, 43783830, 11420933, 1280463, 43214614, 43214625, 43214756,43215104, 43214756, 43215131,
&#9;&#9;&#9;&#9;&#9;&#9;43215149, 43215104, 31885329, 43044371, 43784195, 43783807, 43228021, 43783736, 43783751,50375617 ,50375729,50375705 ,50375745,
&#9;&#9;&#9;&#9;&#9;&#9;49468173, 50371946, 50912977, 50371946, 50371889, 50375617, 50375729, 50375705, 50375745, 50910034, 50910021,
&#9;&#9;&#9;&#9;&#9;&#9;50909457}
&#9;local figures = {{script.Parent.Intro.Man, 43783818}, {script.Parent.Intro.Wizard, 43783843}, {script.Parent.Intro.Elf, 43783830}}
&#9;local assetlink = &quot;http://www.roblox.com/asset/?id=&quot;

&#9;for i, v in pairs(assets) do
&#9;&#9;game:GetService(&quot;ContentProvider&quot;):Preload(assetlink .. v)
&#9;end

&#9;for i, v in pairs(assets) do
&#9;&#9;game:GetService(&quot;InsertService&quot;):LoadAsset(v)
&#9;&#9;local perc = i/#assets
&#9;&#9;script.Parent.Intro.LoadBar:TweenSize(UDim2.new(0, perc * 300, 0, 20), Out, Bounce,  .75, true, nil)
&#9;&#9;if (i &gt;= (#assets/4)) and (not figures[1][3]) then
&#9;&#9;&#9;figures[1][3] = true
&#9;&#9;&#9;ShowShine(figures[1][1].Position, function() figures[1][1].Image = assetlink .. figures[1][2] end)
&#9;&#9;end
&#9;&#9;if (i &gt;= 2 * (#assets/4)) and (not figures[2][3]) then
&#9;&#9;&#9;figures[2][3] = true
&#9;&#9;&#9;ShowShine(figures[2][1].Position, function() figures[2][1].Image = assetlink .. figures[2][2] end)
&#9;&#9;end
&#9;&#9;if (i &gt;= 3 * (#assets/4)) and (not figures[3][3]) then
&#9;&#9;&#9;figures[3][3] = true
&#9;&#9;&#9;ShowShine(figures[3][1].Position, function() figures[3][1].Image = assetlink .. figures[3][2] end)
&#9;&#9;end
&#9;&#9;wait(10/#assets)
&#9;end
&#9;--BlackScreen( function()
&#9;&#9;--wait(5)
&#9;--end)
end

