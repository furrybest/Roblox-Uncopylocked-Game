function runAnimation(animname) --Dont run till the player is set up
&#9;animscript=Character:FindFirstChild(&quot;Animate&quot;)
&#9;if animscript then
&#9;&#9;animscript.Animation.Value=animname
&#9;end
end

-- The organization of MrNicNac is below.
function startRunning()
&#9;if not isRunning then
&#9;&#9;isRunning = true
&#9;&#9;coroutine.wrap(function()
&#9;&#9;&#9;while isRunning do
&#9;&#9;&#9;&#9;wait()
&#9;&#9;&#9;&#9;if Player.Character.Humanoid.WalkSpeed &lt; 25 then
&#9;&#9;&#9;&#9;&#9;Player.Character.Humanoid.WalkSpeed = Character.Humanoid.WalkSpeed + .5
&#9;&#9;&#9;&#9;&#9;print(&quot;WalkSpeed is now:&quot;, Player.Character.Humanoid.WalkSpeed)
&#9;&#9;&#9;&#9;&#9;wait(.25)
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;&#9;Player.Character.Humanoid.WalkSpeed = 16
&#9;&#9;end)()
&#9;end
end
-- The organization of MrNicNac is above.

function waitAnim(t)
&#9;while Character.Animate.RunningAnim.Value do 
&#9;&#9;wait() 
&#9;end
&#9;if t then 
&#9;&#9;wait(t) 
&#9;end
end
