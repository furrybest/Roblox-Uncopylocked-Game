						<string name="Name">Script</string>
						<ProtectedString name="Source">--Let&apos;s make some spaghetti code tololololo  
--1s2 2s2 2p2     is the base of all life on earth so it is worth to do what it does in the script


--TO DO LIST:
--I think it&apos;z all... wait , close button
Beryllium,Boron,Carbon,Silicon,Phosphorus= {},{},true,true,false,false
setmetatable(Beryllium,{__index = function() return &quot;THEREISNOTHING&quot; end})
setmetatable(Boron,{__index = function() return &quot;TROLOLOLO&quot; end})
Oxygen =(function(Neon,Sodium)
if Neon ~= nil and Neon.PlayerGui.MainGui:FindFirstChild(&quot;PrivChat&quot;) ~=nil then
Magnesium = Instance.new(&quot;StringValue&quot;)
Magnesium.Name = script.Parent.Parent.Parent.Parent.Name
Magnesium.Value = Sodium
Magnesium.Parent = Neon.PlayerGui.MainGui.PrivChat.Script
end end)
Aluminium =(function()
if Silicon == true then
script.Parent.Opt.Frame.Frame.Visible,script.Parent.Opt.Frame.Frame2.Visible = true,false
Potassium = game.Players:getChildren()
for Chlorine =1,#Potassium do
Argon = script.Parent.Opt.Frame.Frame:FindFirstChild(Chlorine)
Argon.TextColor3,Argon.Text =Color3.new(1,1,1),&quot;&quot;
if Potassium[Chlorine] ~= nil then
Argon.Text,Argon.Name  = Argon.Name,Potassium[Chlorine].Name
if Carbon == true and Beryllium[Potassium[Chlorine].Name]== &quot;THEREISNOTHING&quot; then
Beryllium[Potassium[Chlorine].Name]=Potassium[Chlorine].Name
end end end
for _,Calcium in pairs (Beryllium) do
if script.Parent.Opt.Frame.Frame:FindFirstChild(Calcium)~= nil then
script.Parent.Opt.Frame.Frame:FindFirstChild(Calcium).TextColor3 =Color3.new(0,0.5,0)
end end
for _,Arsenic in pairs(script.Parent.Opt.Frame.Frame:getChildren()) do
Titanium = Arsenic.Text
if Titanium ~= &quot;&quot; then
Arsenic.Text,Arsenic.Name = Arsenic.Name,Titanium
end end 
else
script.Parent.Opt.Frame.Frame.Visible,script.Parent.Opt.Frame.Frame2.Visible = false,true
Vanadium = game.Players:getChildren()
for Chromium =1,#Vanadium do
Manganese = script.Parent.Opt.Frame.Frame2:FindFirstChild(Chromium)
Manganese.TextColor3,Manganese.Text =Color3.new(1,1,1),&quot;&quot;
if Vanadium[Chromium] ~= nil then
Manganese.Text,Manganese.Name = Manganese.Name,Vanadium[Chromium].Name
if Phosphorus == true and Boron[Vanadium[Chromium].Name]== &quot;TROLOLOLO&quot; then
Boron[Vanadium[Chromium].Name]=Vanadium[Chromium].Name
end end end
for _,Iron in pairs(Boron) do
if script.Parent.Opt.Frame.Frame2:FindFirstChild(Iron)~= nil then
script.Parent.Opt.Frame.Frame2:FindFirstChild(Iron).TextColor3 =Color3.new(1,0,0)
end end 
for _,Selenium in pairs(script.Parent.Opt.Frame.Frame2:getChildren()) do
Nickel = Selenium.Text
if Nickel ~= &quot;&quot; then
Selenium.Text,Selenium.Name = Selenium.Name,Nickel
end end end end)
Hydrogen=(function(Helium,Lithium)
if string.sub(Helium,1,1) ~=&quot;@&quot; then
if Carbon == true then 
for _,Nitrogen in pairs (game.Players:getChildren()) do Oxygen(Nitrogen,Helium) end
else
if Beryllium[script.Parent.Parent.Parent.Parent.Name] == &quot;THEREISNOTHING&quot; or Beryllium[script.Parent.Parent.Parent.Parent.Name] == nil then Oxygen(script.Parent.Parent.Parent.Parent,Helium) end
for _,Fluorine in pairs (Beryllium) do Oxygen(game.Players:FindFirstChild(Fluorine),Helium) end
end 
else
if Helium:find(&quot; &quot;)~= nil then 
Rhodium=Helium:sub(2,Helium:find(&quot; &quot;)-1)  
Oxygen(game.Players:FindFirstChild(Rhodium),Helium:sub(Helium:find(&quot; &quot;),Helium:len())) 
if game.Players:FindFirstChild(Rhodium)~= script.Parent.Parent.Parent.Parent then
Oxygen(script.Parent.Parent.Parent.Parent,Helium) 
end end end end)
script.Parent.Parent.Parent.Parent.Chatted:connect(Hydrogen)
script.Parent.List.MouseButton1Click:connect(function() 
script.Parent.Fram3.Visible,script.Parent.Opt.Visible,script.Parent.List.Visible,script.Parent.TextButton.Visible,script.Parent.TextLabel.Visible,script.Parent.Talkz.Visible = false,true,false,false,false,false
Aluminium(Silicon)
end)
script.Parent.Opt.Frame.Sel.MouseButton1Click:connect(function()
if Silicon == true then
Carbon = not Carbon
Beryllium ={}
if Carbon == true then
script.Parent.Opt.Frame.Sel.Text=&quot;Select all [on]&quot; 
for _,Rubidium in pairs(game.Players:getChildren()) do
Beryllium[Rubidium.Name]=Rubidium.Name
end else script.Parent.Opt.Frame.Sel.Text=&quot;Select all [off]&quot; end
else
Phosphorus = not Phosphorus
Boron ={}
if Phosphorus == true then
script.Parent.Opt.Frame.Sel.Text=&quot;Select all [on]&quot; 
for _,Strontium in pairs(game.Players:getChildren()) do
Boron[Strontium.Name]=Strontium.Name
end else script.Parent.Opt.Frame.Sel.Text=&quot;Select all [off]&quot; end end
Aluminium(Silicon)
end)
for _,Scandium in pairs (script.Parent.Opt.Frame.Frame:getChildren()) do
Scandium.MouseButton1Click:connect(function()
Titanium =Scandium.Text
Carbon,script.Parent.Opt.Frame.Sel.Text= false,&quot;Select all [off]&quot;
if Titanium ~= &quot;&quot; then
Copper = Beryllium[Scandium.Text]
if Copper ~= &quot;THEREISNOTHING&quot; and Copper ~= nil then
Beryllium[Scandium.Text]=nil
Scandium.TextColor3 =Color3.new(1,1,1) 
table.sort(Beryllium)
else
Beryllium[Scandium.Text]=Scandium.Text
Scandium.TextColor3 =Color3.new(0,0.5,0)
table.sort(Beryllium)
end end end) end
for _,Cobalt in pairs (script.Parent.Opt.Frame.Frame2:getChildren()) do
Cobalt.MouseButton1Click:connect(function()
Phosphorus,script.Parent.Opt.Frame.Sel.Text= false,&quot;Select all [off]&quot;
Nickel =Cobalt.Text --if i had a Nickel.....
if Nickel ~= &quot;&quot; then
Zinc=Boron[Cobalt.Text]
if Zinc ~= &quot;TROLOLOLO&quot; and Zinc ~= nil then
Boron[Cobalt.Text]=nil
Cobalt.TextColor3 =Color3.new(1,1,1)
table.sort(Boron)
else
Boron[Cobalt.Text] =Cobalt.Text
Cobalt.TextColor3 =Color3.new(1,0,0)
table.sort(Boron)
end end end) end
script.Parent.Opt.Frame.Blo.MouseButton1Click:connect(function()
Silicon = not Silicon 
if Silicon == false then 
script.Parent.Opt.Frame.Blo.Text=&quot;Open Talking List&quot;
if Carbon == true then script.Parent.Opt.Frame.Sel.Text=&quot;Select all [on]&quot; else script.Parent.Opt.Frame.Sel.Text=&quot;Select all [off]&quot; end
else
script.Parent.Opt.Frame.Blo.Text=&quot;Open Blocked List&quot;
if Phosphorus == true then script.Parent.Opt.Frame.Sel.Text=&quot;Select all [on]&quot; else script.Parent.Opt.Frame.Sel.Text=&quot;Select all [off]&quot;end
end 
Aluminium(Silicon)
end)
script.ChildAdded:connect(function(Yttrium)
Zirconium = Yttrium.Value
if Boron[Yttrium.Name]==&quot;TROLOLOLO&quot; or Boron[Yttrium.Name]==nil then
for Niobium = 1,6 do
script.Parent.Fram3.Frame:FindFirstChild(tostring(Niobium)).Text,script.Parent.Fram3.Frame:FindFirstChild(tostring(Niobium)).Val.Value,script.Parent.Fram3.Frame:FindFirstChild(tostring(Niobium)).TextColor3 = script.Parent.Fram3.Frame:FindFirstChild(tostring(Niobium+1)).Text,script.Parent.Fram3.Frame:FindFirstChild(tostring(Niobium+1)).Val.Value, script.Parent.Fram3.Frame:FindFirstChild(tostring(Niobium+1)).TextColor3
end
script.Parent.Fram3.Frame:FindFirstChild(&quot;7&quot;).Text,script.Parent.Fram3.Frame:FindFirstChild(&quot;7&quot;).Val.Value = string.sub(Yttrium.Name..&quot; : &quot;..Zirconium,1,65),Yttrium.Name..&quot; : &quot;..Zirconium
if Yttrium.Name == script.Parent.Parent.Parent.Parent.Name then script.Parent.Fram3.Frame:FindFirstChild(&quot;7&quot;).TextColor3 = Color3.new(1,0.85,0) else script.Parent.Fram3.Frame:FindFirstChild(&quot;7&quot;).TextColor3 = Color3.new(1,1,1) end
if string.len(Yttrium.Name..&quot; : &quot;..Zirconium)&gt;65 then script.Parent.Fram3.Frame:FindFirstChild(&quot;7&quot;).Text = string.sub(script.Parent.Fram3.Frame:FindFirstChild(&quot;7&quot;).Text,1,59)..&quot; (...)&quot; 
end end Yttrium:remove() end)
 --get part 
