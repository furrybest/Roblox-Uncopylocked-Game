function StartLoad()
&#9;local other_assets = {43784195, 43783807, 43783736, 43783751, 43228021, 42015307}
&#9;local assetlink = &quot;http://www.roblox.com/asset/?id=&quot;

&#9;for i, v in pairs(other_assets) do
&#9;&#9;game:GetService(&quot;ContentProvider&quot;):Preload(assetlink .. v)
&#9;end

&#9;for i, v in pairs(other_assets) do
&#9;&#9;game:GetService(&quot;InsertService&quot;):LoadAsset(v)
&#9;&#9;MainGui.Intro.StartLoad.Text = &quot;Loading&quot; .. string.rep(&quot;.&quot;, math.ceil(i/2))
&#9;end

&#9;BlackScreen(function()
&#9;&#9;MainGui.Intro.StartLoad.Visible = false
&#9;end)
end

