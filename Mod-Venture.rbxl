function shopat(store)

local gui = MainGui.Shop&#9;&#9;&#9;&#9;local stock = store.Stock &#9;
local p=stock:GetChildren()&#9;&#9;&#9;local wares = store.Wares &#9;&#9;&#9;&#9;&#9;local selected = gui.Selected 
local tax = store.Tax &#9;&#9;&#9;&#9;&#9;&#9;local s = 1 &#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;local unit = {}

local b1 = Instance.new(&quot;Part&quot;,LocalParts)
b1.Name = &quot;CameraPart&quot;
b1.Anchored = false
b1.CanCollide = false
b1.Transparency = 1
b1.Size = Vector3.new(1,1,1)
b1.formFactor = &quot;Symmetric&quot;
b1.CFrame = store.ShopKeep.Head.CFrame
local bp = Instance.new(&quot;BodyPosition&quot;,b1)
bp.position = b1.Position
Camera.CameraSubject = b1

&#9;&#9;&#9;--=/= Some ShopGui functions =\=--
MainGui.Shop.Selected.Changed:connect(function(b)
if b then
local w = store.Wares:findFirstChild(b.Name)
if w then
bp.position = w:GetModelCFrame().p
end
end
end)

MainGui.Shop.Release.Changed:connect(function(b)
&#9;if b==true then
&#9;&#9;MainGui.Shop.Release.Value = false
&#9;&#9;Camera.CameraSubject = Character.Humanoid
&#9;&#9;if LocalParts:findFirstChild(&quot;CameraPart&quot;) then
&#9;&#9;LocalParts.CameraPart:remove()
&#9;&#9;end
&#9;&#9;selected.Value = nil
&#9;&#9;MainGui.Shop.Selected.Value = nil
&#9;&#9;MainGui.Shop.Store.Value = nil
&#9;&#9;MainGui.Shop.Frame.BuyInfo.Visible = false
&#9;&#9;Player.PlayerGui.ShopShine.Adornee = nil
&#9;&#9;MainGui.Shop.Visible = false
&#9;&#9;MainGui.CombatAtt.Visible = true
&#9;&#9;UpdateCombatGuis()
&#9;&#9;MainGui.Background.Visible = true
&#9;&#9;MainGui.QuestGui.Visible = true
&#9;&#9;game.Players.LocalPlayer.Character.Humanoid.WalkSpeed = 16
&#9;&#9;&#9;for _,vvv in pairs(game.Players.LocalPlayer.Character:GetChildren()) do
&#9;&#9;&#9;&#9;if vvv.className == &quot;Part&quot; then
&#9;&#9;&#9;&#9;&#9;vvv.Anchored = false
&#9;&#9;&#9;&#9;end 
&#9;&#9;&#9;end
&#9;end
end)

function colorm()
if math.ceil(tools[p[s].Name][&quot;Price&quot;]*(1+(tax.Value)/100)) &gt; Money.Value then
MainGui.Shop.Frame.BuyInfo.Window.SellingPrice.TextColor3 =Color3.new(255-255,255-0,255-0)
else
MainGui.Shop.Frame.BuyInfo.Window.SellingPrice.TextColor3 = Color3.new(27, 42, 5)
end
end


function update(filer)
colorm()
MainGui.Parent.ShopShine.Adornee = b1
MainGui.Shop.Frame.ShopInv.ItemName.Text = filer[&quot;Name&quot;]
print(filer)
MainGui.Shop.Frame.ShopInv.Desc1.Text = filer[&quot;Description&quot;]
MainGui.Shop.Frame.ShopInv.Desc1.GreenStats.Text = filer[&quot;GreenStats&quot;]
MainGui.Shop.Frame.ShopInv.Desc1.RedStats.Text = filer[&quot;RedStats&quot;]
MainGui.Shop.Frame.ShopInv.Desc1.SellingPrice.Text = &quot;Price: &quot;..math.ceil(filer[&quot;Price&quot;]*(1+(tax.Value)/100))
MainGui.Shop.Frame.BuyInfo.Window.SellingPrice.Text = math.ceil(filer[&quot;Price&quot;]*(1+(tax.Value)/100))..&quot; muniez&quot;
end

MainGui.Shop.Frame.ShopInv.Next.MouseButton1Click:connect(function()
if s &lt; #p then
s = s + 1
elseif s &gt;= #p then
s = 1
end
update(tools[p[s].Name])
print(tools[p[s].Name][&quot;Name&quot;])
selected.Value = p[s]
end)

MainGui.Shop.Frame.ShopInv.Back.MouseButton1Click:connect(function()
if s &lt;= 1 then
s = #p
elseif s &gt; 1 then
s = s-1
end
print(s)
update(tools[p[s].Name])
selected.Value = p[s]
end)

MainGui.Shop.Frame.ShopInv.Buy.MouseButton1Click:connect(function(item)
MainGui.Shop.Frame.BuyInfo.Visible = true
end)

Money.Changed:connect(function(b)
colorm()
MainGui.Shop.Frame.ShopInv.Desc1.YourMoney.Text = &quot;muniez: &quot;..b
MainGui.Shop.Frame.BuyInfo.Window.YourMoney.Text = b
end)

MainGui.Shop.Frame.Quit.MouseButton1Click:connect(function()
MainGui.Shop.Release.Value = true
end)

MainGui.Shop.Frame.BuyInfo.Window.Yes.MouseButton1Click:connect(function()
tax = store.Tax
if Player.Money.Value &gt;= math.ceil(tools[p[s].Name][&quot;Price&quot;]*(1+(tax.Value)/100)) then
Player.Money.Value = Player.Money.Value- math.ceil(tools[p[s].Name][&quot;Price&quot;]*(1+(tax.Value)/100))
MainGui.Shop.Frame.BuyInfo.Visible = false
print(p[s].Name)
AddToInventory(p[s].Name)
MainGui.Shop.Release.Value = true
else
script.Sounds.Error:play()
for i = 1, 3 do
MainGui.Shop.Frame.BuyInfo.Window.SellingPrice.TextColor3 = Color3.new(255-255,255-255,255-255)
wait(.25)
MainGui.Shop.Frame.BuyInfo.Window.SellingPrice.TextColor3 = Color3.new(255-255,255-0,255-0)
end
end
end)


MainGui.Shop.Frame.BuyInfo.Window.No.MouseButton1Click:connect(function()
MainGui.Shop.Frame.BuyInfo.Visible = false
end)

MainGui.QuestGui.Visible = false
MainGui.Background.Visible = false
MainGui.CombatAtt.Visible = false
MainGui.Shop.Visible = true

--load stuff
for i = 1, #p do
unit[#unit+1] = p[i]
end
gui.Frame.ShopInv.Desc1.YourMoney.Text = &quot;muniez: &quot;..Money.Value
gui.Frame.BuyInfo.Window.YourMoney.Text = Money.Value
update(p[1])

end



