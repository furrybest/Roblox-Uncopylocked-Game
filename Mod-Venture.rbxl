&#9;function dressCharacter(outfit)
&#9;local bodyparts = {&quot;Left Arm&quot;,&quot;Right Arm&quot;,&quot;Left Leg&quot;,&quot;Right Leg&quot;,&quot;Torso&quot;, &quot;Head&quot;}
&#9;local weldparts = {&quot;ALArm&quot;,&quot;ARArm&quot;,&quot;ALLeg&quot;,&quot;ARLeg&quot;,&quot;ATorso&quot;, &quot;AHead&quot;}
&#9;for i = 1, #weldparts do
&#9;&#9;if Character:findFirstChild(weldparts[i]) then
&#9;&#9;&#9;Character:findFirstChild(weldparts[i]):remove()
&#9;&#9;end
&#9;end
&#9;local hit = Player.Character.Torso
&#9;for a = 1, #bodyparts do
&#9;&#9;print(outfit:findFirstChild(weldparts[a]).Name)
&#9;&#9;local suit = outfit:findFirstChild(weldparts[a]):clone()
&#9;&#9;suit.Parent = hit.Parent
&#9;&#9;local G = suit:GetChildren()
&#9;&#9;for i=1, #G do
&#9;&#9;&#9;if G[i].className == &quot;Part&quot; then
&#9;&#9;&#9;&#9;local suitW = Instance.new(&quot;Weld&quot;)
&#9;&#9;&#9;&#9;suitW.Part0 = suit.MainPart
&#9;&#9;&#9;&#9;suitW.Part1 = G[i]
&#9;&#9;&#9;&#9;local autoW = CFrame.new(suit.MainPart.Position)
&#9;&#9;&#9;&#9;suitW.C0 = suit.MainPart.CFrame:inverse()*autoW
&#9;&#9;&#9;&#9;suitW.C1 = G[i].CFrame:inverse()*autoW
&#9;&#9;&#9;&#9;suitW.Parent = suit.MainPart
&#9;&#9;&#9;end
&#9;&#9;&#9;local bpW = Instance.new(&quot;Weld&quot;)
&#9;&#9;&#9;bpW.Part0 = hit.Parent:findFirstChild(bodyparts[a])
&#9;&#9;&#9;bpW.Part1 = suit.MainPart
&#9;&#9;&#9;bpW.C0 = CFrame.new(0, 0, 0)
&#9;&#9;&#9;bpW.Parent = suit.MainPart
&#9;&#9;end
&#9;&#9;local o = suit:GetChildren()
&#9;&#9;for i=1, #o do
&#9;&#9;&#9;o[i].Anchored = false
&#9;&#9;&#9;o[i].CanCollide = false
&#9;&#9;end
&#9;end
&#9;p = hit.Parent:GetChildren()
&#9;for i = 1, #p do
&#9;&#9;if p[i].className == &quot;Part&quot; then
&#9;&#9;&#9;p[i].Transparency = 1
&#9;&#9;end
&#9;end
end


