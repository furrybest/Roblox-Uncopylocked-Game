&#9;&#9;&#9;func = (type(func) == &quot;function&quot;) and func or function() end
&#9;&#9;&#9;MainGui.BlackScreen.ZIndex = zi
&#9;&#9;&#9;for i = 1, 0, -.05 do
&#9;&#9;&#9;&#9;MainGui.BlackScreen.BackgroundTransparency = i
