&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end

-- == COROUTINE CORNER == --

function Thread(runF, cancelF, ...)
&#9;local args = {...}

&#9;runF = SafeEnv(runF)

&#9;cancelF = type(cancelF) == &quot;function&quot; and cancelF or function(...) end

&#9;local mirrorMT = {__index = getfenv(0)}

&#9;local function SetEnvMirror(f, newEnv) 
&#9;&#9;setfenv(f, newEnv) 
&#9;&#9;setmetatable(newEnv, mirrorMT) 
&#9;end 

&#9;local this = {} 
&#9;local mCo = nil 
&#9;local mHalt = false
&#9;local conns = {}

&#9;local function clear_conns()
&#9;&#9;print(&quot;CLEARING CONNECTIONS&quot;)
&#9;&#9;for i, v in pairs(conns) do
&#9;&#9;&#9;v:disconnect()
&#9;&#9;end
&#9;&#9;conns = {}
&#9;end

&#9;local cancelableENV = {wait = function(time) 
&#9;&#9;time = time or 0 
&#9;&#9;if type(time) ~= &quot;number&quot; then 
&#9;&#9;&#9;error(&quot;Argument #1 to wait must be a number&quot;)
&#9;&#9;end 
&#9;&#9;coroutine.yield(time) 
&#9;end, this = this, event = function(ev, func)
&#9;&#9;print(&quot;ADDED EVENT&quot;)
&#9;&#9;table.insert(conns, ev:connect(func))
&#9;end}

&#9;SetEnvMirror(runF, cancelableENV) 
&#9;mCo = coroutine.create(runF) 

&#9;local function run_thread()
&#9;&#9;Spawn(function() 
&#9;&#9;&#9;while true do 
&#9;&#9;&#9;&#9;if mHalt then 
&#9;&#9;&#9;&#9;&#9;cancelF(unpack(mHalt)) 
&#9;&#9;&#9;&#9;&#9;break 
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;if coroutine.status(mCo) ~= &quot;dead&quot; then
&#9;&#9;&#9;&#9;&#9;local st, val = coroutine.resume(mCo, unpack(args)) 
&#9;&#9;&#9;&#9;&#9;if st then
&#9;&#9;&#9;&#9;&#9;&#9;if val then 
&#9;&#9;&#9;&#9;&#9;&#9;&#9;wait(val)
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;&#9;print(&quot;Thread Error:&quot;, val) -- Coroutine errored
&#9;&#9;&#9;&#9;&#9;&#9;mHalt = {}
&#9;&#9;&#9;&#9;&#9;&#9;clear_conns()
&#9;&#9;&#9;&#9;&#9;&#9;break
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;mHalt = {}
&#9;&#9;&#9;&#9;&#9;break 
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end 
&#9;&#9;end) 
&#9;end

&#9;this.resume = function()
&#9;&#9;if mHalt then
&#9;&#9;&#9;mHalt = false
&#9;&#9;&#9;run_thread()
&#9;&#9;end
&#9;end

&#9;this.halt = function(...) 
&#9;&#9;if not mHalt then
&#9;&#9;&#9;mHalt = {...} 
&#9;&#9;&#9;clear_conns()
&#9;&#9;end
&#9;end

&#9;this.running = function()
&#9;&#9;return not mHalt
&#9;end

&#9;run_thread()

&#9;return this 
end 

function SafeEnv(runF)
&#9;local newEnv={}
&#9;setmetatable(newEnv, {})
&#9;getmetatable(newEnv).__index = function(t,i) return getfenv()[i] end
&#9;setfenv(runF, newEnv)

&#9;return runF
end

-- == CAMERA CORNER == --
function panCam(endpos,speed)
&#9;bp_thread = Thread(function()
&#9;&#9;func = type(func) == &quot;function&quot; and func or function() end
&#9;&#9;campanning = true
&#9;&#9;local cam = game.Workspace.CurrentCamera
&#9;&#9;local startpos = cam.CoordinateFrame.p
&#9;&#9;local unit = (startpos - endpos).unit
&#9;&#9;local dist = (startpos - endpos).magnitude
&#9;&#9;for i = 1, dist/speed do
&#9;&#9;&#9;cam.CoordinateFrame = CFrame.new(startpos + (-i * speed) * unit)
&#9;&#9;&#9;wait(0.03)
&#9;&#9;end
&#9;&#9;campanning = false
&#9;&#9;cam.CoordinateFrame = CFrame.new(endpos)
&#9;&#9;func()
&#9;&#9;bp_thread = false
&#9;end)
end

function fakeBP(part, speed, pos1, func) -- lower the speed, slower it goes
&#9;bp_thread = Thread(function()
&#9;&#9;func = type(func) == &quot;function&quot; and func or function() end
&#9;&#9;b1panning = true
&#9;&#9;local pos = part.Position
&#9;&#9;local unit = (pos - pos1).unit
&#9;&#9;local dist = (pos - pos1).magnitude

&#9;&#9;for i = 1, dist/speed do
&#9;&#9;&#9;part.CFrame = CFrame.new(pos + (-i * speed) * unit)
&#9;&#9;&#9;func()
&#9;&#9;&#9;wait(0.03)
&#9;&#9;end
&#9;&#9;b1panning = false
&#9;&#9;part.CFrame = CFrame.new(pos1)
&#9;&#9;func()
&#9;&#9;bp_thread = false
&#9;end)
end

local lockCam_thread = false

function lockCam(bool) --This means we can only have static camera shots?
 --Heck no. I&apos;ll only use it when the camera needs to stay still. If camera is moving, no need to spam coordinateframe
&#9;if lockCam_thread then
&#9;&#9;lockCam_thread.halt()
&#9;&#9;lockCam_thread = false
&#9;end

&#9;if bool then
&#9;&#9;local cf = Camera.CoordinateFrame
&#9;&#9;MainGui.CameraBlock.Visible = true
&#9;&#9;lockCam_thread = Thread(function()
&#9;&#9;&#9;while true do
&#9;&#9;&#9;&#9;Camera.CoordinateFrame = cf
&#9;&#9;&#9;&#9;wait()
&#9;&#9;&#9;end
&#9;&#9;end)
&#9;else
&#9;&#9;MainGui.CameraBlock.Visible = false
&#9;end
end


