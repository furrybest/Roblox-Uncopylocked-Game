&#9;&#9;Tool.Parent[&quot;Right Arm&quot;].RightGrip.C1 = Tool.Parent[&quot;Right Arm&quot;].RightGrip.C1 * CFrame.fromEulerAnglesXYZ(math.rad(0),0,math.rad(45))
&#9;&#9;wait()
&#9;&#9;end


&#9;&#9;damage=3.75

&#9;&#9;cut.Value=true

&#9;&#9;for i=1,6 do
&#9;&#9;weld2.C0 = weld2.C0*CFrame.fromEulerAnglesXYZ(math.rad(-10), math.rad(20), math.rad(0))
&#9;&#9;Tool.Parent[&quot;Right Arm&quot;].RightGrip.C1 = Tool.Parent[&quot;Right Arm&quot;].RightGrip.C1 * CFrame.fromEulerAnglesXYZ(math.rad(0),0,math.rad(45/12))
&#9;&#9;weld2.C0 = weld2.C0+Vector3.new(0,0,0)
&#9;&#9;wait()
&#9;&#9;end

&#9;&#9;Gyro = Instance.new(&quot;BodyGyro&quot;) 
&#9;&#9;Gyro.P = Gyro.P*100
&#9;&#9;Gyro.maxTorque = Vector3.new(0,0,0)*999 
&#9;&#9;Gyro.cframe = Tool.Parent.Torso.CFrame
&#9;&#9;Gyro.Parent = Tool.Parent.Torso

&#9;&#9;SlashSound:play()

&#9;&#9;damage=3

&#9;&#9;for i=1, 50 do 
&#9;&#9;Gyro.cframe = Gyro.cframe*CFrame.fromEulerAnglesXYZ(0,0,0)
&#9;&#9;wait() 
&#9;&#9;end 

&#9;&#9;cut.Value=false

&#9;&#9;damage=0

&#9;&#9;Gyro:remove()

&#9;&#9;wait(0.01)

&#9;&#9;Tool.Parent[&quot;Humanoid&quot;].WalkSpeed=16

&#9;&#9;weld2.C0=weld20
&#9;&#9;weld2.C1=weld21
&#9;&#9;Tool.Parent[&quot;Right Arm&quot;].RightGrip.C1=grip

&#9;&#9;Seventh=false
&#9;&#9;print(&quot;reload&quot;)
&#9;&#9;damage = 0
&#9;&#9;wait(0.5)
&#9;&#9;if (First==false and Second==false and Third==false and Fourth==false and Fifth ==false and Sixth == false and Seventh == false) then
&#9;&#9;Tool.Parent[&quot;Humanoid&quot;].WalkSpeed=16
&#9;&#9;print(&quot;Oh no!&quot;)
&#9;&#9;S1=true
&#9;&#9;end
&#9;end

&#9;last_attack = t

&#9;Tool.Enabled = true
end









function UnWeld()
if arm ~= nil and torso ~= nil then
local sh = torso:FindFirstChild(&quot;Right Shoulder&quot;)
if sh ~= nil then
local yes = true
if yes then
yes = false
sh.Part1 = arm
welds.Parent = nil
end
else
print(&quot;sh&quot;)
end
else
print(&quot;arms&quot;)
end
end





