local statusframe = MainGui.Background.HealthBar.HeartLabel.Status
local statuslist = {
&#9;&#9;&#9;Poison = {
&#9;&#9;&#9;&#9;image =  51084032;
&#9;&#9;&#9;&#9;code = function() wait(.5) while true do
&#9;&#9;&#9;&#9;if not Status:findFirstChild(&quot;Poison&quot;) and statusframe:findFirstChild(&quot;Poison&quot;) then statusframe.Poison:remove() break end
&#9;&#9;&#9;&#9;Health.Value = Health.Value - math.random(4,5) wait(5) end end;
&#9;&#9;&#9;&#9;animation = function() &#9;&#9;&#9;while Status:findFirstChild(&quot;Poison&quot;) do  &#9;&#9;&#9;wait(.35) &#9;&#9;&#9;local p = Instance.new(&quot;Part&quot;,Character) &#9;&#9;&#9;game.Debris:AddItem(p,1) &#9;&#9;&#9;p.CanCollide = false &#9;&#9;&#9;p.Anchored = true &#9;&#9;&#9;p.Transparency = .4&#9;&#9;p.TopSurface = &quot;Smooth&quot;&#9;p.BottomSurface = &quot;Smooth&quot;&#9;p.BrickColor = BrickColor.new(&quot;Grime&quot;) &#9;&#9;&#9;p.Shape =&quot;Ball&quot; &#9;&#9;&#9;p.formFactor = &quot;Custom&quot; &#9;&#9;&#9;p.Size = Vector3.new(0.6,0.6,0.6) &#9;&#9;&#9;p.CFrame = Character.Torso.CFrame *CFrame.new(math.random(-1,1),math.random(-1,1),math.random(-1,1)) &#9;&#9;&#9;coroutine.resume(coroutine.create(function() &#9;&#9;&#9;for i = 1, 3.6,.2 do &#9;&#9;&#9;p.CFrame = p.CFrame*CFrame.new(0,.2,0) &#9;&#9;&#9;wait(.03) &#9;&#9;&#9;end &#9;&#9;&#9;end)) &#9;&#9;&#9;end  &#9;&#9;&#9;end;
&#9;&#9;&#9;&#9;};

&#9;&#9;&#9;RegenHealth = {
&#9;&#9;&#9;&#9;image =  51084397;
&#9;&#9;&#9;&#9;code = function() wait(.5) while true do
&#9;&#9;&#9;&#9;if not Status:findFirstChild(&quot;RegenHealth&quot;) and statusframe:findFirstChild(&quot;RegenHealth&quot;) then statusframe.RegenHealth:remove() break end
&#9;&#9;&#9;&#9;Health.Value = Health.Value + math.random(4,6) wait(5) end end;
&#9;&#9;&#9;&#9;};
}


function ManageIcons()
wait(.25)
for i, v in pairs (statusframe:GetChildren()) do
v.Position = UDim2.new((i-1)*1,(i-1)*-2,0,0)
end
end

function NewStatus(tepid)
wait(.5)
local name = tepid.Name
local time = tepid.Value
&#9;if statusframe:findFirstChild(name) then
&#9;&#9;tepid:remove()
&#9;else
&#9;&#9;local i = #statusframe:GetChildren()
&#9;&#9;local icon = Instance.new(&quot;ImageLabel&quot;,statusframe)
&#9;&#9;icon.Name = name
&#9;&#9;icon.Image = &quot;http://www.roblox.com/asset/?id=&quot;..statuslist[name].image
&#9;&#9;icon.Size = UDim2.new(1,0,1,0)
&#9;&#9;icon.BackgroundTransparency = 1
&#9;&#9;game.Debris:AddItem(icon,time)
&#9;&#9;coroutine.resume(coroutine.create(function() statuslist[name][&quot;code&quot;]() end))
&#9;&#9;coroutine.resume(coroutine.create(function() statuslist[name][&quot;animation&quot;]() end))
&#9;&#9;ManageIcons()
&#9;end
end

function RemoveStatus(name)
local tepid = Status:findFirstChild(name)
if tepid then
tepid:remove()
ManageIcons()
end
end

function AddStatus(name,time,delay)
print(&quot;Status added&quot;)
if not Status:findFirstChild(name) then
if delay then wait(delay) end
local tepid = Instance.new(&quot;NumberValue&quot;,Status)
tepid.Name = name
tepid.Value = time
game.Debris:AddItem(tepid,time)
end
end

Status.ChildAdded:connect(NewStatus)
Status.ChildRemoved:connect(ManageIcons)


