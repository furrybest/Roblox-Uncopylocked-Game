function SetInvEvent(name, func)
&#9;inv_events[name] = func
end

function AddToInventory(name)
    local tab = {name = name, tools[name][&quot;Type_id&quot;]}
    table.insert(tools[name][&quot;Type&quot;], tab)
    tools[name][&quot;Type_id&quot;] = tools[name][&quot;Type_id&quot;] + 1
&#9; UpdateGuis()
    return tools[name][&quot;Type_id&quot;] - 1
end

function RemoveFromInventory(id)
print(id)
    for i, v in pairs(InvType) do
        if v.id == id then
&#9;&#9;&#9;&#9;DeselectTool()
&#9;&#9;&#9;&#9;inv_events = {}
&#9;&#9;&#9;&#9;curr_tool = 0
            table.remove(InvType, i)
&#9;&#9;&#9;&#9;UpdateGuis()
            return
        end
    end
end

function NewTool(name)
&#9;local tool = tools[name]
&#9;tool.Variables = {}
&#9;local nTool = {tool = tool, SelectThread = false, Select = function(this, ...) if this.SelectThread then this.SelectThread.halt() this.SelectThread = false end this.SelectThread = Thread(this.tool.Selected, function() end, this.tool, ...) end, Deselect = function(this, ...) if this.SelectThread then this.SelectThread.halt() this.SelectThread = false end this.tool.Deselected(this.tool, ...) end}
&#9;return nTool
end

function DeselectTool(...)
&#9;if CurrentTool and not inToolAction then
&#9;&#9;inToolAction = true
&#9;&#9;CurrentTool:Deselect(...)
&#9;&#9;CurrentTool = false
&#9;&#9;inToolAction = false
&#9;&#9;print(&quot;Deselected tool!&quot;)
&#9;&#9;inv_events = {}
&#9;end
end

function SelectTool(name, ...)
&#9;if not inToolAction then
&#9;&#9;DeselectTool()
&#9;&#9;if tools[name] then
&#9;&#9;&#9;CurrentTool = NewTool(name)
&#9;&#9;&#9;CurrentTool:Select(...)
&#9;&#9;&#9;print(&quot;Selected new tool!&quot;)
&#9;&#9;end
&#9;end
end

function checkForDrag(name,...)



end


local doubleclick = false
function InventoryClicked(i, m)
print(InvType)
&#9;print(&quot;Clicked inventory&quot;)
&#9;local pos =  i
&#9;if InvType[pos] then
&#9;&#9;if InvType[pos].id == curr_tool then
&#9;&#9;&#9;DeselectTool(m)
&#9;&#9;&#9;print(&quot;Selected the same tool already!&quot;)
&#9;&#9;&#9;equipped = nil
&#9;&#9;&#9;equipped_class = nil
&#9;&#9;&#9;UpdateCombatGuis()
