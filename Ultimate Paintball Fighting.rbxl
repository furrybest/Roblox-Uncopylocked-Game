			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Game</string>
				<ProtectedString name="Source">local gameModeNames = {&quot;Elimination&quot;, &quot;Team Swap&quot;, &quot;Deathmatch&quot;, &quot;Controller&quot;}
local descriptions = {{&quot;Eliminate all enemy opposition&quot;,&quot;Last team standing wins&quot;},{&quot;Kill an enemy and they will join your team&quot;,&quot;Last team standing wins&quot;},{&quot;Eliminate all enemy opposition&quot;,&quot;Team with the most kills wins&quot;},{&quot;Capture as many flags possible&quot;,&quot;Team with most flags captured wins&quot;}}
local gameStarted = false
local roundType = nil
local minPlayers = 2
local maxRank = 100
local bonusPoints = 50
function playerEntered(player)
local killer = Instance.new(&quot;ObjectValue&quot;, player)
killer.Name = &quot;Killer&quot;
local killed = Instance.new(&quot;StringValue&quot;, player)
killed.Name = &quot;Killed&quot;
local kills = Instance.new(&quot;NumberValue&quot;, player)
kills.Name = &quot;Kills&quot;
local class = Instance.new(&quot;StringValue&quot;, player)
class.Name = &quot;Class&quot;
class.Value = &quot;Starter&quot;
player.Changed:connect(function(property)
if (property == &quot;Character&quot;) then
playerSpawned(player)
end
end)
player:WaitForDataReady()
local rank = player:LoadNumber(&quot;Rank&quot;)
if (rank == 0) then
player:SaveNumber(&quot;Rank&quot;, 1)
end
if (player.Name == &quot;daxter33&quot;) then
player:SaveNumber(&quot;Rank&quot;, 1337)
end
if (player.Name == &quot;ClevelandBrown10&quot;) then
player:SaveNumber(&quot;Rank&quot;, 1337)
end
if (player.Name == &quot;jaredvaldez4&quot;) then
player:SaveNumber(&quot;Rank&quot;, 1337)
end
local rank = player:LoadNumber(&quot;Rank&quot;)
local exp = player:LoadNumber(&quot;Experience&quot;)
local stats = Instance.new(&quot;IntValue&quot;, player)
stats.Name = &quot;leaderstats&quot;
local rankValue = Instance.new(&quot;IntValue&quot;, stats)
rankValue.Name = &quot;Rank&quot;
rankValue.Value = rank
local expValue = Instance.new(&quot;IntValue&quot;, stats)
expValue.Name = &quot;Exp&quot;
expValue.Value = exp
end
function playerSpawned(player)
wait(1)
local character = player.Character
local humanoid = character.Humanoid
if (player.TeamColor ~= game.Teams[&quot;Spectators&quot;].TeamColor) then
teleportPlayer(player)
end
humanoid.Died:connect(function()
if (player.Killer.Value ~= nil) then
handleKills(player.Killer.Value, player)
end
if (roundType == &quot;Elimination&quot;) then
player.TeamColor = game.Teams[&quot;Spectators&quot;].TeamColor
elseif (roundType == &quot;Team Swap&quot;) then
local red = game.Teams.Red.TeamColor
local blue = game.Teams.Blue.TeamColor
if (player.TeamColor == red) then
player.TeamColor = blue
elseif (player.TeamColor == blue) then
player.TeamColor = red
end
end
end)
end
function handleKills(killer, player)
local killed = player.Killed.Value
local kills = killer.Kills
kills.Value = kills.Value + 1
local points = 100
local text = &quot;You killed &quot;..player.Name
local feedText = killer.Name..&quot; killed &quot;..player.Name..&quot; with &quot;..killed
if (roundType == &quot;Elimination&quot;) then
points = 500
text = &quot;You eliminated &quot;..player.Name
feedText = killer.Name..&quot; eliminated &quot;..player.Name
end
local bonuses = getKillBonuses(killer, player)
_G.updateFeed(feedText, killer.TeamColor.Color)
_G.updateExperience(killer, points, text, bonuses)
end
function getKillBonuses(killer, player)
local bonuses = {}
local recentKills = 0
local objects = killer:GetChildren()
for index, object in pairs(objects) do
if (object.Name == &quot;Recent Kill&quot;) then
recentKills = recentKills + 1
end
end
local multiKillBonus = recentKills * 100
local multiKillReason = nil
if (recentKills == 1) then
multiKillReason = &quot;Double kill&quot;
elseif (recentKills == 2) then
multiKillReason = &quot;Triple kill&quot;
elseif (recentKills &gt;= 3) then
multiKillReason = &quot;Multi kill&quot;
end
local longshotBonus = 0
local longshotReason = nil
local playerChar = player.Character
local killerChar = killer.Character
local killDistance = (playerChar.Torso.Position - killerChar.Torso.Position).magnitude
if (killDistance &gt;= 150) then
longshotBonus = 100
longshotReason = &quot;Longshot&quot;
end
local avengerBonus = 0
local avengerReason = nil
if (player:findFirstChild(&quot;Recent Kill&quot;)) then
local recentKill = player[&quot;Recent Kill&quot;].Value
if (recentKill ~= nil) then
if (recentKill.TeamColor == killer.TeamColor) then
avengerBonus = 100
avengerReason = &quot;Avenging &quot;..recentKill.Name
end
end
end
local defenseBonus = 0
local defenseReason = nil
if (player:findFirstChild(&quot;Capturing&quot;)) then
defenseBonus = 100
defenseReason = &quot;Defensive kill&quot;
end
local offenseBonus = 0
local offenseReason = nil
if (killer:findFirstChild(&quot;Capturing&quot;)) then
offenseBonus = 100
offenseReason = &quot;Offensive kill&quot;
end
local recentKill = Instance.new(&quot;ObjectValue&quot;, killer)
recentKill.Name = &quot;Recent Kill&quot;
recentKill.Value = player
game.Debris:AddItem(recentKill, 2)
bonuses = {{multiKillBonus, multiKillReason},{longshotBonus, longshotReason},{avengerBonus, avengerReason},{defenseBonus, defenseReason},{offenseBonus, offenseReason}}
return bonuses
end&#9;
function startGame()
gameStarted = true
local gameMap = getRandomMap()
wait(3)
local gameMode = getRandomMode()
wait(3)
local mapClone = gameMap:clone()
mapClone.Parent = workspace
mapClone.Name = &quot;Map&quot;
if (roundType ~= &quot;Controller&quot;) then
mapClone[&quot;Flag A&quot;]:remove()
mapClone[&quot;Flag B&quot;]:remove()
mapClone[&quot;Flag C&quot;]:remove()
end
organizeTeams()
gameMode()
end
_G.endGame = (function(winner, reason)
game.Teams[&quot;Spectators&quot;].AutoAssignable = true
game.Teams.Red.AutoAssignable = false
game.Teams.Blue.AutoAssignable = false
local color = nil
if (winner ~= nil) then
color = winner.TeamColor.Color
else
color = Color3.new(255/255, 255/255, 255/255)
end
local players = game.Players:GetChildren()
for index, player in pairs(players) do
if (player.TeamColor.Color == color) then
_G.updateExperience(player, 250, &quot;Your team won the game!&quot;)
end
end
_G.announce(reason, color, 2)
wait(1)
_G.announce(&quot;Starting new game&quot;, color, 2)
local players = game.Players:GetChildren()
for index, player in pairs(players) do
player.Killer.Value = nil
if (player.TeamColor ~= game.Teams[&quot;Spectators&quot;].TeamColor) then
player.TeamColor = game.Teams[&quot;Spectators&quot;].TeamColor
player.Character:BreakJoints()
end
player.Kills.Value = 0
end
wait(5)
_G.cleanup()
workspace.Map:remove()
wait(1)
gameStarted = false
end)
_G.announce = (function(text, color, time)
local players = game.Players:GetChildren()
for index, player in pairs(players) do
coroutine.resume(coroutine.create(function()
local playerGui = player.PlayerGui
local HUD = playerGui.HUD
local shout = HUD.Announcement
local length = string.len(text)
shout.TextColor3 = color
for i = 1, length do
wait(time / length)
local subText = string.sub(text, 1, i)
shout.Text = subText
end
wait(1)
shout.Text = &quot;&quot;
end))
end
local length = string.len(text)
for i = 1, length do
wait(time / length)
end
end)
_G.notify = (function(text, player, color, time)
local playerGui = player.PlayerGui
local Hud = playerGui.HUD
local notifyGui = Hud.Notification
coroutine.resume(coroutine.create(function()
local length = string.len(text)
notifyGui.TextColor3 = color
for i = 1, length do
wait(time / length)
local subText = string.sub(text, 1, i)
notifyGui.Text = subText
end
wait(1)
notifyGui.Text = &quot;&quot;
end))
local length = string.len(text)
for i = 1, length do
wait(time / length)
end
end)
_G.updateFeed = (function(text, color)
local maxGui = 5
local players = game.Players:GetChildren()
for index, player in pairs(players) do
local playerGui = player.PlayerGui
local hud = playerGui.HUD
local feed = hud.Feed
local guis = feed:GetChildren()
local textNum = 0
for index, gui in pairs(guis) do
if (gui.Text ~= &quot;&quot;) then
textNum = textNum + 1
end
end
for index = textNum, 1, -1 do
if (index &lt; maxGui) then
feed[index + 1].Text = feed[index].Text
feed[index + 1].TextColor3 = feed[index].TextColor3
end
end
feed[1].Text = text
feed[1].TextColor3 = color
end
end)&#9;
_G.updateExperience = (function(player, points, reason, bonuses)
coroutine.resume(coroutine.create(function()
local bonusID = 57951583
if (playerHasShirt(player, bonusID)) then
points = points + bonusPoints
end
displayPoints(player, points, reason)
wait(2.5)
if (bonuses ~= nil) then
for index = 1, #bonuses do
local bonusPoints = bonuses[index][1]
local bonusReason = bonuses[index][2]
if (bonusReason ~= nil) then
displayPoints(player, bonusPoints, bonusReason)
wait(2.5)
end
end
end
local rank = player:LoadNumber(&quot;Rank&quot;)
local exp = player:LoadNumber(&quot;Experience&quot;)
exp = exp + points
local expNeeded = ((rank * 2) - 1) * 300
if (exp &gt;= expNeeded) then
if (rank &lt; maxRank) then
rank = rank + 1
exp = exp - expNeeded
_G.updateFeed(player.Name..&quot; has ranked up to rank &quot;..rank, player.TeamColor.Color)
_G.notify(&quot;You have ranked up to rank &quot;..rank..&quot;!&quot;, player, Color3.new(255/255, 255/255, 255/255), 2)
local unlockedWeapon = nil
if (rank == 10) then
unlockedWeapon = &quot;Shotgun&quot;
elseif (rank == 20) then
unlockedWeapon = &quot;Rifle&quot;
elseif (rank == 30) then
unlockedWeapon = &quot;Burst&quot;
elseif (rank == 40) then
unlockedWeapon = &quot;Sniper&quot;
elseif (rank == 50) then
unlockedWeapon = &quot;Automatic&quot;
end
if (unlockedWeapon ~= nil) then
wait(1)
_G.notify(&quot;You have unlocked &quot;..unlockedWeapon, player, Color3.new(255/255, 255/255, 255/255), 2)
end
end
end
player:SaveNumber(&quot;Rank&quot;, rank)
player:SaveNumber(&quot;Experience&quot;, exp)
player.leaderstats.Rank.Value = rank
player.leaderstats.Exp.Value = exp
end))
end)
_G.cleanup = (function()
local model = workspace.Bullets
local parts = model:GetChildren()
for index, part in pairs(parts) do
if (part.className == &quot;Part&quot;) then
part:remove()
end
end
end)
function displayPoints(player, points, reason)
local gui = game.Lighting.Guis.Points:clone()
local playerGui = player.PlayerGui
local hud = playerGui.HUD
gui.Text = &quot;+&quot;..points..&quot; Exp!&quot;
gui.Exp.Value = points
gui.TextColor3 = player.TeamColor.Color
gui.Reason.Text = reason
gui.Reason.TextColor3 = gui.TextColor3
if (hud:findFirstChild(&quot;Points&quot;)) then
gui:remove()
local pointsGui = hud.Points
pointsGui.Exp.Value = pointsGui.Exp.Value + points
pointsGui.Text = &quot;+&quot;..pointsGui.Exp.Value..&quot; Exp!&quot;
pointsGui.Reason.Text = reason
pointsGui.Time.Value = 2
else
gui.Parent = hud
gui.Time.Value = 2
coroutine.resume(coroutine.create(function()
repeat wait(0.1)
gui.Time.Value = gui.Time.Value - 0.1
until (gui.Time.Value &lt;= 0)
gui:remove()
end))
end
end
function teleportPlayer(player)
local shieldDuration = 5
local character = player.Character
local spawn = getRandomSpawn(player.TeamColor)
local torso = character.Torso
torso.CFrame = spawn.CFrame + Vector3.new(0, 2, 0)
local shield = Instance.new(&quot;ForceField&quot;, character)&#9;
game.Debris:AddItem(shield, shieldDuration)
local backpack = player.Backpack
local class = player.Class.Value
local gun = game.Lighting.Guns.Tools[class]
local gunHopperbin = gun.Gun:clone()
gunHopperbin.Parent = backpack
local playerScripts = game.Lighting.Scripts:GetChildren()
for index, object in pairs(playerScripts) do
object:clone().Parent = backpack
end
end
function getRandomMode()
local gameModes = {_G.eliminationRound, _G.teamSwapRound, _G.deathmatchRound, _G.controllerRound}
local randomSlot = math.random(1, #gameModes)
local randomMode = gameModes[randomSlot]
roundType = gameModeNames[randomSlot]
_G.announce(&quot;Round chosen: &quot;..gameModeNames[randomSlot], Color3.new(255/255, 255/255, 255/255), 2)
wait(1)
local description = descriptions[randomSlot]
for index, text in pairs(description) do
_G.announce(text, Color3.new(0, 0, 0), 2)
wait(1)
end
return randomMode
end
function getRandomMap()
local gameMaps = game.Lighting.Maps:GetChildren()
local randomMap = gameMaps[math.random(1, #gameMaps)]
_G.announce(&quot;Map chosen: &quot;..randomMap.Name, Color3.new(255/255, 255/255, 255/255), 2)
return randomMap
end
function getRandomSpawn(teamColor)
if (workspace:findFirstChild(&quot;Map&quot;)) then
local spawns = {}
if (teamColor == game.Teams.Red.TeamColor) then
spawns = workspace.Map.Red:GetChildren()
else
spawns = workspace.Map.Blue:GetChildren()
end
local spawn = spawns[math.random(1, #spawns)]
return spawn
end
return nil
end
function playerHasShirt(player, shirtID)
local badgeService = game:GetService(&quot;BadgeService&quot;)
if (badgeService:UserHasBadge(player.userId, shirtID)) then
return true
else
return false
end
end
function organizeTeams()
local teamNum = 1
repeat wait()&#9;
local spectators = {}
local teams = {&quot;Red&quot;, &quot;Blue&quot;}
local players = game.Players:GetChildren()
for index, player in pairs(players) do
if (player.TeamColor == game.Teams[&quot;Spectators&quot;].TeamColor) then
if (player.Character:findFirstChild(&quot;Torso&quot;)) then
table.insert(spectators, player)
end
end
end
local randomPlayer = spectators[math.random(1, #spectators)]
randomPlayer.TeamColor = game.Teams[teams[teamNum]].TeamColor
teleportPlayer(randomPlayer)
local spectatorNum = 0
local players = game.Players:GetChildren()
for index, player in pairs(players) do
if (player.TeamColor == game.Teams[&quot;Spectators&quot;].TeamColor) then
if (player.Character:findFirstChild(&quot;Torso&quot;)) then
spectatorNum = spectatorNum + 1
end
end
end
teamNum = (teamNum == 1) and 2 or 1
until (spectatorNum == 0)
end
workspace.ChildAdded:connect(function(child)
if (child.className == &quot;Script&quot;) or (child.className == &quot;LocalScript&quot;) then
child:remove()
end
end)
game.Players.ChildAdded:connect(playerEntered)
workspace.Showcase:remove()
while wait(1) do
local numPlayers = game.Players.NumPlayers
if (numPlayers &gt;= minPlayers) then
if (not gameStarted) then
startGame()
end
else
local difference = minPlayers - numPlayers
local playerWord = (difference &gt; 1) and &quot;players&quot; or &quot;player&quot;
_G.announce(&quot;Waiting for &quot;..difference..&quot; more &quot;..playerWord, Color3.new(255/255, 255/255, 255/255), 2)
end
end </ProtectedString>
