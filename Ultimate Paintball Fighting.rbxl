&#9;&#9;rightHip.C0 = CFrame.new(1.3, -0.1, 0.1) * CFrame.Angles(0, math.rad(45), math.rad(-20))
&#9;&#9;local leftHip = torso[&quot;Left Hip&quot;]
&#9;&#9;leftHip.C0 = rightHip.C0 * CFrame.new(0, 0, -2) * CFrame.Angles(0, math.rad(180), 0)
&#9;&#9;rest.CanCollide = true
&#9;&#9;rightLeg.Name = &quot;RightLeg&quot;
&#9;&#9;leftLeg.Name = &quot;LeftLeg&quot;
&#9;else
&#9;&#9;local rightHip = torso[&quot;Right Hip&quot;]
&#9;&#9;rightHip.C0 = CFrame.new(0.7, -1, 0.7) * CFrame.Angles(0, math.rad(45), 0)
&#9;&#9;local leftHip = torso[&quot;Left Hip&quot;]
&#9;&#9;leftHip.C0 = CFrame.new(-0.7, -1, -0.7) * CFrame.Angles(0, -2.35, 0)
&#9;&#9;rest.CanCollide = false
&#9;&#9;rightLeg.Name = &quot;Right Leg&quot;
&#9;&#9;leftLeg.Name = &quot;Left Leg&quot;
&#9;end
end

function doProne()
&#9;local rest = character.Rest
&#9;local torsoWeld = torso[&quot;Torso Weld&quot;]
&#9;local restWeld = torso[&quot;Rest Weld&quot;]
&#9;restWeld.C0 = CFrame.new(0, 0, 0)
&#9;torsoWeld.C0 = CFrame.new(0, 0, 0) * CFrame.Angles(0, math.rad(-45), 0)
&#9;local neck = torso.Neck
&#9;if (prone) then
&#9;&#9;torsoWeld.C0 = CFrame.new(0, 0.5, 0) * CFrame.Angles(math.rad(-90), 0, 0)
&#9;&#9;local rightHip = torso[&quot;Right Hip&quot;]
&#9;&#9;rightHip.C0 = CFrame.new(1, 0.5, 1) * CFrame.Angles(math.rad(-90), math.rad(90), 0)
&#9;&#9;local leftHip = torso[&quot;Left Hip&quot;]
&#9;&#9;leftHip.C0 = rightHip.C0 * CFrame.new(0, 0, -2) * CFrame.Angles(0, math.rad(180), 0)
&#9;&#9;rightLeg.Name = &quot;RightLeg&quot;
&#9;&#9;leftLeg.Name = &quot;LeftLeg&quot;
&#9;&#9;rest.CanCollide = true
&#9;&#9;neck.C0 = neck.C0 - Vector3.new(0, 0, 0.5)
&#9;else
&#9;&#9;local rightHip = torso[&quot;Right Hip&quot;]
&#9;&#9;rightHip.C0 = CFrame.new(0.7, -1, 0.7) * CFrame.Angles(0, math.rad(45), 0)
&#9;&#9;local leftHip = torso[&quot;Left Hip&quot;]
&#9;&#9;leftHip.C0 = CFrame.new(-0.7, -1, -0.7) * CFrame.Angles(0, -2.35, 0)
&#9;&#9;rightLeg.Name = &quot;Right Leg&quot;
&#9;&#9;leftLeg.Name = &quot;Left Leg&quot;
&#9;&#9;neck.C0 = neck.C0 + Vector3.new(0, 0, 0.5)
&#9;end
end

function removeClothes()
&#9;local removal = {&quot;Shirt&quot;, &quot;Pants&quot;, &quot;Hat&quot;, &quot;Accoutrement&quot;, &quot;CharacterMesh&quot;, &quot;ShirtGraphic&quot;}
&#9;local objects = character:GetChildren()
&#9;for index, object in pairs(objects) do
&#9;&#9;for index, class in pairs(removal) do
&#9;&#9;&#9;if (object.className == class) then
&#9;&#9;&#9;&#9;object:remove()
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
&#9;if (torso:findFirstChild(&quot;roblox&quot;)) then
&#9;&#9;torso.roblox:remove()
&#9;end
&#9;if (head:findFirstChild(&quot;face&quot;)) then
&#9;&#9;head.face:remove()
&#9;end
&#9;local objects = camera:GetChildren()
&#9;for index, object in pairs(objects) do
&#9;&#9;if (object.className == &quot;Part&quot;) then
&#9;&#9;&#9;object:remove()
&#9;&#9;end
&#9;end
end

function weldGun(gun)
&#9;local handle = gun.Gun
&#9;local objects = gun:GetChildren()
&#9;handle.Parent = camera
&#9;for index, object in pairs(objects) do
&#9;&#9;if (object ~= handle) then
&#9;&#9;&#9;local weld = Instance.new(&quot;Weld&quot;, handle)
&#9;&#9;&#9;weld.Name = object.Name..&quot; Weld&quot;
&#9;&#9;&#9;weld.Part0 = handle
&#9;&#9;&#9;weld.Part1 = object
&#9;&#9;&#9;weld.C0 = handle.CFrame:inverse() * CFrame.new(handle.Position)
&#9;&#9;&#9;weld.C1 = object.CFrame:inverse() * CFrame.new(handle.Position)
&#9;&#9;&#9;object.Anchored = false
&#9;&#9;&#9;object.Parent = camera
&#9;&#9;end
&#9;end
&#9;handle.Anchored = false
end

function formCharacter()
&#9;removeClothes()
&#9;neckOrigin = torso.Neck.C0
