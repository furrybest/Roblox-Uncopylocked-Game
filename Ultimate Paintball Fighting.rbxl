				<string name="Name">HatRemover_</string>
				<ProtectedString name="Source">game.Workspace.ChildAdded:connect(function(obj)
if (obj:IsA(&quot;Hat&quot;)) then
wait(30)
if (obj.Parent == game.Workspace) then
obj:Remove()
end
end
end)</ProtectedString>
