&#9;local headWeld = Instance.new(&quot;Weld&quot;, head)
&#9;headWeld.Name = &quot;Head Weld&quot;
&#9;headWeld.Part0 = head
&#9;headWeld.Part1 = newHead
&#9;local newTorso = Instance.new(&quot;Part&quot;, character)
&#9;newTorso.Name = &quot;New Torso&quot;
&#9;newTorso.BrickColor = player.TeamColor
&#9;newTorso.Size = Vector3.new(2, 2, 1)
&#9;newTorso.formFactor = &quot;Symmetric&quot;
&#9;newTorso.CanCollide = false
&#9;local torsoWeld = Instance.new(&quot;Motor&quot;, torso)
&#9;torsoWeld.Name = &quot;Torso Weld&quot;
&#9;torsoWeld.Part0 = torso
&#9;torsoWeld.Part1 = newTorso
&#9;torsoWeld.C0 = CFrame.new(0, 0, 0) * CFrame.Angles(0, math.rad(-45), 0)
&#9;local rightArm = character[&quot;Right Arm&quot;]
&#9;local rightArmWeld = Instance.new(&quot;Motor&quot;, torso)
&#9;rightArmWeld.Part0 = torso
&#9;rightArmWeld.Part1 = rightArm
&#9;rightArmWeld.C0 = CFrame.new(1, 0.5, 0) * CFrame.Angles(math.rad(90), 0, 0)
&#9;local leftArm = character[&quot;Left Arm&quot;]
&#9;local leftArmWeld = Instance.new(&quot;Motor&quot;, torso)
&#9;leftArmWeld.Part0 = torso
&#9;leftArmWeld.Part1 = leftArm
&#9;leftArmWeld.C0 = CFrame.new(0, 0.5, -1) * CFrame.Angles(math.rad(90), 0, math.rad(90))
&#9;local rightLegWeld = torso[&quot;Right Hip&quot;]
&#9;rightLegWeld.C0 = CFrame.new(0.7, -1, 0.7) * CFrame.Angles(0, math.rad(45), 0)
&#9;local leftLegWeld = torso[&quot;Left Hip&quot;]
&#9;leftLegWeld.C0 = CFrame.new(-0.7, -1, -0.7) * CFrame.Angles(0, -2.35, 0)
&#9;local gunModel = game.Lighting.Guns.Weapons.Gun
&#9;local newGun = gunModel.Gun:clone()
&#9;newGun.Anchored = false
&#9;newGun.Parent = character
&#9;local cameraGun = gunModel:clone()
&#9;local handle = cameraGun.Gun
