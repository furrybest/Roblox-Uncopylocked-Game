						<string name="Name">Starter</string>
						<Ref name="PrimaryPart">null</Ref>
					</Properties>
					<Item class="HopperBin" referent="RBX8664">
						<Properties>
							<bool name="Active">false</bool>
							<token name="BinType">0</token>
							<string name="Name">Gun</string>
							<Content name="TextureId"><null></null></Content>
						</Properties>
						<Item class="LocalScript" referent="RBX8665">
							<Properties>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">Shooter</string>
								<ProtectedString name="Source">local hopperbin = script.Parent
local camera = workspace.CurrentCamera
local player = game.Players.LocalPlayer
local character = player.Character
local bullets = workspace.Bullets
local reloadTime = 0.1
local spread = 5
local recoil = 1
local fire = false
local bulletSpeed = 75
local bulletDrop = 20

_G.shooterSelected = (function(mouse)
&#9;mouse.Icon = &quot;http://www.roblox.com/asset/?id=15324984&quot;
&#9;mouse.Button1Down:connect(function()
&#9;&#9;clicked(mouse)
&#9;end)
&#9;mouse.KeyDown:connect(_G.animateKeyPressed)
end)

function clicked(mouse)
&#9;local gun = camera.Gun
&#9;if (character.Humanoid.Health &gt; 0) then
&#9;&#9;if (not fire) then
&#9;&#9;&#9;fire = true
&#9;&#9;&#9;delay(reloadTime, (function() fire = false end))
&#9;&#9;&#9;local head = character.Head
&#9;&#9;&#9;local startPos = (gun.CFrame * CFrame.new(0, -2, 0)).p
&#9;&#9;&#9;local endPos = (camera.CoordinateFrame * CFrame.new(0, 0, -100)).p
&#9;&#9;&#9;local distance = (endPos - startPos).magnitude
&#9;&#9;&#9;local random = Vector3.new((math.random(-spread, spread) / 250) * distance, (math.random(-spread, spread) / 250) * distance, (math.random(-spread, spread) / 250) * distance)
&#9;&#9;&#9;local shot = gun.Fire
&#9;&#9;&#9;if (not _G.sighted) then
&#9;&#9;&#9;&#9;_G.fireBullet(&quot;Starter&quot;, startPos, endPos + random, 100, bulletSpeed, bulletDrop, player.TeamColor, bullets)
&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;_G.fireBullet(&quot;Starter&quot;, startPos, endPos, 100, bulletSpeed, bulletDrop, player.TeamColor, bullets)
&#9;&#9;&#9;end
&#9;&#9;&#9;recoilCam()
&#9;&#9;&#9;shot:play()
&#9;&#9;end
&#9;end
end

function recoilCam()
&#9;coroutine.resume(coroutine.create(function()
&#9;&#9;camera.Focus = camera.Focus + Vector3.new(0, recoil / 100, 0)
&#9;&#9;local interval = 20
&#9;&#9;for i = 1, interval do
&#9;&#9;&#9;wait(0.01)
