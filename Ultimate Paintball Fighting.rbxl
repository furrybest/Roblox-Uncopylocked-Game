			<Item class="Script" referent="RBX2520">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Controller</string>
					<ProtectedString name="Source">_G.controllerRound = (function()
&#9;game.Teams[&quot;Spectators&quot;].AutoAssignable = false
&#9;game.Teams.Red.AutoAssignable = true
&#9;game.Teams.Blue.AutoAssignable = true
&#9;local gameEnd = false
&#9;local roundTime = 5
&#9;local redFlags = 0
&#9;local blueFlags = 0
&#9;for minutes = roundTime - 1, 0, -1 do
&#9;&#9;if (gameEnd) then
&#9;&#9;&#9;break
&#9;&#9;end
&#9;&#9;for seconds = 59, 0, -1 do
&#9;&#9;&#9;wait(1)
&#9;&#9;&#9;if (gameEnd) then
&#9;&#9;&#9;&#9;break
&#9;&#9;&#9;end
&#9;&#9;&#9;redFlags = 0
&#9;&#9;&#9;blueFlags = 0
&#9;&#9;&#9;seconds = (seconds &gt;= 10) and seconds or &quot;0&quot;..seconds
&#9;&#9;&#9;local flags = workspace.Map:GetChildren()
&#9;&#9;&#9;for index, flag in pairs(flags) do
&#9;&#9;&#9;&#9;if (flag:findFirstChild(&quot;Flag&quot;)) then
&#9;&#9;&#9;&#9;&#9;local color = flag.Flag.BrickColor
&#9;&#9;&#9;&#9;&#9;if (color == game.Teams.Red.TeamColor) then
&#9;&#9;&#9;&#9;&#9;&#9;redFlags = redFlags + 1
&#9;&#9;&#9;&#9;&#9;elseif (color == game.Teams.Blue.TeamColor) then
&#9;&#9;&#9;&#9;&#9;&#9;blueFlags = blueFlags + 1
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;&#9;local players = game.Players:GetChildren()
&#9;&#9;&#9;for index, player in pairs(players) do
&#9;&#9;&#9;&#9;updateHUD(player, minutes..&quot;:&quot;..seconds, redFlags, blueFlags)
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
&#9;if (not gameEnd) then
&#9;&#9;if (redFlags &gt; blueFlags) then
&#9;&#9;&#9;local flagWord = (redFlags &gt; 1) and &quot;flags&quot; or &quot;flag&quot;
&#9;&#9;&#9;_G.endGame(game.Teams.Red, &quot;Time&apos;s up! Red wins with &quot;..redFlags..&quot; &quot;..flagWord..&quot; controlled!&quot;)
&#9;&#9;elseif (blueFlags &gt; redFlags) then
&#9;&#9;&#9;local flagWord = (blueFlags &gt; 1) and &quot;flags&quot; or &quot;flag&quot;
&#9;&#9;&#9;_G.endGame(game.Teams.Blue, &quot;Time&apos;s up! Blue wins with &quot;..blueFlags..&quot; &quot;..flagWord..&quot; controlled!&quot;)
&#9;&#9;else
&#9;&#9;&#9;local flagWord = (redFlags &gt; 1) and &quot;flags&quot; or &quot;flag&quot;
&#9;&#9;&#9;_G.endGame(nil, &quot;Time&apos;s up! It&apos;s a draw! Both teams had &quot;..redFlags..&quot; &quot;..flagWord..&quot; controlled!&quot;)
&#9;&#9;end
&#9;end
end)

function updateHUD(player, timeLeft, redStat, blueStat)
&#9;local playerGui = player.PlayerGui
&#9;local HUD = playerGui.HUD
&#9;local top = HUD.Top
&#9;local mode = top.Mode
&#9;local time = top.Time
&#9;local red = top.Red
&#9;local blue = top.Blue
&#9;top.Visible = true
&#9;mode.Text = &quot;Controller&quot;
&#9;time.Text = timeLeft
&#9;red.Score.Text = redStat
&#9;red.Title.Text = &quot;Red flags&quot;
&#9;blue.Score.Text = blueStat
&#9;blue.Title.Text = &quot;Blue flags&quot;
end
