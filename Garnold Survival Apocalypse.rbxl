local player = game.Players.LocalPlayer

local tool = script.Parent
local list = {}

local gui = tool.CraftFrame
local clear = gui.Clear
local cItem = gui.Item
local cProcess = gui.Process
local cTool = gui.Tool
local ingList = gui.List

local choiceFrame = gui.ChoiceFrame
local bTemp = choiceFrame.ChoiceTemplate
bTemp.Parent = nil

local gui2 = tool.CraftBB
local frame = gui2.Frame
local name = frame.ObjName

db = true

function clearList()
&#9;for index, ingredient in pairs(list) do
&#9;&#9;if ingredient:findFirstChild(&quot;InUse&quot;) ~= nil then
&#9;&#9;&#9;save = ingredient:findFirstChild(&quot;Save&quot;)
&#9;&#9;&#9;print(ingredient.Name)
&#9;&#9;&#9;ingredient.InUse:Remove()
&#9;&#9;&#9;if save ~= nil then
&#9;&#9;&#9;&#9;save:Remove()
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
&#9;for index, button in pairs(choiceFrame:GetChildren()) do
&#9;&#9;button:Remove()
&#9;end
&#9;choiceFrame.Visible = false
&#9;list = {}
&#9;ingList.Text = &quot;&quot;
end

function deleteList()
&#9;for index, ing in pairs(list) do
&#9;&#9;if ing:findFirstChild(&quot;Save&quot;) == nil then
&#9;&#9;&#9;ing:Remove()
&#9;&#9;else
&#9;&#9;&#9;ing:findFirstChild(&quot;Save&quot;):Remove()
&#9;&#9;end
&#9;end
end

function outputList(table)
&#9;local text = &quot;&quot;
&#9;for index, ing in pairs(table) do
&#9;&#9;if index == 1 then
&#9;&#9;&#9;text = ing.Name
&#9;&#9;else
&#9;&#9;&#9;text = text..&quot;, &quot;..ing.Name
&#9;&#9;end
&#9;end
&#9;return text
end

function getDist(posA, posB)
&#9;return (posA - posB).magnitude
end

function round(num) 
&#9;num = num + .5 
&#9;num = math.floor(num) 
&#9;return num 
end

function getMade(current, type)
&#9;correctRecipe = nil
&#9;for index, recipe in pairs(type) do -- Index all of the recipes
&#9;&#9;local recList = recipe[1]
&#9;&#9;local correct = true
&#9;&#9;if #recList == #current then
&#9;&#9;&#9;for i2, item in pairs(recList) do -- Index ingredients in the recipe list
&#9;&#9;&#9;&#9;if string.find(item, current[i2].Name) == nil then
&#9;&#9;&#9;&#9;&#9;print(item, current[i2].Name)
&#9;&#9;&#9;&#9;&#9;print(i2..&quot; is false&quot;)
&#9;&#9;&#9;&#9;&#9;correct = false
&#9;&#9;&#9;&#9;&#9;break
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;print(i2..&quot; is correct&quot;)
&#9;&#9;&#9;&#9;if i2 == #recList then
&#9;&#9;&#9;&#9;&#9;if correct == true then
&#9;&#9;&#9;&#9;&#9;&#9;print(&quot;Found correct recipe&quot;)
&#9;&#9;&#9;&#9;&#9;&#9;correctRecipe = recipe
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;&#9;if correctRecipe ~= nil then 
&#9;&#9;&#9;&#9;break&#9;
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
&#9;print(&quot;returning recipe&quot;)
&#9;return correctRecipe
end

function createChoiceButtons(created)
&#9;local buttonTable = {}
&#9;choiceFrame.Visible = true
&#9;if type(created) == &quot;string&quot; then
&#9;&#9;local button = bTemp:Clone()
&#9;&#9;button.Name = created
&#9;&#9;button.Text = &quot;Create &quot;..created
&#9;&#9;button.Parent = choiceFrame
&#9;&#9;table.insert(buttonTable, button)
&#9;elseif type(created) == &quot;table&quot; then
&#9;&#9;for index, madeItem in pairs(created) do
&#9;&#9;&#9;local button = bTemp:Clone()
&#9;&#9;&#9;button.Name = madeItem
&#9;&#9;&#9;button.Text = &quot;Create &quot;..madeItem
&#9;&#9;&#9;button.Parent = choiceFrame
&#9;&#9;&#9;button.Position = UDim2.new(0.05, 0, (index-1)*(button.Size.Y.Scale)+0.05, 0)
&#9;&#9;&#9;table.insert(buttonTable, button)
&#9;&#9;end
&#9;end
&#9;return buttonTable
end

function createItem()
&#9;local recipe = getMade(list, itemCraftList)
&#9;if recipe ~= nil then
&#9;&#9;local createdItem = recipe[2]
&#9;&#9;local amt = recipe[3]
&#9;&#9;local buttons = createChoiceButtons(createdItem)
&#9;&#9;for index, button in pairs(buttons) do
&#9;&#9;&#9;button.MouseButton1Down:connect(function() 
&#9;&#9;&#9;&#9;local real = game.Lighting.Items:findFirstChild(button.Name)
&#9;&#9;&#9;&#9;local inventory = player.Inventory
&#9;&#9;&#9;&#9;if real ~= nil then
&#9;&#9;&#9;&#9;&#9;if inventory.Items.Value &lt;= inventory.MaxItems.Value - amt then
&#9;&#9;&#9;&#9;&#9;&#9;inventory.Items.Value = inventory.Items.Value + amt
&#9;&#9;&#9;&#9;&#9;&#9;for x = 1, amt do
&#9;&#9;&#9;&#9;&#9;&#9;&#9;real:Clone().Parent = inventory
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;deleteList()
&#9;&#9;&#9;&#9;&#9;&#9;clearList()
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end)
&#9;&#9;end
&#9;end
end

function plant(compost, seed)
&#9;seed.Locked = true
&#9;seed.Anchored = true
&#9;compost.Locked = true

&#9;seed.CFrame = compost.CFrame

&#9;local val = Instance.new(&quot;ObjectValue&quot;)
&#9;val.Name = &quot;MyCompost&quot;
&#9;val.Value = compost
&#9;val.Parent = seed
end

function startProcess()
&#9;local recipe = getMade(list, processList)
&#9;if recipe ~= nil then
&#9;&#9;local service = workspace.Services:findFirstChild(recipe[2])
&#9;&#9;if service.Name == &quot;Farming&quot; then
&#9;&#9;&#9;local zombieOwner = nil
&#9;&#9;&#9;plant(list[1], list[2])
&#9;&#9;&#9;if list[2].Name == &quot;Zombie Seed&quot; then
&#9;&#9;&#9;&#9;zombieOwner = player
&#9;&#9;&#9;end
&#9;&#9;&#9;local ov = Instance.new(&quot;ObjectValue&quot;)
&#9;&#9;&#9;ov.Value = list[2]
&#9;&#9;&#9;if zombieOwner ~= nil then
&#9;&#9;&#9;&#9;ov.Name = zombieOwner.Name
&#9;&#9;&#9;end
&#9;&#9;&#9;ov.Parent = service
&#9;&#9;elseif service.Name == &quot;Biofuel&quot; then
&#9;&#9;&#9;local ov = Instance.new(&quot;ObjectValue&quot;)
&#9;&#9;&#9;ov.Value = list[1]
&#9;&#9;&#9;ov.Parent = service
&#9;&#9;end
&#9;&#9;clearList()
&#9;end
end

function createTool()
&#9;local recipe = getMade(list, toolCraftList)
&#9;if recipe ~= nil then
&#9;&#9;local createdItem = recipe[2]
&#9;&#9;local type = recipe[3]
&#9;&#9;local buttons = createChoiceButtons(createdItem)
&#9;&#9;for index, button in pairs(buttons) do
&#9;&#9;&#9;button.MouseButton1Down:connect(function()
&#9;&#9;&#9;&#9;if type == &quot;Tool&quot; then
&#9;&#9;&#9;&#9;&#9;print(&quot;Tool Made&quot;)
&#9;&#9;&#9;&#9;&#9;local real = game.Lighting.Tools:findFirstChild(button.Name)
&#9;&#9;&#9;&#9;&#9;if real ~= nil then
&#9;&#9;&#9;&#9;&#9;&#9;real:Clone().Parent = player.Backpack
&#9;&#9;&#9;&#9;&#9;&#9;deleteList()
&#9;&#9;&#9;&#9;&#9;&#9;clearList()
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;elseif type == &quot;StructureVehicle&quot; then
&#9;&#9;&#9;&#9;&#9;print(&quot;Structure/Vehicle Made&quot;)
&#9;&#9;&#9;&#9;&#9;local&#9;real = game.Lighting.StructuresVehicles:findFirstChild(button.Name)
&#9;&#9;&#9;&#9;&#9;if real ~= nil then
&#9;&#9;&#9;&#9;&#9;&#9;print(&quot;Tool exists&quot;)
&#9;&#9;&#9;&#9;&#9;&#9;local madeTool = game.Lighting.Tools.TEMPLATE:Clone()
&#9;&#9;&#9;&#9;&#9;&#9;madeTool.Name = button.Name
&#9;&#9;&#9;&#9;&#9;&#9;madeTool.Parent = player.Backpack
&#9;&#9;&#9;&#9;&#9;&#9;deleteList()
&#9;&#9;&#9;&#9;&#9;&#9;clearList()
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end)
&#9;&#9;end
&#9;end
end

function onMouseMove(mouse)
&#9;local char = player.Character 
&#9;local target = mouse.Target
&#9;local pos = mouse.hit.p
&#9;
&#9;if db == true then
&#9;&#9;if target ~= nil then
&#9;&#9;&#9;if getDist(pos, char.Head.Position) &lt; 10 then
&#9;&#9;&#9;&#9;if target.Locked == false then
&#9;&#9;&#9;&#9;&#9;gui2.Adornee = target
&#9;&#9;&#9;&#9;&#9;gui2.Parent = player.PlayerGui
&#9;&#9;&#9;&#9;&#9;name.Text = target.Name
&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;gui2.Adornee = nil
&#9;&#9;&#9;&#9;&#9;gui2.Parent = tool
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;gui2.Adornee = nil
&#9;&#9;&#9;&#9;gui2.Parent = tool
&#9;&#9;&#9;end
&#9;&#9;else
&#9;&#9;&#9;gui2.Adornee = nil
&#9;&#9;&#9;gui2.Parent = tool&#9;
&#9;&#9;end
&#9;end
end

function onButton1Down(mouse)
&#9;
&#9;local char = player.Character 
&#9;local target = mouse.Target
&#9;local pos = mouse.hit.p
&#9;
&#9;if target ~= nil then
&#9;&#9;print(&quot;Found Target&quot;)
&#9;&#9;if getDist(pos, char.Torso.Position) &lt; 15 then
&#9;&#9;&#9;print(&quot;Close enough&quot;)
&#9;&#9;&#9;if target.Locked == false and target:findFirstChild(&quot;InUse&quot;) == nil then
&#9;&#9;&#9;&#9;print(&quot;Craftable&quot;)
&#9;&#9;&#9;&#9;local val = Instance.new(&quot;IntValue&quot;, target)
&#9;&#9;&#9;&#9;val.Name = &quot;InUse&quot;
&#9;&#9;&#9;&#9;table.insert(list, target)
&#9;&#9;&#9;&#9;ingList.Text = outputList(list)
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end

function onSelected(mouse)
&#9;gui.Parent = player.PlayerGui.ScreenGui

&#9;mouse.Move:connect(function() onMouseMove(mouse) end)
&#9;mouse.Button1Down:connect(function() onButton1Down(mouse) end)
end

function onDeselected()
&#9;clearList()
&#9;gui.Parent = tool
&#9;gui2.Adornee = nil
&#9;gui2.Parent = tool
end

tool.Selected:connect(onSelected)
tool.Deselected:connect(onDeselected)

cItem.MouseButton1Down:connect(createItem)
cTool.MouseButton1Down:connect(createTool)
cProcess.MouseButton1Down:connect(startProcess)
clear.MouseButton1Down:connect(clearList)

