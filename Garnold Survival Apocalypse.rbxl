						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">wait(0.5)
local door = script.Parent
local gate = door.Parent
local owner = gate.Owner.Value
local db = true

function getTribeFromMember()
&#9;local tribes = workspace.Services.Tribes:getChildren()
&#9;for index, tribe in pairs(tribes) do
&#9;&#9;for index, member in pairs(tribe.Members:getChildren()) do
&#9;&#9;&#9;if member.Name == owner.Name then
&#9;&#9;&#9;&#9;return tribe
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end

function openDoor()
&#9;door.Transparency = 0.5
&#9;door.CanCollide = false
&#9;wait(0.5)
&#9;door.Transparency = 0
&#9;door.CanCollide = true
end

function onTouched(hit)
&#9;if db == true then
&#9;&#9;db = false
&#9;&#9;if hit ~= nil then
&#9;&#9;&#9;if hit.Parent ~= nil then
&#9;&#9;&#9;&#9;local player = game.Players:GetPlayerFromCharacter(hit.Parent)
&#9;&#9;&#9;&#9;if player ~= nil then
&#9;&#9;&#9;&#9;&#9;if owner.InAColony.Value == true then
&#9;&#9;&#9;&#9;&#9;&#9;local tribe = getTribeFromMember()
&#9;&#9;&#9;&#9;&#9;&#9;for index, member in pairs(tribe.Members:getChildren()) do
&#9;&#9;&#9;&#9;&#9;&#9;&#9;if player.Name == member.Name then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;openDoor()
&#9;&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;&#9;if player == owner then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;openDoor()
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;db = true
&#9;end
end

door.Touched:connect(onTouched)</ProtectedString>
