						<ProtectedString name="Source">tool = script.Parent
timeLeft = tool.TimeLeft
handle = tool.Handle
light = handle.Light

while true do
&#9;wait(1)
&#9;if timeLeft.Value &gt; 0 then
&#9;&#9;timeLeft.Value = timeLeft.Value - 1
&#9;else
&#9;&#9;if handle:findFirstChild(&quot;Fire&quot;) ~= nil then
&#9;&#9;&#9;handle.Fire:Remove()
&#9;&#9;&#9;light.Value = 0
&#9;&#9;end
&#9;end
end

