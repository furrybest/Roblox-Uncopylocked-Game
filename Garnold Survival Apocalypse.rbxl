				<Item class="Script" referent="RBX8947">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">PaintballShooter</string>
						<ProtectedString name="Source">Tool = script.Parent
Tool.GripPos = Vector3.new(0, 0, 1)


RT = 3
shotc = 0

colors = {26}

function fire(v)

if (script.Parent.AmmoScript.Clip.Value == 0) then return 
&#9;end 
&#9;script.Parent.AmmoScript.Clip.Value = script.Parent.AmmoScript.Clip.Value - 1
&#9;print(Ammo)
&#9;

&#9;Tool.Handle.Fire:play()
&#9;Tool.Parent.Torso:findFirstChild(&quot;Right Shoulder&quot;).CurrentAngle = 1
&#9;

&#9;local vCharacter = Tool.Parent
&#9;local vPlayer = game.Players:GetPlayerFromCharacter(Tool.Parent)

&#9;local missile = Instance.new(&quot;Part&quot;)
&#9;local mesh = Instance.new(&quot;SpecialMesh&quot;)

&#9;mesh.MeshType = (&quot;Sphere&quot;)
&#9;mesh.Scale = Vector3.new(.3,.3,.3)
&#9;mesh.Parent = missile
&#9;

&#9;local spawnPos = Tool.Scope.Position

&#9;spawnPos  = spawnPos + (v * 5)

&#9;missile.formFactor = (&quot;Symmetric&quot;)
&#9;missile.Position = spawnPos
&#9;missile.Locked = false
&#9;missile.Size = Vector3.new(1,1,1)
&#9;missile.Velocity = v * 750
&#9;missile.BrickColor = BrickColor.new(26)
&#9;missile.BottomSurface = 0
&#9;missile.TopSurface = 0
&#9;missile.Name = &quot;Paintball&quot;
&#9;missile.Elasticity = 0
&#9;missile.Reflectance = 0.2
&#9;missile.Friction = 0
&#9;missile.CanCollide = true

&#9;local force = Instance.new(&quot;BodyForce&quot;)
&#9;force.force = Vector3.new(0,196,0)
&#9;force.Parent = missile
&#9;Tool.BrickCleanup:clone().Parent = missile

&#9;--local new_mesh2 = script.Parent.Mesh1:clone()
&#9;--new_mesh2.Parent = missile

&#9;local new_script = script.Parent.Paintball:clone()
&#9;new_script.Disabled = false
&#9;new_script.Parent = missile

&#9;local creator_tag = Instance.new(&quot;ObjectValue&quot;)
&#9;creator_tag.Value = vPlayer
&#9;creator_tag.Name = &quot;creator&quot;
&#9;creator_tag.Parent = missile


&#9;missile.Parent = game.Workspace


end



Tool.Enabled = true
function onActivated()

local hum = Tool.Parent.Humanoid

&#9;if not Tool.Enabled then
&#9;&#9;return
&#9;end

&#9;Tool.Enabled = false

&#9;local character = Tool.Parent;
&#9;local humanoid = character.Humanoid
&#9;if humanoid == nil then
&#9;&#9;print(&quot;Humanoid not found&quot;)
&#9;&#9;return 
&#9;end

&#9;local targetPos = humanoid.TargetPoint
&#9;local lookAt = (targetPos - character.Head.Position).unit


&#9;fire(lookAt)

Tool.GripPos = Vector3.new(0, 0, 0.8)
wait(.001)
Tool.GripPos = Vector3.new(0, 0, 0.4)
wait(.001)
Tool.GripPos = Vector3.new(0, 0, 0.0)

&#9;shotc = shotc + 1
wait(.2)
Tool.GripPos = Vector3.new(0, 0, 0.4)
wait(.001) 
Tool.GripPos = Vector3.new(0, 0, 0.8)
wait(.001)
Tool.GripPos = Vector3.new(0, 0, 1)
&#9;
&#9;if (shotc &gt;= 5) then
&#9;RT = 3
&#9;shotc = 0
&#9;end

&#9;wait(RT)
&#9;RT = 3

&#9;Tool.Enabled = true
end


script.Parent.Activated:connect(onActivated)
</ProtectedString>
