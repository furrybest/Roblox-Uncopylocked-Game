					<Item class="Script" referent="RBX11157">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Check</string>
							<ProtectedString name="Source">tool = script.Parent

while true do
&#9;if tool.CratesOpened.Value == 5 then
&#9;&#9;if tool.Parent.className == &quot;Model&quot; then
&#9;&#9;&#9;local player = game.Players:GetPlayerFromCharacter(tool.Parent)&#9;
&#9;&#9;&#9;print(&quot;Awarding BadgeID: &quot;.. 34539952 ..&quot; to UserID: &quot; .. player.userId)
&#9;&#9;&#9;local b = game:GetService(&quot;BadgeService&quot;)
&#9;&#9;&#9;b:AwardBadge(player.userId, 34539952)
&#9;&#9;end
&#9;end
&#9;wait(1)
end
</ProtectedString>
