				<Item class="Script" referent="RBX8347">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">armor = script.Parent
inuse = false

armor.Touched:connect(function(hit)
&#9;local user = hit.Parent
&#9;local hum = user:findFirstChild(&quot;Humanoid&quot;)
&#9;if hum ~= nil then
&#9;&#9;if user:findFirstChild(&quot;Bulletproof Vest&quot;) == nil then
&#9;&#9;&#9;if not inuse then
&#9;&#9;&#9;&#9;local weld = Instance.new(&quot;Weld&quot;, user)
&#9;&#9;&#9;&#9;armor.Parent = user
&#9;&#9;&#9;&#9;weld.Part0 = user.Torso
&#9;&#9;&#9;&#9;weld.Part1 = armor
&#9;&#9;&#9;&#9;armor.CanCollide = false
&#9;&#9;&#9;&#9;armor.Locked = true
&#9;&#9;&#9;&#9;inuse = true
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end)</ProtectedString>
					</Properties>
				</Item>
