						<ProtectedString name="Source">wait(0.25)
local tool = script.Parent
local on = tool.Name
local handle = tool.Handle

local headDamage = 2
local torsoDamage = 1
local armsDamage = 0.5
local legsDamage = 0.75
local damage = 0
local reloadTime = 1.75
local range = 10
local debounce = true

local frame = tool.Frame
local drinksLeft = 0
local maxDrinks = 20
local drinkLabel = frame.DrinksLeft
local drinkBar = frame.WaterBar
local drinkButton = frame.DrinkButton

function slash()
&#9;local s = Instance.new(&quot;StringValue&quot;)
&#9;s.Name = &quot;toolanim&quot;
&#9;s.Value = &quot;Slash&quot;
&#9;s.Parent = tool
end

function setGUI()
&#9;drinkBar.Size = UDim2.new(drinksLeft / maxDrinks, 0, 1, 0)
&#9;drinkLabel.Text = &quot;Drinks Left: &quot;..drinksLeft
end

function takeDrink()
&#9;if drinksLeft &gt; 0 then
&#9;&#9;local player = game.Players:GetPlayerFromCharacter(tool.Parent)
&#9;&#9;local thirst = player.Stats.Thirst
&#9;&#9;thirst.Value = thirst.Value + 10
&#9;&#9;drinksLeft = drinksLeft - 1

&#9;&#9;setGUI()
&#9;end
end

drinkButton.MouseButton1Down:connect(takeDrink)

function onButton1Down(mouse)
&#9;if debounce == true then

&#9;&#9;slash()

&#9;&#9;local target = mouse.Target
&#9;&#9;local pos = mouse.hit.p

&#9;&#9;if target ~= nil then

&#9;&#9;&#9;if target.Parent ~= nil then

&#9;&#9;&#9;&#9;if (handle.Position - pos).magnitude &lt; range then

&#9;&#9;&#9;&#9;&#9;--extra stuff goes here

&#9;&#9;&#9;&#9;&#9;--Get drinks

&#9;&#9;&#9;&#9;&#9;if target.Name == &quot;Water&quot; or target.Name == &quot;Bottled Water&quot; then
&#9;&#9;&#9;&#9;&#9;&#9;drinksLeft = maxDrinks
&#9;&#9;&#9;&#9;&#9;end

&#9;&#9;&#9;&#9;&#9;--Wet stuff

&#9;&#9;&#9;&#9;&#9;local wetCheck = target:findFirstChild(&quot;Dry&quot;)

&#9;&#9;&#9;&#9;&#9;if wetCheck ~= nil then
&#9;&#9;&#9;&#9;&#9;&#9;if drinksLeft &gt; 0 then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;drinksLeft = drinksLeft - 1
&#9;&#9;&#9;&#9;&#9;&#9;&#9;target.Name = wetCheck.NewName.Value
&#9;&#9;&#9;&#9;&#9;&#9;&#9;target.BrickColor = wetCheck.NewColor.Value
&#9;&#9;&#9;&#9;&#9;&#9;&#9;wetCheck:remove()
&#9;&#9;&#9;&#9;&#9;&#9;&#9;if target.Name == &quot;Wet Sand&quot; then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;if target:findFirstChild(&quot;Impure&quot;) ~= nil then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;target.Impure.NewColor.Value = BrickColor.new(&quot;Dark orange&quot;)
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;target.Impure.NewName.Value = &quot;Clay&quot;
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;target.Impure.NewTransparence.Value = 0
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;end&#9;
&#9;&#9;&#9;&#9;&#9;&#9;&#9;end&#9;
&#9;&#9;&#9;&#9;&#9;&#9;end&#9;
&#9;&#9;&#9;&#9;&#9;end&#9;

&#9;&#9;&#9;&#9;&#9;--Waterproof / put out

&#9;&#9;&#9;&#9;&#9;if drinksLeft &gt; 0 then

&#9;&#9;&#9;&#9;&#9;&#9;local flammable = target:findFirstChild(&quot;Flammable&quot;)

&#9;&#9;&#9;&#9;&#9;&#9;if flammable ~= nil then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;flammable:remove()
&#9;&#9;&#9;&#9;&#9;&#9;&#9;local fs = target:findFirstChild(&quot;FireScript&quot;)
&#9;&#9;&#9;&#9;&#9;&#9;&#9;local light = target:findFirstChild(&quot;Light&quot;)
&#9;&#9;&#9;&#9;&#9;&#9;&#9;if fs ~= nil then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;fs:remove()
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;light:Remove()
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;target.Fire:Remove()
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;target.BrickColor = target.OriginalColor.Value
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;target.OriginalColor:remove()
&#9;&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;&#9;drinksLeft = drinksLeft - 1
&#9;&#9;&#9;&#9;&#9;&#9;end

&#9;&#9;&#9;&#9;&#9;end

&#9;&#9;&#9;&#9;&#9;setGUI()

&#9;&#9;&#9;&#9;end

&#9;&#9;&#9;end

&#9;&#9;end

&#9;&#9;tool.Name = &quot;Resting&quot;

&#9;&#9;debounce = false

&#9;&#9;wait(reloadTime)

&#9;&#9;tool.Name = on

&#9;&#9;debounce = true

&#9;end
end

function onEquipped(mouse)
&#9;mouse.Button1Down:connect(function() onButton1Down(mouse) end)

&#9;local player = game.Players:GetPlayerFromCharacter(tool.Parent)
&#9;frame.Parent = player.PlayerGui.ScreenGui

&#9;setGUI()
end

function onUnequipped()
&#9;frame.Parent = tool
end

tool.Equipped:connect(onEquipped)
tool.Unequipped:connect(onUnequipped)
