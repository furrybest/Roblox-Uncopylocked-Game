						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">wait(1)
fuel = script.Parent.Fuel
maxFuel = script.Parent.MaxFuel
carGui = script.Parent.Frame


function onChildAdded(child)
&#9;if child.className == &quot;Weld&quot; then
&#9;&#9;local char = child.Part1.Parent
&#9;&#9;if char.Name ~= &quot;Zombie&quot; and char.Name ~= &quot;Runner&quot; then
&#9;&#9;&#9;local player = game.Players:GetPlayerFromCharacter(child.Part1.Parent)
&#9;&#9;&#9;carGui.Parent = player.PlayerGui.ScreenGui
&#9;&#9;&#9;print(&quot;Character is Welded&quot;)
&#9;&#9;&#9;while true do
&#9;&#9;&#9;&#9;wait(3)
&#9;&#9;&#9;&#9;if fuel.Value &gt; 90 and fuel.Value &lt;= 100 then
&#9;&#9;&#9;&#9;&#9;print(&quot;Has Almost full Fuel&quot;)
&#9;&#9;&#9;&#9;&#9;script.Parent.MaxSpeed = 25
&#9;&#9;&#9;&#9;&#9;carGui.GasLeft.Size = UDim2.new(1, 0, (fuel.Value / maxFuel.Value)*-1, 0)
&#9;&#9;&#9;&#9;&#9;carGui.GasLeft.Text = &quot;Gas Left : &quot;..fuel.Value
&#9;&#9;&#9;&#9;&#9;if child.Parent == script.Parent then
&#9;&#9;&#9;&#9;&#9;&#9;fuel.Value = fuel.Value - 1
&#9;&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;&#9;return
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;elseif fuel.Value &gt; 80 and fuel.Value &lt;= 90 then
&#9;&#9;&#9;&#9;&#9;print(&quot;Still has Fuel&quot;)
&#9;&#9;&#9;&#9;&#9;script.Parent.MaxSpeed = 20
&#9;&#9;&#9;&#9;&#9;carGui.GasLeft.Size = UDim2.new(1, 0, (fuel.Value / maxFuel.Value)*-1, 0)
&#9;&#9;&#9;&#9;&#9;carGui.GasLeft.Text = &quot;Gas Left : &quot;..fuel.Value
&#9;&#9;&#9;&#9;&#9;if child.Parent == script.Parent then
&#9;&#9;&#9;&#9;&#9;&#9;fuel.Value = fuel.Value - 1
&#9;&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;&#9;return
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;elseif fuel.Value &gt; 60 and fuel.Value &lt;= 80 then
&#9;&#9;&#9;&#9;&#9;print(&quot;Still has Fuel&quot;)
&#9;&#9;&#9;&#9;&#9;script.Parent.MaxSpeed = 15
&#9;&#9;&#9;&#9;&#9;carGui.GasLeft.Size = UDim2.new(1, 0, (fuel.Value / maxFuel.Value)*-1, 0)
&#9;&#9;&#9;&#9;&#9;carGui.GasLeft.Text = &quot;Gas Left : &quot;..fuel.Value
&#9;&#9;&#9;&#9;&#9;if child.Parent == script.Parent then
&#9;&#9;&#9;&#9;&#9;&#9;fuel.Value = fuel.Value - 1
&#9;&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;&#9;return
&#9;&#9;&#9;&#9;&#9;end&#9;&#9;&#9;
&#9;&#9;&#9;&#9;elseif fuel.Value &gt; 40 and fuel.Value &lt;= 60 then
&#9;&#9;&#9;&#9;&#9;print(&quot;Still has Fuel&quot;)
&#9;&#9;&#9;&#9;&#9;script.Parent.MaxSpeed = 10
&#9;&#9;&#9;&#9;&#9;carGui.GasLeft.Size = UDim2.new(1, 0, (fuel.Value / maxFuel.Value)*-1, 0)
&#9;&#9;&#9;&#9;&#9;carGui.GasLeft.Text = &quot;Gas Left : &quot;..fuel.Value
&#9;&#9;&#9;&#9;&#9;if child.Parent == script.Parent then
