				<Item class="Script" referent="RBX5458">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">MoveScript</string>
						<ProtectedString name="Source">wait(1)
local bv = script.Parent.BodyVelocity

local bav = script.Parent.BodyAngularVelocity

local seat = script.Parent

local speed = 0
local maxSpeed = seat.MaxSpeed
local rotSpeed = 0
local maxRotSpeed = 2

--Start the constant movement calculator
delay(0, function()
&#9;while true do
&#9;&#9;maxSpeed = seat.MaxSpeed
&#9;&#9;bv.velocity = seat.CFrame.lookVector * speed
&#9;&#9;bav.angularvelocity = Vector3.new(0, rotSpeed, 0)
&#9;&#9;wait()
&#9;end
end)

seat.Changed:connect(function(prop)
&#9;if prop == &quot;Throttle&quot; then
&#9;&#9;if seat.Throttle == 1 or seat.Throttle == -1 then

&#9;&#9;&#9;speed = maxSpeed * seat.Throttle

&#9;&#9;elseif seat.Throttle == 0 then

&#9;&#9;&#9;speed = 0

&#9;&#9;end
&#9;elseif prop == &quot;Steer&quot; then
&#9;&#9;if seat.Steer == -1 or seat.Steer == 1 then

&#9;&#9;&#9;rotSpeed = maxRotSpeed * -seat.Steer

&#9;&#9;elseif seat.Steer == 0 then

&#9;&#9;&#9;rotSpeed = 0

&#9;&#9;end
&#9;end
end)</ProtectedString>
					</Properties>
				</Item>
				<Item class="Script" referent="RBX5459">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">wait(1)
fuel = script.Parent.Fuel
maxFuel = script.Parent.MaxFuel
carGui = script.Parent.Frame


function onChildAdded(child)
&#9;if child.className == &quot;Weld&quot; then
&#9;&#9;local char = child.Part1.Parent
&#9;&#9;if char.Name ~= &quot;Zombie&quot; and char.Name ~= &quot;Runner&quot; then
&#9;&#9;&#9;local player = game.Players:GetPlayerFromCharacter(child.Part1.Parent)
&#9;&#9;&#9;carGui.Parent = player.PlayerGui.ScreenGui
&#9;&#9;&#9;print(&quot;Character is Welded&quot;)
&#9;&#9;&#9;while true do
&#9;&#9;&#9;&#9;wait(3)
&#9;&#9;&#9;&#9;if fuel.Value &gt; 90 and fuel.Value &lt;= 100 then
&#9;&#9;&#9;&#9;&#9;print(&quot;Has Almost full Fuel&quot;)
&#9;&#9;&#9;&#9;&#9;script.Parent.MaxSpeed = 25
&#9;&#9;&#9;&#9;&#9;carGui.GasLeft.Size = UDim2.new(1, 0, (fuel.Value / maxFuel.Value)*-1, 0)
&#9;&#9;&#9;&#9;&#9;carGui.GasLeft.Text = &quot;Gas Left : &quot;..fuel.Value
&#9;&#9;&#9;&#9;&#9;if child.Parent == script.Parent then
&#9;&#9;&#9;&#9;&#9;&#9;fuel.Value = fuel.Value - 1
&#9;&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;&#9;return
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;elseif fuel.Value &gt; 80 and fuel.Value &lt;= 90 then
&#9;&#9;&#9;&#9;&#9;print(&quot;Still has Fuel&quot;)
&#9;&#9;&#9;&#9;&#9;script.Parent.MaxSpeed = 20
&#9;&#9;&#9;&#9;&#9;carGui.GasLeft.Size = UDim2.new(1, 0, (fuel.Value / maxFuel.Value)*-1, 0)
&#9;&#9;&#9;&#9;&#9;carGui.GasLeft.Text = &quot;Gas Left : &quot;..fuel.Value
&#9;&#9;&#9;&#9;&#9;if child.Parent == script.Parent then
&#9;&#9;&#9;&#9;&#9;&#9;fuel.Value = fuel.Value - 1
&#9;&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;&#9;return
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;elseif fuel.Value &gt; 60 and fuel.Value &lt;= 80 then
&#9;&#9;&#9;&#9;&#9;print(&quot;Still has Fuel&quot;)
&#9;&#9;&#9;&#9;&#9;script.Parent.MaxSpeed = 15
&#9;&#9;&#9;&#9;&#9;carGui.GasLeft.Size = UDim2.new(1, 0, (fuel.Value / maxFuel.Value)*-1, 0)
&#9;&#9;&#9;&#9;&#9;carGui.GasLeft.Text = &quot;Gas Left : &quot;..fuel.Value
&#9;&#9;&#9;&#9;&#9;if child.Parent == script.Parent then
&#9;&#9;&#9;&#9;&#9;&#9;fuel.Value = fuel.Value - 1
&#9;&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;&#9;return
&#9;&#9;&#9;&#9;&#9;end&#9;&#9;&#9;
&#9;&#9;&#9;&#9;elseif fuel.Value &gt; 40 and fuel.Value &lt;= 60 then
&#9;&#9;&#9;&#9;&#9;print(&quot;Still has Fuel&quot;)
&#9;&#9;&#9;&#9;&#9;script.Parent.MaxSpeed = 10
&#9;&#9;&#9;&#9;&#9;carGui.GasLeft.Size = UDim2.new(1, 0, (fuel.Value / maxFuel.Value)*-1, 0)
&#9;&#9;&#9;&#9;&#9;carGui.GasLeft.Text = &quot;Gas Left : &quot;..fuel.Value
&#9;&#9;&#9;&#9;&#9;if child.Parent == script.Parent then
&#9;&#9;&#9;&#9;&#9;&#9;fuel.Value = fuel.Value - 1
&#9;&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;&#9;return
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;elseif fuel.Value &gt; 20 and fuel.Value &lt;= 40 then
&#9;&#9;&#9;&#9;&#9;print(&quot;Still has Fuel&quot;)
&#9;&#9;&#9;&#9;&#9;carGui.GasLeft.Size = UDim2.new(1, 0, (fuel.Value / maxFuel.Value)*-1, 0)
&#9;&#9;&#9;&#9;&#9;carGui.GasLeft.Text = &quot;Gas Left : &quot;..fuel.Value
&#9;&#9;&#9;&#9;&#9;script.Parent.MaxSpeed = 5
&#9;&#9;&#9;&#9;&#9;if child.Parent == script.Parent then
&#9;&#9;&#9;&#9;&#9;&#9;fuel.Value = fuel.Value - 1
&#9;&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;&#9;return
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;elseif fuel.Value &gt; 0 and fuel.Value &lt;= 20 then
&#9;&#9;&#9;&#9;&#9;print(&quot;Little Fuel left&quot;)
&#9;&#9;&#9;&#9;&#9;script.Parent.MaxSpeed = 2.5
&#9;&#9;&#9;&#9;&#9;carGui.GasLeft.Size = UDim2.new(1, 0, (fuel.Value / maxFuel.Value)*-1, 0)
&#9;&#9;&#9;&#9;&#9;carGui.GasLeft.Text = &quot;Gas Left : &quot;..fuel.Value
&#9;&#9;&#9;&#9;&#9;if child.Parent == script.Parent then
&#9;&#9;&#9;&#9;&#9;&#9;fuel.Value = fuel.Value - 1
&#9;&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;&#9;return
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;elseif fuel.Value == 0 then
&#9;&#9;&#9;&#9;&#9;print(&quot;No Fuel left&quot;)
&#9;&#9;&#9;&#9;&#9;script.Parent.MaxSpeed = 0
&#9;&#9;&#9;&#9;&#9;carGui.GasLeft.Size = UDim2.new(1, 0, (fuel.Value / maxFuel.Value)*-1, 0)
&#9;&#9;&#9;&#9;&#9;carGui.GasLeft.Text = &quot;Gas Left : &quot;..fuel.Value
&#9;&#9;&#9;&#9;&#9;if child.Parent == script.Parent then
&#9;&#9;&#9;&#9;&#9;&#9;fuel.Value = fuel.Value - 0
&#9;&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;&#9;return
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end

function onChildRemoved(child)
&#9;if child.className == &quot;Weld&quot; then
&#9;&#9;carGui.Parent = script.Parent
&#9;end
end
script.Parent.ChildAdded:connect(onChildAdded)
script.Parent.ChildRemoved:connect(onChildRemoved)
</ProtectedString>
