				<Item class="Script" referent="RBX8053">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">BuildingsScript</string>
						<ProtectedString name="Source">local frame = script.Parent
local delete = frame.DeleteButton
local transfer = frame.TransferButton
local transferBox = frame.TransferBox
local alert = frame.AlertLabel
local retool = frame.RetoolButton
local selectButton = script.SelectButton

wait(1)

local player = frame.Parent.Parent.Parent

local current = nil

function removeButtons()
&#9;local buttons = frame:GetChildren()

&#9;for index, child in pairs(buttons) do
&#9;&#9;if child.Name == &quot;SelectButton&quot; then
&#9;&#9;&#9;child:remove()
&#9;&#9;end
&#9;end
end

function update()
&#9;removeButtons()

&#9;local buildings = player.Buildings:GetChildren()

&#9;local xMax = 0.75
&#9;local yMax = 0.95

&#9;local xStart = 0
&#9;local yStart = 0.15

&#9;local xStep = 0.25
&#9;local yStep = 0.075

&#9;local x = xStart
&#9;local y = yStart

&#9;for index, child in pairs(buildings) do
&#9;&#9;local newButton = selectButton:clone()

&#9;&#9;newButton.Text = child.Name
&#9;&#9;newButton.Position = UDim2.new(x, 0, y, 0)
&#9;&#9;newButton.MouseButton1Down:connect(function()
&#9;&#9;&#9;current = child
&#9;&#9;&#9;notify(child.Name..&quot; selected&quot;)
&#9;&#9;end)
&#9;&#9;newButton.Parent = frame

&#9;&#9;x = x + xStep

&#9;&#9;if x &gt; xMax then
&#9;&#9;&#9;x = xStart
&#9;&#9;&#9;y = y + yStep
&#9;&#9;end
&#9;end
end

function constantUpdate() delay(0, function()
&#9;while true do
&#9;&#9;wait(1)
&#9;&#9;update()
&#9;end
end)
end

function notify(text)
&#9;alert.Text = text
end

function onDelete()
&#9;if current ~= nil then
&#9;&#9;notify(current.Name..&quot; removed&quot;)
&#9;&#9;current.Value:remove()
&#9;&#9;current:remove()
&#9;&#9;current = nil

&#9;&#9;update()
&#9;else
&#9;&#9;notify(&quot;None selected&quot;)
&#9;end
end

function findPlayer(name)
&#9;local c = game.Players:GetChildren()

&#9;for index, child in pairs(c) do
&#9;&#9;if child.Name:lower() == name:lower() then
&#9;&#9;&#9;return child
&#9;&#9;end
&#9;end

&#9;return nil
end

function onTransfer()
&#9;if current ~= nil then
&#9;&#9;local playerName = transferBox.Text
&#9;&#9;local player = findPlayer(playerName)

&#9;&#9;if player ~= nil then
&#9;&#9;&#9;notify(current.Name..&quot; -&gt; &quot;..player.Name)

&#9;&#9;&#9;local building = current.Value
&#9;&#9;&#9;local bOwner = building.Owner
&#9;&#9;&#9;bOwner.Value = player

&#9;&#9;&#9;current.Parent = player.Buildings
&#9;&#9;&#9;current = nil

&#9;&#9;&#9;update()
&#9;&#9;else
&#9;&#9;&#9;notify(&quot;Player not found&quot;)
&#9;&#9;end
&#9;else
&#9;&#9;notify(&quot;None selected&quot;)
&#9;end
end

function onRetool()
&#9;if current ~= nil then
&#9;&#9;local tool = game.Lighting.Tools:findFirstChild(&quot;TEMPLATE&quot;):clone()
&#9;&#9;local bldg = game.Lighting.StructuresVehicles:findFirstChild(current.Name)

&#9;&#9;local cBldg = current.Value

&#9;&#9;local partsNeeded = #bldg:GetChildren()
&#9;&#9;local parts = #cBldg:GetChildren()

&#9;&#9;if parts == partsNeeded then
&#9;&#9;&#9;if tool ~= nil then
&#9;&#9;&#9;&#9;notify(current.Name..&quot; retooled&quot;)
&#9;&#9;&#9;&#9;tool.Name = bldg.Name
&#9;&#9;&#9;&#9;tool.Parent = player.Backpack

&#9;&#9;&#9;&#9;current.Value:remove()
&#9;&#9;&#9;&#9;current:remove()
&#9;&#9;&#9;&#9;current = nil

&#9;&#9;&#9;&#9;update()
&#9;&#9;&#9;end
&#9;&#9;else
