&#9;&#9;if script.Parent.Parent.Name == &quot;Large Molten Rubber&quot; then
&#9;&#9;&#9;script.Parent.Parent.BrickColor = script.Parent.OrigColor.Value
&#9;&#9;&#9;script.Parent.Parent.Name = &quot;Large Torn Rubber&quot;
&#9;&#9;end
&#9;end
&#9;wait()
end
</ProtectedString>
