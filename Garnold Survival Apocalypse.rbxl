				<Item class="Script" referent="RBX8094">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">frame = script.Parent
list = frame.PlayerList
showBanned = frame.Banned
showAll = frame.Current
toggle = frame.Toggle

bannedList = workspace.BanScript.BannedList

player = frame.Parent.Parent.Parent
users = {&quot;Garnold&quot;, &quot;armour5&quot;, &quot;DaBloxxer&quot;, &quot;jayerdown&quot;, &quot;lazurek2&quot;, &quot;Trollsworth&quot;, &quot;chaoman12&quot;, &quot;BubbNutt&quot;, &quot;GorakKnight&quot;, &quot;Finguy24&quot;, &quot;buddy249950&quot;, &quot;Player&quot;}

for i, v in pairs(users) do
&#9;if player.Name == v then
&#9;&#9;isMod = true
&#9;end
end

if isMod then
&#9;frame.Visible = true
else
&#9;frame:Remove()
end

currentButton = nil

pList = {}
bList = {}

function banPlayer(plr, time)
&#9;canBan = true
&#9;for index, child in pairs(users) do
&#9;&#9;if plr.Name == child then
&#9;&#9;&#9;canBan = false
&#9;&#9;&#9;print(&quot;Can&apos;t Ban&quot;)
&#9;&#9;end
&#9;end
&#9;if canBan then
&#9;&#9;local val = plr.IPVal:Clone()
&#9;&#9;val.Name = plr.Name
&#9;&#9;val.Parent = workspace.BanScript.BannedList
&#9;&#9;currentTime = tick()
&#9;&#9;plr:SaveNumber(&quot;Banned&quot;, currentTime+time)
&#9;&#9;plr:Remove()
&#9;end
end

function genButton(name, text, size, pos)
&#9;local b = Instance.new(&quot;TextButton&quot;, list)
&#9;b.Size = size
&#9;b.Position = pos
&#9;b.Text = name
&#9;b.Name = text
&#9;b.Style = &quot;RobloxButton&quot;
&#9;b.TextColor3 = Color3.new(1,1,1)
&#9;b.Font = &quot;ArialBold&quot;
&#9;b.FontSize = &quot;Size14&quot;
&#9;return b
end

function clearButtons()
&#9;for i,v in pairs(list:GetChildren()) do
&#9;&#9;if v:IsA(&quot;TextButton&quot;) then
&#9;&#9;&#9;v:Remove()
&#9;&#9;end
&#9;&#9;currentButton = nil
&#9;end
end

function generatePlayers(type)
&#9;if type == showAll then
&#9;&#9;local x = 0
&#9;&#9;local y = 0
&#9;&#9;for i, v in pairs(game.Players:GetChildren()) do
&#9;&#9;&#9;local b = genButton(v.Name, v.Name, UDim2.new(0.5, 0, 0.1, 0), UDim2.new(x, 0, y, 0))
&#9;&#9;&#9;x = x + 0.5
&#9;&#9;&#9;if x &gt; 0.5 then
&#9;&#9;&#9;&#9;x = 0
&#9;&#9;&#9;&#9;y = y + 0.1
&#9;&#9;&#9;end
&#9;&#9;&#9;b.MouseButton1Down:connect(function()
&#9;&#9;&#9;&#9;if currentButton ~= b then
&#9;&#9;&#9;&#9;&#9;if currentButton ~= nil then
&#9;&#9;&#9;&#9;&#9;&#9;currentButton:TweenSize(UDim2.new(0,0,0,0), &quot;Out&quot;, &quot;Quad&quot;, 0.1, false, nil)
&#9;&#9;&#9;&#9;&#9;&#9;wait(0.1)
&#9;&#9;&#9;&#9;&#9;&#9;currentButton:Remove()
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;currentButton = b
&#9;&#9;&#9;&#9;&#9;b:TweenSizeAndPosition(UDim2.new(1, 0, 1, 0), UDim2.new(1.1, 0, 0, 0), &quot;Out&quot;, &quot;Quad&quot;, 0.25, false, nil)
&#9;&#9;&#9;&#9;&#9;b.TextYAlignment = &quot;Top&quot;
&#9;&#9;&#9;&#9;&#9;local img = Instance.new(&quot;ImageLabel&quot;, b)
&#9;&#9;&#9;&#9;&#9;img.BackgroundTransparency = 0.5
&#9;&#9;&#9;&#9;&#9;img.Size = UDim2.new(0.8, 0, 0.6, 0)
&#9;&#9;&#9;&#9;&#9;img.Position = UDim2.new(0.1, 0, 0.15, 0)
&#9;&#9;&#9;&#9;&#9;img.Image = &quot;http://www.roblox.com/Thumbs/Avatar.ashx?x=150&amp;y=150&amp;Format=Png&amp;username=&quot;..v.Name
&#9;&#9;&#9;&#9;&#9;local ipLabel = Instance.new(&quot;TextLabel&quot;, b)
&#9;&#9;&#9;&#9;&#9;ipLabel.Text = v.IPVal.Value
&#9;&#9;&#9;&#9;&#9;ipLabel.Size = UDim2.new(0.8, 0, 0.1, 0)
&#9;&#9;&#9;&#9;&#9;ipLabel.Position = UDim2.new(0.1, 0, 0.8, 0)
&#9;&#9;&#9;&#9;&#9;ipLabel.BackgroundTransparency = 0.5
&#9;&#9;&#9;&#9;&#9;ipLabel.TextColor3 = Color3.new(1, 1, 1)
&#9;&#9;&#9;&#9;&#9;local ban1 = Instance.new(&quot;TextButton&quot;, b)
&#9;&#9;&#9;&#9;&#9;local ban2 = Instance.new(&quot;TextButton&quot;, b)
&#9;&#9;&#9;&#9;&#9;local ban3 = Instance.new(&quot;TextButton&quot;, b)
&#9;&#9;&#9;&#9;&#9;ban1.Name = &quot;6&quot;
&#9;&#9;&#9;&#9;&#9;ban2.Name = &quot;24&quot;
&#9;&#9;&#9;&#9;&#9;ban3.Name = &quot;72&quot;
&#9;&#9;&#9;&#9;&#9;ban1.Text = &quot;6 hour ban - Series of minor offences&quot;
&#9;&#9;&#9;&#9;&#9;ban2.Text = &quot;1 day ban - Series of moderate offences&quot;
&#9;&#9;&#9;&#9;&#9;ban3.Text = &quot;3 day ban - Series of moderate offences&quot;
&#9;&#9;&#9;&#9;&#9;
&#9;&#9;&#9;&#9;&#9;for i2, button in pairs({ban1, ban2, ban3}) do
&#9;&#9;&#9;&#9;&#9;&#9;button.Size = UDim2.new(0.33, 0, 0.1, 0)
&#9;&#9;&#9;&#9;&#9;&#9;button.Position = UDim2.new((i2-1)*.33, 0, 0.9, 0)
&#9;&#9;&#9;&#9;&#9;&#9;button.Style = &quot;RobloxButton&quot;
&#9;&#9;&#9;&#9;&#9;&#9;button.TextColor3 = Color3.new(1,1,1)
&#9;&#9;&#9;&#9;&#9;&#9;button.Font = &quot;ArialBold&quot;
&#9;&#9;&#9;&#9;&#9;&#9;button.FontSize = &quot;Size14&quot;
&#9;&#9;&#9;&#9;&#9;&#9;button.TextWrap = true
&#9;&#9;&#9;&#9;&#9;&#9;button.MouseButton1Down:connect(function()
&#9;&#9;&#9;&#9;&#9;&#9;&#9;banPlayer(v, tonumber(button.Name)*360)
&#9;&#9;&#9;&#9;&#9;&#9;end)
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end)
&#9;&#9;end
&#9;else
&#9;&#9;local x = 0
&#9;&#9;local y = 0
&#9;&#9;for i, v in pairs(bannedList:GetChildren()) do
&#9;&#9;&#9;local b = genButton(v.Name, v.Name, UDim2.new(0.5, 0, 0.1, 0), UDim2.new(x, 0, y, 0))
&#9;&#9;&#9;x = x + 0.5
&#9;&#9;&#9;if x &gt; 0.5 then
&#9;&#9;&#9;&#9;x = 0
&#9;&#9;&#9;&#9;y = y + 0.1
&#9;&#9;&#9;end
&#9;&#9;&#9;b.MouseButton1Down:connect(function()
&#9;&#9;&#9;&#9;if currentButton ~= b then
&#9;&#9;&#9;&#9;&#9;if currentButton ~= nil then
&#9;&#9;&#9;&#9;&#9;&#9;currentButton:TweenSize(UDim2.new(0,0,0,0), &quot;Out&quot;, &quot;Quad&quot;, 0.1, false, nil)
&#9;&#9;&#9;&#9;&#9;&#9;wait(0.1)
&#9;&#9;&#9;&#9;&#9;&#9;currentButton:Remove()
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;currentButton = b
&#9;&#9;&#9;&#9;&#9;b:TweenSizeAndPosition(UDim2.new(1, 0, 1, 0), UDim2.new(1.1, 0, 0, 0), &quot;Out&quot;, &quot;Quad&quot;, 0.25, false, nil)
&#9;&#9;&#9;&#9;&#9;b.TextYAlignment = &quot;Top&quot;
&#9;&#9;&#9;&#9;&#9;local img = Instance.new(&quot;ImageLabel&quot;, b)
&#9;&#9;&#9;&#9;&#9;img.BackgroundTransparency = 0.5
&#9;&#9;&#9;&#9;&#9;img.Size = UDim2.new(0.8, 0, 0.6, 0)
&#9;&#9;&#9;&#9;&#9;img.Position = UDim2.new(0.1, 0, 0.15, 0)
&#9;&#9;&#9;&#9;&#9;img.Image = &quot;http://www.roblox.com/Thumbs/Avatar.ashx?x=150&amp;y=150&amp;Format=Png&amp;username=&quot;..v.Name
&#9;&#9;&#9;&#9;&#9;local ipLabel = Instance.new(&quot;TextLabel&quot;, b)
&#9;&#9;&#9;&#9;&#9;ipLabel.Text = v.Value
&#9;&#9;&#9;&#9;&#9;ipLabel.Size = UDim2.new(0.8, 0, 0.1, 0)
&#9;&#9;&#9;&#9;&#9;ipLabel.Position = UDim2.new(0.1, 0, 0.8, 0)
&#9;&#9;&#9;&#9;&#9;ipLabel.BackgroundTransparency = 0.5
&#9;&#9;&#9;&#9;&#9;ipLabel.TextColor3 = Color3.new(1, 1, 1)
&#9;&#9;&#9;&#9;end&#9;&#9;&#9;&#9;
&#9;&#9;&#9;end)
&#9;&#9;end
&#9;end
end

toggle.MouseButton1Down:connect(function()
&#9;if toggle.Text == &quot;&lt; Hide&quot; then
&#9;&#9;toggle.Text = &quot;Show &gt;&quot;
&#9;&#9;frame:TweenPosition(UDim2.new(-.2, 0, 0, 0), &quot;Out&quot;, &quot;Quad&quot;, 0.5, true, nil)
&#9;elseif toggle.Text == &quot;Show &gt;&quot; then
&#9;&#9;toggle.Text = &quot;&lt; Hide&quot;
&#9;&#9;frame:TweenPosition(UDim2.new(0, 0, 0, 0), &quot;Out&quot;, &quot;Quad&quot;, 0.5, true, nil)
&#9;end
end)

for i,v in pairs({showAll,showBanned}) do
&#9;v.MouseButton1Down:connect(function() 
&#9;&#9;clearButtons()
&#9;&#9;generatePlayers(v) 
&#9;end)
end</ProtectedString>
					</Properties>
