				<Item class="LocalScript" referent="RBX9165">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">LocalScript</string>
						<ProtectedString name="Source">wait(0.25)
local tool = script.Parent
local on = tool.Name
local handle = tool.Handle

local headDamage = 2
local torsoDamage = 1
local armsDamage = 0.5
local legsDamage = 0.75
local damage = 0
local reloadTime = 1.75
local range = 10
local debounce = true

local frame = tool.Frame
local drinksLeft = 10
local maxDrinks = 10
local drinkLabel = frame.DrinksLeft
local drinkBar = frame.WaterBar

function slash()
&#9;local s = Instance.new(&quot;StringValue&quot;)
&#9;s.Name = &quot;toolanim&quot;
&#9;s.Value = &quot;Slash&quot;
&#9;s.Parent = tool
end

function setGUI()
&#9;drinkBar.Size = UDim2.new(drinksLeft / maxDrinks, 0, 1, 0)
&#9;drinkLabel.Text = &quot;Gas Left: &quot;..drinksLeft
end

function onButton1Down(mouse)
&#9;if debounce == true then

&#9;&#9;slash()

&#9;&#9;local target = mouse.Target
&#9;&#9;local pos = mouse.hit.p

&#9;&#9;if target ~= nil then

&#9;&#9;&#9;if target.Parent ~= nil then

&#9;&#9;&#9;&#9;if (handle.Position - pos).magnitude &lt; range then

&#9;&#9;&#9;&#9;&#9;--extra stuff goes here

&#9;&#9;&#9;&#9;&#9;--Get drinks

&#9;&#9;&#9;&#9;&#9;if target.Name == &quot;Gasoline&quot; then
&#9;&#9;&#9;&#9;&#9;&#9;drinksLeft = maxDrinks
&#9;&#9;&#9;&#9;&#9;&#9;target:Remove()
&#9;&#9;&#9;&#9;&#9;elseif target.Parent.Name == &quot;Car&quot; or target.Parent.Name == &quot;Makeshift Vehicle&quot; or target.Parent.Name == &quot;Motorized Boat&quot;then
&#9;&#9;&#9;&#9;&#9;&#9;if drinksLeft &gt;= 5 then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;fuel = target.Parent.VehicleSeat:findFirstChild(&quot;Fuel&quot;)
&#9;&#9;&#9;&#9;&#9;&#9;&#9;mFuel = target.Parent.VehicleSeat:findFirstChild(&quot;MaxFuel&quot;)
&#9;&#9;&#9;&#9;&#9;&#9;&#9;fuel.Value = mFuel.Value
&#9;&#9;&#9;&#9;&#9;&#9;&#9;drinksLeft = drinksLeft - 5
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;elseif target.Parent.Name == &quot;Truck&quot; then
&#9;&#9;&#9;&#9;&#9;&#9;if drinksLeft == 10 then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;fuel = target.Parent.VehicleSeat:findFirstChild(&quot;Fuel&quot;)
&#9;&#9;&#9;&#9;&#9;&#9;&#9;mFuel = target.Parent.VehicleSeat:findFirstChild(&quot;MaxFuel&quot;)
&#9;&#9;&#9;&#9;&#9;&#9;&#9;fuel.Value = mFuel.Value
&#9;&#9;&#9;&#9;&#9;&#9;&#9;drinksLeft = drinksLeft - 10
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;setGUI()

&#9;&#9;&#9;&#9;end

&#9;&#9;&#9;end

&#9;&#9;end

&#9;&#9;tool.Name = &quot;Resting&quot;

&#9;&#9;debounce = false

&#9;&#9;wait(reloadTime)

&#9;&#9;tool.Name = on

&#9;&#9;debounce = true

&#9;end
end

function onEquipped(mouse)
&#9;mouse.Button1Down:connect(function() onButton1Down(mouse) end)

&#9;local player = game.Players:GetPlayerFromCharacter(tool.Parent)
&#9;frame.Parent = player.PlayerGui.ScreenGui

&#9;setGUI()
end

function onUnequipped()
&#9;frame.Parent = tool
end

tool.Equipped:connect(onEquipped)
tool.Unequipped:connect(onUnequipped)
