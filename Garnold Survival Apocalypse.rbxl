&#9;&#9;&#9;&#9;&#9;print(&quot;Still has Fuel&quot;)
&#9;&#9;&#9;&#9;&#9;carGui.GasLeft.Size = UDim2.new(1, 0, (fuel.Value / maxFuel.Value)*-1, 0)
&#9;&#9;&#9;&#9;&#9;carGui.GasLeft.Text = &quot;Gas Left : &quot;..fuel.Value
&#9;&#9;&#9;&#9;&#9;script.Parent.MaxSpeed = 5
&#9;&#9;&#9;&#9;&#9;if child.Parent == script.Parent then
&#9;&#9;&#9;&#9;&#9;&#9;fuel.Value = fuel.Value - 1
&#9;&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;&#9;return
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;elseif fuel.Value &gt; 0 and fuel.Value &lt;= 20 then
&#9;&#9;&#9;&#9;&#9;print(&quot;Little Fuel left&quot;)
&#9;&#9;&#9;&#9;&#9;script.Parent.MaxSpeed = 2.5
&#9;&#9;&#9;&#9;&#9;carGui.GasLeft.Size = UDim2.new(1, 0, (fuel.Value / maxFuel.Value)*-1, 0)
&#9;&#9;&#9;&#9;&#9;carGui.GasLeft.Text = &quot;Gas Left : &quot;..fuel.Value
&#9;&#9;&#9;&#9;&#9;if child.Parent == script.Parent then
&#9;&#9;&#9;&#9;&#9;&#9;fuel.Value = fuel.Value - 1
&#9;&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;&#9;return
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;elseif fuel.Value == 0 then
&#9;&#9;&#9;&#9;&#9;print(&quot;No Fuel left&quot;)
