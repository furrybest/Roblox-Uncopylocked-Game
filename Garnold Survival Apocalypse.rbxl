				<Item class="HopperBin" referent="RBX11442">
					<Properties>
						<bool name="Active">false</bool>
						<token name="BinType">0</token>
						<string name="Name">Forge</string>
						<Content name="TextureId"><null></null></Content>
					</Properties>
					<Item class="Script" referent="RBX11443">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script</string>
							<ProtectedString name="Source">local tool = script.Parent
local connection = game.Lighting.StructuresVehicles:findFirstChild(tool.Name):clone()
local canPlace = false
local example = connection:clone()

function getAll(model, tab)
&#9;local c = model:GetChildren()

&#9;for index, child in pairs(c) do
&#9;&#9;if child:IsA(&quot;BasePart&quot;)then
&#9;&#9;&#9;table.insert(tab, child)
&#9;&#9;elseif child.className == &quot;Model&quot; then
&#9;&#9;&#9;getAll(child, tab)
&#9;&#9;end
&#9;end
end

function colorModel(model, color)&#9;
&#9;for index, child in pairs(model:GetChildren()) do
&#9;&#9;if child:IsA(&quot;BasePart&quot;) then
&#9;&#9;&#9;child.BrickColor = BrickColor.new(color)
&#9;&#9;end
&#9;end
end

function getCenter(model)
&#9;local c = {}

&#9;getAll(model, c)

&#9;local num = 0
&#9;local avg = Vector3.new(0, 0, 0)

&#9;for index, child in pairs(c) do
&#9;&#9;avg = avg + child.Position
&#9;&#9;num = num + 1
&#9;end

&#9;avg = avg / num

&#9;return avg
end

function rotate(model)
&#9;local c = {}

&#9;getAll(model, c)

&#9;local center = getCenter(model)

&#9;local rotation_frame = CFrame.fromAxisAngle(Vector3.new(0, 1, 0), math.pi/2)

&#9;local temp = Instance.new(&quot;Part&quot;)
&#9;temp.Anchored = true
&#9;temp.CanCollide = false
&#9;temp.Transparency = 1
&#9;temp.CFrame = CFrame.new(center)

&#9;for index, child in pairs(c) do
&#9;&#9;child.CFrame = rotation_frame * temp.CFrame * (temp.CFrame:inverse() * child.CFrame)
&#9;end

&#9;model:MoveTo(center)
end

function isPart(c)
&#9;if c:IsA(&quot;BasePart&quot;) then
&#9;&#9;return true
&#9;end
end

function makeExample(model)
&#9;c = {}

&#9;getAll(model, c)

&#9;for index, child in pairs(c) do
&#9;&#9;if isPart(child) == true then
&#9;&#9;&#9;child.Transparency = 0.5
&#9;&#9;&#9;child.Anchored = true
&#9;&#9;else
&#9;&#9;&#9;child:remove()
&#9;&#9;end
&#9;end
end

function addOwned(player, connection)
&#9;local value = Instance.new(&quot;ObjectValue&quot;)
&#9;value.Name = connection.Name
&#9;value.Value = connection
&#9;value.Parent = player.Buildings
end

makeExample(example)

function onMouseMove(mouse)
&#9;local player = tool.Parent.Parent
&#9;local char = player.Character
&#9;example.Parent = char
&#9;example:MoveTo(mouse.hit.p)
&#9;if mouse.Target ~= nil then
&#9;&#9;if connection:findFirstChild(&quot;Water&quot;) == nil then
&#9;&#9;&#9;if mouse.Target.Name ~= &quot;Ocean&quot; then
&#9;&#9;&#9;&#9;if string.find(connection.Name, &quot;Wall&quot;) ~= nil or string.find(connection.Name, &quot;Gate&quot;) ~= nil then
&#9;&#9;&#9;&#9;&#9;local region = Region3.new(Vector3.new(mouse.Hit.p.x - 30, mouse.Hit.p.y + 1, mouse.Hit.p.z - 30), Vector3.new(mouse.Hit.p.x + 30, mouse.Hit.p.y + 10, mouse.Hit.p.z + 30))
&#9;&#9;&#9;&#9;&#9;print(region.Size)
&#9;&#9;&#9;&#9;&#9;local partsInArea = workspace:FindPartsInRegion3(region, nil)
&#9;&#9;&#9;&#9;&#9;canPlace = true
&#9;&#9;&#9;&#9;&#9;for index, part in pairs(partsInArea) do
&#9;&#9;&#9;&#9;&#9;&#9;if string.find(part:GetFullName(), &quot;Gun shop&quot;) ~= nil then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;canPlace = false
&#9;&#9;&#9;&#9;&#9;&#9;&#9;break
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;if canPlace then
&#9;&#9;&#9;&#9;&#9;&#9;colorModel(example, &quot;Bright green&quot;)
&#9;&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;&#9;colorModel(example, &quot;Bright red&quot;)
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;colorModel(example, &quot;Bright green&quot;)
&#9;&#9;&#9;&#9;&#9;canPlace = true
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;colorModel(example, &quot;Bright red&quot;)
&#9;&#9;&#9;&#9;canPlace = false
&#9;&#9;&#9;end
&#9;&#9;else
&#9;&#9;&#9;if mouse.Target.Name == &quot;Ocean&quot; then
&#9;&#9;&#9;&#9;colorModel(example, &quot;Bright green&quot;)
&#9;&#9;&#9;&#9;canPlace = true
&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;colorModel(example, &quot;Bright red&quot;)
&#9;&#9;&#9;&#9;canPlace = false
&#9;&#9;&#9;end
&#9;&#9;end&#9;
&#9;end
end

function onButton1Down(mouse)
&#9;if canPlace == true then
&#9;&#9;example:remove()

&#9;&#9;connection.Parent = game.Workspace
&#9;&#9;connection:MoveTo(mouse.hit.p)
&#9;&#9;connection:MakeJoints()
&#9;&#9;connection.Owner.Value = tool.Parent.Parent
&#9;&#9;
&#9;&#9;addOwned(tool.Parent.Parent, connection)
&#9;&#9;
&#9;&#9;wait()
&#9;&#9;
&#9;&#9;tool:remove()
&#9;end
end

function onKeyDown(key)
&#9;if key == &quot;r&quot; then
&#9;&#9;rotate(example)
&#9;&#9;rotate(connection)
&#9;end
end

function onSelected(mouse)
&#9;mouse.Button1Down:connect(function() onButton1Down(mouse) end)
&#9;mouse.Move:connect(function() onMouseMove(mouse) end)
&#9;mouse.KeyDown:connect(onKeyDown)
end

function onDeselected()
&#9;example.Parent = nil
end

tool.Selected:connect(onSelected)
tool.Deselected:connect(onDeselected)
