							<string name="Name">Script</string>
							<ProtectedString name="Source">local item = &quot;Flour&quot;
local part = script.Parent

function onTouched(hit)
&#9;if hit.Name == &quot;Wheat Bundle&quot; then
&#9;&#9;local replace = game.Lighting.Items:findFirstChild(item):clone()
&#9;&#9;replace.CFrame = hit.CFrame
&#9;&#9;replace.Parent = game.Workspace

&#9;&#9;hit:remove()
&#9;end
end

part.Touched:connect(onTouched)</ProtectedString>
