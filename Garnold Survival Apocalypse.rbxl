									<ProtectedString name="Source">while true do 
&#9;if script.Parent.Parent.Name == &quot;Large Molten Rubber&quot; then
&#9;&#9;script.Parent.Parent.Locked = false
&#9;&#9;script.Parent.Parent.Shape = 1
