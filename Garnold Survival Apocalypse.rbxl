				<Item class="IntValue" referent="RBX8997">
					<Properties>
						<string name="Name">MaxAccuracy</string>
						<int name="Value">70</int>
					</Properties>
				</Item>
				<Item class="LocalScript" referent="RBX8998">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">FireLocal</string>
						<ProtectedString name="Source">wait(1)
tool = script.Parent
origName = tool.Name
frame = tool.AmmoFrame

ammo = tool.Ammo
clip = ammo.Clip
gunVal = tool.Gun
firingRate = tool.FiringRate

accuracy = tool.Accuracy
maxAccuracy = tool.MaxAccuracy
minimumAcc = accuracy.Value - 50

sprinting = false
bIsDown = false
db = true

function updateGui()
&#9;frame.Label.Text = clip.Value..&quot;/&quot;..ammo.Value
end

function reload()
&#9;if ammo.Value &gt;= gunVal.Value then
&#9;&#9;tool.IsShooting.Value = false
&#9;&#9;tool.Name = &quot;Reloading...&quot;
&#9;&#9;wait(5)
&#9;&#9;clip.Value = gunVal.Value
&#9;&#9;ammo.Value = ammo.Value - gunVal.Value
&#9;&#9;tool.Name = origName
&#9;&#9;tool.IsShooting.Value = false
&#9;end
end

function shoot(v)

&#9;if clip.Value &gt; 0 then
&#9;&#9;tool.Handle.Fire:play()
&#9;&#9;local char = tool.Parent
&#9;&#9;local player = game.Players:GetPlayerFromCharacter(char)
&#9;&#9;local missile = game.Lighting.Objects.Bullet:Clone()
&#9;&#9;local aP = 100/tool.Accuracy.Value
&#9;&#9;local spawnPos = tool.Barrel.Position + (v*4)
&#9;&#9;local bv = Instance.new(&quot;BodyVelocity&quot;, missile)

&#9;&#9;missile.Position = spawnPos
&#9;&#9;bv.velocity = v * 550 + Vector3.new(math.random(-5 * aP, 5 * aP),math.random(-(5 * aP), (5 * aP)),math.random(-(5 * aP), (5 * aP)))
&#9;&#9;missile.BrickColor = BrickColor.new(&quot;Bright yellow&quot;)
&#9;&#9;missile.BottomSurface = 0
&#9;&#9;missile.TopSurface = 0
&#9;&#9;missile.Elasticity = 0
&#9;&#9;missile.Reflectance = 0.15
&#9;&#9;missile.Friction = 1
&#9;&#9;local force = Instance.new(&quot;BodyForce&quot;)

&#9;&#9;force.force = Vector3.new(0, 5, 0)
&#9;&#9;force.Parent = missile
&#9;&#9;missile.Damage.Value = tool.Damage.Value
&#9;&#9;local creatorTag = missile.Killer

&#9;&#9;creatorTag.Value = player
&#9;&#9;missile.Parent = game.Workspace
&#9;&#9;recoil()
&#9;else
&#9;&#9;reload()
&#9;end
end


function recoil()
&#9;tool.GripForward = tool.GripForward - Vector3.new(0, 0.05, 0)
&#9;wait(.001)
&#9;tool.GripForward = tool.GripForward + Vector3.new(0, 0.05, 0)
end



function onButton1Down(mouse)

&#9;local char = tool.Parent

&#9;bIsDown = true
&#9;if tool.ClassType.Value == &quot;Automatic&quot; then
&#9;&#9;while true do
&#9;&#9;&#9;local targetPos = char.Humanoid.TargetPoint
&#9;&#9;&#9;local lookAt = (targetPos - char.Head.Position).unit
&#9;&#9;&#9;if bIsDown == true then
&#9;&#9;&#9;&#9;if tool.Parent.Name ~= &quot;Backpack&quot; then
&#9;&#9;&#9;&#9;&#9;if db == true then
&#9;&#9;&#9;&#9;&#9;&#9;db = false
&#9;&#9;&#9;&#9;&#9;&#9;tool.IsShooting.Value = true
&#9;&#9;&#9;&#9;&#9;&#9;shoot(lookAt)
&#9;&#9;&#9;&#9;&#9;&#9;if clip.Value &gt; 0 then&#9;
&#9;&#9;&#9;&#9;&#9;&#9;&#9;clip.Value = clip.Value - 1
&#9;&#9;&#9;&#9;&#9;&#9;&#9;if tool.Accuracy.Value &gt; minimumAcc then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;tool.Accuracy.Value = tool.Accuracy.Value - tool.Kickback.Value
&#9;&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;updateGui()
&#9;&#9;&#9;&#9;&#9;&#9;mouse.Button1Up:connect(function() bIsDown = false end)
&#9;&#9;&#9;&#9;&#9;&#9;db = true
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;tool.IsShooting.Value = false
&#9;&#9;&#9;&#9;break
&#9;&#9;&#9;end
&#9;&#9;&#9;wait(firingRate.Value)
&#9;&#9;end
&#9;elseif tool.ClassType.Value == &quot;Sniper&quot; then
&#9;&#9;local targetPos = char.Humanoid.TargetPoint
&#9;&#9;local lookAt = (targetPos - char.Head.Position).unit
&#9;&#9;if db == true then
&#9;&#9;&#9;db = false
&#9;&#9;&#9;shoot(lookAt)
&#9;&#9;&#9;if clip.Value &gt; 0 then&#9;
&#9;&#9;&#9;&#9;clip.Value = clip.Value - 1
&#9;&#9;&#9;&#9;if tool.Accuracy.Value &gt; minimumAcc then
&#9;&#9;&#9;&#9;&#9;tool.Accuracy.Value = tool.Accuracy.Value - tool.Kickback.Value
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;&#9;updateGui()
&#9;&#9;&#9;wait(firingRate.Value)
&#9;&#9;&#9;db = true
&#9;&#9;end
&#9;elseif tool.ClassType.Value == &quot;Shotgun&quot; then
&#9;&#9;local targetPos = char.Humanoid.TargetPoint
&#9;&#9;local lookAt = (targetPos - char.Head.Position).unit
&#9;&#9;if db == true then
&#9;&#9;&#9;db = false
&#9;&#9;&#9;for x = 1, math.random(6, 10) do
&#9;&#9;&#9;&#9;shoot(lookAt)
&#9;&#9;&#9;end
&#9;&#9;&#9;if clip.Value &gt; 0 then&#9;
&#9;&#9;&#9;&#9;clip.Value = clip.Value - 1
&#9;&#9;&#9;&#9;if tool.Accuracy.Value &gt; minimumAcc then
&#9;&#9;&#9;&#9;&#9;tool.Accuracy.Value = tool.Accuracy.Value - tool.Kickback.Value
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;&#9;updateGui()
&#9;&#9;&#9;wait(firingRate.Value)
&#9;&#9;&#9;db = true
&#9;&#9;end
&#9;end
end

function onKeyDown(key)
&#9;local player = game.Players.LocalPlayer
&#9;if key == &quot;e&quot; then
&#9;&#9;if sprinting == false then
&#9;&#9;&#9;sprinting = true
&#9;&#9;&#9;maxAccuracy.Value = maxAccuracy.Value - 15
&#9;&#9;&#9;player.Character.Humanoid.WalkSpeed = 20
&#9;&#9;end
&#9;end
end

function onKeyUp(key)
&#9;local player = game.Players.LocalPlayer
&#9;if key == &quot;e&quot; then
&#9;&#9;if sprinting == true then
&#9;&#9;&#9;sprinting = false
&#9;&#9;&#9;maxAccuracy.Value = maxAccuracy.Value + 15
&#9;&#9;&#9;player.Character.Humanoid.WalkSpeed = 16
&#9;&#9;end
&#9;end
end

function onEquipped(mouse)
&#9;local player = game.Players.LocalPlayer
&#9;tool.GripRight = Vector3.new(-0.218, 0, -0.848)
&#9;updateGui()
&#9;frame.Parent = player.PlayerGui.ScreenGui
&#9;mouse.Button1Down:connect(function() onButton1Down(mouse) end)
&#9;mouse.KeyDown:connect(onKeyDown)
&#9;mouse.KeyUp:connect(onKeyUp)
end

function onUnequipped()
&#9;frame.Parent = tool
end

tool.Equipped:connect(onEquipped)
tool.Unequipped:connect(onUnequipped)
clip.Changed:connect(updateGui)</ProtectedString>
