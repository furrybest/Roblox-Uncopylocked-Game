				<Item class="LocalScript" referent="RBX9235">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Charge</string>
						<ProtectedString name="Source">local tool = script.Parent
local frame = tool.Frame
local charging = tool.Charging
local charge = tool.Charge
local chargeFrame = frame.Charge
local stopButton = chargeFrame.Stop
local player = game.Players.LocalPlayer

started = false
oldWalkSpeed = nil

function stopCharging()
&#9;if player ~= nil then
&#9;&#9;charging.Value = false
&#9;&#9;stopButton.Visible = false
&#9;&#9;player.Character.Humanoid.WalkSpeed = oldWalkSpeed
&#9;end
end

function onEquipped(mouse)

&#9;mouse.Button1Down:connect(function()
&#9;&#9;print(&quot;FUNCTION RECEIVED&quot;)
&#9;&#9;local target = mouse.Target
&#9;&#9;if target ~= nil then
&#9;&#9;&#9;print(&quot;TARGET EXISTS&quot;)
&#9;&#9;&#9;if (mouse.hit.p - tool.Handle.Position).magnitude &lt;= 3 then
&#9;&#9;&#9;&#9;print(&quot;TARGET IS CLOSE ENOUGH&quot;)
&#9;&#9;&#9;&#9;if target.Name == &quot;Battery&quot;  then
&#9;&#9;&#9;&#9;&#9;print(&quot;TARGET IS A BATTERY&quot;)
&#9;&#9;&#9;&#9;&#9;print(charging)
&#9;&#9;&#9;&#9;&#9;charging.Value = true
&#9;&#9;&#9;&#9;&#9;stopButton.Visible = true
&#9;&#9;&#9;&#9;&#9;oldWalkSpeed = player.Character.Humanoid.WalkSpeed
&#9;&#9;&#9;&#9;&#9;player.Character.Humanoid.WalkSpeed = 0
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end&#9;&#9;
&#9;end)

&#9;stopButton.MouseButton1Down:connect(function() stopCharging() end)

&#9;if started == false then
&#9;&#9;started = true

&#9;&#9;while true do
&#9;&#9;&#9;if charging.Value == false then
&#9;&#9;&#9;&#9;if charge.Value &gt; 0 then
&#9;&#9;&#9;&#9;&#9;charge.Value = charge.Value - 1
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;if charge.Value &lt; 100 then
&#9;&#9;&#9;&#9;&#9;charge.Value = charge.Value + 3
&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;charge.Value = 100
&#9;&#9;&#9;&#9;&#9;stopCharging()
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;&#9;chargeFrame.Frame.Size = UDim2.new(1, 0, -charge.Value/100, 0)
&#9;&#9;&#9;chargeFrame.Text.Text = &quot;Charge Left: &quot;..charge.Value
&#9;&#9;&#9;wait(2)
&#9;&#9;end
&#9;end
end

tool.Equipped:connect(onEquipped)</ProtectedString>
