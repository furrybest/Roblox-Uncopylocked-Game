&#9;&#9;local pos = mouse.hit.p

&#9;&#9;if target ~= nil then

&#9;&#9;&#9;if target.Parent ~= nil then

&#9;&#9;&#9;&#9;if (handle.Position - target.Position).magnitude &lt; range then

&#9;&#9;&#9;&#9;&#9;local h = target.Parent:findFirstChild(&quot;Humanoid&quot;)

&#9;&#9;&#9;&#9;&#9;if h ~= nil then
&#9;&#9;&#9;&#9;&#9;&#9;local currentDamage = damage
&#9;&#9;&#9;&#9;&#9;&#9;if state == &quot;On&quot; then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;currentDamage = damage*4
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;if h.Health &gt; 0 then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;if target.Name == &quot;Head&quot; then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;h:TakeDamage(headDamage * currentDamage)
&#9;&#9;&#9;&#9;&#9;&#9;&#9;end

&#9;&#9;&#9;&#9;&#9;&#9;&#9;if target.Name == &quot;Torso&quot; then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;h:TakeDamage(torsoDamage * currentDamage)
&#9;&#9;&#9;&#9;&#9;&#9;&#9;end

&#9;&#9;&#9;&#9;&#9;&#9;&#9;if target.Name == &quot;Left Arm&quot; or target.Name == &quot;Right Arm&quot; then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;h:TakeDamage(armsDamage * currentDamage)
&#9;&#9;&#9;&#9;&#9;&#9;&#9;end

&#9;&#9;&#9;&#9;&#9;&#9;&#9;if target.Name == &quot;Left Leg&quot; or target.Name == &quot;Right Leg&quot; then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;h:TakeDamage(armsDamage * currentDamage)
&#9;&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;&#9;if h.Health == 0 then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;plr = game.Players:GetPlayerFromCharacter(target.Parent)
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;if plr == nil then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;local stat = player.Stats:findFirstChild(&quot;ZKills&quot;)
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;if stat ~= nil then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;stat.Value = stat.Value + 1
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;end

&#9;&#9;&#9;&#9;&#9;--extra stuff goes here
&#9;&#9;&#9;&#9;&#9;if state == &quot;On&quot; then
&#9;&#9;&#9;&#9;&#9;&#9;local fireScript = workspace.FireScript
&#9;&#9;&#9;&#9;&#9;&#9;if target:findFirstChild(&quot;Flammable&quot;) ~= nil then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;if math.random(1, quality) == 1 then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;local sc = fireScript:clone()
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;sc.Disabled = false
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;sc.Parent = target
&#9;&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;&#9;if target:findFirstChild(&quot;Fire&quot;) ~= nil then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;local fire = Instance.new(&quot;Fire&quot;, tool.Handle)
&#9;&#9;&#9;&#9;&#9;&#9;&#9;state = &quot;On&quot;
&#9;&#9;&#9;&#9;&#9;&#9;&#9;timeLeft.Value = 300
&#9;&#9;&#9;&#9;&#9;&#9;&#9;tool.Handle.Light.Value = 5
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end

&#9;&#9;&#9;end

&#9;&#9;end

&#9;&#9;tool.Name = &quot;Resting&quot;

&#9;&#9;debounce = false

&#9;&#9;wait(reloadTime)

&#9;&#9;tool.Name = on

&#9;&#9;debounce = true

&#9;end
end

function onEquipped(mouse)
&#9;if timeLeft.Value == 0 then
&#9;&#9;state = &quot;Off&quot;
&#9;end
&#9;mouse.Button1Down:connect(function() onButton1Down(mouse) end)
end

tool.Equipped:connect(onEquipped)

timeLeft.Changed:connect(function()
&#9;if timeLeft.Value &lt; 1 then
&#9;&#9;state = &quot;Off&quot;
&#9;end
end)</ProtectedString>
