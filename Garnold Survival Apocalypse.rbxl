				<Item class="LocalScript" referent="RBX9162">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">LocalScript</string>
						<ProtectedString name="Source">local tool = script.Parent
local frame = tool.WiringFrame
local label = frame.Label
local player = game.Players.LocalPlayer

target1 = nil
target2 = nil

local mode = 0 -- 1 = The Source, 2 = Battery

function onButton1Down(mouse)
&#9;target1 = nil
&#9;target2 = nil

&#9;local target = mouse.Target
&#9;local char = player.Character
&#9;
&#9;if target ~= nil then
&#9;&#9;if (target.Position - char.Head.Position).magnitude &lt; 10 then
&#9;&#9;&#9;if target:findFirstChild(&quot;Electrical&quot;) ~= nil then
&#9;&#9;&#9;&#9;if target.Locked == false then
&#9;&#9;&#9;&#9;&#9;mode = 2
&#9;&#9;&#9;&#9;&#9;target1 = target
&#9;&#9;&#9;&#9;&#9;label.Text = target.Name..&quot; Charge &quot;..target.ChargeLeft.Value..&quot; has been selected as the first item. Connect to a Power User&quot;
&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;label.Text = &quot;This battery is already in use.&quot;
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;elseif target.Name == &quot;Power Box&quot; then
&#9;&#9;&#9;&#9;mode = 1
&#9;&#9;&#9;&#9;target1 = target
&#9;&#9;&#9;&#9;label.Text = target.Name..&quot; has been selected as the first item. Connect to a Battery.&quot;
&#9;&#9;&#9;else 
&#9;&#9;&#9;&#9;label.Text = &quot;The Object you clicked on has no Electical Charge...&quot;
&#9;&#9;&#9;end
&#9;&#9;else 
&#9;&#9;&#9;label.Text = &quot;The Object is too far away, get closer...&quot;
&#9;&#9;end&#9;
&#9;else 
&#9;&#9;label.Text = &quot;Click on an actual object...&quot;
&#9;end
end

function onButton1Up(mouse)
&#9;local target = mouse.Target
&#9;local char = player.Character

&#9;if target ~= nil then
&#9;&#9;if (target.Position - char.Head.Position).magnitude &lt; 10 then
&#9;&#9;&#9;if (target.Position - target1.Position).magnitude &lt; 15 then
&#9;&#9;&#9;&#9;if target.Name == &quot;PowerConnect&quot; or target:findFirstChild(&quot;Electrical&quot;) ~= nil then
&#9;&#9;&#9;&#9;&#9;if mode == 1 then
&#9;&#9;&#9;&#9;&#9;&#9;if target:findFirstChild(&quot;Electrical&quot;) ~= nil then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;if target1 ~= nil then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;if target.Locked == false then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;target2 = target
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;label.Text = target1.Name..&quot; has been connected to &quot;..target2.Name
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;target2.Source.Value = target1
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;if target.User.Value ~= nil then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;target.User.Value.Source.Value = nil 
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;label.Text = &quot;You have broken the old bond.&quot;
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;elseif mode == 2 then
&#9;&#9;&#9;&#9;&#9;&#9;if target.Name == &quot;PowerConnect&quot; then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;if target1 ~= nil then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;if target1.Locked == false then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;target2 = target
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;target1.Locked = true
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;label.Text = target1.Name..&quot; has been connected to &quot;..target2.Name
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;target1.User.Value = target2
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;target2.Parent.Source.Value = target1
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;label.Text = &quot;The battery you have chosen is being used... WIRING RESET.&quot;
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;else 
&#9;&#9;&#9;&#9;&#9;label.Text = &quot;The Target is not Electrical, WIRING RESET.&quot;
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;else 
&#9;&#9;&#9;&#9;label.Text = &quot;The Target is too far away from the Original object, WIRING RESET.&quot;
&#9;&#9;&#9;end
&#9;&#9;else 
&#9;&#9;&#9;label.Text = &quot;The Target is too far away, get closer... WIRING RESET.&quot;
&#9;&#9;end
&#9;else 
&#9;&#9;label.Text = &quot;Click on an actual Object... WIRING RESET.&quot;
&#9;end
end

function onEquipped(mouse)
&#9;frame.Parent = player.PlayerGui.ScreenGui
&#9;
&#9;mouse.Button1Down:connect(function() onButton1Down(mouse) end)
&#9;mouse.Button1Up:connect(function() onButton1Up(mouse) end)
end

function onUnequipped()
&#9;frame.Parent = tool
end

tool.Equipped:connect(onEquipped)
tool.Unequipped:connect(onUnequipped)</ProtectedString>
