				<Item class="Script" referent="RBX8899">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">BulletScript</string>
						<ProtectedString name="Source">wait()
bullet = script.Parent
mainDamage = bullet.Damage

headDamage = mainDamage.Value * 2
torsoDamage = mainDamage.Value * 1.5
armDamage = mainDamage.Value * 1.25
legDamage = mainDamage.Value

db = true

function onTouched(hit)
&#9;headShot = false
&#9;if db == true then
&#9;&#9;if hit.Parent ~= nil then
&#9;&#9;&#9;if hit.Parent ~= bullet.Killer.Value.Character then
&#9;&#9;&#9;&#9;if hit.Parent.className ~= &quot;Tool&quot; or hit.Parent.className ~= &quot;Hat&quot;  or hit.Name ~= &quot;Bullet&quot; then 
&#9;&#9;&#9;&#9;&#9;db = false
&#9;&#9;&#9;&#9;&#9;
&#9;&#9;&#9;&#9;&#9;local humanoid = hit.Parent:findFirstChild(&quot;Humanoid&quot;)
&#9;&#9;&#9;&#9;&#9;local killer = script.Parent:findFirstChild(&quot;Killer&quot;)
&#9;&#9;&#9;&#9;&#9;if humanoid ~= nil then

&#9;&#9;&#9;&#9;&#9;&#9;if humanoid.Health &gt; 0 then

&#9;&#9;&#9;&#9;&#9;&#9;&#9;local victim = game.Players:GetPlayerFromCharacter(humanoid.Parent)

&#9;&#9;&#9;&#9;&#9;&#9;&#9;if hit.Name == &quot;Head&quot; then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;headShot = true
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;humanoid.Health = humanoid.Health - headDamage
&#9;&#9;&#9;&#9;&#9;&#9;&#9;elseif hit.Name == &quot;Torso&quot; then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;humanoid.Health = humanoid.Health - torsoDamage
&#9;&#9;&#9;&#9;&#9;&#9;&#9;elseif hit.Name == &quot;Right Arm&quot; or hit.Name == &quot;Left Arm&quot; then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;humanoid.Health = humanoid.Health - armDamage
&#9;&#9;&#9;&#9;&#9;&#9;&#9;elseif hit.Name == &quot;Right Leg&quot; or hit.Name == &quot;Left Leg&quot; then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;humanoid.Health = humanoid.Health - legDamage
&#9;&#9;&#9;&#9;&#9;&#9;&#9;end

&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;bullet.Parent = nil
&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;db = true
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end

bullet.Touched:connect(onTouched)

wait(5)
bullet.Parent = nil</ProtectedString>
