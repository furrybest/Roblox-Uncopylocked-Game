			<Item class="Script" referent="RBX259">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Biofuel</string>
					<ProtectedString name="Source">function onChildAdded(new)
&#9;print(&quot;New child!&quot;)
&#9;service(new)
end&#9;

function service(value)
&#9;local part = value.Value
&#9;if part ~= nil then
&#9;&#9;local new = game.Lighting.Items:findFirstChild(&quot;Biodiesel&quot;):clone()
&#9;&#9;part.Name = &quot;Decaying &quot;..part.Name
&#9;&#9;if new ~= nil then
&#9;&#9;&#9;wait(math.random(60, 90))
&#9;&#9;&#9;if part ~= nil then
&#9;&#9;&#9;&#9;new.Parent = part.Parent
&#9;&#9;&#9;&#9;new.Position = part.Position
&#9;&#9;&#9;&#9;part:remove()
&#9;&#9;&#9;end&#9;
&#9;&#9;end
&#9;end
end

script.ChildAdded:connect(onChildAdded)</ProtectedString>
