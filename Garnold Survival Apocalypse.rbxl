			<Item class="Script" referent="RBX5667">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<ProtectedString name="Source">function onTouched(hit)
&#9;if hit == nil then return end

&#9;if hit.Parent == nil then return end

&#9;local h = hit.Parent:findFirstChild(&quot;Humanoid&quot;)

&#9;if h ~= nil then
&#9;&#9;local c = hit.Parent:GetChildren()
&#9;&#9;local clips = nil

&#9;&#9;for index, child in pairs(c) do
&#9;&#9;&#9;if child.className == &quot;Tool&quot; then
&#9;&#9;&#9;&#9;if child.Gun ~= nil then
&#9;&#9;&#9;&#9;&#9;ammo = child:findFirstChild(&quot;Ammo&quot;)
&#9;&#9;&#9;&#9;&#9;if ammo ~= nil then
&#9;&#9;&#9;&#9;&#9;&#9;ammo.Value = ammo.Value + child.Gun.Value
&#9;&#9;&#9;&#9;&#9;&#9;script.Parent:remove()
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end
script.Parent.Touched:connect(onTouched)</ProtectedString>
				</Properties>
