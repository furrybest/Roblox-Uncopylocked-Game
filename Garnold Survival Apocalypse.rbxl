			<Item class="StringValue" referent="RBX16">
				<Properties>
					<string name="Name">Chosen</string>
					<string name="Value">Farmer&apos;s Valley</string>
				</Properties>
			</Item>
			<Item class="Script" referent="RBX17">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<ProtectedString name="Source">local manager = script.Parent
local maps = manager.Maps
local chosen = manager.Chosen
local start = manager.StartVote
local status = manager.Status

local mapSet = game:GetService(&quot;InsertService&quot;):GetCollection(351713)

voting = false

function findGreatest(nums) 
&#9;local max = 0 
&#9;local winners = {}  
&#9;for i = 1, table.maxn(nums) do 
&#9;&#9;if nums[i].Value &gt; max then 
&#9;&#9;&#9;max = nums[i].Value 
&#9;&#9;&#9;winners = {nums[i]}
&#9;&#9;elseif nums[i].Value == max and max ~= 0 then 
&#9;&#9;&#9;table.insert(winners, 1, nums[i]) 
&#9;&#9;end 
&#9;end 
&#9;if max == 0 then
&#9;&#9;winners = nums
&#9;end
&#9;r = winners[math.random(1, #winners)] 
&#9;return r
end

function giveGui(plr)
&#9;local gui = game.Lighting:findFirstChild(&quot;VoteFrame&quot;)
&#9;if plr.Character == nil then
&#9;&#9;repeat
&#9;&#9;&#9;wait(1)
&#9;&#9;until plr.Character ~= nil
&#9;end
&#9;if gui ~= nil then
&#9;&#9;if plr.PlayerGui:findFirstChild(&quot;VoteFrame&quot;) == nil then
&#9;&#9;&#9;gui:clone().Parent = plr.PlayerGui.ScreenGui
&#9;&#9;end
&#9;end
end

function startVote()
&#9;for index, player in pairs(game.Players:GetChildren()) do
&#9;&#9;giveGui(player)
&#9;end
&#9;if #game.Players:GetChildren() &lt; 1 then
&#9;&#9;status.Value = &quot;Waiting&quot;
&#9;&#9;repeat
&#9;&#9;&#9;wait(1)
&#9;&#9;until #game.Players:GetChildren() &gt;= 1
&#9;end
&#9;status.Value = &quot;Voting&quot;
&#9;
&#9;repeat -- timer
&#9;&#9;manager.Value = manager.Value - 1
&#9;&#9;wait(1)
&#9;until manager.Value == 0
&#9;-- count votes
&#9;voting = false
&#9;status.Value = &quot;Counting&quot;
&#9;wait(0.5)
&#9;local chosenMap = findGreatest(maps:GetChildren())
&#9;if chosenMap ~= nil then
&#9;&#9;chosen.Value = chosenMap.Name
&#9;else -- Start revote
&#9;
&#9;end
&#9;-- Get map from set
&#9;local mapID = nil
&#9;for index, map in pairs(mapSet) do
&#9;&#9;if map[&quot;Name&quot;] == chosenMap.Name then
&#9;&#9;&#9;mapID = map[&quot;AssetId&quot;]
&#9;&#9;end
&#9;end
&#9;if mapID ~= nil then -- Load the map
&#9;&#9;status.Value = &quot;Loading&quot;
&#9;&#9;realChosen = game:GetService(&quot;InsertService&quot;):LoadAsset(mapID):findFirstChild(chosen.Value)
&#9;&#9;if realChosen ~= nil then
&#9;&#9;&#9;local old = game.Workspace:findFirstChild(&quot;GameMap&quot;)
&#9;&#9;&#9;if old == nil then
&#9;&#9;&#9;&#9;old = workspace.WaitingArea
&#9;&#9;&#9;end
&#9;&#9;&#9;old:Remove()
&#9;&#9;&#9;realChosen.Name = &quot;GameMap&quot;
&#9;&#9;&#9;realChosen.Parent = workspace
&#9;&#9;&#9;realChosen:MoveTo(Vector3.new(0, 0, 0))
&#9;&#9;&#9;realChosen.Crates.Script.Disabled = true
&#9;&#9;&#9;realChosen.Crates.Script.Disabled = false
&#9;&#9;&#9;realChosen:MakeJoints()
&#9;&#9;&#9;if realChosen:findFirstChild(&quot;NoOcean&quot;) == nil then
&#9;&#9;&#9;&#9;workspace.OceanScript.Disabled = false
&#9;&#9;&#9;end
&#9;&#9;&#9;workspace.ZombieSpawner.Max.Value = realChosen.ZombieLimit.Value
&#9;&#9;&#9;workspace.ZombieSpawner.Disabled = false
&#9;&#9;else
&#9;&#9;&#9;print(&quot;ERROR&quot;)
&#9;&#9;end
&#9;&#9;status.Value = &quot;Finished&quot;
&#9;&#9;wait(3.5)
&#9;end
end

game.Players.ChildAdded:connect(function(child)
&#9;if voting then
&#9;&#9;wait(1)
&#9;&#9;giveGui(child)
&#9;end
end)

start.Changed:connect(function()
&#9;if start.Value then
&#9;&#9;voting = true
&#9;&#9;startVote()
&#9;end
end)

--game.Players.MaxPlayers = 12
start.Value = true
</ProtectedString>
