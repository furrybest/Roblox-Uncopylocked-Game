						<string name="Name">Script</string>
						<ProtectedString name="Source">local val = script.Parent
local part = val.Parent
local source = val.Source
local oldName = part.Name

while true do
&#9;if source.Value ~= nil then
&#9;&#9;if (part.Position - source.Value.Position).magnitude &gt; 5 then
&#9;&#9;&#9;if part.Name == val.NewName.Value then
&#9;&#9;&#9;&#9;part.Name = oldName
&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;oldName = part.Name
&#9;&#9;&#9;end
&#9;&#9;&#9;part.BrickColor = val.OrigColor.Value
&#9;&#9;&#9;part.Reflectance = 0
&#9;&#9;&#9;source.Value = nil
&#9;&#9;end
&#9;end
&#9;wait()
end

</ProtectedString>
					</Properties>
				</Item>
