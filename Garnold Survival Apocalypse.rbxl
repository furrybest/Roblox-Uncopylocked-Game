				<Item class="LocalScript" referent="RBX8109">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">LocalScript</string>
						<ProtectedString name="Source">wait()
local player = game.Players.LocalPlayer
frame = script.Parent
lightFrame = frame.Parent.LightFrame
date = workspace.Time.Date

runningLoop = false

function getAllParts(root, tab)
&#9;local c = root:GetChildren()

&#9;for index, child in pairs(c) do
&#9;&#9;if child:IsA(&quot;BasePart&quot;) then
&#9;&#9;&#9;if child:findFirstChild(&quot;Light&quot;) ~= nil then
&#9;&#9;&#9;&#9;table.insert(tab, child)
&#9;&#9;&#9;end
&#9;&#9;elseif child:IsA(&quot;Model&quot;) or child:IsA(&quot;Tool&quot;) then
&#9;&#9;&#9;getAllParts(child, tab)
&#9;&#9;end
&#9;end
end

function getLightSources(char)
&#9;lightParts = {}
&#9;getAllParts(workspace, lightParts)
&#9;power = 0
&#9;for i, v in pairs(lightParts) do
&#9;&#9;dist = (char.Head.Position - v.Position).magnitude
&#9;&#9;if dist &lt; 50 then
&#9;&#9;&#9;power = power + (1/dist*v.Light.Value/5)
&#9;&#9;end
&#9;end
&#9;return power
end
while true do
&#9;local hour = tonumber(string.sub(game.Lighting.TimeOfDay, 1, 2))
&#9;if hour &lt; 5 or hour &gt;= 20 then
&#9;&#9;lightFrame.BackgroundTransparency = 0.4
&#9;elseif hour == 5 then
&#9;&#9;lightFrame.BackgroundTransparency = 0.6
&#9;elseif hour == 6 then
&#9;&#9;lightFrame.BackgroundTransparency = 0.9
&#9;elseif hour &gt;= 7 and hour &lt; 18 then
&#9;&#9;lightFrame.BackgroundTransparency = 1
&#9;elseif hour == 18 then
&#9;&#9;lightFrame.BackgroundTransparency = 0.9
&#9;elseif hour == 19 then
&#9;&#9;lightFrame.BackgroundTransparency = 0.6
&#9;end
&#9;lightFrame.BackgroundTransparency = lightFrame.BackgroundTransparency + getLightSources(player.Character)
&#9;wait(.1)
end
</ProtectedString>
					</Properties>
				</Item>
			</Item>
