							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">LocalScript</string>
							<ProtectedString name="Source">wait(0.25)
local tool = script.Parent
local player = game.Players.LocalPlayer
local on = tool.Name
local handle = tool.Handle

local headDamage = 2
local torsoDamage = 1
local armsDamage = 0.5
local legsDamage = 0.75
local damage = 35
local reloadTime = 1.25
local range = 8
local debounce = true
local quality = 5

function slash()
&#9;local s = Instance.new(&quot;StringValue&quot;)
&#9;s.Name = &quot;toolanim&quot;
&#9;s.Value = &quot;Slash&quot;
&#9;s.Parent = tool
end

function onButton1Down(mouse)
&#9;if debounce == true then

&#9;&#9;slash()

&#9;&#9;local player = game.Players:GetPlayerFromCharacter(tool.Parent) 
&#9;&#9;local target = mouse.Target
&#9;&#9;local pos = mouse.hit.p

&#9;&#9;if target ~= nil then

&#9;&#9;&#9;if target.Parent ~= nil then

&#9;&#9;&#9;&#9;if (handle.Position - target.Position).magnitude &lt; range then

&#9;&#9;&#9;&#9;&#9;local h = target.Parent:findFirstChild(&quot;Humanoid&quot;)

&#9;&#9;&#9;&#9;&#9;if h ~= nil then
&#9;&#9;&#9;&#9;&#9;&#9;if h.Health &gt; 0 then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;if target.Name == &quot;Head&quot; then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;h:TakeDamage(headDamage * damage)
&#9;&#9;&#9;&#9;&#9;&#9;&#9;end

&#9;&#9;&#9;&#9;&#9;&#9;&#9;if target.Name == &quot;Torso&quot; then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;h:TakeDamage(torsoDamage * damage)
&#9;&#9;&#9;&#9;&#9;&#9;&#9;end

&#9;&#9;&#9;&#9;&#9;&#9;&#9;if target.Name == &quot;Left Arm&quot; or target.Name == &quot;Right Arm&quot; then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;h:TakeDamage(armsDamage * damage)
&#9;&#9;&#9;&#9;&#9;&#9;&#9;end

&#9;&#9;&#9;&#9;&#9;&#9;&#9;if target.Name == &quot;Left Leg&quot; or target.Name == &quot;Right Leg&quot; then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;h:TakeDamage(armsDamage * damage)
&#9;&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;&#9;if h.Health == 0 then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;plr = game.Players:GetPlayerFromCharacter(target.Parent)
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;if plr == nil then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;local stat = player.Stats:findFirstChild(&quot;ZKills&quot;)
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;if stat ~= nil then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;stat.Value = stat.Value + 1
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;end

&#9;&#9;&#9;&#9;&#9;--extra stuff goes here
&#9;&#9;&#9;&#9;&#9;if target.Name == &quot;Top&quot; then
&#9;&#9;&#9;&#9;&#9;&#9;print(&quot;Top is there&quot;)
&#9;&#9;&#9;&#9;&#9;&#9;if target.Parent.Name == &quot;Crate&quot; then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;print(&quot;Its in a crate&quot;)
&#9;&#9;&#9;&#9;&#9;&#9;&#9;if math.random(1, quality) == 1 then&#9;&#9;
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;tool.Name = &quot;Crate Opened!&quot;
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;target:BreakJoints()
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;tool.CratesOpened.Value = tool.CratesOpened.Value + 1
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;wait(2)
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;target:remove()
&#9;&#9;&#9;&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;tool.Name = &quot;Failed...&quot;
&#9;&#9;&#9;&#9;&#9;&#9;&#9;end

&#9;&#9;&#9;&#9;&#9;&#9;end

&#9;&#9;&#9;&#9;&#9;end

&#9;&#9;&#9;&#9;end

&#9;&#9;&#9;end

&#9;&#9;end

&#9;&#9;tool.Name = &quot;Resting&quot;

&#9;&#9;debounce = false

&#9;&#9;wait(reloadTime)

&#9;&#9;tool.Name = on

&#9;&#9;debounce = true

&#9;end
end

function onEquipped(mouse)
&#9;mouse.Button1Down:connect(function() onButton1Down(mouse) end)
end

tool.Equipped:connect(onEquipped)
</ProtectedString>
						</Properties>
					</Item>
					<Item class="IntValue" referent="RBX11156">
						<Properties>
							<string name="Name">CratesOpened</string>
							<int name="Value">27</int>
						</Properties>
