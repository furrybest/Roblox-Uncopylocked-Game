		<Item class="Script" referent="RBX6">
			<Properties>
				<bool name="Disabled">true</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">BuildingScript</string>
				<ProtectedString name="Source">function onPlayerLeave(oldPlayer)
&#9;print(&quot;A player left&quot;)
&#9;plr = script.Parent.Owner
&#9;plrName = plr.Value.Name
&#9;if oldPlayer == plr.Value then
&#9;&#9;x = 300
&#9;&#9;print(&quot;Owner left&quot;)
&#9;&#9;local found = false
&#9;&#9;repeat
&#9;&#9;&#9;x = x - 1
&#9;&#9;&#9;local newPlr = game.Players:findFirstChild(plrName)
&#9;&#9;&#9;if newPlr ~= nil then
&#9;&#9;&#9;&#9;print(&quot;The player has returned&quot;)
&#9;&#9;&#9;&#9;found = true
&#9;&#9;&#9;&#9;plr.Value = newPlr
&#9;&#9;&#9;&#9;local val = Instance.new(&quot;ObjectValue&quot;)
&#9;&#9;&#9;&#9;val.Name = script.Parent.Name
&#9;&#9;&#9;&#9;val.Value = script.Parent
&#9;&#9;&#9;&#9;repeat
&#9;&#9;&#9;&#9;&#9;print(&quot;waiting for buildings to come&quot;)
&#9;&#9;&#9;&#9;&#9;wait()
&#9;&#9;&#9;&#9;until newPlr:findFirstChild(&quot;Buildings&quot;) ~= nil
&#9;&#9;&#9;&#9;val.Parent = newPlr.Buildings
&#9;&#9;&#9;end
&#9;&#9;&#9;wait(1)
&#9;&#9;until found or x == 0
&#9;&#9;if not found then
&#9;&#9;&#9;script.Parent:Remove()
&#9;&#9;end
&#9;end
end

game.Players.ChildRemoved:connect(onPlayerLeave)
</ProtectedString>
			</Properties>
		</Item>
		<Item class="Script" referent="RBX7">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">SeguridadDeLosExplotadores</string>
				<ProtectedString name="Source">serv = game:GetService(&quot;InsertService&quot;)
status = workspace.VoteManager.Status
serv.ChildAdded:connect(function(param) 
&#9;if status.Value ~= &quot;Loading&quot; then
&#9;&#9;param:Remove() 
&#9;end
end)</ProtectedString>
			</Properties>
		</Item>
		<Item class="Script" referent="RBX8">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">ToolStorage</string>
				<ProtectedString name="Source">function onPlayerEntered(player)
&#9;player.Chatted:connect(function(message)
&#9;&#9;if message:sub(1, 9) == &quot;store/all&quot; then
&#9;&#9;&#9;local tools = player.Backpack:GetChildren()
&#9;&#9;&#9;for index, child in pairs(tools) do
&#9;&#9;&#9;&#9;if child:findFirstChild(&quot;StarterTool&quot;) == nil then
&#9;&#9;&#9;&#9;&#9;child.Parent = player.Inventory
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;elseif message:sub(1, 6) == &quot;store/&quot; then
&#9;&#9;&#9;local picked = message:sub(7)
&#9;&#9;&#9;local real = player.Backpack:findFirstChild(picked)
&#9;&#9;&#9;if real ~= nil then
&#9;&#9;&#9;&#9;local starter = real:findFirstChild(&quot;StarterTool&quot;)
&#9;&#9;&#9;&#9;if starter == nil then
&#9;&#9;&#9;&#9;&#9;real.Parent = player.Inventory
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end)
end
game.Players.ChildAdded:connect(onPlayerEntered)
</ProtectedString>
			</Properties>
		</Item>
