				<Item class="LocalScript" referent="RBX9529">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">LocalWelding</string>
						<ProtectedString name="Source">function Weld(x,y)
&#9;local W = Instance.new(&quot;Weld&quot;)
&#9;W.Part0 = x
&#9;W.Part1 = y
&#9;local CJ = CFrame.new(x.Position)
&#9;local C0 = x.CFrame:inverse()*CJ
&#9;local C1 = y.CFrame:inverse()*CJ
&#9;W.C0 = C0
&#9;W.C1 = C1
&#9;W.Parent = x
end

function Get(A)
&#9;if A:IsA(&quot;BasePart&quot;) then
&#9;&#9;Weld(script.Parent.Handle, A)
&#9;&#9;A.Anchored = false
&#9;else
&#9;&#9;local C = A:GetChildren()
&#9;&#9;for i=1, #C do
&#9;&#9;Get(C[i])
&#9;&#9;end
&#9;end
end

function GetTwo(A)
&#9;if A:IsA(&quot;BasePart&quot;) then
&#9;&#9;Weld(script.Parent.Handle, A)
&#9;&#9;A.Anchored = true
&#9;else
&#9;&#9;local C = A:GetChildren()
&#9;&#9;for i=1, #C do
&#9;&#9;GetTwo(C[i])
&#9;&#9;end
&#9;end
end

function Finale()
&#9;Get(script.Parent)
end

function FinaleTwo()
&#9;GetTwo(script.Parent)
end

script.Parent.Equipped:connect(Finale)
Finale()</ProtectedString>
					</Properties>
				</Item>
				<Item class="LocalScript" referent="RBX9530">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">MouseIcon</string>
						<ProtectedString name="Source">wait(0.1)
tool = script.Parent
accuracy = tool.Accuracy
maxAccuracy = tool.MaxAccuracy
http = &quot;http://www.roblox.com/asset/?id=&quot;
icons = {&quot;39621740&quot;, &quot;39621784&quot;, &quot;39621841&quot;, &quot;39621897&quot;, &quot;39621939&quot;, &quot;39621995&quot;, &quot;39622044&quot;, &quot;39622136&quot;, &quot;39622176&quot;, &quot;39622228&quot;, &quot;39622268&quot;, &quot;39622329&quot;}
icons2 = {&quot;53390489&quot;, &quot;53390513&quot;, &quot;53390538&quot;, &quot;53390574&quot;, &quot;53390602&quot;, &quot;53390614&quot;, &quot;53390636&quot;, &quot;53390658&quot;, &quot;53390681&quot;, &quot;53390700&quot;, &quot;53390738&quot;, &quot;53390723&quot;}

secondOn = false
timeLeft = 5

function changeIcon(mouse)
&#9;if accuracy.Value &gt; 49 then
&#9;&#9;accuracy.Value = 49
&#9;elseif accuracy.Value &lt; 1 then
&#9;&#9;accuracy.Value = 1
&#9;end
&#9;if not secondOn then
&#9;&#9;local iconGet = math.ceil(accuracy.Value/4.1667 + 0.1)
&#9;&#9;mouse.Icon = http..icons[iconGet]
&#9;else
&#9;&#9;local iconGet = math.ceil(accuracy.Value/4.1667 + 0.1)
&#9;&#9;mouse.Icon = http..icons2[iconGet]
&#9;end
end

function onEquipped(mouse)
&#9;accuracy.Changed:connect(function() changeIcon(mouse) end)
&#9;while true do
&#9;&#9;if tool.EnemyHit.Value then
&#9;&#9;&#9;secondOn = true
&#9;&#9;&#9;tool.EnemyHit.Value = false
&#9;&#9;else
&#9;&#9;&#9;timeLeft = timeLeft - 1
&#9;&#9;&#9;if timeLeft &lt; 1 then
&#9;&#9;&#9;&#9;secondOn = false
&#9;&#9;&#9;&#9;changeIcon(mouse)
&#9;&#9;&#9;&#9;timeLeft = 5
&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;if accuracy.Value &gt; maxAccuracy.Value then
&#9;&#9;&#9;if tool.IsShooting.Value == false then
&#9;&#9;&#9;&#9;if tool.ClassType.Value == &quot;Automatic&quot; then 
&#9;&#9;&#9;&#9;&#9;accuracy.Value = accuracy.Value - tool.Kickback.Value*2
&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;accuracy.Value = accuracy.Value - tool.Kickback.Value/2
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;if accuracy.Value &lt; maxAccuracy.Value then
&#9;&#9;&#9;&#9;&#9;accuracy.Value = maxAccuracy.Value
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;if maxAccuracy.Value &gt; 49 then
&#9;&#9;&#9;&#9;&#9;maxAccuracy.Value  = 49
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;wait(0.1)
&#9;end
end

tool.Equipped:connect(onEquipped)

</ProtectedString>
					</Properties>
				</Item>
				<Item class="LocalScript" referent="RBX9531">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">UniversalFireLocal</string>
						<ProtectedString name="Source">wait(0.1)
local player = game.Players.LocalPlayer
tool = script.Parent
origName = tool.Name
frame = tool.Interface

ammo = tool.Ammo
clip = ammo.Clip
gunVal = tool.Gun
--grenades = player.Character:findFirstChild(&quot;Grenades&quot;)
firingRate = 1/(tool.FiringRate.Value/60)
range = 100

bulletSpeed = tool.Speed.Value*3.2808399
damage = tool.Damage.Value

accuracy = tool.Accuracy
maxAccuracy = tool.MaxAccuracy
minimumAcc = accuracy.Value + 25

sprinting = false
bIsDown = false
gIsDown = false
knifing = false
db = true

bg = player.Character.Torso:findFirstChild(&quot;BodyGyro&quot;)

function getGravEf(waitTime)
&#9;local downSpeed = 9.81*waitTime
&#9;return downSpeed*waitTime
end

function createAnim(commandName, value)
&#9;local command = Instance.new(&quot;NumberValue&quot;) -- Creates animation
&#9;command.Name = commandName
&#9;command.Value = value
&#9;command.Parent = tool.ArmWelding
end

function sendBullet(origin, endPos, hit, current)

&#9;local mark = nil
&#9;local direction = CFrame.new(origin, endPos).lookVector
&#9;if hit ~= nil then
&#9;&#9;mark = Instance.new(&quot;Part&quot;)
&#9;&#9;local mesh = Instance.new(&quot;BlockMesh&quot;, mark)
&#9;&#9;mark.Name = &quot;Mark&quot;
&#9;&#9;mark.Size = Vector3.new(1, 1, 1)
&#9;&#9;mark.CFrame = CFrame.new(endPos + endpos*(direction*5))
&#9;&#9;mark.BrickColor = hit.BrickColor
&#9;&#9;mark.Anchored = true
&#9;&#9;mesh.Scale = Vector3.new(0.15, 0.15, 0.15)
&#9;&#9;local detail = nil
&#9;&#9;if hit.Material == Enum.Material.Wood or hit.Material == Enum.Material.Grass or hit.Material == Enum.Material.Concrete then
&#9;&#9;&#9;detail = Instance.new(&quot;Smoke&quot;, mark)
&#9;&#9;&#9;detail.Opacity = 0.5
&#9;&#9;&#9;detail.RiseVelocity = 5
&#9;&#9;&#9;detail.Color = hit.BrickColor.Color
&#9;&#9;else
&#9;&#9;&#9;detail = Instance.new(&quot;Sparkles&quot;, mark)
&#9;&#9;&#9;detail.SparkleColor = Color3.new(228/255, 169/255, 8/255)
&#9;&#9;end
&#9;end

&#9;if current ~= 1 then
&#9;&#9;local&#9;bPath = Instance.new(&quot;Part&quot;)
&#9;&#9;local bMesh = Instance.new(&quot;BlockMesh&quot;, bPath) 
&#9;&#9;bPath.Name = &quot;BulletPath&quot;
&#9;&#9;bPath.CanCollide = false 
&#9;&#9;bPath.Size = Vector3.new(1, 1, 1) 
&#9;&#9;bPath.Transparency = 0.75
&#9;&#9;bPath.Anchored = true 
&#9;&#9;bPath.CFrame = CFrame.new(origin, endPos) 
&#9;&#9;bPath.BrickColor = BrickColor.new(&quot;Pastel yellow&quot;) 
&#9;&#9;bPath.formFactor = &quot;Custom&quot; 
&#9;&#9;bMesh.Scale = Vector3.new(0.15, 0.15, (origin - endPos).magnitude) 
&#9;&#9;bMesh.Offset = Vector3.new(0,0,(origin - endPos).magnitude/-2) 
&#9;&#9;bPath.Parent = player.Character
&#9;end
&#9;

&#9;local killed = false
&#9;local currentDamage = damage
&#9;if hit ~= nil then
&#9;&#9;if hit.Parent ~= nil then
&#9;&#9;&#9;local parent = hit.Parent
&#9;&#9;&#9;local hum = parent:findFirstChild(&quot;Humanoid&quot;)
&#9;&#9;&#9;if hum == nil then
&#9;&#9;&#9;&#9;repeat
&#9;&#9;&#9;&#9;&#9;parent = parent.Parent
&#9;&#9;&#9;&#9;&#9;hum = parent:findFirstChild(&quot;Humanoid&quot;)
&#9;&#9;&#9;&#9;until hum ~= nil or parent == workspace or parent == game
&#9;&#9;&#9;end
&#9;&#9;&#9;if hum ~= nil then
&#9;&#9;&#9;&#9;local plr = game.Players:GetPlayerFromCharacter(parent)
&#9;&#9;&#9;&#9;if hit.Name == &quot;Head&quot; then
&#9;&#9;&#9;&#9;&#9;headshot = true
&#9;&#9;&#9;&#9;&#9;hum.Health = hum.Health - currentDamage*2
&#9;&#9;&#9;&#9;elseif hit.Name == &quot;Bulletproof Vest&quot; then
&#9;&#9;&#9;&#9;&#9;hum.Health = hum.Health - currentDamage/3
&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;hum.Health = hum.Health - currentDamage
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;tool.EnemyHit.Value = true
&#9;&#9;&#9;&#9;if hum.Health == 0 then
&#9;&#9;&#9;&#9;&#9;if plr == nil then
&#9;&#9;&#9;&#9;&#9;&#9;local stat = player.Stats:findFirstChild(&quot;ZKills&quot;)
&#9;&#9;&#9;&#9;&#9;&#9;if stat ~= nil then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;stat.Value = stat.Value + 1
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;mark.Parent = player.Character
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end

function castRay(origin, point, ignore)
&#9;local dFrame = CFrame.new(origin, point)
&#9;return workspace:FindPartOnRay(Ray.new(origin, dFrame.lookVector*range), ignore)
end

function updateGui()
&#9;frame.AmmoFrame.Label.Text = clip.Value..&quot;/&quot;..ammo.Value
&#9;--frame.GrenadeFrame.Label.Text = grenades.Value
end

function throwGrenade(velocity)
&#9;local grenade = game.Lighting.Objects:findFirstChild(&quot;Grenade&quot;):clone()
&#9;if grenade ~= nil then
&#9;&#9;print(&quot;Throwing Grenade&quot;)
&#9;&#9;grenade.Killer.Value = player
&#9;&#9;grenade.CFrame = CFrame.new((tool.Barrel.Position+Vector3.new(0, 1, 0)) + (tool.Handle.CFrame.lookVector*tool.Barrel.Size.y))
&#9;&#9;grenade.Velocity = velocity
&#9;&#9;grenade.Parent = workspace
&#9;end
end

function reload()
&#9;if tool.Reloading.Value == false then
&#9;&#9;if tool.ClassType.Value ~= &quot;Shotgun&quot; then
&#9;&#9;&#9;tool.Reloading.Value = true
&#9;&#9;&#9;tool.IsShooting.Value = false
&#9;&#9;&#9;if ammo.Value &gt; 0 then
&#9;&#9;&#9;&#9;createAnim(&quot;Reload&quot;, tool.ReloadTime.Value)
&#9;&#9;&#9;&#9;local amtLeft = clip.Value
&#9;&#9;&#9;&#9;local maxAmt = gunVal.Value
&#9;&#9;&#9;&#9;local checks = 10
&#9;&#9;&#9;&#9;tool.Reloading.Value = true
&#9;&#9;&#9;&#9;tool.Name = &quot;Reloading&quot;
&#9;&#9;&#9;&#9;if tool.ReloadTime.Value &gt; 5 then
&#9;&#9;&#9;&#9;&#9;tool.Handle.LMGReload:Play()
&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;tool.Handle.Reload:Play()
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;tool.Magazine.Transparency = 1
&#9;&#9;&#9;&#9;repeat
&#9;&#9;&#9;&#9;&#9;wait(tool.ReloadTime.Value/10)
&#9;&#9;&#9;&#9;&#9;checks = checks - 1
&#9;&#9;&#9;&#9;until checks == 0 or tool.InUse.Value == false
&#9;&#9;&#9;&#9;tool.Magazine.Transparency = 0
&#9;&#9;&#9;&#9;tool.Name = origName
&#9;&#9;&#9;&#9;if tool.InUse.Value == true then
&#9;&#9;&#9;&#9;&#9;clip.Value = clip.Value + ammo.Value
&#9;&#9;&#9;&#9;&#9;ammo.Value = 0
&#9;&#9;&#9;&#9;&#9;if clip.Value &gt; maxAmt then
&#9;&#9;&#9;&#9;&#9;&#9;ammo.Value = clip.Value - maxAmt
&#9;&#9;&#9;&#9;&#9;&#9;clip.Value = maxAmt
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;&#9;tool.Reloading.Value = false
&#9;&#9;else
&#9;&#9;&#9;if ammo.Value &gt; 0 then
&#9;&#9;&#9;&#9;local maxAmt = gunVal.Value
&#9;&#9;&#9;&#9;interupted = false
&#9;&#9;&#9;&#9;repeat
&#9;&#9;&#9;&#9;&#9;createAnim(&quot;Reload&quot;, tool.ReloadTime.Value)
&#9;&#9;&#9;&#9;&#9;tool.Reloading.Value = true
&#9;&#9;&#9;&#9;&#9;tool.Handle.ShotgunReload:Play()
&#9;&#9;&#9;&#9;&#9;wait(tool.ReloadTime.Value)
&#9;&#9;&#9;&#9;&#9;clip.Value = clip.Value + 1
&#9;&#9;&#9;&#9;&#9;ammo.Value = ammo.Value - 1
&#9;&#9;&#9;&#9;&#9;if bIsDown then
&#9;&#9;&#9;&#9;&#9;&#9;interupted = true
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;until ammo.Value == 0 or clip.Value == maxAmt or not tool.InUse.Value == true or interupted == true
&#9;&#9;&#9;&#9;tool.Reloading.Value = false
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end

function createFlash()
&#9;local flash = Instance.new(&quot;Part&quot;) -- I needa find a better spot for this...
&#9;local flashMesh = Instance.new(&quot;SpecialMesh&quot;, flash)
&#9;flash.Name = &quot;Flash&quot;
&#9;flash.BrickColor = BrickColor.new(&quot;Bright yellow&quot;)
&#9;flash.Transparency = 0.75
&#9;flash.formFactor = &quot;Symmetric&quot;
&#9;flash.Size = Vector3.new(1, 1, 1)
&#9;flashMesh.MeshType = &quot;Sphere&quot;
&#9;flash.Anchored = true
&#9;flash.CanCollide = false
&#9;flash.CFrame = CFrame.new(tool.Barrel.Position + (tool.Barrel.Size.y*tool.Ironsights.CFrame.lookVector)/2)
&#9;flash.Parent = player.Character
end

function shoot(v, hitPos)
&#9;if tool.InUse.Value == true then
&#9;&#9;local char = tool.Parent
&#9;&#9;local player = game.Players:GetPlayerFromCharacter(char)
&#9;&#9;local ap = accuracy.Value/1250
&#9;&#9;local spawnPos = char.Head.Position
&#9;&#9;local determinable = ap*(hitPos - spawnPos).magnitude
&#9;&#9;local point = hitPos + Vector3.new(math.random(-determinable, determinable), math.random(-determinable, determinable), math.random(-determinable, determinable))
&#9;&#9;local maxRange = (spawnPos - point).magnitude
&#9;&#9;local waitTime = maxRange/bulletSpeed
&#9;&#9;local gravEffect = Vector3.new(0, getGravEf(waitTime), 0)
&#9;&#9;print(gravEffect)
&#9;&#9;local continuations = math.ceil(maxRange/range)
&#9;&#9;local current = 1
&#9;&#9;local dividedWait = waitTime/continuations
&#9;&#9;print(&quot;dividedWait&quot;, dividedWait)
&#9;&#9;print(continuations)
&#9;&#9;createFlash()
&#9;&#9;createAnim(&quot;Recoil&quot;, 0)
&#9;&#9;repeat
&#9;&#9;&#9;hit, pos = castRay(spawnPos, point, char)
&#9;&#9;&#9;sendBullet(spawnPos, pos, hit, current)
&#9;&#9;&#9;point = point - gravEffect/continuations
&#9;&#9;&#9;spawnPos = pos
&#9;&#9;&#9;continuations = continuations - 1
&#9;&#9;&#9;current = current + 1
&#9;&#9;&#9;wait(dividedWait)
&#9;&#9;until hit ~= nil or continuations == 0

&#9;&#9;createAnim(&quot;Recoil&quot;, 0)
&#9;end
end

function recoil()
&#9;if tool.ClassType.Value == &quot;Pistol&quot; then
&#9;&#9;tool.GripForward = tool.GripForward - Vector3.new(0, 0.1, 0)
&#9;&#9;wait(0.1)
&#9;&#9;tool.GripForward = tool.GripForward + Vector3.new(0, 0.1, 0)
&#9;else
&#9;&#9;tool.GripForward = tool.GripForward - Vector3.new(0, 0.05, 0)
&#9;&#9;wait(.001)
&#9;&#9;tool.GripForward = tool.GripForward + Vector3.new(0, 0.05, 0)
&#9;end
end

function onButton1Down(mouse)

&#9;local char = tool.Parent

&#9;bIsDown = true
&#9;if tool.Reloading.Value == false then
&#9;&#9;if knifing == false then
&#9;&#9;&#9;if char.Humanoid.Health &gt; 0 then
&#9;&#9;&#9;&#9;if tool.ClassType.Value == &quot;Automatic&quot; then
&#9;&#9;&#9;&#9;&#9;while bIsDown and tool.Reloading.Value == false and tool.InUse.Value == true and knifing == false and char.Humanoid.Health &gt; 0 do
&#9;&#9;&#9;&#9;&#9;&#9;local targetPos = char.Humanoid.TargetPoint
&#9;&#9;&#9;&#9;&#9;&#9;local lookAt = (targetPos - char.Head.Position).unit
&#9;&#9;&#9;&#9;&#9;&#9;if tool.Parent.Name ~= &quot;Backpack&quot; then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;if db == true then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;db = false
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;tool.IsShooting.Value = true
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;if clip.Value &gt; 0 then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;tool.Handle.Fire:play()
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;coroutine.resume(coroutine.create(shoot), lookAt, mouse.hit.p)
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;clip.Value = clip.Value - 1
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;if tool.Accuracy.Value &lt; minimumAcc then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;tool.Accuracy.Value = tool.Accuracy.Value + tool.Kickback.Value
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;reload()
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;db = true
&#9;&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;wait(firingRate)
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;tool.IsShooting.Value = false
&#9;&#9;&#9;&#9;elseif tool.ClassType.Value == &quot;Sniper&quot; then
&#9;&#9;&#9;&#9;&#9;local targetPos = char.Humanoid.TargetPoint
&#9;&#9;&#9;&#9;&#9;local lookAt = (targetPos - char.Head.Position).unit
&#9;&#9;&#9;&#9;&#9;if db == true then
&#9;&#9;&#9;&#9;&#9;&#9;db = false
&#9;&#9;&#9;&#9;&#9;&#9;if clip.Value &gt; 0 then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;tool.Handle.Fire:play()
&#9;&#9;&#9;&#9;&#9;&#9;&#9;coroutine.resume(coroutine.create(shoot), lookAt, mouse.hit.p)
&#9;&#9;&#9;&#9;&#9;&#9;&#9;clip.Value = clip.Value - 1
&#9;&#9;&#9;&#9;&#9;&#9;&#9;if tool.Accuracy.Value &lt; minimumAcc then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;tool.Accuracy.Value = tool.Accuracy.Value + tool.Kickback.Value
&#9;&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;&#9;&#9;reload()
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;wait(firingRate/2)
&#9;&#9;&#9;&#9;&#9;&#9;tool.Handle.Sniper:Play()
&#9;&#9;&#9;&#9;&#9;&#9;wait(firingRate/2)
&#9;&#9;&#9;&#9;&#9;&#9;db = true
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;elseif tool.ClassType.Value == &quot;Semi-Automatic&quot; or tool.ClassType.Value == &quot;Pistol&quot; then
&#9;&#9;&#9;&#9;&#9;local targetPos = char.Humanoid.TargetPoint
&#9;&#9;&#9;&#9;&#9;local lookAt = (targetPos - char.Head.Position).unit
&#9;&#9;&#9;&#9;&#9;if db == true then
&#9;&#9;&#9;&#9;&#9;&#9;db = false
&#9;&#9;&#9;&#9;&#9;&#9;tool.IsShooting.Value = true
&#9;&#9;&#9;&#9;&#9;&#9;if clip.Value &gt; 0 then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;tool.Handle.Fire:play()
&#9;&#9;&#9;&#9;&#9;&#9;&#9;coroutine.resume(coroutine.create(shoot), lookAt, mouse.hit.p)
&#9;&#9;&#9;&#9;&#9;&#9;&#9;clip.Value = clip.Value - 1
&#9;&#9;&#9;&#9;&#9;&#9;&#9;if tool.Accuracy.Value &lt; minimumAcc then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;tool.Accuracy.Value = tool.Accuracy.Value + tool.Kickback.Value
&#9;&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;&#9;&#9;reload()
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;tool.IsShooting.Value = false
&#9;&#9;&#9;&#9;&#9;&#9;wait(firingRate)
&#9;&#9;&#9;&#9;&#9;&#9;db = true
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;elseif tool.ClassType.Value == &quot;Shotgun&quot; then
&#9;&#9;&#9;&#9;&#9;local targetPos = mouse.hit.p
&#9;&#9;&#9;&#9;&#9;local lookAt = (targetPos - char.Head.Position).unit
&#9;&#9;&#9;&#9;&#9;if db == true then
&#9;&#9;&#9;&#9;&#9;&#9;db = false
&#9;&#9;&#9;&#9;&#9;&#9;tool.IsShooting.Value = true
&#9;&#9;&#9;&#9;&#9;&#9;if clip.Value &gt; 0 then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;tool.Handle.Fire:play()
&#9;&#9;&#9;&#9;&#9;&#9;&#9;for x = 1, math.random(6, 10) do
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;coroutine.resume(coroutine.create(shoot), lookAt, mouse.hit.p)
&#9;&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;&#9;clip.Value = clip.Value - 1
&#9;&#9;&#9;&#9;&#9;&#9;&#9;if tool.Accuracy.Value &lt; minimumAcc then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;tool.Accuracy.Value = tool.Accuracy.Value + tool.Kickback.Value
&#9;&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;&#9;&#9;reload()
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;wait(firingRate/2)
&#9;&#9;&#9;&#9;&#9;&#9;tool.IsShooting.Value = false
&#9;&#9;&#9;&#9;&#9;&#9;tool.Handle.Sniper:Play()
&#9;&#9;&#9;&#9;&#9;&#9;wait(firingRate/2)
&#9;&#9;&#9;&#9;&#9;&#9;db = true
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;elseif tool.ClassType.Value == &quot;Explosive&quot; then
&#9;&#9;&#9;&#9;&#9;local targetPos = mouse.hit.p
&#9;&#9;&#9;&#9;&#9;local lookAt = (targetPos - char.Head.Position).unit
&#9;&#9;&#9;&#9;&#9;if db == true then
&#9;&#9;&#9;&#9;&#9;&#9;db = false
&#9;&#9;&#9;&#9;&#9;&#9;tool.IsShooting.Value = true
&#9;&#9;&#9;&#9;&#9;&#9;if clip.Value &gt; 0 then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;tool.Handle.Fire:play()
&#9;&#9;&#9;&#9;&#9;&#9;&#9;local smoke = tool.Barrel:findFirstChild(&quot;Smoke&quot;)
&#9;&#9;&#9;&#9;&#9;&#9;&#9;if smoke ~= nil then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;smoke.Enabled = true
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;wait(0.1)
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;smoke.Enabled = false
&#9;&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;&#9;coroutine.resume(coroutine.create(shoot), lookAt, mouse.hit.p)
&#9;&#9;&#9;&#9;&#9;&#9;&#9;clip.Value = clip.Value - 1
&#9;&#9;&#9;&#9;&#9;&#9;&#9;if tool.Accuracy.Value &lt; minimumAcc then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;tool.Accuracy.Value = tool.Accuracy.Value + tool.Kickback.Value
&#9;&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;&#9;&#9;reload()
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;tool.IsShooting.Value = false
&#9;&#9;&#9;&#9;&#9;&#9;wait(firingRate/2)
&#9;&#9;&#9;&#9;&#9;&#9;db = true
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;elseif string.sub(tool.ClassType.Value, 1, 5) == &quot;Burst&quot; then
&#9;&#9;&#9;&#9;&#9;local times = tonumber(string.sub(tool.ClassType.Value, 7, string.len(tool.ClassType.Value)))
&#9;&#9;&#9;&#9;&#9;repeat
&#9;&#9;&#9;&#9;&#9;&#9;local targetPos = char.Humanoid.TargetPoint
&#9;&#9;&#9;&#9;&#9;&#9;local lookAt = (targetPos - char.Head.Position).unit
&#9;&#9;&#9;&#9;&#9;&#9;if db == true then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;db = false
&#9;&#9;&#9;&#9;&#9;&#9;&#9;tool.IsShooting.Value = true
&#9;&#9;&#9;&#9;&#9;&#9;&#9;if clip.Value &gt; 0 then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;tool.Handle.Fire:play()
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;coroutine.resume(coroutine.create(shoot), lookAt, mouse.hit.p)
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;clip.Value = clip.Value - 1
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;if tool.Accuracy.Value &lt; minimumAcc then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;tool.Accuracy.Value = tool.Accuracy.Value + tool.Kickback.Value
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;reload()
&#9;&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;&#9;tool.IsShooting.Value = false
&#9;&#9;&#9;&#9;&#9;&#9;&#9;wait(firingRate)
&#9;&#9;&#9;&#9;&#9;&#9;&#9;db = true
&#9;&#9;&#9;&#9;&#9;&#9;end&#9;&#9;&#9;
&#9;&#9;&#9;&#9;&#9;&#9;times = times-1
&#9;&#9;&#9;&#9;&#9;until times == 0 or tool.Reloading.Value == true or tool.InUse.Value == false or knifing == true or char.Humanoid.Health == 0
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end
function onKeyDown(key, mouse)
&#9;if player.Character.Humanoid.Health &gt; 0 then
&#9;&#9;if key == &quot;e&quot; then
&#9;&#9;&#9;if sprinting == false then
&#9;&#9;&#9;&#9;if player.Character.Torso.Velocity ~= Vector3.new(0, 0, 0) then
&#9;&#9;&#9;&#9;&#9;local energyLeft = 100
&#9;&#9;&#9;&#9;&#9;sprinting = true
&#9;&#9;&#9;&#9;&#9;accuracy.Value = accuracy.Value + 20
&#9;&#9;&#9;&#9;&#9;maxAccuracy.Value = maxAccuracy.Value + 20
&#9;&#9;&#9;&#9;&#9;tool.CrouchZoom.Value = false
&#9;&#9;&#9;&#9;&#9;player.Character.Humanoid.WalkSpeed = 25

&#9;&#9;&#9;&#9;&#9;createAnim(&quot;Sprint&quot;, 0)

&#9;&#9;&#9;&#9;&#9;repeat
&#9;&#9;&#9;&#9;&#9;&#9;energyLeft = energyLeft - 1
&#9;&#9;&#9;&#9;&#9;&#9;wait(0.1)
&#9;&#9;&#9;&#9;&#9;until sprinting == false or energyLeft == 0 or bIsDown == true or InUse == false or player.Character.Torso.Velocity == Vector3.new(0, 0, 0) -- Lots of things to make you stop...
&#9;&#9;&#9;&#9;&#9;for index, part in pairs(tool:GetChildren()) do
&#9;&#9;&#9;&#9;&#9;&#9;if part:IsA(&quot;BasePart&quot;) then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;if part.Name ~= &quot;Ironsights&quot; and part.Name ~= &quot;Scope&quot; then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;part.Transparency = 0
&#9;&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;end

&#9;&#9;&#9;&#9;&#9;createAnim(&quot;Stop&quot;, 0)
&#9;&#9;&#9;&#9;&#9;tool.CrouchZoom.Value = true
&#9;&#9;&#9;&#9;&#9;maxAccuracy.Value = maxAccuracy.Value - 20
&#9;&#9;&#9;&#9;&#9;player.Character.Humanoid.WalkSpeed = 16
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;elseif key == &quot;r&quot; then
&#9;&#9;&#9;if clip.Value &lt; gunVal.Value then
&#9;&#9;&#9;&#9;reload()
&#9;&#9;&#9;end
&#9;&#9;--[[elseif key == &quot;g&quot; then
&#9;&#9;&#9;gIsDown = true
&#9;&#9;&#9;if db == true then
&#9;&#9;&#9;&#9;if not sprinting then
&#9;&#9;&#9;&#9;&#9;tool.CrouchZoom.Value = false
&#9;&#9;&#9;&#9;&#9;db = false
&#9;&#9;&#9;&#9;&#9;if grenades.Value &gt; 0 then
&#9;&#9;&#9;&#9;&#9;&#9;local throwForce = 75
&#9;&#9;&#9;&#9;&#9;&#9;for index, part in pairs(tool:GetChildren()) do
&#9;&#9;&#9;&#9;&#9;&#9;&#9;if part:IsA(&quot;BasePart&quot;) then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;if part.Name ~= &quot;Ironsights&quot; and part.Name ~= &quot;Scope&quot; then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;part.Transparency = 1
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;createAnim(&quot;Throw&quot;, 0)
&#9;&#9;&#9;&#9;&#9;&#9;repeat
&#9;&#9;&#9;&#9;&#9;&#9;&#9;throwForce = throwForce + 5
&#9;&#9;&#9;&#9;&#9;&#9;&#9;wait(0.1)
&#9;&#9;&#9;&#9;&#9;&#9;until throwForce == 150 or gIsDown == false or tool.InUse.Value == false or sprinting == true
&#9;&#9;&#9;&#9;&#9;&#9;createAnim(&quot;Release&quot;, 0)
&#9;&#9;&#9;&#9;&#9;&#9;if tool.InUse.Value == true and sprinting == false then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;local direction = CFrame.new(player.Character[&quot;Right Arm&quot;].Position, mouse.hit.p)
&#9;&#9;&#9;&#9;&#9;&#9;&#9;local velocity = direction.lookVector*throwForce
&#9;&#9;&#9;&#9;&#9;&#9;&#9;grenades.Value = grenades.Value - 1
&#9;&#9;&#9;&#9;&#9;&#9;&#9;throwGrenade(velocity)
&#9;&#9;&#9;&#9;&#9;&#9;&#9;wait(0.5)
&#9;&#9;&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;&#9;&#9;print(&quot;Not in use.&quot;)
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;for index, part in pairs(tool:GetChildren()) do
&#9;&#9;&#9;&#9;&#9;&#9;&#9;if part:IsA(&quot;BasePart&quot;) then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;if part.Name ~= &quot;Ironsights&quot; and part.Name ~= &quot;Scope&quot; then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;part.Transparency = 0
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;tool.CrouchZoom.Value = true
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;db = true
&#9;&#9;&#9;end
&#9;&#9;elseif key == &quot;v&quot; then
&#9;&#9;&#9;if sprinting == false then
&#9;&#9;&#9;&#9;if knifing == false then
&#9;&#9;&#9;&#9;&#9;local knife = game.Lighting.Objects.Knife:clone()
&#9;&#9;&#9;&#9;&#9;local knifeWeld = Instance.new(&quot;Weld&quot;, player.Character)
&#9;&#9;&#9;&#9;&#9;for index, part in pairs(tool:GetChildren()) do
&#9;&#9;&#9;&#9;&#9;&#9;if part:IsA(&quot;BasePart&quot;) then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;if part.Name ~= &quot;Ironsights&quot; and part.Name ~= &quot;Scope&quot; then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;part.Transparency = 1
&#9;&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;createAnim(&quot;Knife&quot;, 0.5)
&#9;&#9;&#9;&#9;&#9;tool.CrouchZoom.Value = false
&#9;&#9;&#9;&#9;&#9;knifing = true
&#9;&#9;&#9;&#9;&#9;knife.User.Value = player
&#9;&#9;&#9;&#9;&#9;knife.Parent = workspace
&#9;&#9;&#9;&#9;&#9;knifeWeld.Part0 = player.Character:findFirstChild(&quot;Right Arm&quot;)
&#9;&#9;&#9;&#9;&#9;knifeWeld.Part1 = knife.Handle
&#9;&#9;&#9;&#9;&#9;knifeWeld.C0 = CFrame.new(0, -1.5, 0)
&#9;&#9;&#9;&#9;&#9;wait(0.7)
&#9;&#9;&#9;&#9;&#9;knife:Remove()
&#9;&#9;&#9;&#9;&#9;knifeWeld:Remove()
&#9;&#9;&#9;&#9;&#9;knifing = false
&#9;&#9;&#9;&#9;&#9;for index, part in pairs(tool:GetChildren()) do
&#9;&#9;&#9;&#9;&#9;&#9;if part:IsA(&quot;BasePart&quot;) then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;if part.Name ~= &quot;Ironsights&quot; and part.Name ~= &quot;Scope&quot; then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;part.Transparency = 0
&#9;&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;tool.CrouchZoom.Value = true
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end]]
&#9;&#9;end
&#9;end
end

function onKeyUp(key)
&#9;local player = game.Players.LocalPlayer
&#9;if key == &quot;e&quot; then
&#9;&#9;if sprinting == true then
&#9;&#9;&#9;sprinting = false
&#9;&#9;end
&#9;elseif key == &quot;g&quot; then
&#9;&#9;gIsDown = false
&#9;end
end

function onEquipped(mouse)
&#9;if tool.InUse.Value == false then
&#9;&#9;tool.InUse.Value = true
&#9;&#9;if bg == nil then
&#9;&#9;&#9;bg = Instance.new(&quot;BodyGyro&quot;, player.Character.Torso)
&#9;&#9;&#9;bg.maxTorque = Vector3.new(1, 1, 1)
&#9;&#9;&#9;bg.P = 100000
&#9;&#9;end

&#9;&#9;updateGui()
&#9;&#9;frame.Parent = player.PlayerGui.ScreenGui
&#9;&#9;mouse.Move:connect(function() 
&#9;&#9;&#9;if bg.Parent ~= nil then
&#9;&#9;&#9;&#9;bg.cframe = CFrame.new(bg.Parent.Position, Vector3.new(mouse.hit.p.x, bg.Parent.Position.y, mouse.hit.p.z))
&#9;&#9;&#9;&#9;print(bg.cframe)
&#9;&#9;&#9;end
&#9;&#9;end)
&#9;&#9;mouse.Button1Down:connect(function() onButton1Down(mouse) end)
&#9;&#9;mouse.Button1Up:connect(function() bIsDown = false end)
&#9;&#9;mouse.KeyDown:connect(function(key) onKeyDown(key, mouse) end)
&#9;&#9;mouse.KeyUp:connect(onKeyUp)
&#9;end
end

function onUnequipped()
&#9;if bg ~= nil then
&#9;&#9;bg.Parent = nil
&#9;&#9;bg = nil
&#9;end
&#9;tool.InUse.Value = false
&#9;frame.Parent = tool
end

tool.Equipped:connect(onEquipped)
tool.Unequipped:connect(onUnequipped)
clip.Changed:connect(updateGui)
ammo.Changed:connect(updateGui)
--grenades.Changed:connect(updateGui)</ProtectedString>
