		<Item class="Script" referent="RBX986">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">GunDetailRemoval</string>
				<ProtectedString name="Source">workspace.ChildAdded:connect(function(child)
&#9;if game.Players:GetPlayerFromCharacter(child) ~= nil then
&#9;&#9;local x = Instance.new(&quot;IntValue&quot;, child)
&#9;&#9;x.Name = &quot;Grenades&quot;
&#9;&#9;x.Value = 2
&#9;&#9;child.ChildAdded:connect(function(part)
&#9;&#9;&#9;if part.Name == &quot;Mark&quot; then
&#9;&#9;&#9;&#9;part.Reflectance = 0.5
&#9;&#9;&#9;&#9;for i = 1, 10 do
&#9;&#9;&#9;&#9;&#9;part.Reflectance = part.Reflectance + .05
&#9;&#9;&#9;&#9;&#9;wait()
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;part:Remove()
&#9;&#9;&#9;elseif part.Name == &quot;Flash&quot; or part.Name == &quot;BulletPath&quot; then
&#9;&#9;&#9;&#9;for i = 1, 2 do
&#9;&#9;&#9;&#9;&#9;part.Transparency = part.Transparency + 0.25
&#9;&#9;&#9;&#9;&#9;wait(.1)
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;part:Remove()
&#9;&#9;&#9;end
&#9;&#9;end)
&#9;end
end)</ProtectedString>
