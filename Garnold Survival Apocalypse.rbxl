		<Item class="Script" referent="RBX21">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">BanScript</string>
				<ProtectedString name="Source">wait()
server = game.NetworkServer 
banList = script.BannedList

playerIP = nil

server.IncommingConnection:connect(function(ip, client) 
&#9;local ipString = tostring(ip)
&#9;local colonNum = string.find(ipString, &quot;:&quot;)
&#9;ipStringMod = string.sub(ipString, 1, colonNum-1)
&#9;print(ipStringMod)
&#9;playerIP = ipStringMod
end)

game.Players.PlayerAdded:connect(function(plr)
&#9;if playerIP ~= nil then
&#9;&#9;local val = Instance.new(&quot;StringValue&quot;, plr)
&#9;&#9;val.Value = playerIP
&#9;&#9;val.Name = &quot;IPVal&quot;
&#9;&#9;plr:WaitForDataReady()
&#9;&#9;if plr:LoadNumber(&quot;Banned&quot;) ~= 0 then
&#9;&#9;&#9;local currentTime = tick()
&#9;&#9;&#9;if currentTime &gt; plr:LoadNumber(&quot;Banned&quot;) then
&#9;&#9;&#9;&#9;plr:SaveNumber(&quot;Banned&quot;, 0)
&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;cloneVal = val:clone()
&#9;&#9;&#9;&#9;cloneVal.Name = plr.Name
&#9;&#9;&#9;&#9;cloneVal.Parent = banList
&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;for i,v in pairs(banList:GetChildren()) do
&#9;&#9;&#9;if v.Value == playerIP or v.Name == plr.Name then
&#9;&#9;&#9;&#9;playerIP = nil
&#9;&#9;&#9;&#9;playerClient = nil
&#9;&#9;&#9;&#9;player = nil
&#9;&#9;&#9;&#9;plr:Remove()
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end)
