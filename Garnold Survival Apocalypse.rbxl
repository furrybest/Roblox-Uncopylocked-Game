&#9;&#9;&#9;&#9;&#9;--extra stuff goes here

&#9;&#9;&#9;&#9;&#9;--Get drinks

&#9;&#9;&#9;&#9;&#9;if target.Name == &quot;Gasoline&quot; then
&#9;&#9;&#9;&#9;&#9;&#9;drinksLeft = maxDrinks
&#9;&#9;&#9;&#9;&#9;&#9;target:Remove()
&#9;&#9;&#9;&#9;&#9;elseif target.Parent.Name == &quot;Car&quot; or target.Parent.Name == &quot;Makeshift Vehicle&quot; or target.Parent.Name == &quot;Motorized Boat&quot;then
&#9;&#9;&#9;&#9;&#9;&#9;if drinksLeft &gt;= 5 then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;fuel = target.Parent.VehicleSeat:findFirstChild(&quot;Fuel&quot;)
&#9;&#9;&#9;&#9;&#9;&#9;&#9;mFuel = target.Parent.VehicleSeat:findFirstChild(&quot;MaxFuel&quot;)
&#9;&#9;&#9;&#9;&#9;&#9;&#9;fuel.Value = mFuel.Value
&#9;&#9;&#9;&#9;&#9;&#9;&#9;drinksLeft = drinksLeft - 5
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;elseif target.Parent.Name == &quot;Truck&quot; then
&#9;&#9;&#9;&#9;&#9;&#9;if drinksLeft == 10 then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;fuel = target.Parent.VehicleSeat:findFirstChild(&quot;Fuel&quot;)
&#9;&#9;&#9;&#9;&#9;&#9;&#9;mFuel = target.Parent.VehicleSeat:findFirstChild(&quot;MaxFuel&quot;)
&#9;&#9;&#9;&#9;&#9;&#9;&#9;fuel.Value = mFuel.Value
&#9;&#9;&#9;&#9;&#9;&#9;&#9;drinksLeft = drinksLeft - 10
