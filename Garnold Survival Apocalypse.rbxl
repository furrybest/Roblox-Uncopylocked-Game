					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">LocalScript</string>
					<ProtectedString name="Source">local maps = game:GetService(&quot;InsertService&quot;):GetCollection(351713) -- The Set of S:A Maps
local player = game.Players.LocalPlayer
local source = game.Workspace.VoteManager
local statusSource = source.Status

local frame = script.Parent
local container = frame.Container
local scrollFrame = container.ScrollFrame
local side = frame.SideFrame
local bottom = frame.BottomFrame
local chatFrame = side.ChatBox
local status = side.Status

local timeFrame = bottom.TimeLeft

local buttonTemp = frame.ExampleMap
local chatTemp = frame.ChatTemplate

local canVote = true

set = 1
maxSets = math.ceil(#maps/6)

function onChatted(plr, message)
&#9;local max = 50
&#9;local length = string.len(message)
&#9;if length &gt; max then
&#9;&#9;message = string.sub(message, 1, max)..&quot;...&quot;
&#9;end
&#9;local chat = chatTemp:Clone()
&#9;chat.Text = plr.Name..&quot;: &quot;..message
&#9;chat.Visible = true
&#9;for index, child in pairs(chatFrame:GetChildren()) do
&#9;&#9;child.Position = UDim2.new(0, 0, child.Position.Y.Scale + 0.1, 0)
&#9;&#9;if child.Position.Y.Scale &gt; 1 then
&#9;&#9;&#9;child:Remove()
&#9;&#9;end
&#9;end
&#9;chat.Parent = chatFrame
end

function onButton1Down(map, button)
&#9;if canVote then
&#9;&#9;for index, child in pairs(container:GetChildren()) do
&#9;&#9;&#9;if child ~= button and child ~= scrollFrame then
&#9;&#9;&#9;&#9;child:Remove()
&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;local vote = button.Vote
&#9;&#9;local back = button.Back
&#9;&#9;button:TweenSizeAndPosition(UDim2.new(1.775, 0, 1, 0), UDim2.new(0, 0, 0, 0), Out, Quad, 0.25, true, nil)
&#9;&#9;button.ImageButton.Position = UDim2.new(0.05, 0, 0.075, 0)
&#9;&#9;button.ImageButton.Size = UDim2.new(0.35, 0, 0.8, 0)
&#9;&#9;button.MapName.Position = UDim2.new(0.5, 0, 0.1, 0)
&#9;&#9;button.MapName.Size = UDim2.new(0.5, 0, 0.25, 0)
&#9;&#9;button.Creator.Position = UDim2.new(0.5, 0, 0.25, 0)
&#9;&#9;button.Creator.Size = UDim2.new(0.5, 0, 0.25, 0)
&#9;&#9;vote.Visible = true
&#9;&#9;back.Visible = true
&#9;&#9;&#9;
&#9;&#9;vote.MouseButton1Down:connect(function() 
&#9;&#9;&#9;local mapVotes = source.Maps
&#9;&#9;&#9;scrollFrame.Visible = false
&#9;&#9;&#9;found = false
&#9;&#9;&#9;for index, child in pairs(mapVotes:GetChildren()) do
&#9;&#9;&#9;&#9;if child.Name == button.Name then
&#9;&#9;&#9;&#9;&#9;found = true
&#9;&#9;&#9;&#9;&#9;child.Value = child.Value + 1
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;&#9;if not found then
&#9;&#9;&#9;&#9;val = Instance.new(&quot;IntValue&quot;, mapVotes)
&#9;&#9;&#9;&#9;val.Name = button.Name
&#9;&#9;&#9;&#9;val.Value = 1
&#9;&#9;&#9;end
&#9;&#9;&#9;status.Text = &quot;You&apos;ve voted for &quot;..map.Name..&quot;.&quot;
&#9;&#9;&#9;vote:Remove()
&#9;&#9;&#9;back:Remove()
&#9;&#9;end)
&#9;&#9;back.MouseButton1Down:connect(function()
&#9;&#9;&#9;button:Remove()
&#9;&#9;&#9;loadMapButtons()
&#9;&#9;end)
&#9;end
end

function clearCurrentButtons(amnt)
&#9;buttons = container:GetChildren()
&#9;for index, child in pairs(buttons) do
&#9;&#9;if child ~= scrollFrame then
&#9;&#9;&#9;child:TweenPosition(UDim2.new(child.Position.X.Scale, 0, child.Position.Y.Scale+(-1*amnt)), Out, Quad, 0.2, true, nil)
&#9;&#9;end
&#9;end
&#9;wait(0.25)
&#9;for index, child in pairs(buttons) do
&#9;&#9;if child ~= scrollFrame then
&#9;&#9;&#9;child:Remove()
&#9;&#9;end
&#9;end&#9;
end

function scroll(amnt)
&#9;set = set + amnt
&#9;clearCurrentButtons(amnt)
&#9;print(set)
&#9;loadMapButtons(set)
end

function loadMapButtons()
&#9;local x = 0
&#9;local y = 0
&#9;for index, map in pairs(maps) do
&#9;&#9;if index &lt;= set*6 and index &gt; (set*6)-6 then
&#9;&#9;&#9;local unselected = true
&#9;&#9;&#9;local start = &quot;http://www.roblox.com/Game/Tools/ThumbnailAsset.ashx?fmt=png&amp;wd=110&amp;ht=110&amp;aid=&quot;
&#9;&#9;&#9;local button = buttonTemp:clone()
&#9;&#9;&#9;button.Visible = true
&#9;&#9;&#9;button.ImageButton.Image = start..map[&quot;AssetId&quot;]
&#9;&#9;&#9;button.Name = map[&quot;Name&quot;]
&#9;&#9;&#9;button.MapName.Text = map[&quot;Name&quot;]
&#9;&#9;&#9;button.Creator.Text = map[&quot;CreatorName&quot;]
&#9;&#9;&#9;button.Parent = container
&#9;&#9;&#9;button:TweenPosition(UDim2.new(x, 0, y, 0), Out, Quad, 0.2, false, nil)
&#9;&#9;&#9;if x &lt; 0.6 then
&#9;&#9;&#9;&#9;x = x + 0.3
&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;x = 0
&#9;&#9;&#9;&#9;y = y + 0.6
&#9;&#9;&#9;end
&#9;&#9;&#9;button.ImageButton.MouseEnter:connect(function() 
&#9;&#9;&#9;&#9;if unselected == true then
&#9;&#9;&#9;&#9;&#9;button:TweenSize(UDim2.new(0.5, 0, 0.5, 0), Out, Quad, 0.2, true, nil)
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end)
&#9;&#9;&#9;button.ImageButton.MouseLeave:connect(function() 
&#9;&#9;&#9;&#9;if unselected == true then
&#9;&#9;&#9;&#9;&#9;button:TweenSize(UDim2.new(0.4, 0, 0.4, 0), Out, Quad, 0.2, true, nil)
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end)
&#9;&#9;&#9;button.ImageButton.MouseButton1Down:connect(function() unselected = false onButton1Down(map, button) end)
&#9;&#9;end
&#9;end
end

statusSource.Changed:connect(function()
&#9;if statusSource.Value == &quot;Waiting&quot; then
&#9;&#9;canVote = false
&#9;&#9;status.Text = &quot;3 players are needed to start.&quot;
&#9;elseif statusSource.Value == &quot;Voting&quot; then
&#9;&#9;canVote = true
&#9;&#9;status.Text = &quot;Vote for a map.&quot;
&#9;elseif statusSource.Value == &quot;Counting&quot; then
&#9;&#9;canVote = false
&#9;&#9;status.Text = &quot;Voting has ended&quot;
&#9;elseif statusSource.Value == &quot;Loading&quot; then
&#9;&#9;status.Text = source.Chosen.Value..&quot; has been chosen!&quot;
&#9;&#9;wait(1.5)
&#9;&#9;status.Text = &quot;Loading &quot;..source.Chosen.Value..&quot;...&quot;
&#9;elseif statusSource.Value == &quot;Finished&quot; then
&#9;&#9;status.Text = source.Chosen.Value..&quot; is finished loading, &quot;
&#9;&#9;wait(1.5)
&#9;&#9;status.Text = &quot;Enjoy.&quot;
&#9;&#9;frame:Remove()
&#9;end
end)

source.Changed:connect(function()
&#9;timeFrame.Text = &quot;Time left: &quot;..source.Value
end )

for index, child in pairs(game.Players:GetChildren()) do
&#9;child.Chatted:connect(function(msg) onChatted(child, msg) end)
end
game.Players.ChildAdded:connect(function(plr)
&#9;plr.Chatted:connect(function(msg) onChatted(plr, msg) end)
end)

scrollFrame.Up.MouseButton1Down:connect(function()
&#9;if set &gt; 1 and set &lt;= maxSets then
&#9;&#9;scroll(-1) 
&#9;end
end)

scrollFrame.Down.MouseButton1Down:connect(function()
&#9;if set &gt;= 1 and set &lt; maxSets then
&#9;&#9;scroll(1) 
&#9;end
end)

loadMapButtons()
</ProtectedString>
