				<Item class="LocalScript" referent="RBX8982">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">LocalScript</string>
						<ProtectedString name="Source">wait(0.25)
local tool = script.Parent
local on = tool.Name
local handle = tool.Handle

local headDamage = 2
local torsoDamage = 1
local armsDamage = 0.5
local legsDamage = 0.75
local damage = 0
local reloadTime = 3
local range = 30
local debounce = true

local quality = 5 --more = worse
local fireScript = game.Workspace.FireScript:clone()

function slash()
&#9;local s = Instance.new(&quot;StringValue&quot;)
&#9;s.Name = &quot;toolanim&quot;
&#9;s.Value = &quot;Slash&quot;
&#9;s.Parent = tool
end

function onButton1Down(mouse)
&#9;if debounce == true then

&#9;&#9;slash()

&#9;&#9;local target = mouse.Target
&#9;&#9;local pos = mouse.hit.p

&#9;&#9;if target ~= nil then

&#9;&#9;&#9;if target.Parent ~= nil then

&#9;&#9;&#9;&#9;if (handle.Position - target.Position).magnitude &lt; range then

&#9;&#9;&#9;&#9;&#9;local h = target.Parent:findFirstChild(&quot;Humanoid&quot;)

&#9;&#9;&#9;&#9;&#9;if h ~= nil then

&#9;&#9;&#9;&#9;&#9;&#9;if target.Name == &quot;Head&quot; then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;h:TakeDamage(headDamage * damage)
&#9;&#9;&#9;&#9;&#9;&#9;end

&#9;&#9;&#9;&#9;&#9;&#9;if target.Name == &quot;Torso&quot; then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;h:TakeDamage(torsoDamage * damage)
&#9;&#9;&#9;&#9;&#9;&#9;end

&#9;&#9;&#9;&#9;&#9;&#9;if target.Name == &quot;Left Arm&quot; or target.Name == &quot;Right Arm&quot; then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;h:TakeDamage(armsDamage * damage)
&#9;&#9;&#9;&#9;&#9;&#9;end

&#9;&#9;&#9;&#9;&#9;&#9;if target.Name == &quot;Left Leg&quot; or target.Name == &quot;Right Leg&quot; then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;h:TakeDamage(armsDamage * damage)
&#9;&#9;&#9;&#9;&#9;&#9;end

&#9;&#9;&#9;&#9;&#9;end

&#9;&#9;&#9;&#9;&#9;if math.random(1, quality) == 1 then
&#9;&#9;&#9;&#9;&#9;&#9;local sc = fireScript:clone()
&#9;&#9;&#9;&#9;&#9;&#9;sc.Disabled = false
&#9;&#9;&#9;&#9;&#9;&#9;sc.Parent = target
&#9;&#9;&#9;&#9;&#9;end

&#9;&#9;&#9;&#9;end

&#9;&#9;&#9;end

&#9;&#9;end

&#9;&#9;tool.Name = &quot;Resting&quot;

&#9;&#9;debounce = false

&#9;&#9;wait(reloadTime)

&#9;&#9;tool.Name = on

&#9;&#9;debounce = true

&#9;end
end

function onEquipped(mouse)
&#9;mouse.Button1Down:connect(function() onButton1Down(mouse) end)
end

tool.Equipped:connect(onEquipped)
</ProtectedString>
