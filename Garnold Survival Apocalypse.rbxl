&#9;&#9;&#9;elseif accuracy.Value &lt; 65 and accuracy.Value &gt;= 55 then
&#9;&#9;&#9;&#9;mouse.Icon = http..icons[7]
&#9;&#9;&#9;elseif accuracy.Value &lt; 55 and accuracy.Value &gt;= 45 then
&#9;&#9;&#9;&#9;mouse.Icon = http..icons[8]
&#9;&#9;&#9;elseif accuracy.Value &lt; 45 and accuracy.Value &gt;= 65 then
&#9;&#9;&#9;&#9;mouse.Icon = http..icons[9]
&#9;&#9;&#9;elseif accuracy.Value &lt; 35 and accuracy.Value &gt;= 25 then
