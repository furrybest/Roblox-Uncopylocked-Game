		<Item class="Script" referent="RBX989">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Time</string>
				<ProtectedString name="Source">wait(1)
time = tick()

function getLeapyears(start, current)
&#9;return (current-start)/4
end

function getTime()
&#9;local start = 1992
&#9;local leapYearStart = 1992
&#9;local seconds = time
&#9;local minutes = seconds/60
&#9;local days = minutes/60/24
&#9;local weeks = math.floor(days/7)

&#9;local years = days/365
&#9;local floorYears = math.floor(days/365)

&#9;local currentYear = start+years
&#9;local leapYears = math.floor(getLeapyears(start, currentYear))

&#9;local yearsMod = (days-leapYears)/365
&#9;local floorYearsMod = math.floor((days+leapYears)/365)
&#9;local currentYearMod = math.floor(start+yearsMod)

&#9;local currentWeek = (yearsMod-floorYearsMod)*52
&#9;local currentWeekFloor = math.floor((yearsMod-floorYearsMod)*52)

&#9;local currentDayOfWeek = math.floor((currentWeek-currentWeekFloor)*7)+1

&#9;
&#9;local currentDayOfYear = ((yearsMod-floorYearsMod)*365)+1
&#9;local currentDayOfYearFloor = math.floor((yearsMod-floorYearsMod)*365)+1

&#9;local currentHour = (currentDayOfYear-currentDayOfYearFloor)*24
&#9;local currentHourFloor = math.floor((currentDayOfYear-currentDayOfYearFloor)*24)

&#9;local currentMinute = (currentHour-currentHourFloor)*60
&#9;local currentMinuteFloor = math.floor((currentHour-currentHourFloor)*60)

&#9;local currentSecond = (currentMinute-currentMinuteFloor)*60
&#9;local currentSecondFloor = math.floor((currentMinute-currentMinuteFloor)*60)
&#9;
&#9;return currentYearMod, currentDayOfWeek, currentDayOfYearFloor, currentHourFloor, currentMinuteFloor, currentSecondFloor
end

function getMonth(day, year)
&#9;print(day, year)
&#9;local dayCount = 0
&#9;local month = nil
&#9;local dayOfMonth = nil
&#9;local monthTable = {{&quot;Jan.&quot;, 31}, {&quot;Feb.&quot;, 28, 29}, {&quot;Mar.&quot;, 31}, {&quot;Apr.&quot;, 30}, {&quot;May&quot;, 31}, {&quot;Jun.&quot;, 30}, {&quot;Jul.&quot;, 31}, {&quot;Aug&quot;, 31}, {&quot;Sep.&quot;, 30}, {&quot;Oct.&quot;, 31}, {&quot;Nov.&quot;, 30}, {&quot;Dec.&quot;, 31}}
&#9;if year/4 == math.floor(year/4) then
&#9;&#9;table.remove(monthTable[2], monthTable[2][2])
&#9;else
&#9;&#9;table.remove(monthTable[2], monthTable[2][3])
&#9;end
&#9;for index, monthK in pairs(monthTable) do
&#9;&#9;dayCount = dayCount + monthK[2]
&#9;&#9;if dayCount &lt; day then
&#9;&#9;&#9;print(dayCount, day)
&#9;&#9;else
&#9;&#9;&#9;print(monthTable[index][1])
&#9;&#9;&#9;month = monthTable[index][1]
&#9;&#9;&#9;dayOfMonth = monthK[2]-(dayCount-day)
&#9;&#9;&#9;break
&#9;&#9;end
&#9;end
&#9;print(month, dayOfMonth)
&#9;return month, dayOfMonth
end
&#9;
function getStandardTime(hour, minute, second)
&#9;hourMod = nil
&#9;minuteMod = minute
&#9;secondMod = second
&#9;if minute &lt; 10 then
&#9;&#9;minuteMod = &quot;0&quot;..minute
&#9;end
&#9;if second &lt; 10 then
&#9;&#9;secondMod = &quot;0&quot;..second
&#9;end
&#9;if hour &gt; 12 then
&#9;&#9;hourMod = (hour-12)..&quot;:&quot;..minuteMod..&quot;:&quot;..secondMod..&quot; PM&quot;
&#9;elseif hour &gt; 0 and hour &lt; 12 then
&#9;&#9;hourMod = hour..&quot;:&quot;..minuteMod..&quot;:&quot;..secondMod..&quot; AM&quot;
&#9;elseif hour == 12 then
&#9;&#9;hourMod = &quot;12&quot;..&quot;:&quot;..minuteMod..&quot;:&quot;..secondMod..&quot; PM&quot;
&#9;elseif hour == 0 then
&#9;&#9;hourMod = &quot;12&quot;..&quot;:&quot;..minuteMod..&quot;:&quot;..secondMod..&quot; AM&quot;
&#9;end
&#9;return hourMod
end

function outputTime()
&#9;local year, dayOfWeek, dayOfYear, hour, minute, second = getTime()
&#9;local month, dayOfMonth = getMonth(dayOfYear, year)
&#9;local standardTime = getStandardTime(hour, minute, second)
&#9;script.Date.Value = month..&quot; &quot;..dayOfMonth..&quot;, &quot;..year..&quot;, &quot;..standardTime

&#9;game.Lighting.TimeOfDay = hour..&quot;.&quot;..minute..&quot;.&quot;..second
end

while true do
&#9;wait(1/15)
&#9;time = time + 4
&#9;coroutine.resume(coroutine.create(outputTime))
end
</ProtectedString>
