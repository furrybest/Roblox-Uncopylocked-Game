			<Item class="Script" referent="RBX33">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Farming</string>
					<ProtectedString name="Source">function onChildAdded(new)
&#9;print(&quot;New child!&quot;)
&#9;service(new)
end&#9;

function service(value)
&#9;local part = value.Value
&#9;local owner = value.Name

&#9;--Custom Function

&#9;--Delay it
&#9;wait(math.random(60, 120))

&#9;--Free the compost
&#9;part.MyCompost.Value.Locked = false

&#9;--Find the plant
&#9;local plant = nil

&#9;if part.Name == &quot;Carrot Seed Pack&quot; then
&#9;&#9;plant = game.Lighting.Farming:findFirstChild(&quot;Carrot Flower&quot;):clone()
&#9;elseif part.Name == &quot;Corn Seed Pack&quot; then
&#9;&#9;plant = game.Lighting.Farming:findFirstChild(&quot;Corn&quot;):clone()
&#9;elseif part.Name == &quot;Grape Seed Pack&quot; then
&#9;&#9;plant = game.Lighting.Farming:findFirstChild(&quot;Grape&quot;):clone()
&#9;elseif part.Name == &quot;Pumpkin Seed Pack&quot; then
&#9;&#9;plant = game.Lighting.Farming:findFirstChild(&quot;Pumpkin Seed&quot;):clone()
&#9;elseif part.Name == &quot;Zombie Seed&quot; then
&#9;&#9;plant = game.Lighting.Farming:findFirstChild(&quot;Grown Zombie&quot;):clone()
&#9;&#9;plant.Owner.Value = game.Players:findFirstChild(owner)
&#9;elseif part.Name == &quot;Wheat Seed Pack&quot; then
&#9;&#9;plant = game.Lighting.Farming:findFirstChild(&quot;Wheat Seed&quot;):clone()
&#9;elseif part.Name ~=  &quot;Wheat Seed Pack&quot; then
&#9;&#9;plant = game.Lighting.Farming:findFirstChild(part.Name):clone()
&#9;end

&#9;--Set the primary part
&#9;local c = plant:GetChildren()
&#9;local primaryPart = nil

&#9;for index, child in pairs(c) do
&#9;&#9;local pp = child:findFirstChild(&quot;PrimaryPart&quot;)
&#9;&#9;if pp ~= nil then
&#9;&#9;&#9;primaryPart = child
&#9;&#9;&#9;pp:remove()
&#9;&#9;&#9;break
&#9;&#9;end
&#9;end

&#9;plant.PrimaryPart = primaryPart

&#9;--Find the seed position, then remove it
&#9;local pos = part.Position
&#9;part:remove()

&#9;--Grow the plant
&#9;plant.Parent = game.Workspace
&#9;plant:MoveTo(pos)
&#9;plant:MakeJoints()
&#9;if plant.Owner ~= nil then
&#9;PLAYERHELP = script.StringValue.Value
&#9;plant.Owner.Value = PLAYERHELP
&#9;PLAYERHELP:Remove()
&#9;end
&#9;--/Custom Function

&#9;value:remove()
end

script.ChildAdded:connect(onChildAdded)</ProtectedString>
