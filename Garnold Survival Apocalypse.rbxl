local button = script.Parent
local frame = button.Parent.Tools

function onMB1D()
&#9;if frame.Visible == false then
&#9;&#9;frame.Visible = true
&#9;&#9;button.Text = &quot;Close Tool Pocket&quot;
&#9;else
&#9;&#9;frame.Visible = false
&#9;&#9;button.Text = &quot;Open Tool Pocket&quot;
&#9;end
end

button.MouseButton1Down:connect(onMB1D)</ProtectedString>
