					<Item class="LocalScript" referent="RBX8072">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">LocalScript</string>
							<ProtectedString name="Source">local stats = script.Parent:GetChildren()

for index, child in pairs(stats) do
&#9;if child.className == &quot;TextLabel&quot; then
&#9;&#9;local statName = child.Name
&#9;&#9;local player = script.Parent.Parent.Parent.Parent.Parent --Script, Label, Frame, GuiMain, PlayerGui, Player
&#9;&#9;local stat = player.stats:findFirstChild(statName)

&#9;&#9;stat.Changed:connect(function()
&#9;&#9;&#9;local newVal = stat.Value
&#9;&#9;&#9;local statBar = script.Parent.Parent:findFirstChild(statName..&quot;Bar&quot;)
&#9;&#9;&#9;statBar.Size = UDim2.new(0.33, 0, -(newVal/100), 0)
&#9;&#9;&#9;child.Text = newVal
&#9;&#9;end)&#9;
&#9;end
end

</ProtectedString>
