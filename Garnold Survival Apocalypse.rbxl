		<Item class="Script" referent="RBX987">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">ZombieSpawner</string>
				<ProtectedString name="Source">local MAX_ZOMBIES = script.Max.Value * 3

function getSpawns()
&#9;local c = game.Workspace.GameMap.Spawns:GetChildren()
&#9;local spawns = {}

&#9;for index, child in pairs(c) do
&#9;&#9;if child.Name == &quot;ZombieSpawn&quot; then
&#9;&#9;&#9;table.insert(spawns, child)
&#9;&#9;end
&#9;end

&#9;return spawns
end

function pickRandomChild(tab)
&#9;return tab[math.random(1, #tab)]
end

function spawnZombie(type)
&#9;local zombies = game.Lighting.Zombies:GetChildren()
&#9;--local npc = game.Lighting.NPC
&#9;local spawns = getSpawns()

&#9;local zombie = pickRandomChild(zombies):clone()
&#9;local spawn = pickRandomChild(spawns)

&#9;zombie.Parent = game.Workspace
&#9;zombie:MakeJoints()
&#9;zombie:MoveTo(spawn.Position)
end

function zombieCount()
&#9;local zombies = {}

&#9;local c = game.Workspace:GetChildren()

&#9;for index, child in pairs(c) do
&#9;&#9;if child.Name == &quot;Zombie&quot; or child.Name == &quot;Runner&quot; or child.Name == &quot;Skulker&quot; or child.Name == &quot;Tank&quot; then
&#9;&#9;&#9;table.insert(zombies, child)
&#9;&#9;end
&#9;end

&#9;return #zombies
end

while true do
&#9;local hour = tonumber(string.sub(game.Lighting.TimeOfDay, 1, 2))
&#9;if hour &gt;= 20 or hour &lt; 6 then
&#9;&#9;if zombieCount() &lt; MAX_ZOMBIES then
&#9;&#9;&#9;if math.random(1, 2) == 1 then
&#9;&#9;&#9;&#9;spawnZombie()
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
&#9;wait(1)
end
</ProtectedString>
