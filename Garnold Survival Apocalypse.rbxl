					<Item class="LocalScript" referent="RBX11405">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Zoom Script</string>
							<ProtectedString name="Source">wait(0.5)
local player = game.Players.LocalPlayer
gui = script.GUI
tool = script.Parent

accuracy = tool.Accuracy
maxAccuracy = tool.MaxAccuracy

accImprov = 0

db = true

function createAnim(commandName, value)
&#9;local command = Instance.new(&quot;NumberValue&quot;) -- Creates animation
&#9;command.Name = commandName
&#9;command.Value = value
&#9;command.Parent = tool.ArmWelding
end

function onEquipped(mouse)
&#9;mouse.KeyDown:connect(function(key) onKeyDown(key, mouse) end)
&#9;mouse.KeyUp:connect(function(key) onKeyUp(key, mouse) end)
end

function onKeyDown(key, mouse) 
&#9;if tool.CrouchZoom.Value == true then
&#9;&#9;if key == &quot;q&quot; then
&#9;&#9;&#9;if db == true then
&#9;&#9;&#9;&#9;db = false
&#9;&#9;&#9;&#9;if tool.ClassType.Value == &quot;Sniper&quot; then
&#9;&#9;&#9;&#9;&#9;accImprov = 45
&#9;&#9;&#9;&#9;elseif tool.ClassType.Value == &quot;Shotgun&quot; then
&#9;&#9;&#9;&#9;&#9;accImprov = 5
&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;accImprov = 20
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;createAnim(&quot;Aim&quot;, 0)
&#9;&#9;&#9;&#9;if tool.IronsightsOn.Value == true then
&#9;&#9;&#9;&#9;&#9;accuracy.Value = accuracy.Value - accImprov
&#9;&#9;&#9;&#9;&#9;maxAccuracy.Value = maxAccuracy.Value - accImprov

&#9;&#9;&#9;&#9;&#9;--[[zoomCFrame = CFrame.new(tool.Handle.Position, mouse.hit.p)
&#9;&#9;&#9;&#9;&#9;tool.Handle.CFrame = zoomCFrame
&#9;&#9;&#9;&#9;&#9;game.Workspace.CurrentCamera.CameraSubject = tool.Ironsights
&#9;&#9;&#9;&#9;&#9;game.Workspace.CurrentCamera.CameraType = 1]]
&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;gui.Parent = player.PlayerGui
&#9;&#9;&#9;&#9;&#9;accuracy.Value = accuracy.Value - accImprov
&#9;&#9;&#9;&#9;&#9;maxAccuracy.Value = maxAccuracy.Value - accImprov

&#9;&#9;&#9;&#9;&#9;local zoomPart = Instance.new(&quot;Part&quot;)
&#9;&#9;&#9;&#9;&#9;zoomPart.Name = player.Name..&quot;Zoom&quot;
&#9;&#9;&#9;&#9;&#9;zoomPart.Size = Vector3.new(2, 2, 2)
&#9;&#9;&#9;&#9;&#9;zoomPart.Transparency = 1
&#9;&#9;&#9;&#9;&#9;zoomPart.Anchored = true
&#9;&#9;&#9;&#9;&#9;zoomPart.Locked = true
&#9;&#9;&#9;&#9;&#9;zoomPart.CanCollide = false
&#9;&#9;&#9;&#9;&#9;zoomCFrame = CFrame.new(player.Character.Head.CFrame.p, mouse.hit.p)
&#9;&#9;&#9;&#9;&#9;zoomPart.CFrame = player.Character.Head.CFrame + (zoomCFrame.lookVector*((player.Character.Head.Position-mouse.hit.p).magnitude/2))
&#9;&#9;&#9;&#9;&#9;game.Workspace.CurrentCamera.CameraSubject = zoomPart
&#9;&#9;&#9;&#9;&#9;game.Workspace.CurrentCamera.CameraType = 1
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end 
&#9;end
end

function onKeyUp(key, mouse)
&#9;if key == &quot;q&quot; then
&#9;&#9;if db == false then
&#9;&#9;&#9;db = true
&#9;&#9;&#9;createAnim(&quot;UnAim&quot;)
&#9;&#9;&#9;accuracy.Value = accuracy.Value + accImprov
&#9;&#9;&#9;maxAccuracy.Value = maxAccuracy.Value + accImprov

&#9;&#9;&#9;game.Workspace.CurrentCamera.CameraSubject = player.Character.Humanoid
&#9;&#9;&#9;game.Workspace.CurrentCamera.CameraType = &quot;Custom&quot;
&#9;&#9;&#9;gui.Parent = script
&#9;&#9;end
&#9;end
end

tool.Equipped:connect(onEquipped)

tool.CrouchZoom.Changed:connect(function()
&#9;if tool.CrouchZoom.Value == false then
&#9;&#9;if db == false then
&#9;&#9;&#9;db = true
&#9;&#9;&#9;accuracy.Value = accuracy.Value + accImprov
&#9;&#9;&#9;maxAccuracy.Value = maxAccuracy.Value + accImprov

&#9;&#9;&#9;game.Workspace.CurrentCamera.CameraSubject = player.Character.Humanoid
&#9;&#9;&#9;game.Workspace.CurrentCamera.CameraType = &quot;Custom&quot;
&#9;&#9;&#9;gui.Parent = script
&#9;&#9;end
&#9;end
end)

</ProtectedString>
