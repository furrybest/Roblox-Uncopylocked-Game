				<string name="Name">InventoryGiver</string>
				<ProtectedString name="Source">function givePack(player)
&#9;local value = Instance.new(&quot;BoolValue&quot;)
&#9;value.Name = &quot;InAColony&quot;
&#9;value.Parent = player
&#9;value.Value = false
&#9;local backup = game.Lighting:findFirstChild(player.Name..&quot;Backup&quot;)
&#9;if backup ~= nil then
&#9;&#9;backup.Inventory.Parent = player
&#9;&#9;backup:Remove()
&#9;else
&#9;&#9;local pack = Instance.new(&quot;Model&quot;)
&#9;&#9;pack.Name = &quot;Inventory&quot;
&#9;&#9;pack.Parent = player
&#9;&#9;local items = Instance.new(&quot;IntValue&quot;)
&#9;&#9;items.Parent = pack
&#9;&#9;items.Name = &quot;Items&quot;
&#9;&#9;local maxItems = Instance.new(&quot;IntValue&quot;)
&#9;&#9;maxItems.Parent = pack
&#9;&#9;maxItems.Value = 20
&#9;&#9;maxItems.Name = &quot;MaxItems&quot;
&#9;end
end

game.Players.ChildAdded:connect(function(child)
&#9;givePack(child)
end)

game.Players.PlayerRemoving:connect(function(child) -- Inventory backup
&#9;local backupModel = Instance.new(&quot;Model&quot;, game.Lighting)
&#9;local inv = child.Inventory:clone()
&#9;backupModel.Name = child.Name..&quot;Backup&quot;
&#9;inv.Parent = backupModel
&#9;wait(120)
&#9;backupModel:Remove()
end)</ProtectedString>
