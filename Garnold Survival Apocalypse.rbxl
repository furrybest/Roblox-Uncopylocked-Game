					<string name="Name">Read</string>
					<ProtectedString name="Source">-- This is one of the most Important objects of the game. 
-- It is the Zombies&apos; POF(Point of reference) to the world. 
-- As long as it doesn&apos;t get moved or deleted, Zombies will remain normal.</ProtectedString>
