					<string name="Name">Disabler</string>
					<ProtectedString name="Source">while true do 
wait(1)
&#9;if script.Parent.Humanoid.Health &lt; 1 then
&#9;&#9;t = script.Parent:GetChildren()
&#9;&#9;for index, child in pairs(t) do
&#9;&#9;&#9;if child.Name == &quot;zarm&quot; then 
&#9;&#9;&#9;&#9;child.Deadly.Disabled = true
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end
