		<Item class="Script" referent="RBX982">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">OwnershipGiver</string>
				<ProtectedString name="Source">function givePack(player)
&#9;local buildings = Instance.new(&quot;Model&quot;)
&#9;buildings.Name = &quot;Buildings&quot;
&#9;buildings.Parent = player
end

game.Players.ChildAdded:connect(function(child)
&#9;givePack(child)
end)</ProtectedString>
