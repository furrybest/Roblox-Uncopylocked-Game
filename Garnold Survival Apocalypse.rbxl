				<Item class="Script" referent="RBX8074">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">local label = script.Parent
local player = label.Parent.Parent.Parent
local char = player.Character

local bp = Instance.new(&quot;BodyPosition&quot;)
bp.position = Vector3.new(0, 25, 0)
bp.maxForce = Vector3.new(0, 4e3, 0)

local swimming = false
local count = 0

function waitForPart(name, parent)
&#9;while parent:findFirstChild(name) == nil do
&#9;&#9;wait()
&#9;end

&#9;return parent:findFirstChild(name)
end

local torso = waitForPart(&quot;Torso&quot;, char)

function onChanged(name)
&#9;if name == &quot;Position&quot; then
&#9;&#9;if workspace:findFirstChild(&quot;OceanModel&quot;) ~= nil then
&#9;&#9;&#9;if torso.Position.y &lt; 25.5 then
&#9;&#9;&#9;&#9;label.Visible = true
&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;label.Visible = false
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end

function onMouseButton1Down()
&#9;if swimming then
&#9;&#9;bp.Parent = nil
&#9;&#9;swimming = false
&#9;&#9;label.Text = &quot;Swim&quot;
&#9;&#9;rest()
&#9;else
&#9;&#9;if label.Active then
&#9;&#9;&#9;bp.Parent = torso
&#9;&#9;&#9;swimming = true
&#9;&#9;&#9;label.Text = &quot;Swimming&quot;
&#9;&#9;end
&#9;end
end

label.MouseButton1Down:connect(onMouseButton1Down)

function rest()
&#9;label.Active = false
&#9;label.Text = &quot;Resting&quot;
&#9;torso.Velocity = Vector3.new(0, 50, 0)
&#9;wait(count)
&#9;label.Active = true
&#9;label.Text = &quot;Swim&quot;
&#9;count = 0
end

delay(0, function()
&#9;while true do
&#9;&#9;if swimming then
&#9;&#9;&#9;count = count + 1
&#9;&#9;end

&#9;&#9;if count &gt; 25 then
&#9;&#9;&#9;bp.Parent = nil
&#9;&#9;&#9;swimming = false
&#9;&#9;&#9;rest()
&#9;&#9;end

&#9;&#9;wait(1)
&#9;end
end)

delay(0, function()
&#9;local lastPos = torso.Position
&#9;while true do
&#9;&#9;wait()
&#9;&#9;if torso.Position ~= lastPos then
&#9;&#9;&#9;onChanged(&quot;Position&quot;)
&#9;&#9;end
&#9;&#9;lastPos = torso.Position
&#9;end
end)

</ProtectedString>
