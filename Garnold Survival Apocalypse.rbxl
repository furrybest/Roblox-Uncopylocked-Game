						<ProtectedString name="Source">tool = script.Parent
accuracy = tool.Accuracy
maxAccuracy = tool.MaxAccuracy
http = &quot;http://www.roblox.com/asset/?id=&quot;
icons = {&quot;39621740&quot;, &quot;39621784&quot;, &quot;39621841&quot;, &quot;39621897&quot;, &quot;39621939&quot;, &quot;39621995&quot;, &quot;39622044&quot;, &quot;39622136&quot;, &quot;39622176&quot;, &quot;39622228&quot;, &quot;39622268&quot;, &quot;39622329&quot;}

function onEquippedLocal(mouse)
&#9;cor = coroutine.create(function ()
&#9;&#9;accuracy.Changed:connect(function()
&#9;&#9;&#9;if accuracy.Value &lt;= 100 and accuracy.Value &gt;= 95 then
&#9;&#9;&#9;&#9;mouse.Icon = http..icons[1]
&#9;&#9;&#9;elseif accuracy.Value &lt; 95 and accuracy.Value &gt;= 90 then
&#9;&#9;&#9;&#9;mouse.Icon = http..icons[2]
&#9;&#9;&#9;elseif accuracy.Value &lt; 90 and accuracy.Value &gt;= 85 then
&#9;&#9;&#9;&#9;mouse.Icon = http..icons[3]
&#9;&#9;&#9;elseif accuracy.Value &lt; 85 and accuracy.Value &gt;= 80 then
&#9;&#9;&#9;&#9;mouse.Icon = http..icons[4]
&#9;&#9;&#9;elseif accuracy.Value &lt; 80 and accuracy.Value &gt;= 75 then
&#9;&#9;&#9;&#9;mouse.Icon = http..icons[5]
&#9;&#9;&#9;elseif accuracy.Value &lt; 75 and accuracy.Value &gt;= 65 then
&#9;&#9;&#9;&#9;mouse.Icon = http..icons[6]
&#9;&#9;&#9;elseif accuracy.Value &lt; 65 and accuracy.Value &gt;= 55 then
&#9;&#9;&#9;&#9;mouse.Icon = http..icons[7]
&#9;&#9;&#9;elseif accuracy.Value &lt; 55 and accuracy.Value &gt;= 45 then
&#9;&#9;&#9;&#9;mouse.Icon = http..icons[8]
&#9;&#9;&#9;elseif accuracy.Value &lt; 45 and accuracy.Value &gt;= 65 then
&#9;&#9;&#9;&#9;mouse.Icon = http..icons[9]
&#9;&#9;&#9;elseif accuracy.Value &lt; 35 and accuracy.Value &gt;= 25 then
&#9;&#9;&#9;&#9;mouse.Icon = http..icons[10]
&#9;&#9;&#9;elseif accuracy.Value &lt; 25 and accuracy.Value &gt;= 15 then
&#9;&#9;&#9;&#9;mouse.Icon = http..icons[11]
&#9;&#9;&#9;elseif accuracy.Value &lt; 15 and accuracy.Value &gt;= 0 then
&#9;&#9;&#9;&#9;mouse.Icon = http..icons[12]
&#9;&#9;&#9;end
&#9;&#9;end)
&#9;end)

&#9;cor2 = coroutine.create(function ()
&#9;&#9;while true do
&#9;&#9;&#9;if accuracy.Value &lt; maxAccuracy.Value then
&#9;&#9;&#9;&#9;if tool.IsShooting.Value == false then
&#9;&#9;&#9;&#9;&#9;accuracy.Value = accuracy.Value + tool.Kickback.Value/2
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;&#9;wait(0.1)
&#9;&#9;end
&#9;end)

&#9;coroutine.resume(cor)
&#9;coroutine.resume(cor2)
end





tool.Equipped:connect(onEquippedLocal)

