				<Item class="Script" referent="RBX9222">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">wait(0.25)
local tool = script.Parent
local frame = tool.Frame
local msgFrame = frame.ReceivingBox
local sendButton = frame.SendMsg
local msg = frame.Message
local charging = tool.Charging
local charge = tool.Charge
local chargeFrame = frame.Charge
local player = nil
started = false

function findPlayer()
&#9;if player ~= nil then
&#9;&#9;local y = 0
&#9;&#9;print(&quot;FIND PLAYER&quot;)
&#9;&#9;frame.PlayersFrame.Visible = true
&#9;&#9;for index, child in pairs(game.Players:getChildren()) do
&#9;&#9;&#9;if child ~= player then
&#9;&#9;&#9;&#9;if child.Character:findFirstChild(&quot;Radio&quot;) ~= nil then 
&#9;&#9;&#9;&#9;&#9;local b = Instance.new(&quot;TextButton&quot;)
&#9;&#9;&#9;&#9;&#9;b.Size = UDim2.new(1, 0, 0.2, 0)
&#9;&#9;&#9;&#9;&#9;b.Position = UDim2.new(0, 0, y, 0)
&#9;&#9;&#9;&#9;&#9;b.Parent = frame.PlayersFrame
&#9;&#9;&#9;&#9;&#9;b.Name = child.Name
&#9;&#9;&#9;&#9;&#9;b.Text = child.Name
&#9;&#9;&#9;&#9;&#9;b.MouseButton1Down:connect(function()
&#9;&#9;&#9;&#9;&#9;&#9;frame.PlayerName.Text = b.Text
&#9;&#9;&#9;&#9;&#9;&#9;tool.Receiver.Value = child
&#9;&#9;&#9;&#9;&#9;&#9;frame.PlayersFrame.Visible = false
&#9;&#9;&#9;&#9;&#9;end)
&#9;&#9;&#9;&#9;&#9;y = y + 0.2
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end

function sendMsg()
&#9;if player ~= nil then
&#9;&#9;local receiver = tool.Receiver.Value
&#9;&#9;if charge.Value &gt; 0 then
&#9;&#9;&#9;if msg.Text ~= &quot;&quot; then
&#9;&#9;&#9;&#9;if receiver ~= nil then
&#9;&#9;&#9;&#9;&#9;if receiver.Character:findFirstChild(&quot;Radio&quot;) ~= nil then
&#9;&#9;&#9;&#9;&#9;&#9;if receiver.Character.Radio.Charge.Value &gt; 0 then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;local receiverText = receiver.PlayerGui.ScreenGui.Frame.ReceivingBox
&#9;&#9;&#9;&#9;&#9;&#9;&#9;receiverText.Text = msg.Text..&quot; -- &quot;..player.Name..&quot; || &quot;..receiverText.Text
&#9;&#9;&#9;&#9;&#9;&#9;&#9;msgFrame.Text = &quot;(To &quot;..receiver.Name..&quot;) &quot;..msg.Text..&quot; -- &quot;..player.Name..&quot; || &quot;..msgFrame.Text
&#9;&#9;&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;&#9;&#9;msgFrame.Text = &quot;The Receiver&apos;s battery has died. || &quot;..msgFrame.Text
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;else
&#9;&#9;&#9;msgFrame.Text = &quot;Battery is dead... || &quot;..msgFrame.Text
&#9;&#9;end
&#9;end
end

function onUnequipped()
&#9;frame.Parent = tool
end

function onEquipped(mouse)

&#9;player = game.Players:getPlayerFromCharacter(tool.Parent)
&#9;frame.Parent = player.PlayerGui.ScreenGui

&#9;if started == false then
&#9;&#9;started = true
&#9;&#9;sendButton.MouseButton1Down:connect(sendMsg)
&#9;&#9;frame.PlayerName.MouseButton1Down:connect(findPlayer)
&#9;end
end

tool.Equipped:connect(onEquipped)
tool.Unequipped:connect(onUnequipped)</ProtectedString>
