					<float name="RightParamB">0.5</float>
					<token name="RightSurface">0</token>
					<token name="RightSurfaceInput">0</token>
					<Vector3 name="RotVelocity">
						<X>0</X>
						<Y>0</Y>
						<Z>0</Z>
					</Vector3>
					<float name="TopParamA">-0.5</float>
					<float name="TopParamB">0.5</float>
					<token name="TopSurface">0</token>
					<token name="TopSurfaceInput">0</token>
					<float name="Transparency">0</float>
					<Vector3 name="Velocity">
						<X>0</X>
						<Y>0</Y>
						<Z>0</Z>
					</Vector3>
					<token name="formFactorRaw">0</token>
					<token name="shape">1</token>
					<Vector3 name="size">
						<X>6</X>
						<Y>2</Y>
						<Z>4</Z>
					</Vector3>
				</Properties>
				<Item class="IntValue" referent="RBX5853">
					<Properties>
						<string name="Name">Flammable</string>
						<int name="Value">2147483647</int>
					</Properties>
				</Item>
				<Item class="Script" referent="RBX5854">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">FireScript</string>
						<ProtectedString name="Source">local part = script.Parent

local fireScript = game.Workspace.FireScript:clone()

local flame = Instance.new(&quot;Part&quot;)
flame.formFactor = &quot;Symmetric&quot;
flame.Locked = true
flame.CanCollide = false
flame.Size = Vector3.new(1, 1, 1)
flame.TopSurface = &quot;Smooth&quot;
flame.BottomSurface = &quot;Smooth&quot;

local bv = Instance.new(&quot;BodyVelocity&quot;)
bv.velocity = Vector3.new(0, 25, 0)
bv.Parent = flame

local mesh = Instance.new(&quot;SpecialMesh&quot;)
mesh.MeshType = &quot;Sphere&quot;
mesh.Parent = flame

local colors = {&quot;Bright red&quot;, &quot;Bright yellow&quot;, &quot;Neon orange&quot;}

function getBiggestSize()
&#9;local x = part.Size.x
&#9;local y = part.Size.y
&#9;local z = part.Size.z

&#9;return math.max(x, y, z)
end

function generateFlame()
&#9;local c = flame:clone()

&#9;local choice = colors[math.random(1, #colors)]

&#9;c.BrickColor = BrickColor.new(choice)

&#9;local position = Vector3.new(math.random(-1, 1), math.random(-1, 1), math.random(-1, 1)).unit
&#9;position = position * getBiggestSize()
&#9;position = position + part.Position

&#9;c.Position = position
&#9;c.Parent = game.Workspace

&#9;game:GetService(&quot;Debris&quot;):addItem(c, 0.25)
end

function getAllParts(root, tab)
&#9;local c = root:GetChildren()

&#9;for index, child in pairs(c) do
&#9;&#9;if child:IsA(&quot;BasePart&quot;) then
&#9;&#9;&#9;table.insert(tab, child)
&#9;&#9;elseif child:IsA(&quot;Model&quot;) then
&#9;&#9;&#9;getAllParts(child, tab)
&#9;&#9;end
&#9;end
end

function getDist(a, b)
&#9;return (a - b).magnitude
end

function spreadFire()
&#9;local range = getBiggestSize() * 2

&#9;local parts = {}
&#9;getAllParts(game.Workspace, parts)

&#9;for index, child in pairs(parts) do
&#9;&#9;if child ~= part then

&#9;&#9;&#9;local dist = getDist(part.Position, child.Position)

&#9;&#9;&#9;if dist &lt; range then
&#9;&#9;&#9;&#9;local fireDebounce = child:findFirstChild(&quot;FireScript&quot;)

&#9;&#9;&#9;&#9;if fireDebounce == nil then
&#9;&#9;&#9;&#9;&#9;local sc = fireScript:clone()
&#9;&#9;&#9;&#9;&#9;sc.Disabled = false
&#9;&#9;&#9;&#9;&#9;sc.Parent = child
&#9;&#9;&#9;&#9;end

&#9;&#9;&#9;&#9;local raw = child:findFirstChild(&quot;Raw&quot;)
&#9;&#9;&#9;&#9;local edible = child:findFirstChild(&quot;Edible&quot;)
&#9;&#9;&#9;&#9;local cookDebounce = true

&#9;&#9;&#9;&#9;if raw ~= nil and edible ~= nil and cookDebounce then
&#9;&#9;&#9;&#9;&#9;child.BrickColor = raw.NewColor.Value
&#9;&#9;&#9;&#9;&#9;child.Name = raw.NewName.Value
&#9;&#9;&#9;&#9;&#9;edible.Health.Value = 0
&#9;&#9;&#9;&#9;&#9;raw:remove()

&#9;&#9;&#9;&#9;&#9;local cooked = Instance.new(&quot;IntValue&quot;)
&#9;&#9;&#9;&#9;&#9;cooked.Name = &quot;Cooked&quot;
&#9;&#9;&#9;&#9;&#9;cooked.Parent = child

&#9;&#9;&#9;&#9;&#9;cookDebounce = false
&#9;&#9;&#9;&#9;end

&#9;&#9;&#9;&#9;local cooked = child:findFirstChild(&quot;Cooked&quot;)

&#9;&#9;&#9;&#9;if cooked ~= nil and edible ~= nil and cookDebounce then
&#9;&#9;&#9;&#9;&#9;makeFlammable(child)

&#9;&#9;&#9;&#9;&#9;child.BrickColor = BrickColor.new(&quot;Black&quot;)
&#9;&#9;&#9;&#9;&#9;child.Name = &quot;Burnt Food&quot;
&#9;&#9;&#9;&#9;&#9;edible.Health.Value = -25
&#9;&#9;&#9;&#9;end

&#9;&#9;&#9;&#9;local impure = child:findFirstChild(&quot;Impure&quot;)

&#9;&#9;&#9;&#9;if impure ~= nil then
&#9;&#9;&#9;&#9;&#9;child.BrickColor = impure.NewColor.Value
&#9;&#9;&#9;&#9;&#9;child.Name = impure.NewName.Value
&#9;&#9;&#9;&#9;&#9;child.Reflectance = impure.NewReflectance.Value
&#9;&#9;&#9;&#9;&#9;child.Transparency = impure.NewTransparency.Value
&#9;&#9;&#9;&#9;&#9;impure:remove()
&#9;&#9;&#9;&#9;&#9;if child:findFirstChild(&quot;Dry&quot;) ~= nil then
&#9;&#9;&#9;&#9;&#9;&#9;child:findFirstChild(&quot;Dry&quot;):Remove()
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end

&#9;&#9;&#9;&#9;local metal = child:findFirstChild(&quot;Metallic&quot;)
&#9;&#9;&#9;&#9;local origName = child.Name
&#9;&#9;&#9;&#9;local origRefl = child.Reflectance

&#9;&#9;&#9;&#9;if metal ~= nil then
&#9;&#9;&#9;&#9;&#9;child.BrickColor = metal.NewColor.Value
&#9;&#9;&#9;&#9;&#9;child.Name = metal.NewName.Value
&#9;&#9;&#9;&#9;&#9;child.Reflectance = metal.NewReflectance.Value
&#9;&#9;&#9;&#9;&#9;metal.Source.Value = part
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end

function catchFire()
&#9;local flam = script.Parent:findFirstChild(&quot;Flammable&quot;)

&#9;if flam ~= nil then
&#9;&#9;burn()
&#9;else
&#9;&#9;script:remove()
&#9;end
end

function makeFlammable(obj)
&#9;local flam = Instance.new(&quot;IntValue&quot;)
&#9;flam.Name = &quot;Flammable&quot;
&#9;flam.Parent = obj
end

function burn()
&#9;local mass = part:GetMass()

&#9;local fire = Instance.new(&quot;Fire&quot;)
&#9;local light = Instance.new(&quot;IntValue&quot;, part)
&#9;light.Name = &quot;Light&quot;
&#9;
&#9;fire.Parent = part
&#9;if mass &lt; 25 then 
&#9;&#9;fire.Size = 5
&#9;else
&#9;&#9;fire.Size = mass / 5
&#9;end
&#9;light.Value = fire.Size

&#9;local time = mass + part.Flammable.Value

&#9;local oc = Instance.new(&quot;BrickColorValue&quot;)
&#9;oc.Name = &quot;OriginalColor&quot;
&#9;oc.Value = part.BrickColor
&#9;oc.Parent = part

&#9;part.BrickColor = BrickColor.new(&quot;Bright red&quot;)

&#9;local explosive = part:findFirstChild(&quot;Explosive&quot;)

&#9;if explosive ~= nil then
&#9;&#9;spreadFire()

&#9;&#9;local e = Instance.new(&quot;Explosion&quot;)
&#9;&#9;e.Position = part.Position
&#9;&#9;e.BlastRadius = explosive.Value
&#9;&#9;e.Parent = game.Workspace

&#9;&#9;part:remove()
&#9;end

&#9;for burnTime = 1, time do
&#9;&#9;wait(1)

