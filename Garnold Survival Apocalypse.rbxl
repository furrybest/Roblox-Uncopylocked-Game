				<Item class="LocalScript" referent="RBX9527">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">ArmMovement</string>
						<ProtectedString name="Source">tool = script.Parent
local arms = nil
local welds = {}

function equip(mouse)
&#9;wait(0.5)
&#9;arms = {tool.Parent:FindFirstChild(&quot;Left Arm&quot;), tool.Parent:FindFirstChild(&quot;Right Arm&quot;)}
&#9;torso = tool.Parent.Torso
&#9;welds[1] = torso:findFirstChild(&quot;LARM&quot;)
&#9;welds[2] = torso:findFirstChild(&quot;RARM&quot;)
&#9;if welds[1] ~= nil and welds[2] ~= nil then
&#9;&#9;mouse.Move:connect(function()
&#9;&#9;&#9;cf1 = CFrame.new(arms[1].CFrame.p, mouse.hit.p) + (mouse.hit.lookVector*20)
&#9;&#9;&#9;cf2 = CFrame.new(arms[2].CFrame.p, mouse.hit.p) + (mouse.hit.lookVector*20)
&#9;&#9;&#9;x, y, z = CFrame.new(Vector3.new(0,0,0), welds[2].Part0.CFrame:toObjectSpace(cf1).p):toEulerAnglesXYZ()
&#9;&#9;&#9;x2, y2, z2 = CFrame.new(Vector3.new(0,0,0), welds[1].Part0.CFrame:toObjectSpace(cf1).p):toEulerAnglesXYZ()

&#9;&#9;&#9;welds[1].C0 = CFrame.new(Vector3.new(0,0,0)) * CFrame.Angles(x2, 0, 0)
&#9;&#9;&#9;welds[2].C0 = CFrame.new(Vector3.new(0,0,0)) * CFrame.Angles(x, 0, 0)
&#9;&#9;end)
&#9;end
end

tool.Equipped:connect(equip)

</ProtectedString>
