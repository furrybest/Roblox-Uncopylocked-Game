		<Item class="Script" referent="RBX20">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Electricity</string>
				<ProtectedString name="Source">function getPowerSources()
&#9;local x = {}
&#9;for index, child in pairs(game.Workspace:GetChildren()) do
&#9;&#9;if child:findFirstChild(&quot;Power Box&quot;) ~= nil then
&#9;&#9;&#9;table.insert(x, child)
&#9;&#9;end
&#9;end
&#9;return x
end

function getPowerUsers()
&#9;local x = {}
&#9;for index, child in pairs(game.Workspace:GetChildren()) do
&#9;&#9;if child:findFirstChild(&quot;Electrical&quot;) ~= nil then
&#9;&#9;&#9;table.insert(x, child)
&#9;&#9;end
&#9;end
&#9;return x
end

function updateElectricity()
&#9;while true do
&#9;&#9;local batteries = getPowerUsers()
&#9;&#9;for index, child in pairs(batteries) do
&#9;&#9;&#9;local chargeLeft = child.ChargeLeft
&#9;&#9;&#9;if child.Source.Value ~= nil then
&#9;&#9;&#9;&#9;if chargeLeft.Value &lt; 100 then
&#9;&#9;&#9;&#9;&#9;chargeLeft.Value = chargeLeft.Value + 5
&#9;&#9;&#9;&#9;&#9;if chargeLeft.Value &gt; 100 then
&#9;&#9;&#9;&#9;&#9;&#9;chargeLeft.Value = 100
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;&#9;if child.User.Value ~= nil then
&#9;&#9;&#9;&#9;chargeLeft.Value =  chargeLeft.Value - 5
&#9;&#9;&#9;&#9;if chargeLeft.Value &lt; 0 then
&#9;&#9;&#9;&#9;&#9;chargeLeft.Value = 0
&#9;&#9;&#9;&#9;&#9;child.Locked = false
&#9;&#9;&#9;&#9;&#9;child.User.Value.Parent.Source.Value = nil
&#9;&#9;&#9;&#9;&#9;child.User.Value = nil
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;wait(5)
&#9;end
end

updateElectricity()</ProtectedString>
