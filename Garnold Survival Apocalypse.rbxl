									<R10>0</R10>
									<R11>1</R11>
									<R12>0</R12>
									<R20>0</R20>
									<R21>0</R21>
									<R22>1</R22>
								</CoordinateFrame>
								<Vector3 name="maxTorque">
									<X>3.99999995e+015</X>
									<Y>0</Y>
									<Z>3.99999995e+015</Z>
								</Vector3>
