						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">LocalScript</string>
						<ProtectedString name="Source">wait(0.25)
local load = true
local player = game.Players.LocalPlayer
local biting = false
local biteval = 0
local rodval = 1
local on = script.Parent.Name

local tool = script.Parent

local frame = tool.Frame
local label = frame.Label

function message(text)
&#9;local originalName = label.Text
&#9;label.Text = text
&#9;wait(1)
&#9;label.Text = originalName
end

function drawLine(p1, p2)
&#9;local p = Instance.new(&quot;Part&quot;)
&#9;p.Anchored = true
&#9;p.Locked = true
&#9;p.CanCollide = false
&#9;p.CFrame = CFrame.new(((p1 + p2) / 2), p2)
&#9;p.Size = Vector3.new(1, 1, (p1 - p2).magnitude)

&#9;local mesh = Instance.new(&quot;SpecialMesh&quot;)
&#9;mesh.MeshType = &quot;Brick&quot;
&#9;mesh.Scale = Vector3.new(0.1, 0.1, 1)
&#9;mesh.Parent = p

&#9;p.Parent = game.Workspace

&#9;return p
end

function endOfHandle(handle)
&#9;return handle.Position + Vector3.new(0, 3, 0)
end

function fixFishName(name)
&#9;local a, b = name:find(&quot;Raw &quot;)

&#9;if a ~= nil then
&#9;&#9;return name:sub(b)
&#9;else
&#9;&#9;return name
&#9;end
end

function gotAFish()
&#9;local fish = game.Lighting.Fish:GetChildren()
&#9;local picked = fish[math.random(1, #fish)]
&#9;local fishName = fixFishName(picked.Name)
&#9;local val = picked.Diff.Value
&#9;local pack = player.Inventory
&#9;local char = tool.Parent
&#9;local hs = char.Humanoid.WalkSpeed

&#9;biting = true

&#9;char.Humanoid.WalkSpeed = 0

&#9;message(&quot;A &quot;..fishName:upper()..&quot; IS BITING!!!&quot;)

&#9;char.Humanoid.WalkSpeed = hs

&#9;biting = false

&#9;if biteval &gt;= val then
&#9;&#9;if pack.Items.Value &lt; pack.MaxItems.Value then
&#9;&#9;&#9;local caught = picked:Clone()
&#9;&#9;&#9;message(&quot;Caught a &quot;..fishName..&quot;!!&quot;)
&#9;&#9;&#9;caught.Parent = pack
&#9;&#9;&#9;pack.Items.Value = pack.Items.Value + 1
&#9;&#9;else
&#9;&#9;&#9;message(&quot;Not enough space!!&quot;)
&#9;&#9;end
&#9;else
&#9;&#9;message(&quot;It got away...&quot;)
&#9;end

&#9;biteval = 0

&#9;wait(1)
end

function onButton1Down(mouse)
&#9;if load == true then

&#9;&#9;load = false
&#9;&#9;local anim = Instance.new(&quot;StringValue&quot;)
&#9;&#9;anim.Name = &quot;toolanim&quot;
&#9;&#9;anim.Value = &quot;Slash&quot;
&#9;&#9;anim.Parent = tool

&#9;&#9;local p = nil

&#9;&#9;local pos = mouse.hit.p

&#9;&#9;if mouse.Target.Name ~= &quot;Ocean&quot; then return end

&#9;&#9;for i = 1, 500 do
&#9;&#9;&#9;p = drawLine(endOfHandle(tool.Handle), pos)
&#9;&#9;&#9;wait()

&#9;&#9;&#9;if math.random(1, 250) == 1 then
&#9;&#9;&#9;&#9;gotAFish()
&#9;&#9;&#9;&#9;p:remove()
&#9;&#9;&#9;&#9;break
&#9;&#9;&#9;end

&#9;&#9;&#9;p:remove()
&#9;&#9;end

&#9;&#9;load = true

&#9;end
end

function onKeyDown(key)
&#9;if key == &quot;q&quot; then
&#9;&#9;if biting == true then
&#9;&#9;&#9;biteval = biteval + rodval
&#9;&#9;end
&#9;end
end


function onEquippedLocal(mouse)
&#9;frame.Parent = player.PlayerGui.ScreenGui

&#9;mouse.Button1Down:connect(function() onButton1Down(mouse) end)
&#9;mouse.KeyDown:connect(onKeyDown)
end

function onUnequipped()
&#9;frame.Parent = tool
end


tool.Equipped:connect(onEquippedLocal)
tool.Unequipped:connect(onUnequipped)</ProtectedString>
