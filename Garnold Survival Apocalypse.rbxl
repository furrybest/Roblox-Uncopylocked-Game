local door = script.Parent.Parent.Door
local clickDetector = script.Parent.ClickDetector

function openDoor()
&#9;door.Transparency = 0.5
&#9;door.CanCollide = false
&#9;wait(1)
&#9;door.Transparency = 0
&#9;door.CanCollide = true
end

function onClick()
&#9;openDoor()
end

