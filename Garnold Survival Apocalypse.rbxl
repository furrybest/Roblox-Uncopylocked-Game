					<int name="ZIndex">1</int>
				</Properties>
				<Item class="Script" referent="RBX8013">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">local button = script.Parent
local sg = button.Parent
local bf = sg.BuildingsFrame

local showFrame = false

function onMouseButton1Down()
&#9;showFrame = not showFrame

&#9;if showFrame then
&#9;&#9;button.Text = &quot;Hide Bldgs. Menu&quot;
&#9;else
&#9;&#9;button.Text = &quot;Show Bldgs. Menu&quot;
&#9;end

&#9;bf.Visible = showFrame
end

button.MouseButton1Down:connect(onMouseButton1Down)
</ProtectedString>
					</Properties>
				</Item>
			</Item>
			<Item class="Frame" referent="RBX8014">
				<Properties>
					<bool name="Active">false</bool>
					<Color3 name="BackgroundColor3">4294967295</Color3>
					<float name="BackgroundTransparency">0</float>
					<Color3 name="BorderColor3">4279970357</Color3>
					<int name="BorderSizePixel">1</int>
					<bool name="ClipsDescendants">false</bool>
					<bool name="Draggable">false</bool>
					<string name="Name">ColonyFrame</string>
					<UDim2 name="Position">
						<XS>0.25</XS>
						<XO>0</XO>
						<YS>0.25</YS>
						<YO>0</YO>
					</UDim2>
					<UDim2 name="Size">
						<XS>0.5</XS>
						<XO>0</XO>
						<YS>0.5</YS>
						<YO>0</YO>
					</UDim2>
					<token name="SizeConstraint">0</token>
					<token name="Style">3</token>
					<bool name="Visible">false</bool>
					<int name="ZIndex">1</int>
				</Properties>
				<Item class="Script" referent="RBX8015">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">TribeScript</string>
						<ProtectedString name="Source">local frame = script.Parent

local nTribeButton = frame.NewTribeButton
local nTribeNB = frame.NewTribeNameBox

local jobName = frame.JobNameLabel
local tribeName = frame.TribeNameLabel

local tribeService = game.Workspace.Services.Tribes
local tribeModel = tribeService.TribeModel:clone()
tribeModel.TribeScript.Disabled = false

local memberFrame = script.MemberFrame:clone()
local memberFrameL = script.MemberFrameLeader:clone()

local leaderFrame = frame.LeaderFrame

local inviteButton = leaderFrame.InviteButton
local inviteBox = leaderFrame.InviteBox

local newJobBox = leaderFrame.NewJobBox

local messageButton = leaderFrame.MessageButton
local messageBody = leaderFrame.MessageBody

local messageFrame = script.MessageFrame
local inviteFrame = script.InviteFrame

local leaveButton = frame.LeaveTribeButton

function newMember(player, job, tribe)
&#9;local playerVal = Instance.new(&quot;ObjectValue&quot;)
&#9;playerVal.Value = player
&#9;playerVal.Name = player.Name

&#9;local jobVal = Instance.new(&quot;StringValue&quot;)
&#9;jobVal.Value = job
&#9;jobVal.Name = &quot;myJob&quot;
&#9;jobVal.Parent = playerVal

&#9;local pointerTest = player:findFirstChild(&quot;myTribe&quot;)

&#9;if pointerTest ~= nil then
&#9;&#9;local oldMember = findTribeMember(player.Name, pointerTest.Value)

&#9;&#9;if oldMember ~= nil then
&#9;&#9;&#9;oldMember:remove()
&#9;&#9;end

&#9;&#9;pointerTest:remove()
&#9;end

&#9;local tribePointer = Instance.new(&quot;ObjectValue&quot;)
&#9;tribePointer.Name = &quot;myTribe&quot;
&#9;tribePointer.Value = tribe
&#9;tribePointer.Parent = player

&#9;playerVal.Parent = tribe.Members
end

function clearButtons()
&#9;local buttons = frame:GetChildren()

&#9;for index, child in pairs(buttons) do
&#9;&#9;if child.Name == &quot;MemberFrame&quot; or child.Name == &quot;MemberFrameLeader&quot; then
&#9;&#9;&#9;child:remove()
&#9;&#9;end
&#9;end
end

function findTribeMember(name, tribe)
&#9;return tribe.Members:findFirstChild(name)
end

function onNewTribe()
&#9;local player = frame.Parent.Parent.Parent
&#9;player.InAColony.Value = true

&#9;local newName = nTribeNB.Text

&#9;local newTribe = tribeModel:clone()
&#9;newTribe.Name = newName
&#9;newTribe.Leader.Value = player
&#9;newMember(player, &quot;Leader&quot;, newTribe)
&#9;newTribe.Parent = tribeService

&#9;update()
end

nTribeButton.MouseButton1Down:connect(onNewTribe)

function onBanish(member)
&#9;local player = frame.Parent.Parent.Parent

&#9;if member.Value == player then return end

&#9;local realMember = member.Value
&#9;local tribe = realMember.myTribe.Value
&#9;local tribeMember = findTribeMember(realMember.Name, tribe)

&#9;tribeMember:remove()
&#9;realMember.myTribe:remove()
&#9;realMember.InAColony.Value = true

&#9;update()
end

function onJobChange(member, newJob)
&#9;local player = frame.Parent.Parent.Parent

&#9;if member.Value == player then return end

&#9;member.myJob.Value = newJob

&#9;update()
end

function findPlayer(text)
&#9;local c = game.Players:GetChildren()

&#9;for index, child in pairs(c) do
&#9;&#9;if child.Name:lower() == text:lower() then
&#9;&#9;&#9;return child
&#9;&#9;end
&#9;end

&#9;return nil
end

function onAccept(frame, player, tribe)
&#9;newMember(player, &quot;Unemployed&quot;, tribe)
&#9;player.InAColony.Value = true

&#9;onDecline(frame)
end

function onDecline(frame)
&#9;local children = frame.Parent:GetChildren()

&#9;for index, child in pairs(children) do
&#9;&#9;if child.Name == frame.Name then
&#9;&#9;&#9;child:remove()
&#9;&#9;end
&#9;end
end

function onInvite()
&#9;local player = frame.Parent.Parent.Parent
&#9;local tribe = player.myTribe.Value

&#9;local invitedName = inviteBox.Text
&#9;local invited = findPlayer(invitedName)

&#9;if invited ~= nil then
&#9;&#9;if findTribeMember(invited.Name, tribe) == nil then
&#9;&#9;&#9;local newFrame = inviteFrame:clone()
&#9;&#9;&#9;newFrame.TribeNameLabel.Text = tribe.Name
&#9;&#9;&#9;newFrame.YesButton.MouseButton1Down:connect(function()
&#9;&#9;&#9;&#9;onAccept(newFrame, invited, tribe)
&#9;&#9;&#9;end)
&#9;&#9;&#9;newFrame.NoButton.MouseButton1Down:connect(function()
&#9;&#9;&#9;&#9;onDecline(newFrame)
&#9;&#9;&#9;end)
&#9;&#9;&#9;newFrame.Parent = invited.PlayerGui.ScreenGui
&#9;&#9;end
&#9;end
end

inviteButton.MouseButton1Down:connect(onInvite)

function onMessage()
&#9;local player = frame.Parent.Parent.Parent
&#9;local tribe = player.myTribe.Value

&#9;local members = tribe.Members:GetChildren()

&#9;local messageText = messageBody.Text..&quot; --Posted by &quot;..(player.Name)

&#9;for index, child in pairs(members) do
&#9;&#9;local newMessage = messageFrame:clone()
&#9;&#9;newMessage.MessageLabel.Text = messageText
&#9;&#9;newMessage.Script.Disabled = false
&#9;&#9;newMessage.Parent = child.Value.PlayerGui.ScreenGui
&#9;end
end

messageButton.MouseButton1Down:connect(onMessage)

function onLeave()
&#9;local player = frame.Parent.Parent.Parent
&#9;player.InAColony.Value = false

&#9;local tribePointer = player:findFirstChild(&quot;myTribe&quot;)

&#9;if tribePointer ~= nil then
&#9;&#9;local member = findTribeMember(player.Name, tribePointer.Value)

&#9;&#9;tribePointer:remove()
&#9;&#9;member:remove()
&#9;end

&#9;update()
end

leaveButton.MouseButton1Down:connect(onLeave)

function update()
&#9;local player = frame.Parent.Parent.Parent

&#9;clearButtons() --Get rid of the old buttons
&#9;leaderFrame.Visible = false

&#9;local tribeTest = player:findFirstChild(&quot;myTribe&quot;)
&#9;if tribeTest ~= nil then
&#9;&#9;local realTribe = tribeTest.Value
&#9;&#9;if realTribe ~= nil then
&#9;&#9;&#9;local leader = realTribe.Leader.Value

&#9;&#9;&#9;tribeName.Text = realTribe.Name
&#9;&#9;&#9;jobName.Text = findTribeMember(player.Name, realTribe).myJob.Value --Change the job and name guis on the top

&#9;&#9;&#9;local members = realTribe.Members:GetChildren() --Get all the members

&#9;&#9;&#9;local y = 1
&#9;&#9;&#9;for index, child in pairs(members) do
&#9;&#9;&#9;&#9;local newFrame = nil

&#9;&#9;&#9;&#9;if leader == player then
&#9;&#9;&#9;&#9;&#9;newFrame = memberFrameL:clone()
&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;newFrame = memberFrame:clone()
&#9;&#9;&#9;&#9;end

&#9;&#9;&#9;&#9;newFrame.Position = UDim2.new(0, 0, 0.05 * y, 0)
&#9;&#9;&#9;&#9;newFrame.myName.Text = child.Name
&#9;&#9;&#9;&#9;newFrame.myJob.Text = child.myJob.Value

&#9;&#9;&#9;&#9;if leader == player then
&#9;&#9;&#9;&#9;&#9;newFrame.BanishButton.MouseButton1Down:connect(function()
&#9;&#9;&#9;&#9;&#9;&#9;onBanish(child)
&#9;&#9;&#9;&#9;&#9;end)

&#9;&#9;&#9;&#9;&#9;newFrame.ChangeJobButton.MouseButton1Down:connect(function()
&#9;&#9;&#9;&#9;&#9;&#9;onJobChange(child, newJobBox.Text)
&#9;&#9;&#9;&#9;&#9;end)
&#9;&#9;&#9;&#9;end

&#9;&#9;&#9;&#9;newFrame.Parent = script.Parent

&#9;&#9;&#9;&#9;y = y + 1
&#9;&#9;&#9;end --Make buttons for all the members

&#9;&#9;&#9;leaderFrame.Visible = (leader == player)
&#9;&#9;else
&#9;&#9;&#9;tribeTest:remove()
&#9;&#9;end
&#9;else
&#9;&#9;tribeName.Text = &quot;Solo&quot;
&#9;&#9;jobName.Text = &quot;&quot;
&#9;end
end

while true do
&#9;update()
&#9;wait(5)
end
</ProtectedString>
