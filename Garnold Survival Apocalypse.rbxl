					<ProtectedString name="Source">wait(1)
local tool = script.Parent
local frame = tool.Frame

function updateInventory()
&#9;local player = tool.Parent.Parent
&#9;local char = player.Character
&#9;local inventory = player:findFirstChild(&quot;Inventory&quot;)
&#9;if inventory ~= nil then 
&#9;&#9;local y1 = 1
&#9;&#9;local x1 = 1
&#9;&#9;local y2 = 1
&#9;&#9;local x2 = 1
&#9;&#9;local y3 = 1
&#9;&#9;local x3 = 1
&#9;&#9;local contents = inventory:GetChildren()
&#9;&#9;for index, a in pairs(contents) do
&#9;&#9;&#9;local button = Instance.new(&quot;TextButton&quot;)
&#9;&#9;&#9;if a.className == &quot;Part&quot; then
&#9;&#9;&#9;&#9;if a:findFirstChild(&quot;Seed&quot;) == nil then
&#9;&#9;&#9;&#9;&#9;button.Name = a.Name
&#9;&#9;&#9;&#9;&#9;button.BackgroundColor3 = a.BrickColor.Color
&#9;&#9;&#9;&#9;&#9;button.Parent = frame.Main
&#9;&#9;&#9;&#9;&#9;button.Size = UDim2.new(0.15, 0, 0.15, 0)
&#9;&#9;&#9;&#9;&#9;button.Position = UDim2.new(0.15 * x1, 0, 0.15 * y1, 0)
&#9;&#9;&#9;&#9;&#9;button.Text = a.Name

&#9;&#9;&#9;&#9;&#9;button.MouseButton1Down:connect(function() 
&#9;&#9;&#9;&#9;&#9;&#9;button:Remove() 
&#9;&#9;&#9;&#9;&#9;&#9;a.Parent = Workspace
&#9;&#9;&#9;&#9;&#9;&#9;a.Position = char.Head.Position + Vector3.new(0, -2, 5)
&#9;&#9;&#9;&#9;&#9;&#9;inventory.Items.Value = inventory.Items.Value - 1
&#9;&#9;&#9;&#9;&#9;end)

&#9;&#9;&#9;&#9;&#9;if x1 &lt; 4 then
&#9;&#9;&#9;&#9;&#9;&#9;x1 = x1 + 1
&#9;&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;&#9;x1 = 1
&#9;&#9;&#9;&#9;&#9;&#9;y1 = y1 + 1
&#9;&#9;&#9;&#9;&#9;end

&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;button.BackgroundColor3 = a.BrickColor.Color
&#9;&#9;&#9;&#9;&#9;button.Parent = frame.Seeds
&#9;&#9;&#9;&#9;&#9;button.Size = UDim2.new(0.15, 0, 0.15, 0)
&#9;&#9;&#9;&#9;&#9;button.Position = UDim2.new(0.15 * x2, 0, 0.15 * y2, 0)
&#9;&#9;&#9;&#9;&#9;button.Text = a.Name

&#9;&#9;&#9;&#9;&#9;button.MouseButton1Down:connect(function() 
&#9;&#9;&#9;&#9;&#9;&#9;button:Remove() 
&#9;&#9;&#9;&#9;&#9;&#9;a.Parent = Workspace
&#9;&#9;&#9;&#9;&#9;&#9;a.Position = char.Head.Position + Vector3.new(0, -2, 5)
&#9;&#9;&#9;&#9;&#9;&#9;inventory.Items.Value = inventory.Items.Value - 1
&#9;&#9;&#9;&#9;&#9;end)

&#9;&#9;&#9;&#9;&#9;if x2 &lt; 4 then
&#9;&#9;&#9;&#9;&#9;&#9;x2 = x2 + 1
&#9;&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;&#9;x2 = 1
&#9;&#9;&#9;&#9;&#9;&#9;y2 = y2 + 1
&#9;&#9;&#9;&#9;&#9;end

&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;wait()

&#9;&#9;&#9;elseif a.className == &quot;Tool&quot; or a.className == &quot;HopperBin&quot; then

&#9;&#9;&#9;&#9;button.Parent = frame.Tools
&#9;&#9;&#9;&#9;button.Size = UDim2.new(0.15, 0, 0.15, 0)
&#9;&#9;&#9;&#9;button.Position = UDim2.new(0.15 * x3, 0, 0.15 * y3, 0)
&#9;&#9;&#9;&#9;button.Text = a.Name
&#9;
&#9;&#9;&#9;&#9;if a:findFirstChild(&quot;Handle&quot;)~= nil then
&#9;&#9;&#9;&#9;&#9;button.BackgroundColor3 = a.Handle.BrickColor.Color
&#9;&#9;&#9;&#9;end

&#9;&#9;&#9;&#9;button.MouseButton1Down:connect(function() 
&#9;&#9;&#9;&#9;&#9;button:Remove() 
&#9;&#9;&#9;&#9;&#9;a.Parent = player.Backpack
&#9;&#9;&#9;&#9;end)

&#9;&#9;&#9;&#9;if x2 &lt; 4 then
&#9;&#9;&#9;&#9;&#9;x3 = x3 + 1
&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;x3 = 1
&#9;&#9;&#9;&#9;&#9;y3 = y3 + 1
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end





function onSelected()
&#9;local player = tool.Parent.Parent
&#9;local char = player.Character
&#9;frame.Parent = player.PlayerGui.ScreenGui
&#9;updateInventory()
end

function onDeselected()
&#9;local buttons = frame.Main:GetChildren()
&#9;local others = frame.Seeds:GetChildren()

&#9;for index, child in pairs(buttons) do
&#9;&#9;if child.className == &quot;TextButton&quot; then 
&#9;&#9;&#9;child:Remove()
&#9;&#9;end
&#9;end

&#9;for index, child in pairs(others) do
&#9;&#9;if child.className == &quot;TextButton&quot; then 
&#9;&#9;&#9;child:Remove()
&#9;&#9;end
&#9;end
&#9;
&#9;frame.Parent = script.Parent
&#9;
end

tool.Selected:connect(onSelected)
tool.Deselected:connect(onDeselected)</ProtectedString>
