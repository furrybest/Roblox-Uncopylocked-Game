				<Item class="Script" referent="RBX8716">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Swim Script</string>
						<ProtectedString name="Source">zombie = script.Parent
torso = zombie.Torso
hum = zombie.Humanoid
bp = Instance.new(&quot;BodyPosition&quot;)

function swim()
&#9;while true do
&#9;&#9;wait()
&#9;&#9;if workspace:findFirstChild(&quot;OceanModel&quot;) ~= nil then
&#9;&#9;&#9;if torso.Position.y &lt; 25.5 and hum.Health &gt; 0 then
&#9;&#9;&#9;&#9;bp.position = Vector3.new(0, 25, 0)
&#9;&#9;&#9;&#9;bp.maxForce = Vector3.new(0, 4e3, 0)
&#9;&#9;&#9;&#9;bp.Parent = torso
&#9;&#9;&#9;&#9;wait(15)
&#9;&#9;&#9;&#9;bp.Parent = nil
&#9;&#9;&#9;&#9;wait(10)
&#9;&#9;&#9;&#9;hum.Health = 0
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end

swim()</ProtectedString>
					</Properties>
				</Item>
				<Item class="Script" referent="RBX8717">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">local zomb = script.Parent

function findNearestTorso(pos)
&#9;local list = game.Workspace:children()
&#9;local torso = nil
&#9;local dist = 75
&#9;local temp = nil
&#9;local human = nil
&#9;local temp2 = nil
&#9;for x = 1, #list do
&#9;&#9;temp2 = list[x]
&#9;&#9;if temp2.className == &quot;Model&quot; and temp2:findFirstChild(&quot;IsNZ&quot;) == nil then
&#9;&#9;&#9;temp = temp2:findFirstChild(&quot;Right Arm&quot;)
&#9;&#9;&#9;human = temp2:findFirstChild(&quot;Humanoid&quot;)
&#9;&#9;&#9;if temp ~= nil and human ~= nil and human.Health &gt; 0 then
&#9;&#9;&#9;&#9;if (temp.Position - pos).magnitude &lt; dist then
&#9;&#9;&#9;&#9;&#9;torso = temp
&#9;&#9;&#9;&#9;&#9;dist = (temp.Position - pos).magnitude
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
&#9;return torso
end

function wanderAbout()
&#9;zomb.Humanoid:MoveTo(zomb.Torso.Position + Vector3.new(math.random(-50, 50), 0, math.random(-50, 50)), workspace.Part)
end




while true do
&#9;wait(math.random(1, 2))
&#9;local target = findNearestTorso(zomb.Torso.Position)
&#9;if target ~= nil then
&#9;&#9;zomb.Humanoid:MoveTo(target.Position, target)
&#9;else
&#9;&#9;wanderAbout()&#9;&#9;
&#9;end

end
</ProtectedString>
					</Properties>
				</Item>
				<Item class="Script" referent="RBX8718">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Respawn</string>
						<ProtectedString name="Source">zomb = script.Parent

while true do
local hum = zomb:findFirstChild(&quot;Humanoid&quot;)
&#9;if hum ~= nil then
&#9;&#9;if hum.Health &lt; 1 then
&#9;&#9;&#9;zomb:remove()
&#9;&#9;end
&#9;end
&#9;wait(1)
end
&#9;&#9;


</ProtectedString>
					</Properties>
				</Item>
				<Item class="Script" referent="RBX8719">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Disabler</string>
						<ProtectedString name="Source">while true do 
wait(1)
&#9;if script.Parent.Humanoid.Health &lt; 1 then
&#9;&#9;t = script.Parent:GetChildren()
&#9;&#9;for index, child in pairs(t) do
&#9;&#9;&#9;if child.Name == &quot;zarm&quot; then 
&#9;&#9;&#9;&#9;child.Deadly.Disabled = true
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end
</ProtectedString>
