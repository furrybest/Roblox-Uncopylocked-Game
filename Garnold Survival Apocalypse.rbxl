				<Item class="LocalScript" referent="RBX9045">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">LocalWelding</string>
						<ProtectedString name="Source">function Weld(x,y)
&#9;local W = Instance.new(&quot;Weld&quot;)
&#9;W.Part0 = x
&#9;W.Part1 = y
&#9;local CJ = CFrame.new(x.Position)
&#9;local C0 = x.CFrame:inverse()*CJ
&#9;local C1 = y.CFrame:inverse()*CJ
&#9;W.C0 = C0
&#9;W.C1 = C1
&#9;W.Parent = x
end

function Get(A)
&#9;if A.className == &quot;Part&quot; then
&#9;&#9;Weld(script.Parent.Handle, A)
&#9;&#9;A.Anchored = false
&#9;else
&#9;&#9;local C = A:GetChildren()
&#9;&#9;for i=1, #C do
&#9;&#9;Get(C[i])
&#9;&#9;end
&#9;end
end

function GetTwo(A)
&#9;if A.className == &quot;Part&quot; then
&#9;&#9;Weld(script.Parent.Handle, A)
&#9;&#9;A.Anchored = true
&#9;else
&#9;&#9;local C = A:GetChildren()
&#9;&#9;for i=1, #C do
&#9;&#9;GetTwo(C[i])
&#9;&#9;end
&#9;end
end

function Finale()
&#9;Get(script.Parent)
end

function FinaleTwo()
&#9;GetTwo(script.Parent)
end

script.Parent.Equipped:connect(Finale)
script.Parent.Unequipped:connect(FinaleTwo)
Finale()</ProtectedString>
					</Properties>
				</Item>
				<Item class="LocalScript" referent="RBX9046">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Zoom Script</string>
						<ProtectedString name="Source">wait()
gui = script.GUI
tool = script.Parent

extents = tool.ZoomExtent
accuracy = tool.Accuracy
maxAccuracy = tool.MaxAccuracy

accImprov = 0

db = true

function onEquipped(mouse)
&#9;mouse.KeyDown:connect(onKeyDown)
&#9;mouse.KeyUp:connect(onKeyUp)
end

function onKeyDown(key) 
&#9;local player = game.Players.LocalPlayer
&#9;if key == &quot;q&quot; then
&#9;&#9;if db == true then
&#9;&#9;&#9;db = false
&#9;&#9;&#9;if script.Parent.IronsightsOn.Value == true then
&#9;&#9;&#9;&#9;accImprov = 5
&#9;&#9;&#9;&#9;accuracy.Value = accuracy.Value + accImprov
&#9;&#9;&#9;&#9;maxAccuracy.Value = maxAccuracy.Value + accImprov
&#9;&#9;&#9;&#9;--[[zoomPart.Name = player.Name..&quot;Zoom&quot;
&#9;&#9;&#9;&#9;zoomPart.Size = Vector3.new(2, 2, 2)
&#9;&#9;&#9;&#9;zoomPart.Transparency = 1
&#9;&#9;&#9;&#9;zoomPart.Anchored = true
&#9;&#9;&#9;&#9;zoomPart.Locked = true
&#9;&#9;&#9;&#9;zoomPart.CanCollide = false ]]

&#9;&#9;&#9;&#9;--zoomPart.CFrame = CFrame.new(script.Parent.Barrel.Position + (script.Parent.Part6.CFrame.lookVector * extents.Value))
&#9;&#9;&#9;&#9;game.Workspace.CurrentCamera.CameraSubject = script.Parent.Ironsights
&#9;&#9;&#9;&#9;game.Workspace.CurrentCamera.CameraType = 1
&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;gui.Parent = player.PlayerGui
&#9;&#9;&#9;&#9;accImprov = 10
&#9;&#9;&#9;&#9;accuracy.Value = accuracy.Value + accImprov
&#9;&#9;&#9;&#9;maxAccuracy.Value = maxAccuracy.Value + accImprov

&#9;&#9;&#9;&#9;local zoomPart = Instance.new(&quot;Part&quot;)
&#9;&#9;&#9;&#9;zoomPart.Name = player.Name..&quot;Zoom&quot;
&#9;&#9;&#9;&#9;zoomPart.Size = Vector3.new(2, 2, 2)
&#9;&#9;&#9;&#9;zoomPart.Transparency = 1
&#9;&#9;&#9;&#9;zoomPart.Anchored = true
&#9;&#9;&#9;&#9;zoomPart.Locked = true
&#9;&#9;&#9;&#9;zoomPart.CanCollide = false

&#9;&#9;&#9;&#9;zoomPart.CFrame = script.Parent.Ironsights.CFrame + (script.Parent.Ironsights.CFrame.lookVector * extents.Value)
&#9;&#9;&#9;&#9;game.Workspace.CurrentCamera.CameraSubject = zoomPart
&#9;&#9;&#9;&#9;game.Workspace.CurrentCamera.CameraType = 1
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end 
end

function onKeyUp(key)
&#9;local player = game.Players.LocalPlayer
&#9;if key == &quot;q&quot; then
&#9;&#9;if db == false then
&#9;&#9;&#9;db = true
&#9;&#9;&#9;accuracy.Value = accuracy.Value - accImprov
&#9;&#9;&#9;maxAccuracy.Value = maxAccuracy.Value - accImprov

&#9;&#9;&#9;game.Workspace.CurrentCamera.CameraSubject = player.Character.Humanoid
&#9;&#9;&#9;game.Workspace.CurrentCamera.CameraType = &quot;Custom&quot;
&#9;&#9;&#9;gui.Parent = script
&#9;&#9;end
&#9;end
end

tool.Equipped:connect(onEquipped)

