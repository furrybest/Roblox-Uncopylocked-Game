								<R21>0.113761038</R21>
								<R22>0.993073642</R22>
							</CoordinateFrame>
						</Properties>
					</Item>
					<Item class="CFrameValue" referent="RBX15717">
						<Properties>
							<string name="Name">OriginCFrame</string>
