				<Item class="Script" referent="RBX12136">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">DoorScript</string>
						<ProtectedString name="Source">-- Ajedi32

speed = 1

door1 = script.Parent.SlidingDoor1
door2 = script.Parent.SlidingDoor2
door3 = script.Parent.SlidingDoor3
open = script.open

function stateChanged()
&#9;if open.Value then
&#9;&#9;for i=1,(door3.Size.z/speed) + 4 do
&#9;&#9;&#9;wait()
&#9;&#9;&#9;door2.CFrame = door2.CFrame - (door2.CFrame.lookVector * speed)
&#9;&#9;&#9;door3.CFrame = door3.CFrame - (door3.CFrame.lookVector * speed)
&#9;&#9;end
&#9;else
&#9;&#9;for i=1,(door3.Size.z/speed) + 4 do
&#9;&#9;&#9;wait()
&#9;&#9;&#9;door3.CFrame = door3.CFrame + (door3.CFrame.lookVector * speed)
&#9;&#9;&#9;door2.CFrame = door2.CFrame + (door2.CFrame.lookVector * speed)
&#9;&#9;end
&#9;end
end

open.Changed:connect(stateChanged)</ProtectedString>
					</Properties>
