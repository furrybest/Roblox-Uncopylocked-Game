									<string name="Name">Script</string>
									<ProtectedString name="Source">gui = script.Parent.Parent
player = gui.Parent.Parent
running = 0

function Run()
&#9;if running == 0 then
&#9;&#9;running = 1
&#9;&#9;script.Parent.Text = &quot;Allow 1st Visor View&quot;
&#9;&#9;script.Parent.Parent.LocalScript.Disabled = true
&#9;else
&#9;&#9;running = 0
&#9;&#9;script.Parent.Text = &quot;Dont Allow 1st Visor&quot;
&#9;&#9;script.Parent.Parent.LocalScript.Disabled = false
&#9;end
end

