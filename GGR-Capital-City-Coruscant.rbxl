				<Item class="Script" referent="RBX3068">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Gui</string>
						<ProtectedString name="Source">--By: StealthCloset AKA StealthMouse

function onTouched(hit) 
&#9;local human = hit.Parent:findFirstChild(&quot;Humanoid&quot;) 
&#9;if (human == nil ) then return end
&#9;local PlayerName = hit.Parent.Name
&#9;if (PlayerName == nil) then return end

&#9;local NameOfTool = &quot;View&quot;
&#9;if (game.Players:findFirstChild(PlayerName).PlayerGui:findFirstChild(NameOfTool) == nil) then
&#9;&#9;if (script:findFirstChild(NameOfTool) ~= nil) then
&#9;&#9;&#9;script:findFirstChild(NameOfTool):clone().Parent = game.Players:findFirstChild(PlayerName).PlayerGui
&#9;&#9;end
&#9;end
&#9;wait(1)
end 

script.Parent.Touched:connect(onTouched)
</ProtectedString>
					</Properties>
					<Item class="ScreenGui" referent="RBX3069">
						<Properties>
							<string name="Name">View</string>
						</Properties>
						<Item class="LocalScript" referent="RBX3070">
							<Properties>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">Main</string>
								<ProtectedString name="Source">-- Made by PeanutButterCrackers.
local GUI = script.Parent 
local Player = GUI.Parent.Parent
local User = Player.Character
local Objects = {}
repeat wait() until game.Workspace.CurrentCamera ~= nil
local Camera = game.Workspace.CurrentCamera
GUI.Circle.player.name.Text = GUI.Parent.Parent.Name
while true do
&#9;local Direction = (Vector2.new(Camera.Focus.x,Camera.Focus.z)-Vector2.new(Camera.CoordinateFrame.x,Camera.CoordinateFrame.z)).unit
&#9;GUI.Circle.NORTH.Position = UDim2.new(0.5,-Direction.x*110,0.5,Direction.y*110)
&#9;GUI.Circle.EAST.Position = UDim2.new(0.5,-Direction.y*110,0.5,-Direction.x*110)
&#9;GUI.Circle.SOUTH.Position = UDim2.new(0.5,Direction.x*110,0.5,-Direction.y*110)
&#9;GUI.Circle.WEST.Position = UDim2.new(0.5,Direction.y*110,0.5,Direction.x*110)
&#9;local Delete = GUI.Circle.Players:GetChildren()
&#9;for x = 1,#Delete do
&#9;&#9;Delete[x].Parent = nil
&#9;end
&#9;local Delete = GUI.Circle.Objects:GetChildren()
&#9;for x = 1,#Delete do
&#9;&#9;Delete[x].Parent = nil
&#9;end
&#9;local Players = game.Players:GetChildren()
&#9;for x = 1,#Players do
&#9;&#9;if Players[x] ~= nil and Players[x].Character ~= nil and Players[x].Character.Humanoid.Health &gt; 0 and Players[x].Name ~= Player.Name then
&#9;&#9;&#9;local Distance = (Vector2.new(User.Torso.CFrame.x,User.Torso.CFrame.z)-Vector2.new(Players[x].Character.Torso.CFrame.x,Players[x].Character.Torso.CFrame.z)).magnitude
&#9;&#9;&#9;if Distance &lt;= 45 then
&#9;&#9;&#9;&#9;local Size = ((50-Distance)/40)*20
&#9;&#9;&#9;&#9;local Position = ((CFrame.new(Vector3.new(Camera.CoordinateFrame.x,0,Camera.CoordinateFrame.z),Vector3.new(User.Head.CFrame.x,0,User.Head.CFrame.z))-Vector3.new(Camera.CoordinateFrame.x,0,Camera.CoordinateFrame.z)+Vector3.new(User.Head.CFrame.x,0,User.Head.CFrame.z)):toObjectSpace(CFrame.new(Players[x].Character.Torso.CFrame.p))).p
&#9;&#9;&#9;&#9;Position = Vector2.new((Position.x/50)*100,(Position.z/50)*100)
&#9;&#9;&#9;&#9;local Label = GUI.Circle.player:clone()
&#9;&#9;&#9;&#9;Label.Name = Players[x].Name ..&quot;Dot&quot;
&#9;&#9;&#9;&#9;Label.Parent = GUI.Circle.Objects

&#9;&#9;&#9;&#9;if Players[x].TeamColor == Player.TeamColor then
&#9;&#9;&#9;&#9;&#9;Label.Image = &quot;http://www.roblox.com/asset/?id=41067802&quot;
&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;Label.Image = &quot;http://www.roblox.com/asset/?id=41068173&quot;
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;Label.Size = UDim2.new(0,Size,0,Size)
&#9;&#9;&#9;&#9;Label.Position = UDim2.new(0.5,Position.x-(Size/2),0.5,Position.y-(Size/2))
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end

&#9;local workspace = game.Workspace:GetChildren()
&#9;for x = 1,#workspace do
&#9;&#9;if workspace[x].className == &quot;Model&quot; then
&#9;&#9;&#9;if workspace[x]:findFirstChild(&quot;Torso&quot;) ~= nil and workspace[x]:findFirstChild(&quot;Zombie&quot;) ~= nil then
&#9;&#9;&#9;&#9;local Distance = (Vector2.new(User.Torso.CFrame.x,User.Torso.CFrame.z)-Vector2.new(workspace[x].Torso.CFrame.x,workspace[x].Torso.CFrame.z)).magnitude
&#9;&#9;&#9;&#9;if Distance &lt;= 45 then
&#9;&#9;&#9;&#9;&#9;local Size = ((50-Distance)/40)*20
&#9;&#9;&#9;&#9;&#9;local Position = ((CFrame.new(Vector3.new(Camera.CoordinateFrame.x,0,Camera.CoordinateFrame.z),Vector3.new(User.Head.CFrame.x,0,User.Head.CFrame.z))-Vector3.new(Camera.CoordinateFrame.x,0,Camera.CoordinateFrame.z)+Vector3.new(User.Head.CFrame.x,0,User.Head.CFrame.z)):toObjectSpace(CFrame.new(workspace[x].Torso.CFrame.p))).p
&#9;&#9;&#9;&#9;&#9;Position = Vector2.new((Position.x/50)*100,(Position.z/50)*100)
&#9;&#9;&#9;&#9;&#9;local Label = GUI.Circle.player:clone()
&#9;&#9;&#9;&#9;&#9;Label.Name = workspace[x].Name ..&quot;Dot&quot;
&#9;&#9;&#9;&#9;&#9;Label.Parent = GUI.Circle.Objects
&#9;&#9;&#9;&#9;&#9;Label.name.Text = workspace[x].Name

&#9;&#9;&#9;&#9;&#9;Label.Image = &quot;http://www.roblox.com/asset/?id=41067802&quot;

&#9;&#9;&#9;&#9;&#9;Label.Size = UDim2.new(0,Size,0,Size)
&#9;&#9;&#9;&#9;&#9;Label.Position = UDim2.new(0.5,Position.x-(Size/2),0.5,Position.y-(Size/2))
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
wait(0.025)
end
</ProtectedString>
