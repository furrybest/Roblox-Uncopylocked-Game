											<string name="Name">Weld</string>
											<ProtectedString name="Source">original = script.Parent.Parent

function Welds()
Parts = script.Parent.Parent

m8 = Parts.DoorController2.Motor

Parts.Door2.Anchored = false

m8.Part0 = m8.Parent
m8.Part1 = Parts.Door2
m8.CurrentAngle = 0
m8.DesiredAngle = -1.3
m8.MaxVelocity = 0.1
m8.C1 = CFrame.new(0.,.01,0)*CFrame.fromEulerAnglesXYZ(0,math.pi/2,0)


end

model = original
Welds()



game.Players.ChildAdded:connect(onPlayerEntered)</ProtectedString>
