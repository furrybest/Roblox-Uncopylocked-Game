						<Item class="Script" referent="RBX9494">
							<Properties>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">Dark ON</string>
								<ProtectedString name="Source">--This script makes a GUI in StarterGui visible, so put the DarknessGUI in StarterGui
--You can also change the GUI from this script

function OnTouch(part)
local human = part.Parent:findFirstChild(&quot;Humanoid&quot;)
&#9;if (human ~= nil ) then 
&#9;local check = game.Players:findFirstChild(part.Parent.Name)
&#9;local gui = check.PlayerGui.Travel
&#9;gui.InOrbit.Shuttle.move.Disabled = true
&#9;wait(0.0001)
&#9;gui.InOrbit.Shuttle.move.Disabled = false
&#9;end 
end

script.Parent.Touched:connect(OnTouch)</ProtectedString>
