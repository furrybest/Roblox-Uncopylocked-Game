				<ProtectedString name="Source">print(&quot;WHAT A WONDERFULL SKYBOX TODAY. THE MEAT IS IN THE TACO!&quot;)

function onPlayerEntered(newPlayer)

&#9;local stats = Instance.new(&quot;IntValue&quot;)
&#9;stats.Name = &quot;leaderstats&quot;

&#9;local cash = Instance.new(&quot;IntValue&quot;)
&#9;cash.Name = &quot;Credits&quot; -- For RGRM, Credits would probably work better
&#9;cash.Value = 0 -- starting cash

&#9;cash.Parent = stats

&#9;cash.Parent = stats
&#9;
&#9;stats.Parent = newPlayer

&#9;while true do
&#9;&#9;wait(1) -- one second
&#9;&#9;cash.Value = cash.Value + 1 -- one prestige/cash per second
&#9;end
end

game.Players.ChildAdded:connect(onPlayerEntered)</ProtectedString>
			</Properties>
