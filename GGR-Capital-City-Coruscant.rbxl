				<Item class="Script" referent="RBX1104">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Welder</string>
						<ProtectedString name="Source">local x = script.Parent.Parent.Mainpart
local y = script.Parent

local W = Instance.new(&quot;Weld&quot;)
W.Part0 = x
W.Part1 = y
local CJ = CFrame.new(x.Position)
local C0 = x.CFrame:inverse()*CJ
local C1 = y.CFrame:inverse()*CJ
W.C0 = C0
W.C1 = C1
W.Parent = x
</ProtectedString>
					</Properties>
				</Item>
			</Item>
