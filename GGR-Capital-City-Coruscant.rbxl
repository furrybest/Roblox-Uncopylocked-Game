				<Item class="Script" referent="RBX3745">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Pauldron</string>
						<ProtectedString name="Source">function onTouched(hit)
&#9;if hit.Parent:findFirstChild(&quot;Humanoid&quot;) ~= nil and hit.Parent:findFirstChild(&quot;Pauldron&quot;) == nil then
&#9;&#9;local g = script.Parent.Parent.Pauldron:clone()
&#9;&#9;g.Parent = hit.Parent
&#9;&#9;local C = g:GetChildren()
&#9;&#9;for i=1, #C do
&#9;&#9;&#9;if C[i].className == &quot;Part&quot; then
&#9;&#9;&#9;&#9;local W = Instance.new(&quot;Weld&quot;)
&#9;&#9;&#9;&#9;W.Part0 = g.Middle
&#9;&#9;&#9;&#9;W.Part1 = C[i]
&#9;&#9;&#9;&#9;local CJ = CFrame.new(g.Middle.Position)
&#9;&#9;&#9;&#9;local C0 = g.Middle.CFrame:inverse()*CJ
&#9;&#9;&#9;&#9;local C1 = C[i].CFrame:inverse()*CJ
&#9;&#9;&#9;&#9;W.C0 = C0
&#9;&#9;&#9;&#9;W.C1 = C1
&#9;&#9;&#9;&#9;W.Parent = g.Middle
&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;local Y = Instance.new(&quot;Weld&quot;)
&#9;&#9;&#9;&#9;Y.Part0 = hit.Parent.Torso
&#9;&#9;&#9;&#9;Y.Part1 = g.Middle
&#9;&#9;&#9;&#9;Y.C0 = CFrame.new(0, 1.5, -0.01)
&#9;&#9;&#9;&#9;Y.Parent = Y.Part0
&#9;&#9;end

&#9;&#9;local h = g:GetChildren()
&#9;&#9;for i = 1, # h do
&#9;&#9;&#9;if h[i].className == &quot;Part&quot; then
&#9;&#9;&#9;&#9;h[i].Anchored = false
&#9;&#9;&#9;&#9;h[i].CanCollide = false
&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;
&#9;end
end

script.Parent.Touched:connect(onTouched)
</ProtectedString>
					</Properties>
				</Item>
				<Item class="Script" referent="RBX3746">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Anti Owner</string>
						<ProtectedString name="Source">print (&quot;VIP T-Shirt Door Script Loaded&quot;)

-- list of account names allowed to go through the door.
permission = {&quot;Greyhound40&quot;, &quot;gavinfirfox&quot; } -- This is how many people can still get through, so u don&apos;t have to change shirts. You can also have another friend here.

-- TextureId of the VIP shirt.
texture = &quot;http://&quot; -- Go to the wiki below this script to find out how to change the shirt. And paste the link in between the &quot;&quot; marks.

function checkOkToLetIn(name) 
&#9;for i = 1,#permission do 
&#9;&#9;-- convert strings to all upper case, otherwise we will let in 
&#9;&#9;-- &quot;Username&quot; but not &quot;username&quot; or &quot;uSERNAME&quot; 
&#9;&#9;if (string.upper(name) == string.upper(permission[i])) then return true end 
&#9;end 
&#9;return false 
end 

local Door = script.Parent

function onTouched(hit) 
&#9;print(&quot;Door Hit&quot;) 
&#9;local human = hit.Parent:findFirstChild(&quot;Humanoid&quot;) 
&#9;if (human ~= nil ) then 
&#9;&#9;if human.Parent.Torso.roblox.Texture == texture then --the shirt 
&#9;&#9;&#9;Door.Transparency = 0
&#9;&#9;&#9;Door.CanCollide = false 
&#9;&#9;&#9;wait(4) -- this is how long the door is open 
&#9;&#9;&#9;Door.CanCollide = true 
&#9;&#9;&#9;Door.Transparency = 0 
&#9;&#9;&#9;-- a human has touched this door! 
&#9;&#9;&#9;print(&quot;Human touched door&quot;) 
&#9;&#9;&#9;-- test the human&apos;s name against the permission list 
&#9;&#9;elseif (checkOkToLetIn(human.Parent.Name)) then 
&#9;&#9;&#9;print(&quot;Human passed test&quot;) 
&#9;&#9;&#9;Door.Transparency = 0
&#9;&#9;&#9;Door.CanCollide = true
&#9;&#9;&#9;wait(0) -- this is how long the door is open
&#9;&#9;&#9;Door.CanCollide = true 
&#9;&#9;&#9;Door.Transparency = 0 
&#9;&#9;else human.Health = 0 -- delete this line of you want a non-killing VIP door 
&#9;&#9;end 
&#9;end 
end 

script.Parent.Touched:connect(onTouched)
</ProtectedString>
					</Properties>
				</Item>
				<Item class="Script" referent="RBX3747">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Tele</string>
						<ProtectedString name="Source">d = game.Workspace.Line --Replace &apos;Object&apos; with the brick you want to be edited. Brick must be under workspace.

--If the brick is in a model: use this: (remove the -- before it and erase the above line)

--d = game.Workspace.INSERTMODELNAMEHERE.Object 

function onTouched(hit)
&#9;local humanoid = hit.Parent:findFirstChild(&quot;Humanoid&quot;)
&#9;if humanoid~=nil then --Checks for touches by players
&#9;hit.Parent:findFirstChild(&quot;Torso&quot;).CFrame = CFrame.new(d.Position)
&#9;end
end

script.Parent.Touched:connect(onTouched)

</ProtectedString>
					</Properties>
				</Item>
