				<Item class="Script" referent="RBX13848">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">ShirtScript</string>
						<ProtectedString name="Source">function onTouched(hit)
&#9;local h = hit.Parent:findFirstChild(&quot;Humanoid&quot;)
&#9;if h~=nil then
&#9;&#9;local s = hit.Parent:findFirstChild(&quot;Shirt&quot;)
&#9;&#9;if s~=nil and d~=nil then
&#9;&#9;&#9;hit.Parent.Shirt:remove()
&#9;&#9;&#9;script.Parent.Shirt:clone().Parent = hit.Parent
&#9;&#9;elseif s~=nil then
&#9;&#9;&#9;hit.Parent.Shirt:remove()
&#9;&#9;&#9;script.Parent.Shirt:clone().Parent = hit.Parent
&#9;&#9;elseif d~=nil then
&#9;&#9;&#9;script.Parent.Shirt:clone().Parent = hit.Parent
&#9;&#9;elseif s==nil and d==nil then
&#9;&#9;&#9;script.Parent.Shirt:clone().Parent = hit.Parent
&#9;&#9;end
&#9;end
end

script.Parent.Touched:connect(onTouched)
