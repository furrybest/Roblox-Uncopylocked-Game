						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Face Cange</string>
						<ProtectedString name="Source">-- declarations

local head = script.Parent
local sound = head:findFirstChild(&quot;Victory&quot;)

function onTouched(part)
&#9;local h = part.Parent:findFirstChild(&quot;Humanoid&quot;)
&#9;if h~=nil then
sound:play()
if part.Parent:findFirstChild(&quot;Head&quot;):findFirstChild(&quot;face&quot;).Texture == nil then return end
part.Parent:findFirstChild(&quot;Head&quot;):findFirstChild(&quot;face&quot;).Texture=&quot;http://&quot;
&#9;end
end

script.Parent.Touched:connect(onTouched)</ProtectedString>
