				<Item class="Script" referent="RBX15975">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Weld</string>
						<ProtectedString name="Source">model = script.Parent
WeldedTo = &quot;AircraftSeat&quot;
function stick(x, y)
&#9;weld = Instance.new(&quot;Weld&quot;) 

&#9;weld.Part0 = x
&#9;weld.Part1 = y

&#9;local HitPos = x.Position

&#9;local CJ = CFrame.new(HitPos) 
&#9;local C0 = x.CFrame:inverse() *CJ 
&#9;local C1 = y.CFrame:inverse() * CJ 

&#9;weld.C0 = C0 
&#9;weld.C1 = C1 
&#9;
&#9;weld.Parent = workspace
&#9;
&#9;weld.Name = &quot;Weld&quot;
end

local Stuff = script.Parent:GetChildren()
for X = 1, # Stuff do
&#9;if Stuff[X].className == &quot;CornerWedgePart&quot; or Stuff[X].className == &quot;Seat&quot; or Stuff[X].className==&quot;SpawnLocation&quot; or Stuff[X].className==&quot;WedgePart&quot; or Stuff[X].className==&quot;VehicleSeat&quot; then
&#9;&#9;if (Stuff[X].Name==WeldedTo) then
&#9;&#9;Stuff[X].Anchored = false
&#9;&#9;else
&#9;&#9;stick(Stuff[X], model[WeldedTo])
&#9;&#9;Stuff[X].Anchored = false
&#9;&#9;end
&#9;end
end
</ProtectedString>
					</Properties>
				</Item>
