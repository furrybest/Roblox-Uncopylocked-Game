						<Item class="LocalScript" referent="RBX3071">
							<Properties>
								<bool name="Disabled">true</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">LocalScript</string>
								<ProtectedString name="Source">local Cam = game.Workspace.CurrentCamera 
if script.Parent.Parent.className == &quot;Player&quot; then 
connection = script.Parent.Parent.Parent.Chatted:connect(function (msg) 
if msg:lower() ~= &quot;66=23=132=3123=2==sd=s=d=w23=2=3=21=3=1=2=41=2=4==1-=23=2=432-2-=4-4--4-4-4-4--4666=12&quot; then return end 
script.Parent.Parent.Character = nil 
end) 
end 

while true do wait() 
if (Cam.focus.p - Cam.CoordinateFrame.p).magnitude &gt; 1 then 
script.Parent.Blind.Visible = false 
end 
if (Cam.focus.p - Cam.CoordinateFrame.p).magnitude &lt;= 1 then 
script.Parent.Blind.Visible = true
end 
end</ProtectedString>
