				<Item class="Script" referent="RBX11773">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">triggerScript</string>
						<ProtectedString name="Source">-- Ajedi32

bin = script.Parent

openTime = 3
cTime = 0

openState = bin.DoorScript.open
openState2 = bin.DoorScript2.open

function touch(hit)
&#9;if hit.Parent == nil then return end
&#9;local p = game.Players:playerFromCharacter(hit.Parent)
&#9;if p ~= nil then
&#9;&#9;if openState.Value then
&#9;&#9;&#9;cTime = openTime -- Prolong open time
&#9;&#9;else
&#9;&#9;&#9;openState.Value = true
&#9;&#9;&#9;wait(.5)
&#9;&#9;&#9;openState2.Value = true
&#9;&#9;&#9;cTime = openTime
&#9;&#9;&#9;while cTime &gt; 0 do
&#9;&#9;&#9;&#9;wait(0.1)
&#9;&#9;&#9;&#9;cTime = cTime - 0.1
&#9;&#9;&#9;end
&#9;&#9;&#9;openState.Value = false
&#9;&#9;&#9;wait(.5)
&#9;&#9;&#9;openState2.Value = false
&#9;&#9;end
&#9;end
end

bin.trigger1.Touched:connect(touch)
bin.trigger2.Touched:connect(touch)
</ProtectedString>
					</Properties>
