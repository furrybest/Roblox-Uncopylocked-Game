										<Content name="LinkedSource"><null></null></Content>
										<string name="Name">Script</string>
										<ProtectedString name="Source">function onButton1Down(mouse)
p = script.Parent.Parent.Parent.Parent.Parent
ch = p.Character
t = ch.Torso
local b = t:findFirstChild(&quot;BodyVelocity&quot;)
if b == nil then 
a = Instance.new(&quot;BodyVelocity&quot;)
a.velocity = Vector3.new(0, 0, 0)
a.maxForce = Vector3.new(0,100000, 0)
a.Parent = t
script.Parent.Text = &quot;Jet (ON)&quot;
ch.Jetpack.Jet1.Light.Light1.Visible = true
ch.Jetpack.Jet1.Fire.Enabled = true
ch.Jetpack.Jet2.Light.Light1.Visible = true
ch.Jetpack.Jet2.Fire.Enabled = true
script.Parent.Menu.Visible = true
script.Parent.Menu.Up.script.Disabled = false
script.Parent.Menu.Down.script.Disabled = false
script.Parent.Menu.Hover.script.Disabled = false
else
b:remove()
script.Parent.Text = &quot;Jet (OFF)&quot;
script.Parent.Menu.Visible = false
ch.Jetpack.Jet1.Light.Light1.Visible = false
ch.Jetpack.Jet1.Fire.Enabled = false
ch.Jetpack.Jet2.Light.Light1.Visible = false
ch.Jetpack.Jet2.Fire.Enabled = false
script.Parent.Menu.Up.script.Disabled = true
script.Parent.Menu.Down.script.Disabled = true
script.Parent.Menu.Hover.script.Disabled = true
end 
end 


script.Parent.MouseButton1Click:connect(onButton1Down)
</ProtectedString>
