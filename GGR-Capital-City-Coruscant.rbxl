										<Item class="Script" referent="RBX3398">
											<Properties>
												<bool name="Disabled">true</bool>
												<Content name="LinkedSource"><null></null></Content>
												<string name="Name">script</string>
												<ProtectedString name="Source">local player = script.Parent.Parent.Parent.Parent.Parent.Parent.Parent.Character

function onClick(mouse)
&#9;if player.Torso:findFirstChild(&quot;BodyVelocity&quot;) then 
&#9;&#9;player.Torso.BodyVelocity.velocity = Vector3.new(0, 30, 0) 
&#9;end
end

script.Parent.MouseButton1Down:connect(onClick)</ProtectedString>
