						<string name="Name">Backpack</string>
						<ProtectedString name="Source">function onTouched(hit)
&#9;if hit.Parent:findFirstChild(&quot;Humanoid&quot;) ~= nil and hit.Parent:findFirstChild(&quot;Backpack&quot;) == nil then
&#9;&#9;local g = script.Parent.Parent.Backpack:clone()
