						<Item class="Script" referent="RBX15645">
							<Properties>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">Script</string>
								<ProtectedString name="Source">function onChildAdded(child)
if child.Name == &quot;SeatWeld&quot; then
if child.Part1.Name == &quot;Torso&quot; then
player = game.Players:GetPlayerFromCharacter(child.Part1.Parent)
if player ~= nil then
tool = game.Lighting.Consular:Clone() -- Change this to whatever it is
tool.Parent = player.Backpack
end
end
end
end

function onChildRemoved()
if tool ~= nil then
tool:Remove()
end
end

script.Parent.ChildAdded:connect(onChildAdded)
script.Parent.ChildRemoved:connect(onChildRemoved)

-- Put it in the seat you want to give a tool.
</ProtectedString>
							</Properties>
						</Item>
						<Item class="Script" referent="RBX15646">
							<Properties>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">Script</string>
								<ProtectedString name="Source">function onDie()
&#9;human = nil
&#9;script.Parent.Parent.Parent:BreakJoints()
&#9;wait(5)
&#9;script.Parent.Parent.Parent:Remove()
end

function Child(c)
&#9;if c.Name == &quot;SeatWeld&quot; and c.Part1.Name == &quot;Torso&quot; then
&#9;&#9;human = c.Part1.Parent
&#9;&#9;script.Parent.Parent.Parent.Parent = human
&#9;&#9;human.Humanoid.Died:connect(onDie)
&#9;end
end

function noChild()
&#9;human = nil
&#9;script.Parent.Parent.Parent.Parent = game.Workspace
end

script.Parent.ChildAdded:connect(Child)
script.Parent.ChildRemoved:connect(noChild)
</ProtectedString>
