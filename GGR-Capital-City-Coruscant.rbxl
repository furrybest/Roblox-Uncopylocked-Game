						<Item class="Script" referent="RBX8849">
							<Properties>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">Dark ON</string>
								<ProtectedString name="Source">--This script makes a GUI in StarterGui visible, so put the DarknessGUI in StarterGui
--You can also change the GUI from this script

function OnTouch(part)
local human = part.Parent:findFirstChild(&quot;Humanoid&quot;)
&#9;if (human ~= nil ) then 
&#9;local check = game.Players:findFirstChild(part.Parent.Name)
&#9;local gui = check.PlayerGui.Travel
&#9;gui.OnSurface.Shuttle.move.Disabled = true
&#9;wait(0.0001)
&#9;gui.OnSurface.Shuttle.move.Disabled = false
&#9;end 
end

script.Parent.Touched:connect(OnTouch)</ProtectedString>
							</Properties>
						</Item>
						<Item class="Script" referent="RBX8850">
							<Properties>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">WalkSpeed Script</string>
								<ProtectedString name="Source">local debounce = false 

function onTouch(part) 

local human = part.Parent:findFirstChild(&quot;Humanoid&quot;) 
if (human ~= nil) and debounce == false then 

debounce = true 

human.WalkSpeed = 0
wait(2.1)
human.WalkSpeed = 16

wait(0) 
debounce = false 
end 
end 


script.Parent.Touched:connect(onTouch) 
</ProtectedString>
