		<Item class="Script" referent="RBX10">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">RemoveSnaps</string>
				<ProtectedString name="Source">p= game.Workspace:GetChildren()			
for i= 1, #p do				
if p[i].className == &quot;Part&quot; then
if p[i].Anchored == true then
p[i]:BreakJoints()
end
elseif p[i].className == &quot;Model&quot; then
pp=p[i]:GetChildren()
for i=1, #pp do
if p[i].className == &quot;Part&quot; then
if p[i].Anchored == true then
p[i]:BreakJoints()
end
end
end
end

--[[ Basic SnapRemover that WONT remove welds. 

Credit to Anaminus

-- Dignity ]]
</ProtectedString>
				<bool name="archivable">true</bool>
