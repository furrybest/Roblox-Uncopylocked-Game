				<Item class="Script" referent="RBX1177">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">print(&quot;Message Interactive v2.0 Opened Successfully&quot;)

local debounce = false


function onHit(hit)
	local human = hit.Parent:findFirstChild(&quot;Humanoid&quot;)
	if (human ~= nil) and debounce == false then

                debounce = true

local message = Instance.new(&quot;Hint&quot;)
message.Text = &quot;You step foot up to the angel, labeled Winter...&quot;
message.Parent = game.Players:playerFromCharacter(hit.Parent)
wait(5)

message:Remove()

local message = Instance.new(&quot;Hint&quot;)
message.Text = &quot;A slight chill passes over your shoulder...&quot;
message.Parent = game.Players:playerFromCharacter(hit.Parent)
wait(5)

message:Remove()

local message = Instance.new(&quot;Hint&quot;)
message.Text = &quot; You stand frozen for what seems like an eternity...&quot;
message.Parent = game.Players:playerFromCharacter(hit.Parent)
wait(5)

message:Remove ()

local message = Instance.new(&quot;Hint&quot;)
message.Text = &quot;There&apos;s a ringing in your ears, as you hear a dark voice.&quot;
message.Parent = game.Players:playerFromCharacter(hit.Parent)
wait(5)

message:Remove ()

local message = Instance.new(&quot;Hint&quot;)
message.Text = &quot;The strong will, the strong mind of man...&quot;
message.Parent = game.Players:playerFromCharacter(hit.Parent)
wait(5)

message:Remove()

local message = Instance.new(&quot;Hint&quot;)
message.Text = &quot;...could never hold me down.&quot;
message.Parent = game.Players:playerFromCharacter(hit.Parent)
wait(5)

message:Remove()
local message = Instance.new(&quot;Hint&quot;)
message.Text = &quot;For that of what you&apos;re looking for,&quot;
message.Parent = game.Players:playerFromCharacter(hit.Parent)
wait(5)

message:Remove()

local message = Instance.new(&quot;Hint&quot;)
message.Text = &quot;...is what you put forth yourself.&quot;
message.Parent = game.Players:playerFromCharacter(hit.Parent)
wait(5)

message:Remove()

local message = Instance.new(&quot;Hint&quot;)
message.Text = &quot;The essence of life, the stride to push forward...&quot;
message.Parent = game.Players:playerFromCharacter(hit.Parent)
wait(5)

message:Remove()

local message = Instance.new(&quot;Hint&quot;)
message.Text = &quot;...from the fear of the darkness.&quot;
message.Parent = game.Players:playerFromCharacter(hit.Parent)
wait(5)

message:Remove()

local message = Instance.new(&quot;Hint&quot;)
message.Text = &quot;Through it all, no matter what it takes...&quot;
message.Parent = game.Players:playerFromCharacter(hit.Parent)
wait(5)

message:Remove()

local message = Instance.new(&quot;Hint&quot;)
message.Text = &quot;With this attribute, no push is left in vein.&quot;
message.Parent = game.Players:playerFromCharacter(hit.Parent)
wait(5)

message:Remove()

                debounce = false
	end
end

script.Parent.Touched:connect(onHit)

-- Entry: Commitment</ProtectedString>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
