				<Item class="Script" referent="RBX448">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">print(&quot;Message Interactive v2.0 Opened Successfully&quot;)

local debounce = false


function onHit(hit)
	local human = hit.Parent:findFirstChild(&quot;Humanoid&quot;)
	if (human ~= nil) and debounce == false then

                debounce = true

local message = Instance.new(&quot;Message&quot;)
message.Text = &quot;You step foot up to the angel, labeled Spring...&quot;
message.Parent = game.Players:playerFromCharacter(hit.Parent)
wait(5)

message:Remove()

local message = Instance.new(&quot;Message&quot;)
message.Text = &quot;As you walk up to the shrine...&quot;
message.Parent = game.Players:playerFromCharacter(hit.Parent)
wait(5)

message:Remove()

local message = Instance.new(&quot;Message&quot;)
message.Text = &quot;...you hear a light voice.&quot;
message.Parent = game.Players:playerFromCharacter(hit.Parent)
wait(5)

message:Remove()

local message = Instance.new(&quot;Message&quot;)
message.Text = &quot;My Child... simplicity knows no bounds-&quot;
message.Parent = game.Players:playerFromCharacter(hit.Parent)
wait(5)

message:Remove()

local message = Instance.new(&quot;Message&quot;)
message.Text = &quot;...for one as smart as you.&quot;
message.Parent = game.Players:playerFromCharacter(hit.Parent)
wait(5)

message:Remove()

local message = Instance.new(&quot;Message&quot;)
message.Text = &quot;Yonder ruthless, and prevail.&quot;
message.Parent = game.Players:playerFromCharacter(hit.Parent)
wait(5)

message:Remove()

local message = Instance.new(&quot;Message&quot;)
message.Text = &quot;-to gain what means most to you...&quot;
message.Parent = game.Players:playerFromCharacter(hit.Parent)
wait(5)

message:Remove()

local message = Instance.new(&quot;Message&quot;)
message.Text = &quot;Friendship, and love, the simple lust for life,&quot;
message.Parent = game.Players:playerFromCharacter(hit.Parent)
wait(5)

message:Remove()

local message = Instance.new(&quot;Message&quot;)
message.Text = &quot;that holds you together.&quot;
message.Parent = game.Players:playerFromCharacter(hit.Parent)
wait(5)

message:Remove()

local message = Instance.new(&quot;Message&quot;)
message.Text = &quot;To the mood that pushes you through every struggle...&quot;
message.Parent = game.Players:playerFromCharacter(hit.Parent)
wait(5)

message:Remove()

local message = Instance.new(&quot;Message&quot;)
message.Text = &quot;It brings but only one thought...&quot;
message.Parent = game.Players:playerFromCharacter(hit.Parent)
wait(5)

message:Remove()

                debounce = false
	end
end

script.Parent.Touched:connect(onHit)

