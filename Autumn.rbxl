							<ProtectedString name="Source">print(&quot;Message Interactive v2.0 Opened Successfully&quot;)

local debounce = false


function onHit(hit)
	local human = hit.Parent:findFirstChild(&quot;Humanoid&quot;)
	if (human ~= nil) and debounce == false then

                debounce = true

local message = Instance.new(&quot;Message&quot;)
message.Text = &quot;The Autumn breeze..&quot;
message.Parent = game.Players:playerFromCharacter(hit.Parent)
wait(5)

message:Remove ()

message.Text = &quot;catches but a glimpse of your nose..&quot;
message.Parent = game.Players:playerFromCharacter(hit.Parent)
wait(5)

message:Remove ()

message.Text = &quot;Smells.. almost familiar..&quot;
message.Parent = game.Players:playerFromCharacter(hit.Parent)
wait(5)

message:Remove ()

                debounce = false
	end
end

