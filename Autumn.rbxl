				<Item class="Script" referent="RBX2009">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">print(&quot;Message Interactive v2.0 Opened Successfully&quot;)

local debounce = false


function onHit(hit)
	local human = hit.Parent:findFirstChild(&quot;Humanoid&quot;)
	if (human ~= nil) and debounce == false then

                debounce = true

local message = Instance.new(&quot;Hint&quot;)
message.Text = &quot;You step up the odd statue...&quot;
message.Parent = game.Players:playerFromCharacter(hit.Parent)
wait(5)

message:Remove()

local message = Instance.new(&quot;Hint&quot;)
message.Text = &quot;A warm breeze slides aside your shoulder as you hear these words..&quot;
message.Parent = game.Players:playerFromCharacter(hit.Parent)
wait(5)

message:Remove()

local message = Instance.new(&quot;Hint&quot;)
message.Text = &quot;I am that of what once was, before the world, came to be...&quot;
message.Parent = game.Players:playerFromCharacter(hit.Parent)
wait(5)

message:Remove ()

local message = Instance.new(&quot;Hint&quot;)
message.Text = &quot;The peace, that the world has not spoken of, to be restored. The solitude, and love.&quot;
message.Parent = game.Players:playerFromCharacter(hit.Parent)
wait(5)

message:Remove()

local message = Instance.new(&quot;Hint&quot;)
message.Text = &quot;Driven away, and forbidden to return. I bring warmth, to those willing to bestow my power...&quot;
message.Parent = game.Players:playerFromCharacter(hit.Parent)
wait(5)

message:Remove()

                debounce = false

script.Parent.Touched:connect(onHit)

-- Entry: Tranquility




</ProtectedString>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
			</Item>
