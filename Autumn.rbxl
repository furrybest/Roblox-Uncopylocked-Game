			<Item class="Script" referent="RBX1728">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Time Open Script</string>
					<ProtectedString name="Source">--[[ &quot;Crag Rock&quot; Door opens every 5 minutes, to lead to the hidden well. ]]

door = script.parent

while true do
door.Transparency= 1 -- Transparency Level
door.CanCollide= false
wait(12) -- Open Waiting
door.Transparency= 0
door.CanCollide= true
wait(300) -- Time Limit
end

--[[ Dignity ]]--</ProtectedString>
					<bool name="archivable">true</bool>
				</Properties>
			</Item>
		</Item>
