							<string name="Source">local engine = script.Parent.Parent.Engine&#13;&#10;&#13;&#10;while true do&#13;&#10;&#9;wait()&#13;&#10;&#9;engine.RotVelocity = Vector3.new(0, -0.5, 0)&#13;&#10;end &#13;&#10;</string>
