							<Item class="Script" referent="RBX1833">
								<Properties>
									<bool name="Disabled">false</bool>
									<Content name="LinkedSource"><null></null></Content>
									<string name="Name">Script</string>
									<string name="Source">heart = script.Parent&#13;&#10;bottom = heart.Parent.Parent.Parent.Controls.ShipBottom&#13;&#10;sail = heart.Parent.Parent.Parent.ShipBody.SailConnector&#13;&#10;&#13;&#10;while true do&#13;&#10;&#9;wait(1)&#13;&#10;&#9;if (heart.Position - bottom.Position).magnitude &gt; 6 or (heart.Position - bottom.Position).magnitude &lt; 2 then&#13;&#10;&#9;local bodypos = bottom:findFirstChild(&quot;BodyPosition&quot;)&#13;&#10;&#9;if bodypos ~= nil then&#13;&#10;&#9;bodypos:remove()&#13;&#10;&#9;end&#13;&#10;&#13;&#10;&#9;sail:breakJoints()&#13;&#10;&#13;&#10;&#9;local velo = Instance.new(&quot;BodyVelocity&quot;)&#13;&#10;&#9;velo.velocity = Vector3.new(0, -2, 0)&#13;&#10;&#9;velo.maxForce = Vector3.new(0, &quot;9e+031&quot;, 0)&#13;&#10;&#9;velo.Parent = bottom&#13;&#10;&#9;bottom.Parent.Parent.SpawnLocation:remove()&#13;&#10;&#9;bottom.Parent.Parent.Parent:findFirstChild(&quot;ShipCount&quot;).Value = bottom.Parent.Parent.Parent:findFirstChild(&quot;ShipCount&quot;).Value -1&#13;&#10;&#9;wait(30)&#13;&#10;&#9;heart.Parent.Parent.Parent:remove()&#13;&#10;&#9;break end&#13;&#10;end </string>
									<bool name="archivable">true</bool>
								</Properties>
							</Item>
