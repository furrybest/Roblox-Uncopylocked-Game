				<Item class="StringValue" referent="RBX3327">
					<Properties>
						<string name="Name">Talk</string>
						<string name="Value">This hat costs 550$. Would you like to buy it? (y/n) [If you have already bought it, you won&apos;t have to pay again.]</string>
						<bool name="archivable">true</bool>
