		<Item class="HopperBin" referent="RBX12826">
			<Properties>
				<token name="BinType">0</token>
				<string name="Name">Color</string>
				<Content name="TextureId"><null></null></Content>
				<bool name="archivable">true</bool>
			</Properties>
			<Item class="Script" referent="RBX12827">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">ColorScript</string>
					<string name="Source">msg=Instance.new(&quot;Hint&quot;)
msg.Name=&quot;ColorHint&quot;
c=1
t=2 maxT=0.8
r=3 maxR=1
a=5
costT=.8 --per .1
costR=1 --per .1
costC=5 --for each dif. colour
cost=0 --running total of current cost
mode=c
ct=0
tt=0
function accept(suit)
	pl=game.Players.LocalPlayer.Character
	if pl==nil then return end
	if pl:findFirstChild(&quot;Torso&quot;)==nil then return end
	msg.Parent=game.Players.LocalPlayer
	cost=0 --reset the cost
	if suit.LA.BrickColor~=pl[&quot;Left Arm&quot;].BrickColor then cost=cost+costC end
	if suit.RA.BrickColor~=pl[&quot;Right Arm&quot;].BrickColor then  cost=cost+costC end
	if suit.LL.BrickColor~=pl[&quot;Left Leg&quot;].BrickColor then cost=cost+costC end
	if suit.RL.BrickColor~=pl[&quot;Right Leg&quot;].BrickColor then cost=cost+costC end
	if suit.T.BrickColor~=pl[&quot;Torso&quot;].BrickColor then cost=cost+costC end
	if suit.H.BrickColor~=pl[&quot;Head&quot;].BrickColor then cost=cost+costC end

	if suit.LA.Reflectance~=pl[&quot;Left Arm&quot;].Reflectance then cost=cost+costR*math.abs(suit.LA.Reflectance-pl[&quot;Left Arm&quot;].Reflectance) end
	if suit.RA.Reflectance~=pl[&quot;Right Arm&quot;].Reflectance then cost=cost+costR*math.abs(suit.RA.Reflectance-pl[&quot;Right Arm&quot;].Reflectance) end
	if suit.LL.Reflectance~=pl[&quot;Left Leg&quot;].Reflectance then cost=cost+costR*math.abs(suit.LL.Reflectance-pl[&quot;Left Leg&quot;].Reflectance) end
	if suit.RL.Reflectance~=pl[&quot;Right Leg&quot;].Reflectance then cost=cost+costR*math.abs(suit.RL.Reflectance-pl[&quot;Right Leg&quot;].Reflectance) end
	if suit.T.Reflectance~=pl[&quot;Torso&quot;].Reflectance then cost=cost+costR*math.abs(suit.T.Reflectance-pl[&quot;Torso&quot;].Reflectance) end
	if suit.H.Reflectance~=pl[&quot;Head&quot;].Reflectance then cost=cost+costR*math.abs(suit.H.Reflectance-pl[&quot;Head&quot;].Reflectance) end

	if suit.LA.Transparency~=pl[&quot;Left Arm&quot;].Transparency then cost=cost+costT*math.abs(suit.LA.Transparency-pl[&quot;Left Arm&quot;].Transparency) end
	if suit.RA.Transparency~=pl[&quot;Right Arm&quot;].Transparency then cost=cost+costT*math.abs(suit.RA.Transparency-pl[&quot;Right Arm&quot;].Transparency) end
	if suit.LL.Transparency~=pl[&quot;Left Leg&quot;].Transparency then Cost=cost+costT*math.abs(suit.LL.Transparency-pl[&quot;Left Leg&quot;].Transparency) end
	if suit.RL.Transparency~=pl[&quot;Right Leg&quot;].Transparency then cost=cost+costT*math.abs(suit.RL.Transparency-pl[&quot;Right Leg&quot;].Transparency) end
	if suit.T.Transparency~=pl[&quot;Torso&quot;].Transparency then cost=cost+costT*math.abs(suit.T.Transparency-pl[&quot;Torso&quot;].Transparency) end
	if suit.H.Transparency~=pl[&quot;Head&quot;].Transparency then cost=cost+costT*math.abs(suit.H.Transparency-pl[&quot;Head&quot;].Transparency) end
--NOW TO ACTUALLY CHANGE IT!
	cost=math.ceil(cost) --ensures if they changed say 1 transparency, they still have to pay 1$ not 0$!!
	mn=game.Players.LocalPlayer
	if mn.leaderstats.Money.Value &gt;= cost then 
		mn.leaderstats.Money.Value=mn.leaderstats.Money.Value-cost
		if suit.LA.BrickColor~=pl[&quot;Left Arm&quot;].BrickColor then pl[&quot;Left Arm&quot;].BrickColor=suit.LA.BrickColor end
		if suit.RA.BrickColor~=pl[&quot;Right Arm&quot;].BrickColor then pl[&quot;Right Arm&quot;].BrickColor=suit.RA.BrickColor end
		if suit.LL.BrickColor~=pl[&quot;Left Leg&quot;].BrickColor then pl[&quot;Left Leg&quot;].BrickColor=suit.LL.BrickColor end
		if suit.RL.BrickColor~=pl[&quot;Right Leg&quot;].BrickColor then pl[&quot;Right Leg&quot;].BrickColor=suit.RL.BrickColor end
		if suit.T.BrickColor~=pl[&quot;Torso&quot;].BrickColor then pl[&quot;Torso&quot;].BrickColor=suit.T.BrickColor end
		if suit.H.BrickColor~=pl[&quot;Head&quot;].BrickColor then pl[&quot;Head&quot;].BrickColor=suit.H.BrickColor end

		if suit.LA.Reflectance~=pl[&quot;Left Arm&quot;].Reflectance then pl[&quot;Left Arm&quot;].Reflectance=suit.LA.Reflectance end
		if suit.RA.Reflectance~=pl[&quot;Right Arm&quot;].Reflectance then pl[&quot;Right Arm&quot;].Reflectance=suit.RA.Reflectance end
		if suit.LL.Reflectance~=pl[&quot;Left Leg&quot;].Reflectance then pl[&quot;Left Leg&quot;].Reflectance=suit.LL.Reflectance end
		if suit.RL.Reflectance~=pl[&quot;Right Leg&quot;].Reflectance then pl[&quot;Right Leg&quot;].Reflectance=suit.RL.Reflectance end
		if suit.T.Reflectance~=pl[&quot;Torso&quot;].Reflectance then pl[&quot;Torso&quot;].Reflectance=suit.T.Reflectance end
		if suit.H.Reflectance~=pl[&quot;Head&quot;].Reflectance then pl[&quot;Head&quot;].Reflectance=suit.H.Reflectance end

		if suit.LA.Transparency~=pl[&quot;Left Arm&quot;].Transparency then pl[&quot;Left Arm&quot;].Transparency=suit.LA.Transparency end
		if suit.RA.Transparency~=pl[&quot;Right Arm&quot;].Transparency then pl[&quot;Right Arm&quot;].Transparency=suit.RA.Transparency end
		if suit.LL.Transparency~=pl[&quot;Left Leg&quot;].Transparency then pl[&quot;Left Leg&quot;].Transparency=suit.LL.Transparency end
		if suit.RL.Transparency~=pl[&quot;Right Leg&quot;].Transparency then pl[&quot;Right Leg&quot;].Transparency=suit.RL.Transparency end
		if suit.T.Transparency~=pl[&quot;Torso&quot;].Transparency then pl[&quot;Torso&quot;].Transparency=suit.T.Transparency end
		if suit.H.Transparency~=pl[&quot;Head&quot;].Transparency then pl[&quot;Head&quot;].Transparency=suit.H.Transparency end
		msg.Text=&quot;Thank-you for purchasing Builderman Suite Hotel Fully Customizable Suits!&quot;
	else
		msg.Text=&quot;Sorry, but you don&apos;t have enough money to buy this suit.&quot;
	end	
	tt=ct+5
end
function onKeyDown(key)
	key=key:lower()
	if key==&quot;q&quot; then giveInstructions()
	elseif key==&quot;c&quot; then mode=c msg.Parent=game.Players.LocalPlayer msg.Text=&quot;Current Property: Colour&quot;
	elseif key==&quot;t&quot; then mode=t msg.Parent=game.Players.LocalPlayer msg.Text=&quot;Current Property: Transparency&quot;
	elseif key==&quot;r&quot; then mode=r msg.Parent=game.Players.LocalPlayer msg.Text=&quot;Current Property: Reflectance&quot;
	elseif key==&quot;a&quot; then mode=a msg.Parent=game.Players.LocalPlayer msg.Text=&quot;Click on the suit to pay and get your new colours!&quot;
	elseif key==&quot;x&quot; then msg.Parent=nil tt=0
	end
	tt=ct+5
end
db=false
function giveInstructions()
	if db then return end
	db=true
	tt=0
	msg.Parent=game.Players.LocalPlayer
	msg.Text=&quot;INSTRUCTIONS&quot;
	wait(2)
	msg.Text=&quot;Click on a suit piece to change the property currently selected.&quot;
	wait(4)
	msg.Text=&quot;Valid properties: c=colour, t=transparency, and r=reflectance.&quot;
	wait(5)
	msg.Text=&quot;Cycle through them until you get the property value you want, then press a to accept and click the suit!&quot;
	wait(5)
	msg.Text=&quot;It will cost you money, though! It is based on the amount of changes compared to your current suit [body colours].&quot;
	wait(5)
	msg.Text=&quot;END OF INSTRUCTIONS (press q to see again, x to get rid of this msg at any time)&quot;
	db=false
	tt=ct+10
end
function onButton1Down(mouse)
	local player = game.Players.LocalPlayer
	if player == nil then return end
	obj=mouse.Target
	if obj.Parent.Name==&quot;Suit&quot; then
		if mode==t then
			obj.Transparency=math.floor(obj.Transparency*10+1.0001)/10
			if math.floor(obj.Transparency*10+0.001)&gt;maxT*10 then obj.Transparency=0 end
		elseif mode==r then
			obj.Reflectance=math.floor(obj.Reflectance*10+1.0001)/10
			if obj.Reflectance&gt;maxR then obj.Reflectance=0 end
		elseif mode==c then
			if obj.BrickColor==BrickColor.new(&quot;Bright red&quot;) then
				obj.BrickColor=BrickColor.new(&quot;Bright orange&quot;)
			elseif obj.BrickColor==BrickColor.new(&quot;Bright orange&quot;) then
				obj.BrickColor=BrickColor.new(&quot;Bright yellow&quot;)
			elseif obj.BrickColor==BrickColor.new(&quot;Bright yellow&quot;) then
				obj.BrickColor=BrickColor.new(&quot;Bright green&quot;)
			elseif obj.BrickColor==BrickColor.new(&quot;Bright green&quot;) then
				obj.BrickColor=BrickColor.new(&quot;Bright blue&quot;)
			elseif obj.BrickColor==BrickColor.new(&quot;Bright blue&quot;) then
				obj.BrickColor=BrickColor.new(&quot;Dark orange&quot;)
			elseif obj.BrickColor==BrickColor.new(&quot;Dark orange&quot;) then
				obj.BrickColor=BrickColor.new(&quot;Bright violet&quot;)
			elseif obj.BrickColor==BrickColor.new(&quot;Bright violet&quot;) then
				obj.BrickColor=BrickColor.new(&quot;Brown&quot;)
			elseif obj.BrickColor==BrickColor.new(&quot;Brown&quot;) then
				obj.BrickColor=BrickColor.new(&quot;Medium blue&quot;)
			elseif obj.BrickColor==BrickColor.new(&quot;Medium blue&quot;) then
				obj.BrickColor=BrickColor.new(&quot;Dark green&quot;)
			elseif obj.BrickColor==BrickColor.new(&quot;Dark green&quot;) then
				obj.BrickColor=BrickColor.new(&quot;Medium stone grey&quot;)
			elseif obj.BrickColor==BrickColor.new(&quot;Medium stone grey&quot;) then
				obj.BrickColor=BrickColor.new(&quot;Dark stone grey&quot;)
			elseif obj.BrickColor==BrickColor.new(&quot;Dark stone grey&quot;) then
				obj.BrickColor=BrickColor.new(&quot;Black&quot;)
			elseif obj.BrickColor==BrickColor.new(&quot;Black&quot;) then
				obj.BrickColor=BrickColor.new(&quot;White&quot;)
			else
				obj.BrickColor=BrickColor.new(&quot;Bright red&quot;)
			end
		elseif mode==a then --accepted!
			accept(obj.Parent)
		end
	end
	mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
end

function onSelected(mouse)
	mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
	mouse.Button1Down:connect(function() onButton1Down(mouse) end)
	mouse.KeyDown:connect(onKeyDown)
	giveInstructions()
end
script.Parent.Selected:connect(onSelected)
while script.Parent~=nil do --only operate while we are in &quot;existance&quot;
	wait(1)
	ct=ct+1
	if tt&lt;=ct and tt~=0 then
		tt=0
		msg.Parent=nil
	end
end
msg:Remove()
