		<Item class="HopperBin" referent="RBX12740">
			<Properties>
				<token name="BinType">0</token>
				<string name="Name">Water</string>
				<Content name="TextureId"><null></null></Content>
				<bool name="archivable">true</bool>
			</Properties>
			<Item class="Script" referent="RBX12866">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">MenuScript</string>
					<string name="Source">function onSelected(mouse)	h=Instance.new(&quot;Hint&quot;)
	i=game.Players.LocalPlayer.stats.Inventory
	if i:findFirstChild(&quot;Water&quot;)==nil then
		if #i:getChildren()&gt;=4 then
			h.Text=&quot;You can&apos;t hold more than 4 items. Put some back first.&quot;
		else
			l=Instance.new(&quot;BoolValue&quot;)
			l.Name=&quot;Water&quot;
			l.Parent=i
			h.Text=&quot;You are now holding some water!&quot;
		end
	else
		h.Text=&quot;You are already holding some water.&quot;
	end
	h.Parent=game.Players.LocalPlayer
	s=game.Lighting.DeleteChildScript:clone()
	s.What.Value=h
	s.Parent=game.Workspace
	script.Parent:Remove()endscript.Parent.Selected:connect(onSelected)</string>
					<bool name="archivable">true</bool>
				</Properties>
			</Item>
