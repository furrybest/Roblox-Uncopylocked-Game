	ch=script.Parent:GetChildren()
	for i = #ch, 1, -1 do
		if ch[i].Name~=&quot;Script&quot; then
			f=ch[i]
			if f.Name==&quot;Food&quot; then
				if (f.Content.Value==7 or f.Content.Value==31) and f.Cooked.Value==true then
					f.Reflectance=0.7
				elseif f.Reflectance~=0.5 then
					f.Reflectance=0
				end
			elseif f.Name==&quot;Food2&quot; then
				if f.Cooked.Value==true then 
					f.Reflectance=0.7
				elseif f.Reflectance~=0.5 then
					f.Reflectance=0
				end
			end
			if f.Position.y&gt;160 then ch[i]:Remove() end
		end
	end
end
