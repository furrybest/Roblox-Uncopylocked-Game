					<Item class="Script" referent="RBX7010">
						<Properties>
							<bool name="Disabled">true</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script</string>
							<string name="Source">wait(.1)
w=script.Who.Value
h=Instance.new(&quot;Hint&quot;)
h.Parent=w
ch = w.stats.Keys:getChildren()
for i = 1, #ch do
	if ch[i]:findFirstChild(&quot;ID&quot;)~=nil then --a key to a room!
		ch[i]:Remove()
		h.Text=&quot;There we are! Thank-you for visiting Builderman&apos;s Suite Hotel! Come back soon!&quot;
	end
end
wait(6)
h:Remove()
script:Remove() --we&apos;re just taking up space!
</string>
							<bool name="archivable">true</bool>
						</Properties>
						<Item class="ObjectValue" referent="RBX7011">
							<Properties>
