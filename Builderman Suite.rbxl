	local i	for i = 1, 3 do --assing random times		--a and b are constants that control the range of the transparency; where a is min and b is max %%		a=30		b=60		--note that a and b should both be 1 when i = 3, so...		if i==3 then a=100 b=100 end		t[i]=math.random(a, b)/100		la[i]=math.random(a, b)/100		ra[i]=math.random(a, b)/100		ll[i]=math.random(a, b)/100		rl[i]=math.random(a, b)/100		h[i]=math.random(a, b)/100	end	for i = 1, 27 do --for formulas, see appear()		if i==1 or i==10 or i==19 then --new shift			st = pt.Transparency			sla = pla.Transparency			sra = pra.Transparency			sll = pll.Transparency			srl = prl.Transparency			sh = ph.Transparency			shift = math.ceil(i/9)		end		v = 9/(i-(shift-1)*9)		pt.Transparency=st+(t[shift]-st)/v		pla.Transparency=sla+(la[shift]-sla)/v		pra.Transparency=sra+(ra[shift]-sra)/v		pll.Transparency=sll+(ll[shift]-sll)/v		prl.Transparency=srl+(rl[shift]-srl)/v		ph.Transparency=sh+(h[shift]-sh)/v		wait(.03)	endendfunction appear(person) --takes ~~1 second to occur	-- s_ is the starting transparency at the beginning of a new shift	-- p_ is the actual part, and _ by itself is the target transparency (not applicable here, is 1)	-- of course, there is no s_ here, either	local pt = person:findFirstChild(&quot;Torso&quot;)	local pla = person:findFirstChild(&quot;Left Arm&quot;)	local pra = person:findFirstChild(&quot;Right Arm&quot;)	local pll = person:findFirstChild(&quot;Left Leg&quot;)	local prl = person:findFirstChild(&quot;Right Leg&quot;)	local ph = person:findFirstChild(&quot;Head&quot;)	if pt == nil or pla == nil or pra == nil or pll == nil or prl == nil or ph == nil then return end --the person&apos;s not all there!
	local i	for i = 1, 27 do --a step is start+(target-start)/steps, and *that by step# for step Val.		pt.Transparency=1-1/27*i		pla.Transparency=1-1/27*i		pra.Transparency=1-1/27*i		pll.Transparency=1-1/27*i		prl.Transparency=1-1/27*i		ph.Transparency=1-1/27*i		wait(.03)	end	pt.Anchored=falseendfunction onHit(hit)	if hit.Parent:findFirstChild(&quot;Humanoid&quot;) ~= nil then		shouldReturn=false		tag(hit.Parent) --ensures we don&apos;t &quot;teleport&quot; multiple times		if shouldReturn then return end --comes from &quot;hit.Parent&quot; tagging response! [debounce]		disappear(hit.Parent)		wait(.5)		hit.Parent:moveTo(TeleportTo)		wait(.5)		appear(hit.Parent)		untag(hit.Parent)	endendscript.Parent.Touched:connect(onHit)
