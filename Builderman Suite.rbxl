					<Item class="StringValue" referent="RBX2773">
						<Properties>
							<string name="Name">Talk</string>
							<string name="Value">What would you like to order? a. Hamburger b. Sandwich c. Milk d. Water e. Pop f. Fries g. Soup n. Nothing</string>
							<bool name="archivable">true</bool>
						</Properties>
						<Item class="StringValue" referent="RBX11938">
							<Properties>
								<string name="Name">a</string>
								<string name="Value">A hamburger costs 5$ and gives you 5 minutes of life! Buy it? y/n</string>
								<bool name="archivable">true</bool>
							</Properties>
							<Item class="StringValue" referent="RBX11939">
								<Properties>
									<string name="Name">y</string>
									<string name="Value"></string>
									<bool name="archivable">true</bool>
								</Properties>
								<Item class="Script" referent="RBX11940">
									<Properties>
										<bool name="Disabled">true</bool>
										<Content name="LinkedSource"><null></null></Content>
										<string name="Name">Script</string>
										<string name="Source">name=&quot;Hamburger&quot;
cost=5
food=300
max=900
wait(.1)
p=script.Who.Value
if p~=nil then
	h=Instance.new(&quot;Hint&quot;)
	h.Parent=p
	f=p.stats.Food
	m=p.leaderstats.Money
	if m.Value&gt;=cost then
		f.Value=f.Value+food
		m.Value=m.Value-cost
		if f.Value&gt;=max then
			h.Text=&quot;You have eaten a &quot; .. name .. &quot;! You are full now. Eating more simply wastes your money.&quot;
			f.Value=max
		else
			h.Text=&quot;You have eaten a &quot; .. name .. &quot;! You are still hungry though.&quot;
		end
	else
		h.Text=&quot;You don&apos;t have enough money to make the purchase.&quot;
	end
	wait(5)
	h:Remove()
end
