					<Item class="StringValue" referent="RBX1829">
						<Properties>
							<string name="Name">random2</string>
							<string name="Value">There&apos;s tons to do at the hotel! Want to hear more? (y/n)</string>
							<bool name="archivable">true</bool>
						</Properties>
						<Item class="StringValue" referent="RBX1827">
							<Properties>
								<string name="Name">y</string>
								<string name="Value">We have swimming pools, restaurants, keys, doors... and some even say we have secret rooms! Don&apos;t put too much into those rumours, though. Anyway, lots to do, so have fun!</string>
								<bool name="archivable">true</bool>
							</Properties>
						</Item>
						<Item class="StringValue" referent="RBX1830">
							<Properties>
								<string name="Name">n</string>
								<string name="Value">Alright. Well, enjoy your stay at the hotel!</string>
								<bool name="archivable">true</bool>
							</Properties>
						</Item>
					</Item>
					<Item class="StringValue" referent="RBX1831">
						<Properties>
							<string name="Name">random3</string>
							<string name="Value">Welcome! Interested in getting money? There are so many jobs available! Want to know more? (y/n)</string>
							<bool name="archivable">true</bool>
						</Properties>
						<Item class="StringValue" referent="RBX1832">
