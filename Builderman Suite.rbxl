						<string name="Name">Script</string>
						<string name="Source">function onTouch(obj)
	p=game.Players:findFirstChild(obj.Parent.Name)
	if p~=nil then
		t=p.Backpack:findFirstChild(&quot;Color&quot;)
		if t==nil then
			game.Lighting.Color:clone().Parent=p.Backpack
		end
	end
end
script.Parent.Touched:connect(onTouch)
