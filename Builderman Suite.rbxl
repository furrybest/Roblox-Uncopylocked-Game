			<Item class="StringValue" referent="RBX12148">
				<Properties>
					<string name="Name">Talk</string>
					<string name="Value">Hello! Just give me a second to find your key #...</string>
					<bool name="archivable">true</bool>
				</Properties>
				<Item class="Script" referent="RBX12149">
					<Properties>
						<bool name="Disabled">true</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<string name="Source">wait(.1)
w=script.Who.Value
h=Instance.new(&quot;Hint&quot;)
h.Parent=w
ch = w.stats.Keys:getChildren()
h.Text=&quot;You don&apos;t own a key... perhaps your room expired?&quot;
for i = 1, #ch do
	if ch[i]:findFirstChild(&quot;ID&quot;)~=nil then --a key to a room!
		h.Text=&quot;Your key # is &quot; .. ch[i].ID.Value .. &quot;! Have a nice stay at Builderman&apos;s Suite Hotel!&quot;
		break
	end
end
wait(6)
h:Remove()
script:Remove() --we&apos;re just taking up space!
</string>
						<bool name="archivable">true</bool>
					</Properties>
