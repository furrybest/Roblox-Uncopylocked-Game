				<Item class="Script" referent="RBX11566">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<string name="Source">function onTouch(obj)
	p=game.Players:findFirstChild(obj.Parent.Name)
	if p~=nil then
		t=p.Backpack:findFirstChild(&quot;Color&quot;)
		if t~=nil then t:Remove() end
		h=p:findFirstChild(&quot;ColorHint&quot;)
		if h~=nil then h:Remove() end
	end
end
script.Parent.Touched:connect(onTouch)
</string>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
