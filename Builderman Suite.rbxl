										<string name="Name">Script</string>
										<string name="Source">script.Parent.Value=script.Parent.Parent.Parent.Parent.Parent.n
</string>
										<bool name="archivable">true</bool>
									</Properties>
								</Item>
							</Item>
						</Item>
						<Item class="StringValue" referent="RBX1823">
							<Properties>
								<string name="Name">y</string>
								<string name="Value">Lots of jobs! You can mop the floors, clean windows and bathroom supplies, do gardening, or even cook! But don&apos;t forget to enjoy yourself!</string>
								<bool name="archivable">true</bool>
							</Properties>
