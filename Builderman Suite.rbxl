						<string name="Source">debounce = false
function onButton1Down(mouse)
	if debounce==true then return end
	debounce=true
	local player = game.Players.LocalPlayer
	if player == nil then return end
	if mouse.Target.Parent.Name==&quot;Weed&quot; and mouse.Target.Parent.Parent.Name==&quot;Garden&quot; then
		t=player.Character:findFirstChild(&quot;Torso&quot;)
		if t==nil then return end
		obj=mouse.Target.Parent
		dist=(obj.Stem.Position-t.Position).magnitude
		if dist&lt;=15 then
			obj:Remove()
			p=script.Parent.Parent.Parent
			s=p:findFirstChild(&quot;leaderstats&quot;)
			if s~=nil then
				if s:findFirstChild(&quot;Money&quot;)~=nil then
						s.Money.Value=s.Money.Value+2 --EDITABLE
					end
			end
		else
			m=Instance.new(&quot;Hint&quot;)
			m.Parent=player
			m.Text=&quot;You aren&apos;t close enough to kill that weed.&quot;
			wait(2)
			m:Remove()
		end
	end
	debounce=false
end

