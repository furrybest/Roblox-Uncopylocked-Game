						<string name="Name">Script</string>
						<string name="Source">selected=false
obj=nil
function onButton1Down(mouse)
	if selected then
		n=mouse.Target.Name
		if n==&quot;Counter&quot; or n==&quot;Stove&quot; or (n==&quot;Top&quot; and mouse.Target.Parent.Name==&quot;Table&quot;) then 
			obj.Position=mouse.Hit.p
			obj.Reflectance=0
			selected=false
			if game.Players.LocalPlayer==obj.Creator.Value then obj.LastTimeAccessed.Value=game.Workspace.Timer.Time.Value end
		elseif mouse.Target==obj then --deselect
			obj.Reflectance=0
			selected=false
			if game.Players.LocalPlayer==obj.Creator.Value then obj.LastTimeAccessed.Value=game.Workspace.Timer.Time.Value end
		end
	else
		n=mouse.Target.Name
		if n==&quot;Food&quot; or n==&quot;Drink&quot; or n==&quot;Food2&quot; then
			obj=mouse.Target
			obj.Reflectance=0.5
			selected=true
		end
	end
	
end

function onSelected(mouse)
	mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
	mouse.Button1Down:connect(function() onButton1Down(mouse) end)
	h=Instance.new(&quot;Hint&quot;)
	h.Text=&quot;Move food items to the counter, stove, or to the tables!&quot;
	h.Parent=game.Players.LocalPlayer
	s=game.Lighting.DeleteChildScript:clone()
	s.What.Value=h
	s.Parent=game.Workspace
end
script.Parent.Selected:connect(onSelected)
