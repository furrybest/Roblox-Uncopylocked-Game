			<Item class="HopperBin" referent="RBX12778">
				<Properties>
					<token name="BinType">0</token>
					<string name="Name">Up-&gt;Put Back</string>
					<Content name="TextureId"><null></null></Content>
					<bool name="archivable">true</bool>
				</Properties>
				<Item class="ObjectValue" referent="RBX12891">
					<Properties>
						<string name="Name">Tree</string>
						<Ref name="Value">RBX12777</Ref>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
				<Item class="Script" referent="RBX12892">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">MenuScript</string>
						<string name="Source">function onSelected(mouse)
	b=game.Players.LocalPlayer.Backpack
	import=script.Parent.Tree.Value.Parent.Parent:GetChildren()
	delete=script.Parent.Tree.Value.Parent:GetChildren()
	iv=b.Parent.stats.Inventory
	for i = 1, #import do
		import[i].Value:clone().Parent=b
	end
	for i = 1, #delete do
		if #iv:getChildren() &gt; 0 then
			if iv:FindFirstChild(delete[i].Name)~=nil then
				b:findFirstChild(delete[i].Value.Name):Remove()
			end
		end
	end
	script.Parent:Remove() --special delete for UP-&gt;___ tools
endscript.Parent.Selected:connect(onSelected)</string>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
			</Item>
		</Item>
		<Item class="HopperBin" referent="RBX12893">
			<Properties>
				<token name="BinType">0</token>
				<string name="Name">select</string>
				<Content name="TextureId"><url>rbxasset://Textures\GameTool.png</url></Content>
				<bool name="archivable">true</bool>
			</Properties>
			<Item class="HopperBin" referent="RBX12766">
				<Properties>
					<token name="BinType">0</token>
					<string name="Name">Bread</string>
					<Content name="TextureId"><null></null></Content>
					<bool name="archivable">true</bool>
				</Properties>
				<Item class="ObjectValue" referent="RBX12894">
					<Properties>
						<string name="Name">Tree</string>
						<Ref name="Value">RBX12765</Ref>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
				<Item class="Script" referent="RBX12895">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">SelectScript</string>
						<string name="Source">debounce=false
function onButton1Down(mouse)
	if debounce then return end
	debounce=true
	if mouse.Target.Name==&quot;Counter&quot; then 
		f=game.Lighting.resources.Food:clone()
		f.Parent=game.Workspace.FoodItems
		f.Cooked.Value=false
		f.Description.Value = &quot;Food. Status: Uncooked -- Contains:  Bread&quot;
		f.Content.Value=0
		f.Position=mouse.Hit.p
		f.Creator.Value=game.Players.LocalPlayer
		f.LastTimeAccessed.Value=game.Workspace.Timer.Time.Value
		wait(1) --prevent noobs from creating hundreds of food items!
	end
	debounce=false
end

function onSelected(mouse)
	mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
	mouse.Button1Down:connect(function() onButton1Down(mouse) end)
	h=Instance.new(&quot;Hint&quot;)
	h.Text=&quot;Click on a counter to make more bread food items.&quot;
	h.Parent=game.Players.LocalPlayer
	s=game.Lighting.DeleteChildScript:clone()
	s.What.Value=h
	s.Parent=game.Workspace
end
script.Parent.Selected:connect(onSelected)
</string>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
			</Item>
			<Item class="HopperBin" referent="RBX12752">
				<Properties>
					<token name="BinType">0</token>
					<string name="Name">Cheese</string>
					<Content name="TextureId"><null></null></Content>
					<bool name="archivable">true</bool>
				</Properties>
				<Item class="ObjectValue" referent="RBX12896">
					<Properties>
						<string name="Name">Tree</string>
						<Ref name="Value">RBX12751</Ref>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
				<Item class="Script" referent="RBX12897">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">SelectScript</string>
						<string name="Source">function getDesc(v)
	if cooked then stc=&quot;Cooked&quot; else stc=&quot;Uncooked&quot; end
	d=&quot;Food. Status: &quot; .. stc .. &quot; -- Contains:  Bread&quot;
	if math.floor(v/16)==1 then v=v-16 d=d..&quot;, Mustard&quot; end
	if math.floor(v/8)==1 then v=v-8 d=d..&quot;, Ketchup&quot; end
	if math.floor(v/4)==1 then v=v-4 d=d..&quot;, Meat&quot; end
	if math.floor(v/2)==1 then v=v-2 d=d..&quot;, Cheese&quot; end
	if v==1 then d=d..&quot;, Lettuce&quot; end
	return d
end
cooked=false
function onButton1Down(mouse)
	if debounce then return end
	debounce=true
	if mouse.Target.Name==&quot;Food&quot; then 
		f=mouse.Target
		s=getDesc(f.Content.Value)
		cooked=f.Cooked.Value
		if string.find(s, &quot;Cheese&quot;)==nil then f.Content.Value=f.Content.Value+2 end
		f.Description.Value = getDesc(f.Content.Value)
		if game.Players.LocalPlayer==f.Creator.Value then f.LastTimeAccessed.Value=game.Workspace.Timer.Time.Value end
	end
	debounce=false
end

