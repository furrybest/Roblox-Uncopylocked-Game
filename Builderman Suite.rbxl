			<Item class="Script" referent="RBX10750">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<string name="Source">ch1=script.Parent:getChildren()
ch={}
for i = 1, #ch1 do if ch1[i].Name==&quot;Tele&quot; then table.insert(ch, ch1[i]) end end

db=false
function onTouch(obj)
	if db then return end
	db=true
	if game.Players:findFirstChild(obj.Parent.Name)~=nil then
		obj.Parent:MoveTo(Vector3.new(-23, 1010, 972))
	end
	wait()
	db=false
end

for i = 1, #ch do ch[i].Touched:connect(onTouch) end
</string>
					<bool name="archivable">true</bool>
				</Properties>
			</Item>
		</Item>
