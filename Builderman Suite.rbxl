					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">GrowingScript</string>
					<string name="Source">speed=8 --between 1 (standard) and 10 (super-fast!!)maxFlowers=150 --num bricks tends to be maxFlowers*2 add no more than 50 after that for weeds--5 steps to a flower--1-3 == the height of the stem--4; flower appears (yellow 1x1 platform) --COULD BE YELLOW, ORANGE, OR RED!--5; flower grows (yellow 3x3 platform)--WATER SYSTEM--If &lt; 3 then flowers&apos; health goes down (turn brown eventually)--if &gt;=3 and &lt;=5 then nothing happens--if &gt;5 then health up--water not higher than 8, else just doesn&apos;t do anything--Water decreases by 1 every 30sec--HEALTH SYSTEM [goes up/down 1/sec based on water conditions (see above)]--If above 50, will gain growth.--If below 20, will lose growth.--Won&apos;t die, even with 0 health, until GROWTH turns to 0.--GROWTH SYSTEM--Starts at 5, if gets to 0 or 10 will turn brown(die) or grow another stage--every 10sec it can gain/lose another value.--A NEW FLOWER SPROUTS IF Water &gt;5
ch=script.Parent:getChildren()
for i =1, #ch do	if ch[i].Name==&quot;Flower&quot; or ch[i].Name==&quot;Weed&quot; then ch[i]:Remove() endend
flowers={} --array of flowersflowerStage={} --the stage it&apos;s atflowerHealth={} --the health it&apos;s atflowerGrowth={} --how far it is to getting to the next stagew=script.Parent.Waterd=script.Parent.Descriptionw.Value=8 --standard starting valuefunction getHealthString(v)	if v&lt;3 then return &quot;Very dry soil.&quot; elseif v&lt;= 5 then return &quot;The soil has little water.&quot; else return &quot;The soil is moist!&quot; endendfunction getHealthDirection(v)	if v&lt;3 then return -1 elseif v&lt;= 5 then return 0 else return 1 endenddip=script.Parent.Dirt.Positiondis=script.Parent.Dirt.Size
dis=Vector3.new(dis.x-2, dis.y, dis.z-2)function numberFlowers() --that are alive/existant (so technically could be dead and is counted)	num=0	for q=1, #flowers do		if flowerHealth[q]~=-100 then num=num+1 end	end	return numendfunction newFlowerPosition() --works for weeds, too!	smag=0 --magnitude... distance to the nearest flower	trials=0	while smag&lt;=3 and trials&lt;200 do		trials=trials+1		pos=Vector3.new(math.random(dip.x-dis.x/2, dip.x+dis.x/2), 1.4, math.random(dip.z-dis.z/2, dip.z+dis.z/2))		ch=script.Parent:getChildren()
		smag=10		for z = 1, #ch do			if ch[z].className==&quot;Model&quot; then part=ch[z].Stem mag=(part.Position-pos).magnitude if mag&lt;smag then smag=mag end end		end	end	return posendfunction kill(flower)	ch=flower:getChildren()	for x=1, #ch do		ch[x].BrickColor=BrickColor.new(&quot;Brown&quot;)	endend
function updateWeed(curWeed) --kills all the flowers
	for w=1, #flowers do
		if flowerHealth[w]&gt;0 and (flowers[w].Stem.Position - curWeed.Stem.Position).magnitude &lt;= 8 then kill(flowers[w]) flowerHealth[w]=-1 end
	end
end
function updateWeeds() --kill all surrounding flowers within 8 units.
	ch=script.Parent:getChildren()
	for ww=1, #ch do
		if ch[ww]==nil then return end --believe it or not, this line is needed!!!
		if ch[ww].Name==&quot;Weed&quot; then updateWeed(ch[ww]) end
	end
endfunction addWeed() --just add another weed!
	weed=Instance.new(&quot;Model&quot;)
	weed.Name=&quot;Weed&quot;
	weed2=Instance.new(&quot;Part&quot;)
	weed2.Name=&quot;Stem&quot;
	weed2.BrickColor=BrickColor.new(&quot;Sand green&quot;)
	weed2.Parent=weed
	weed2.FormFactor=2
	weed2.BackSurface=3
	weed2.BottomSurface=3
	weed2.FrontSurface=3
	weed2.LeftSurface=3
	weed2.RightSurface=3
	weed2.TopSurface=3
	weed2.Size=Vector3.new(2,0.4,2)
	weed2.CFrame=CFrame.new(newFlowerPosition())
	weed.Parent=script.Parent
	weed2.Anchored=true
	weed2:BreakJoints()
endfunction addFlower()	for q=1, #flowers do		if flowerHealth[q]==-100 then changeStage(q, 1) return end	end	changeStage(#flowers+1, 1) --make a new index!endfunction changeStage(j, newStage) --where j is the index of the flower	if newStage==1 then		flowers[j]=Instance.new(&quot;Model&quot;)		flowers[j].Name=&quot;Flower&quot;		flowers[j].Parent=game.Workspace.Garden		s=Instance.new(&quot;Part&quot;)		s.Name=&quot;Stem&quot;		s.Parent=flowers[j]		s.BrickColor=BrickColor.new(&quot;Dark green&quot;)		s.Size=Vector3.new(1,1,1)
		s:BreakJoints()		s.CFrame=CFrame.new(newFlowerPosition())		s.Anchored=true		flowerStage[j]=1		flowerHealth[j]=80	elseif newStage&lt;=3 then		s=flowers[j].Stem		s.Size=Vector3.new(1,newStage+0.1,1)
		s:BreakJoints()
		s.CFrame=CFrame.new(Vector3.new(s.Position.x, s.Size.y/2+0.8, s.Position.z))	elseif newStage==4 then		m=Instance.new(&quot;Part&quot;)		cc=math.random(1,3)		if cc==1 then c=BrickColor.new(&quot;Bright red&quot;) elseif cc==2 then c=BrickColor.new(&quot;Bright yellow&quot;) else c=BrickColor.new(&quot;Bright orange&quot;) end		m.BrickColor=c		m.FormFactor=2		m.Size=Vector3.new(1,0.4,1)		pos = flowers[j].Stem.Position
		m:BreakJoints()		m.CFrame=CFrame.new(Vector3.new(pos.x, 4.6, pos.z))		m.Name=&quot;Flower&quot;		m.Parent=flowers[j]		m.Anchored=true		else --is 5 or higher
		s=flowers[j].Stem		m=flowers[j].Flower		m.Size=Vector3.new(3,0.4,3)
		m.CFrame=CFrame.new(Vector3.new(s.Position.x, 4.6, s.Position.z))
	end
	flowerGrowth[j]=5end
updateWeedTrue=falsefunction update()	for i = 1, #flowers do		if flowerHealth[i]&gt;-1 then -- (-1 or less) means dead; -100 == non-existant			a=getHealthDirection(w.Value)			flowerHealth[i]=flowerHealth[i]+a			if flowerHealth[i]&gt;100 then flowerHealth[i]=100 end			if flowerHealth[i]&lt;0 then flowerHealth[i]=0 end			if t%10==0 then --we can also update growth				if flowerHealth[i]&gt;=60 then					flowerGrowth[i]=flowerGrowth[i]+1				elseif flowerHealth[i]&lt;=30 then					flowerGrowth[i]=flowerGrowth[i]-1				end				if flowerGrowth[i]&gt;=10 then					flowerStage[i]=flowerStage[i]+1					changeStage(i, flowerStage[i]) --doesn&apos;t care if it&apos;s greater than 5				elseif flowerGrowth[i]&lt;=0 then					flowerHealth[i]=-1 --kill the flower!					kill(flowers[i]) --turn it brown!				end			end		elseif flowerHealth[i]~=-100 then			flowerHealth[i]=flowerHealth[i]-1			if flowerHealth[i]&lt;=-20 then				flowers[i]:Remove()
			end		end	end	if t%45==0 and w.Value&gt;0 then w.Value=w.Value-1 end	if w.Value&gt;5 and numberFlowers() &lt; maxFlowers then addFlower() end
	if math.random(0,30)==0 then addWeed() updateWeedTrue=true end --the weed strikes again!!!!endt=0 --current timewhile true do	wait(1/speed)
	if updateWeedTrue==true then updateWeedTrue=false updateWeeds() end	t=t+1	d.Value=&quot;The garden! &quot; .. getHealthString(w.Value)	update()end</string>
					<bool name="archivable">true</bool>
				</Properties>
			</Item>
