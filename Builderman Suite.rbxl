					<Item class="Script" referent="RBX1021">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script</string>
							<string name="Source">decals={script.Parent.DecalHQ, script.Parent.Decal}
i=0
while true do
	wait(4)
	i=i+1
	if i&gt;#decals then i=1 end
	for d = 1, #decals do
		decals[d].Face=4
	end
	decals[i].Face=1
end
</string>
							<bool name="archivable">true</bool>
						</Properties>
