					<string name="Source">function onSelected(mouse)
	ch=game.Workspace.Kitchen:getChildren()
	q=false --Qualified?
	for c=1, #ch do
		if ch[c].Name==&quot;Garbage Can&quot; and (ch[c].Can.Position-game.Players.LocalPlayer.Character.Torso.Position).magnitude&lt;15 then q=true end
	end
	if q then
		b=game.Players.LocalPlayer.Backpack
		import=script.Parent.Tree.Value:GetChildren()
		delete=script.Parent.Tree.Value.Parent:GetChildren()
		for i = 1, #import do
			import[i].Value:clone().Parent=b
		end
		for i = 1, #delete do
			b:findFirstChild(delete[i].Value.Name):Remove()
		end
	else
		h=Instance.new(&quot;Hint&quot;)
		h.Text=&quot;You aren&apos;t close enough to the shelf!&quot;
		h.Parent=game.Players.LocalPlayer
		s=game.Lighting.DeleteChildScript:clone()
		s.What.Value=h
		s.Parent=game.Workspace
	end
endscript.Parent.Selected:connect(onSelected)</string>
