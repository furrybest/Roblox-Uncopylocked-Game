				<Item class="StringValue" referent="RBX3351">
					<Properties>
						<string name="Name">Talk</string>
						<string name="Value">This hat costs 350$. Would you like to buy it? (y/n) [If you have already bought it, you won&apos;t have to pay again.]</string>
						<bool name="archivable">true</bool>
					</Properties>
					<Item class="StringValue" referent="RBX3352">
						<Properties>
							<string name="Name">y</string>
