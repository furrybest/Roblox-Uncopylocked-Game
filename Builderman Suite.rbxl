					<string name="Name">MenuScript</string>
					<string name="Source">function onButton1Down(mouse)
	n=mouse.Target.Name
	if n==&quot;Food&quot; or n==&quot;Drink&quot; or n==&quot;Food2&quot; then 
		if mouse.Target.Creator.Value==nil or mouse.Target.Creator.Value==game.Players.LocalPlayer or mouse.Target.LastTimeAccessed.Value + 60 &lt;= game.Workspace.Timer.Time.Value then
			mouse.Target:Remove() 
		else
			h=Instance.new(&quot;Hint&quot;)
			h.Text=&quot;You can&apos;t garbage that! Someone else made it and may be using it. Wait until it expires (60 sec from last access).&quot;
			h.Parent=game.Players.LocalPlayer
			s=game.Lighting.DeleteChildScript:clone()
			s.What.Value=h
			s.Parent=game.Workspace
		end
	end
end

function onSelected(mouse)
	ch=game.Workspace.Kitchen:getChildren()
	q=false --Qualified?
	for c=1, #ch do
		if ch[c].Name==&quot;Garbage Can&quot; and (ch[c].Can.Position-game.Players.LocalPlayer.Character.Torso.Position).magnitude&lt;15 then q=true end
	end
	if q then
		mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
		mouse.Button1Down:connect(function() onButton1Down(mouse) end)
		h=Instance.new(&quot;Hint&quot;)
		h.Text=&quot;Click on the food item you want to garbage.&quot;
		h.Parent=game.Players.LocalPlayer
		s=game.Lighting.DeleteChildScript:clone()
		s.What.Value=h
		s.Parent=game.Workspace
	else
		h=Instance.new(&quot;Hint&quot;)
		h.Text=&quot;You aren&apos;t close enough to the garbage can!&quot;
		h.Parent=game.Players.LocalPlayer
		s=game.Lighting.DeleteChildScript:clone()
		s.What.Value=h
		s.Parent=game.Workspace
	endendscript.Parent.Selected:connect(onSelected)
