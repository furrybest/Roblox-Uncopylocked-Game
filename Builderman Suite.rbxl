			<Item class="StringValue" referent="RBX2677">
				<Properties>
					<string name="Name">Description</string>
					<string name="Value">The hockey arena coach! He can help you exit the game and switch teams.</string>
					<bool name="archivable">true</bool>
				</Properties>
			</Item>
			<Item class="StringValue" referent="RBX2678">
				<Properties>
					<string name="Name">Talk</string>
					<string name="Value">Hey there! What can I do for you? (a. Switch teams b. Instructions c. Quit d. What do the numbers mean? e. Nothing)</string>
					<bool name="archivable">true</bool>
				</Properties>
				<Item class="StringValue" referent="RBX2679">
					<Properties>
						<string name="Name">a</string>
						<string name="Value"></string>
						<bool name="archivable">true</bool>
					</Properties>
					<Item class="Script" referent="RBX2680">
						<Properties>
							<bool name="Disabled">true</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script</string>
							<string name="Source">while script:findFirstChild(&quot;Who&quot;)==nil do	wait(.1)endw=script.Who.Valueh2=Instance.new(&quot;Hint&quot;)h2.Parent=wh=game.Workspace[&quot;Hockey Arena&quot;]r=h.RedTeamb=h.BlueTeamif r:findFirstChild(w.Name)~=nil then	r:findFirstChild(w.Name).Parent=b	w.Character.Head.BrickColor=BrickColor.new(&quot;Bright blue&quot;)	h2.Text=&quot;You are now on the blue team!&quot;elseif b:findFirstChild(w.Name)~=nil then	b:findFirstChild(w.Name).Parent=r	w.Character.Head.BrickColor=BrickColor.new(&quot;Bright red&quot;)	h2.Text=&quot;You are now on the red team!&quot;else	h2.Text=&quot;There must be some error... you aren&apos;t registered on a team! Try exiting the hockey arena and re-entering.&quot;endwait(5)h2:Remove()script:Remove()</string>
							<bool name="archivable">true</bool>
						</Properties>
						<Item class="ObjectValue" referent="RBX2681">
							<Properties>
								<string name="Name">Who</string>
								<Ref name="Value">null</Ref>
								<bool name="archivable">true</bool>
							</Properties>
						</Item>
					</Item>
				</Item>
				<Item class="StringValue" referent="RBX2682">
					<Properties>
						<string name="Name">b</string>
						<string name="Value"></string>
						<bool name="archivable">true</bool>
					</Properties>
					<Item class="Script" referent="RBX2683">
						<Properties>
							<bool name="Disabled">true</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script</string>
							<string name="Source">while script:findFirstChild(&quot;Who&quot;)==nil do	wait(.1)endw=script.Who.Valueh2=Instance.new(&quot;Hint&quot;)h2.Parent=wh=game.Workspace[&quot;Hockey Arena&quot;]if h.RedTeam:findFirstChild(w.Name)~=nil then	h2.Text=&quot;Simply push the puck into the blue net!&quot;else	h2.Text=&quot;Simply push the puck into the red net!&quot;endwait(5)h2:Remove()script:Remove()</string>
							<bool name="archivable">true</bool>
						</Properties>
						<Item class="ObjectValue" referent="RBX2684">
							<Properties>
								<string name="Name">Who</string>
								<Ref name="Value">null</Ref>
								<bool name="archivable">true</bool>
							</Properties>
						</Item>
					</Item>
				</Item>
				<Item class="StringValue" referent="RBX2685">
					<Properties>
						<string name="Name">c</string>
						<string name="Value"></string>
						<bool name="archivable">true</bool>
					</Properties>
					<Item class="Script" referent="RBX2686">
						<Properties>
							<bool name="Disabled">true</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script</string>
							<string name="Source">while script:findFirstChild(&quot;Who&quot;)==nil do	wait(.1)endw=script.Who.Valueh2=Instance.new(&quot;Hint&quot;)h2.Parent=wh2.Text=&quot;Ok then. Have a good stay at Builderman Suite Hotel!&quot;
h=game.Workspace[&quot;Hockey Arena&quot;]r=h.RedTeamb=h.BlueTeamp=game.Workspace.Dinner.TeleportTo.Seat.Positionw.Character:MoveTo(Vector3.new(p.x,p.y+7,p.z))w.Character.Head.BrickColor=w.HeadColor.Value--is this correct?
if r:findFirstChild(w.Name)~=nil then	r:findFirstChild(w.Name):Remove()elseif b:findFirstChild(w.Name)~=nil then	b:findFirstChild(w.Name):Remove()endwait(5)
h2:Remove()
script:Remove()
</string>
							<bool name="archivable">true</bool>
						</Properties>
						<Item class="ObjectValue" referent="RBX2687">
							<Properties>
								<string name="Name">Who</string>
								<Ref name="Value">null</Ref>
								<bool name="archivable">true</bool>
							</Properties>
						</Item>
					</Item>
				</Item>
				<Item class="StringValue" referent="RBX2688">
					<Properties>
						<string name="Name">d</string>
						<string name="Value">The numbers above me show the seconds left until the end of the game. The numbers of each net show the number of scores that have been made on the net.</string>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
				<Item class="StringValue" referent="RBX2689">
					<Properties>
						<string name="Name">e</string>
						<string name="Value">Well then... get scoring!</string>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
			</Item>
		</Item>
