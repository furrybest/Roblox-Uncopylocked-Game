			<Item class="HopperBin" referent="RBX12611">
				<Properties>
					<token name="BinType">0</token>
					<string name="Name">Mop</string>
					<Content name="TextureId"><null></null></Content>
					<bool name="archivable">true</bool>
				</Properties>
				<Item class="Script" referent="RBX12612">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">FloorWasher</string>
						<string name="Source">function onButton1Down(mouse)	if debounce==true then return end	debounce=true	local player = game.Players.LocalPlayer	if player == nil then return end	obj= mouse.Target	if obj==nil then return end	if obj.Name==&quot;Floor*&quot; and obj:findFirstChild(&quot;Clean&quot;)~=nil then
		t=player.Character:findFirstChild(&quot;Torso&quot;)
		if t==nil then return end
		dist=(obj.Position-t.Position).magnitude - math.max(obj.Size.x, obj.Size.z)
		if dist&lt;=20 then			if obj.Clean.Value&lt;5 then 				obj.Clean.Value=obj.Clean.Value+1				s=player:findFirstChild(&quot;leaderstats&quot;)				if s~=nil then					m=s:findFirstChild(&quot;Money&quot;)					if m~=nil then m.Value=m.Value+2 end				end			else				m=Instance.new(&quot;Hint&quot;)				m.Text=&quot;This floor is already clean!&quot;				m.Parent=player				wait(2)				m:Remove()			end
		else
			m=Instance.new(&quot;Hint&quot;)
			m.Parent=player
			m.Text=&quot;You aren&apos;t close enough to clean it!&quot;
			wait(2)
			m:Remove()
		end	end	debounce = falseendfunction onSelected(mouse)	mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;	mouse.Button1Down:connect(function() onButton1Down(mouse) end)endcleanTools={&quot;Bathroom&quot;, &quot;Mop&quot;, &quot;Water&quot;, &quot;Weed&quot;, &quot;Window&quot;}
function onAncestryChanged()
	if script.Parent.Parent.Name==&quot;Backpack&quot; then --do a search! Are there other CLEANING tools? If so, kick the oldest one.
		script.Parent.Age.Value=3 --being highest, we&apos;ll ignore ourself...
		b=script.Parent.Parent
		for i= 1, #cleanTools do
			nc = b:findFirstChild(cleanTools[i])
			if nc~=nil then
				v=nc.Age
				if v.Value==0 then nc:Remove() else v.Value=0 end
			end
		end
		script.Parent.Age.Value=1 --this way, we won&apos;t be removed instantly, but the time after that.
	end
end
script.Parent.AncestryChanged:connect(onAncestryChanged)script.Parent.Selected:connect(onSelected)</string>
