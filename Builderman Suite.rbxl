			<Item class="StringValue" referent="RBX12124">
				<Properties>
					<string name="Name">Description</string>
					<string name="Value">Wow It&apos;s the may be famous weaselman50!</string>
					<bool name="archivable">true</bool>
				</Properties>
			</Item>
			<Item class="StringValue" referent="RBX12125">
				<Properties>
					<string name="Name">Talk</string>
					<string name="Value">Welcome I am Weaselman50! Want to chat? (y/n)</string>
					<bool name="archivable">true</bool>
				</Properties>
				<Item class="StringValue" referent="RBX12126">
					<Properties>
						<string name="Name">y</string>
						<string name="Value">Great!</string>
						<bool name="archivable">true</bool>
					</Properties>
					<Item class="StringValue" referent="RBX12127">
						<Properties>
							<string name="Name">random1</string>
							<string name="Value">You must be worthy of an orb for finding me...wanna know something else? (y/n) </string>
							<bool name="archivable">true</bool>
						</Properties>
						<Item class="StringValue" referent="RBX12128">
							<Properties>
								<string name="Name">n</string>
								<string name="Value">Ok. Talk to you later, then!</string>
								<bool name="archivable">true</bool>
							</Properties>
						</Item>
						<Item class="StringValue" referent="RBX12129">
							<Properties>
								<string name="Name">y</string>
								<string name="Value">There are more secret orbs like this! Have fun finded em&apos;!</string>
								<bool name="archivable">true</bool>
							</Properties>
						</Item>
					</Item>
					<Item class="StringValue" referent="RBX12130">
						<Properties>
							<string name="Name">random2</string>
							<string name="Value">Entering contests are a great way to meet new friends! Aren&apos;t they?</string>
							<bool name="archivable">true</bool>
						</Properties>
						<Item class="StringValue" referent="RBX12131">
							<Properties>
								<string name="Name">y</string>
								<string name="Value">I think so too! </string>
								<bool name="archivable">true</bool>
							</Properties>
						</Item>
						<Item class="StringValue" referent="RBX12132">
							<Properties>
								<string name="Name">n</string>
								<string name="Value">Alright. If you say so.  Well, enjoy your stay at the hotel!</string>
								<bool name="archivable">true</bool>
							</Properties>
						</Item>
					</Item>
					<Item class="StringValue" referent="RBX12133">
						<Properties>
							<string name="Name">random3</string>
							<string name="Value">If you see the other builders around be sure to say hi for me! Will you do that? (y/n)</string>
							<bool name="archivable">true</bool>
						</Properties>
						<Item class="StringValue" referent="RBX12134">
							<Properties>
								<string name="Name">y</string>
								<string name="Value">Thanks!</string>
								<bool name="archivable">true</bool>
							</Properties>
						</Item>
						<Item class="StringValue" referent="RBX12135">
							<Properties>
								<string name="Name">n</string>
								<string name="Value">Well, it&apos;s up to you..</string>
								<bool name="archivable">true</bool>
							</Properties>
						</Item>
					</Item>
				</Item>
				<Item class="StringValue" referent="RBX12136">
					<Properties>
						<string name="Name">n</string>
						<string name="Value">Oh. Ok... well, have fun at the hotel!</string>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
			</Item>
		</Item>
