			<Item class="Script" referent="RBX11643">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<string name="Source">b={}
ch=script.Parent:getChildren()
for i = 1, # ch do
	if ch[i].Name==&quot;Head&quot; then table.insert(b,ch[i]) end
end

function teleport(obj)
	p=obj.Parent
	if p:findFirstChild(&quot;Humanoid&quot;)~=nil then
		p:MoveTo(game.Workspace[&quot;Starting Entrance&quot;].SpawnLocation.Position)
	end
end


for i = 1, #b do
	b[i].Touched:connect(teleport)
end
</string>
					<bool name="archivable">true</bool>
				</Properties>
			</Item>
