				<Item class="StringValue" referent="RBX3155">
					<Properties>
						<string name="Name">Talk</string>
						<string name="Value">This hat costs 10$. Would you like to buy it? (y/n) [If you have already bought it, you won&apos;t have to pay again.]</string>
						<bool name="archivable">true</bool>
					</Properties>
					<Item class="StringValue" referent="RBX3156">
						<Properties>
							<string name="Name">y</string>
							<string name="Value"></string>
