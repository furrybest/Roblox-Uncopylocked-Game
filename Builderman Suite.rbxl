					<Item class="StringValue" referent="RBX2535">
						<Properties>
							<string name="Name">Talk</string>
							<string name="Value">This shirt costs 20$. Would you like to buy it? (y/n) [If you have already bought it, you won&apos;t have to pay again.]</string>
							<bool name="archivable">true</bool>
						</Properties>
						<Item class="StringValue" referent="RBX2536">
							<Properties>
								<string name="Name">y</string>
								<string name="Value"></string>
								<bool name="archivable">true</bool>
							</Properties>
							<Item class="Script" referent="RBX2537">
								<Properties>
									<bool name="Disabled">true</bool>
									<Content name="LinkedSource"><null></null></Content>
									<string name="Name">SuitPTie</string>
									<string name="Source">wait()
cost=20 --edit this!
name=script.Name
who=script.Who.Value
t=script.Texture.Value
--first job, do they have this shirt already? If so, they don&apos;t have to pay for it!
m=Instance.new(&quot;Hint&quot;)
m.Parent=who
continue=true
buy=true
if who.stats.Hats:findFirstChild(name)==nil then --have to pay
	if who.leaderstats.Money.Value&gt;=cost then
		m.Text=&quot;You have bought the shirt!&quot;
		who.leaderstats.Money.Value=who.leaderstats.Money.Value-cost
	else
		m.Text=&quot;You don&apos;t have enough money to pay for that shirt!&quot;
		continue=false
	end
else
	m.Text=&quot;You are now wearing the shirt.&quot;
	buy=false
end
if continue then
	hh=who.Character.Torso:findFirstChild(&quot;roblox&quot;)
	if hh==nil then hh=Instance.new(&quot;Decal&quot;) hh.Shiny=20 hh.Specular=0 hh.Face=5 hh.Name=&quot;roblox&quot; hh.Parent=who.Character.Torso end
	hh.Texture=t
	if buy then
		b=Instance.new(&quot;BoolValue&quot;) --record that we&apos;ve bought this shirt
		b.Name=name
		b.Parent=who.stats.Hats
	end
end
wait(4)
m:Remove()
script:Remove()</string>
