								<string name="Source">wait(0.1)
pos=Vector3.new(0,-0.3, 0) --edit this!
cost=1000 --edit this!

name=script.Name
who=script.Who.Value
mesh=script.Mesh --make sure the mesh is the HAT mesh!
--first job, do they have this hat already? If so, they don&apos;t have to pay for it!
m=Instance.new(&quot;Hint&quot;)
m.Parent=who
continue=true
if who.stats.Hats:findFirstChild(name)==nil then --have to pay
	if who.leaderstats.Money.Value&gt;=cost then
		m.Text=&quot;You have bought the hat!&quot;
		who.leaderstats.Money.Value=who.leaderstats.Money.Value-cost
	else
		m.Text=&quot;You don&apos;t have enough money to pay for this hat!&quot;
		continue=false
	end
else
	m.Text=&quot;You are now wearing the hat.&quot;
end
if continue then
	hh=who.Character:findFirstChild(&quot;A_Hat&quot;)
	if hh~=nil then hh:Remove() end
	h = Instance.new(&quot;Hat&quot;)
	p = Instance.new(&quot;Part&quot;)
	h.Name = &quot;A_Hat&quot;
	p.Parent = h
	p.Position = who.Character.Head.Position
	p.Name = &quot;Handle&quot; 
	p.formFactor = 0
	p.Size = Vector3.new(2, 1, 1) 
	p.BottomSurface = 0 
	p.TopSurface = 0 
	p.Locked = true 
	mesh:clone().Parent = p
	h.Parent = who.Character
	h.AttachmentPos = pos
	b=Instance.new(&quot;BoolValue&quot;) --record that we&apos;ve bought this hat
	b.Name=name
	b.Parent=who.stats.Hats
end
wait(4)
m:Remove()
script:Remove()</string>
