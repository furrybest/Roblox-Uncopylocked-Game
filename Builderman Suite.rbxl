		<Item class="HopperBin" referent="RBX12722">
			<Properties>
				<token name="BinType">0</token>
				<string name="Name">Stove</string>
				<Content name="TextureId"><null></null></Content>
				<bool name="archivable">true</bool>
			</Properties>
			<Item class="Script" referent="RBX12858">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">BakeScript</string>
					<string name="Source">function onButton1Down(mouse)
	n=mouse.Target.Name
	if n==&quot;Food&quot; or n==&quot;Food2&quot; then
		if mouse.Target.Cooked.Value==false and mouse.Target:findFirstChild(&quot;Cooker&quot;)==nil then
			game.Lighting.resources.Cooker:clone().Parent=mouse.Target
		end
	end
end

function onSelected(mouse)
	ch=game.Workspace.Kitchen:getChildren()
	q=false --Qualified?
	for c=1, #ch do
		if ch[c].Name==&quot;Stove&quot; and (ch[c].Stove.Position-game.Players.LocalPlayer.Character.Torso.Position).magnitude&lt;15 then q=true end
	end
	if q then
		mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
		mouse.Button1Down:connect(function() onButton1Down(mouse) end)
		h=Instance.new(&quot;Hint&quot;)
		h.Text=&quot;Click on a food item to cook it. NOTE: It takes time to cook!&quot;
		h.Parent=game.Players.LocalPlayer
		s=game.Lighting.DeleteChildScript:clone()
		s.What.Value=h
		s.Parent=game.Workspace
	else
		h=Instance.new(&quot;Hint&quot;)
		h.Text=&quot;You aren&apos;t close enough to the stove to cook anything!&quot;
		h.Parent=game.Players.LocalPlayer
		s=game.Lighting.DeleteChildScript:clone()
		s.What.Value=h
		s.Parent=game.Workspace
	end
endscript.Parent.Selected:connect(onSelected)</string>
