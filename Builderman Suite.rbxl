					<string name="Source">k=script.Parent[&quot;Key*&quot;]
db=false
function onTouch(obj)
	if db then return end
	db=true
	p=game.Players:findFirstChild(obj.Parent.Name)
	if p~=nil then
		f=false
		ch=p.stats.Keys:getChildren()
		for i = 1, #ch do
			if ch[i].Value==k.Value then f=true break end
		end
		h=Instance.new(&quot;Hint&quot;)
		h.Parent=p
		s=game.Lighting.DeleteChildScript:clone()
		s.What.Value=h
		s.Parent=game.Workspace
		if not f then
			k:clone().Parent=p.stats.Keys
			h.Text=&quot;You found a key! I wonder what it unlocks...?&quot;
			wait(1)
		else
			h.Text=&quot;You already have this key.&quot;
		end
	end
	db=false
end
script.Parent.Touched:connect(onTouch)
