			<Item class="StringValue" referent="RBX8228">
				<Properties>
					<string name="Name">Description</string>
					<string name="Value">Low Quality Residence. Looks like you could book a room by talking to him!</string>
					<bool name="archivable">true</bool>
				</Properties>
			</Item>
			<Item class="StringValue" referent="RBX8229">
				<Properties>
					<string name="Name">Talk</string>
					<string name="Value">Welcome to Builderman Suite Hotel! Are you looking to book a low quality room? (y/n)</string>
					<bool name="archivable">true</bool>
				</Properties>
				<Item class="StringValue" referent="RBX8230">
					<Properties>
						<string name="Name">y</string>
						<string name="Value"></string>
						<bool name="archivable">true</bool>
					</Properties>
					<Item class="StringValue" referent="RBX8231">
						<Properties>
							<string name="Name">random1</string>
							<string name="Value">Wonderful!</string>
							<bool name="archivable">true</bool>
						</Properties>
						<Item class="StringValue" referent="RBX8232">
							<Properties>
								<string name="Name">random</string>
								<string name="Value">The price of a low quality residence is 100$, and you must renew every 10 minutes costing 20$ each. Is this OK? (y/n)</string>
								<bool name="archivable">true</bool>
							</Properties>
							<Item class="StringValue" referent="RBX8233">
								<Properties>
									<string name="Name">y</string>
									<string name="Value">Great! Let&apos;s see what room # is open...</string>
									<bool name="archivable">true</bool>
								</Properties>
								<Item class="Script" referent="RBX8234">
									<Properties>
										<bool name="Disabled">true</bool>
										<Content name="LinkedSource"><null></null></Content>
										<string name="Name">Script</string>
										<string name="Source">cost=100 --cost to purchase room
wait(.1)
w=script.Who.Value
h=Instance.new(&quot;Hint&quot;)
h.Parent=w
--1st; do they have the $$?
m=w.leaderstats.Money
if m.Value&gt;=cost then --continue execution....
	keys=game.Lighting.Keys.Low:getChildren()
	av={} --index of AVailable keys
	for i = 1, #keys do
		if keys[i].InUse.Value==false then table.insert(av, i) end
	end
	if #av &gt; 0 then
		ch = w.stats.Keys:getChildren()
		for i = 1, #ch do
			if ch[i]:findFirstChild(&quot;ID&quot;)~=nil then --a key to a room!
				ch[i]:Remove()
				h.Text=&quot;You already have a key? I&apos;ll take that...&quot;
				wait(2)
			end
		end
		m.Value=m.Value-cost
		n=math.random(1, #av)
		k=keys[av[n]]:clone()
		k.InUse:Remove()
		keys[av[n]].InUse.Value=true
		k.Parent=w.stats.Keys
		h.Text=&quot;Your new key unlocks room # &quot; .. k.ID.Value .. &quot;. Have a nice stay at Builderman Suite Hotel!&quot;
		wait(10)
		h:Remove()
	else
		h.Text = &quot;Sorry, we have no more rooms available. Try again later?&quot;
		wait(5)
		h:Remove()
	end
else --not enough money
	h.Text=&quot;Wait a moment -- you don&apos;t have &quot; .. cost .. &quot;$! You&apos;d better go work to get some more money.&quot;
	wait(5)
	h:Remove()
end
script:Remove() --we&apos;re just taking up space!
</string>
										<bool name="archivable">true</bool>
									</Properties>
									<Item class="ObjectValue" referent="RBX8235">
										<Properties>
											<string name="Name">Who</string>
											<Ref name="Value">null</Ref>
											<bool name="archivable">true</bool>
										</Properties>
									</Item>
								</Item>
							</Item>
							<Item class="StringValue" referent="RBX8236">
								<Properties>
									<string name="Name">n</string>
									<string name="Value">Perhaps later, then? Try doing jobs around the hotel and maybe you&apos;ll enough money then!</string>
									<bool name="archivable">true</bool>
								</Properties>
							</Item>
						</Item>
					</Item>
					<Item class="StringValue" referent="RBX8237">
						<Properties>
							<string name="Name">random2</string>
							<string name="Value">Super!</string>
							<bool name="archivable">true</bool>
						</Properties>
						<Item class="ObjectValue" referent="RBX8238">
							<Properties>
								<string name="Name">redirect</string>
								<Ref name="Value">RBX8232</Ref>
								<bool name="archivable">true</bool>
							</Properties>
							<Item class="Script" referent="RBX8239">
								<Properties>
									<bool name="Disabled">false</bool>
									<Content name="LinkedSource"><null></null></Content>
									<string name="Name">Script</string>
									<string name="Source">script.Parent.Value=script.Parent.Parent.Parent.random1.random
</string>
									<bool name="archivable">true</bool>
								</Properties>
							</Item>
						</Item>
					</Item>
				</Item>
				<Item class="StringValue" referent="RBX8240">
					<Properties>
						<string name="Name">n</string>
						<string name="Value">OK. Have a nice day!</string>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
				<Item class="StringValue" referent="RBX8241">
					<Properties>
						<string name="Name">who</string>
						<string name="Value"></string>
						<bool name="archivable">true</bool>
					</Properties>
					<Item class="Script" referent="RBX8242">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script</string>
							<string name="Source">function c(property)
	if script.Parent.Value==&quot;&quot; then tt=0 else tt=t+60 end --timeout in a minute
end
script.Parent.Changed:connect(c)
t=0
tt=0
while true do
	wait(1)
	t=t+1
	if tt&lt;=t and tt~=0 then script.Parent.Value=&quot;&quot; tt=0 end
end
</string>
							<bool name="archivable">true</bool>
						</Properties>
					</Item>
				</Item>
			</Item>
