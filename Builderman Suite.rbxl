			<Item class="Script" referent="RBX12494">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<string name="Source">function open()
	script.Parent.CanCollide=false
	script.Parent.Transparency=0.8
	wait(.4)
	close()
end
ch=game.Lighting.Keys.Low:getChildren()
function close()
	script.Parent.CanCollide=true
	script.Parent.Transparency=0.5
end
function onTouch(obj)
	p=game.Players:findFirstChild(obj.Parent.Name)
	if p~=nil then
		k=p.stats.Keys:findFirstChild(&quot;Key&quot;)
		if k~=nil then
			f=false
			for i = 1, #ch do
				if k.ID.Value==ch[i].ID.Value then f=true break end
			end
			if f then close() else open() end --if they have a low Q key... don&apos;t let them in!
		else
			close()
		end
	end
end
script.Parent.Touched:connect(onTouch)
</string>
					<bool name="archivable">true</bool>
