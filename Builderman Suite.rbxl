			<Item class="StringValue" referent="RBX12323">
				<Properties>
					<string name="Name">Description</string>
					<string name="Value">Looks deep in thought...</string>
					<bool name="archivable">true</bool>
				</Properties>
			</Item>
			<Item class="StringValue" referent="RBX12324">
				<Properties>
					<string name="Name">Talk</string>
					<string name="Value">Hey there! I can&apos;t chat long, I&apos;ve got so much to do... scripting and programming...</string>
					<bool name="archivable">true</bool>
				</Properties>
				<Item class="StringValue" referent="RBX12325">
					<Properties>
						<string name="Name">random</string>
						<string name="Value">I did almost all the scripting for this place and even helped build some of it! Want to know a secret? (y/n)</string>
						<bool name="archivable">true</bool>
					</Properties>
					<Item class="StringValue" referent="RBX12326">
						<Properties>
							<string name="Name">y</string>
							<string name="Value">Desperate, are we? Well, trust me, it&apos;s better to find it out on your own! </string>
							<bool name="archivable">true</bool>
						</Properties>
					</Item>
					<Item class="StringValue" referent="RBX12327">
						<Properties>
							<string name="Name">n</string>
							<string name="Value">Good for you! For that, I want to tell you one anyways. [LOOK AWAY NOW IF YOU DON&apos;T WANT TO SEE IT!] Try looking around the entranceway... you might find something... ;)</string>
							<bool name="archivable">true</bool>
						</Properties>
					</Item>
				</Item>
				<Item class="StringValue" referent="RBX12328">
					<Properties>
						<string name="Name">random</string>
						<string name="Value">Do you like this place? (y/n) I did most of the scripting and a little building too! What fun that was... though I spent like 30 hours in the process XD</string>
						<bool name="archivable">true</bool>
					</Properties>
					<Item class="StringValue" referent="RBX12329">
						<Properties>
							<string name="Name">y</string>
							<string name="Value">I&apos;m glad! You should check out the hockey arena on the 7th floor, though -- I love that room! Well, have fun at the hotel!</string>
							<bool name="archivable">true</bool>
						</Properties>
					</Item>
					<Item class="StringValue" referent="RBX12330">
						<Properties>
							<string name="Name">n</string>
							<string name="Value">Too bad... it took tons of work!</string>
							<bool name="archivable">true</bool>
						</Properties>
					</Item>
				</Item>
			</Item>
		</Item>
