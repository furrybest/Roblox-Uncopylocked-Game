			<Item class="StringValue" referent="RBX6887">
				<Properties>
					<string name="Name">Description</string>
					<string name="Value">High Quality Residence. Looks like you could book a room by talking to him!</string>
					<bool name="archivable">true</bool>
				</Properties>
			</Item>
			<Item class="StringValue" referent="RBX6888">
				<Properties>
					<string name="Name">Talk</string>
					<string name="Value">Welcome to Builderman Suite Hotel! May I find you a high class room to stay in? (y/n)</string>
					<bool name="archivable">true</bool>
				</Properties>
				<Item class="StringValue" referent="RBX6889">
					<Properties>
						<string name="Name">y</string>
						<string name="Value"></string>
						<bool name="archivable">true</bool>
					</Properties>
					<Item class="StringValue" referent="RBX6890">
						<Properties>
							<string name="Name">random1</string>
							<string name="Value">Wonderful!</string>
							<bool name="archivable">true</bool>
						</Properties>
						<Item class="StringValue" referent="RBX6891">
							<Properties>
								<string name="Name">random</string>
								<string name="Value">Our luxurious rooms cost 1000$ with 60$ renewals every 10 minutes. Does this work for you? (y/n)</string>
								<bool name="archivable">true</bool>
							</Properties>
							<Item class="StringValue" referent="RBX6892">
								<Properties>
									<string name="Name">y</string>
									<string name="Value">I need but a second to fetch your key...</string>
									<bool name="archivable">true</bool>
								</Properties>
								<Item class="Script" referent="RBX6893">
									<Properties>
										<bool name="Disabled">true</bool>
										<Content name="LinkedSource"><null></null></Content>
										<string name="Name">Script</string>
										<string name="Source">cost=1000 --cost to purchase room
wait(.1)
w=script.Who.Value
h=Instance.new(&quot;Hint&quot;)
h.Parent=w
--1st; do they have the $$?
m=w.leaderstats.Money
if m.Value&gt;=cost then --continue execution....
	keys=game.Lighting.Keys.High:getChildren()
	av={} --index of AVailable keys
	for i = 1, #keys do
		if keys[i].InUse.Value==false then table.insert(av, i) end
	end
	if #av &gt; 0 then
		ch = w.stats.Keys:getChildren()
		for i = 1, #ch do
			if ch[i]:findFirstChild(&quot;ID&quot;)~=nil then --a key to a room!
				ch[i]:Remove()
				h.Text=&quot;You already have a key? I&apos;m sorry, but I must take your old keys...&quot;
				wait(2)
			end
		end
		m.Value=m.Value-cost
		n=math.random(1, #av)
		k=keys[av[n]]:clone()
		k.InUse:Remove()
		keys[av[n]].InUse.Value=true
		k.Parent=w.stats.Keys
		h.Text=&quot;Your new key unlocks room # &quot; .. k.ID.Value .. &quot;. Have a luxurious stay at the best of Builderman Suite Hotel!&quot;
		wait(10)
		h:Remove()
	else
		h.Text = &quot;I&apos;m shocked! All our rooms are booked! Perhaps you&apos;d like to try a different class, for now?&quot;
		wait(5)
		h:Remove()
	end
else --not enough money
	h.Text=&quot;I&apos;m sorry, but you need &quot; .. cost .. &quot;$ to book a high class room! Try doing some odd jobs or book a lower class room.&quot;
	wait(5)
	h:Remove()
end
script:Remove() --we&apos;re just taking up space!
</string>
										<bool name="archivable">true</bool>
									</Properties>
