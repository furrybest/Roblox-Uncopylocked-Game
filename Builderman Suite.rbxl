						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">WateringScript</string>
						<string name="Source">debounce = false
function onButton1Down(mouse)
	if debounce==true then return end
	debounce=true
	local player = game.Players.LocalPlayer
	if player == nil then return end
	if mouse.Target.Name==&quot;Dirt&quot; and mouse.Target.Parent.Name==&quot;Garden&quot; then
		t=player.Character:findFirstChild(&quot;Torso&quot;)
		if t==nil then return end
		obj=mouse.Target
		dist=(obj.Position-t.Position).magnitude
		if dist&lt;=60 then
			w=mouse.Target.Parent.Water
			if w.Value&lt;8 then 
				w.Value=w.Value+1
				p=script.Parent.Parent.Parent
				s=p:findFirstChild(&quot;leaderstats&quot;)
				if s~=nil then
					if s:findFirstChild(&quot;Money&quot;)~=nil then
						s.Money.Value=s.Money.Value+2 --EDITABLE
					end
				end
			end
		else
			m=Instance.new(&quot;Hint&quot;)
			m.Parent=player
			m.Text=&quot;You aren&apos;t close enough to water the garden!&quot;
			wait(2)
			m:Remove()
		end
	end
	debounce=false
end

function onSelected(mouse)
	mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
	mouse.Button1Down:connect(function() onButton1Down(mouse) end)
end
cleanTools={&quot;Bathroom&quot;, &quot;Mop&quot;, &quot;Water&quot;, &quot;Weed&quot;, &quot;Window&quot;}
function onAncestryChanged()
	if script.Parent.Parent.Name==&quot;Backpack&quot; then --do a search! Are there other CLEANING tools? If so, kick the oldest one.
		script.Parent.Age.Value=3 --being highest, we&apos;ll ignore ourself...
		b=script.Parent.Parent
		for i= 1, #cleanTools do
			nc = b:findFirstChild(cleanTools[i])
			if nc~=nil then
				v=nc.Age
				if v.Value==0 then nc:Remove() else v.Value=0 end
			end
		end
		script.Parent.Age.Value=1 --this way, we won&apos;t be removed instantly, but the time after that.
	end
end
script.Parent.AncestryChanged:connect(onAncestryChanged)
script.Parent.Selected:connect(onSelected)
