										<string name="Source">name=&quot;Milk&quot;
cost=1
food=60
max=900
wait(.1)
p=script.Who.Value
if p~=nil then
	h=Instance.new(&quot;Hint&quot;)
	h.Parent=p
	f=p.stats.Food
	m=p.leaderstats.Money
	if m.Value&gt;=cost then
		m.Value=m.Value-cost
		f.Value=f.Value+food
