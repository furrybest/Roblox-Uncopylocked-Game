			<Item class="Script" referent="RBX12819">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Cooker</string>
					<string name="Source">function check()
	n=script.Parent.Name
	if n==&quot;Food&quot; or n==&quot;Food2&quot; then --cook it! Then remove this script.
		for i = 1, 100 do
			wait(.1) --10 seconds to cook!
			d=script.Parent.Description
			m=string.find(d.Value, &quot;|&quot;)
			if m~=nil then
				d.Value=string.sub(d.Value,1,m-1)
			end
			d.Value=d.Value .. &quot;|Cooked: &quot;..i..&quot;%&quot;
		end
		m=string.find(d.Value, &quot;|&quot;)
		if m~=nil then
			d.Value=string.sub(d.Value,1,m-1)
		end
		script.Parent.Cooked.Value=true
		d.Value=string.gsub(d.Value, &quot;Uncooked&quot;, &quot;Cooked&quot;)
		script:Remove()
		continue=false
	end
end
continue=true
while continue do
	wait(1)
	check()
end
</string>
					<bool name="archivable">true</bool>
				</Properties>
			</Item>
		</Item>
		<Item class="HopperBin" referent="RBX12708">
			<Properties>
				<token name="BinType">0</token>
				<string name="Name">...Up</string>
				<Content name="TextureId"><null></null></Content>
				<bool name="archivable">true</bool>
			</Properties>
			<Item class="Script" referent="RBX12820">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">MenuScript</string>
					<string name="Source">function onSelected(mouse)
	b=game.Players.LocalPlayer.Backpack
	import=script.Parent.Tree.Value.Parent.Parent:GetChildren()
	delete=script.Parent.Tree.Value.Parent:GetChildren()
	for i = 1, #import do
		import[i].Value:clone().Parent=b
	end
	for i = 1, #delete do
		b:findFirstChild(delete[i].Value.Name):Remove()
	end
end
