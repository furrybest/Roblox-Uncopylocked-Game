			<Item class="HopperBin" referent="RBX12626">
				<Properties>
					<token name="BinType">0</token>
					<string name="Name">Fly</string>
					<Content name="TextureId"><null></null></Content>
					<bool name="archivable">true</bool>
				</Properties>
				<Item class="Script" referent="RBX12627">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Flyer</string>
						<string name="Source">--chess123mate made this
bin=script.Parent
controlling = false
bspeed=1
speed=bspeed
bg=Instance.new(&quot;BodyGyro&quot;)
tor=game.Players.LocalPlayer.Character.Torso
bg.Parent=tor
bg.maxTorque=Vector3.new(400000,400000,400000)
bg.cframe=CFrame.new(tor.Position)
bp=Instance.new(&quot;BodyPosition&quot;)
bp.Parent=tor
bp.maxForce=Vector3.new(40000,400000,40000)
bp.position=tor.Position+Vector3.new(0,3,0)
h=Instance.new(&quot;Hint&quot;)
h.Parent=game.Players.LocalPlayer
h.Text=&quot;FLY: Press z,a,q to control speed (q is fastest), e for mode, and use mouse to control direction.&quot;
mode=0 --bodyPos. BodyGyro mode ==1
function move(target)
	dir=(target-tor.Position).unit
	if mode==1 then bg.cframe=CFrame.new(tor.Position+dir, tor.Position+dir*2) else bp.position=bp.position+dir*speed end
end

function onButton1Down(mouse)
	controlling = true
	while controlling do
		move(mouse.Hit.p)
		wait()
	end
end

function onButton1Up(mouse)
	controlling = false
end
function onSelected(mouse)
	mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot; 
	bp.maxForce=Vector3.new(40000,400000,40000)
	bp.position=bp.Parent.Position+Vector3.new(0,3,0)
	bg.maxTorque=Vector3.new(400000,400000,400000)
	mouse.Button1Down:connect(function() onButton1Down(mouse) end)
	mouse.Button1Up:connect(function() onButton1Up(mouse) end)
	mouse.KeyDown:connect(onKeyDown)
end
function onDeselected()
	bp.maxForce=Vector3.new(0,0,0)
	bg.maxTorque=Vector3.new(0,0,0)
	controlling=false
end
function onKeyDown(key)
	if key~=nil then
		if key==&quot;q&quot; then --power controls
			speed=bspeed*3
		elseif key==&quot;a&quot; then
			speed=bspeed*2
		elseif key==&quot;z&quot; then
			speed=bspeed*1
		elseif key==&quot;e&quot; then
			mode=1-mode
		end
	end
end

bin.Selected:connect(onSelected)
bin.Deselected:connect(onDeselected)
wait(4)
h.Text=&quot;Don&apos;t go through any doors! You can&apos;t fly out there :)&quot;
wait(2)
h:Remove()
</string>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
			</Item>
