						<string name="Name">who</string>
						<string name="Value"></string>
						<bool name="archivable">true</bool>
					</Properties>
					<Item class="Script" referent="RBX10311">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script</string>
							<string name="Source">function c(property)
	if script.Parent.Value==&quot;&quot; then tt=0 else tt=t+60 end --timeout in a minute
end
script.Parent.Changed:connect(c)
t=0
tt=0
while true do
	wait(1)
	t=t+1
	if tt&lt;=t and tt~=0 then script.Parent.Value=&quot;&quot; tt=0 end
end
</string>
