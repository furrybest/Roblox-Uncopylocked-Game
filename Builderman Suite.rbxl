		<Item class="Script" referent="RBX43">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">AutoRenewalScript</string>
				<string name="Source">--Room script. Subtracts money from your account automatically every 15 min
--you own a room. If you can&apos;t pay, you instantly lose your key.
time={} --time until another payment. Counts down from 600 seconds.
key={} --0=none; 1=low; 2=med; 3=high. key[]*20==payment.
lKey={} --LastKey. used to determine when to reset Time[]
keyO={} --the key itself
theTime=900 --seconds you get the key without renewal DEBUG should be 900
function remove(xid) --index is a String... removes the key that matches keyO[index].ID.Value
	ch=game.Lighting.Keys.Low:getChildren()
	local f=nil
	for kk=1, #ch do
		if ch[kk].ID.Value==xid then f=ch[i] break end
	end
	if f~=nil then 
		f.InUse.Value=false
	else --check for med key
		ch=game.Lighting.Keys.Med:getChildren()
		local f=nil
		for kk=1, #ch do
			if ch[kk].ID.Value==xid then f=ch[i] break end
		end
		if f~=nil then 
			f.InUse.Value=false
		else
			ch=game.Lighting.Keys.High:getChildren()
			local f=nil
			for kk=1, #ch do
				if ch[kk].ID.Value==xid then f=ch[i] break end
			end
			if f~=nil then 
				f.InUse.Value=false
			end
		end
	end
end
function low(xk) --is this key a &quot;Low&quot; key? (true/false)
	xid=xk.ID.Value
	ch=game.Lighting.Keys.Low:getChildren()
	f=false
	for kk=1, #ch do
		if ch[kk].ID.Value==xid then f=true break end
	end
	return f --Found
end
function med(xk)
	xid=xk.ID.Value
	ch=game.Lighting.Keys.Med:getChildren()
	f=false
	for kk=1, #ch do
		if ch[kk].ID.Value==xid then f=true break end
	end
	return f --Found
end
function high(xk)
	xid=xk.ID.Value
	ch=game.Lighting.Keys.High:getChildren()
	f=false
	for kk=1, #ch do
		if ch[kk].ID.Value==xid then f=true break end
	end
	return f --Found
end
function update()
	p=game.Players:getChildren()
	for i = 1, #p do
		n=p[i].Name
		if time[n]~=-100 then time[n]=time[n]-1 end		
	end
end
function pay()
	p=game.Players:getChildren()
	for i = 1, #p do
		n=p[i].Name
		if time[n]~=-100 and time[n]&lt;=0 then 
			time[n]=theTime
			h=Instance.new(&quot;Hint&quot;)
			h.Parent=p[i]
			s=game.Lighting.DeleteChildScript:clone()
			s.What.Value=h
			s.Parent=game.Workspace
			if p[i].leaderstats.Money.Value&gt;=key[n]*20 then
				p[i].leaderstats.Money.Value=p[i].leaderstats.Money.Value-key[n]*20
				h.Text=&quot;Your residence has been renewed.&quot;
			else
				remove(keyO[n].ID.Value)
				keyO[n]:Remove()
				key[n]=0
				h.Text=&quot;You don&apos;t have enough money to renew your residence! Your key has been taken.&quot;
			end
		end		
	end
end
function findNew() --find new players
	p=game.Players:getChildren()
	for i = 1, #p do
		n=p[i].Name
		if time[n]==nil then time[n]=-100 key[n]=0 lKey[n]=0 end --signal for &quot;no room&quot;
	end
end
function findKeys() --find a players&apos; keys + set up time+key references
	p=game.Players:getChildren()
	for i = 1, #p do
		n=p[i].Name
		if p[i]:FindFirstChild(&quot;stats&quot;)~=nil then --player is in game
			k=p[i].stats.Keys:getChildren()
			f=false --found
			for j=1, #k do
				if k[j]:findFirstChild(&quot;ID&quot;)~=nil then --otherwise not a room key
					if low(k[j]) then --they have a low quality key
						f=true
						key[n]=1
						keyO[n]=k[j]
						break
					elseif med(k[j]) then --med Q key
						f=true
						key[n]=2
						keyO[n]=k[j]
						break
					elseif high(k[j]) then --high Q key
						f=true
						key[n]=3
						keyO[n]=k[j]
						break
					end
				end
			end
			if not f then key[n]=0 end
			if key[n]~=lKey[n] then
				lKey[n]=key[n]
				if key[n]==0 then time[n]=-100 else time[n]=theTime end
			end
		end
	end
end
function exists(kid)
	p=game.Players:GetChildren()
	f=false --found
	for i = 1, #p do
		if p[i]:FindFirstChild(&quot;stats&quot;)~=nil then --player is in game
			k=p[i].stats.Keys:getChildren()
			for j=1, #k do
				if k[j]:findFirstChild(&quot;ID&quot;)~=nil then --otherwise not a room key
					if k[j].ID.Value==kid then f=true break end
				end
			end
		end
		if f then break end
	end
	return f
end
function checkKeys() --checks to make sure that all keys that are &quot;InUse&quot; actually exist
	ch=game.Lighting.Keys.Low:getChildren()
	for kk=1, #ch do
		if not exists(ch[kk].ID.Value) then ch[kk].InUse.Value=false end
	end
	ch=game.Lighting.Keys.Med:getChildren()
	for kk=1, #ch do
		if not exists(ch[kk].ID.Value) then ch[kk].InUse.Value=false end
	end
	ch=game.Lighting.Keys.High:getChildren()
	for kk=1, #ch do
		if not exists(ch[kk].ID.Value) then ch[kk].InUse.Value=false end
	end
end
TT=0
while true do
	wait(1)
	TT=TT+1
	findNew() --see if there are new players
	update() --update the time table
	checkKeys() --do the keys still exist?
	if TT%10==0 then
		findKeys() --update the Key Status
		pay() --if time to pay, then pay!
	end
end
</string>
				<bool name="archivable">true</bool>
			</Properties>
		</Item>
		<Item class="Script" referent="RBX44">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">BreakJointsScript</string>
				<string name="Source">c=0
function breakAnchored(model) 
	if (model.className == &quot;Part&quot;) or (model.className == &quot;Seat&quot;) or (model.className == &quot;SpawnLocation&quot;) then 
		if model.Anchored then model:BreakJoints() c=c+1 end 
	else 
		local child = model:GetChildren() 
		for n = 1, #child do 
			breakAnchored(child[n]) 
		end 
	end 
end 
function makeUnanchored(model) 
	if (model.className == &quot;Part&quot;) or (model.className == &quot;Seat&quot;) or (model.className == &quot;SpawnLocation&quot;) then 
		if not model.Anchored then model:MakeJoints() c=c+1 end 
	else 
		local child = model:GetChildren() 
		for n = 1, #child do 
			makeUnanchored(child[n]) 
		end 
	end 
end 
wait() 
breakAnchored(workspace) 
print(&quot;Broke Joints on: &quot; .. c .. &quot; bricks.&quot;)
c=0
makeUnanchored(workspace)
print(&quot;Made Joints on: &quot; .. c .. &quot;bricks.&quot;)
function find(m) --find all humanoids and repair them
	local ch=m:getChildren()
	local i = 0
	for i = 1, #ch do
		if ch[i].className==&quot;Humanoid&quot; then h=ch[i] h.Parent:MakeJoints() h.Health=h.MaxHealth
		elseif ch[i].className==&quot;Model&quot; then find(ch[i]) end
	end
end
find(game.Workspace)
</string>
				<bool name="archivable">true</bool>
			</Properties>
		</Item>
		<Item class="Script" referent="RBX45">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">CustomLeaderboard</string>
				<string name="Source">maxFood=900 --15 minutes before death from starvation!
secondsInDay = 480 --feel free to change!
cTime = 160 --custom time variable. Change to change the starting time (in comparison to secondsInDay)
function onPlayerRespawn(property, player)
	-- need to connect to new humanoid
	--I tested this, it only runs AFTER your respawn, not before (though I&apos;m sure you already knew that)
	if property == &quot;Character&quot; and player.Character ~= nil then
		local humanoid = player.Character.Humanoid
		local p = player
		local h = humanoid
		p.stats.Food.Value=maxFood --put that back up to the top
		ch=p:getChildren()
		for pp=1, #ch do
			if ch[pp].Name==&quot;Hint&quot; then ch[pp]:Remove() end
		end
	end
end

function onPlayerEntered(newPlayer)

	stats = Instance.new(&quot;IntValue&quot;)
	stats.Name = &quot;leaderstats&quot;

	money=Instance.new(&quot;IntValue&quot;)
	money.Name=&quot;Money&quot;
	money.Value=100 --editable... we&apos;ll need to change this later depending on values + discussion
	money.Parent=stats

	--POWER/ORB VARIABLE HERE when we decide what it is

	stats.Parent = newPlayer
	--CUSTOM STATS (ie, for if you found a key or something, record perminently until they exit server)
	stats2 = Instance.new(&quot;IntValue&quot;)
	stats2.Name=&quot;stats&quot;
	
	inventory=Instance.new(&quot;IntValue&quot;) --for cooking job, holds what ingrediants are currently &quot;on hand&quot;.
	inventory.Name=&quot;Inventory&quot;
	inventory.Parent=stats2
	keys=Instance.new(&quot;IntValue&quot;)
	keys.Name=&quot;Keys&quot;
	keys.Parent=stats2
	orbs=Instance.new(&quot;IntValue&quot;)
	orbs.Name=&quot;Orbs Found&quot;
	orbs.Value=0
	orbs.Parent=stats
	orbs2=Instance.new(&quot;IntValue&quot;)
	orbs2.Name=&quot;Orbs&quot;
	orbs2.Parent=stats2
	food=Instance.new(&quot;IntValue&quot;)
	food.Name=&quot;Food&quot;
	food.Value=maxFood
	food.Parent=stats2
	hats=Instance.new(&quot;IntValue&quot;)
	hats.Name=&quot;Hats&quot;
	hats.Parent=stats2
	hd=Instance.new(&quot;BrickColorValue&quot;)
	hd.Name=&quot;HeadColor&quot;
	hd.Parent=newPlayer
	stats2.Parent=newPlayer
	
	while true do
		if newPlayer.Character ~= nil then break end
		wait(1)
	end
	newPlayer.Changed:connect(function(property) onPlayerRespawn(property, newPlayer) end )
	ss=game.Lighting.IntroScript:clone()
	ss.Who.Value=newPlayer
	ss.Disabled=false
	ss.Parent=game.Workspace
end

game.Players.ChildAdded:connect(onPlayerEntered)
while true do 
	wait(1)
	p=game.Players:getChildren()
	for pp = 1, #p do
		s=p[pp]:findFirstChild(&quot;stats&quot;)
		if s~=nil and p[pp].Character~=nil then
			f=s:findFirstChild(&quot;Food&quot;)
			if f~=nil then
				f.Value=f.Value - 1
				p[pp].Character.Humanoid.Health=f.Value/maxFood*100
			end
			if p[pp].leaderstats[&quot;Orbs Found&quot;].Value&gt;=10 then
				p[pp].leaderstats.Money.Value=p[pp].leaderstats.Money.Value+5
			end
		end
	end
	cTime = cTime+1
	if cTime&gt;secondsInDay then cTime=cTime-secondsInDay end
	pc = cTime/secondsInDay
	gameTime = 86400*pc --in seconds; 86400 is #seconds in one 24h day
	hours = math.floor(gameTime/60/60)
	gameTime = gameTime-hours*60*60
	minutes = math.floor(gameTime/60)
	gameTime = gameTime-minutes*60
	seconds = gameTime
	game.Lighting.TimeOfDay = hours .. &quot;:&quot; .. minutes .. &quot;:&quot; .. seconds
	hhh=game.Workspace:findFirstChild(&quot;A_Hat&quot;)
	if hhh~=nil then hhh:Remove() end
end
</string>
				<bool name="archivable">true</bool>
			</Properties>
		</Item>
		<Item class="Script" referent="RBX46">
			<Properties>
				<bool name="Disabled">true</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">EntranceRingLightScript</string>
				<string name="Source">wait(20) --so that other scripts have a chance to do stuff before we add even more lag....
lights=game.Workspace.Legs.Leg.Entrance.EntranceRing:getChildren()
lights2=game.Workspace.Legs.Leg2.Entrance.EntranceRing:getChildren()
colours= {BrickColor.new(&quot;Bright orange&quot;), BrickColor.new(&quot;White&quot;), BrickColor.new(&quot;Black&quot;), BrickColor.new(&quot;Bright red&quot;), BrickColor.new(&quot;Bright yellow&quot;)}
for i = 1, #lights do
	lights[i].Reflectance=0.1
	lights2[i].Reflectance=0.1
end
function identical()
	m=0
	while m&lt;=25 do
		wait(.4)
		m=m+1
		for i = 1, #lights do
			n=math.random(1,#colours)
			lights[i].BrickColor=colours[n]
			lights2[i].BrickColor=colours[n]
		end
	end
end
function separate()
	m=0
	while m&lt;=25 do
		wait(.4)
		m=m+1
		for i = 1, #lights do
			lights[i].BrickColor=colours[math.random(1,#colours)]
			lights2[i].BrickColor=colours[math.random(1,#colours)]
		end
	end
end
function flashIdentical()
	m=0
	while m&lt;=20 do
		wait(.2)
		m=m+1
		ln = n while ln==n do n=math.random(1,#colours) end
		for i=1, #lights do
			lights[i].BrickColor=colours[n]
			lights2[i].BrickColor=colours[n]
		end
	end
end
function flashSeparate()
	m=0
	while m&lt;=20 do
		wait(.2)
		m=m+1
		ln = n while ln==n do n=math.random(1,#colours) end
		ln2 = n2 while ln2==n2 or n2==n do n2=math.random(1,#colours) end
		for i=1, #lights do
			lights[i].BrickColor=colours[n]
			lights2[i].BrickColor=colours[n2]
		end
	end
end
function solo1()
	white2()
	m=0
	while m&lt;=15 do
		wait(.4)
		m=m+1
		for i = 1, #lights do
			lights[i].BrickColor=colours[math.random(1,#colours)]
		end
	end
end
function solo2()
	white1()
	m=0
	while m&lt;=15 do
		wait(.4)
		m=m+1
		for i = 1, #lights2 do
			lights2[i].BrickColor=colours[math.random(1,#colours)]
		end
	end
end
function white1()
	for i = 1, #lights do
		lights[i].BrickColor=BrickColor.new(&quot;Light stone grey&quot;)
	end
end
function white2()
	for i = 1, #lights2 do
		lights2[i].BrickColor=BrickColor.new(&quot;Light stone grey&quot;)
	end
end

while true do
	flashSeparate()
	solo1()
	solo2()
	separate()
	flashSeparate()
	solo2()
	solo1()
	identical()
	flashIdentical()
	flashSeparate()
	flashIdentical()
	white1()
	white2()
	wait(20)
end
</string>
				<bool name="archivable">true</bool>
			</Properties>
		</Item>
		<Item class="Script" referent="RBX47">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">FloorScript</string>
				<string name="Source">--BASED ON WINDOW SCRIPT, only dif. is that where it&apos;s &quot;floor&quot; and a few modificationswait(4)floors={} --insert all floors in herefloorClean={}floorLClean={}floorHealth={}
floorDesc={}function searchForWindow(where)	local ch=where:getChildren()	local i=1	for i=1, #ch do		if ch[i].className==&quot;Model&quot; then searchForWindow(ch[i]) end		if ch[i].Name==&quot;Floor*&quot; and ch[i]:findFirstChild(&quot;Clean&quot;)~=nil then table.insert(floors, ch[i]) end	endendsearchForWindow(game.Workspace)print(&quot;Found &quot; .. #floors .. &quot; floors!&quot;)for i = 1, #floors do	floorClean[i]=floors[i].Clean
	floorDesc[i]=floors[i].Description	floorClean[i].Value=5	floorLClean[i]=floorClean[i].Value-1 --to ensure it&apos;s different	floorHealth[i]=100 endfunction updateStage(floor, stage) --returns the new description	t=0	if stage==5 then
		d=&quot;A beautiful Builderman Suite floor!&quot;		c=BrickColor.new(&quot;Light stone gray&quot;)		t=.1	elseif stage==4 then
		d=&quot;A slightly dirty floor. Clean for 2$!&quot;		c=BrickColor.new(&quot;Medium stone gray&quot;)	elseif stage==2 then
		d=&quot;What a dirty floor! Clean it for 6$!&quot;		c=BrickColor.new(&quot;Dark orange&quot;)	elseif stage==1 then
		d=&quot;Yuck! That&apos;s one dirty floor. Clean it for 8$!&quot;		c=BrickColor.new(&quot;Brown&quot;)	elseif stage==3 then
		d=&quot;That floor looks a bit dirty. Clean it for 4$!&quot;		c=BrickColor.new(&quot;Dark stone gray&quot;)	else
		d=&quot;Gross! That floor is filthy! Somebody should clean it... they&apos;d get 10$!&quot;		c=BrickColor.new(&quot;Black&quot;)	end	floor.BrickColor=c	floor.Reflectance=t
	return dendfunction update() --decrease the health; change the stage if dif. than last &quot;clean&quot; value	for i = 1, #floors do		floorHealth[i]=floorHealth[i]-math.random(10,15)/10		if floorHealth[i]&lt;=0 then			floorHealth[i]=100			if floorClean[i].Value&gt;0 then floorClean[i].Value=floorClean[i].Value-1 end		end		if floorClean[i].Value~=floorLClean[i] then			floorDesc[i].Value = updateStage(floors[i], floorClean[i].Value)			floorLClean[i]=floorClean[i].Value		end	end	endwhile true do	wait(3)	update()end</string>
				<bool name="archivable">true</bool>
			</Properties>
		</Item>
		<Item class="Script" referent="RBX48">
			<Properties>
				<bool name="Disabled">true</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">KeyGiverScript</string>
				<string name="Source">k=script.Parent[&quot;Key*&quot;]
function onTouch(obj)
	p=game.Players:findFirstChild(obj.Parent.Name)
	if p~=nil then
		f=false
		ch=p.stats.Keys:getChildren()
		for i = 1, #ch do
			if ch[i].Value==k.Value then f=true break end
		end
		h=Instance.new(&quot;Hint&quot;)
		h.Parent=p
		s=game.Lighting.DeleteChildScript:clone()
		s.What.Value=h
		s.Parent=game.Workspace
		if f then
			h.Text=&quot;You already have this key!&quot;
		else
			k:clone().Parent=p.stats.Keys
			h.Text=&quot;You found a key! I wonder what it unlocks...?&quot;
		end
	end
end
script.Parent.Touched:connect(onTouch)
</string>
				<bool name="archivable">true</bool>
			</Properties>
		</Item>
		<Item class="Script" referent="RBX49">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">LightingKeyDoorConnections</string>
				<string name="Source">--takes all the keys and connects them to their appropriate door. All doors are under
--game.Workspace.RoomDoors
--all keys are under
--game.Lighting.Keys. + Low/Med/High

--So, simply connect them appropriately! The &quot;Door*&quot; under the ID name that matches the ID of the Key!
kl=game.Lighting.Keys.Low:getChildren()
km=game.Lighting.Keys.Med:getChildren()
kh=game.Lighting.Keys.High:getChildren()
d=game.Workspace.RoomDoors:getChildren()
function match(k)
	for i = 1, #k do
		for j = 1, #d do
			if tonumber(d[j].Name)==k[i].ID.Value then --they match! hook &apos;em up!
				k[i].Value=d[j][&quot;Door*&quot;]
			end
		end
	end
end
match(kl)
match(km)
match(kh)

</string>
				<bool name="archivable">true</bool>
			</Properties>
		</Item>
		<Item class="Script" referent="RBX50">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">LightingObjectValueConnections</string>
				<string name="Source">--This script connects all the tools, allowing the cooking tools to work. Without this script, the tools won&apos;t even
--begin to work.
function connectPair(a, b) --where a is in the menu, and b is in the lighting.
	a.Value = b
	b.Tree.Value=a
end
function findPair(menu)
	if menu.Parent==game.Lighting.Menu[&quot;Cooking...&quot;][&quot;Select...&quot;] or menu.Parent==game.Lighting.Menu[&quot;Cooking...&quot;][&quot;Select...&quot;] then
		return game.Lighting.select:findFirstChild(menu.Name)
	elseif menu.Parent==game.Lighting.Menu[&quot;Cooking...&quot;][&quot;Put Back...&quot;] or menu.Parent==game.Lighting.Menu[&quot;Cooking...&quot;][&quot;Put Back...&quot;] then
		return game.Lighting.delete:findFirstChild(menu.Name)
	else
		return game.Lighting:findFirstChild(menu.Name)
	end
end
function searchMenu(where)
	local ch=where:getChildren()
	local i =1
	for i = 1, #ch do
		print(&quot;Looking at &quot; .. ch[i].Name .. &quot;...&quot;)
		connectPair(ch[i], findPair(ch[i]))
		num=#ch[i]:getChildren()
		if num&gt;=1 then searchMenu(ch[i]) end --has children? go find them! pair them up!
	end
end
searchMenu(game.Lighting.Menu)
</string>
				<bool name="archivable">true</bool>
			</Properties>
		</Item>
		<Item class="Script" referent="RBX51">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">LockedDoorScript</string>
				<string name="Source">s=game.Lighting.DeleteChildScript:clone()
s.Disabled=false
s2=s:clone()
ss=game.Lighting.DoorReturnScript:clone()ss.Disabled=falsewait(20) -- gives the other scripts that search the workspace time to complete before creating our own lag.doors={}function searchForDoor(where)	local ch=where:getChildren()	local i=1	for i=1, #ch do		if ch[i].className==&quot;Model&quot; then searchForDoor(ch[i]) end		if ch[i].Name==&quot;Door*&quot; then table.insert(doors, ch[i]) end	endendsearchForDoor(game.Workspace)function onHit(obj, door)	if obj.Parent:FindFirstChild(&quot;Humanoid&quot;)~=nil then		local p=game.Players:findFirstChild(obj.Parent.Name)		if p~=nil then			local k=p.stats.Keys:getChildren()			local i = 1			local works=false			for i = 1, #k do				if k[i].Value~= nil then if k[i].Value==door then works=true break end end			end			h=Instance.new(&quot;Hint&quot;)
			h.Parent=p			s2.What.Value=h
			s2.Parent=game.Workspace
			s2=s:clone() --for next time!
			ss:clone().Parent=door						if works then --found a good key!				h.Text=&quot;You unlocked the door with one of your keys!&quot;
				door.CanCollide=false				door.Transparency=1			else				h.Text=&quot;That door is locked. None of your keys fit this door.&quot;				door.CanCollide=true --prevent an already open door from allowing this person in.
				door.Transparency=0			end		end	endendfor i = 1, #doors do	doors[i].Touched:connect(function(obj) onHit(obj, doors[i]) end)end</string>
				<bool name="archivable">true</bool>
			</Properties>
		</Item>
		<Item class="Script" referent="RBX52">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">MirrorScript</string>
				<string name="Source">--BASED ON WINDOW SCRIPT, only dif. is that where it&apos;s &quot;mirror&quot; and a few modificationswait(6)mirrors={} --insert all mirrors in heremirrorClean={}
mirrorDesc={}mirrorLClean={}mirrorHealth={}function searchForWindow(where)	local ch=where:getChildren()	local i=1	for i=1, #ch do		if ch[i].className==&quot;Model&quot; then searchForWindow(ch[i]) end		if ch[i].Name==&quot;Mirror*&quot; and ch[i]:findFirstChild(&quot;Clean&quot;)~=nil then table.insert(mirrors, ch[i]) end	endendsearchForWindow(game.Workspace)print(&quot;Found &quot; .. #mirrors .. &quot; mirrors!&quot;)for i = 1, #mirrors do	mirrorClean[i]=mirrors[i].Clean
	mirrorDesc[i]=mirrors[i].Description	mirrorClean[i].Value=10	mirrorLClean[i]=mirrorClean[i].Value-1 --to ensure it&apos;s different	mirrorHealth[i]=100 endfunction updateStage(mirror, stage) --returns new description	if stage&gt;1 then		mirror.Reflectance=stage/10		mirror.BrickColor=BrickColor.new(&quot;White&quot;)
		d=&quot;A beautiful mirror that you can look at yourself in.&quot;
		if stage&lt;10 then d = d .. &quot; Clean it for &quot; .. (10 - stage) .. &quot;$!&quot; end	else --super dirty mirror!!!		mirror.Reflectance=0.1		mirror.BrickColor=BrickColor.new(&quot;Medium stone gray&quot;)
		d=&quot;What a disgusting mirror! Someone should clean it. They&apos;d get 10$!&quot;	end	if stage&gt;1 and stage&lt;=6 then mirror.BrickColor=BrickColor.new(&quot;Light stone gray&quot;) end
	return dendfunction update() --decrease the health; change the stage if dif. than last &quot;clean&quot; value	for i = 1, #mirrors do		mirrorHealth[i]=mirrorHealth[i]-math.random(2,3)		if mirrorHealth[i]&lt;=0 then			mirrorHealth[i]=100			if mirrorClean[i].Value&gt;1 then mirrorClean[i].Value=mirrorClean[i].Value-1 end		end		if mirrorClean[i].Value~=mirrorLClean[i] then			mirrorDesc[i].Value=updateStage(mirrors[i], mirrorClean[i].Value)			mirrorLClean[i]=mirrorClean[i].Value		end	end	endwhile true do	wait(3)	update()end</string>
				<bool name="archivable">true</bool>
			</Properties>
		</Item>
		<Item class="Script" referent="RBX53">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">OrbScript</string>
				<string name="Source">--BASED ON TELEPORTCOLOURSCRIPTwait(5)orb={}function searchForWindow(where)	local ch=where:getChildren()	local i=1	for i=1, #ch do		if ch[i].className==&quot;Model&quot; then searchForWindow(ch[i]) end		if string.find(ch[i].Name, &quot;Orb&quot;)~=nil and ch[i].className==&quot;Part&quot; and ch[i]:findFirstChild(&quot;Description&quot;)~=nil then table.insert(orb, ch[i]) end	endendsearchForWindow(game.Workspace)print(&quot;Found &quot; .. #orb .. &quot; orbs!&quot;)c1 = BrickColor.new(&quot;White&quot;)
c2 = BrickColor.new(&quot;Bright yellow&quot;)
c3 = BrickColor.new(&quot;Bright orange&quot;)
db={}
for i = 1, #orb do db[i]=false end
function onTouch(obj, o)
	if db[o] then return end
	db[o]=true
	if obj.Parent:findFirstChild(&quot;Humanoid&quot;)~=nil then --humanoid.... do they already have this orb?
		p=game.Players:findFirstChild(obj.Parent.Name)
		if p~=nil then
			ox=p.stats.Orbs
			h=Instance.new(&quot;Hint&quot;)
			h.Parent=p
			s=game.Lighting.DeleteChildScript:clone()
			s.Parent=game.Workspace
			s.What.Value=h
			if ox:findFirstChild(orb[o].Name)==nil then
				ob=Instance.new(&quot;BoolValue&quot;)
				ob.Name=orb[o].Name
				ob.Parent=ox
				h.Text=&quot;You have found an orb!!!&quot;
				p.leaderstats[&quot;Orbs Found&quot;].Value = #ox:GetChildren()
				wait(3) --only wait if the person got the orb. Otherwise might interfere with crowds getting it!
			else --already have it!
				h.Text=&quot;You already have this orb.&quot;
			end
		end
	end
	db[o]=false
end

for i = 1, #orb do
orb[i].Touched:connect(function(obj) onTouch(obj, i) end)
end

function it()
	t=t+tt
	if t&gt;=1 then
		t=1
		tt=-tt
	elseif t&lt;=0 then
		tt=-tt
		t=0
	end
	for oo = 1, #orb do
		orb[oo].Transparency=t
	end
end
--[[c=1
t=0
tt=0.02
while true do
	if c==1 then 
		for i = 1, #orb do
			orb[i].BrickColor=c1
		end
		c = 2 
	elseif c==2 then
		c = 3 
		for i = 1, #orb do
			orb[i].BrickColor=c2
		end
	else
		c = 1 
		for i = 1, #orb do
			orb[i].BrickColor=c3
		end
	end
	for i=0,.3,0.04 do
		wait(.4)
		it()
		for j = 1, #orb do
			orb[j].Reflectance=i
		end		
	end
	for i=.3,0,-0.04 do
		wait(.4)
		it()
		for j = 1, #orb do
			orb[j].Reflectance=i
		end		
	end
end
--]]
</string>
				<bool name="archivable">true</bool>
			</Properties>
		</Item>
		<Item class="Script" referent="RBX54">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">OrderingScript</string>
				<string name="Source">--makes pretend customers and orders so that you can cook for them and get money!
t=game.Workspace.SpecialTables:getChildren() --references the tables themselves
tables={} --the table TOP&apos;s, as in the Brick of the table we&apos;re using.
orders={}
for i = 1, #t do
	tables[i]=t[i].Table.Top
	orders[i]=0
end
t=nil --clear this variable -- we don&apos;t need it anymore.
function makeValue() --generates random order and returns the value.
	return math.random(1,2)+2^math.random(2,4)+2^math.random(5,6)
end
function getDesc(v) --for value &quot;v&quot;. Returns String representing order.
	d=&quot;Ordering:&quot;
	ff=true --first time means no comma...
	if math.floor(v/64)==1 then v=v-64 if not ff then d=d..&quot;,&quot; end ff=false d=d..&quot; Fries&quot; end
	if math.floor(v/32)==1 then v=v-32 if not ff then d=d..&quot;,&quot; end ff=false d=d..&quot; Soup&quot; end
	if math.floor(v/16)==1 then v=v-16 if not ff then d=d..&quot;,&quot; end ff=false d=d..&quot; Water&quot; end
	if math.floor(v/8)==1 then v=v-8 if not ff then d=d..&quot;,&quot; end ff=false d=d..&quot; Pop&quot; end
	if math.floor(v/4)==1 then v=v-4 if not ff then d=d..&quot;,&quot; end ff=false d=d..&quot; Milk&quot; end
	if math.floor(v/2)==1 then v=v-2 if not ff then d=d..&quot;,&quot; end ff=false d=d..&quot; Hamburger&quot; end
	if math.floor(v/1)==1 then v=v-1 if not ff then d=d..&quot;,&quot; end ff=false d=d..&quot; Sandwich&quot; end
	return d
end


function makeOrders()
	for i = 1, #orders do
		if orders[i]==0 then orders[i]=makeValue() update=true end
	end
end
function checkOrder(index, food) --is it ordered? If so, pay up + delete, otherwise do nothing.
	--find the Name of the object, the pay we&apos;d give for it, and the index (ie 1, 2, ... 64)
	ok=true
	if food.Name==&quot;Food&quot; then --sandwich, or hamburger? Look at content...
		ok=food.Cooked.Value
		if food.Content.Value==7 then
			name=&quot;Sandwich&quot;
			nn=1
			pay=50
		elseif food.Content.Value==31 then
			name=&quot;Hamburger&quot;
			nn=2
			pay=65
		else
			ok=false --definitely not edible...
		end
	elseif food.Name==&quot;Drink&quot; then
		pay=15
		if string.find(food.Description.Value, &quot;Milk&quot;)~=nil then
			name=&quot;Milk&quot;
			nn=4
		elseif string.find(food.Description.Value, &quot;Water&quot;)~=nil then
			name=&quot;Water&quot;
			nn=16
		else --pop
			name=&quot;Pop&quot;
			nn=8
		end
	else --is &quot;Food2&quot;, so is either fries or soup.
		pay=25
		ok=food.Cooked.Value
		if string.find(food.Description.Value, &quot;Fries&quot;)~=nil then
			nn=64
			name=&quot;Fries&quot;
		else
			nn=32
			name=&quot;Soup&quot;
		end
	end
	if string.find(getDesc(orders[index]), name) and ok then 
		c=food:FindFirstChild(&quot;Creator&quot;)
		if c~=nil then c.Value.leaderstats.Money.Value=c.Value.leaderstats.Money.Value+pay end
		food:Remove()
		orders[index]=orders[index]-nn
		update=true
	end
end
function checkOrders()
	ch=game.Workspace.FoodItems:GetChildren()
	for t = 1, #tables do
		for i = 1, #ch do
			if ch[i].className==&quot;Part&quot; then --otherwise we found the script
				dist=(ch[i].Position-tables[t].Position).magnitude
				if dist&lt;4 then
					checkOrder(t,ch[i])
				end
			end
		end
	end
end
update=true
while true do
	wait(5)
	makeOrders() --make new orders whenever there is something empty.
	checkOrders() --check to see if anything ordered is on the table. If yes, clear the food and pay up!
	if update then
		update=false
		for t = 1, #tables do
			tables[t].Parent.Parent.Description.Value=getDesc(orders[t])
		end
	end
end
</string>
				<bool name="archivable">true</bool>
			</Properties>
		</Item>
		<Item class="Script" referent="RBX55">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">SecretBaseTeleportMaze</string>
				<string name="Source">aa=game.Workspace.Teleporteraa
ab=game.Workspace.Teleporterab
ac=game.Workspace.Teleporterac
ad=game.Workspace.Teleporterad
ba=game.Workspace.Teleporterba
bb=game.Workspace.Teleporterbb
ca=game.Workspace.Teleporterca
cb=game.Workspace.Teleportercb
da=game.Workspace.Teleporterda
function onTouchaa(obj)
	if game.Players:findFirstChild(obj.Parent.Name)~=nil then
		obj.Parent:MoveTo(game.Workspace[&quot;Starting Entrance&quot;].SpawnLocation.Position)
	end
end
p1=ba.Position
p2=bb.Position
abPos=Vector3.new((p1.x+p2.x)/2, p1.y+7, (p1.z+p2.z)/2)
function onTouchab(obj)
	if game.Players:findFirstChild(obj.Parent.Name)~=nil then
		obj.Parent:MoveTo(abPos)
	end
end
p1=ac.Position
p2=ad.Position
acPos=Vector3.new((p1.x+p2.x)/2, p1.y+7, (p1.z+p2.z)/2)
function onTouchac(obj)
	if game.Players:findFirstChild(obj.Parent.Name)~=nil then
		obj.Parent:MoveTo(acPos)
	end
end
function onTouchad(obj)
	if game.Players:findFirstChild(obj.Parent.Name)~=nil then
		obj.Parent:MoveTo(Vector3.new(ad.Position.x-15, ad.Position.y+7, ad.Position.z))
	end
end
cancelBA=false
dbBA=false
p1=ca.Position
p2=cb.Position
baPos=Vector3.new((p1.x+p2.x)/2, p1.y+7, (p1.z+p2.z)/2)
function onTouchba(obj)
	if dbBA then return end
	if game.Players:findFirstChild(obj.Parent.Name)~=nil then --finish to have debounce + cancellable
		dbBA=true
		cancelBA=false
		wait(8)
		if cancelBA or obj==nil then dbBA=false return end --someone stepped on the wrong teleporter! OR person left....
		obj.Parent:MoveTo(baPos)
		dbBA=false
	end
end
function onTouchbb(obj)
	if game.Players:findFirstChild(obj.Parent.Name)~=nil then
		cancelBA=true
		obj.Parent:MoveTo(Vector3.new(ad.Position.x-15, ad.Position.y+7, ad.Position.z))
	end
end
function onTouchca(obj)
	if game.Players:findFirstChild(obj.Parent.Name)~=nil then
		obj.Parent:MoveTo(Vector3.new(da.Position.x-6, da.Position.y+6, da.Position.z))
	end
end
function onTouchcb(obj)
	if game.Players:findFirstChild(obj.Parent.Name)~=nil then
		obj.Parent:MoveTo(Vector3.new(ad.Position.x-15, ad.Position.y+7, ad.Position.z))
	end
end
function onTouchda(obj)
	if game.Players:findFirstChild(obj.Parent.Name)~=nil then
		obj.Parent:MoveTo(Vector3.new(ad.Position.x-15, ad.Position.y+7, ad.Position.z))
	end
end
aa.Touched:connect(onTouchaa)
ab.Touched:connect(onTouchab)
ac.Touched:connect(onTouchac)
ad.Touched:connect(onTouchad)
ba.Touched:connect(onTouchba)
bb.Touched:connect(onTouchbb)
ca.Touched:connect(onTouchca)
cb.Touched:connect(onTouchcb)
da.Touched:connect(onTouchda)
</string>
				<bool name="archivable">true</bool>
			</Properties>
		</Item>
		<Item class="Script" referent="RBX56">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">SinkScript</string>
				<string name="Source">--BASED ON FLOOR SCRIPT, only dif. is that where it&apos;s &quot;sink&quot; and a few modificationswait(7)sinks={} --insert all sinks in heresinkClean={}
sinkDesc={}sinkLClean={}sinkHealth={}function searchForWindow(where)	local ch=where:getChildren()	local i=1	for i=1, #ch do		if ch[i].className==&quot;Model&quot; then searchForWindow(ch[i]) end		if ch[i].Name==&quot;Sink*&quot; and ch[i]:findFirstChild(&quot;Clean&quot;)~=nil then table.insert(sinks, ch[i]) end	endendsearchForWindow(game.Workspace)print(&quot;Found &quot; .. #sinks .. &quot; sinks!&quot;)for i = 1, #sinks do	sinkClean[i]=sinks[i].Clean
	sinkDesc[i]=sinks[i].Description	sinkClean[i].Value=5	sinkLClean[i]=sinkClean[i].Value-1 --to ensure it&apos;s different	sinkHealth[i]=100 endfunction updateStage(sink, stage)	t=0	if stage==5 then		c=BrickColor.new(&quot;White&quot;)		t=.4
		d=&quot;A shining Builderman Suite sink!&quot;	elseif stage==4 then		t=.2		c=BrickColor.new(&quot;White&quot;)
		d=&quot;A Builderman Suite sink. Clean for 2$.&quot;	elseif stage==3 then		t=.1		c=BrickColor.new(&quot;Light stone gray&quot;)
		d=&quot;A dirty sink. Clean for 4$.&quot;	elseif stage==2 then		c=BrickColor.new(&quot;Medium stone gray&quot;)
		d=&quot;That&apos;s one dirty sink! Clean it up for 6$.&quot;	elseif stage==1 then		c=BrickColor.new(&quot;Dark stone gray&quot;)
		d=&quot;I wouldn&apos;t want to use that filthy sink! Clean it up for 8$.&quot;	else
		d=&quot;Yuck! That&apos;s a disgusting sink! Someone should clean it; they&apos;d get 10$!&quot;		c=BrickColor.new(&quot;Black&quot;)	end	sink.BrickColor=c	sink.Reflectance=t
	return dendfunction update() --decrease the health; change the stage if dif. than last &quot;clean&quot; value	for i = 1, #sinks do		sinkHealth[i]=sinkHealth[i]-math.random(1,2)		if sinkHealth[i]&lt;=0 then			sinkHealth[i]=100			if sinkClean[i].Value&gt;0 then sinkClean[i].Value=sinkClean[i].Value-1 end		end		if sinkClean[i].Value~=sinkLClean[i] then			sinkDesc[i].Value=updateStage(sinks[i], sinkClean[i].Value)			sinkLClean[i]=sinkClean[i].Value		end	end	endwhile true do	wait(3)	update()end</string>
				<bool name="archivable">true</bool>
			</Properties>
		</Item>
		<Item class="Script" referent="RBX57">
			<Properties>
				<bool name="Disabled">true</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">TeleportColourScript</string>
				<string name="Source">--BASED FLOOR SCRIPTwait(7)tele={} --insert all floors in herefunction searchForWindow(where)	local ch=where:getChildren()	local i=1	for i=1, #ch do		if ch[i].className==&quot;Model&quot; then searchForWindow(ch[i]) end		if string.find(ch[i].Name, &quot;Teleporter&quot;)~=nil and ch[i]:findFirstChild(&quot;Head&quot;)~=nil then table.insert(tele, ch[i].Head) end	endendsearchForWindow(game.Workspace)print(&quot;Found &quot; .. #tele .. &quot; teleporters!&quot;)c1 = BrickColor.new(&quot;Bright red&quot;)
c2 = BrickColor.new(&quot;Bright yellow&quot;)
c3 = BrickColor.new(&quot;Bright green&quot;)
c=1
while true do
	if c==1 then 
		for t = 1, #tele do
			tele[t].BrickColor=c1
		end
		c = 2 
	elseif c==2 then
		c = 3
		for t = 1, #tele do
			tele[t].BrickColor=c2
		end
	else
		for t = 1, #tele do
			tele[t].BrickColor=c3
		end
		c = 1
	end
	for i=0,.5,0.1 do
		wait(.2)
		for t=1, #tele do
			tele[t].Reflectance=i
		end
	end
	for i=.5,0,-0.1 do
		wait(.2)
		for t=1, #tele do
			tele[t].Reflectance=i
		end
	end
end
</string>
				<bool name="archivable">true</bool>
			</Properties>
		</Item>
		<Item class="Script" referent="RBX58">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Timer</string>
				<string name="Source">script.Time.Value=0
while true do
	wait(1)
	script.Time.Value=script.Time.Value+1
end
</string>
				<bool name="archivable">true</bool>
			</Properties>
			<Item class="IntValue" referent="RBX59">
				<Properties>
					<string name="Name">Time</string>
					<int name="Value">278</int>
					<bool name="archivable">true</bool>
				</Properties>
			</Item>
		</Item>
		<Item class="Script" referent="RBX60">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">WindowScript</string>
				<string name="Source">wait(5)
windows={} --insert all windows in herewindowClean={}
windowDesc={}windowLClean={}windowHealth={}function searchForWindow(where)	local ch=where:getChildren()	local i=1	for i=1, #ch do		if ch[i].className==&quot;Model&quot; then searchForWindow(ch[i]) end		if ch[i].Name==&quot;Window*&quot; and ch[i]:findFirstChild(&quot;Clean&quot;)~=nil then table.insert(windows, ch[i]) end	endendsearchForWindow(game.Workspace)print(&quot;Found &quot; .. #windows .. &quot; windows!&quot;)for i = 1, #windows do	windowClean[i]=windows[i].Clean
	windowDesc[i]=windows[i].Description	windowClean[i].Value=10	windowLClean[i]=windowClean[i].Value-1 --to ensure it&apos;s different	windowHealth[i]=100 endfunction updateStage(window, stage)	if stage&gt;1 then		window.Transparency=(stage-1)/10		window.Reflectance=(stage-1)/32		window.BrickColor=BrickColor.new(&quot;Black&quot;)
		if stage==10 then d=&quot;A beautiful Builderman Suite window!&quot; elseif stage&gt;6 then d=&quot;A slightly dirty window. Clean for &quot; .. (10-stage) .. &quot;$.&quot;
		else d=&quot;A dirty window. Clean for &quot; .. (10-stage) .. &quot;$.&quot; end	else --super dirty window!!!		window.Reflectance=0		window.Transparency=0.1		window.BrickColor=BrickColor.new(&quot;Dark orange&quot;)
		d=&quot;The filthiest window I&apos;ve ever seen! Someone should clean it; they&apos;d receive 10$!&quot;	end
	return dendfunction update() --decrease the health; change the stage if dif. than last &quot;clean&quot; value	for i = 1, #windows do		windowHealth[i]=windowHealth[i]-math.random(3,4)		if windowHealth[i]&lt;=0 then			windowHealth[i]=100			if windowClean[i].Value&gt;1 then windowClean[i].Value=windowClean[i].Value-1 end		end		if windowClean[i].Value~=windowLClean[i] then			windowDesc[i].Value=updateStage(windows[i], windowClean[i].Value)			windowLClean[i]=windowClean[i].Value		end	end	endwhile true do	wait(3)	update()end</string>
				<bool name="archivable">true</bool>
			</Properties>
		</Item>
