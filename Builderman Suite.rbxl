						<string name="Name">MirrorAndSink</string>
						<string name="Source">function onButton1Down(mouse)	if debounce==true then return end	debounce=true	local player = game.Players.LocalPlayer	if player == nil then return end	obj= mouse.Target	if obj==nil then return end	if (obj.Name==&quot;Mirror*&quot; or obj.Name==&quot;Sink*&quot;) and obj:findFirstChild(&quot;Clean&quot;)~=nil then
		t=player.Character:findFirstChild(&quot;Torso&quot;)
		if t==nil then return end
		dist=(obj.Position-t.Position).magnitude
		if dist&lt;=20 then			if (obj.Clean.Value&lt;10 and obj.Name==&quot;Mirror*&quot;) or (obj.Name==&quot;Sink*&quot; and obj.Clean.Value&lt;5) then 				obj.Clean.Value=obj.Clean.Value+1				s=player:findFirstChild(&quot;leaderstats&quot;)				if s~=nil then					m=s:findFirstChild(&quot;Money&quot;)					if m~=nil then if obj.Name==&quot;Mirror*&quot; then mm=1 else mm=2 end m.Value=m.Value+mm end				end			else				m=Instance.new(&quot;Hint&quot;)				if obj.Name==&quot;Mirror*&quot; then m.Text=&quot;This mirror is already clean!&quot; else m.Text=&quot;This sink is already clean!&quot; end				m.Parent=player				wait(2)				m:Remove()			end
		else
			m=Instance.new(&quot;Hint&quot;)
			m.Parent=player
			m.Text=&quot;You aren&apos;t close enough to clean it!&quot;
			wait(2)
			m:Remove()
		end	end	debounce = falseendfunction onSelected(mouse)	mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;	mouse.Button1Down:connect(function() onButton1Down(mouse) end)end
cleanTools={&quot;Bathroom&quot;, &quot;Mop&quot;, &quot;Water&quot;, &quot;Weed&quot;, &quot;Window&quot;}function onAncestryChanged()
	if script.Parent.Parent.Name==&quot;Backpack&quot; then --do a search! Are there other CLEANING tools? If so, kick the oldest one.
		script.Parent.Age.Value=3 --being highest, we&apos;ll ignore ourself...
		b=script.Parent.Parent
		for i= 1, #cleanTools do
			nc = b:findFirstChild(cleanTools[i])
			if nc~=nil then
				v=nc.Age
				if v.Value==0 then nc:Remove() else v.Value=0 end
			end
