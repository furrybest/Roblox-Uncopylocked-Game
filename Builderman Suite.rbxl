					</Properties>
					<Item class="StringValue" referent="RBX1819">
						<Properties>
							<string name="Name">random1</string>
							<string name="Value">Welcome to Builderman&apos;s Suite Hotel! Want to know more about (j) jobs or (a) other activities that go on at this hotel? (n for no)</string>
							<bool name="archivable">true</bool>
						</Properties>
						<Item class="StringValue" referent="RBX1820">
