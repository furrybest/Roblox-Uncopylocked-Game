			<Item class="StringValue" referent="RBX10294">
				<Properties>
					<string name="Name">Description</string>
					<string name="Value">Medium Quality Residence. Looks like you could book a room by talking to him!</string>
					<bool name="archivable">true</bool>
				</Properties>
			</Item>
			<Item class="StringValue" referent="RBX10295">
				<Properties>
					<string name="Name">Talk</string>
					<string name="Value">Welcome to Builderman Suite Hotel! Would you like to book a medium quality room? (y/n)</string>
					<bool name="archivable">true</bool>
				</Properties>
				<Item class="StringValue" referent="RBX10296">
					<Properties>
						<string name="Name">y</string>
						<string name="Value"></string>
						<bool name="archivable">true</bool>
					</Properties>
					<Item class="StringValue" referent="RBX10297">
						<Properties>
							<string name="Name">random1</string>
							<string name="Value">Wonderful!</string>
							<bool name="archivable">true</bool>
						</Properties>
						<Item class="StringValue" referent="RBX10298">
							<Properties>
								<string name="Name">random</string>
								<string name="Value">You must pay 400$ for a medium class room, and renewal -- which occurs every 10 minutes -- will be 40$. Sound good? (y/n)</string>
								<bool name="archivable">true</bool>
							</Properties>
							<Item class="StringValue" referent="RBX10299">
								<Properties>
									<string name="Name">y</string>
									<string name="Value">Alrighty then! Just give me a second to get your key...</string>
									<bool name="archivable">true</bool>
								</Properties>
								<Item class="Script" referent="RBX10300">
									<Properties>
										<bool name="Disabled">true</bool>
										<Content name="LinkedSource"><null></null></Content>
										<string name="Name">Script</string>
										<string name="Source">cost=400 --cost to purchase room
wait(.1)
w=script.Who.Value
h=Instance.new(&quot;Hint&quot;)
h.Parent=w
--1st; do they have the $$?
m=w.leaderstats.Money
if m.Value&gt;=cost then --continue execution....
	keys=game.Lighting.Keys.Med:getChildren()
	av={} --index of AVailable keys
	for i = 1, #keys do
		if keys[i].InUse.Value==false then table.insert(av, i) end
	end
	if #av &gt; 0 then
		ch = w.stats.Keys:getChildren()
		for i = 1, #ch do
			if ch[i]:findFirstChild(&quot;ID&quot;)~=nil then --a key to a room!
				ch[i]:Remove()
				h.Text=&quot;You already have a key? I&apos;ll take that...&quot;
				wait(2)
			end
		end
		m.Value=m.Value-cost
		n=math.random(1, #av)
		k=keys[av[n]]:clone()
		k.InUse:Remove()
		keys[av[n]].InUse.Value=true
		k.Parent=w.stats.Keys
		h.Text=&quot;Your new key unlocks room # &quot; .. k.ID.Value .. &quot;. Have a wonderful stay at Builderman Suite Hotel!&quot;
		wait(10)
		h:Remove()
	else
		h.Text = &quot;I&apos;m terribly sorry! All our rooms are booked! Perhaps you&apos;d like to try a different class, for now?&quot;
		wait(5)
		h:Remove()
	end
else --not enough money!
	h.Text=&quot;I&apos;m sorry, but you need to have &quot; .. cost .. &quot;$ before you can book a room.&quot;
	wait(5)
	h:Remove()
end
script:Remove() --we&apos;re just taking up space!
</string>
										<bool name="archivable">true</bool>
									</Properties>
									<Item class="ObjectValue" referent="RBX10301">
										<Properties>
											<string name="Name">Who</string>
											<Ref name="Value">null</Ref>
											<bool name="archivable">true</bool>
										</Properties>
									</Item>
								</Item>
							</Item>
							<Item class="StringValue" referent="RBX10302">
								<Properties>
									<string name="Name">n</string>
									<string name="Value">Perhaps you&apos;d like to try the low class, then?</string>
									<bool name="archivable">true</bool>
								</Properties>
							</Item>
						</Item>
					</Item>
					<Item class="StringValue" referent="RBX10303">
