			<Item class="Script" referent="RBX3018">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<string name="Source">distUp=70 --how far to aim upwards
distDown=50 --how far to aim downwards
p=script.Parent
c=p[&quot;Call Buttons&quot;]
buttons={c.b1, c.b2, c.b3, c.b4, c.b5, c.b6, c.b7, c.b8, c.b9} --call-to-floor buttons
d=p[&quot;Select Buttons&quot;]
button2={}
for i = 1, 9 do
button2[i]=d:findFirstChild(i).Head
end
db=false
up=script.Parent.Up.Head
down=script.Parent.Down.Head
ch=script.Parent:getChildren()
for i = 1, #ch do
	if string.sub(ch[i].Name, 1,5)==&quot;Floor&quot; then f=ch[i] break end
end
floor=0 --real floor is floor+1
height=70.55
maxFloor=8 -- +1==9
b=script.Parent.Floor.BodyPosition
d1=p.Door
d2=p.Door2
FChange=d.FloorChange
DFloor=d.DesiredFloor
targetPosition=floor*height+.6
function close()
	b.Parent.Anchored=false
	for i = 1, 0.5, -0.05 do
		wait(.15)
		d1.Transparency=i
		d2.Transparency=i
	end
	d1.Transparency=.5
	d2.Transparency=.5
	d1.CanCollide=true
	d2.CanCollide=true
end
function open()
	d1.CanCollide=false
	d2.CanCollide=false
	for i = 0.5, 1, 0.05 do
		wait(.15)
		d1.Transparency=i
		d2.Transparency=i
	end
	d1.Transparency=1
	d2.Transparency=1
	b.Parent.Anchored=true
	wait(3) --wait 3 seconds before allowing more orders to come in
end
function gn(ty, cy) --ty==targetY; cy=currentY
	if ty&gt;cy then
		gg=cy+distUp
		if gg&gt;ty then gg=ty end
		return gg
	else --we&apos;ll asume ty~=cy...
		gg= cy-distDown
		if gg&lt;ty then gg=ty end
		return gg
	end
end
function v(yy)
	return Vector3.new(b.Parent.Position.x, yy, b.Parent.Position.z)
end
function getCFloor(ty,cy)
	if ty&gt;cy then --going up...
		return math.floor(cy/height+0.1)+1
	else
		return math.ceil(cy/height-0.1)+1
	end
end
function act(br)
	db=true
	local i
	for i = 1, 9 do
		buttons[i].BrickColor=BrickColor.new(&quot;Bright blue&quot;)
	end
	br.BrickColor = BrickColor.new(&quot;Bright yellow&quot;)
	buttons[floor+1].BrickColor=BrickColor.new(&quot;Bright yellow&quot;)
	close()
	b.position = v(gn(targetPosition, b.Parent.Position.y))
	while math.abs(targetPosition-b.Parent.Position.y)&gt;1.5 do --update+wait
		wait(.1)
		b.position = v(gn(targetPosition, b.Parent.Position.y))
		f.Name=&quot;Floor &quot; .. getCFloor(targetPosition, b.Parent.Position.y)
	end
	f.Name=&quot;Floor &quot; .. (floor+1)
	open()
	for i = 1, 9 do
		buttons[i].BrickColor=BrickColor.new(&quot;White&quot;)
	end
	br.BrickColor = BrickColor.new(&quot;White&quot;)
	buttons[floor+1].BrickColor=BrickColor.new(&quot;White&quot;)
	db=false
end
function Fup(hit)
	if hit.Parent:FindFirstChild(&quot;Humanoid&quot;) ~= nil and floor&lt;maxFloor then
		if db then return end
		floor=floor+1
		targetPosition=floor*height+.6
		act(up)
	end
end
function Fdown(hit)
	if hit.Parent:FindFirstChild(&quot;Humanoid&quot;) ~= nil and floor&gt;0 then
		if db then return end
		floor=floor-1
		targetPosition=floor*height+.6
		act(down)
	end
end
function NewFloor(property)
	if FChange.Value==true then --new floor?
		if db then FChange.Value=false return end
		if DFloor.Value~=(floor+1) then
			floor=DFloor.Value-1
			targetPosition=floor*height+.6
			act(button2[floor+1])
			FChange.Value=false --allow more orders to come in!
		end
	end
end
ddb={}
function onTouched(hit, what, flr) 
	if ddb[flr]==true then return end
	ddb[flr]=true
	if db then --currently running &quot;act&quot;
		c=what.BrickColor 
		what.BrickColor=BrickColor.new(&quot;Bright red&quot;) 
		wait(1.5) 
		if what.BrickColor==BrickColor.new(&quot;Bright red&quot;) then what.BrickColor=c end --colour already updated, don&apos;t undo it!
		ddb[flr]=false
		return
	end
	if hit.Parent:FindFirstChild(&quot;Humanoid&quot;) ~= nil and floor~=flr and not db then
		floor=flr
		targetPosition=floor*height+.6
		wait() --for db; prevents duo-hit from making the button turn red
		ddb[flr]=false
		act(what)
	else
		ddb[flr]=false
	end
end

for i = 1, #buttons do
	buttons[i].Touched:connect(function(hit) onTouched(hit, buttons[i], (i-1)) end) 
end
up.Touched:connect(Fup) --where f stands for Function
down.Touched:connect(Fdown) --same thing
FChange.Changed:connect(NewFloor)
act(buttons[1])
while true do
	wait(1)
	if not db and FChange.Value then --error?
		wait(1)
		if not db and FChange.Value then --for sure we know it&apos;s an error now!
			FChange.Value=false
		end
	end
end

