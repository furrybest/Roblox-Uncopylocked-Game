			<Item class="StringValue" referent="RBX6977">
				<Properties>
					<string name="Name">Description</string>
					<string name="Value">He&apos;s the Hockey Arena Instructor! Talk to him to get in the game.</string>
					<bool name="archivable">true</bool>
				</Properties>
			</Item>
			<Item class="StringValue" referent="RBX6978">
				<Properties>
					<string name="Name">Talk</string>
					<string name="Value">What can I do for you? (b. I want to play! a. How do I play hockey? c. Nothing)</string>
					<bool name="archivable">true</bool>
				</Properties>
				<Item class="StringValue" referent="RBX6979">
					<Properties>
						<string name="Name">a</string>
						<string name="Value">Make sure you aren&apos;t hungry before starting a game. Simply push the puck into the opponent&apos;s net! If you get a red helmet, shoot at the blue net and vice versa. I strongly suggest making sure your head is NOT transparent or too reflectant, otherwise people won&apos;t know what team you&apos;re on.</string>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
				<Item class="StringValue" referent="RBX6980">
					<Properties>
						<string name="Name">b</string>
						<string name="Value"></string>
						<bool name="archivable">true</bool>
					</Properties>
					<Item class="Script" referent="RBX6981">
						<Properties>
							<bool name="Disabled">true</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script</string>
							<string name="Source">while script:findFirstChild(&quot;Who&quot;)==nil do	wait(.1)endw=script.Who.Valueh=Instance.new(&quot;Hint&quot;)h.Parent=w--add to a teamh2=game.Workspace[&quot;Hockey Arena&quot;]
if h2.RedTeam:findFirstChild(w.Name)~=nil then --died ingame due to hunger or used &quot;Get&quot;&gt;&quot;H&quot;
	w.Character.Head.BrickColor=BrickColor.new(&quot;Bright red&quot;)
	h.Text=&quot;You have been put back into the red team. Go score on the blue net!&quot;
elseif h2.BlueTeam:findFirstChild(w.Name)~=nil then --died ingame due to hunger
	w.Character.Head.BrickColor=BrickColor.new(&quot;Bright blue&quot;)
	h.Text=&quot;You have been put back into the blue team. Go score on the red net!&quot;
else	r=h2.RedTeam:GetChildren()	b=h2.BlueTeam:GetChildren()	s=Instance.new(&quot;ObjectValue&quot;)	s.Name=w.Name	s.Value=w
	if #r&gt;#b then --add to red team		w.HeadColor.Value=w.Character.Head.BrickColor		w.Character.Head.BrickColor=BrickColor.new(&quot;Bright blue&quot;)		h.Text=&quot;You are now on the blue team. Go score on the red net!&quot;		s.Parent=h2.BlueTeam	else --add to red team		w.HeadColor.Value=w.Character.Head.BrickColor		w.Character.Head.BrickColor=BrickColor.new(&quot;Bright red&quot;)		h.Text=&quot;You are now on the red team. Go score on the blue net!&quot;		s.Parent=h2.RedTeam	end
endp=h2.Ice.Positionw.Character:MoveTo(Vector3.new(p.x,p.y+15,p.z))wait(5)h:Remove()script:Remove()</string>
							<bool name="archivable">true</bool>
						</Properties>
						<Item class="ObjectValue" referent="RBX6982">
							<Properties>
								<string name="Name">Who</string>
								<Ref name="Value">null</Ref>
								<bool name="archivable">true</bool>
							</Properties>
						</Item>
					</Item>
				</Item>
				<Item class="StringValue" referent="RBX6983">
					<Properties>
						<string name="Name">c</string>
						<string name="Value">Ok! Have a good stay at Builderman Suite Hotel!</string>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
			</Item>
		</Item>
