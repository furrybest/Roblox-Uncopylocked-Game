											<string name="Name">Who</string>
											<Ref name="Value">null</Ref>
											<bool name="archivable">true</bool>
										</Properties>
									</Item>
								</Item>
							</Item>
							<Item class="StringValue" referent="RBX6895">
								<Properties>
									<string name="Name">n</string>
									<string name="Value">Perhaps you should try our medium and low class rooms, which cost less. Have a nice day!</string>
									<bool name="archivable">true</bool>
								</Properties>
							</Item>
						</Item>
