		<Item class="Script" referent="RBX20">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Group team spawn</string>
				<ProtectedString name="Source">function onPlayerEntered(newPlayer)
if newPlayer:isInGroup(14638) then
newPlayer.TeamColor = BrickColor.new(&quot;Dark green&quot;)
--[[elseif newPlayer:isInGroup(enemyid) then
newPlayer.TeamColor = BrickColor.new(&quot;Bright red&quot;)]]
else newPlayer.TeamColor = BrickColor.new(&quot;Bright blue&quot;)
end
game.Players.ChildAdded:connect(onPlayerEntered)

-- BAUER102 wrote the coloring and group team scripts, BenBonez and earth100 gave me ones with an error somewhere in them, therefore BAUER helped me fix it, so big thanks to him.

--// :DieSoft</ProtectedString>
