		<Item class="Script" referent="RBX12841">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Script</string>
				<ProtectedString name="Source">c= game.Workspace:GetChildren()
for i= 1, #c do
if c[i].className == &quot;Part&quot; then
if c[i].BrickColor == BrickColor.new(&quot;Navy blue&quot;) then
c[i].BrickColor = BrickColor.new(&quot;Earth green&quot;)
end
end
end
</ProtectedString>
			</Properties>
