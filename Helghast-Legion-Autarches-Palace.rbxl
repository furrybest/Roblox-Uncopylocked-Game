			<Item class="Script" referent="RBX972">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">MainControl</string>
					<ProtectedString name="Source">CaptureTime = 60

function Change(Team)
&#9;if Team == game.Teams.Vaktovians.TeamColor then
&#9;&#9;for _,v in pairs(game.Players:GetPlayers()) do
&#9;&#9;&#9;v.PlayerGui.Capture.NOTIF.Visible = true
&#9;&#9;&#9;v.PlayerGui.Capture.NOTIF.Notifi.Text = &quot;HL Are reclaiming the terminal!&quot;
&#9;&#9;end
&#9;elseif Team == game.Teams.Raiders.TeamColor then
&#9;&#9;for _,v in pairs(game.Players:GetPlayers()) do
&#9;&#9;&#9;v.PlayerGui.Capture.NOTIF.Visible = true
&#9;&#9;&#9;v.PlayerGui.Capture.NOTIF.Notifi.Text = &quot;Raiders are hacking the terminal!&quot;
&#9;&#9;end
&#9;end
end

function Reset()
&#9;for _,v in pairs(game.Players:GetPlayers()) do
&#9;&#9;v.PlayerGui.Capture.NOTIF.Visible = false 
&#9;end
end

while true do
&#9;for _, Player in pairs(game.Players:GetPlayers()) do
&#9;&#9;local _, Torso = pcall(function() return Player.Character.Torso end)
&#9;&#9;if type(Torso) == &quot;userdata&quot; and Player.TeamColor ~= script.Parent.ControlColor.Value and Player.Neutral == false and Player.PlayerGui:FindFirstChild(&quot;FlagGui&quot;) ~= nil and Player.TeamColor ~= game.Teams[&quot;Vaktovian Cadets&quot;].TeamColor and Player.TeamColor ~= game.Teams.VACs.TeamColor then
&#9;&#9;&#9;if (Torso.Position - script.Parent.Base.Position).magnitude &lt;= 20 and Player.PlayerGui.FlagGui.Capturing.Value == false then
&#9;&#9;&#9;&#9;Player.PlayerGui.FlagGui.Capturing.Value = true
&#9;&#9;&#9;&#9;coroutine.wrap(function()
&#9;&#9;&#9;&#9;&#9;local WaitTime = 0
&#9;&#9;&#9;&#9;&#9;Player.PlayerGui.FlagGui.Background:TweenPosition(UDim2.new(0.9, 85, .3, 180), &quot;Out&quot;, &quot;Quad&quot;, 1, true)
&#9;&#9;&#9;&#9;&#9;Player.PlayerGui.FlagGui.Background.BarFront:TweenSize(UDim2.new(0, 20, 0, -180), &quot;Out&quot;, &quot;Quad&quot;, CaptureTime, true)
&#9;&#9;&#9;&#9;&#9;Change(Player.TeamColor)
&#9;&#9;&#9;&#9;&#9;while true do
&#9;&#9;&#9;&#9;&#9;&#9;if Torso.Parent == nil then break end
&#9;&#9;&#9;&#9;&#9;&#9;if (Torso.Position - script.Parent.Base.Position).magnitude &gt; 20 or Player.TeamColor == script.Parent.ControlColor.Value or Player.Neutral == true then break end
&#9;&#9;&#9;&#9;&#9;&#9;WaitTime = WaitTime + wait()
&#9;&#9;&#9;&#9;&#9;&#9;if WaitTime &gt; CaptureTime then break end
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;Player.PlayerGui.FlagGui.Background:TweenPosition(UDim2.new(0.9, 135, .3, 180), &quot;Out&quot;, &quot;Quad&quot;, 1, true)
&#9;&#9;&#9;&#9;&#9;Player.PlayerGui.FlagGui.Background.BarFront:TweenSize(UDim2.new(0, 20, 0, 0), &quot;Out&quot;, &quot;Quad&quot;, 0.25, true)
&#9;&#9;&#9;&#9;&#9;Reset()
&#9;&#9;&#9;&#9;&#9;if WaitTime &gt; CaptureTime then script.Parent.ControlColor.Value = Player.TeamColor Reset() end
&#9;&#9;&#9;&#9;&#9;wait(0.1)
&#9;&#9;&#9;&#9;&#9;Player.PlayerGui.FlagGui.Capturing.Value = false
&#9;&#9;&#9;&#9;end)()
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
&#9;--script.Parent.Flag.BrickColor = script.Parent.ControlColor.Value
&#9;script.Parent.Base.Handles.Color = script.Parent.ControlColor.Value
&#9;wait()
end&#9;</ProtectedString>
				</Properties>
			</Item>
