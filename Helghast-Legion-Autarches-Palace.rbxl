				<Item class="Script" referent="RBX8787">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">WeldScript</string>
						<ProtectedString name="Source">t = script.Parent

function stick(x, y)
&#9;weld = Instance.new(&quot;Weld&quot;) 
&#9;weld.Part0 = x
&#9;weld.Part1 = y
&#9;local HitPos = x.Position
&#9;local CJ = CFrame.new(HitPos) 
&#9;local C0 = x.CFrame:inverse() *CJ 
&#9;local C1 = y.CFrame:inverse() * CJ 
&#9;weld.C0 = C0 
&#9;weld.C1 = C1 
&#9;weld.Parent = x
end

function Weldnow()
&#9;c = t:children()
&#9;for n = 1, #c do
&#9;&#9;if (c[n].className == &quot;Part&quot;) then
&#9;&#9;&#9;if (c[n].Name ~= &quot;Handle&quot; and c[n].Name ~= &quot;Damage&quot;) then
&#9;&#9;&#9;&#9;c[n].CFrame = t.Handle.CFrame
&#9;&#9;&#9;&#9;c[n].Anchored = false
&#9;&#9;&#9;&#9;stick(c[n], t.Handle)
&#9;&#9;&#9;end
&#9;&#9;&#9;if (c[n].Name == &quot;Damage&quot;) then
&#9;&#9;&#9;&#9;c[n].CFrame = t.Handle.CFrame * CFrame.new(0,2.5,0)
&#9;&#9;&#9;&#9;c[n].Anchored = false
&#9;&#9;&#9;&#9;stick(c[n], t.Handle)
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end

script.Parent.Equipped:connect(Weldnow)
script.Parent.Unequipped:connect(Weldnow)
Weldnow()</ProtectedString>
					</Properties>
				</Item>
				<Item class="LocalScript" referent="RBX8788">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Local Gui</string>
						<ProtectedString name="Source">local Tool = script.Parent;

function getSurface(p,pos)
&#9;if (p == nil) then return nil end
&#9;local vec = p.CFrame:pointToObjectSpace(pos) 
&#9;local s = p.Size / 2

&#9;if (math.abs(vec.x - s.x) &lt; 1) then return &quot;Right&quot; end
&#9;if (math.abs(vec.x + s.x) &lt; 1) then return &quot;Left&quot; end
&#9;if (math.abs(vec.y + s.y) &lt; 1) then return &quot;Bottom&quot; end
&#9;if (math.abs(vec.y - s.y) &lt; 1) then return &quot;Top&quot; end
&#9;if (math.abs(vec.z - s.z) &lt; 1) then return &quot;Back&quot; end
&#9;if (math.abs(vec.z + s.z) &lt; 1) then return &quot;Front&quot; end

&#9;if (p.Shape == Enum.PartType.Ball) then return &quot;Ball&quot;, CFrame.new(p.Position,pos).lookVector end
&#9;return &quot;None&quot;
end

function getNormal(p,sId)
&#9;if (p == nil) then return nil end
&#9;if (sId == &quot;Front&quot;) then return p.CFrame.lookVector end
&#9;if (sId == &quot;Back&quot;) then return (p.CFrame * CFrame.Angles(0,math.pi,0)).lookVector end
&#9;if (sId == &quot;Left&quot;) then return (p.CFrame * CFrame.Angles(0,math.pi/2,0)).lookVector end
&#9;if (sId == &quot;Right&quot;) then return (p.CFrame * CFrame.Angles(0,math.pi/-2,0)).lookVector end
&#9;if (sId == &quot;Bottom&quot;) then return (p.CFrame * CFrame.Angles(math.pi/-2,0,0)).lookVector end
&#9;if (sId == &quot;Top&quot;) then return (p.CFrame * CFrame.Angles(math.pi/2,0,0)).lookVector end
end

function getBounce(vel,part,pos,friction)
&#9;local surface, normal = getSurface(part,pos)
&#9;if (surface == &quot;Ball&quot;) then
&#9;&#9;return friction * (-2 * vel:Dot(normal) * normal + vel)
&#9;else
&#9;&#9;normal = getNormal(part,surface)
&#9;&#9;return friction * (-2 * vel:Dot(normal) * normal + vel)
&#9;end
end

function physShell(pt,iVel,duration)
&#9;local speed = iVel.magnitude
&#9;local frames = duration * 30

&#9;pt.Velocity = iVel
&#9;local passed = 0

&#9;for passed = 1, duration do
&#9;&#9;wait()
&#9;&#9;local ray = Ray.new(pt.Position,pt.Velocity/30)
&#9;&#9;local p, pos = workspace:FindPartOnRay(ray,pt)
&#9;&#9;pt.CFrame = CFrame.new(pos)
&#9;&#9;
&#9;&#9;if (p) then
&#9;&#9;&#9;pt.Bounce.Volume = pt.Velocity.magnitude / 10
&#9;&#9;&#9;pt.Bounce:play()
&#9;&#9;&#9;pt.Velocity = getBounce(pt.Velocity,p,pos,0.75)
&#9;&#9;&#9;pt.CFrame = CFrame.new(pos)
&#9;&#9;end

&#9;&#9;pt.Velocity = pt.Velocity - Vector3.new(0,1,0)
&#9;&#9;if (pt.Velocity.magnitude &lt; 2) then break end
&#9;end
&#9;local a = 0
&#9;for a = 1, 100 do
&#9;&#9;pt.Transparency = a / 100
&#9;&#9;wait()
&#9;end
&#9;pt:remove()
end

vector = Vector3.new

function stick(x, y)
&#9;weld = Instance.new(&quot;Weld&quot;) 
&#9;weld.Part0 = x
&#9;weld.Part1 = y
&#9;local HitPos = x.Position
&#9;local CJ = CFrame.new(HitPos) 
&#9;local C0 = x.CFrame:inverse() *CJ 
&#9;local C1 = y.CFrame:inverse() * CJ 
&#9;weld.C0 = C0 
&#9;weld.C1 = C1 
&#9;weld.Parent = x
end

enabled = true
splat_id = &quot;http://www.roblox.com/asset/?id=29350583&quot;
hole_id = &quot;http://www.roblox.com/asset/?id=30217567&quot;
hitHum = false

function animate(ani)
&#9;if (ani == &quot;slash&quot;) then
&#9;&#9;ls = Tool.Parent.Torso[&quot;Left Shoulder&quot;]
&#9;&#9;rs = Tool.Parent.Torso[&quot;Right Shoulder&quot;]
&#9;&#9;for a = 1, 5 do
&#9;&#9;&#9;rs.C0 = rs.C0 * CFrame.Angles(0,0.1,0)
&#9;&#9;&#9;rs.DesiredAngle = (math.pi/2) * 1.25
&#9;&#9;&#9;wait()
&#9;&#9;end
&#9;&#9;Tool.Handle.Sound:play()
&#9;&#9;local speed = rs.MaxVelocity
&#9;&#9;rs.MaxVelocity = 1.2
&#9;&#9;for a = 1, 5 do
&#9;&#9;&#9;wait()
&#9;&#9;&#9;rs.DesiredAngle = 0
&#9;&#9;end
&#9;&#9;rs.MaxVelocity = speed
&#9;&#9;for a = 1, 5 do
&#9;&#9;&#9;rs.C0 = rs.C0 * CFrame.Angles(0,-0.1,0)
&#9;&#9;&#9;rs.DesiredAngle = (math.pi/2) * 1.25
&#9;&#9;&#9;wait()
&#9;&#9;end
&#9;end
&#9;if (ani == &quot;slash2&quot;) then
&#9;&#9;ls = Tool.Parent.Torso[&quot;Left Shoulder&quot;]
&#9;&#9;rs = Tool.Parent.Torso[&quot;Right Shoulder&quot;]
&#9;&#9;for a = 1, 7 do
&#9;&#9;&#9;rs.C0 = rs.C0 * CFrame.Angles(0,0.1,0)
&#9;&#9;&#9;ls.C0 = ls.C0 * CFrame.Angles(0,-0.1,0)
&#9;&#9;&#9;rs.DesiredAngle = (math.pi/2) * 1.25
&#9;&#9;&#9;ls.DesiredAngle = (-math.pi/2) * 1.25
&#9;&#9;&#9;wait()
&#9;&#9;end

&#9;&#9;for a = 1, 5 do
&#9;&#9;&#9;rs.DesiredAngle = (math.pi/2) * 1.25
&#9;&#9;&#9;ls.DesiredAngle = (-math.pi/2) * 1.25
&#9;&#9;&#9;wait()
&#9;&#9;end

&#9;&#9;Tool.Handle.Sound:play()
&#9;&#9;local speed = rs.MaxVelocity
&#9;&#9;rs.MaxVelocity = 1.2
&#9;&#9;ls.MaxVelocity = 1.2
&#9;&#9;for a = 1, 5 do
&#9;&#9;&#9;wait()
&#9;&#9;&#9;rs.DesiredAngle = 0
&#9;&#9;&#9;ls.DesiredAngle = 0
&#9;&#9;end
&#9;&#9;rs.MaxVelocity = speed
&#9;&#9;ls.MaxVelocity = speed

&#9;&#9;for a = 1, 7 do
&#9;&#9;&#9;rs.C0 = rs.C0 * CFrame.Angles(0,-0.1,0)
&#9;&#9;&#9;ls.C0 = ls.C0 * CFrame.Angles(0,0.1,0)
&#9;&#9;&#9;rs.DesiredAngle = (math.pi/2) * 1.25
&#9;&#9;&#9;ls.DesiredAngle = (-math.pi/2) * 1.25
&#9;&#9;&#9;wait()
&#9;&#9;end
&#9;&#9;--ls.DesiredAngle = (-math.pi/2) * 0.75
&#9;end
&#9;if (ani == &quot;stab&quot;) then
&#9;&#9;ls = Tool.Parent.Torso[&quot;Left Shoulder&quot;]
&#9;&#9;rs = Tool.Parent.Torso[&quot;Right Shoulder&quot;]

&#9;&#9;for a = 1, 7 do
&#9;&#9;&#9;rs.C0 = rs.C0 * CFrame.Angles(0,0.1,0)
&#9;&#9;&#9;ls.C0 = ls.C0 * CFrame.Angles(0,-0.1,0)
&#9;&#9;&#9;rs.DesiredAngle = (math.pi)
&#9;&#9;&#9;ls.DesiredAngle = (-math.pi)
&#9;&#9;&#9;wait()
&#9;&#9;end

&#9;&#9;Tool.GripUp = Vector3.new(0,-1,0)
&#9;&#9;Tool.GripRight = Vector3.new(1,0,0)

&#9;&#9;for a = 1, 5 do
&#9;&#9;&#9;rs.DesiredAngle = (math.pi)
&#9;&#9;&#9;ls.DesiredAngle = (-math.pi)
&#9;&#9;&#9;wait()
&#9;&#9;end

&#9;&#9;Tool.Handle.Sound:play()
&#9;&#9;local speed = rs.MaxVelocity
&#9;&#9;rs.MaxVelocity = 1.2
&#9;&#9;ls.MaxVelocity = 1.2
&#9;&#9;for a = 1, 5 do
&#9;&#9;&#9;wait()
&#9;&#9;&#9;rs.DesiredAngle = 0
&#9;&#9;&#9;ls.DesiredAngle = 0
&#9;&#9;end
&#9;&#9;rs.MaxVelocity = speed
&#9;&#9;ls.MaxVelocity = speed

&#9;&#9;for a = 1, 7 do
&#9;&#9;&#9;rs.C0 = rs.C0 * CFrame.Angles(0,-0.1,0)
&#9;&#9;&#9;ls.C0 = ls.C0 * CFrame.Angles(0,0.1,0)
&#9;&#9;&#9;rs.DesiredAngle = (math.pi/2) * 1.25
&#9;&#9;&#9;ls.DesiredAngle = (-math.pi/2) * 1.25
&#9;&#9;&#9;wait()
&#9;&#9;end
&#9;&#9;Tool.GripUp = Vector3.new(0,1,0)
&#9;&#9;Tool.GripRight = Vector3.new(1,0,0)
&#9;end
&#9;if (ani == &quot;shot&quot;) then
&#9;&#9;Tool.Loading1.BrickColor = BrickColor.new(&quot;Earth green&quot;)
&#9;&#9;Tool.Loading2.BrickColor = BrickColor.new(&quot;Earth green&quot;)
&#9;&#9;Tool.Loading3.BrickColor = BrickColor.new(&quot;Earth green&quot;)
&#9;&#9;Tool.Loading4.BrickColor = BrickColor.new(&quot;Earth green&quot;)
&#9;&#9;wait(0.1)
&#9;&#9;Tool.Loading1.BrickColor = BrickColor.new(&quot;Lime green&quot;)
&#9;&#9;wait(0.1)
&#9;&#9;Tool.Loading2.BrickColor = BrickColor.new(&quot;Lime green&quot;)
&#9;&#9;wait(0.1)
&#9;&#9;Tool.Loading3.BrickColor = BrickColor.new(&quot;Lime green&quot;)
&#9;&#9;wait(0.1)
&#9;&#9;Tool.Loading4.BrickColor = BrickColor.new(&quot;Lime green&quot;)
&#9;end
&#9;if (ani == &quot;reload&quot;) then
&#9;&#9;Tool.Loading1.BrickColor = BrickColor.new(&quot;Reddish brown&quot;)
&#9;&#9;Tool.Loading2.BrickColor = BrickColor.new(&quot;Reddish brown&quot;)
&#9;&#9;Tool.Loading3.BrickColor = BrickColor.new(&quot;Reddish brown&quot;)
&#9;&#9;Tool.Loading4.BrickColor = BrickColor.new(&quot;Reddish brown&quot;)
&#9;&#9;wait(1)
&#9;&#9;Tool.Loading1.BrickColor = BrickColor.new(&quot;Really red&quot;)
&#9;&#9;wait(1)
&#9;&#9;Tool.Loading2.BrickColor = BrickColor.new(&quot;Really red&quot;)
&#9;&#9;wait(1)
&#9;&#9;Tool.Loading3.BrickColor = BrickColor.new(&quot;Really red&quot;)
&#9;&#9;wait(1)
&#9;&#9;Tool.Loading4.BrickColor = BrickColor.new(&quot;Really red&quot;)
&#9;&#9;wait(1)
&#9;&#9;Tool.Handle.Charge:play()
&#9;&#9;Tool.Loading1.BrickColor = BrickColor.new(&quot;Earth green&quot;)
&#9;&#9;Tool.Loading2.BrickColor = BrickColor.new(&quot;Earth green&quot;)
&#9;&#9;Tool.Loading3.BrickColor = BrickColor.new(&quot;Earth green&quot;)
&#9;&#9;Tool.Loading4.BrickColor = BrickColor.new(&quot;Earth green&quot;)
&#9;&#9;wait(0.1)
&#9;&#9;Tool.Loading1.BrickColor = BrickColor.new(&quot;Lime green&quot;)
&#9;&#9;wait(0.1)
&#9;&#9;Tool.Loading2.BrickColor = BrickColor.new(&quot;Lime green&quot;)
&#9;&#9;wait(0.1)
&#9;&#9;Tool.Loading3.BrickColor = BrickColor.new(&quot;Lime green&quot;)
&#9;&#9;wait(0.1)
&#9;&#9;Tool.Loading4.BrickColor = BrickColor.new(&quot;Lime green&quot;)
&#9;&#9;shots = 25
&#9;&#9;Tool.Name =  &quot;Gunblade [&quot; .. shots .. &quot;]&quot;
&#9;end
end

function relpos(x, y)
&#9;local HitPos = x
&#9;local CJ = CFrame.new(HitPos) 
&#9;local C0 = CFrame.new(-x) * CJ
&#9;local C1 = y.CFrame:inverse() * CJ
&#9;local ReturnCF = C0 * (C1:inverse())
&#9;return ReturnCF:inverse().p
end

function texture(part,pos,surface,id,size)
&#9;if (part) then
&#9;&#9;--Enum.NormalId.Top
&#9;&#9;local p = Instance.new(&quot;Part&quot;)
&#9;&#9;p.formFactor = 0
&#9;&#9;p.Size = Vector3.new(1,1,1)
&#9;&#9;p.CFrame = part.CFrame
&#9;&#9;p.Anchored = true
&#9;&#9;p.Transparency = 1
&#9;&#9;p.CanCollide = false
&#9;&#9;p.Parent = part.Parent
&#9;&#9;local m = Instance.new(&quot;BlockMesh&quot;)
&#9;&#9;m.Parent = p
&#9;&#9;m.Offset = relpos(pos,part)
&#9;&#9;local d = Instance.new(&quot;Decal&quot;)
&#9;&#9;d.Face = surface
&#9;&#9;d.Texture = id
&#9;&#9;d.Parent = p
&#9;&#9;game:GetService(&quot;Debris&quot;):AddItem(p,1200)
&#9;&#9;if (surface == Enum.NormalId.Top or surface == Enum.NormalId.Bottom) then
&#9;&#9;&#9;m.Scale = Vector3.new(size,0,size)
&#9;&#9;end
&#9;&#9;if (surface == Enum.NormalId.Left or surface == Enum.NormalId.Right) then
&#9;&#9;&#9;m.Scale = Vector3.new(0,size,size)
&#9;&#9;end
&#9;&#9;if (surface == Enum.NormalId.Front or surface == Enum.NormalId.Back) then
&#9;&#9;&#9;m.Scale = Vector3.new(size,size,0)
&#9;&#9;end
&#9;&#9;if (not part.Anchored) then
&#9;&#9;&#9;p.Anchored = false
&#9;&#9;&#9;local w = Instance.new(&quot;Weld&quot;)
&#9;&#9;&#9;w.Part0 = part
&#9;&#9;&#9;w.Part1 = p
&#9;&#9;&#9;w.Parent = part
&#9;&#9;end
&#9;end
end

shots = 25
maxshots = shots
baseName = Tool.Name

clicks = 0
time = 0
damage = 100
function onButton1Down(mouse)
&#9;if (not moved) then
&#9;&#9;clicks = clicks + 1
&#9;&#9;time = time + 7
&#9;&#9;while time &gt; 0 do
&#9;&#9;&#9;wait()
&#9;&#9;&#9;time = time - 1
&#9;&#9;end

&#9;&#9;if (not enabled) then return end
&#9;&#9;enabled = false

&#9;&#9;print(clicks)
&#9;&#9;if (clicks == 1) then 
&#9;&#9;&#9;damage = 5
&#9;&#9;&#9;animate(&quot;slash&quot;) 
&#9;&#9;&#9;clicks = 0 
&#9;&#9;end
&#9;&#9;if (clicks == 2) then 
&#9;&#9;&#9;damage = 20
&#9;&#9;&#9;animate(&quot;slash2&quot;) 
&#9;&#9;&#9;clicks = 0
&#9;&#9;end
&#9;&#9;if (clicks == 3) then 
&#9;&#9;&#9;damage = 80
&#9;&#9;&#9;animate(&quot;stab&quot;) 
&#9;&#9;&#9;clicks = 0
&#9;&#9;end
&#9;&#9;clicks = 0
&#9;&#9;damage = 2
&#9;&#9;enabled = true
&#9;else
&#9;&#9;local targ = mouse.Target
&#9;&#9;if (targ == nil) then return end
&#9;&#9;if (not enabled) then return end
&#9;&#9;enabled = false

&#9;&#9;if (shots &lt; 1) then
&#9;&#9;&#9;enabled = true
&#9;&#9;&#9;Tool.Handle.Fail:play()
&#9;&#9;&#9;return
&#9;&#9;end

&#9;&#9;shots = shots - 1
&#9;&#9;Tool.Name =  &quot;Gunblade [&quot; .. shots .. &quot;]&quot;


&#9;&#9;Hit = CFrame.new(mouse.hit.p)
&#9;&#9;local P = Instance.new(&quot;Part&quot;) 
&#9;&#9;P.Name = &quot;BulletTrail&quot; 
&#9;&#9;local Place0 = Tool.Handle.CFrame * CFrame.new(0,1.5,0.2)
&#9;&#9;P.formFactor = 0 
&#9;&#9;P.Size = Vector3.new(1,1,(Place0.p - Hit.p).magnitude) 
&#9;&#9;P.CFrame = CFrame.new((Place0.p + Hit.p)/2,Place0.p) 
&#9;&#9;P.Parent = script.Parent.Parent
&#9;&#9;P.BrickColor = BrickColor.Yellow()
&#9;&#9;P.Anchored = true 
&#9;&#9;P.CanCollide = false
&#9;&#9;local m = Instance.new(&quot;BlockMesh&quot;)
&#9;&#9;m.Scale = Vector3.new(0.1,0.1,1)
&#9;&#9;m.Parent = P
&#9;&#9;local remScript = script.Parent.RemScript:clone()
&#9;&#9;remScript.Disabled = false
&#9;&#9;remScript.Parent = P

&#9;&#9;Tool.Handle.Shot:play()
&#9;&#9;Tool.Handle.Charge:play()
&#9;&#9;mouse.Icon = &quot;rbxasset://textures\\GunWaitCursor.png&quot;

&#9;&#9;local a = targ.Parent:children()
&#9;&#9;local b = 0
&#9;&#9;hitHum = false
&#9;&#9;for b = 1, #a do 
&#9;&#9;&#9;if (a[b]:IsA(&quot;Humanoid&quot;)) then 
&#9;&#9;&#9;&#9;a[b].Health = a[b].Health - 500
&#9;&#9;&#9;&#9;local tag = Instance.new(&quot;ObjectValue&quot;)
&#9;&#9;&#9;&#9;tag.Value = game:GetService(&quot;Players&quot;).LocalPlayer
&#9;&#9;&#9;&#9;tag.Name = &quot;creator&quot;
&#9;&#9;&#9;&#9;tag.Parent = a[b]
&#9;&#9;&#9;&#9;hitHum = true 
&#9;&#9;&#9;end 
&#9;&#9;end

&#9;&#9;if (hitHum and targ.Parent ~= workspace) then
&#9;&#9;&#9;local parent = targ.Parent.Parent
&#9;&#9;&#9;targ.Parent.Parent = Tool.Parent
&#9;&#9;&#9;local targ2 = mouse.Target
&#9;&#9;&#9;local pos = mouse.Hit.p
&#9;&#9;&#9;local surface = mouse.TargetSurface
&#9;&#9;&#9;targ.Parent.Parent = parent
&#9;&#9;&#9;texture(targ2,pos,surface,splat_id,2)
&#9;&#9;&#9;texture(targ,mouse.Hit.p,mouse.TargetSurface,splat_id,0.5)
&#9;&#9;else
&#9;&#9;&#9;texture(targ,mouse.Hit.p,mouse.TargetSurface,hole_id,0.5)
&#9;&#9;end

&#9;&#9;local p = Instance.new(&quot;Part&quot;)
&#9;&#9;p.formFactor = 0
&#9;&#9;p.Size = Vector3.new(2,2,2)
&#9;&#9;p.CFrame = mouse.Hit
&#9;&#9;p.Anchored = false
&#9;&#9;p.Transparency = 1
&#9;&#9;p.Parent = mouse.Target.Parent
&#9;&#9;p.Velocity = CFrame.new(Tool.Parent.Torso.Position,mouse.Hit.p).lookVector * 300

&#9;&#9;local shell = Instance.new(&quot;Part&quot;)
&#9;&#9;shell.Name = &quot;Shell&quot;
&#9;&#9;shell.CFrame = Tool.Handle.CFrame * CFrame.new(1,0,0)
&#9;&#9;shell.Parent = workspace
&#9;&#9;shell.BrickColor = BrickColor.Yellow()
&#9;&#9;shell.Reflectance = 0.5
&#9;&#9;shell.Size = Vector3.new(1,1.2,2)
&#9;&#9;shell.Anchored = true
&#9;&#9;shell.Locked = true
&#9;&#9;local mesh = Instance.new(&quot;BlockMesh&quot;)
&#9;&#9;mesh.Scale = Vector3.new(0.05, 0.05, 0.1)
&#9;&#9;mesh.Parent = shell
&#9;&#9;Tool.Handle.Bounce:clone().Parent = shell
&#9;&#9;local lv = (Tool.Handle.CFrame * CFrame.Angles(0,math.pi / -2,0)).lookVector * 10
&#9;&#9;local co = coroutine.create(physShell)
&#9;&#9;coroutine.resume(co,shell,lv,300)

&#9;&#9;animate(&quot;shot&quot;)
&#9;&#9;p.Parent = nil
&#9;&#9;enabled = true
&#9;&#9;mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
&#9;end
end

moved = false

function onKey(key)
&#9;key = tostring(key)
&#9;key = key:lower()
&#9;if (not enabled) then return end
&#9;if (key == &quot;m&quot;) then
&#9;&#9;moved = not moved
&#9;&#9;if (moved) then
&#9;&#9;&#9;rs = Tool.Parent.Torso[&quot;Right Shoulder&quot;]
&#9;&#9;&#9;rs.C0 = rs.C0 * CFrame.Angles(0,0.5,0)
&#9;&#9;&#9;Tool.Grip = CFrame.new(0,0,-0.5) * CFrame.Angles(math.pi/2,0.5,0)
&#9;&#9;else
&#9;&#9;&#9;rs = Tool.Parent.Torso[&quot;Right Shoulder&quot;]
&#9;&#9;&#9;rs.C0 = rs.C0 * CFrame.Angles(0,-0.5,0)
&#9;&#9;&#9;Tool.Grip = CFrame.new()
&#9;&#9;end
&#9;end
&#9;if (key == &quot;r&quot;) then animate(&quot;reload&quot;) end
end

function onEquippedLocal(mouse)
&#9;if mouse == nil then
&#9;&#9;print(&quot;Mouse not found&quot;)
&#9;&#9;return 
&#9;end
&#9;mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
&#9;mouse.Button1Down:connect(function() onButton1Down(mouse) end)
&#9;mouse.KeyDown:connect(onKey)
&#9;Tool.Equip.Value = true
end

function onUnS()
&#9;Tool.Equip.Value = false
&#9;if (moved) then
&#9;&#9;rs = game:GetService(&quot;Players&quot;).LocalPlayer.Character.Torso[&quot;Right Shoulder&quot;]
&#9;&#9;rs.C0 = rs.C0 * CFrame.Angles(0,-0.5,0)
&#9;&#9;Tool.Grip = CFrame.new()
&#9;&#9;moved = false
&#9;end
end

Tool.Equipped:connect(onEquippedLocal)
Tool.Unequipped:connect(onUnS)

function onHit(p)
&#9;if (p == nil) then return end
&#9;if (p.Parent == nil) then return end
&#9;if (p.Parent == Tool.Parent) then return end

&#9;snd = Tool.Handle.Hit
&#9;if (not snd.IsPlaying) then snd:play() end

&#9;local a = p.Parent:children()
&#9;local b = 0
&#9;local hum = nil
&#9;for b = 1, #a do
&#9;&#9;if (a[b]:IsA(&quot;Humanoid&quot;)) then
&#9;&#9;&#9;hum = a[b]
&#9;&#9;end
&#9;end
&#9;if (hum) then
&#9;&#9;hum.Health = hum.Health - damage

&#9;&#9;snd = Tool.Handle.Ouch
&#9;&#9;if (not snd.IsPlaying) then snd:play() end
&#9;end
end

Tool.Damage.Touched:connect(onHit)
