		<Item class="Script" referent="RBX6238">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">bok38&apos;s Admin Commands</string>
				<ProtectedString name="Source">-- Here are your Admin Commands, hope this is what you wanted! If you need anything else contact me! This admin script is one that I already had, I modified it to your needs. If it needs to be modified any more, tell me what it needs.
adminlist = {&quot;888daniel888&quot;}-- The people that you want to be able to have admin here.
bannedlist = {&quot;&quot;}--The Bannedlist. Selfexplanitory.
texture = &quot;example www.roblox.com/blahblahblah&quot;--If you have a shirt you want people to buy to get your admin, put the link to the shirt here.
 
disableBan = false --Set to &apos;true&apos; if you don&apos;t want the &quot;ban/&quot; command to be able to be used by anyone, including you.
disableAdmin = false --Set to &apos;true&apos; if you don&apos;t want the &quot;admin/&quot; command to be able to be used by anyone, including you.
disableKick = false --&quot;                                 &quot;
disableInsert = false --&quot;                                 &quot;
disableLoopKill = false
disableScriptBuilder = false --&quot;                             &quot;
