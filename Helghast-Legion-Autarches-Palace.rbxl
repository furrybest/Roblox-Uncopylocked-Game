						<ProtectedString name="Source">local prev 
local parts = script.Parent:GetChildren() 
for i = 1,#parts do 
if (parts[i].className == &quot;Part&quot;) or (parts[i].className == &quot;WedgePart&quot;) then 
if (prev ~= nil)then 
