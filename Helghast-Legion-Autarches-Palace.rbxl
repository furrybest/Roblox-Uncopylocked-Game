			<Item class="LocalScript" referent="RBX6279">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">LocalScript</string>
					<ProtectedString name="Source">local c0 = nil
local c1 = nil
name = &quot;Right&quot;
local s = nil
local w = nil
local t = nil
local c = nil
function Click(mouse)
player = script.Parent.Parent.Parent
char = player.Character
if char ~= nil then
torso = char:FindFirstChild(&quot;Torso&quot;)
arm = char:FindFirstChild(name..&quot; Arm&quot;)
head = char:FindFirstChild(&quot;Head&quot;)
if torso ~= nil and arm ~= nil and head ~=nil then
shoulder = torso:FindFirstChild(name..&quot; Shoulder&quot;)
neck = torso:FindFirstChild(&quot;Neck&quot;)
if shoulder ~= nil then
c0 = shoulder.C0
c1 = shoulder.C1
s = shoulder:clone()
shoulder.Parent = nil
local weld = Instance.new(&quot;Weld&quot;)
local yes = true
if yes then
yes = false
w = weld
t = torso
c = char
weld.Part0 = torso
weld.Parent = torso
weld.Part1 = arm
weld.C1 = CFrame.new(-.7,-.3,.35) * CFrame.fromEulerAnglesXYZ(math.rad(270), math.rad(-80), math.rad(-5))
torso.Neck.C1 = CFrame.new(0,-.5,0) * CFrame.fromEulerAnglesXYZ(math.rad(-75), math.rad(0), math.rad(180))
end
end
end
end
end
function Unclick(mouse)
torso.Neck.C1 = CFrame.new(0,-.5,0) * CFrame.fromEulerAnglesXYZ(math.rad(-90), math.rad(0), math.rad(180))
w.Parent = nil
s.Parent = t
s.C0 = c0
s.C1 = c1
local ani = char:FindFirstChild(&quot;Animate&quot;)
if ani ~= nil then
local d = ani:clone()
ani.Parent = nil
wait()
ani = d
ani.Parent = c
end
end

function Select(mouse)
mouse.Button1Down:connect(function() Click(mouse) end)
mouse.Button1Up:connect(function() Unclick(mouse) end)
end
script.Parent.Selected:connect(Select)</ProtectedString>
