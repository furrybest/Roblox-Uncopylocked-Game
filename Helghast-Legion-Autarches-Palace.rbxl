			<Item class="StringValue" referent="RBX966">
				<Properties>
					<string name="Name">TimeCtrl</string>
					<string name="Value">00:00</string>
				</Properties>
				<Item class="Script" referent="RBX967">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">while true do
wait()
if _G.Minutes and _G.Seconds then
Min = tostring(_G.Minutes)
Sec = tostring(_G.Seconds)
if _G.Seconds &lt; 10 and _G.Minutes &gt; 10 then
script.Parent.Value = Min..&quot;:0&quot; ..Sec
else
if _G.Seconds &gt; 10 and _G.Minutes &gt;10 then
script.Parent.Value = _G.Minutes..&quot;:&quot;.._G.Seconds
else
if _G.Minutes &lt; 10 and _G.Seconds &gt; 10 then
script.Parent.Value = &quot;0&quot;..Min..&quot;:&quot; ..Sec
else
if _G.Minutes &lt; 10 and _G.Seconds &lt; 10 then
script.Parent.Value = &quot;0&quot;..Min..&quot;:0&quot; ..Sec
end
end
end
end
end
end
</ProtectedString>
					</Properties>
				</Item>
			</Item>
			<Item class="Script" referent="RBX968">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">TimeController</string>
					<ProtectedString name="Source">while true do
wait()
pcall(function() 
if script.Parent.ControlColor.Value == game.Teams.Raiders.TeamColor then 
game.Lighting.Timer.Parent = script.Parent
else
if script.Parent.ControlColor.Value == game.Teams.Vaktovians.TeamColor then
if script.Parent:findFirstChild(&quot;Timer&quot;) then
Obj = script.Parent:findFirstChild(&quot;Timer&quot;)
Obj.Parent = game.Lighting
_G.Seconds = 00
_G.Minutes = 00
end
end
end
end)
end</ProtectedString>
				</Properties>
			</Item>
			<Item class="Script" referent="RBX969">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Holder</string>
					<ProtectedString name="Source">Scr = script.Parent.ControlColor

script.Parent.ControlColor.Changed:connect(function()
&#9;if Scr.Value == game.Teams.Vaktovians.TeamColor then
&#9;&#9;script.Parent.CtrlValue.Value = &quot;HL:Grey Knights&quot;,&quot;Helghast Legion&quot;,&quot;Autarch&quot;
&#9;&#9;else
&#9;&#9;script.Parent.CtrlValue.Value = &quot;Raiders&quot;
&#9;end
end)

</ProtectedString>
				</Properties>
			</Item>
