		<Item class="Script" referent="RBX862">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Ban Guests</string>
				<ProtectedString name="Source">function Msg(type, message, time, parent)
&#9;m = Instance.new(type)
&#9;m.Parent = parent
&#9;m.Text = message
&#9;wait(time)
&#9;m:remove()
end

function removeguest(guest)
&#9;Msg(&quot;Message&quot;, &quot;Sorry &quot; ..guest.Name.. &quot; but I had to.&quot;, 3, guest)
&#9;guest:remove()
end

function alert(players)
&#9;Msg(&quot;Message&quot;, &quot;Guest free zone&quot;, 2, players)
end

function onPlayersEntered(tobechecked)
&#9;if string.find((tobechecked.Name),&quot;Guest &quot;) then
&#9;&#9;removeguest(tobechecked)
&#9;else alert(tobechecked)
&#9;end
end

game.Players.ChildAdded:connect(onPlayersEntered)
</ProtectedString>
			</Properties>
