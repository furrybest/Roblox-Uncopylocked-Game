				<string name="Name">Remove Hat when Dropped Script!</string>
				<ProtectedString name="Source">while true do
wait(0)
local c = game.Workspace:GetChildren()
for i = 1, #c do
if (c[i].className == &quot;Hat&quot;) then
c[i]:Remove()
end
end
end
</ProtectedString>
