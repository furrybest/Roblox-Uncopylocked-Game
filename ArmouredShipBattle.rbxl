								<float name="P">3000</float>
								<CoordinateFrame name="cframe">
									<X>-2</X>
									<Y>6.4000001</Y>
									<Z>1004</Z>
									<R00>1</R00>
									<R01>0</R01>
									<R02>0</R02>
									<R10>0</R10>
									<R11>1</R11>
