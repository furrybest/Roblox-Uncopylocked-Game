									<Content name="LinkedSource"><null></null></Content>
									<string name="Name">ParentScript</string>
									<ProtectedString name="Source">seat = script.Parent.VehicleSeat

function onChildAdded(part)
	if part.className == &quot;Weld&quot; then
		local torso = part.Part1
		if torso ~= nil then
			local parent = torso.Parent
			if parent ~= nil then
				script.Parent.Parent = parent
				script.Parent.Base.Anchored = false
			end
		end
	end
end

seat.ChildAdded:connect(onChildAdded)
</ProtectedString>
