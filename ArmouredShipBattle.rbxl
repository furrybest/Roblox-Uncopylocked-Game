								<float name="P">200</float>
								<CoordinateFrame name="cframe">
									<X>0</X>
									<Y>0</Y>
									<Z>0</Z>
									<R00>1</R00>
									<R01>0</R01>
									<R02>0</R02>
									<R10>0</R10>
									<R11>1</R11>
									<R12>0</R12>
									<R20>0</R20>
									<R21>0</R21>
									<R22>1</R22>
								</CoordinateFrame>
								<Vector3 name="maxTorque">
									<X>8.99999949e+009</X>
									<Y>0</Y>
									<Z>8.99999949e+009</Z>
								</Vector3>
