			<Item class="Script" referent="RBX5617">
				<Properties>
					<bool name="Archivable">true</bool>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Paintball</string>
					<ProtectedString name="Source">ball = script.Parent
damage = 9999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999



function onTouched(hit)
	local humanoid = hit.Parent:findFirstChild(&quot;Humanoid&quot;)
	

	if humanoid ~= nil then
		local char = game.Players:playerFromCharacter(humanoid.Parent)
		if char ~= nil then 
		if char.TeamColor == ball.TeamColor.Value and char.Neutral ~= true then return end
		tagHumanoid(humanoid)
		humanoid:TakeDamage(damage)
		wait(2)
		untagHumanoid(humanoid)
		else
		tagHumanoid(humanoid)
		humanoid:TakeDamage(damage)
		wait(2)
		untagHumanoid(humanoid)
		end
	end

	connection:disconnect()
	ball.Parent = nil

end

function tagHumanoid(humanoid)
	-- todo: make tag expire
	local tag = ball:findFirstChild(&quot;creator&quot;)
	if tag ~= nil then
		local new_tag = tag:clone()
		new_tag.Parent = humanoid
	end
end


function untagHumanoid(humanoid)
	if humanoid ~= nil then
		local tag = humanoid:findFirstChild(&quot;creator&quot;)
		if tag ~= nil then
			tag.Parent = nil
		end
	end
end

connection = ball.Touched:connect(onTouched)

wait(1)
ball.Parent = nil
</ProtectedString>
				</Properties>
			</Item>
			<Item class="NumberValue" referent="RBX5618">
				<Properties>
					<bool name="Archivable">true</bool>
					<string name="Name">Spread</string>
