						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Health</string>
						<ProtectedString name="Source">function onTouched(hit)
	if hit.Parent.Humanoid ~= nil then
		hit.Parent.Humanoid.MaxHealth = (150)
		hit.Parent.Humanoid.Health = (145)
	end
	if hit.Parent.Humanoid == nil then return end
end

script.Parent.Touched:connect(onTouched)
</ProtectedString>
					</Properties>
					<Item class="Timer" referent="RBX4486">
						<Properties>
							<bool name="Archivable">true</bool>
							<string name="Name">y1wq209hw</string>
						</Properties>
					</Item>
				</Item>
				<Item class="Script" referent="RBX4487">
					<Properties>
						<bool name="Archivable">true</bool>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">ForceField</string>
						<ProtectedString name="Source">function onTouched(hit)
	if hit.Parent.Humanoid ~= nil then
		ff = Instance.new(&quot;ForceField&quot;)
		ff.Parent = hit.Parent
		wait(3)
		hit.Parent.ForceField:Remove()
	end
	if hit.Parent.Humanoid == nil then return end
end

script.Parent.Touched:connect(onTouched)
</ProtectedString>
