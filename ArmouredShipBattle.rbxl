								<CoordinateFrame name="Grip">
									<X>-1</X>
									<Y>-0.75</Y>
									<Z>0.25</Z>
									<R00>0</R00>
									<R01>0</R01>
									<R02>1</R02>
									<R10>0</R10>
									<R11>1</R11>
									<R12>-0</R12>
									<R20>-1</R20>
									<R21>0</R21>
