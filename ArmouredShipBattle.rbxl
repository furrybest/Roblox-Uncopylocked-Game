wait(0.2)
script.Parent.Transparency = 0.8
script.Parent.Mesh.Scale = Vector3.new(       30,	3.2,	40	)
wait(0.2)
script.Parent.Transparency = 0.9
script.Parent.Mesh.Scale = Vector3.new(       34,	3,	46	)
wait(0.2)
script.Parent:remove()
