								<Item class="Script" referent="RBX3074">
									<Properties>
										<bool name="Archivable">true</bool>
										<bool name="Disabled">false</bool>
										<Content name="LinkedSource"><null></null></Content>
										<string name="Name">Script</string>
										<ProtectedString name="Source">repeat wait() until script.Parent.Parent.Vehicle.Value~=nil

db=false
held=false

v=script.Parent.Parent.Vehicle
f=script.Parent
guns=script.Parent.Machine

function fireguns()
v1=v.Value.Gun1Bullet:clone()
vel=Instance.new(&quot;BodyVelocity&quot;)
vel.Parent=v1
v1.Velocity=v1.CFrame.lookVector*500
vel.velocity=v1.Velocity
v1.Anchored=false
--v1.CanCollide=true
v1.Transparency=0
v1.Damage.Disabled=false
v1.Parent=workspace
print(&quot;Created bullet&quot;)
v.Value.Gun1Bullet.Fire:Play()
end


function gunsdown()
held=true
while held==true do
fireguns()
print(&quot;Fire bullet&quot;)
wait(0.1)
end
end

function gunsup()
held=false
print(&quot;up&quot;)
end


guns.MouseButton1Down:connect(gunsdown)
guns.MouseButton1Up:connect(gunsup)
guns.MouseLeave:connect(function() gunsup() end)




</ProtectedString>
