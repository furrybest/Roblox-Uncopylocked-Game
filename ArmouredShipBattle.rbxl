						<Item class="Script" referent="RBX2710">
							<Properties>
								<bool name="Archivable">true</bool>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">EngineScript</string>
								<ProtectedString name="Source">function OnF()
	script.Parent.Engine.Pitch = (script.Parent.Parent.VehicleSeat.MaxSpeed / 10) + 2.5
	script.Parent.Engine:play()
end

function OnB()
	script.Parent.Engine.Pitch = -(script.Parent.Parent.VehicleSeat.MaxSpeed / 10) + 2.5
	script.Parent.Engine:play()
end

function Off()
	script.Parent.Engine:stop()
end

function Check()
	if script.Parent.Parent.VehicleSeat.MaxSpeed &gt; 0 then
		OnF()
	elseif script.Parent.Parent.VehicleSeat.MaxSpeed &lt; 0 then
		OnB()
	elseif script.Parent.Parent.VehicleSeat.MaxSpeed == 0 then
		Off()
	end
end

script.Parent.Parent.VehicleSeat.Changed:connect(Check)
</ProtectedString>
							</Properties>
						</Item>
