											<ProtectedString name="Source">On=false 
function onClicked() 
if On then On=false else 
On=true 
while On do 
	
	script.Parent.Parent.A.BrickColor = BrickColor.new(&quot;Bright blue&quot;) 
	script.Parent.Parent.A.Reflectance=0 
	
	script.Parent.Parent.B.BrickColor = BrickColor.new(&quot;Bright blue&quot;) 
	script.Parent.Parent.B.Reflectance=0 
	
	script.Parent.Parent.C.BrickColor = BrickColor.new(&quot;Bright blue&quot;) 
	script.Parent.Parent.C.Reflectance=0 
	
	script.Parent.Parent.D.BrickColor = BrickColor.new(&quot;Bright red&quot;) 
	script.Parent.Parent.D.Reflectance=0 
	
	script.Parent.Parent.E.BrickColor = BrickColor.new(&quot;Bright red&quot;) 
	script.Parent.Parent.E.Reflectance=0 
	
	script.Parent.Parent.F.BrickColor = BrickColor.new(&quot;Bright red&quot;) 
	script.Parent.Parent.F.Reflectance=0 
	
	wait(0.2) 
	
	script.Parent.Parent.A.BrickColor = BrickColor.new(&quot;Bright red&quot;) 
	script.Parent.Parent.A.Reflectance=0 
	
	script.Parent.Parent.B.BrickColor = BrickColor.new(&quot;Bright red&quot;) 
	script.Parent.Parent.B.Reflectance=0 
	
	script.Parent.Parent.C.BrickColor = BrickColor.new(&quot;Bright red&quot;) 
	script.Parent.Parent.C.Reflectance=0 
	
	script.Parent.Parent.D.BrickColor = BrickColor.new(&quot;Bright blue&quot;) 
	script.Parent.Parent.D.Reflectance=1 
	
	script.Parent.Parent.E.BrickColor = BrickColor.new(&quot;Bright blue&quot;) 
	script.Parent.Parent.E.Reflectance=0 
	
	script.Parent.Parent.F.BrickColor = BrickColor.new(&quot;Bright blue&quot;) 
	script.Parent.Parent.F.Reflectance=0 
	
	wait(0.2) 
	
	script.Parent.Parent.A.BrickColor = BrickColor.new(&quot;Bright blue&quot;) 
	script.Parent.Parent.A.Reflectance=1 
	
	script.Parent.Parent.B.BrickColor = BrickColor.new(&quot;Bright blue&quot;) 
	script.Parent.Parent.B.Reflectance=0 
	
	script.Parent.Parent.C.BrickColor = BrickColor.new(&quot;Bright blue&quot;) 
