						<Item class="Script" referent="RBX5333">
							<Properties>
								<bool name="Archivable">true</bool>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">Pickup</string>
								<ProtectedString name="Source">script.Parent.ChildAdded:connect(function(w)
print(&quot;ChildAdded&quot;)
if w.className==&quot;Weld&quot; then
print(&quot;IsAWeld&quot;)
if w.Name==&quot;SeatWeld&quot; then
print(&quot;IsASeatWeld&quot;)
if w.Part1.Parent:findFirstChild(&quot;Humanoid&quot;)~=nil then
print(&quot;IsAHumanoid&quot;)
pl=game.Players:GetPlayerFromCharacter(w.Part1.Parent)
if pl~=nil then
print(&quot;IsAPlayer&quot;)
if pl.PlayerGui:findFirstChild(&quot;VehicleGui&quot;)~=nil then
print(&quot;found vehicle gui - deleting&quot;)
pl.PlayerGui:findFirstChild(&quot;VehicleGui&quot;).Parent=nil
print(&quot;deleted&quot;)
else
print(&quot;no gui found - adding&quot;)
newgui=script.Parent.VehicleGui:clone()
newgui.Parent=pl.PlayerGui
newgui.Vehicle.Value=script.Parent.Parent

print(&quot;added&quot;)
end
end
end
end
end
end)

script.Parent.ChildRemoved:connect(function(w)
print(&quot;ChildRemoved&quot;)
if w.className==&quot;Weld&quot; then
print(&quot;IsAWeld&quot;)
if w.Name==&quot;SeatWeld&quot; then
print(&quot;IsASeatWeld&quot;)
if w.Part1.Parent:findFirstChild(&quot;Humanoid&quot;)~=nil then
print(&quot;IsAHumanoid&quot;)
pl=game.Players:GetPlayerFromCharacter(w.Part1.Parent)
if pl~=nil then
print(&quot;IsAPlayer&quot;)
if pl.PlayerGui:findFirstChild(&quot;VehicleGui&quot;)~=nil then
print(&quot;found vehicle gui - deleting&quot;)
pl.PlayerGui:findFirstChild(&quot;VehicleGui&quot;).Parent=nil
print(&quot;deleted&quot;)
else
print(&quot;no gui found - wierd...&quot;)
end
end
end
end
end
end)

</ProtectedString>
							</Properties>
						</Item>
						<Item class="Script" referent="RBX5334">
							<Properties>
								<bool name="Archivable">true</bool>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">SteerScript</string>
								<ProtectedString name="Source">MP = script.Parent.Parent.Part1
MP2 = script.Parent.Parent.Part2
Height = 15

while true do
wait()

if script.Parent.Steer == 1 then
MP.BodyGyro.cframe = MP.BodyGyro.cframe*CFrame.Angles(0,math.rad(-2),0)
print(&quot;Right&quot;)
end

if script.Parent.Steer == -1 then
MP.BodyGyro.cframe = MP.BodyGyro.cframe*CFrame.Angles(0,math.rad(2),0)
print(&quot;Left&quot;)
end 


if script.Parent.Throttle == 1 then
if Height ~= 30 then 
Height = Height + 1
MP2.BodyGyro.cframe = MP2.BodyGyro.cframe*CFrame.Angles(math.rad(2),0,0)
end end


if script.Parent.Throttle == -1 then
if Height ~= 1 then
Height = Height - 1
MP2.BodyGyro.cframe = MP2.BodyGyro.cframe*CFrame.Angles(math.rad(-2),0,0)
end end

end










</ProtectedString>
							</Properties>
						</Item>
						<Item class="ScreenGui" referent="RBX5335">
							<Properties>
								<bool name="Archivable">true</bool>
								<string name="Name">VehicleGui</string>
							</Properties>
							<Item class="Frame" referent="RBX5336">
								<Properties>
									<bool name="Active">false</bool>
									<bool name="Archivable">true</bool>
									<Color3 name="BackgroundColor3">4281545523</Color3>
									<float name="BackgroundTransparency">0</float>
									<Color3 name="BorderColor3">4278190080</Color3>
									<int name="BorderSizePixel">1</int>
									<bool name="Draggable">false</bool>
									<string name="Name">Frame</string>
									<UDim2 name="Position">
										<XS>0.460000008</XS>
										<XO>0</XO>
										<YS>0.675000012</YS>
										<YO>0</YO>
									</UDim2>
									<UDim2 name="Size">
										<XS>0.140000001</XS>
										<XO>0</XO>
										<YS>0.13000001</YS>
										<YO>0</YO>
									</UDim2>
									<token name="SizeConstraint">0</token>
									<token name="Style">0</token>
									<bool name="Visible">true</bool>
									<int name="ZIndex">1</int>
								</Properties>
								<Item class="Script" referent="RBX5337">
									<Properties>
										<bool name="Archivable">true</bool>
										<bool name="Disabled">false</bool>
										<Content name="LinkedSource"><null></null></Content>
										<string name="Name">Script</string>
										<ProtectedString name="Source">repeat wait() until script.Parent.Parent.Vehicle.Value~=nil

db=false
held=false

v=script.Parent.Parent.Vehicle
f=script.Parent
guns=script.Parent.Machine

function fireguns()
v1=v.Value.Gun1Bullet:clone()
vel=Instance.new(&quot;BodyVelocity&quot;)
vel.Parent=v1
v1.Velocity=v1.CFrame.lookVector*500
vel.velocity=v1.Velocity
v1.Anchored=false
--v1.CanCollide=true
v1.Transparency=0
v1.Damage.Disabled=false
v1.Parent=workspace
print(&quot;Created bullet&quot;)
v.Value.Gun1Bullet.Fire:Play()
end


function gunsdown()
held=true
while held==true do
fireguns()
print(&quot;Fire bullet&quot;)
wait(0.1)
end
end

function gunsup()
held=false
print(&quot;up&quot;)
end


guns.MouseButton1Down:connect(gunsdown)
guns.MouseButton1Up:connect(gunsup)
guns.MouseLeave:connect(function() gunsup() end)




</ProtectedString>
