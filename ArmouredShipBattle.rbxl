					<Item class="Script" referent="RBX4504">
						<Properties>
							<bool name="Archivable">true</bool>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">iSwallowedYourC00K3HZAndYouCantGetThemNowCauseTheyreInMahStomachLolFarts</string>
							<ProtectedString name="Source">if game:findFirstChild(&quot;NetworkServer&quot;)~=nil then 
	function onJoined(player)
		local noob = game.Workspace:findFirstChild(player.Name)
		if noob~=nil then 
			local h = noob.Parent:findFirstChild(&quot;Humanoid&quot;)
			if h~=nil then 
				for i = 1,3 do 
					h.Health = 1200
					wait(5)
				end 
			end 
		end 
	end 
end </ProtectedString>
