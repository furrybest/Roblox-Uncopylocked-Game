script.Parent.Transparency = 0.5
script.Parent.Mesh.Scale = Vector3.new(       18,	3.8,	22	)
wait(0.2)
script.Parent.Transparency = 0.6
script.Parent.Mesh.Scale = Vector3.new(       22,	3.6,	28	)
