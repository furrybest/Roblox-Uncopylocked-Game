							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script</string>
							<ProtectedString name="Source">local v = 200
function onTouched(hit)
if hit.Parent:findFirstChild(&quot;Torso&quot;) and not hit.Parent:findFirstChild(&quot;AntiGrief&quot;) then
hit.Parent.Torso.Velocity = v * (script.Parent.CFrame.lookVector)	
else
if not hit.Anchored then
hit.Velocity = v * (script.Parent.CFrame.lookVector)
end
end
end
script.Parent.Touched:connect(onTouched)
</ProtectedString>
