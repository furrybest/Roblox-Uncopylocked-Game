									<ProtectedString name="Source">h = Instance.new(&quot;BodyPosition&quot;)
h.Name = &quot;Hover&quot;
h.D = 1.25e+003
h.P = 1e+004
h.maxForce = Vector3.new(0, 1e+006, 0)
h.position = Vector3.new(0, 33, 0)

g = Instance.new(&quot;BodyGyro&quot;)
g.Name = &quot;Gyro&quot;
g.D = 500
g.P = 3e+003
g.maxTorque = Vector3.new(4e+005, 0, 4e+005)

function onClicked()
if script.Parent:findFirstChild(&quot;Hover&quot;) ~= nil then
script.Parent.Hover:Remove()
script.Parent.Gyro:Remove()
script.Parent.BrickColor = BrickColor.new(&quot;Black&quot;)
script.Parent.Reflectance = 0.2
else
h.Parent = script.Parent
g.Parent = script.Parent
script.Parent.BrickColor = BrickColor.new(&quot;Pastel Blue&quot;)
script.Parent.Reflectance = 0.5
end
end
