num = 1
debounce = false

function keepRecord()
	while (game.Players.LocalPlayer == nil) do
	wait()
	end
	while (game.Players.LocalPlayer.Character == nil) do
	wait()
	end
	while (game.Players.LocalPlayer.Character:findFirstChild(&quot;Head&quot;) == nil) do
	wait()
	end
	player = game.Players.LocalPlayer
	v = player:findFirstChild(&quot;FaceRecord&quot;)
	if (v == nil) then
		V = Instance.new(&quot;NumberValue&quot;)
		V.Name = &quot;FaceRecord&quot;
		V.Parent = player
	end
end

function returnRecord()
	local player = game.Players.LocalPlayer
	char = player.Character
	Head = char.Head
	if (Head ~= nil) then
		face = Head:FindFirstChild(&quot;face&quot;)
		if (face ~= nil) then	
			v = player:findFirstChild(&quot;FaceRecord&quot;)
			if (v ~= nil) then
				if (v.Value == 1) then
					face.Texture = script.Parent.Faces.face9.Texture
					num = 9
				end
				if (v.Value == 2) then
					face.Texture = script.Parent.Faces[&quot;face&quot;..v.Value-1].Texture
					num = 1
				end 
				if (v.Value == 3) then
					face.Texture = script.Parent.Faces[&quot;face&quot;..v.Value-1].Texture
					num = 2
				end 
				if (v.Value == 4) then
					face.Texture = script.Parent.Faces[&quot;face&quot;..v.Value-1].Texture
					num = 3
				end
				if (v.Value == 5) then
					face.Texture = script.Parent.Faces[&quot;face&quot;..v.Value-1].Texture
					num = 4
				end 
				if (v.Value == 6) then
					face.Texture = script.Parent.Faces[&quot;face&quot;..v.Value-1].Texture
					num = 5
				end 
				if (v.Value == 7) then
					face.Texture = script.Parent.Faces[&quot;face&quot;..v.Value-1].Texture
					num = 6
				end 
				if (v.Value == 8) then
					face.Texture = script.Parent.Faces[&quot;face&quot;..v.Value-1].Texture
					num = 7
				end 
				if (v.Value == 9) then
					face.Texture = script.Parent.Faces[&quot;face&quot;..v.Value-1].Texture
					num = 8
				end 
			end
		end
	end
end

function onButton1Down(mouse) 
	player = game.Players.LocalPlayer
	if (player == nil) then return end
	char = player.Character
	local Head = char:findFirstChild(&quot;Head&quot;)
	v = player:findFirstChild(&quot;FaceRecord&quot;)
	if (Head ~= nil) and (v ~= nil) then
		face = Head:findFirstChild(&quot;face&quot;)
		if (face ~= nil) and (debounce == false) then
			debounce = true
			face.Texture = script.Parent.Faces[&quot;face&quot;..num].Texture
			mouse.Icon = face.Texture
			num = num+1
			wait()
			v.Value = num
			if (num == 10) then
				num = 1
				wait()
				v.Value = 1
			end
			debounce = false
		end
	end
end 

function onSelected(mouse)
	player = game.Players.LocalPlayer
	if (player == nil) then return end
	char = player.Character
	local Head = char:findFirstChild(&quot;Head&quot;)
	if (Head ~= nil) then
		face = Head:findFirstChild(&quot;face&quot;)
		if (face ~= nil) and (face.Texture ~= script.Parent.Faces.face9.Texture) then
			mouse.Icon = face.Texture
		end
		if (face ~= nil) and (face.Texture == script.Parent.Faces.face9.Texture) then
			mouse.Icon = &quot;rbxasset://textures\\face.png&quot;
		end
	end
	mouse.Button1Down:connect(function() onButton1Down(mouse) end)
end 

bin.Selected:connect(onSelected)
keepRecord()
