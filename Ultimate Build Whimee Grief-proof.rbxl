					<Item class="Script" referent="RBX2477">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script</string>
							<ProtectedString name="Source">local v = 200
function onTouched(hit)
if hit.Parent:findFirstChild(&quot;Torso&quot;) ~= nil then
hit.Parent.Torso.Velocity = v * (script.Parent.CFrame.lookVector)	
else
if hit.Anchored ~= true then
hit.Velocity = v * (script.Parent.CFrame.lookVector)
end
end
end
script.Parent.Touched:connect(onTouched)
</ProtectedString>
							<bool name="archivable">true</bool>
						</Properties>
