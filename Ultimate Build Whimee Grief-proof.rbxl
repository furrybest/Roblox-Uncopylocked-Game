							<ProtectedString name="Source">function onMove(mouse)
targ = mouse.Target
if targ==nil then return end
if targ.Locked==true then script.Parent.Parent.Parent.Message.Text = &quot;Brick Is Locked!&quot; return end
if targ.Anchored == true then
script.Parent.Parent.Parent.Message.Text = &quot;Brick Is Anchored&quot;
else
script.Parent.Parent.Parent.Message.Text = &quot;Brick Isn&apos;t Anchored&quot;
end
end

function onButton1Down(mouse)
targ = mouse.Target
if targ==nil then return end
if targ.Locked == true then return end
if targ.Anchored == true then
targ.Velocity = Vector3.new(0,0,0)
targ.RotVelocity = Vector3.new(0,0,0)
targ.Anchored = false
local v = targ.Transparency
targ.Transparency = 1
wait(0.1)
targ.Transparency = v
else
targ.Velocity = Vector3.new(0,0,0)
targ.RotVelocity = Vector3.new(0,0,0)
targ.Anchored = true
local v = targ.Transparency
targ.Transparency = 1
wait(0.1)
targ.Transparency = v
end
end

