			<Item class="Script" referent="RBX4226">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">ToolScript</string>
					<ProtectedString name="Source">bin = script.Parent
backpack = bin.Parent
player = backpack.Parent

tools = {}
currentTool = 0

function onButton1Down(mouse)
	if #tools == 0 then
		print(&quot;ERROR:  No Tools.&quot;)
		return
	end
	if currentTool ~= #tools then
		currentTool = currentTool + 1
	else
		currentTool = 1
	end
	if not tools[currentTool] then
		print(&quot;ERROR:  Tool not found.&quot;)
	end
	previousTool = currentTool - 1
	if previousTool == 0 then
		previousTool = #tools
	end
	--[[if tools[previousTool] then
		if tools[previousTool].Parent == backpack then
			tools[previousTool].Parent = bin
		else
			print(&quot;ERROR:  Previous tool already in bin.&quot;)
		end
	else
		print(&quot;ERROR:  Previous tool not found&quot;)
	end]]
	local c = backpack:GetChildren()
	for i = 1, #c do
		for n = 1, #tools do
			if string.sub(tools[n].Name,1,4) == string.sub(c[i].Name,1,4) then
				c[i].Parent = nil
			end
		end
	end
	tools[currentTool]:Clone().Parent = backpack
end

function onSelected(mouse)
	local c = bin:GetChildren()
	for i = 1, #c do
		if c[i].className == &quot;HopperBin&quot; or c[i].className == &quot;Tool&quot; then
			table.insert(tools, c[i])
		end
	end
	mouse.Button1Down:connect(onButton1Down)
end

bin.Selected:connect(onSelected)</ProtectedString>
					<bool name="archivable">true</bool>
				</Properties>
			</Item>
			<Item class="HopperBin" referent="RBX4227">
				<Properties>
					<bool name="Active">false</bool>
					<token name="BinType">0</token>
					<string name="Name">Balefire</string>
					<Content name="TextureId"><null></null></Content>
					<bool name="archivable">true</bool>
				</Properties>
				<Item class="Script" referent="RBX4228">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">print(&quot;Balefire Spell Loaded&quot;) 

local COOLDOWN = 000.1

bin = script.Parent 


function balefire(pos) 

local player = game.Players.LocalPlayer 
if player == nil or player.Character == nil then return end 

local char = player.Character.Torso 

dir = (pos - char.CFrame.p).unit 

for i = 1, 50 do 
local ex = Instance.new(&quot;Explosion&quot;) 
ex.BlastRadius = 3 
ex.BlastPressure = 8000000 
ex.Position = char.CFrame.p + (dir * 6 * i) + (dir * 7) 
ex.Parent = game.Workspace 
end 

end 


enabled = true 
function onButton1Down(mouse) 
if not enabled then 
return 
end 

local player = game.Players.LocalPlayer 
if player == nil then return end 



enabled = false 
mouse.Icon = &quot;rbxasset://textures\\GunWaitCursor.png&quot; 

-- find the best cf 
local cf = mouse.Hit 
local v = cf.lookVector 

balefire(cf.p) 

wait(COOLDOWN) 
mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot; 
enabled = true 

end 

function onSelected(mouse) 
mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot; 
mouse.Button1Down:connect(function() onButton1Down(mouse) end) 
end 

bin.Selected:connect(onSelected) 

</ProtectedString>
