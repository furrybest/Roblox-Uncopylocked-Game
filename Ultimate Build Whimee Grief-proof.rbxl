						<ProtectedString name="Source">function onButton1Down(mouse)
	if script.Parent.Value.Value == 1 then
	local Beam = Instance.new(&quot;Model&quot;)
	local Ray = script.Ray:Clone()
	local ShockWave = script.ShockWave:Clone()
	ShockWave.Grow.Disabled = false
	ShockWave.Rotate.Disabled = false
	ShockWave.Rotate.Value.ValueScript.Disabled = false
	ShockWave.ValueScript.Disabled = false
	ShockWave.Position = mouse.Hit.p + Vector3.new(0, 1, 0)
	ShockWave.Parent = Beam
	Beam.Parent = game.Workspace
	Ray.Script.Disabled = false
	Ray.Parent = Beam
	Ray.Position = mouse.Hit.p + Vector3.new(0, 1, 0)
	script.Parent.Value.Value = 0
	script.Parent.TextureId = script.Parent.Charging.LinkedSource
	mouse.Icon = &quot;http://www.roblox.com/asset/?id=2608853&quot;
	wait(10)--CoolDown
	script.Parent.Value.Value = 1
	script.Parent.TextureId = script.Parent.Normal.LinkedSource
	mouse.Icon = &quot;http://www.roblox.com/asset/?id=2608850&quot;
	end
end

function onSelected(mouse)
	if script.Parent.Value.Value == 0 then
	mouse.Icon = &quot;http://www.roblox.com/asset/?id=2608853&quot;
	mouse.Button1Down:connect(function() onButton1Down(mouse) end)
	mouse.KeyDown:connect(onKeyDown)
	end
	if script.Parent.Value.Value == 1 then
	mouse.Icon = &quot;http://www.roblox.com/asset/?id=2608850&quot;
	mouse.Button1Down:connect(function() onButton1Down(mouse) end)
	mouse.KeyDown:connect(onKeyDown)
	end
end



script.Parent.Selected:connect(onSelected)

