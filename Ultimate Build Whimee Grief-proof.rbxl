			<Item class="Script" referent="RBX1968">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Teleport Script</string>
					<ProtectedString name="Source">function Teleport(player)
if player.Parent:findFirstChild(&quot;Torso&quot;) ~= nil then
player.Parent.Torso.CFrame = CFrame.new(math.random(-6.5,6.5),45,math.random(-6.5,6.5))
end
end
script.Parent.Wall1.Touched:connect(Teleport)
script.Parent.Wall2.Touched:connect(Teleport)
script.Parent.Wall3.Touched:connect(Teleport)
script.Parent.Wall4.Touched:connect(Teleport)</ProtectedString>
					<bool name="archivable">true</bool>
				</Properties>
			</Item>
