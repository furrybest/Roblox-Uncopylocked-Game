						<ProtectedString name="Source">function onMove(mouse)
targ = mouse.Target
if targ==nil then return end
if targ.Locked==true then script.Parent.Parent.Parent.Message.Text = &quot;Brick Is Locked!&quot; return end
if targ.Anchored == true then
script.Parent.Parent.Parent.Message.Text = &quot;Brick Is Anchored&quot;
else
