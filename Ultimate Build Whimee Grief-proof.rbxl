				</Item>
			</Item>
			<Item class="HopperBin" referent="RBX4310">
				<Properties>
					<bool name="Active">false</bool>
					<token name="BinType">0</token>
					<string name="Name">Transparency</string>
					<Content name="TextureId"><null></null></Content>
					<bool name="archivable">true</bool>
				</Properties>
				<Item class="StringValue" referent="RBX4311">
					<Properties>
						<string name="Name">Value</string>
						<string name="Value">0</string>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
				<Item class="NumberValue" referent="RBX4312">
					<Properties>
						<string name="Name">Value2</string>
						<double name="Value">0</double>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
				<Item class="Script" referent="RBX4313">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">Bin = script.Parent
function onKeyDown(key)
	if (key~=nil) then
		if (key==&quot;q&quot;) then
			if Bin.Value2.Value &gt;= 10 then return end
		Bin.Value.Value = Bin.Value.Value + 0.1
		Bin.Value2.Value = Bin.Value2.Value + 1
		Bin.Parent.Parent.Message2.Text = Bin.Value.Value
		end
		if (key==&quot;e&quot;) then
			if Bin.Value2.Value &lt;= -0 then return end
		Bin.Value.Value = Bin.Value.Value - 0.1
		Bin.Value2.Value = Bin.Value2.Value - 1
		Bin.Parent.Parent.Message2.Text = Bin.Value.Value
		end
	end
end

function onMove(mouse)
targ = mouse.Target
if targ==nil then return end
script.Parent.Parent.Parent.Message.Text = &quot;Click To change Transparency&quot;
end

function onButton1Down(mouse)
targ = mouse.Target
if targ==nil then return end
targ.Transparency = Bin.Value.Value
end

function onS(mouse)
mouse.Button1Down:connect(function() onButton1Down(mouse) end)
Instance.new(&quot;Hint&quot;).Parent = script.Parent.Parent.Parent
mouse.Move:connect(function() onMove(mouse) end)
end
script.Parent.Selected:connect(onS)

function onSelected(mouse)

	b = Instance.new(&quot;Message&quot;)
	b.Parent = script.Parent.Parent.Parent
	b.Text = Bin.Value.Value
	b.Name = &quot;Message2&quot;

        h = Instance.new(&quot;Hint&quot;)
               h.Parent = script.Parent.Parent.Parent
               h.Text = &quot;press q or e to change the transparency value&quot; 
               h.Name = &quot;Hint&quot;
	wait (2)
	h:Remove()

	mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
	mouse.Button1Down:connect(function() onButton1Down(mouse) end)
	mouse.KeyDown:connect(onKeyDown)

end

function onUnS(mouse)
script.Parent.Parent.Parent.Message:Remove()
script.Parent.Parent.Parent.Message2:Remove()
end
script.Parent.Deselected:connect(onUnS)
Bin.Selected:connect(onSelected)



</ProtectedString>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
			</Item>
			<Item class="HopperBin" referent="RBX4314">
				<Properties>
					<bool name="Active">false</bool>
					<token name="BinType">0</token>
					<string name="Name">WarShip</string>
					<Content name="TextureId"><null></null></Content>
					<bool name="archivable">true</bool>
				</Properties>
				<Item class="Script" referent="RBX4315">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">plane = 0
mode = 1
phase = false

function Selected(mouse)
selected = true
Bin = script.Parent
player = Bin.Parent.Parent.Character
mouse.Button1Down:connect(function() onButton1Down(mouse) end)
mouse.Button1Up:connect(function() onButton1Up(mouse) end)
mouse.Move:connect(function() onMove(mouse) end) 
mouse.KeyDown:connect(onKeyDown)
repeat
if player:findFirstChild(&quot;Plane&quot;) ~= nil then
if player.Plane:findFirstChild(&quot;Engine&quot;) ~= nil then
if player.Plane.Engine:findFirstChild(&quot;BodyPosition&quot;) ~= nil then
player.Plane.Engine.BodyPosition.position = player.Plane.Engine.Position + (player.Plane.Engine.CFrame.lookVector*1000)
end
end
end
target = mouse.hit.p
wait()
until
selected == false
end

function onButton1Down(mouse)
if player:findFirstChild(&quot;Plane&quot;) ~= nil then
if player.Plane:findFirstChild(&quot;Engine&quot;) ~= nil then
if player.Plane.Engine:findFirstChild(&quot;BodyGyro&quot;) ~= nil then
fly = true
repeat
wait(0.1)
player.Plane.Engine.BodyGyro.cframe = CFrame.new(player.Plane.Engine.Position,mouse.hit.p)
until fly == false
end
end
end
end

function onButton1Up(mouse)
fly = false
end

function onKeyDown(key)
if (key~=nil) then


if ((key == &quot;t&quot;)) then
if player:findFirstChild(&quot;Plane&quot;) ~= nil then
player.Torso.CFrame = player.Plane.Seat.CFrame
end
end


if ((key == &quot;z&quot;)) then
if player:findFirstChild(&quot;Plane&quot;) ~= nil then
e = Instance.new(&quot;Explosion&quot;)
e.BlastRadius = 50
e.BlastPressure = 5000000
e.Position = player.Plane.Engine.Position
e.Parent = Workspace
end
end
if ((key == &quot;p&quot;)) then
if player:findFirstChild(&quot;Plane&quot;) ~= nil then
if phase == false then
phase = true
x = player.Plane:getChildren()
for i = 1,#x do
if ((x[i].className == &quot;Part&quot;) or (x[i].className == &quot;Seat&quot;)) then
x[i].CanCollide = false
x[i].Transparency = 0.4
end
end
repeat
player.Head.CanCollide = false
player.Torso.CanCollide = false
wait()
until phase == false
else
phase = false
x = player.Plane:getChildren()
for i = 1,#x do
if ((x[i].className == &quot;Part&quot;) or (x[i].className == &quot;Seat&quot;)) then
x[i].CanCollide = true
x[i].Transparency = 0
end
end
end
end
end

if ((key == &quot;e&quot;)) then
if player:findFirstChild(&quot;Plane&quot;) ~= nil then
player:findFirstChild(&quot;Plane&quot;):Remove()
end
end
if ((key == &quot;y&quot;)) then
if player:findFirstChild(&quot;Plane&quot;) ~= nil then
if player.Plane:findFirstChild(&quot;Engine&quot;) ~= nil then
if ((player.Plane.Engine:findFirstChild(&quot;BodyPosition&quot;) ~= nil) and (player.Plane.Engine:findFirstChild(&quot;BodyGyro&quot;) ~= nil)) then
player.Plane.Engine.BodyGyro.cframe = CFrame.new(player.Plane.Engine.Position,player.Plane.Engine.BodyPosition.position)
player.Plane.Engine.BodyGyro.maxTorque = Vector3.new(1,1,1)*math.huge
if plane == 1 then
player.Plane.Engine.BodyPosition.maxForce = Vector3.new(1,1,1)*5000000
end
if plane == 2 then
player.Plane.Engine.BodyPosition.maxForce = Vector3.new(1,1,1)*2500000
end
end
end
end
end
if ((key == &quot;x&quot;)) then
if player:findFirstChild(&quot;Plane&quot;) ~= nil then
if player.Plane:findFirstChild(&quot;Engine&quot;) ~= nil then
if ((player.Plane.Engine:findFirstChild(&quot;BodyPosition&quot;) ~= nil) and (player.Plane.Engine:findFirstChild(&quot;BodyGyro&quot;) ~= nil)) then
player.Plane.Engine.BodyGyro.maxTorque = Vector3.new(0,0,0)
player.Plane.Engine.BodyPosition.maxForce = Vector3.new(0,0,0)
end
end
end
end

if ((key == &quot;f&quot;)) then
if plane == 1 then
if mode == 1 then
local p = Instance.new(&quot;Part&quot;)
p.Name = &quot;Bullet&quot;
p.CanCollide = false
p.size = Vector3.new(1.2,1,1.2)
p.TopSurface = 0
p.BottomSurface = 0
p.BrickColor = BrickColor.new(&quot;Black&quot;)
p.CFrame = CFrame.new(player.Plane.Gun1.Position,target)
p.Velocity = p.CFrame.lookVector*500
p.Parent = Workspace
local v = Instance.new(&quot;BodyVelocity&quot;)
v.velocity = p.CFrame.lookVector*500
v.Parent = p
local sv = Instance.new(&quot;StringValue&quot;)
sv.Name = &quot;Player&quot;
sv.Value = script.Parent.Parent.Parent.Character.Name
sv.Parent = p
local s = script[&quot;1&quot;]:Clone()
s.Disabled = false
s.Parent = p
mode = 2 return end

if mode == 2 then
local p = Instance.new(&quot;Part&quot;)
p.Name = &quot;Bullet&quot;
p.CanCollide = false
p.size = Vector3.new(1.2,1,1.2)
p.TopSurface = 0
p.BottomSurface = 0
p.BrickColor = BrickColor.new(&quot;Black&quot;)
p.CFrame = CFrame.new(player.Plane.Gun2.Position,target)
p.Velocity = p.CFrame.lookVector*500
p.Parent = Workspace
local v = Instance.new(&quot;BodyVelocity&quot;)
v.velocity = p.CFrame.lookVector*500
v.Parent = p
local sv = Instance.new(&quot;StringValue&quot;)
sv.Name = &quot;Player&quot;
sv.Value = script.Parent.Parent.Parent.Character.Name
sv.Parent = p
local s = script[&quot;1&quot;]:Clone()
s.Disabled = false
s.Parent = p
mode = 1 return end
end
if plane == 2 then
local p = Instance.new(&quot;Part&quot;)
p.Name = &quot;Bomb&quot;
p.CanCollide = false
p.size = Vector3.new(12,1,12)
p.TopSurface = 0
p.BottomSurface = 0
