							<string name="Name">Script</string>
							<ProtectedString name="Source">print (&quot;VIP T-Shirt Door Script Loaded&quot;)

permission = { &quot;B0BBA&quot;,&quot;Sarren&quot;,&quot;xxxxAhrimxxx&quot;,&quot;Czechtech&quot; }

texture = &quot;http://www.roblox.com/asset/?id=6256477&quot;

function checkOkToLetIn(name) 
	for i = 1,#permission do 
		if (string.upper(name) == string.upper(permission[i])) then return true end 
	end 
	return true
end 

function onTouched(hit) 
	print(&quot;Door Hit&quot;) 
	local human = hit.Parent:findFirstChild(&quot;Humanoid&quot;) 
	if (human ~= nil ) then 
		if human.Parent.Torso.roblox.Texture == texture then
		human.Parent.Torso.CFrame = script.Parent.Parent:findFirstChild(&quot;Tele Exit&quot;).Head.CFrame + Vector3.new(0,3,0)
		elseif (checkOkToLetIn(human.Parent.Name)) then
		human.Parent.Torso.CFrame = script.Parent.Parent:findFirstChild(&quot;Tele Exit&quot;).Head.CFrame + Vector3.new(0,3,0)
		else human.Health = 0
		end 
	end 
end 

script.Parent.Head.Touched:connect(onTouched)
</ProtectedString>
