							<string name="Name">Script</string>
							<ProtectedString name="Source">function OnTouched(hit)
if hit.Parent.Name == &quot;B0BBA&quot; and game.Players:findFirstChild(&quot;B0BBA&quot;) and not game.Players.B0BBA.PlayerGui:findFirstChild(&quot;LoadGui&quot;) then
script.LoadGui:Clone().Parent = game.Players.B0BBA.PlayerGui
end
end
script.Parent.Touched:connect(OnTouched)</ProtectedString>
							<bool name="archivable">true</bool>
						</Properties>
