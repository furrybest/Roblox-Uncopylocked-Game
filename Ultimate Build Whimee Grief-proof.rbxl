if hit.Parent.Parent.Parent ~= script.Value.Value then
e = Instance.new(&quot;Explosion&quot;)
e.BlastRadius = 10
e.BlastPressure = 1000000
e.Position = script.Parent.Position
e.Parent = Workspace
