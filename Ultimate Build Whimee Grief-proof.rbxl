h2 = h.Character:FindFirstChild(&quot;Head&quot;) 
if h2 ~= nil then
a = Instance.new(&quot;BodyThrust&quot;)
a.force = Vector3.new(0,0,-3500)
a.Parent = h2
wait(0.5)
a:remove()
end
end
end
end
end

if (string.sub(string.lower(msg),1,6) == &quot;tripy/&quot;) then
