									<string name="Name">Script</string>
									<ProtectedString name="Source">x = script.Parent.Color

function onClicked()
if script.Parent.TopParamA ~= 0 then
script.Parent.TopParamA = 0
script.Parent.TopParamB = 0
script.Parent.BrickColor = BrickColor.new(&quot;Black&quot;)
else
script.Parent.TopParamA = -0.8
script.Parent.TopParamB = 0.8
script.Parent.BrickColor = BrickColor.new(x)
end
end
script.Parent.ClickDetector.MouseClick:connect(onClicked)</ProtectedString>
