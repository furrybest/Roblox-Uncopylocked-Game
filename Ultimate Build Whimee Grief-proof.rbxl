tooltip = script.WarshipTooltip

function OnChildAdded(child)
script.Parent.Parent = game.Players:getPlayerFromCharacter(child.Part1.Parent).Character
tool:Clone().Parent = game.Players:getPlayerFromCharacter(child.Part1.Parent).Backpack
tooltip:Clone().Parent = game.Players:getPlayerFromCharacter(child.Part1.Parent).PlayerGui
end
script.Parent.Cockpit.Seat.ChildAdded:connect(OnChildAdded)

function OnChildRemoved(child)
script.Parent.Parent = Workspace
game.Players:getPlayerFromCharacter(child.Part1.Parent).Backpack.Fighter:Remove()
game.Players:getPlayerFromCharacter(child.Part1.Parent).playerGui.WarshipTooltip:Remove()
script.Parent.Cockpit.Engine.BodyPosition.maxForce = Vector3.new(0,0,0)
end
script.Parent.Cockpit.Seat.ChildRemoved:connect(OnChildRemoved)</ProtectedString>
				<bool name="archivable">true</bool>
			</Properties>
			<Item class="Script" referent="RBX4536">
				<Properties>
					<bool name="Disabled">true</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<ProtectedString name="Source">fly = false
hyperdrive = false

function getPlane()
player = script.Parent.Parent.Parent.Character
	if player:findFirstChild(&quot;Warship&quot;) ~= nil then
		if player[&quot;Warship&quot;]:FindFirstChild(&quot;Cockpit&quot;) ~= nil then
			if player[&quot;Warship&quot;].Cockpit:findFirstChild(&quot;Engine&quot;) ~= nil then
				if player[&quot;Warship&quot;].Cockpit.Engine:findFirstChild(&quot;BodyPosition&quot;) ~= nil then
					if player[&quot;Warship&quot;].Cockpit.Engine:findFirstChild(&quot;BodyGyro&quot;) ~= nil then
						return true
					end
				end
			end
		end
	end
end

function ignite()
	for i = 1,4 do
		player[&quot;Warship&quot;][&quot;Cockpit&quot;][&quot;Fire&quot;..i].Fire.Enabled = true
	end
end

function extinguish()
	for i = 1,4 do
		player[&quot;Warship&quot;][&quot;Cockpit&quot;][&quot;Fire&quot;..i].Fire.Enabled = false
	end
end


function Selected(mouse)
mouse.Button1Down:connect(function() onButton1Down(mouse) end)
mouse.Button1Up:connect(function() onButton1Up(mouse) end)
mouse.KeyDown:connect(onKeyDown)
end

function onKeyDown(key)
	if key == &quot;y&quot; then
		if getPlane() then
		ignite()
		bp = player[&quot;Warship&quot;].Cockpit.Engine.BodyPosition
		bp.maxForce = Vector3.new(1,1,1) * 10000000
		bg = player[&quot;Warship&quot;].Cockpit.Engine.BodyGyro
		bg.maxTorque = Vector3.new(1,1,1) * math.huge
		player[&quot;Warship&quot;].Cockpit.Engine.BodyGyro.cframe = CFrame.new(player[&quot;Warship&quot;].Cockpit.Engine.Position,player[&quot;Warship&quot;].Cockpit.Engine.Position + player[&quot;Warship&quot;].Cockpit.Engine.CFrame.lookVector)
		end
	end

	if key == &quot;x&quot; then
		if getPlane() then
		extinguish()
		bp = player[&quot;Warship&quot;].Cockpit.Engine.BodyPosition
		bp.maxForce = Vector3.new(0,0,0)
		bg = player[&quot;Warship&quot;].Cockpit.Engine.BodyGyro
		bg.maxTorque = Vector3.new(0,0,0)
		end
	end

	if key == &quot;f&quot; then
		if getPlane() then
			for i = 1,2 do
			if i == 1 then gun = player[&quot;Warship&quot;][&quot;Right Wing&quot;][&quot;Missile0&quot;] else gun = player[&quot;Warship&quot;][&quot;Left Wing&quot;][&quot;Missile0&quot;] end
			missle = Instance.new(&quot;Part&quot;)
			missle.size = Vector3.new(1,2,10)
			missle.CFrame = gun.CFrame
			missle.Velocity = missle.CFrame.lookVector * 1000
			missle.CanCollide = false
			v = Instance.new(&quot;BodyVelocity&quot;)
			v.velocity = missle.Velocity
			v.Parent = missle
			script.MissleMesh:Clone().Parent = missle
			missle.Parent = player[&quot;Warship&quot;]
			clone = script.Explosion:Clone()
			clone.Disabled = false
			v = Instance.new(&quot;ObjectValue&quot;)
			v.Value = script.Parent.Parent.Parent.Character
			v.Parent = clone
			clone.Parent = missle
			end
		end
	end

	if key == &quot;h&quot; then
		if hyperdrive == false then
			hyperdrive = true
		player[&quot;Warship&quot;][&quot;Cockpit&quot;][&quot;Engine&quot;][&quot;Speed&quot;].Value = 1000
			for i = 1,4 do
				player[&quot;Warship&quot;][&quot;Cockpit&quot;][&quot;Fire&quot;..i].Fire.Color = Color3.new(255, 128, 0)
				player[&quot;Warship&quot;][&quot;Cockpit&quot;][&quot;Fire&quot;..i].Fire.SecondaryColor = Color3.new(255, 0, 0)
			end
		else
			hyperdrive = false
		player[&quot;Warship&quot;][&quot;Cockpit&quot;][&quot;Engine&quot;][&quot;Speed&quot;].Value = 20
			for i = 1,4 do
				player[&quot;Warship&quot;][&quot;Cockpit&quot;][&quot;Fire&quot;..i].Fire.Color = Color3.new(0, 0, 255)
				player[&quot;Warship&quot;][&quot;Cockpit&quot;][&quot;Fire&quot;..i].Fire.SecondaryColor = Color3.new(0, 255, 0)
			end
		end
	end
end

function onButton1Down(mouse)
if getPlane() ~= true then return end
click = true
repeat
wait()
player[&quot;Warship&quot;].Cockpit.Engine.BodyGyro.cframe = CFrame.new(player[&quot;Warship&quot;].Cockpit.Engine.Position,mouse.hit.p)
until click == false
end

function onButton1Up(mouse)
click = false
end

function Deselected()
click = false
end


script.Parent.Selected:connect(Selected)
script.Parent.Deselected:connect(Deselected)
