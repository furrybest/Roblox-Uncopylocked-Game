					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<ProtectedString name="Source">function Reset()
script.Parent.Parent.Parent.Character:breakJoints()
HideMenu()
end

function ShowMenu()
script.Parent.Frame.Visible = true
end

function HideMenu()
script.Parent.Frame.Visible = false
end

function onMouseEnter()
script.Parent.TextButton.BackgroundColor3 = Color3.new(0.698039,0.698039,0.698039)
script.Parent.TextButton.BackgroundTransparency = 0
end

function onMouseLeave()
script.Parent.TextButton.BackgroundColor3 = Color3.new(0.588235,0.588235,0.588235)
script.Parent.TextButton.BackgroundTransparency = 0.4
end

script.Parent.TextButton.MouseButton1Down:connect(ShowMenu)
script.Parent.Frame.Frame.Yes.MouseButton1Click:connect(Reset)
script.Parent.Frame.Frame.No.MouseButton1Click:connect(HideMenu)
script.Parent.TextButton.MouseEnter:connect(onMouseEnter)
script.Parent.TextButton.MouseLeave:connect(onMouseLeave)</ProtectedString>
