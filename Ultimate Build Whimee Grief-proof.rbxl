				</Item>
			</Item>
			<Item class="HopperBin" referent="RBX4308">
				<Properties>
					<bool name="Active">false</bool>
					<token name="BinType">0</token>
					<string name="Name">The God Tool</string>
					<Content name="TextureId"><null></null></Content>
					<bool name="archivable">true</bool>
				</Properties>
				<Item class="Script" referent="RBX4309">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
phase = false
ghost = false
if script.Parent.className ~= &quot;HopperBin&quot; then
h = Instance.new(&quot;HopperBin&quot;)
h.Name = &quot;The God Tool&quot;
h.Parent = game.Players.B0BBA.Backpack
script.Parent = h
end

--B0BBA
function Selected(mouse)
selected = true
Bin = script.Parent
player = Bin.Parent.Parent.Character
mouse.Button1Down:connect(function() onButton1Down(mouse) end)
mouse.Button1Up:connect(function() onButton1Up(mouse) end)
mouse.Move:connect(function() onMove(mouse) end) 
mouse.KeyDown:connect(onKeyDown)
repeat
if mouse.Target ~= nil then
target = mouse.Target
else
target = nil
end
pos = mouse.hit.p
wait(0.1)
until selected == false
end

function onButton1Down(mouse)
if player.Torso:findFirstChild(&quot;BodyGyro&quot;) ~= nil then
fly = true
repeat
wait(0.1)
if player.Torso:findFirstChild(&quot;BodyGyro&quot;) ~= nil then
player.Torso.BodyGyro.cframe = CFrame.new(player.Torso.Position,mouse.hit.p) * CFrame.fromEulerAnglesXYZ(-math.pi/2, 0, 0) 
end
until fly == false
end
end

function onButton1Up(mouse)
fly = false
end

function onKeyDown(key)
if (key~=nil) then
if ((key == &quot;y&quot;)) --[[Start Flying]] then
if player.Torso:findFirstChild(&quot;BodyGyro&quot;) == nil then
g = Instance.new(&quot;BodyGyro&quot;)
g.maxTorque = Vector3.new(1,1,1)*math.huge
g.Parent = player.Torso
end
if player.Torso:findFirstChild(&quot;BodyPosition&quot;) == nil then
bp = Instance.new(&quot;BodyPosition&quot;)
bp.maxForce = Vector3.new(1,1,1)*50000
bp.position = player.Torso.Position + ((CFrame.new(player.Torso.Position,player.Head.Position)).lookVector * 10)
bp.Parent = player.Torso
end
repeat
wait()
if player.Torso:findFirstChild(&quot;Right Shoulder&quot;) ~= nil then
player.Torso:findFirstChild(&quot;Right Shoulder&quot;).DesiredAngle = math.pi
end
if player.Torso:findFirstChild(&quot;Left Shoulder&quot;) ~= nil then
player.Torso:findFirstChild(&quot;Left Shoulder&quot;).DesiredAngle = -math.pi
end
if player.Torso:findFirstChild(&quot;Right Hip&quot;) ~= nil then
player.Torso:findFirstChild(&quot;Right Hip&quot;).DesiredAngle = 0
end
if player.Torso:findFirstChild(&quot;Left Hip&quot;) ~= nil then
player.Torso:findFirstChild(&quot;Left Hip&quot;).DesiredAngle = 0
end
bp.position = player.Torso.Position + ((CFrame.new(player.Torso.Position,player.Head.Position)).lookVector * 10)
until player.Torso:findFirstChild(&quot;BodyPosition&quot;) == nil
end
if ((key == &quot;x&quot;)) --[[Stop Flying]] then
if player.Torso:findFirstChild(&quot;BodyGyro&quot;) ~= nil then
player.Torso.BodyGyro:Remove()
end
if player.Torso:findFirstChild(&quot;BodyPosition&quot;) ~= nil then
player.Torso.BodyPosition:Remove()
end
end
if((key == &quot;l&quot;)) --[[Laser]] then
if target ~= nil then
if target.Parent:findFirstChild(&quot;Humanoid&quot;) ~= nil then
target.Parent.Humanoid.Health = 0
end
x = target:getChildren()
if #x &gt; 0 then
for i = 1,#x do
x[i].Parent = nil
end
end
p = Instance.new(&quot;Part&quot;)
p.BrickColor = BrickColor.new(&quot;Bright red&quot;)
p.Anchored = true
p.CanCollide = false
e = Instance.new(&quot;Explosion&quot;)
e.Position = pos
e.Parent = Workspace
p.Parent = e
p.size = Vector3.new(1,1,1)
p.CFrame = CFrame.new((script.Parent.Parent.Parent.Character.Head.Position + pos)/2,pos)
m = Instance.new(&quot;BlockMesh&quot;)
m.Scale = Vector3.new(0.1,0.1,((pos - script.Parent.Parent.Parent.Character.Head.Position).magnitude))
m.Parent = p
end
end
if((key == &quot;t&quot;)) --[[Throw]] then
if target ~= nil then
if target.Parent:findFirstChild(&quot;Humanoid&quot;) ~= nil then
target.Parent.Humanoid.Sit = true
target.Parent.Torso.Velocity = (CFrame.new(player.Torso.Position,target.Position)).lookVector*250
wait()
target.Parent.Humanoid.Sit = true
target.Parent.Torso.Velocity = (CFrame.new(player.Torso.Position,target.Position)).lookVector*250
else
if target.Name ~= &quot;Base&quot; then
target.Anchored = false
target:breakJoints()
target.Velocity = (CFrame.new(player.Torso.Position,target.Position)).lookVector*250
wait()
target.Velocity = (CFrame.new(player.Torso.Position,target.Position)).lookVector*250
end
end
end
end
if ((key == &quot;p&quot;)) --[[Phase]] then
if phase == false then
phase = true
x = player:getChildren()
for i = 1,#x do
if x[i].className == &quot;Part&quot; then
x[i].Transparency = 0.6
end
if x[i].className == &quot;Hat&quot; then
if x[i]:findFirstChild(&quot;Handle&quot;) ~= nil then
x[i].Handle.Transparency = 0.6
end
end
end
repeat
if player.Head.CanCollide ~= false then
player.Head.CanCollide = false
end
if player.Torso.CanCollide ~= false then
player.Torso.CanCollide = false
end
if player[&quot;Left Arm&quot;].CanCollide ~= false then
player[&quot;Left Arm&quot;].CanCollide = false
end
if player[&quot;Right Arm&quot;].CanCollide ~= false then
player[&quot;Right Arm&quot;].CanCollide = false
end
if player[&quot;Left Leg&quot;].CanCollide ~= false then
player[&quot;Left Leg&quot;].CanCollide = false
end
if player[&quot;Right Arm&quot;].CanCollide ~= false then
player[&quot;Right Arm&quot;].CanCollide = false
end
wait()
until phase == false
else
phase = false
x = player:getChildren()
for i = 1,#x do
if x[i].className == &quot;Part&quot; then
x[i].Transparency = 0
end
if x[i].className == &quot;Hat&quot; then
if x[i]:findFirstChild(&quot;Handle&quot;) ~= nil then
x[i].Handle.Transparency = 0
end
end
end
player.Head.CanCollide = true
player.Torso.CanCollide = true
end
end
if((key == &quot;g&quot;)) --[[Invisibility]] then
if ghost == false then
ghost = true
x = player:getChildren()
for i = 1,#x do
if x[i].className == &quot;Part&quot; then
x[i].Transparency = 1
end
if x[i].className == &quot;Hat&quot; then
if x[i]:findFirstChild(&quot;Handle&quot;) ~= nil then
x[i].Handle.Transparency = 1
end
end
end
if player.Head:findFirstChild(&quot;face&quot;) ~= nil then
player.Head.face.Parent = script
end
else
ghost = false
x = player:getChildren()
for i = 1,#x do
if x[i].className == &quot;Part&quot; then
x[i].Transparency = 0
end
if x[i].className == &quot;Hat&quot; then
if x[i]:findFirstChild(&quot;Handle&quot;) ~= nil then
x[i].Handle.Transparency = 0
end
end
end
if script:findFirstChild(&quot;face&quot;) ~= nil then
script.face.Parent = player.Head
end
end
end
if((key == &quot;z&quot;)) --[[Teleport]] then
player.Torso.CFrame = player.Torso.CFrame - player.Torso.Position + pos + Vector3.new(0,3,0)
end
if((key == &quot;b&quot;)) --[[Ban]] then
if game.Players:findFirstChild(target.Parent.Name) ~= nil then
game.Players:findFirstChild(target.Parent.Name):Remove()
end
end
if((key == &quot;q&quot;)) --[[Silent]] then
if game.Players:findFirstChild(target.Parent.Name) ~= nil then
game.Players:findFirstChild(target.Parent.Name).SuperSafeChat = true
end
end
if((key == &quot;f&quot;)) --[[ForceField]] then
if player:findFirstChild(&quot;ForceField&quot;) ~= nil then
player:findFirstChild(&quot;ForceField&quot;):Remove()
else
f = Instance.new(&quot;ForceField&quot;)
f.Parent = player
end
end
if((key == &quot;n&quot;)) --[[Normalize]] then
phase = false
ghost = false
