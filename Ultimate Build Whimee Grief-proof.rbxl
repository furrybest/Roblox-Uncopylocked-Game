						<string name="Name">Script</string>
						<ProtectedString name="Source">function onMove(mouse)
targ = mouse.Target
if targ==nil then return end
if targ.CanCollide == true then
script.Parent.Parent.Parent.Message.Text = &quot;Brick CanCollide = True&quot;
else
script.Parent.Parent.Parent.Message.Text = &quot;Brick CanCollide = False&quot;
end
end

function onButton1Down(mouse)
targ = mouse.Target
if targ==nil then return end
if targ.CanCollide == true then
targ.CanCollide = false
local v = targ.Transparency
targ.Transparency = 1
wait(0.1)
targ.Transparency = v
else targ.CanCollide = true
local v = targ.Transparency
targ.Transparency = 1
wait(0.1)
targ.Transparency = v
end
end

function onS(mouse)
mouse.Button1Down:connect(function() onButton1Down(mouse) end)
Instance.new(&quot;Hint&quot;).Parent = script.Parent.Parent.Parent
mouse.Move:connect(function() onMove(mouse) end)
end
script.Parent.Selected:connect(onS)

function onUnS(mouse)
script.Parent.Parent.Parent.Message:Remove()
end
script.Parent.Deselected:connect(onUnS)</ProtectedString>
