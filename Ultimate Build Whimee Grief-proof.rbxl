						<ProtectedString name="Source">local buttons = {}
local clicked = false

function GetButtons()
x = game.Players:getPlayers()
for i = 1,#x do
local button = Instance.new(&quot;TextButton&quot;)
button.Name = x[i].Name
button.Text = x[i].Name
button.Size = UDim2.new(1,0,0,19)
button.Position = UDim2.new(0,0,0,(i*20))
button.AutoButtonColor = true
button.Parent = script.Parent
local buttonscript = script.Script:Clone()
buttonscript.Disabled = false
buttonscript.Parent = button
local value = Instance.new(&quot;ObjectValue&quot;)
value.Value = x[i]
value.Parent = button

local button2 = Instance.new(&quot;TextButton&quot;)
button2.Name = &quot;Kill&quot;
button2.Text = &quot;Kill&quot;
button2.Size = UDim2.new(1,0,1,0)
button2.Position = UDim2.new(1,0,0,0)
button2.Visible = false
button2.AutoButtonColor = true
button2.Parent = button
local kill = script.Kill:Clone()
kill.Disabled = false
kill.Parent = button2

local button3 = Instance.new(&quot;TextButton&quot;)
button3.Name = &quot;Kick&quot;
button3.Text = &quot;Kick&quot;
button3.Size = UDim2.new(1,0,1,0)
button3.Position = UDim2.new(2,0,0,0)
button3.Visible = false
button3.AutoButtonColor = true
button3.Parent = button
local kick = script.Kick:Clone()
kick.Disabled = false
kick.Parent = button3

local button4 = Instance.new(&quot;TextButton&quot;)
button4.Name = &quot;Tele&quot;
button4.Text = &quot;Tele&quot;
button4.Size = UDim2.new(1,0,1,0)
button4.Position = UDim2.new(3,0,0,0)
button4.Visible = false
button4.AutoButtonColor = true
button4.Parent = button
local tele = script.Tele:Clone()
tele.Disabled = false
tele.Parent = button4

table.insert(buttons,button)
end
end

function RemoveButtons()
if #buttons &gt; 0 then
for i = 1,#buttons do
buttons[i]:Remove()
end
end
end


function OnButton1Down()
if clicked == false then
clicked = true
GetButtons()
else
clicked = false
RemoveButtons()
end
end

script.Parent.MouseButton1Down:connect(OnButton1Down)
