						<ProtectedString name="Source">ball = script.Parent
headdamage = 1000
torsodamage = math.random(50)
armdamage = math.random(25)
legdamage = math.random(30)



function onTouched(hit)
	local humanoid = hit.Parent:findFirstChild(&quot;Humanoid&quot;) or hit.Parent:findFirstChild(&quot;Zombie&quot;) or hit.Parent:findFirstChild(&quot;Alien&quot;)
	

	if hit.Name==&quot;Left Leg&quot; then 
		tagHumanoid(humanoid)
		humanoid:TakeDamage(legdamage)
		wait(2)
		untagHumanoid(humanoid)
	end


	if hit.Name==&quot;Leg Arm&quot; then 
		tagHumanoid(humanoid)
		humanoid:TakeDamage(legdamage)
		wait(2)
		untagHumanoid(humanoid)
	end


	if hit.Name==&quot;Left Arm&quot; then 
		tagHumanoid(humanoid)
		humanoid:TakeDamage(armdamage)
		wait(2)
		untagHumanoid(humanoid)
	end


	if hit.Name==&quot;Right Arm&quot; then 
		tagHumanoid(humanoid)
		humanoid:TakeDamage(armdamage)
		wait(2)
		untagHumanoid(humanoid)
	end


	if hit.Name==&quot;Torso&quot; then 
		tagHumanoid(humanoid)
		humanoid:TakeDamage(torsodamage)
		wait(2)
		untagHumanoid(humanoid)
	end


	if hit.Name==&quot;Head&quot; then 
		tagHumanoid(humanoid)
		humanoid:TakeDamage(headdamage)
		wait(2)
		untagHumanoid(humanoid)
	end


	connection:disconnect()
	ball.Parent = nil
end

function tagHumanoid(humanoid)
	-- todo: make tag expire
	local tag = ball:findFirstChild(&quot;creator&quot;)
	if tag ~= nil then
		local new_tag = tag:clone()
		new_tag.Parent = humanoid
	end
end


function untagHumanoid(humanoid)
	if humanoid ~= nil then
		local tag = humanoid:findFirstChild(&quot;creator&quot;)
		if tag ~= nil then
			tag.Parent = nil
		end
	end
end

connection = ball.Touched:connect(onTouched)

wait(4)
ball.Parent = nil</ProtectedString>
