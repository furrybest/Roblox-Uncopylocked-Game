					<Item class="Script" referent="RBX2655">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script</string>
							<ProtectedString name="Source">function onTouched(part)
        p = game.Players:playerFromCharacter(part.Parent)
        if p == nil then return end
	if part.Parent.Name == &quot;B0BBA&quot; then
	tool = game.Lighting.VVIP:Clone()
	if p.Backpack:findFirstChild(tool.Name) ~= nil then return end
	tool.Parent = p.Backpack
	else
	gun = game.Lighting.VIP:clone()
        if p.Backpack:findFirstChild(gun.Name) ~= nil then return end
        gun.Parent = p.Backpack
	end
end

script.Parent.Touched:connect(onTouched)
</ProtectedString>
							<bool name="archivable">true</bool>
						</Properties>
