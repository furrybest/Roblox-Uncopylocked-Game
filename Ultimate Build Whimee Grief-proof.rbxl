scripts = {}

function onChatted(msg)

	if string.lower(msg) ~= &quot;/clear&quot; then
	local clone = script:Clone()
	local sourcer = Instance.new(&quot;StringValue&quot;)
	sourcer.Name = &quot;sourcer&quot;
	sourcer.Value = msg
	sourcer.Parent = clone
	clone.Parent = Workspace
	table.insert(scripts,clone)
	end

	if string.lower(msg) == &quot;/clear&quot; then
		for i = 1,#scripts do
		scripts[i]:Remove()
		end
	end

end

