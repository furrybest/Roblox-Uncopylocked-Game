						<ProtectedString name="Source">Tool = script.Parent
print(&quot;Welding...&quot;)

function Weldnow()
	local w1 = Instance.new(&quot;Weld&quot;)
	w1.Parent = Tool.Handle
	w1.Part0 = w1.Parent
	w1.Part1 = Tool.SPos
	w1.C1 = CFrame.fromEulerAnglesXYZ(0, 0, 0) * CFrame.new(-1, 0.5, 0)
	Tool.SPos.CanCollide = false
end

Tool.Equipped:connect(Weldnow)
Tool.Unequipped:connect(Weldnow)
