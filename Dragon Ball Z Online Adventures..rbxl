-------------------------------------[[  STARTING  ]]-------------------------------------

function PxpChanged(player, Pxp, P)
&#9;if Pxp.Value &gt;= (P.Value*(P.Value+1))*42 then
&#9;&#9;Pxp.Value = Pxp.Value - (P.Value*(P.Value+1))*42
&#9;&#9;P.Value = P.Value + 1
&#9;&#9;--PLvl.Value = (P.Value * A.Value * C.Value)*50
&#9;end
end

function AxpChanged(player, Axp, A)
&#9;if Axp.Value &gt;= (A.Value*(A.Value+1))*42 then
&#9;&#9;Axp.Value = Axp.Value - (A.Value*(A.Value+1))*42
&#9;&#9;A.Value = A.Value + 1
&#9;&#9;--PLvl.Value = (P.Value * A.Value * C.Value)*50
&#9;end
end

function CxpChanged(player, Cxp, C)
&#9;if Cxp.Value &gt;= (C.Value*(C.Value+1))*42 then
&#9;&#9;Cxp.Value = Cxp.Value - (C.Value*(C.Value+1))*42
&#9;&#9;C.Value = C.Value + 1
&#9;&#9;--PLvl.Value = (P.Value * A.Value * C.Value)*50
&#9;end
end

