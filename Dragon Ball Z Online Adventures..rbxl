				<Item class="Script" referent="RBX1691">
					<Properties>
						<bool name="Archivable">true</bool>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Damage</string>
						<ProtectedString name="Source">arrow = script.Parent
Owner = arrow.Owner
damage = 26
Hits = 0

function onTouched(hit)

&#9;humanoid = hit.Parent:findFirstChild(&quot;Humanoid&quot;)
&#9;if humanoid~=nil then
&#9;&#9;if hit.Parent.Name ~= Owner.Value.Name then
      if Hits &lt; 1 then 
&#9;&#9; humanoid.Health = humanoid.Health - damage
       Hits = Hits + 1
       hit.Parent.Torso.CFrame = arrow.CFrame * CFrame.Angles(0, -3.14, 0)
       humanoid.Sit = true
       wait(0.5)
      end
&#9;&#9;wait()
&#9;&#9;end
&#9;end
&#9;explosion = game.Lighting.Bewm:clone()
&#9;explosion.Position = arrow.Position
&#9;explosion.Mesh.Scale = Vector3.new(4, 4, 4)
&#9;explosion.Parent = workspace
&#9;wait()
&#9;arrow:Remove()
end

arrow.Touched:connect(onTouched)
</ProtectedString>
					</Properties>
				</Item>
			</Item>
