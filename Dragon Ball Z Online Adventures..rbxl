						<string name="Name">Commands</string>
						<ProtectedString name="Source">Me = script.Parent.Parent.Parent
Me.Chatted:connect(function(Msg)
 msg = Msg:lower()
 if string.sub(msg, 1, 6) == &quot;update&quot; then
&#9;script.Parent.Help.Visible = true
 end
