&#9;decal = script.Parent.Decal
&#9;tex = &quot;http://www.roblox.com/Thumbs/Asset.ashx?format=png&amp;width=420&amp;height=230&amp;assetId=&quot; ..placeId
&#9;decal.Texture = tex
end



</ProtectedString>
