					<Item class="Script" referent="RBX2713">
						<Properties>
							<bool name="Archivable">true</bool>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script</string>
							<ProtectedString name="Source">Updates = {&quot;How to use Combat Tool:&quot;,
&quot;Q - Left Punch&quot;,
&quot;E - Right Punch&quot;,
&quot;R - Left Kick&quot;,
&quot;T - Right Kick&quot;,&quot;&quot;,
&quot;Earn XP by Training with friends, or by your self! Using skills will give&quot;,&quot; you XP, but hitting an actual person with them will give you more.&quot;,
&quot;Having Matches is a good way to Level Up faster&quot;,
&quot;Updates:&quot;,
&quot;- New Skills!&quot;,&quot;- Since noobs keep bothering me about the Big update,&quot;,&quot;  it will happen later on this weekend or so.&quot;,&quot;- Upgraded Combat a bit&quot;}
for i = 1 , #Updates do
 script.Parent[&quot;Line&quot;..i].Text = Updates[i]
end
</ProtectedString>
