   M = Instance.new(&quot;Message&quot;)
   M.Parent = PlayerGui
   if Backpack:findFirstChild(&quot;Fly&quot;) ~= nil then
    if Backpack.Fly.Script.Fast.Value == false then
     M.Text = &quot;Your Flight Speed has increased!&quot;
     Backpack.Fly.Script.Fast.Value = true
     wait(1)
     M:Remove()
     wait(0.1)
     Activated = false
     else
     Activated = true
     M.Text = &quot;You already have that!&quot;
     wait(1)
     M:Remove()
     wait(0.1)
     Activated = false
    end
   end
  end
 end
end
