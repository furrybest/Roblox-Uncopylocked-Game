Energy2.Transparency = Energy2.Transparency - 0.2
wait(0.07)
end
Energy.Transparency = 0
Energy2.Transparency = 0
wait(0.4)
for i = 1, 5 do
RightShoulder.C0 = RightShoulderC0 * CFrame.Angles(0, 0, 1.57)
LeftShoulder.C0 = LeftShoulderC0 * CFrame.Angles(0, 0, 1.57)
Energy.Transparency = Energy.Transparency + 0.2
t = Instance.new(&quot;Part&quot;)
t.Parent = game.Workspace
t.formFactor = &quot;Symmetric&quot;
t.Shape = &quot;Ball&quot;
t.Name = &quot;Blast&quot;
t.TopSurface = &quot;Smooth&quot;
t.BottomSurface = &quot;Smooth&quot;
t.CanCollide = false
t.Size = Vector3.new(3, 3, 3)
t.CFrame = Torso.CFrame * CFrame.new(0, 0, -4)
t.Transparency = 0.2
e = Instance.new(&quot;BodyPosition&quot;)
e.position = t.Position
e.Parent = t
e.maxForce = Vector3.new(4e+006,4e+006,4e+006)
Owner = Instance.new(&quot;ObjectValue&quot;)
Owner.Parent = t
Owner.Name = &quot;Owner&quot;
Owner.Value = Me
t.BrickColor = Energy.BrickColor
script.Damage:clone().Parent = t
e.position = eTorso.Position
Data.KiControl.KiXP.Value = Data.KiControl.KiXP.Value+70
wait(0.15)
RightShoulder.C0 = RightShoulderC0 * CFrame.Angles(0, 0, -1.57)
LeftShoulder.C0 = LeftShoulderC0 * CFrame.Angles(0, 0, -1.57)
Energy2.Transparency = Energy.Transparency + 0.2
t = Instance.new(&quot;Part&quot;)
t.Parent = game.Workspace
t.formFactor = &quot;Symmetric&quot;
t.Shape = &quot;Ball&quot;
t.Name = &quot;Blast&quot;
t.TopSurface = &quot;Smooth&quot;
t.BottomSurface = &quot;Smooth&quot;
t.CanCollide = false
t.Size = Vector3.new(3, 3, 3)
t.CFrame = Torso.CFrame * CFrame.new(0, 0, -4)
t.Transparency = 0.2
e = Instance.new(&quot;BodyPosition&quot;)
e.position = t.Position
e.Parent = t
e.maxForce = Vector3.new(4e+006,4e+006,4e+006)
Owner = Instance.new(&quot;ObjectValue&quot;)
Owner.Parent = t
Owner.Name = &quot;Owner&quot;
Owner.Value = Me
t.BrickColor = Energy.BrickColor
script.Damage:clone().Parent = t
e.position = eTorso.Position
Data.KiControl.KiXP.Value = Data.KiControl.KiXP.Value+70
wait(0.15)
end
Energy:Remove()
Energy2:Remove()
wait(1)
v.Occupied.Value = false
if v.Occupied:findFirstChild(&quot;EnableScript&quot;) ~= nil then
v.Occupied:findFirstChild(&quot;EnableScript&quot;):Remove()
end
ePosition:Remove()
Thrust:Remove()
eGyro:Remove()
RefreshWelds()
Humanoid.WalkSpeed = 16
wait(1)
Gyro:Remove()
Position:Remove()
Velocity:Remove()
end
end
end
wait(0.05)  
RightShoulder.MaxVelocity = 0.15
LeftShoulder.MaxVelocity = 0.15
RefreshWelds()
Chance = math.random(1, 3)
if Chance == 1 then
 Data.Physical.PhXP.Value = Data.Physical.PhXP.Value+300
end
wait(7)
Activated = false
end
end
wait(1)
mouse.Icon = &quot;http://www.roblox.com/asset/?id=11624732&quot;
end 

