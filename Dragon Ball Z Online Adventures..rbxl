				<Item class="LocalScript" referent="RBX2726">
					<Properties>
						<bool name="Archivable">true</bool>
						<bool name="Disabled">true</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Rotation</string>
						<ProtectedString name="Source">local cam = game.Workspace.CurrentCamera
local cs = game.Workspace:findFirstChild(&quot;Cam1&quot;)
local cs2 = game.Workspace:findFirstChild(&quot;Cam2&quot;)
local cs3 = game.Workspace:findFirstChild(&quot;Cam3&quot;)

while true do
wait()
cam.CameraSubject = cs2
for i = 1, 5, 0.01 do
&#9;local r = 30
&#9;local h = 65
&#9;local x = (math.cos(i) * r)
&#9;local y = (math.sin(i) * h)
&#9;local p = Instance.new(&quot;Part&quot;)
&#9;cam.CoordinateFrame = CFrame.new(Vector3.new(x,h,y))
&#9;wait(0.01)
end 
cam.CameraSubject = cs
for i = 1, 5, 0.01 do
&#9;local r = 40
&#9;local h = 65
&#9;local x = (math.cos(i) * r)
&#9;local y = (math.sin(i) * h)
&#9;local p = Instance.new(&quot;Part&quot;)
&#9;cam.CoordinateFrame = cs.CFrame*CFrame.new(Vector3.new(x,h,y))
&#9;wait(0.01)
end 
cam.CameraSubject = cs3
for i = 1, 5, 0.01 do
&#9;local r = 40
&#9;local h = 30
&#9;local x = (math.cos(i) * r)
&#9;local y = (math.sin(i) * h)
&#9;local p = Instance.new(&quot;Part&quot;)
&#9;cam.CoordinateFrame = cs3.CFrame*CFrame.new(Vector3.new(x,h,y))
&#9;wait(0.01)
end 
end</ProtectedString>
