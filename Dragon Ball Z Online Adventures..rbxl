Gui = script.Parent
Me = Gui.Parent.Parent
PlayerGui = Me.PlayerGui
Backpack = Me.Backpack
Character = Me.Character
Humanoid = Character.Humanoid
Torso = Character.Torso
Head = Character.Head
LeftArm = Character[&quot;Left Arm&quot;]
RightArm = Character[&quot;Right Arm&quot;]
LeftLeg = Character[&quot;Left Leg&quot;]
RightLeg = Character[&quot;Right Leg&quot;]
Neck = Torso[&quot;Neck&quot;]
RightShoulder = Torso[&quot;Right Shoulder&quot;]
LeftShoulder = Torso[&quot;Left Shoulder&quot;]
RightHip = Torso[&quot;Right Hip&quot;]
LeftHip = Torso[&quot;Left Hip&quot;]

HealthGUI = PlayerGui:findFirstChild(&quot;HealthGUI&quot;)
if HealthGUI ~= nil then
 HealthGUI:Remove()
end

Occupied = Character:findFirstChild(&quot;Occupied&quot;)
if Occupied == nil then
 O = Instance.new(&quot;BoolValue&quot;)
 O.Name = &quot;Occupied&quot;
 O.Parent = Character
 O.Value = false
end

NewGame = Gui.NewGame
Continue = Gui.Continue

New = Gui.New
Ki = New.Ki.Colours
Race = New.Race.Races
Hand = New.Hand
Choose = New.Choose
Cover = Gui.Cover

function EnterGame()
 New.Visible = false
 NewGame.Visible = false
 Continue.Visible = false
 for i = 0, 1, 0.2 do
  Cover.BackgroundTransparency = Cover.BackgroundTransparency - 0.2
  wait(0.1)
 end
 Cover.BackgroundTransparency = 0
 wait(0.25)
 Gui.Rotation.Disabled = true
 --Character.Parent = workspace
 workspace.CurrentCamera.CameraSubject = Humanoid
 Chance = math.random(1, 3)
 if Chance == 1 then
  Character.Torso.CFrame = Workspace[&quot;Spot2&quot;].CFrame
  elseif Chance == 2 then
  Character.Torso.CFrame = Workspace[&quot;Spot3&quot;].CFrame
  else
  Character.Torso.CFrame = Workspace[&quot;Spot4&quot;].CFrame
 end
 Character.Humanoid.WalkSpeed = 16
 Gui.Reset.Visible = true
 Gui.RunGui.Visible = true
 Gui.Float.Visible = true
 Gui.Stats.Visible = true
 Gui.Save.Visible = true
 Gui.Save.Script.Disabled = false
 Gui.Shop.Visible = true
 Gui.Title:Remove()
 Cover.Visible = false
 Gui.MouseLockImage:Remove()
 PlayerGui.Bars.Background.Visible = true
 PlayerGui.Bars.Background.KiGather.Script.Disabled = false
 PlayerGui.Bars.Help.Visible = true
 PlayerGui.Bars.Script.Disabled = false
 if Me.Name == &quot;mastrj&quot; then
  game.Lighting[&quot;Fly&quot;]:clone().Parent = Backpack --
  game.Lighting[&quot;Combat&quot;]:clone().Parent = Backpack 
  game.Lighting[&quot;Hellzone Grenade&quot;]:clone().Parent = Backpack 
  game.Lighting[&quot;Wolf Fang Fist&quot;]:clone().Parent = Backpack 
  game.Lighting[&quot;Energy Punch&quot;]:clone().Parent = Backpack 
  game.Lighting[&quot;Destructo Disk&quot;]:clone().Parent = Backpack 
  game.Lighting[&quot;Aggressive Energy Wave&quot;]:clone().Parent = Backpack 
  game.Lighting[&quot;Energy Blast Volley&quot;]:clone().Parent = Backpack 
  game.Lighting[&quot;Galick Gun&quot;]:clone().Parent = Backpack 
  game.Lighting[&quot;Monster Crush&quot;]:clone().Parent = Backpack --
  game.Lighting[&quot;Instant Transmission&quot;]:clone().Parent = Backpack 
  game.Lighting[&quot;Dragon Throw&quot;]:clone().Parent = Backpack 
  game.Lighting[&quot;Energy Wave&quot;]:clone().Parent = Backpack 
  game.Lighting[&quot;Genocide Breaker&quot;]:clone().Parent = Backpack
  game.Lighting[&quot;Energy Blast&quot;]:clone().Parent = Backpack  
  game.Lighting[&quot;Chou Makohou&quot;]:clone().Parent = Backpack
  game.Lighting[&quot;Kamehameha&quot;]:clone().Parent = Backpack
  game.Lighting[&quot;HighSpeed Rush&quot;]:clone().Parent = Backpack
  game.Lighting[&quot;Dragon Fist&quot;]:clone().Parent = Backpack
  game.Lighting[&quot;Bone Crush&quot;]:clone().Parent = Backpack
  game.Lighting[&quot;Ki Blast&quot;]:clone().Parent = Backpack
  else
  game.Lighting[&quot;Fly&quot;]:clone().Parent = Backpack
  game.Lighting[&quot;Combat&quot;]:clone().Parent = Backpack
  game.Lighting[&quot;Ki Blast&quot;]:clone().Parent = Backpack
 end
--[[
 if Me.Name == &quot;mastrj&quot; or Me.Name == &quot;Player&quot; or Me.Name == &quot;piehole64&quot; or Me.Name == &quot;rikuskill&quot; or Me.Name == &quot;KishimotoMasashi&quot; or Me.Name == &quot;UtagawaKuniyoshi&quot; or Me.Name == &quot;campinking&quot; then
  if Me:findFirstChild(&quot;Crystal Mode&quot;) == nil then
  CM = game.Lighting.Modes[&quot;Crystal Mode&quot;]:clone()
  CM.Parent = Me
  CM.Disabled = false
  end
 end
 if Me.Name == &quot;Tokatomo&quot; then
  if Me:findFirstChild(&quot;Spark&quot;) == nil then
  S = game.Lighting.Modes[&quot;Spark&quot;]:clone()
  S.Parent = Me
  S.Disabled = false
  end
 end
 if Me.Name == &quot;fordsuv&quot; then
  if Me:findFirstChild(&quot;ASSJ&quot;) == nil then
  ASSJ = game.Lighting.Modes[&quot;ASSJ&quot;]:clone()
  ASSJ.Parent = Me 
  ASSJ.Disabled = false
  end
 end
 if Me.Name == &quot;DaisukeUchiha&quot; or Me.Name == &quot;lordjman101&quot; then
  if Me:findFirstChild(&quot;Super Majin&quot;) == nil then
  SM = game.Lighting.Modes[&quot;Super Majin&quot;]:clone()
  SM.Parent = Me
  SM.Disabled = false
  end
 end
--]]
 for i = 0, 1, 0.2 do
  Cover.BackgroundTransparency = Cover.BackgroundTransparency + 0.2
  wait()
 end
 script.Parent.Rotation:Remove()
 Cover:Remove()
 New:Remove()
 Continue:Remove()
 NewGame:Remove()
 script:Remove()
end

workspace.CurrentCamera.CameraSubject = workspace.Cam1
--Character.Parent = workspace.CurrentCamera
--Character:MoveTo(workspace.Spot.Position)
--Character.Torso.CFrame = Workspace.Spot.CFrame
Character.Humanoid.WalkSpeed = 0

script.Parent.Rotation.Disabled = false

if Me:findFirstChild(&quot;Data&quot;) ~= nil then
 Data = Me:findFirstChild(&quot;Data&quot;)
 if Data.Ki.Value ~= 0 and Data.Race.Value ~= 0 then
  Continue.Visible = true
  else
  Continue.Visible = false
 end
end

wait(3)

for i = 0, 1, 0.2 do
 Cover.BackgroundTransparency = Cover.BackgroundTransparency + 0.2
 wait()
end
wait(0.1)
Cover.BackgroundTransparency = 1

Activated = false

NewGame.MouseButton1Down:connect(function()
 if not Activated then
  Activated = true
  if Me:findFirstChild(&quot;Data&quot;) ~= nil then
   Data = Me:findFirstChild(&quot;Data&quot;)
   if Continue.Visible == true then
    Gui.Overwrite.Visible = true
    Continue.Visible = false
    NewGame.Visible = false
    else
    Data.Ki.Value = 0
    Data.Race.Value = 0
    Data.Hand.Value = 1
    Data.Physical.Value = 1
    Data.Agility.Value = 1
    Data.KiControl.Value = 1
    Data.Physical.PhXP.Value = 0
    Data.Agility.AXP.Value = 0
    Data.KiControl.KiXP.Value = 0
    Data.PowerLvl.Value = 50
    Continue.Visible = false
    NewGame.Visible = false
    wait(0.5)
    Data.Ki.Value = 1
    Data.Race.Value = 1
    New.Visible = true
   end
  end
  wait(0.05)
  Activated = false
 end
end)

