&quot;http://www.roblox.com/asset/?id=53072013&quot;
}
local Ave = {Num = 0, Total = 0}

for i = 1, #DecalImages do
script.Parent.IDLabel.Text = &quot;Loading Image: ID #&quot; .. DecalImages[i]:sub(33)
local lTime = time()
game:GetService(&quot;InsertService&quot;):LoadAsset(tonumber(DecalImages[i]:sub(33)))
Ave.Total = Ave.Total + time() - lTime
Ave.Num = Ave.Num + 1
for i, v in pairs(game:GetService(&quot;InsertService&quot;):GetChildren()) do
&#9;v:remove()
end
script.Parent.BackScroll.PercentLabel.Text = &quot;&quot; .. math.floor(i/#DecalImages*100) .. &quot;%&quot;
script.Parent.Scroll.Size = UDim2.new(0, i/#DecalImages*300, 0, 20)
end

print(&quot;Done&quot;)

script.Parent.Scroll.BackgroundColor3 = Color3.new(0, 205, 0)

wait(0.5)

for i = 0,1,0.2 do
&#9;script.Parent.BlackOut.BackgroundTransparency = script.Parent.BlackOut.BackgroundTransparency - 0.2
