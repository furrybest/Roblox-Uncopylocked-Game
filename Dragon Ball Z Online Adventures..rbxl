RightLeg = Character[&quot;Right Leg&quot;]
Neck = Torso[&quot;Neck&quot;]
RightShoulder = Torso[&quot;Right Shoulder&quot;]
LeftShoulder = Torso[&quot;Left Shoulder&quot;]
RightHip = Torso[&quot;Right Hip&quot;]
LeftHip = Torso[&quot;Left Hip&quot;]

NeckC0 = CFrame.new(0, 1, 0, -1, 0, 0, 0, 0, 1, 0, 1, 0)
NeckC1 = CFrame.new(0, -0.5, 0, -1, 0, 0, 0, 0, 1, 0, 1, 0)
LeftShoulderC0 = CFrame.new(-1, 0.5, 0, 0, 0, -1, 0, 1, 0, 1, 0, 0)
LeftShoulderC1 = CFrame.new(0.5, 0.5, 0, 0, 0, -1, 0, 1, 0, 1, 0, 0)
RightShoulderC0 = CFrame.new(1, 0.5, 0, 0, 0, 1, 0, 1, 0, -1, 0, 0)
RightShoulderC1 = CFrame.new(-0.5, 0.5, 0, 0, 0, 1, 0, 1, 0, -1, 0, 0)
LeftHipC0 = CFrame.new(-1, -1, 0, 0, 0, -1, 0, 1, 0, 1, 0, 0)
LeftHipC1 = CFrame.new(-0.5, 1, 0, 0, 0, -1, 0, 1, 0, 1, 0, 0)
RightHipC0 = CFrame.new(1, -1, 0, 0, 0, 1, 0, 1, 0, -1, 0, 0)
RightHipC1 = CFrame.new(0.5, 1, 0, 0, 0, 1, 0, 1, 0, -1, 0, 0)

function RefreshWelds()
 Neck.C0 = NeckC0
 Neck.C1 = NeckC1
 RightShoulder.C0 = RightShoulderC0
 RightShoulder.C1 = RightShoulderC1
 LeftShoulder.C0 = LeftShoulderC0
 LeftShoulder.C1 = LeftShoulderC1
 RightHip.C0 = RightHipC0
 RightHip.C1 = RightHipC1
 LeftHip.C0 = LeftHipC0
 LeftHip.C1 = LeftHipC1
end

Activated = false
Thing = Character.Occupied

function Attack(mouse)
if not Activated and Thing.Value == false then

&#9;Activated = true

   mouse.Icon = &quot;http://www.roblox.com/asset/?id=41672909&quot;

if Ki.Value &gt;= 400 then

   SavedHealth = Humanoid.Health
   Humanoid.PlatformStand = true
   
   Gyro = Instance.new(&quot;BodyGyro&quot;)
   Gyro.Parent = Torso
   Gyro.D = 50
   Gyro.maxTorque = Vector3.new(math.huge, math.huge, math.huge)
   Gyro.cframe = Torso.CFrame
   Velocity = Instance.new(&quot;BodyVelocity&quot;)
   Velocity.Parent = Torso
   Velocity.maxForce = Vector3.new(0, 0, 0)
   Position = Instance.new(&quot;BodyPosition&quot;)
   Position.Parent = Torso
   Position.maxForce = Vector3.new(0, 0, 0)
   LawlGyro = Gyro.cframe

   Position.maxForce = Vector3.new(math.huge, math.huge, math.huge)
   Position.position = Torso.Position

   LastNumberDistance = 10
   LastTorso = &quot;&quot;
   LastHumanoid = &quot;&quot;

   wait(0.1)
   Thing.Value = true

   for i, v in pairs(workspace:GetChildren()) do
    if v.Name ~= Me.Name then
     aTorso = v:findFirstChild(&quot;Torso&quot;)
     aHumanoid = v:findFirstChild(&quot;Humanoid&quot;)
     if aTorso ~= nil and aHumanoid ~= nil then
      if (Torso.Position-aTorso.Position).magnitude &lt;= LastNumberDistance and aHumanoid.Health &gt; 0 then
       LastNumberDistance = (Torso.Position-aTorso.Position).magnitude
       LastTorso = aTorso
       LastHumanoid = aHumanoid
       aPosition = Instance.new(&quot;BodyPosition&quot;)
       aPosition.Name = &quot;Stay&quot;
       aPosition.Parent = LastTorso
       script.PositionScript:clone().Parent = aPosition
       aPosition.PositionScript.Disabled = false
       v.Occupied.Value = true
       game.Lighting.EnableScript:clone().Parent = v.Occupied
      end
     end
    end
   end
   LastPunched = &quot;Left&quot;
   if LastTorso ~= &quot;&quot; then
    Ki.Value = Ki.Value - 400
    LastHumanoid.PlatformStand = true
    if LastTorso:findFirstChild(&quot;FloatV&quot;) ~= nil then
     LastTorso:findFirstChild(&quot;FloatV&quot;):Remove()
    end
    for i = 1 , 64 do
     if LastTorso ~= nil and LastHumanoid ~= nil then
      Humanoid.Health = SavedHealth
      Chance = math.random(1, 3)
      if Chance == 1 then
       Data.Physical.PhXP.Value = Data.Physical.PhXP.Value+6
       Data.KiControl.KiXP.Value = Data.KiControl.KiXP.Value+5
       Data.Agility.AXP.Value = Data.Agility.AXP.Value+7
       Chance2 = math.random(1, 3)
       if Chance2 == 1 then
        exp = Instance.new(&quot;Explosion&quot;)
        exp.BlastPressure = 0
        exp.Position = LastTorso.Position
        exp.Parent = workspace
       end
      end
      if i &lt; 63 then
       LastTorso.CFrame = Torso.CFrame * CFrame.new(0, 0, -1.85) * CFrame.Angles(0, 3.14, 0)
       if LastTorso:findFirstChild(&quot;Stay&quot;) ~= nil then
        if LastTorso:findFirstChild(&quot;Stay&quot;).maxForce ~= Vector3.new(0, math.huge, 0) then
         LastTorso:findFirstChild(&quot;Stay&quot;).position = LastTorso.Position
         LastTorso:findFirstChild(&quot;Stay&quot;).maxForce = Vector3.new(0, math.huge, 0)
        end
       end
      end
      Gyro.cframe = CFrame.new(Torso.Position, LastTorso.Position)
      if i &gt;= 63 then
       LastHumanoid:TakeDamage(5)
       LastHumanoid.Sit = true

       exp = Instance.new(&quot;Explosion&quot;)
       exp.BlastPressure = 0
       exp.Position = LastTorso.Position
       exp.Parent = workspace
       LastTorso.Parent.Occupied.Value = false
       if LastTorso.Parent.Occupied:findFirstChild(&quot;EnableScript&quot;) ~= nil then
        LastTorso.Parent.Occupied:findFirstChild(&quot;EnableScript&quot;):Remove()
       end

       LastTorso.Velocity = Torso.CFrame.lookVector * 200
       --[[pie = game.Lighting[&quot;DPScript2&quot;]:clone()
       pie.Parent = LastTorso.Parent
       pie.Disabled = false]]
      end
      LastHumanoid:TakeDamage(0.7)
      if LastPunched == &quot;Left&quot; then
       LastPunched = &quot;Right&quot;
       RightShoulder.C0 = RightShoulder.C0 * CFrame.Angles(0, 0, 1.5)
       LeftShoulder.C0 = LeftShoulder.C0 * CFrame.Angles(0, 0, 1)
       LastTorso.CFrame = LastTorso.CFrame * CFrame.new(0.25, 0.5, -0.25)
       wait(0.01)
       RightShoulder.C0 = RightShoulder.C0 * CFrame.Angles(0, 0, -1)
       LeftShoulder.C0 = LeftShoulder.C0 * CFrame.Angles(0, 0, 1)
       RightHip.C0 = RightHip.C0 * CFrame.Angles(0, 0, 1)
       LeftHip.C0 = LeftHip.C0 * CFrame.Angles(0, 0, -2)
       else
       LastPunched = &quot;Left&quot;
       RightShoulder.C0 = RightShoulder.C0 * CFrame.Angles(0, 0, -1)
       LeftShoulder.C0 = LeftShoulder.C0 * CFrame.Angles(0, 0, -1.5)
       LastTorso.CFrame = LastTorso.CFrame * CFrame.new(-0.25, -0.5, 0.25)
       wait(0.01)
       RightShoulder.C0 = RightShoulder.C0 * CFrame.Angles(0, 0, 1)
       LeftShoulder.C0 = LeftShoulder.C0 * CFrame.Angles(0, 0, 1)
       RightHip.C0 = RightHip.C0 * CFrame.Angles(0, 0, 2)
       LeftHip.C0 = LeftHip.C0 * CFrame.Angles(0, 0, 1)
      end
     end
     wait(0.01)
    end
   end

   wait(1)

   Gyro:Remove()
   Position:Remove()
   Velocity:Remove()

   Humanoid.PlatformStand = false
   Thing.Value = false
   RefreshWelds()
   wait(10)
   end
   wait(7)
   mouse.Icon = &quot;http://www.roblox.com/asset/?id=11624732&quot;
&#9;Activated = false
 end
end 

function onSelected(mouse)
   mouse.Icon = &quot;http://www.roblox.com/asset/?id=11624732&quot;
&#9;mouse.Button1Down:connect(function() Attack(mouse) end)
end

