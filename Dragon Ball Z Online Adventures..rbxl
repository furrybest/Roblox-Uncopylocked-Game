function onPlayerRemoving(player)
&#9;print(&quot;Attempting to save score for &quot; .. player.Name)
&#9;local stats = player:FindFirstChild(&quot;Data&quot;)
&#9;if (stats ~= nil) then 
&#9;&#9;local Race = stats:FindFirstChild(&quot;Race&quot;)
&#9;&#9;if (Race ~= nil) then
&#9;&#9;&#9;saveRace(player, Race.Value)
&#9;&#9;end
&#9;&#9;local Ki = stats:FindFirstChild(&quot;Ki&quot;)
&#9;&#9;if (Ki ~= nil) then
&#9;&#9;&#9;saveKi(player, Ki.Value)
&#9;&#9;end
&#9;&#9;local Hand = stats:FindFirstChild(&quot;Hand&quot;)
&#9;&#9;if (Hand ~= nil) then
&#9;&#9;&#9;saveHand(player, Hand.Value)
&#9;&#9;end

&#9;&#9;local P = stats:FindFirstChild(&quot;Physical&quot;)
&#9;&#9;if (P ~= nil) then
&#9;&#9;&#9;saveP(player, P.Value)
&#9;&#9;&#9;local Pxp = P:FindFirstChild(&quot;PhXP&quot;)
&#9;&#9;&#9;if (Pxp ~= nil) then
&#9;&#9;&#9;&#9;savePxp(player, Pxp.Value)
&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;local C = stats:FindFirstChild(&quot;KiControl&quot;)
&#9;&#9;if (C ~= nil) then
&#9;&#9;&#9;saveC(player, C.Value)
&#9;&#9;&#9;local Cxp = C:FindFirstChild(&quot;KiXP&quot;)
&#9;&#9;&#9;if (Cxp ~= nil) then
&#9;&#9;&#9;&#9;saveCxp(player, Cxp.Value)
&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;local A = stats:FindFirstChild(&quot;Agility&quot;)
&#9;&#9;if (A ~= nil) then
&#9;&#9;&#9;saveA(player, A.Value)
&#9;&#9;&#9;local Axp = A:FindFirstChild(&quot;AXP&quot;)
&#9;&#9;&#9;if (Axp ~= nil) then
&#9;&#9;&#9;&#9;saveAxp(player, Axp.Value)
&#9;&#9;&#9;end
&#9;&#9;end

&#9;&#9;local PLvl = stats:FindFirstChild(&quot;PowerLvl&quot;)
&#9;&#9;if (PLvl ~= nil) then
&#9;&#9;&#9;savePLvl(player, PLvl.Value)
&#9;&#9;end
&#9;end
--[[&#9;local skills = stats:FindFirstChild(&quot;Skills&quot;)
&#9;if (skills ~= nil) then 
&#9;&#9;local BC = skills:FindFirstChild(&quot;BoneCrush&quot;)
&#9;&#9;if (BC ~= nil) then
&#9;&#9;&#9;saveBC(player, BC.Value)
&#9;&#9;end
&#9;&#9;local EW = skills:FindFirstChild(&quot;EnergyWave&quot;)
&#9;&#9;if (EW ~= nil) then
&#9;&#9;&#9;saveEW(player, EW.Value)
&#9;&#9;end
&#9;&#9;local HSR = skills:FindFirstChild(&quot;HighSpeedRush&quot;)
&#9;&#9;if (HSR ~= nil) then
&#9;&#9;&#9;saveHSR(player, HSR.Value)
&#9;&#9;end
&#9;&#9;local EP = skills:FindFirstChild(&quot;EnergyPunch&quot;)
&#9;&#9;if (EP ~= nil) then
&#9;&#9;&#9;saveEP(player, EP.Value)
&#9;&#9;end
&#9;&#9;local HG = skills:FindFirstChild(&quot;HellzoneG&quot;)
&#9;&#9;if (HG ~= nil) then
&#9;&#9;&#9;saveHG(player, HG.Value)
&#9;&#9;end
&#9;&#9;local DF = skills:FindFirstChild(&quot;DragonFist&quot;)
&#9;&#9;if (DF ~= nil) then
&#9;&#9;&#9;saveDF(player, DF.Value)
&#9;&#9;end
&#9;&#9;local IT = skills:FindFirstChild(&quot;InstantT&quot;)
&#9;&#9;if (IT ~= nil) then
&#9;&#9;&#9;saveIT(player, IT.Value)
&#9;&#9;end
&#9;end]]
end

game.Players.PlayerAdded:connect(onPlayerEntered)
game.Players.PlayerRemoving:connect(onPlayerRemoving)</ProtectedString>
