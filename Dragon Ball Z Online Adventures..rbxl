HealthBar = Me.PlayerGui.Bars.Background.HealthBar.Bar
KiBar = Me.PlayerGui.Bars.Background.KiBar.Bar
KiGather = Me.PlayerGui.Bars.Background.KiGather
SmashBar = Me.PlayerGui.Bars.Background.SmashBar.Bar
Scouter1 = Me.PlayerGui.Bars.Background.Scouter1
Scouter2 = Me.PlayerGui.Bars.Background.Scouter2
SavedHP = 100
Ki = script.Parent.Ki
MaxKi = script.Parent.MaxKi
Smash = script.Parent.Smash
MaxSmash = script.Parent.MaxSmash
DP = script.Parent.DP
game.Lighting.Ragdoll:clone().Parent = Me.Character
Me.PlayerGui.Bars.BloodScreen.BackgroundTransparency = 0

while true do
 Humanoid = Me.Character:findFirstChild(&quot;Humanoid&quot;)
 if Humanoid ~= nil then
  if Humanoid.MaxHealth ~= math.huge then
   if Humanoid.Health &lt; SavedHP then
    Me.PlayerGui.Bars.BloodScreen.BackgroundTransparency = 0.6
    SavedHP = Humanoid.Health
    Me.PlayerGui.Bars.BloodScreen.BackgroundColor = BrickColor.new(21)
    else
    Me.PlayerGui.Bars.BloodScreen.BackgroundTransparency = 1
    SavedHP = Humanoid.Health
    Scouter1.Visible = true
   end
  end
  if Humanoid.Health &lt;= 10 then
   SavedHP = Humanoid.Health
   Scouter1.Visible = false
   if Me.PlayerGui.Bars.BloodScreen.BackgroundTransparency &gt; 0.9 then
    Me.PlayerGui.Bars.BloodScreen.BackgroundTransparency = 0.6
    Me.PlayerGui.Bars.BloodScreen.BackgroundColor = BrickColor.new(21)
   end
  end  
  if Me.PlayerGui.Bars.BloodScreen.BackgroundTransparency &gt;= 0.6 and Me.PlayerGui.Bars.BloodScreen.BackgroundTransparency &lt; 1 then
   Me.PlayerGui.Bars.BloodScreen.BackgroundTransparency = Me.PlayerGui.Bars.BloodScreen.BackgroundTransparency + 0.05
  end
  HealthBar.Size = UDim2.new(Me.Character.Humanoid.Health/Me.Character.Humanoid.MaxHealth/-1, 0, 4.3, 0)
  KiBar.Size = UDim2.new(Ki.Value/MaxKi.Value/-1, 0, 2.5, 0)
  SmashBar.Size = UDim2.new(Smash.Value/MaxSmash.Value/1, 0, 1, 0)
  if Ki.Value &gt;= MaxKi.Value then
   KiGather.Style = &quot;RobloxButtonDefault&quot;
   else
   KiGather.Style = &quot;RobloxButton&quot;
  end
  if DP.Value == 0 then
   Me.PlayerGui.Bars.Background.SmashButton.Visible = false
   Me.PlayerGui.Bars.Background.SmashBar.Visible = false
  end
 end
 wait()
end
