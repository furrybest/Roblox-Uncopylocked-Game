								<ProtectedString name="Source">wait(0.1)
Player = script.Parent.Parent.Parent.Parent.Parent
Data = Player:findFirstChild(&quot;Data&quot;)
Character = Player.Character 
PlayerGui = Player.PlayerGui 
Bars = PlayerGui.Bars
Backpack = Player.Backpack 
Humanoid = Character.Humanoid
Torso = Character.Torso 
Head = Character.Head 
LeftArm = Character[&quot;Left Arm&quot;]
RightArm = Character[&quot;Right Arm&quot;]
LeftLeg = Character[&quot;Left Leg&quot;]
RightLeg = Character[&quot;Right Leg&quot;]
Neck = Torso[&quot;Neck&quot;]
RightShoulder = Torso[&quot;Right Shoulder&quot;]
LeftShoulder = Torso[&quot;Left Shoulder&quot;]
RightHip = Torso[&quot;Right Hip&quot;]
LeftHip = Torso[&quot;Left Hip&quot;]

NeckC0 = CFrame.new(0, 1, 0, -1, 0, 0, 0, 0, 1, 0, 1, 0)
NeckC1 = CFrame.new(0, -0.5, 0, -1, 0, 0, 0, 0, 1, 0, 1, 0)
LeftShoulderC0 = CFrame.new(-1, 0.5, 0, 0, 0, -1, 0, 1, 0, 1, 0, 0)
LeftShoulderC1 = CFrame.new(0.5, 0.5, 0, 0, 0, -1, 0, 1, 0, 1, 0, 0)
RightShoulderC0 = CFrame.new(1, 0.5, 0, 0, 0, 1, 0, 1, 0, -1, 0, 0)
RightShoulderC1 = CFrame.new(-0.5, 0.5, 0, 0, 0, 1, 0, 1, 0, -1, 0, 0)
LeftHipC0 = CFrame.new(-1, -1, 0, 0, 0, -1, 0, 1, 0, 1, 0, 0)
LeftHipC1 = CFrame.new(-0.5, 1, 0, 0, 0, -1, 0, 1, 0, 1, 0, 0)
RightHipC0 = CFrame.new(1, -1, 0, 0, 0, 1, 0, 1, 0, -1, 0, 0)
RightHipC1 = CFrame.new(0.5, 1, 0, 0, 0, 1, 0, 1, 0, -1, 0, 0)

function RefreshWelds()
 Neck.C0 = NeckC0
 Neck.C1 = NeckC1
 RightShoulder.C0 = RightShoulderC0
 RightShoulder.C1 = RightShoulderC1
 LeftShoulder.C0 = LeftShoulderC0
 LeftShoulder.C1 = LeftShoulderC1
 RightHip.C0 = RightHipC0
 RightHip.C1 = RightHipC1
 LeftHip.C0 = LeftHipC0
 LeftHip.C1 = LeftHipC1
end

function KiWelds()
 TiltX = 0
 TiltY = 0
 TiltZ = 2.5
 RightShoulder.C0 = RightShoulderC0 * CFrame.Angles(TiltX, TiltY, TiltZ)
 LeftShoulder.C0 = LeftShoulderC0 * CFrame.Angles(TiltX, TiltY, -TiltZ)
 TiltX = -0.05
 TiltY = 0
 Stuff = 0.3
 TiltZ = 1
 MoveX = 0
 MoveY = 0.1
 MoveZ = 0
 Neck.C0 = NeckC0 * CFrame.Angles(Stuff, TiltY, TiltY)
 RightHip.C0 = RightHipC0 * CFrame.Angles(TiltX, TiltY, TiltZ) * CFrame.new(MoveX, MoveY, MoveZ)
 LeftHip.C0 = LeftHipC0 * CFrame.Angles(TiltX, TiltY, -TiltZ) * CFrame.new(MoveX, MoveY, MoveZ)
end

local reset = script.Parent
local Ki = Bars.Ki
local MaxKi = Bars.MaxKi
local Charging = false
local wave = Instance.new(&quot;Part&quot;)
wave.Name = &quot;Aura&quot;
wave.Locked = true
wave.Anchored = false
wave.CanCollide = false
wave.formFactor = &quot;Symmetric&quot;
wave.TopSurface = &quot;Smooth&quot;
wave.BottomSurface = &quot;Smooth&quot;
wave.Size = Vector3.new(1, 1, 1)
wave.Reflectance = 0.02
wave.Transparency = 0.6
if Data.Ki.Value == 1 then
wave.BrickColor = BrickColor.new(23)
elseif Data.Ki.Value == 2 then
wave.BrickColor = BrickColor.new(21)
elseif Data.Ki.Value == 3 then
wave.BrickColor = BrickColor.new(1023)
elseif Data.Ki.Value == 4 then
wave.BrickColor = BrickColor.new(106)
elseif Data.Ki.Value == 5 then
wave.BrickColor = BrickColor.new(37)
elseif Data.Ki.Value == 6 then
wave.BrickColor = BrickColor.new(26)
elseif Data.Ki.Value == 7 then
wave.BrickColor = BrickColor.new(1)
end
local growing = true
local grow = 0
reset.MouseButton1Down:connect(function()
if Humanoid.PlatformStand == false then
Charging = true
Bars.Charging.Value = true
Humanoid.WalkSpeed = 0
KiWelds()
local Aura = wave:clone()
Aura.Parent = Character
Weld = Instance.new(&quot;Weld&quot;)
Weld.Parent = Torso
Weld.Part0 = Torso
Weld.Part1 = Aura
Weld.C0 = CFrame.new(0, 0, 0)
Mesh = Instance.new(&quot;SpecialMesh&quot;)
Mesh.MeshType = &quot;FileMesh&quot;
Mesh.MeshId = &quot;http://www.roblox.com/asset/?id=20329976&quot;
Mesh.Scale = Vector3.new(0, 1, 0)
Mesh.Parent = Aura
delay(0,function()
while (Charging) do
if Ki.Value &lt; MaxKi.Value then
Ki.Value = Ki.Value + 2
chance = math.random(1, 2)
if chance == 1 then
Data.KiControl.KiXP.Value = Data.KiControl.KiXP.Value + 1
end
end
Humanoid.WalkSpeed = 0
KiWelds()
--------------------------------------

--------------------------------------
if (growing == true) then
grow = grow + 0.2
end
if (growing == false) then
grow = grow - 0.2
end
if (grow &gt;= 4.4) then
growing = false
end
if (grow &lt;= 3.15) then
growing = true
end
Mesh.Scale = Vector3.new(grow, grow*2, grow)
--------------------------------------
wait()
end
if Ki.Value &gt;= MaxKi.Value then
Charging = false
Bars.Charging.Value = false
Humanoid.WalkSpeed = 16
RefreshWelds()
Pie = Character:findFirstChild(&quot;Aura&quot;)
if Pie ~= nil then
Pie:Remove()
end
end
end)
end
reset.MouseButton1Up:connect(function()
Charging = false
Bars.Charging.Value = false
Humanoid.WalkSpeed = 16
RefreshWelds()
Pie = Character:findFirstChild(&quot;Aura&quot;)
if Pie ~= nil then
Pie:Remove()
end
end)
reset.MouseLeave:connect(function()
Charging = false
Bars.Charging.Value = false
Humanoid.WalkSpeed = 16
RefreshWelds()
Pie = Character:findFirstChild(&quot;Aura&quot;)
if Pie ~= nil then
Pie:Remove()
end
end)
end)

