&#9;player:SaveNumber(&quot;BoneCrush&quot;, playerBC)
end
function saveEW(player, playerEW)
&#9;player:SaveNumber(&quot;EnergyWave&quot;, playerEW)
end
function saveEP(player, playerEP)
&#9;player:SaveNumber(&quot;EnergyPunch&quot;, playerEP)
end
function saveHSR(player, playerHSR)
&#9;player:SaveNumber(&quot;HighSpeedRush&quot;, playerHSR)
end
function saveHG(player, playerHG)
&#9;player:SaveNumber(&quot;HellzoneG&quot;, playerHG)
end
function saveDF(player, playerDF)
&#9;player:SaveNumber(&quot;DragonFist&quot;, playerDF)
end
function saveIT(player, playerIT)
&#9;player:SaveNumber(&quot;InstantT&quot;, playerIT)
end
]]
-------------------------------------[[  LOADING  ]]-------------------------------------

function loadRace(player, Race)
&#9;local playerRace = player:LoadNumber(&quot;Race&quot;) 

&#9;if playerRace ~= 0 then
&#9;&#9;Race.Value = playerRace
&#9;else
&#9;&#9;print(&quot;Nothing to load&quot;)
&#9;end

end

function loadKi(player, Ki)
&#9;local playerKi = player:LoadNumber(&quot;Ki&quot;) 

&#9;if playerKi ~= 0 then
&#9;&#9;Ki.Value = playerKi
&#9;else
&#9;&#9;print(&quot;Nothing to load&quot;)
&#9;end

end

