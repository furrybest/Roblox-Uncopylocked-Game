							<ProtectedString name="Source">wait(0.1)
Button = script.Parent
Main = Button.Parent
PlayerGui = Main.Parent
player = PlayerGui.Parent
stats = player.Data

Activated = false

function saveRace(player, playerRace)
&#9;player:SaveNumber(&quot;Race&quot;, playerRace)
end

function saveKi(player, playerKi)
&#9;player:SaveNumber(&quot;Ki&quot;, playerKi)
end

function saveHand(player, playerHand)
&#9;player:SaveNumber(&quot;Hand&quot;, playerHand)
end

function saveP(player, playerP)
&#9;player:SaveNumber(&quot;Physical&quot;, playerP)
end
function savePxp(player, playerPxp)
&#9;player:SaveNumber(&quot;PhXP&quot;, playerPxp)
end

function saveC(player, playerC)
&#9;player:SaveNumber(&quot;KiControl&quot;, playerC)
end
function saveCxp(player, playerCxp)
&#9;player:SaveNumber(&quot;KiXP&quot;, playerCxp)
end

function saveA(player, playerA)
&#9;player:SaveNumber(&quot;Agility&quot;, playerA)
end
function saveAxp(player, playerAxp)
&#9;player:SaveNumber(&quot;AXP&quot;, playerAxp)
end

function savePLvl(player, playerPLvl)
&#9;player:SaveNumber(&quot;PowerLvl&quot;, playerPLvl)
end

function Save()
&#9;print(&quot;Attempting to save score for &quot; .. player.Name)
&#9;local stats = player:findFirstChild(&quot;Data&quot;)
&#9;if (stats ~= nil and not Activated) then 
&#9;&#9;Activated = true
&#9;&#9;M = Instance.new(&quot;Message&quot;)
&#9;&#9;M.Parent = PlayerGui
&#9;&#9;M.Text = &quot;Saving...&quot;
&#9;&#9;wait(1)
&#9;&#9;local Race = stats:FindFirstChild(&quot;Race&quot;)
&#9;&#9;if (Race ~= nil) then
&#9;&#9;&#9;saveRace(player, Race.Value)
&#9;&#9;end
&#9;&#9;local Ki = stats:FindFirstChild(&quot;Ki&quot;)
&#9;&#9;if (Ki ~= nil) then
&#9;&#9;&#9;saveKi(player, Ki.Value)
&#9;&#9;end
&#9;&#9;local Hand = stats:FindFirstChild(&quot;Hand&quot;)
&#9;&#9;if (Hand ~= nil) then
&#9;&#9;&#9;saveHand(player, Hand.Value)
&#9;&#9;end

&#9;&#9;local P = stats:FindFirstChild(&quot;Physical&quot;)
&#9;&#9;if (P ~= nil) then
&#9;&#9;&#9;saveP(player, P.Value)
&#9;&#9;&#9;local Pxp = P:FindFirstChild(&quot;PhXP&quot;)
&#9;&#9;&#9;if (Pxp ~= nil) then
&#9;&#9;&#9;&#9;savePxp(player, Pxp.Value)
&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;local C = stats:FindFirstChild(&quot;KiControl&quot;)
&#9;&#9;if (C ~= nil) then
&#9;&#9;&#9;saveC(player, C.Value)
&#9;&#9;&#9;local Cxp = C:FindFirstChild(&quot;KiXP&quot;)
&#9;&#9;&#9;if (Cxp ~= nil) then
&#9;&#9;&#9;&#9;saveCxp(player, Cxp.Value)
&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;local A = stats:FindFirstChild(&quot;Agility&quot;)
&#9;&#9;if (A ~= nil) then
&#9;&#9;&#9;saveA(player, A.Value)
&#9;&#9;&#9;local Axp = A:FindFirstChild(&quot;AXP&quot;)
&#9;&#9;&#9;if (Axp ~= nil) then
&#9;&#9;&#9;&#9;saveAxp(player, Axp.Value)
&#9;&#9;&#9;end
&#9;&#9;end

&#9;&#9;local PLvl = stats:FindFirstChild(&quot;PowerLvl&quot;)
&#9;&#9;if (PLvl ~= nil) then
&#9;&#9;&#9;savePLvl(player, PLvl.Value)
&#9;&#9;end
&#9;end
&#9;&#9;wait(math.random(1, 3))
&#9;&#9;M.Text = &quot;Saved&quot;
&#9;&#9;wait(2)
&#9;&#9;M:Remove()
&#9;&#9;Activated = false
&#9;&#9;wait(0.1)
end
Button.MouseButton1Click:connect(Save)













