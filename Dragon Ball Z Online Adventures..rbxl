								<string name="Name">Script</string>
								<ProtectedString name="Source">Frame = script.Parent.Parent
PlayerGui = Frame.Parent.Parent
Me = PlayerGui.Parent
Character = Me.Character
Button = Frame[&quot;Exit&quot;]


Activated = false

function onMouseButton1Click()
&#9;if Activated == false then
&#9;&#9;Activated = true
&#9;&#9;Frame.Visible = false
&#9;&#9;Activated = false
&#9;end
end
