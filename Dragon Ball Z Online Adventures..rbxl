			<Item class="Script" referent="RBX2579">
				<Properties>
					<bool name="Archivable">true</bool>
					<bool name="Disabled">true</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">RightSmash</string>
					<ProtectedString name="Source">Tool = script.Parent

-- 1: http://www.roblox.com/asset/?id=42907471
-- 2: http://www.roblox.com/asset/?id=49610228
-- 3: http://www.roblox.com/asset/?id=29268434
-- 4: http://www.roblox.com/asset/?id=7663075
-- 4: http://www.roblox.com/asset/?id=16251577

Activated = false

function onTouched(hit)
 Player = game.Players:GetPlayerFromCharacter(hit.Parent)
 if Player ~= nil then

  Backpack = Player.Backpack
  PlayerGui = Player.PlayerGui
  Character = Player.Character
  Humanoid = Character.Humanoid
  Torso = Character.Torso
  Head = Character.Head

  Smash = PlayerGui.Bars.Smash
  DP = PlayerGui.Bars.DP

  if DP.Value ~= 0 and Humanoid.Health &gt; 0 and (Torso.Position-Tool.Position).magnitude &lt;= Tool.Size.Z/2.5 then
  if Torso:findFirstChild(&quot;SmashWeld&quot;) == nil and not Activated then
  Humanoid.PlatformStand = true
  Activated = true

  if Torso:findFirstChild(&quot;FloatV&quot;) ~= nil then
   Torso:findFirstChild(&quot;FloatV&quot;):Remove()
  end

  Part = Instance.new(&quot;Part&quot;)
  Part.Parent = workspace
  Part.Anchored = true
  Part.formFactor = &quot;Symmetric&quot;
  Part.CanCollide = false
  Part.Name = Player.Name..&quot;SmashPart&quot;
  Part.TopSurface = &quot;Smooth&quot;
  Part.BottomSurface = &quot;Smooth&quot;
  Part.Transparency = 1
  Part.Size = Vector3.new(5, 1, 7)
  Part.CFrame = CFrame.new(Tool.Position)
  m = Instance.new(&quot;SpecialMesh&quot;)
  m.MeshType = &quot;Brick&quot;
  m.Scale = Vector3.new(1, 0.2, 1)
  m.Parent = Part
  game:getService(&quot;Debris&quot;):AddItem(Part, 5)

  hitPos=hit.Position*Vector3.new(0, 1, 1)
  hight=(script.Parent.Position*Vector3.new(1, 0, 0)) + script.Parent.Size*Vector3.new(-0.5, 0, 0)

  Part.CFrame=CFrame.new(hitPos+hight)*CFrame.Angles(1.57, 0, 1.57)
  Torso.CFrame = CFrame.new(Part.Position+Vector3.new(0.3, 0, 0)) * CFrame.Angles(0, 4.71, math.random(-3, 3))
  --hitPos=hit.Position
  --hight=(script.Parent.Position*Vector3.new(0, 1, 0)) + script.Parent.Size*Vector3.new(0, 0.5, 0)

  Weld = Instance.new(&quot;Weld&quot;)
  Weld.Name = &quot;SmashWeld&quot;
  Weld.Parent = Torso
  Weld.Part0 = Torso
  Weld.Part1 = Part
  Weld.C0 = CFrame.new(0, 0, 0)*CFrame.Angles(0, 0, 0)

  d = Instance.new(&quot;Decal&quot;)
  d.Parent = Part
  d.Face = &quot;Bottom&quot;
  if DP.Value == 1 then
   Humanoid:TakeDamage(3)
   d.Texture = &quot;http://www.roblox.com/asset/?id=42907471&quot;
   m.Scale = Vector3.new(1, 0.2, 0.75)
  end
  if DP.Value == 2 then
   Humanoid:TakeDamage(5)
   d.Texture = &quot;http://www.roblox.com/asset/?id=49610228&quot;
   m.Scale = Vector3.new(1.2, 0.2, 1)
  end
  if DP.Value == 3 then
   Humanoid:TakeDamage(7)
   d.Texture = &quot;http://www.roblox.com/asset/?id=29268434&quot;
   m.Scale = Vector3.new(2, 0.2, 1.2)
  end
  if DP.Value == 4 then
   Humanoid:TakeDamage(10)
   d.Texture = &quot;http://www.roblox.com/asset/?id=16251577&quot;
   m.Scale = Vector3.new(1.75, 0.2, 1.75)
  end

  PlayerGui.Bars.Background.SmashButton.Visible = true
  end
  end
  Activated = false
 end
end

script.Parent.Touched:connect(onTouched)
</ProtectedString>
