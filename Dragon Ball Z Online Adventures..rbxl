DP = script.Parent.DP
Smash = script.Parent.Smash
MaxSmash = script.Parent.MaxSmash
SmashBar = script.Parent.Background.SmashBar
SmashButton = script.Parent.Background.SmashButton

Activated = false
ClickCount = 0

SmashButton.MouseButton1Down:connect(function()
 if not Activated then
  Activated = true
  if SmashBar.Visible == false then
   SmashBar.Visible = true
   Smash.Value = ClickCount
   MaxSmash.Value = DP.Value*5
   Weld = Torso:findFirstChild(&quot;SmashWeld&quot;)
   if Weld == nil then
    ClickCount = 0
    DP.Value = 0
    SmashButton.Visible = false
    SmashBar.Visible = false
    Smash.Value = 0
    MaxSmash.Value = 0
    wait(1)
    Humanoid.PlatformStand = false
    PlayerGui.Main.Float.Selected = false
    PlayerGui.Main.Float.Script.Disabled = false
   end
  end
  if ClickCount &gt;= DP.Value*5 then
   ClickCount = 0
   DP.Value = 0
   Weld = Torso:findFirstChild(&quot;SmashWeld&quot;)
   if Weld ~= nil then
    for i, v in pairs(workspace:GetChildren()) do
     if v.Name == Me.Name..&quot;SmashPart&quot; then
      if v:findFirstChild(&quot;Remover&quot;) == nil then
       game.Lighting.Remover:clone().Parent = v
      end
     end
    end
    Weld:Remove()
    SmashButton.Visible = false
    SmashBar.Visible = false
    Smash.Value = 0
    MaxSmash.Value = 0
    wait(1)
    Humanoid.PlatformStand = false
    PlayerGui.Main.Float.Selected = false
    PlayerGui.Main.Float.Script.Disabled = false
   end
   else
   ClickCount = ClickCount + 1
   Smash.Value = ClickCount - 1
  end
  wait(0.01)
  Activated = false
 end
end)
