				<Item class="Script" referent="RBX1401">
					<Properties>
						<bool name="Archivable">true</bool>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">DesertSmash</string>
						<ProtectedString name="Source">Tool = script.Parent

-- 1: http://www.roblox.com/asset/?id=42907471
-- 2: http://www.roblox.com/asset/?id=49610228
-- 3: http://www.roblox.com/asset/?id=29268434
-- 4: http://www.roblox.com/asset/?id=7663075
-- 4: http://www.roblox.com/asset/?id=16251577

Activated = false

function onTouched(hit)
 Player = game.Players:GetPlayerFromCharacter(hit.Parent)
 if Player ~= nil then

  Backpack = Player.Backpack
  PlayerGui = Player.PlayerGui
  Character = Player.Character
  Humanoid = Character.Humanoid
  Torso = Character.Torso
  Head = Character.Head

  Smash = PlayerGui.Bars.Smash
  DP = PlayerGui.Bars.DP

  if DP.Value ~= 0 and Humanoid.Health &gt; 0 then
  if Torso:findFirstChild(&quot;SmashWeld&quot;) == nil and not Activated then
  Humanoid.PlatformStand = true
  Activated = true

  if Torso:findFirstChild(&quot;FloatV&quot;) ~= nil then
   Torso:findFirstChild(&quot;FloatV&quot;):Remove()
  end

  Part = Instance.new(&quot;Part&quot;)
  Part.Parent = workspace
  Part.Anchored = true
  Part.formFactor = &quot;Symmetric&quot;
  Part.CanCollide = false
  Part.Name = Player.Name..&quot;SmashPart&quot;
  Part.TopSurface = &quot;Smooth&quot;
  Part.BottomSurface = &quot;Smooth&quot;
  Part.BrickColor = BrickColor.new(&quot;Dark orange&quot;)
  Part.Transparency = 0
  Part.Size = Vector3.new(5, 1, 7)
  Part.CFrame = CFrame.new(Tool.Position)
  game:getService(&quot;Debris&quot;):AddItem(Part, 5)

  hitPos=hit.Position*Vector3.new(1, 0, 1)
  hight=(script.Parent.Position*Vector3.new(0, 1, 0)) + script.Parent.Size*Vector3.new(0, 0.5, 0)

  Part.CFrame=CFrame.new(hitPos+hight)*CFrame.Angles(0, math.random(-3, 3), 0)
  Torso.CFrame = CFrame.new(Part.Position+Vector3.new(0, 0.3, 0)) * CFrame.Angles(1.57, 0, 0)
  --hitPos=hit.Position
  --hight=(script.Parent.Position*Vector3.new(0, 1, 0)) + script.Parent.Size*Vector3.new(0, 0.5, 0)

  Weld = Instance.new(&quot;Weld&quot;)
  Weld.Name = &quot;SmashWeld&quot;
  Weld.Parent = Torso
  Weld.Part0 = Torso
  Weld.Part1 = Part
  Weld.C0 = CFrame.new(0, 0, 0)*CFrame.Angles(0, math.random(-3, 3), 0)

  Cloud = game.Lighting.DesertCloud:clone()
  Cloud.Parent = Workspace
  Cloud.Position = Torso.Position

  PlayerGui.Bars.Background.SmashButton.Visible = true

  for i = 1 , 5 do
   p = Instance.new(&quot;Part&quot;)
   p.Parent = game.Workspace
   chance = math.random(1, 3)
   if chance == 1 then
    p.BrickColor = BrickColor.new(&quot;Nougat&quot;)
    else
    p.BrickColor = BrickColor.new(&quot;Dark orange&quot;)
   end
   p.TopSurface = &quot;Smooth&quot;
   p.BottomSurface = &quot;Smooth&quot;
   p.Size = Vector3.new(math.random(3, 7), math.random(3, 7), math.random(3, 7))
   p.CFrame = Torso.CFrame * CFrame.new(Vector3.new(math.random(-4, 4), -6, math.random(-4, 4))) * CFrame.Angles(math.random(-3, 3), math.random(-3, 3), math.random(-3, 3))
   p.Velocity = Vector3.new(0, 7, 0)
   game:getService(&quot;Debris&quot;):AddItem(p, 5)
   wait()
  end

  end
  end
  Activated = false
 end
end

