						<ProtectedString name="Source">wait(0.05)
Bin = script.Parent
Backpack = Bin.Parent
Me = Backpack.Parent
Character = Me.Character
Humanoid = Character.Humanoid
Data = Me.Data
Torso = Character.Torso
