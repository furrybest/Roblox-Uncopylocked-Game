Button = script.Parent.Button
Shop = Button.Parent.Stuff
Stats = Shop.Parent.Parent.Stats.Stuff
StatsButton = Stats.Parent.Button
PlayerGui = Button.Parent.Parent.Parent
Me = PlayerGui.Parent
Backpack = Me.Backpack
Data = Me:findFirstChild(&quot;Data&quot;)
Physical = Data.Physical
Speed = Data.Agility
Control = Data.KiControl
Phys = Shop.Slot1
Ki = Shop.Slot2
Trans = Shop.Slot3

Activated = false

function onClick()
 if not Activated then
  if (Button.Text == &quot;View Skill Dojo&quot;) then
   Activated = true
   Button.Text = &quot;Close Skill Dojo&quot;
   if Stats.Visible == true then
    StatsButton.Text = &quot;View Stats&quot;
    Stats.Visible = false
   end
   wait(0.1)
   Shop.Visible = true
   Activated = false
   else Button.Text = &quot;View Skill Dojo&quot;
   Activated = true
   Shop.Visible = false
   wait(0.1)
   Activated = false
  end
 end
end
Button.MouseButton1Down:connect(onClick)

function onStatsClick()
 if (StatsButton.Text == &quot;View Stats&quot;) then
  StatsButton.Text = &quot;Close Stats&quot;
  if Shop.Visible == true then
   Button.Text = &quot;View Skill Dojo&quot;
   Shop.Visible = false
  end
  Stats.Visible = true
  else StatsButton.Text = &quot;View Stats&quot;
  Stats.Visible = false
 end
 wait(0.1)
end
StatsButton.MouseButton1Down:connect(onStatsClick)

function onPhys()
 if not Activated then
  Activated = true
  Ki.Visible = false
  Trans.Visible = false
  Shop.Ki.BorderColor = BrickColor.new(&quot;Really black&quot;)
  Shop.Trans.BorderColor = BrickColor.new(&quot;Really black&quot;)
  wait(0.1)
  Shop.Phys.BorderColor = BrickColor.new(&quot;Really red&quot;)
  Phys.Visible = true
  Activated = false
 end
end
Shop.Phys.MouseButton1Down:connect(onPhys)

function onKi()
 if not Activated then
  Activated = true
  Phys.Visible = false
  Trans.Visible = false
  Shop.Phys.BorderColor = BrickColor.new(&quot;Really black&quot;)
  Shop.Trans.BorderColor = BrickColor.new(&quot;Really black&quot;)
  wait(0.1)
  Shop.Ki.BorderColor = BrickColor.new(&quot;Really red&quot;)
  Ki.Visible = true
  Activated = false
 end
end
Shop.Ki.MouseButton1Down:connect(onKi)

function onTrans()
 if not Activated then
  Activated = true
  Ki.Visible = false
  Phys.Visible = false
  Shop.Ki.BorderColor = BrickColor.new(&quot;Really black&quot;)
  Shop.Phys.BorderColor = BrickColor.new(&quot;Really black&quot;)
  wait(0.1)
  Shop.Trans.BorderColor = BrickColor.new(&quot;Really red&quot;)
  Trans.Visible = true
  Activated = false
 end
end
Shop.Trans.MouseButton1Down:connect(onTrans)

-- [[ Skills ]] --

function AEW()
 if not Activated then
  if Ki.Column3.Move.AEW.BackgroundColor == BrickColor.new(&quot;New Yeller&quot;) then
   Activated = true
   M = Instance.new(&quot;Message&quot;)
   M.Parent = PlayerGui
   if Backpack:findFirstChild(&quot;Aggressive Energy Wave&quot;) == nil then
    M.Text = &quot;You have learned a new Skill!&quot;
    game.Lighting[&quot;Aggressive Energy Wave&quot;]:clone().Parent = Backpack
    wait(1)
    M:Remove()
    wait(0.1)
    Activated = false
    else
    Activated = true
    M.Text = &quot;You already have that!&quot;
    wait(1)
    M:Remove()
    wait(0.1)
    Activated = false
   end
  end
 end
end
Ki.Column3.Move.AEW.MouseButton1Down:connect(AEW)

