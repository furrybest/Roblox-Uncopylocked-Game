						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Starter</string>
						<ProtectedString name="Source">--[[Due to problems with this tool, this script will be used to get the weapon working]]--
S = script.Parent[&quot;Bin Script&quot;]
SS = S:clone()
S:remove()
SS.Parent = script.Parent</ProtectedString>
