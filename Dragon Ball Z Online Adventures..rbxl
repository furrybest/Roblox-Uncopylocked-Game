						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Bin Script</string>
						<ProtectedString name="Source">Bin = script.Parent
Backpack = Bin.Parent
Me = Backpack.Parent
PlayerGui = Me.PlayerGui
Ki = PlayerGui.Bars.Ki
Character = Me.Character
Data = Me.Data
Humanoid = Character.Humanoid
Torso = Character.Torso
Head = Character.Head
LeftArm = Character[&quot;Left Arm&quot;]
RightArm = Character[&quot;Right Arm&quot;]
LeftLeg = Character[&quot;Left Leg&quot;]
RightLeg = Character[&quot;Right Leg&quot;]
Neck = Torso[&quot;Neck&quot;]
RightShoulder = Torso[&quot;Right Shoulder&quot;]
LeftShoulder = Torso[&quot;Left Shoulder&quot;]
RightHip = Torso[&quot;Right Hip&quot;]
LeftHip = Torso[&quot;Left Hip&quot;]

NeckC0 = CFrame.new(0, 1, 0, -1, 0, 0, 0, 0, 1, 0, 1, 0)
NeckC1 = CFrame.new(0, -0.5, 0, -1, 0, 0, 0, 0, 1, 0, 1, 0)
LeftShoulderC0 = CFrame.new(-1, 0.5, 0, 0, 0, -1, 0, 1, 0, 1, 0, 0)
LeftShoulderC1 = CFrame.new(0.5, 0.5, 0, 0, 0, -1, 0, 1, 0, 1, 0, 0)
RightShoulderC0 = CFrame.new(1, 0.5, 0, 0, 0, 1, 0, 1, 0, -1, 0, 0)
RightShoulderC1 = CFrame.new(-0.5, 0.5, 0, 0, 0, 1, 0, 1, 0, -1, 0, 0)
LeftHipC0 = CFrame.new(-1, -1, 0, 0, 0, -1, 0, 1, 0, 1, 0, 0)
LeftHipC1 = CFrame.new(-0.5, 1, 0, 0, 0, -1, 0, 1, 0, 1, 0, 0)
RightHipC0 = CFrame.new(1, -1, 0, 0, 0, 1, 0, 1, 0, -1, 0, 0)
RightHipC1 = CFrame.new(0.5, 1, 0, 0, 0, 1, 0, 1, 0, -1, 0, 0)

function RefreshWelds()
Neck.C0 = NeckC0
Neck.C1 = NeckC1
RightShoulder.C0 = RightShoulderC0
RightShoulder.C1 = RightShoulderC1
LeftShoulder.C0 = LeftShoulderC0
LeftShoulder.C1 = LeftShoulderC1
RightHip.C0 = RightHipC0
RightHip.C1 = RightHipC1
LeftHip.C0 = LeftHipC0
LeftHip.C1 = LeftHipC1
end

function ChakraWelds()
 TiltX = 0
 TiltY = 0
 TiltZ = 1.57
 RightShoulder.C0 = RightShoulderC0 * CFrame.Angles(TiltX, TiltY, TiltZ)
 LeftShoulder.C0 = LeftShoulderC0 * CFrame.Angles(TiltX, TiltY, -TiltZ)
 TiltX = 0.6
 TiltY = 0
 TiltZ = 0
 MoveX = 0
 MoveY = 0
 MoveZ = -0.3
 RightShoulder.C0 = RightShoulder.C0 * CFrame.Angles(TiltX, TiltY, TiltZ) * CFrame.new(MoveX, MoveY, MoveZ)
 LeftShoulder.C0 = LeftShoulder.C0 * CFrame.Angles(TiltX, TiltY, TiltZ) * CFrame.new(MoveX, MoveY, MoveZ)
 TiltX = -0.05
 TiltY = 0
 TiltZ = 0
 MoveX = 0
 MoveY = 0.1
 MoveZ = 0
 RightHip.C0 = RightHipC0 * CFrame.Angles(TiltX, TiltY, TiltZ) * CFrame.new(MoveX, MoveY, MoveZ)
 LeftHip.C0 = LeftHipC0 * CFrame.Angles(TiltX, TiltY, TiltZ) * CFrame.new(MoveX, MoveY, MoveZ)
end

Activated = false
Thing = Character.Occupied

function Attack(mouse)

mouse.Icon = &quot;http://www.roblox.com/asset/?id=41672909&quot;
if not Activated then
if Ki.Value &gt;= 180 and Thing.Value == false then
Activated = true
RightShoulder.MaxVelocity = 0
RightShoulder.CurrentAngle = 0
LeftShoulder.MaxVelocity = 0
LeftShoulder.CurrentAngle = 0

for i = 1 , 6 do
RightShoulder.C0 = RightShoulderC0 * CFrame.Angles(0, 0, -0.15*i)
LeftShoulder.C0 = LeftShoulderC0 * CFrame.Angles(0, 0, 0.15*i)
RightHip.C0 = RightHipC0 * CFrame.Angles(0, 0, 0.31*i)
LeftHip.C0 = LeftHipC0 * CFrame.Angles(0, 0, 0.035*i)
wait()
end
for i, v in pairs(workspace:GetChildren()) do
eTorso = v:findFirstChild(&quot;Torso&quot;)
eHumanoid = v:findFirstChild(&quot;Humanoid&quot;)
if eTorso ~= nil and eHumanoid ~= nil and v.Name ~= Me.Name then
if (Torso.Position-eTorso.Position).magnitude &lt;= 5 then
Thing.Value = true
v.Occupied.Value = true
game.Lighting.EnableScript:clone().Parent = v.Occupied
Ki.Value = Ki.Value - 180
Gyro = Instance.new(&quot;BodyGyro&quot;)
Gyro.Parent = Torso
Gyro.D = 50
Gyro.maxTorque = Vector3.new(0,0,0)
Gyro.cframe = Torso.CFrame
Position = Instance.new(&quot;BodyPosition&quot;)
Position.Parent = Torso
Position.maxForce = Vector3.new(0, 0, 0)
RefreshWelds()
eHumanoid.PlatformStand = true
if eTorso:findFirstChild(&quot;FloatV&quot;) ~= nil then
eTorso:findFirstChild(&quot;FloatV&quot;):Remove()
end
eHumanoid:TakeDamage(5)
Humanoid.WalkSpeed = 0
wait()
ePosition = Instance.new(&quot;BodyPosition&quot;)
ePosition.Parent = eTorso
ePosition.position = eTorso.Position
ePosition.maxForce = Vector3.new(math.huge, math.huge, math.huge)
eGyro = Instance.new(&quot;BodyGyro&quot;)
eGyro.Parent = eTorso
eGyro.D = 50
eGyro.maxTorque = Vector3.new(math.huge, math.huge, math.huge)
eGyro.cframe = CFrame.new(0, 0, 0) * CFrame.Angles(0, 0, 0)
Gyro.cframe = CFrame.new(0, 0, 0) * CFrame.Angles(0, 0, 0)
Gyro.maxTorque = Vector3.new(math.huge, math.huge, math.huge)
eGyro.cframe = CFrame.new(eTorso.Position, Torso.Position)
wait(0.1)
Torso.CFrame = eTorso.CFrame * CFrame.new(0, 0, 1.4)
wait(0.01)
Position.position = Torso.Position
Position.maxForce = Vector3.new(math.huge, math.huge, math.huge)
ePosition.position = eTorso.Position
ePosition.maxForce = Vector3.new(math.huge, math.huge, math.huge)
ChakraWelds()

   LastPunched = &quot;Left&quot;
    for i = 1 , 20 do
     if eTorso ~= nil and eHumanoid ~= nil then
      Chance = math.random(1, 3)
      if Chance == 1 then
       Data.Physical.PhXP.Value = Data.Physical.PhXP.Value+5
       Data.Agility.AXP.Value = Data.Agility.AXP.Value+10
      end
      eTorso.CFrame = Torso.CFrame * CFrame.new(0, 0, -1.4) * CFrame.Angles(0, 3.14, 0)
      Gyro.cframe = CFrame.new(Torso.Position, eTorso.Position)
      eGyro.cframe = CFrame.new(eTorso.Position, Torso.Position)
      eHumanoid.PlatformStand = true
      Humanoid.PlatformStand = true
      eHumanoid:TakeDamage(0.5)
      if LastPunched == &quot;Left&quot; then
       LastPunched = &quot;Right&quot;
       RightShoulder.C0 = RightShoulderC0 * CFrame.Angles(0, 0, -1.5)
       LeftShoulder.C0 = LeftShoulderC0 * CFrame.Angles(0, 0, -1.5)
       eTorso.CFrame = eTorso.CFrame * CFrame.new(0.25, 0.5, -0.25)
       wait(0.01)
       RightShoulder.C0 = RightShoulderC0 * CFrame.Angles(0, 0, 1.5)
       LeftShoulder.C0 = LeftShoulderC0 * CFrame.Angles(0, 0, 1.5)
       RightHip.C0 = RightHipC0 * CFrame.Angles(0, 0, 1)
       LeftHip.C0 = LeftHipC0 * CFrame.Angles(0, 0, -2)
       else
       LastPunched = &quot;Left&quot;
       RightShoulder.C0 = RightShoulderC0 * CFrame.Angles(0, 0, -1.5)
       LeftShoulder.C0 = LeftShoulderC0 * CFrame.Angles(0, 0, -1.5)
       eTorso.CFrame = eTorso.CFrame * CFrame.new(-0.25, -0.5, 0.25)
       wait(0.01)
       RightShoulder.C0 = RightShoulderC0 * CFrame.Angles(0, 0, 1.5)
       LeftShoulder.C0 = LeftShoulderC0 * CFrame.Angles(0, 0, 1.5)
       RightHip.C0 = RightHipC0 * CFrame.Angles(0, 0, 2)
       LeftHip.C0 = LeftHipC0 * CFrame.Angles(0, 0, 1)
      end
     end
     wait(0.01)
   end
wait(0.1)
ChakraWelds()

eHumanoid:TakeDamage(5)
eGyro.maxTorque = Vector3.new(0, 0, 0)
Chance = math.random(1, 3)
if Chance == 1 then
 Data.Physical.PhXP.Value = Data.Physical.PhXP.Value+70
 Data.Agility.AXP.Value = Data.Agility.AXP.Value+100
 else
 Data.Physical.PhXP.Value = Data.Physical.PhXP.Value+40
 Data.Agility.AXP.Value = Data.Agility.AXP.Value+50
end
RefreshWelds()
Position.position = eTorso.Position + Vector3.new(0, 50, 0)
Gyro.cframe = CFrame.new(Torso.Position, eTorso.Position)
&#9;Chance = math.random(1, 2)
&#9;if Chance == 1 then
&#9;&#9;Data.KiControl.KiXP.Value = Data.KiControl.KiXP.Value+190
&#9;&#9;else
&#9;&#9;Data.KiControl.KiXP.Value = Data.KiControl.KiXP.Value+130
&#9;end
   LeftShoulder.C0 = LeftShoulderC0 * CFrame.Angles(0, 0, -1.57)
   RightShoulder.C0 = RightShoulderC0 * CFrame.Angles(0, 0, 1.57)
   wait(0.7)
&#9;Energy = Instance.new(&quot;Part&quot;)
&#9;Energy.Parent = Head
&#9;Energy.formFactor = &quot;Symmetric&quot;
&#9;Energy.CanCollide = false
&#9;if Me.Name == &quot;mastrj&quot; then
&#9;&#9;Energy.BrickColor = BrickColor.new(&quot;New Yeller&quot;)
&#9;&#9;else
&#9;&#9;if Data.Ki.Value == 1 then
&#9;&#9;Energy.BrickColor = BrickColor.new(23)
&#9;&#9;elseif Data.Ki.Value == 2 then
&#9;&#9;Energy.BrickColor = BrickColor.new(21)
&#9;&#9;elseif Data.Ki.Value == 3 then
&#9;&#9;Energy.BrickColor = BrickColor.new(1023)
&#9;&#9;elseif Data.Ki.Value == 4 then
&#9;&#9;Energy.BrickColor = BrickColor.new(106)
&#9;&#9;elseif Data.Ki.Value == 5 then
&#9;&#9;Energy.BrickColor = BrickColor.new(37)
&#9;&#9;elseif Data.Ki.Value == 6 then
&#9;&#9;Energy.BrickColor = BrickColor.new(26)
&#9;&#9;elseif Data.Ki.Value == 7 then
&#9;&#9;Energy.BrickColor = BrickColor.new(1)
&#9;&#9;end
&#9;end
&#9;Energy.Transparency = 1
&#9;Energy.Reflectance = 0.1
&#9;Energy.Name = &quot;Energy&quot;
&#9;Energy.Size = Vector3.new(3, 3, 3)
&#9;Energy.TopSurface = &quot;Smooth&quot;
&#9;Energy.BottomSurface = &quot;Smooth&quot;
&#9;Energy.CFrame = Torso.CFrame
   EnergyWeld = Instance.new(&quot;Weld&quot;)
   EnergyWeld.Parent = Torso
   EnergyWeld.Part0 = Torso
   EnergyWeld.Part1 = Energy
   EnergyWeld.C0 = CFrame.new(0, 0.5, -2)
&#9;EnergyMesh = Instance.new(&quot;SpecialMesh&quot;) 
&#9;EnergyMesh.Parent = Energy
&#9;EnergyMesh.MeshType = &quot;Sphere&quot;
&#9;EnergyMesh.Scale = Vector3.new(1, 1, 1)

   Gyro.cframe = CFrame.new(Torso.Position, eTorso.Position)

&#9;Torso.CFrame = CFrame.new(Torso.Position, eTorso.Position)

&#9;for i = 1 , 10 do
&#9;&#9;Energy.Transparency = Energy.Transparency - 0.07
      EnergyMesh.Scale = EnergyMesh.Scale + Vector3.new(0.1, 0.1, 0.1)
&#9;&#9;wait(0.075)
&#9;end

&#9;wait(0.2)

   Model = Instance.new(&quot;Model&quot;)
   Model.Name = &quot;Blast&quot;
   Model.Parent = Character
&#9;p = Instance.new(&quot;Part&quot;)
&#9;p.Parent = Model
&#9;p.Anchored = true
&#9;p.Size = Vector3.new(4, 200, 4)
&#9;p.CanCollide = false
&#9;p.Transparency = Energy.Transparency
&#9;p.Name = &quot;StrongBlast&quot;
&#9;p.BrickColor = Energy.BrickColor
&#9;p.TopSurface = &quot;Smooth&quot;
&#9;p.BottomSurface = &quot;Smooth&quot;
   p.CFrame = Torso.CFrame * CFrame.new(Vector3.new(0, 0.5, -2)) * CFrame.fromEulerAnglesXYZ(1.57, 0, 0)
&#9;Owner = Instance.new(&quot;ObjectValue&quot;)
&#9;Owner.Parent = p
&#9;Owner.Name = &quot;Owner&quot;
&#9;Owner.Value = Me
&#9;m = Instance.new(&quot;CylinderMesh&quot;)
&#9;m.Parent = p
&#9;m.Scale = Vector3.new(1, 0, 1)
&#9;script.Parent.Damage:clone().Parent = p

&#9;for i = 1 , 75 do
&#9;&#9;p.Transparency = p.Transparency + 0.005
&#9;&#9;Energy.Transparency = Energy.Transparency + 0.005
&#9;&#9;EnergyMesh.Scale = EnergyMesh.Scale - Vector3.new(0.01, 0.01, 0.01)
&#9;&#9;p.CFrame = p.CFrame * CFrame.new(Vector3.new(0, -3, 0))
&#9;&#9;m.Scale = m.Scale - Vector3.new(0.01, 0.03, 0.01)
&#9;&#9;wait()
&#9;end  
&#9;Model:Remove()
&#9;Energy:Remove()
&#9;wait(1)
&#9;Humanoid.PlatformStand = false
eHumanoid.Sit = true
Thing.Value = false
ePosition:Remove()
v.Occupied.Value = false
if v.Occupied:findFirstChild(&quot;EnableScript&quot;) ~= nil then
v.Occupied:findFirstChild(&quot;EnableScript&quot;):Remove()
end
eGyro:Remove()
RefreshWelds()
Humanoid.WalkSpeed = 16
&#9;RefreshWelds()
&#9;wait(0.1)
&#9;Gyro:Remove()
&#9;Position:Remove()
&#9;wait(6)
end
end
end
wait(0.05)  
RightShoulder.MaxVelocity = 0.15
LeftShoulder.MaxVelocity = 0.15
RefreshWelds()
Chance = math.random(1, 3)
if Chance == 1 then
 Data.Physical.PhXP.Value = Data.Physical.PhXP.Value+300
end
wait(5)
Activated = false
end
end
wait(5)
mouse.Icon = &quot;http://www.roblox.com/asset/?id=11624732&quot;
end 

function onSelected(mouse)
mouse.Icon = &quot;http://www.roblox.com/asset/?id=11624732&quot;
mouse.Button1Down:connect(function() Attack(mouse) end)
end

