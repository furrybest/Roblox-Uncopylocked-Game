&#9;&#9;Data.KiControl.KiXP.Value = Data.KiControl.KiXP.Value+250
&#9;&#9;else
&#9;&#9;Data.KiControl.KiXP.Value = Data.KiControl.KiXP.Value+170
&#9;end
