							<string name="Name">Script</string>
							<ProtectedString name="Source">player = script.Parent.Parent.Parent.Parent
bin = script.Parent

function mb1d()

if (bin.Text == &quot;Run&quot;) then

bin.Text = &quot;Walk&quot;
player.Backpack.Speed.Disabled = false

else bin.Text = &quot;Run&quot;
player.Backpack.Speed.Disabled = true
wait(0.1)
player.Character.Humanoid.WalkSpeed = 16
end
end

bin.MouseButton1Down:connect(mb1d)
