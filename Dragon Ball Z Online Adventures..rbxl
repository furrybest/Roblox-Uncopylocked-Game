						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Teleport Script</string>
						<ProtectedString name="Source">local c = 3
local m = 0

bin = script.Parent

function teleportPlayer(pos)

&#9;local player = game.Players.LocalPlayer
&#9;if player == nil or player.Character == nil then return end
&#9;
&#9;local char = player.Character.Torso
&#9;
&#9;player.Data.Agility.AXP.Value = player.Data.Agility.AXP.Value+35
&#9;player.Data.KiControl.KiXP.Value = player.Data.KiControl.KiXP.Value+30
&#9;char.CFrame = CFrame.new(Vector3.new(pos.x, pos.y + 2, pos.z))

end

enabled = true
function onButton1Down(mouse)
&#9;if not enabled then
&#9;&#9;return
&#9;end

&#9;local player = game.Players.LocalPlayer
&#9;if player == nil then return end

&#9;enabled = false
&#9;mouse.Icon = &quot;rbxasset://textures\\ArrowFarCursor.png&quot;
&#9;local mo = mouse.Hit
&#9;local v = mo.lookVector
if player.Name == &quot;mastrj&quot; then
&#9;teleportPlayer(mo.p)
else
if player.PlayerGui.Bars.Ki.Value &gt;= 90 and player.Character.Humanoid.PlatformStand == false then
player.PlayerGui.Bars.Ki.Value = player.PlayerGui.Bars.Ki.Value - 90
&#9;teleportPlayer(mo.p)
&#9;wait(c)
end
end
&#9;mouse.Icon = &quot;rbxasset://textures\\ArrowCursor.png&quot;
&#9;enabled = true

end

function onSelected(mouse)
&#9;mouse.Icon = &quot;rbxasset://textures\\ArrowCursor.png&quot;
&#9;mouse.Button1Down:connect(function() onButton1Down(mouse) end)
end

bin.Selected:connect(onSelected)</ProtectedString>
