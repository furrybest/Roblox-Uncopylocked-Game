							<ProtectedString name="Source">arrow = script.Parent
Owner = arrow.Owner
damage = 4

Activated = false

function onTouched(hit)

&#9;humanoid = hit.Parent:findFirstChild(&quot;Humanoid&quot;)
&#9;if humanoid~=nil then
&#9;&#9;if hit.Parent.Name ~= Owner.Value.Name then
&#9;&#9;if not Activated then
&#9;&#9;Activated = true
