					<Item class="Script" referent="RBX8051">
						<Properties>
							<bool name="Archivable">true</bool>
							<bool name="Disabled">true</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Zombie Startup</string>
							<ProtectedString name="Source">function LoadZombie(x,y,z)
local num = false
while num ~= true do
zom = game.Lighting.Marshland.Majini:clone()
zom.RegenScript.Xpos.Value = x
zom.RegenScript.Ypos.Value = y
zom.RegenScript.Zpos.Value = z
zom.Parent = game.Workspace
zom.Torso.CFrame = CFrame.new(x,y,z)
wait(1)
if zom.Zombie.Health &gt; 1 then
num = true
zom:findFirstChild(&quot;Zombie Startup&quot;).Disabled = false
else
zom:remove()
end
end
end



wait(.5)
welds = script.Parent.Torso:GetChildren()
for num = 1, #welds do
if welds[num].Name == &quot;SecondaryWeld&quot; then
welds[num]:remove()
end end
wait(.5)
local w1 = Instance.new(&quot;Weld&quot;)
&#9;w1.Parent = script.Parent.Torso
&#9;w1.Part0 = w1.Parent
&#9;w1.Part1 = script.Parent.Torso2
&#9;w1.C1 = CFrame.fromEulerAnglesXYZ(0, 0, 0) * CFrame.new(0, -.5, 1)
&#9;w1.Name = &quot;SecondaryWeld&quot;
&#9;
&#9;local w2 = Instance.new(&quot;Weld&quot;)
&#9;w2.Parent = script.Parent.Torso
&#9;w2.Part0 = w2.Parent
&#9;w2.Part1 = script.Parent.arm1
&#9;w2.C1 = CFrame.fromEulerAnglesXYZ(-1.5, -1.7, -.1) * CFrame.new(-1.5, -.5, .5)
&#9;w2.Name = &quot;SecondaryWeld&quot;

&#9;local w3 = Instance.new(&quot;Weld&quot;)
&#9;w3.Parent = script.Parent.Torso
&#9;w3.Part0 = w3.Parent
&#9;w3.Part1 = script.Parent.tent
&#9;w3.C1 = CFrame.fromEulerAnglesXYZ(-1.5, 0, 0) * CFrame.new(0, -1.2, .5)
&#9;w3.Name = &quot;SecondaryWeld&quot;

&#9;local w4 = Instance.new(&quot;Weld&quot;)
&#9;w4.Parent = script.Parent.Torso
&#9;w4.Part0 = w4.Parent
&#9;w4.Part1 = script.Parent.Head
&#9;w4.C1 = CFrame.fromEulerAnglesXYZ(0, 0, 0) * CFrame.new(0, -1.5, 0)
&#9;w4.Name = &quot;SecondaryWeld&quot;

&#9;local w5 = Instance.new(&quot;Weld&quot;)
&#9;w5.Parent = script.Parent.Torso
&#9;w5.Part0 = w5.Parent
&#9;w5.Part1 = script.Parent.arm2
&#9;w5.C1 = CFrame.fromEulerAnglesXYZ(-1.5, -1.2, .3) * CFrame.new(1.5, -.5, .5)
&#9;w5.Name = &quot;SecondaryWeld&quot;

wait(.5)
if script.Parent.Zombie.Health &lt; 1 then
if script.Parent.DontRegen.Value == false then
script.Parent.DontRegen.Value = true
LoadZombie(script.Xpos.Value, script.Ypos.Value, script.Zpos.Value)
wait(3)
script.Parent:remove()
end
end
script.Parent.Zombie.WalkSpeed = 16
script.Parent.Torso2.Anchored = false
script.Parent.arm1.Anchored = false
