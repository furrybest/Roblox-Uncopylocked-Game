						<string name="Name">_Cutscene Procedure_</string>
						<ProtectedString name="Source">chil = game.Players:GetChildren()

script.Start.Changed:connect(function()
wait(4)
play = game.Players:GetChildren()
for NUMOFCAM = 1, #play do
&#9;if play[NUMOFCAM]:findFirstChild(&quot;inGame&quot;) ~= nil then
&#9;&#9;if play[NUMOFCAM].inGame.Value == true then
&#9;&#9;&#9;script.Cam1:clone().Parent = play[NUMOFCAM].Backpack
end end end

wait(3)
script.fire:play()
wait(.01)
set = script.Parent.Gun1:GetChildren()
for num = 1, #set do
set[num].Transparency = 1
end
set = script.Parent.Gun2:GetChildren()
for num = 1, #set do
set[num].Transparency = 0
end
wait(.2)
set = script.Parent.Gun1:GetChildren()
for num = 1, #set do
set[num].Transparency = 0
end
set = script.Parent.Gun2:GetChildren()
for num = 1, #set do
set[num].Transparency = 1
end
wait(.1)
script.fire:play()
wait(.01)
set = script.Parent.Gun1:GetChildren()
for num = 1, #set do
set[num].Transparency = 1
end
set = script.Parent.Gun2:GetChildren()
for num = 1, #set do
set[num].Transparency = 0
end
wait(.2)
set = script.Parent.Gun1:GetChildren()
for num = 1, #set do
set[num].Transparency = 0
end
set = script.Parent.Gun2:GetChildren()
for num = 1, #set do
set[num].Transparency = 1
end
wait(.1)
script.fire:play()
wait(.01)
set = script.Parent.Gun1:GetChildren()
for num = 1, #set do
set[num].Transparency = 1
end
set = script.Parent.Gun2:GetChildren()
for num = 1, #set do
set[num].Transparency = 0
end
wait(.2)
set = script.Parent.Gun1:GetChildren()
for num = 1, #set do
set[num].Transparency = 0
end
set = script.Parent.Gun2:GetChildren()
for num = 1, #set do
set[num].Transparency = 1
end


set = script.Parent.Gun1:GetChildren()
for num = 1, #set do
set[num].Transparency = 1
end
set = script.Parent.Person:GetChildren()
for num = 1, #set do
set[num].Transparency = 1
end
set = script.Parent.Person2:GetChildren()
for num = 1, #set do
set[num].Transparency = 0
end



set = script.Parent.Anim1:GetChildren()
for num = 1, #set do
set[num].Transparency = 1
end
set = script.Parent.Anim2:GetChildren()
for num = 1, #set do
set[num].Transparency = 0
end
wait(.08)
set = script.Parent.Anim2:GetChildren()
for num = 1, #set do
set[num].Transparency = 1
end
set = script.Parent.Anim3:GetChildren()
for num = 1, #set do
set[num].Transparency = 0
end
wait(.08)
set = script.Parent.Anim3:GetChildren()
for num = 1, #set do
set[num].Transparency = 1
end
set = script.Parent.Anim4:GetChildren()
for num = 1, #set do
set[num].Transparency = 0
end
wait(.08)
local hin = Instance.new(&quot;Hint&quot;)
hin.Parent = script.Parent
hin.Text = &quot;Irving: Ahhhhhhh!!&quot;
wait(4)
hin.Text = &quot;Chris(you): Enough! Tell me what you know about the bioweapons being made!&quot;
wait(6)
hin.Text = &quot;Irving: Hahahaha...&quot;
wait(4)
hin.Text = &quot;Irving: You&apos;ll find all your answers in the caves...&quot;
wait(6)
hin.Text = &quot;Irving: ...That is, if you can live long enough to find them!&quot;
wait(4)
hin.Text = &quot;Irving: Hahahaha! *Starts choking*&quot;
wait(4)
hin.Text = &quot;*Irving dies*&quot;
wait(4)
hin.Text = &quot;Chris: Poor guy...&quot;
wait(5)
game.Workspace:findFirstChild(&quot;_Game Script_&quot;).Section.Value = 14
end)


