								<string name="Name">Script</string>
								<ProtectedString name="Source">function ChangeGun()
if script.Parent.Parent.Parent.Parent.Parent.Character:findFirstChild(&quot;Game Tool&quot;) ~= nil then
if script.Parent.Parent.Parent.Parent.Parent.Character:findFirstChild(&quot;Game Tool&quot;).Reloading.Value == true then return end
--Save stats
if script.Parent.Parent.Parent.Parent.Parent.Character:findFirstChild(&quot;Game Tool&quot;).CurrentWeapon.Value ~= &quot;&quot; then
script.Parent.Parent.Parent.Parent.Parent.Character:findFirstChild(&quot;Game Tool&quot;).WeaponList:findFirstChild(&quot;W&quot;..script.Parent.Parent.Parent.Parent.Parent.Character:findFirstChild(&quot;Game Tool&quot;).CurrentWeapon.BoxNum.Value).Ammo.Value = script.Parent.Parent.Parent.Parent.Parent.Character:findFirstChild(&quot;Game Tool&quot;).CurrentWeapon.Ammo.Value
script.Parent.Parent.Parent.Parent.Parent.Character:findFirstChild(&quot;Game Tool&quot;).WeaponList:findFirstChild(&quot;W&quot;..script.Parent.Parent.Parent.Parent.Parent.Character:findFirstChild(&quot;Game Tool&quot;).CurrentWeapon.BoxNum.Value).Clip.Value = script.Parent.Parent.Parent.Parent.Parent.Character:findFirstChild(&quot;Game Tool&quot;).CurrentWeapon.Clip.Value
end
--CHANGE GUN

--{NEW IMPORTANT STAT}
script.Parent.Parent.Parent.Parent.Parent.Character:findFirstChild(&quot;Game Tool&quot;).CurrentWeapon.BoxNum.Value = 7
----------------------

script.Parent.Parent.Parent.Parent.Parent.Character:findFirstChild(&quot;Game Tool&quot;).CurrentWeapon.Value =
script.Parent.Parent.Parent.Parent.Parent.Character:findFirstChild(&quot;Game Tool&quot;).WeaponList.W7.Value
script.Parent.Parent.Parent.Parent.Parent.Character:findFirstChild(&quot;Game Tool&quot;).CurrentWeapon.Ammo.Value = 
script.Parent.Parent.Parent.Parent.Parent.Character:findFirstChild(&quot;Game Tool&quot;).WeaponList.W7.Ammo.Value
script.Parent.Parent.Parent.Parent.Parent.Character:findFirstChild(&quot;Game Tool&quot;).CurrentWeapon.Clip.Value = 
script.Parent.Parent.Parent.Parent.Parent.Character:findFirstChild(&quot;Game Tool&quot;).WeaponList.W7.Clip.Value
script.Parent.Parent.Parent.Parent.Health.Tray.Ammo.Text = 
&quot;Ammo: &quot;..
script.Parent.Parent.Parent.Parent.Parent.Character:findFirstChild(&quot;Game Tool&quot;).WeaponList.W7.Ammo.Value
script.Parent.Parent.Parent.Parent.Health.Tray.Clip.Text = 
&quot;Clip: &quot;..
script.Parent.Parent.Parent.Parent.Parent.Character:findFirstChild(&quot;Game Tool&quot;).WeaponList.W7.Clip.Value
script.Parent.Parent.Parent.Parent.Health.Tray.Gun.Text = 
script.Parent.Parent.Parent.Parent.Parent.Character:findFirstChild(&quot;Game Tool&quot;).WeaponList.W7.Value

--Change Mesh
Tool = script.Parent.Parent.Parent.Parent.Parent.Character:findFirstChild(&quot;Game Tool&quot;)
wep = script.Parent.Parent.Parent.Parent.Parent.Character:findFirstChild(&quot;Game Tool&quot;).WeaponList.W7.Value

if Tool.CurrentWeapon.Value == &quot;M92F&quot; or Tool.CurrentWeapon.Value == &quot;H&amp;K P8&quot; or Tool.CurrentWeapon.Value == &quot;SIG P226&quot; or Tool.CurrentWeapon.Value == &quot;M93R&quot; then
Tool.Handle.Mesh.MeshId = Tool.Pistol.MeshId
Tool.Handle.Mesh.Scale = Tool.Pistol.Scale
Tool.GripForward = Vector3.new(1, 1, 0)
Tool.GripPos = Vector3.new(0, 0, 0.5)
Tool.GripRight = Vector3.new(1, 0, 0)
Tool.GripUp = Vector3.new(0, 1, 0)
elseif Tool.CurrentWeapon.Value == &quot;Ithaca M37&quot; then
Tool.Handle.Mesh.MeshId = Tool.Shotgun1.MeshId
Tool.Handle.Mesh.Scale = Tool.Shotgun1.Scale
Tool.GripForward = Vector3.new(-1,0,-1)
Tool.GripPos = Vector3.new(0,-.7,-.2)
Tool.GripRight = Vector3.new(1,0,0)
Tool.GripUp = Vector3.new(0,0,1)
elseif Tool.CurrentWeapon.Value == &quot;M3&quot; then
Tool.Handle.Mesh.MeshId = Tool.Shotgun2.MeshId
Tool.Handle.Mesh.Scale = Tool.Shotgun2.Scale
Tool.GripForward = Vector3.new(1, 1, 0)
Tool.GripPos = Vector3.new(0, 0, 0.5)
Tool.GripRight = Vector3.new(1, 0, 0)
Tool.GripUp = Vector3.new(0, 1, 0)
elseif Tool.CurrentWeapon.Value == &quot;S75&quot; or Tool.CurrentWeapon.Value == &quot;Dragunov SVD&quot; or Tool.CurrentWeapon.Value == &quot;H&amp;K PSG-1&quot; then
Tool.Handle.Mesh.MeshId = Tool.Sniper.MeshId
Tool.Handle.Mesh.Scale = Tool.Sniper.Scale
Tool.GripForward = Vector3.new(1, 1, 0)
Tool.GripPos = Vector3.new(0, -.6, 1.2)
Tool.GripRight = Vector3.new(1, 0, 0)
Tool.GripUp = Vector3.new(0, 1, 0)
elseif Tool.CurrentWeapon.Value == &quot;S&amp;W M29&quot; or Tool.CurrentWeapon.Value == &quot;L Hawk&quot; or Tool.CurrentWeapon.Value == &quot;S&amp;W M500&quot; then
Tool.Handle.Mesh.MeshId = Tool.Magnum.MeshId
Tool.Handle.Mesh.Scale = Tool.Magnum.Scale
Tool.GripForward = Vector3.new(-1,0,-1)
Tool.GripPos = Vector3.new(0,-.7,-.2)
Tool.GripRight = Vector3.new(1,0,0)
Tool.GripUp = Vector3.new(0,0,1)
elseif Tool.CurrentWeapon.Value == &quot;VZ61&quot; or Tool.CurrentWeapon.Value == &quot;AK-74&quot; then
Tool.Handle.Mesh.MeshId = Tool.MachineGun1.MeshId
Tool.Handle.Mesh.Scale = Tool.MachineGun1.Scale
Tool.GripForward = Vector3.new(1, 1, 0)
Tool.GripPos = Vector3.new(0, 0, 0.5)
Tool.GripRight = Vector3.new(1, 0, 0)
Tool.GripUp = Vector3.new(0, 1, 0)
elseif Tool.CurrentWeapon.Value == &quot;H&amp;K MP5&quot; or Tool.CurrentWeapon.Value == &quot;SIG 556&quot; then
Tool.Handle.Mesh.MeshId = Tool.MachineGun2.MeshId
Tool.Handle.Mesh.Scale = Tool.MachineGun2.Scale
Tool.GripForward = Vector3.new(0,0,0)
Tool.GripPos = Vector3.new(0,1.5,0)
Tool.GripRight = Vector3.new(0,0,1)
Tool.GripUp = Vector3.new(0,0,0)
wait(.01)
Tool.GripForward = Vector3.new(0,0,0)
Tool.GripPos = Vector3.new(0,1.5,0)
Tool.GripRight = Vector3.new(0,0,1)
Tool.GripUp = Vector3.new(0,0,0)
elseif Tool.CurrentWeapon.Value == &quot;Jail Breaker&quot; or Tool.CurrentWeapon.Value == &quot;Hydra&quot; then
Tool.Handle.Mesh.MeshId = Tool.Shotgun3.MeshId
Tool.Handle.Mesh.Scale = Tool.Shotgun3.Scale
Tool.GripForward = Vector3.new(1, 1, 0)
Tool.GripPos = Vector3.new(0, -.8, 1)
Tool.GripRight = Vector3.new(1, 0, 0)
Tool.GripUp = Vector3.new(0, 1, 0)
elseif Tool.CurrentWeapon.Value == &quot;Rocket Launcher&quot; then
Tool.Handle.Mesh.MeshId = Tool.Rocket.MeshId
Tool.Handle.Mesh.Scale = Tool.Rocket.Scale
Tool.GripForward = Vector3.new(-1,0,-1)
Tool.GripPos = Vector3.new(0,0,-.6)
Tool.GripRight = Vector3.new(0,1,0)
Tool.GripUp = Vector3.new(0,0,1)
end
end end

