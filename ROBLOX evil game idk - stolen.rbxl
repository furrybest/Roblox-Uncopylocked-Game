							<Item class="Script" referent="RBX9239">
								<Properties>
									<bool name="Archivable">true</bool>
									<bool name="Disabled">false</bool>
									<Content name="LinkedSource"><null></null></Content>
									<string name="Name">ChangeGui</string>
									<ProtectedString name="Source">script.Parent.Changed:connect(function()
if script.Parent.Value &lt; 1 then
script.Parent.Parent.Parent.Parent.Tran1.CanCollide = false
script.Parent.Parent.Parent.Parent.Tran2.CanCollide = false
script.Parent.Parent.Parent.Parent.Tran3.CanCollide = false
script.Parent.Parent.Parent.Parent.Tran4.CanCollide = false
script.Parent.Parent.Parent.LeftArm1:remove()
script.Parent.Parent.Parent.LeftArm2:remove()
script.Parent.Parent.Parent.LeftArm3:remove()
script.Parent.Parent.Parent.LeftArm4:remove()
script.Parent.Parent.Parent.Parent.EndSection.Script.Disabled = false
script.Parent.Parent.Parent.Parent.Squidy1:remove()
script.Parent.Parent.Parent.Parent.Squidy2:remove()
script.Parent.Parent.Parent.Parent.TOPW:stop()
script.Parent.Parent.Parent.Parent.Winds:play()
else
local pla = game.Players:GetChildren()
for num = 1, #pla do
if pla[num]:findFirstChild(&quot;inGame&quot;) ~= nil then
if pla[num].inGame.Value == true then
pla[num].PlayerGui.inGame.ExcellaHealth.Visible = true
pla[num].PlayerGui.inGame.ExcellaHealth.Health.Size = UDim2.new(0,(script.Parent.Value)/(script.Parent.Multi.Value*1.5),0,50)
end end end

end
end)
</ProtectedString>
