							</Properties>
						</Item>
						<Item class="Script" referent="RBX10482">
							<Properties>
								<bool name="Archivable">true</bool>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">Script</string>
								<ProtectedString name="Source">local cost = 15
local gun = &quot;VZ61&quot;

player = script.Parent.Parent.Parent.Parent.Parent
gold = player.leaderstats.Gold
wait(1)
if player:findFirstChild(gun) == nil then
while player:findFirstChild(gun) == nil do
wait(1)
end
end
if player:findFirstChild(gun).Value == true then
script.Parent:remove()
end
function die()
if gold.Value &gt;= cost then -- Cost to activate (50)
local backpack = script.Parent.Parent.Parent:findFirstChild(&quot;Background(Organize)&quot;).Items:children()
local con = true
for x = 1, #backpack do
if (backpack[x].Text == &quot;N/A&quot;) and (con == true) then
con = false
backpack[x].Text = gun
player:findFirstChild(gun).Value = true
gold.Value = gold.Value - cost
script.Parent.Visible = false
script.Parent.Active = false
wait(.5)
script.Parent:remove()
end
end
end
end

