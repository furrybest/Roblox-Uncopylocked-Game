script.Parent.Parent:findFirstChild(GuiList[4]).Position = UDim2.new(script.Parent.Parent:findFirstChild(GuiList[4]).Position.X.Scale, 0, script.Parent.Parent:findFirstChild(GuiList[4]).Position.Y.Scale, xpos)
script.Parent.Parent:findFirstChild(GuiList[5]).Position = UDim2.new(script.Parent.Parent:findFirstChild(GuiList[5]).Position.X.Scale, 0, script.Parent.Parent:findFirstChild(GuiList[5]).Position.Y.Scale, xpos)
script.Parent.Parent:findFirstChild(GuiList[6]).Position = UDim2.new(script.Parent.Parent:findFirstChild(GuiList[6]).Position.X.Scale, 0, script.Parent.Parent:findFirstChild(GuiList[6]).Position.Y.Scale, xpos)
wait()
end
script.Parent.Parent.Visible = false
script.Parent.Parent.Parent.Organize.Visible = true
script.Parent.Parent.Parent.Shop.Visible = true
script.Parent.Parent.Parent.Ready.Visible = true
script.Parent.Parent.Parent.Ready.ToGame.Value = false
script.Parent.Parent.Parent.Background2.Visible = true
script.Parent.Parent.Parent.Background.Visible = true
end
stopfun = false
end

