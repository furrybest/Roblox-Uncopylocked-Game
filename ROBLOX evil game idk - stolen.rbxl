				<Item class="LocalScript" referent="RBX9638">
					<Properties>
						<bool name="Archivable">true</bool>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">SpecialKeys</string>
						<ProtectedString name="Source">Tool = script.Parent

--Define keys
UPARROW=string.char(17) 
DOWNARROW=string.char(18) 
LEFTARROW=string.char(20) 
RIGHTARROW=string.char(19) 
SPACEBAR=string.char(32) 

function Key(key)
if key then
key = string.lower(key)
if key == &quot;q&quot; then --RADAR
if game.Players:findFirstChild(script.Parent.Parent.Name).PlayerGui.StartGui.Radar.Visible == false then
game.Players:findFirstChild(script.Parent.Parent.Name).PlayerGui.StartGui.Radar.Visible = true 
else
game.Players:findFirstChild(script.Parent.Parent.Name).PlayerGui.StartGui.Radar.Visible = false
end

elseif  key == &quot;p&quot; then --PAUSE MENU
if script.Parent.Paused.Value == false then
script.Parent.Paused.Value = true
script.Parent.Parent.Humanoid.WalkSpeed = 0
game.Players:findFirstChild(script.Parent.Parent.Name).PlayerGui.StartGui.PauseMenu.Visible = true
else
script.Parent.Paused.Value = false
script.Parent.Parent.Humanoid.WalkSpeed = 16
game.Players:findFirstChild(script.Parent.Parent.Name).PlayerGui.StartGui.PauseMenu.Visible = false
end

elseif  key == &quot;r&quot; then --Reload Weapon
script.Parent.ManualReloading.Value = true

elseif  key == &quot;m&quot; then --WEAPON MENU
game.Players:findFirstChild(script.Parent.Parent.Name).PlayerGui.GunInstructions.TextLabel.Visible = false
if game.Players:findFirstChild(script.Parent.Parent.Name).PlayerGui.StartGui.WeaponMenu.Visible == false then
game.Players:findFirstChild(script.Parent.Parent.Name).PlayerGui.StartGui.WeaponMenu.Visible = true
else
game.Players:findFirstChild(script.Parent.Parent.Name).PlayerGui.StartGui.WeaponMenu.Visible = false
end

elseif key == &quot;f&quot; then --SHORTCUTS
if script.Parent.CurrentWeapon.BoxNum.Value ~= 0 then
if script.Parent.Reloading.Value == false then
script.Parent.WeaponList:findFirstChild(&quot;W&quot;..script.Parent.CurrentWeapon.BoxNum.Value).Ammo.Value = script.Parent.CurrentWeapon.Ammo.Value
script.Parent.WeaponList:findFirstChild(&quot;W&quot;..script.Parent.CurrentWeapon.BoxNum.Value).Clip.Value = script.Parent.CurrentWeapon.Clip.Value
end
end
script.Parent.CurrentWeapon.BoxNum.Value = 4
script.Parent.CurrentWeapon.Value = script.Parent.WeaponList.W4.Value
script.Parent.CurrentWeapon.Ammo.Value = script.Parent.WeaponList.W4.Ammo.Value
script.Parent.CurrentWeapon.Clip.Value = script.Parent.WeaponList.W4.Clip.Value
