							<string name="Name">Script</string>
							<ProtectedString name="Source">local cont = false
function LoadReaper(x,y,z)
local num = false
while num ~= true do
zom = game.Lighting.Special.Reaper:clone()
zom.RegenScript.Xpos.Value = x
zom.RegenScript.Ypos.Value = y
zom.RegenScript.Zpos.Value = z
zom.Parent = game.Workspace
zom.Torso.CFrame = CFrame.new(x,y,z)
wait(1)
if zom.Zombie.Health &gt; 1 then
num = true
else
zom:remove()
end
end
end

function LoadLicker(x,y,z)
local num = false
while num ~= true do
zom = game.Lighting.Special.Licker:clone()
zom.RegenScript.Xpos.Value = x
zom.RegenScript.Ypos.Value = y
zom.RegenScript.Zpos.Value = z
zom.Parent = game.Workspace
zom.Torso.CFrame = CFrame.new(x,y,z)
wait(1)
if zom.Zombie.Health &gt; 1 then
num = true
else
zom:remove()
end
end
end

local hin = Instance.new(&quot;Hint&quot;)
function onTouched(hit)
if hit ~= nil then
if hit.Parent:findFirstChild(&quot;Humanoid&quot;) ~= nil then
if cont == false then
cont = true
script.Parent.Parent.TimerScript.Disabled = false
script.Parent.Parent.Gothic:stop()
script.Parent.Parent.Metal:play()
LoadReaper(script.Parent.Parent.ZomTele1.Position.X, script.Parent.Parent.ZomTele1.Position.Y, script.Parent.Parent.ZomTele1.Position.Z)
LoadLicker(script.Parent.Parent.ZomTele2.Position.X, script.Parent.Parent.ZomTele2.Position.Y, script.Parent.Parent.ZomTele2.Position.Z)
LoadReaper(script.Parent.Parent.ZomTele3.Position.X, script.Parent.Parent.ZomTele3.Position.Y, script.Parent.Parent.ZomTele3.Position.Z)
script.Parent.Parent.BigDoor.Anim.Disabled = false
hin.Parent = script.Parent
hin.Text = &quot;Chris(you): What the heck are these things!?&quot;
wait(5)
hin.Text = &quot;Chris(you): I need to shoot the Reapers in the belly!&quot;
wait(7)
hin.Text = &quot;Chris(you): Alright, come get some!&quot;
wait(5)
hin:remove()
wait(.5)
script.Parent:remove()
end end end end

script.Parent.Touched:connect(onTouched)</ProtectedString>
