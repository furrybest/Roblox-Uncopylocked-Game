					<Item class="Script" referent="RBX5758">
						<Properties>
							<bool name="Archivable">true</bool>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script</string>
							<ProtectedString name="Source">local cont = false

function LoadZombie(x,y,z)
local num = false
while num ~= true do
zom = game.Lighting.Licker:clone()
zom.Parent = game.Workspace
zom.Torso.CFrame = CFrame.new(x,y,z)
wait(1)
if zom.Zombie.Health &gt; 1 then
num = true
else
zom:remove()
end
end
end

function onTouched(hit)
if hit ~= nil then
if hit.Parent:findFirstChild(&quot;Humanoid&quot;) ~= nil then
if cont == false then
cont = true
LoadZombie(script.Parent.Parent.ZomTele2.Position.X, script.Parent.Parent.ZomTele2.Position.Y, script.Parent.Parent.ZomTele2.Position.Z)

script.Parent.Parent.ExitDoor.Anim.Disabled = false

script.Parent.Parent.Lev1.Part1.Transparency = 1
script.Parent.Parent.Lev1.Part1.CanCollide = false
script.Parent.Parent.Lev1.Part2.Transparency = 1
script.Parent.Parent.Lev1.Part2.CanCollide = false

script.Parent.Parent.Lev2.Part1.Transparency = 0
script.Parent.Parent.Lev2.Part1.CanCollide = true
script.Parent.Parent.Lev2.Part2.Transparency = 0
script.Parent.Parent.Lev2.Part2.CanCollide = true

wait(.5)
script.Parent:remove()
end end end end

script.Parent.Touched:connect(onTouched)</ProtectedString>
