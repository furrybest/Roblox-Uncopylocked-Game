								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">Script</string>
								<ProtectedString name="Source">weps = {&quot;M92F&quot;, &quot;H&amp;K P8&quot;, &quot;SIG P226&quot;, &quot;M93R&quot;, &quot;Ithaca M37&quot;, &quot;M3&quot;, &quot;Jail Breaker&quot;, &quot;Hydra&quot;, &quot;VZ61&quot;, &quot;H&amp;K MP5&quot;, &quot;AK-74&quot;, &quot;SIG 556&quot;, &quot;S75&quot;, &quot;Dragunov SVD&quot;, &quot;H&amp;K PSG-1&quot;, &quot;S&amp;W M29&quot;, &quot;L Hawk&quot;, &quot;S&amp;W M500&quot;, &quot;Rocket Launcher&quot;, &quot;LickerKill&quot;, &quot;ReaperKill&quot;, &quot;REmblem&quot;, &quot;GEmblem&quot;, &quot;YEmblem&quot;, &quot;BEmblem&quot;, &quot;OEmblem&quot;}pla = script.Parent.Parent.Parent.Parent.Parent
gold = pla.leaderstats.Gold.Value

function onButtonClicked()
for num = 1, #weps do

if pla:findFirstChild(weps[num]).Value == true then
pla:SaveBoolean(weps[num], true)
else
pla:SaveBoolean(weps[num], false)
end
pla:SaveNumber(&quot;Gold&quot;, pla.leaderstats.Gold.Value)
pla:SaveNumber(&quot;Kills&quot;, pla.Kills.Value)
end
script.Parent.Parent.DataSaved.Visible = true
wait(3)
script.Parent.Parent.DataSaved.Visible = false
end

