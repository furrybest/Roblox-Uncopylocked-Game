							<string name="Name">Script</string>
							<ProtectedString name="Source">local hin = Instance.new(&quot;Hint&quot;)
local cont = false
function onTouched(hit)
if hit ~= nil then
if hit.Parent:findFirstChild(&quot;Humanoid&quot;) ~= nil then
if cont == false then
cont = true
hin.Parent = script.Parent
hin.Text = &quot;HQ: We need you to locate a man named Irving.&quot;
wait(5)
hin.Text = &quot;HQ: We believe he may know something about the bioweapons being produced.&quot;
wait(5)
hin.Text = &quot;HQ: His hideout should be right past the butchery.&quot;
wait(5)
hin.Text = &quot;HQ: Be careful, we dont know where all the civilians are at.&quot;
wait(9)
hin:remove()
wait(.5)
script.Parent:remove()
end
end
end
end

