firstSelect=false

function onRelativeDown(obj,x,y)
obj.Text=(obj.Text==&quot;X&quot;)and&quot;&quot;or&quot;X&quot;
end

function onSelected(mouse)
obj1.Parent=game.Players.LocalPlayer.PlayerGui
if not firstSelect then
firstSelect=true
obj3.MouseButton1Down:connect(onObj3Down)
obj7.MouseButton1Down:connect(onObj7Down)
obj21.MouseButton1Down:connect(function(...) onRelativeDown(obj21,...) end)
obj22.MouseButton1Down:connect(function(...) onRelativeDown(obj22,...) end)
obj23.MouseButton1Down:connect(function(...) onRelativeDown(obj23,...) end)
obj30.MouseButton1Down:connect(onObj30Down)
obj29.MouseButton1Down:connect(function() onTrayButton(obj29) end)
obj28.MouseButton1Down:connect(function() onTrayButton(obj28) end)
obj27.MouseButton1Down:connect(function() onTrayButton(obj27) end)
obj26.MouseButton1Down:connect(function() onTrayButton(obj26) end)
for i,v in pairs(modeButtons) do
v.MouseButton1Down:connect(function() onModeClick(v) end)
end
player=game.Players.LocalPlayer
if player:findFirstChild(&quot;BlobbyblobBuildToolStats&quot;)==nil then
local stats=Instance.new(&quot;IntValue&quot;)
stats.Parent=player
stats.Name=&quot;BlobbyblobBuildToolStats&quot;
for i,v in pairs(allActions) do
local permission=Instance.new(&quot;BoolValue&quot;)
permission.Name=&quot;Can&quot;..v..&quot;_&quot;..player.Name
permission.Parent=stats
permission.Value=true
end
end
obj4.MouseButton1Down:connect(function()
if obj132.Visible then
obj132.Visible=false
else
obj132.Visible=true
end
end)
end
mouse.Button1Down:connect(function() onButton1Down(mouse) end)
mouse.Button1Up:connect(function() onButton1Up(mouse) end)
mouse.KeyDown:connect(function(key) onKeyDown(key,mouse) end)
mouse.KeyUp:connect(function(key) onKeyUp(key,mouse) end)
mouse.Move:connect(function() onMove(mouse) end)
refreshPermissionsGrid()
end

function onDeselected(mouse)
obj1.Parent=nil
end

script.Parent.Selected:connect(onSelected)
script.Parent.Deselected:connect(onDeselected)

