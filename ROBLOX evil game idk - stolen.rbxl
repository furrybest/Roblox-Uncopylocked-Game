						<Item class="Script" referent="RBX5590">
							<Properties>
								<bool name="Archivable">true</bool>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">Script</string>
								<ProtectedString name="Source">local sto = false
function onTouched(hit)
if hit ~= nil then
if hit.Parent:findFirstChild(&quot;Humanoid&quot;) ~= nil then
if script.Parent.Transparency == 0 then
if sto == false then
sto = true
game.Workspace:findFirstChild(&quot;_Game Script_&quot;).Section.Value = 14.5
pla = game.Players:GetChildren()
for num = 1, #pla do
if pla[num]:findFirstChild(&quot;inGame&quot;) ~= nil then
if pla[num].inGame.Value == true then
if pla[num]:findFirstChild(&quot;leaderstats&quot;) ~= nil then
pla[num].leaderstats.Gold.Value = pla[num].leaderstats.Gold.Value + 20
end end end end end
end
end
end
end

script.Parent.Touched:connect(onTouched)</ProtectedString>
