						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">ChangeLight</string>
						<ProtectedString name="Source">wait(.2)
script.LightDie:play()
game.Lighting.Ambient = game.Lighting.ReallyDark.Value
game.Lighting.Brightness = .1
wait(.1)
game.Lighting.Ambient = game.Lighting.Dark.Value
game.Lighting.Brightness = 0
wait(.1)
game.Lighting.Ambient = game.Lighting.ReallyDark.Value
game.Lighting.Brightness = .1
wait(.1)
game.Lighting.Ambient = game.Lighting.Dark.Value
game.Lighting.Brightness = 0
wait(.1)
game.Lighting.Ambient = game.Lighting.ReallyDark.Value
game.Lighting.Brightness = 0
wait(.8)
game.Lighting.Brightness = .1
</ProtectedString>
