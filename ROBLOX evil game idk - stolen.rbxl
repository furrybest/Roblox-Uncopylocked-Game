but = script.Parent.Parent

function buttonClicked()
if but.Parent.Parent.Backpack.sqr1.Text ~= &quot;N/A&quot; and but.Parent.Parent.Backpack.sqr2.Text ~= &quot;N/A&quot; and  but.Parent.Parent.Backpack.sqr3.Text ~= &quot;N/A&quot; and but.Parent.Parent.Backpack.sqr4.Text ~= &quot;N/A&quot; and  but.Parent.Parent.Backpack.sqr5.Text ~= &quot;N/A&quot; and  but.Parent.Parent.Backpack.sqr6.Text ~= &quot;N/A&quot; and  but.Parent.Parent.Backpack.sqr7.Text ~= &quot;N/A&quot; and  but.Parent.Parent.Backpack.sqr8.Text ~= &quot;N/A&quot; and but.Parent.Parent.Backpack.sqr9.Text ~= &quot;N/A&quot; then
