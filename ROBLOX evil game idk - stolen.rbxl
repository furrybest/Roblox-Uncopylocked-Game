					<Item class="Script" referent="RBX6455">
						<Properties>
							<bool name="Archivable">true</bool>
							<bool name="Disabled">true</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Anim</string>
							<ProtectedString name="Source">--Custom Animation :D
--by brickman637

--DO NOT CHANGE ANYTHING IN THIS FUNCTION
function Animate(BRICK,FRAMES,FPS,OrigAngX,OrigAngY,OrigAngZ,OrigPosX,
OrigPosY,OrigPosZ,ChanAngX,ChanAngY,ChanAngZ,ChanPosX,ChanPosY,ChanPosZ)
Numbers = {0,0,0,0,0,0}
Numbers[1] = OrigAngX
Numbers[2] = OrigAngY
Numbers[3] = OrigAngZ
Numbers[4] = OrigPosX
Numbers[5] = OrigPosY
Numbers[6] = OrigPosZ
TotalTime = FRAMES/FPS
counter = 0
while counter &lt; FRAMES do
wait(1/FPS)
script.Parent.CFrame = 
CFrame.fromEulerAnglesXYZ(
(Numbers[1])+((OrigAngX - ChanAngX)/FRAMES), 
(Numbers[2])+((OrigAngY - ChanAngY)/FRAMES),
(Numbers[3])+((OrigAngZ - ChanAngZ)/FRAMES)) *
CFrame.new(
(Numbers[4])+((OrigPosX - ChanPosX)/FRAMES),
(Numbers[5])+((OrigPosY - ChanPosY)/FRAMES),
(Numbers[6])+((OrigPosZ - ChanPosZ)/FRAMES))
Numbers[1] = (Numbers[1])+((OrigAngX - ChanAngX)/FRAMES)
Numbers[2] = (Numbers[2])+((OrigAngY - ChanAngY)/FRAMES)
Numbers[3] = (Numbers[3])+((OrigAngZ - ChanAngZ)/FRAMES)
Numbers[4] = (Numbers[4])+((OrigPosX - ChanPosX)/FRAMES)
Numbers[5] = (Numbers[5])+((OrigPosY - ChanPosY)/FRAMES)
Numbers[6] = (Numbers[6])+((OrigPosZ - ChanPosZ)/FRAMES)
counter=counter+1
end end






--CHANGE VALUES BELOW ONLY!
Animate(  --leave this, this calls the function

&quot;RocketFire&quot;, --brick Name(in workspace)
40, --Frames
20, --FPS(Frames per Second)
0, --Orig. Ang. X. 
0, --Orig. Ang. Y. 
0, --Orig. Ang. Z. 
script.Parent.Position.X, --Orig. Pos. X. 
script.Parent.Position.Y, --Orig. Pos. Y. 
script.Parent.Position.Z, --Orig. Pos. Z.  
0, --Final Ang. X. **(MUST BE OPPOSITE OF WHAT YOU WANT ON ALL WITH A **)
0, --Final Ang. Y. **(FOR EXAMPLE, IF YOU WANTED THE BRICK TO END AT 10, YOU WOULD ENTER -10)
0, --Final Ang. Z. **
script.Parent.Position.X, --Final Pos. X. **
script.Parent.Position.Y+44, --Final Pos. Y.**
script.Parent.Position.Z+87.1  --Final Pos. Z. **

) --dont erase this
script.Parent.Transparency = 1
local exp = Instance.new(&quot;Explosion&quot;)
exp.Parent = script.Parent.Parent.Explosive
exp.Position = script.Parent.Parent.Explosive.Position
exp.BlastRadius = 20
wait(.5)
script.Parent:remove()
</ProtectedString>
						</Properties>
					</Item>
				</Item>
