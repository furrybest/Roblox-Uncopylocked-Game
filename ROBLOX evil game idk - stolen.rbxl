function checkForText()
if box.Box1.Text ~= &quot;&quot; and box.Box2.Text ~= &quot;&quot; and box.Box3.Text ~= &quot;&quot; and box.Box4.Text ~= &quot;&quot; and box.Box5.Text ~= &quot;&quot; and box.Box6.Text ~= &quot;&quot; then
return true
else
return false
end end


function checkGold()
Bx1Gold = 0
Bx2Gold = 0
Bx1Gold = box.Box1.Text
Bx4Gold = box.Box4.Text
if ((Bx1Gold-1763)/2.5) == ((Bx4Gold-264)/3) then
return true
elseif Bx1Gold == &quot;0&quot; and Bx4Gold == &quot;0&quot; then
return true
else
return false
end
end

function checkBx2()
for numy = 1, 64 do
if box.Box2.Text == Bx2Nums[numy] then
return true
end end
return false
end

function checkBx3()
for numy = 1, 64 do
if box.Box3.Text == Bx3Nums[numy] then
return true
end end
return false
end

function checkBx5()
for numy = 1, 64 do
if box.Box5.Text == Bx5Nums[numy] then
return true
end end
return false
end

function checkBx6()
for numy = 1, 64 do
if box.Box6.Text == Bx6Nums[numy] then
return true
end end
return false
end

function onButtonClicked()
if (checkForText() == false) then
local new_script = script.Parent.Parent.FailScript:clone()
new_script.Parent = script.Parent.Parent.Failed
new_script.Disabled = false
return
end
if (checkGold() == true) and (checkBx2() == true) and (checkBx3() == true) and (checkBx5() == true) and (checkBx6() == true) then
setBx1Stats()
setBx2Stats()
setBx3Stats()
setBx5Stats()
setBx6Stats()
pla.Character.Humanoid.Health = 0
script.Parent.Parent.Visible = false
script.Parent.Parent.Parent.LoadSuccess.Visible = true
else
local new_script = script.Parent.Parent.FailScript:clone()
new_script.Parent = script.Parent.Parent.Failed
new_script.Disabled = false
end
end

script.Parent.MouseButton1Click:connect(onButtonClicked)</ProtectedString>
