						<string name="Name">Script</string>
						<ProtectedString name="Source">wait(.2)
game.Lighting.Ambient = script.Color.Value
game.Lighting.Brightness = .5
game.Lighting.TimeOfDay = &quot;05:40:00&quot;
while true do
wait(math.random(15,30))
script.Thunder:play()
game.Lighting.Brightness = 2
wait(.07)
game.Lighting.Brightness = .5
wait(.07)
game.Lighting.Brightness = 2
wait(.07)
game.Lighting.Brightness = .5
wait(.07)
