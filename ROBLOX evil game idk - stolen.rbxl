								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">Script</string>
								<ProtectedString name="Source">MenuName = &quot;StartMenu&quot;
GuiList2 = {&quot;Start&quot;, &quot;Records&quot;, &quot;Options&quot;, &quot;Library&quot;, &quot;Leaderboards&quot;, &quot;Credits&quot;}
stopfun = false
function onButtonClicked()
if stopfun == false then
stopfun = true
script.Parent.Parent.Visible = false
script.Parent.Parent.Parent:findFirstChild(MenuName).Visible = true
local xpos = -300
while xpos &lt; 0 do
xpos = xpos + 10
script.Parent.Parent.Parent:findFirstChild(MenuName):findFirstChild(GuiList2[1]).Position = UDim2.new(script.Parent.Parent.Parent:findFirstChild(MenuName):findFirstChild(GuiList2[1]).Position.X.Scale, 0, script.Parent.Parent.Parent:findFirstChild(MenuName):findFirstChild(GuiList2[1]).Position.Y.Scale, xpos)
script.Parent.Parent.Parent:findFirstChild(MenuName):findFirstChild(GuiList2[2]).Position = UDim2.new(script.Parent.Parent.Parent:findFirstChild(MenuName):findFirstChild(GuiList2[2]).Position.X.Scale, 0, script.Parent.Parent.Parent:findFirstChild(MenuName):findFirstChild(GuiList2[2]).Position.Y.Scale, xpos)
script.Parent.Parent.Parent:findFirstChild(MenuName):findFirstChild(GuiList2[3]).Position = UDim2.new(script.Parent.Parent.Parent:findFirstChild(MenuName):findFirstChild(GuiList2[3]).Position.X.Scale, 0, script.Parent.Parent.Parent:findFirstChild(MenuName):findFirstChild(GuiList2[3]).Position.Y.Scale, xpos)
script.Parent.Parent.Parent:findFirstChild(MenuName):findFirstChild(GuiList2[4]).Position = UDim2.new(script.Parent.Parent.Parent:findFirstChild(MenuName):findFirstChild(GuiList2[4]).Position.X.Scale, 0, script.Parent.Parent.Parent:findFirstChild(MenuName):findFirstChild(GuiList2[4]).Position.Y.Scale, xpos)
script.Parent.Parent.Parent:findFirstChild(MenuName):findFirstChild(GuiList2[5]).Position = UDim2.new(script.Parent.Parent.Parent:findFirstChild(MenuName):findFirstChild(GuiList2[5]).Position.X.Scale, 0, script.Parent.Parent.Parent:findFirstChild(MenuName):findFirstChild(GuiList2[5]).Position.Y.Scale, xpos)
script.Parent.Parent.Parent:findFirstChild(MenuName):findFirstChild(GuiList2[6]).Position = UDim2.new(script.Parent.Parent.Parent:findFirstChild(MenuName):findFirstChild(GuiList2[6]).Position.X.Scale, 0, script.Parent.Parent.Parent:findFirstChild(MenuName):findFirstChild(GuiList2[6]).Position.Y.Scale, xpos)
wait()
end
script.Parent.Parent.Parent:findFirstChild(MenuName):findFirstChild(GuiList2[1]).Script.Disabled = false
script.Parent.Parent.Parent:findFirstChild(MenuName):findFirstChild(GuiList2[2]).Script.Disabled = false
script.Parent.Parent.Parent:findFirstChild(MenuName):findFirstChild(GuiList2[3]).Script.Disabled = false
script.Parent.Parent.Parent:findFirstChild(MenuName):findFirstChild(GuiList2[4]).Script.Disabled = false
script.Parent.Parent.Parent:findFirstChild(MenuName):findFirstChild(GuiList2[5]).Script.Disabled = false
script.Parent.Parent.Parent:findFirstChild(MenuName):findFirstChild(GuiList2[6]).Script.Disabled = false
end
stopfun = false
end

