script.Section.Value = 1
game.Lighting.Ambient = game.Lighting.Light.Value
goldFinder = game.Workspace:GetChildren()
for GoldNum = 1, #goldFinder do
if goldFinder[GoldNum].Name == &quot;Gold&quot; then
goldFinder[GoldNum]:remove()
end end





end
end)</ProtectedString>
