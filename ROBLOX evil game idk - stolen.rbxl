--if script.Parent.CurrentWeapon.Ammo.Value == 0 then return end
if script.Parent.CurrentWeapon.Clip.Value &lt;= 0 then
--ListOfWeapons = {&quot;M92F&quot;, &quot;H&amp;K P8&quot;, &quot;SIG P226&quot;, &quot;M93R&quot;, &quot;Ithaca M37&quot;, &quot;M3&quot;, &quot;Jail Breaker&quot;, &quot;Hydra&quot;, &quot;VZ61&quot;, &quot;H&amp;K MP5&quot;, &quot;AK-74&quot;, &quot;SIG 556&quot;, &quot;S75&quot;, &quot;Dragunov SVD&quot;, &quot;H&amp;K PSG-1&quot;, &quot;S&amp;W M29&quot;, &quot;L Hawk&quot;, &quot;S&amp;W M500&quot;, &quot;Rocket Launcher&quot;, &quot;Gatling Gun&quot;, &quot;Longbow&quot;}
