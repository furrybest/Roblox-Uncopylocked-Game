			<Item class="Script" referent="RBX16">
				<Properties>
					<bool name="Archivable">true</bool>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">ResetGame</string>
					<ProtectedString name="Source">function LoadZombie(x,y,z)
local num = false
while num ~= true do
zom = game.Lighting.Jill:clone()
zom.Parent = game.Workspace
zom.Torso.CFrame = CFrame.new(x,y,z)
wait(1)
if zom.Zombie.Health &gt; 1 then
num = true
else
zom:remove()
end
end
end


script.Plays.Changed:connect(function()--
print(&quot;in Func&quot;)
play = game.Players:GetChildren()
if script.Plays.Value &gt;= (#play/2) then--
script.Plays.Value = 0
pla = game.Players:GetChildren()
for num = 1, #pla do
if pla[num]:findFirstChild(&quot;FixGame&quot;) ~= nil then
pla[num].FixGame.Value = false
pla[num].PlayerGui.inGame.FixGame.BackgroundColor3 = pla[num].PlayerGui.inGame.FixGame.Green.Value
end end



playersy = game.Players:GetChildren()
for num = 1, #playersy do--
playersy[num].PlayerGui.inGame.FixGame.TextLabel.Text = script.Plays.Value..&quot; / &quot;..(#play/2)
end --167,168
chil = game.Workspace:GetChildren()
for num = 1, #chil do--
if chil[num].Name ~= &quot;SpawnTower&quot; and chil[num].Name ~= &quot;_Game Script_&quot; and chil[num].Name ~= &quot;Leaderboard&quot; and chil[num].Name ~= &quot;ResetGame&quot; and chil[num]:findFirstChild(&quot;Humanoid&quot;) == nil and chil[num].Name ~= &quot;Camera&quot; and chil[num].Name ~= &quot;Message&quot; then--
childrens = chil[num]:GetChildren()
for numy = 1, #childrens do
if childrens[numy].className == &quot;Sound&quot; then
childrens[numy]:stop()
end end
wait(.1)
chil[num]:remove()
end end --22,23
