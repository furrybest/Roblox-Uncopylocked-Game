Map:MakeJoints()
Map:MoveTo(Vector3.new(0, 400, 0)) -- Place map
wait(.2)
players = game.Players:GetChildren()
for num = 1, #players do
if players[num]:findFirstChild(&quot;inGame&quot;) ~= nil then
if players[num].inGame.Value == true then
players[num].Character.Humanoid.Health = 0
players[num].PlayerGui.Scripts.Loading.Visible = true
end
end
end
game.Lighting.TimeOfDay = &quot;14:00:00&quot;
game.Lighting.Ambient = game.Lighting.FireCol.Value
goldFinder = game.Workspace:GetChildren()
for GoldNum = 1, #goldFinder do
if goldFinder[GoldNum].Name == &quot;Gold&quot; then
goldFinder[GoldNum]:remove()
end end


elseif script.Section.Value == 18 then
stuff = game.Workspace:GetChildren()
for num = 1, #stuff do
if stuff[num] ~= nil then
if stuff[num]:findFirstChild(&quot;Zombie&quot;) ~= nil then
stuff[num]:remove()
end end end
game.Workspace:findFirstChild(&quot;Sec17_Map11&quot;).TOPW:stop()
wait(.5)
game.Workspace:findFirstChild(&quot;Sec17_Map11&quot;):remove()
Map = game.Lighting:findFirstChild(&quot;Sec18_Map12&quot;):clone()
Map.Parent = Workspace
Map:MakeJoints()
Map:MoveTo(Vector3.new(0, 400, 0)) -- Place map
wait(.2)
Map.Boss.Script.Disabled = false
players = game.Players:GetChildren()
for num = 1, #players do
if players[num]:findFirstChild(&quot;inGame&quot;) ~= nil then
if players[num].inGame.Value == true then
players[num].Character.Humanoid.Health = 0
players[num].PlayerGui.Scripts.Loading.Visible = true
end
end
end

game.Lighting.Ambient = game.Lighting.FireCol.Value

goldFinder = game.Workspace:GetChildren()
for GoldNum = 1, #goldFinder do
if goldFinder[GoldNum].Name == &quot;Gold&quot; then
goldFinder[GoldNum]:remove()
end end

elseif script.Section.Value == 18.5 then
game.Lighting.TimeOfDay = &quot;14:00:00&quot;
game.Lighting.Ambient = game.Lighting.FireCol.Value
game.Workspace:findFirstChild(&quot;Sec18_Map12&quot;).TOPW:stop()
wait(.5)
game.Workspace:findFirstChild(&quot;Sec18_Map12&quot;):remove()

Map = game.Lighting:findFirstChild(&quot;Sec18.5_Cut7&quot;):clone()
Map.Parent = Workspace
Map:MakeJoints()
Map:MoveTo(Vector3.new(0, 400, 0)) -- Place map
wait(.2)
players = game.Players:GetChildren()
for num = 1, #players do
if players[num]:findFirstChild(&quot;inGame&quot;) ~= nil then
if players[num].inGame.Value == true then
players[num].Character.Humanoid.Health = 0
players[num].PlayerGui.Scripts.Loading.Visible = true
end
end
end

wait(3)
Map:findFirstChild(&quot;_Cutscene Procedure_&quot;).Start.Value = true
--]]
goldFinder = game.Workspace:GetChildren()
for GoldNum = 1, #goldFinder do
if goldFinder[GoldNum].Name == &quot;Gold&quot; then
goldFinder[GoldNum]:remove()
end end


elseif script.Section.Value == 19 then
game.Lighting.Ambient = game.Lighting.Light.Value
game.Lighting.Brightness = 1
game.Workspace:findFirstChild(&quot;Sec18.5_Cut7&quot;).TOPW:stop()
wait(.5)
game.Workspace:findFirstChild(&quot;Sec18.5_Cut7&quot;):remove()
Map = game.Lighting:findFirstChild(&quot;Sec19_Map13&quot;):clone()
Map.Parent = Workspace
Map:MakeJoints()
Map:MoveTo(Vector3.new(0, 400, 0)) -- Place map
wait(.2)
Map.StartCredits.Disabled = false
players = game.Players:GetChildren()
for num = 1, #players do
if players[num]:findFirstChild(&quot;inGame&quot;) ~= nil then
if players[num].inGame.Value == true then
players[num].Character.Humanoid.Health = 0
players[num].PlayerGui.Scripts.Loading.Visible = true
end
end
end
goldFinder = game.Workspace:GetChildren()
for GoldNum = 1, #goldFinder do
if goldFinder[GoldNum].Name == &quot;Gold&quot; then
goldFinder[GoldNum]:remove()
end end
elseif script.Section.Value == 20 then
game.Workspace:findFirstChild(&quot;Sec19_Map13&quot;).Schala:stop()
wait(.5)
game.Workspace:findFirstChild(&quot;Sec19_Map13&quot;):remove()
script.Section.Value = 1
game.Lighting.Ambient = game.Lighting.Light.Value
goldFinder = game.Workspace:GetChildren()
for GoldNum = 1, #goldFinder do
if goldFinder[GoldNum].Name == &quot;Gold&quot; then
goldFinder[GoldNum]:remove()
end end





end
