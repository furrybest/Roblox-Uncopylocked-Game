game.Workspace.Chris.AIPaths.Follow.Value = &quot;Chris4&quot;
wait(2)
play = game.Players:GetChildren()
for NUMOFCAM = 1, #play do
&#9;if play[NUMOFCAM]:findFirstChild(&quot;inGame&quot;) ~= nil then
&#9;&#9;if play[NUMOFCAM].inGame.Value == true then
&#9;&#9;&#9;script.Cam5:clone().Parent = play[NUMOFCAM].Backpack
end end end
game.Workspace.Wesker:findFirstChild(&quot;Right Arm&quot;).Transparency = 0
game.Workspace.Wesker:findFirstChild(&quot;Left Arm&quot;).Transparency = 0
game.Workspace.Wesker:findFirstChild(&quot;Right Leg&quot;).Transparency = 0
game.Workspace.Wesker:findFirstChild(&quot;Left Leg&quot;).Transparency = 0
game.Workspace.Wesker:findFirstChild(&quot;Head&quot;).Transparency = 0
game.Workspace.Wesker:findFirstChild(&quot;Torso&quot;).Transparency = 0
game.Workspace.Wesker.Zombie.WalkSpeed = 16
script.Parent.ChrisAnimSet2.Anim8.P1.Transparency = 1
script.Parent.ChrisAnimSet2.Anim8.P2.Transparency = 1
script.Parent.ChrisAnimSet2.Anim8.P3.Transparency = 1
script.Parent.ChrisAnimSet2.Anim8.P4.Transparency = 1
script.Parent.ChrisAnimSet2.Anim8.P5.Transparency = 1
script.Parent.ChrisAnimSet2.Anim8.P6.Transparency = 1
game.Workspace.Wesker.AIPaths.Follow.Value = &quot;Wesker3&quot;
wait(2)
play = game.Players:GetChildren()
for NUMOFCAM = 1, #play do
&#9;if play[NUMOFCAM]:findFirstChild(&quot;inGame&quot;) ~= nil then
&#9;&#9;if play[NUMOFCAM].inGame.Value == true then
&#9;&#9;&#9;script.Cam6:clone().Parent = play[NUMOFCAM].Backpack
end end end
game.Workspace.Jill.AIPaths.Follow.Value = &quot;Jill4&quot;
game.Workspace.Jill.Zombie.WalkSpeed = 28
wait(5)
play = game.Players:GetChildren()
for NUMOFCAM = 1, #play do
&#9;if play[NUMOFCAM]:findFirstChild(&quot;inGame&quot;) ~= nil then
&#9;&#9;if play[NUMOFCAM].inGame.Value == true then
&#9;&#9;&#9;script.Cam5:clone().Parent = play[NUMOFCAM].Backpack
end end end
game.Workspace.Wesker:findFirstChild(&quot;Right Arm&quot;).Transparency = 1
game.Workspace.Wesker:findFirstChild(&quot;Left Arm&quot;).Transparency = 1
game.Workspace.Wesker:findFirstChild(&quot;Right Leg&quot;).Transparency = 1
game.Workspace.Wesker:findFirstChild(&quot;Left Leg&quot;).Transparency = 1
game.Workspace.Wesker:findFirstChild(&quot;Head&quot;).Transparency = 1
game.Workspace.Wesker:findFirstChild(&quot;Torso&quot;).Transparency = 1
script.Parent.JillAnim1.Disabled = false

--FINISH SCRIPT HERE (MOVE CAMER BRICK ETC.)
wait(7)
game.Workspace:findFirstChild(&quot;_Game Script_&quot;).Section.Value = 6
end)


