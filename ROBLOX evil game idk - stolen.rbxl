				<Item class="Script" referent="RBX2299">
					<Properties>
						<bool name="Archivable">true</bool>
						<bool name="Disabled">true</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">ChrisAnim2</string>
						<ProtectedString name="Source">set = script.Parent.ChrisAnimSet2:GetChildren()
numy = 0
while numy &lt; #set do
numy = numy + 1
if numy &gt; 8 then
script.Parent.ChrisAnimSet2.Anim8.P1.Transparency = 0
