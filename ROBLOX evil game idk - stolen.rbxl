				<Item class="Script" referent="RBX2229">
					<Properties>
						<bool name="Archivable">true</bool>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">_Cutscene Procedure_</string>
						<ProtectedString name="Source">function LoadJill(x,y,z)
local num = false
while num ~= true do
zom = game.Lighting.Cut3.Jill:clone()
zom.Parent = game.Workspace
zom.Torso.CFrame = CFrame.new(x,y,z)
wait(1)
if zom.Zombie.Health &gt; 1 then
num = true
else
zom:remove()
end
end
end
function LoadWesker(x,y,z)
local num = false
while num ~= true do
zom = game.Lighting.Cut3.Wesker:clone()
zom.Parent = game.Workspace
zom.Torso.CFrame = CFrame.new(x,y,z)
wait(1)
if zom.Zombie.Health &gt; 1 then
num = true
else
zom:remove()
end
end
end
function LoadChris(x,y,z)
local num = false
while num ~= true do
zom = game.Lighting.Cut3.Chris:clone()
zom.Parent = game.Workspace
zom.Torso.CFrame = CFrame.new(x,y,z)
wait(1)
if zom.Zombie.Health &gt; 1 then
num = true
else
zom:remove()
end
end
end



