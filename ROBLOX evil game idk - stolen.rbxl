obj201=Instance.new(&quot;TextLabel&quot;) obj201.Active=false obj201.BackgroundColor3=Color3.new(172/255,174/255,173/255) obj201.BackgroundTransparency=1 obj201.BorderColor3=Color3.new(27/255,42/255,53/255) obj201.Name=&quot;Title&quot; obj201.Parent=obj200 obj201.Position=UDim2.new(0,5,0,5) obj201.Size=UDim2.new(1,-10,0,13) obj201.Text=&quot;Move&quot; obj201.TextColor3=Color3.new(27/255,42/255,53/255) obj201.TextTransparency=1 obj201.TextXAlignment=Enum.TextXAlignment.Left
obj202=Instance.new(&quot;TextLabel&quot;) obj202.Active=false obj202.BackgroundColor3=Color3.new(255/255,176/255,0/255) obj202.BackgroundTransparency=1 obj202.BorderColor3=Color3.new(27/255,42/255,53/255) obj202.Name=&quot;Text&quot; obj202.Parent=obj200 obj202.Position=UDim2.new(0,5,0,23) obj202.Size=UDim2.new(1,-10,0,74) obj202.Text=&quot;The one key thing to remember when moving bricks is that if you have the checkbox under the Help button toggled, the brick will move relative to its own rotation. Otherwise, it will move along the world&apos;s x, y, and z axes.&quot; obj202.TextColor3=Color3.new(27/255,42/255,53/255) obj202.TextTransparency=1 obj202.TextWrap=true obj202.TextXAlignment=Enum.TextXAlignment.Left obj202.TextYAlignment=Enum.TextYAlignment.Top
obj203=Instance.new(&quot;TextButton&quot;) obj203.BackgroundColor3=Color3.new(255/255,176/255,0/255) obj203.BorderColor3=Color3.new(27/255,42/255,53/255) obj203.Name=&quot;Return&quot; obj203.Parent=obj200 obj203.Position=UDim2.new(0,5,0,100) obj203.Size=UDim2.new(1,-10,0,13) obj203.Text=&quot;Close the Window&quot; obj203.TextColor3=Color3.new(27/255,42/255,53/255)
