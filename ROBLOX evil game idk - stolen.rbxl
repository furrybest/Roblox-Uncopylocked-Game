						<Item class="Script" referent="RBX8294">
							<Properties>
								<bool name="Archivable">true</bool>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">Script</string>
								<ProtectedString name="Source">local oneTime = false
function onTouched(hit)
print(oneTime)
if oneTime == false then
oneTime = true
if hit ~= nil then
if hit.Parent:findFirstChild(&quot;Humanoid&quot;) ~= nil then

num = 0
while num &lt; 15 do
num = num + 1
wait(.1)
if hit.Parent.Humanoid.Health &gt; 0 and script.Parent.Parent.Zombie.Health &gt; 0 then
script.Parent.Parent.Zombie.WalkSpeed = 0
hit.Parent.Humanoid.WalkSpeed = 0
script.Parent.Parent.Tongue.Transparency = 0
else
script.Parent.Parent.Zombie.WalkSpeed = 16
if hit.Parent.Torso.roblox.Texture == &quot;http://www.roblox.com/asset/?id=49482336&quot; then
hit.Parent.Humanoid.WalkSpeed = 20
else
hit.Parent.Humanoid.WalkSpeed = 16
end
script.Parent.Parent.Tongue.Transparency = 1
oneTime = false
return
end
end
hit.Parent.Humanoid.Health = hit.Parent.Humanoid.Health - 25
if hit.Parent.Torso.roblox.Texture == &quot;http://www.roblox.com/asset/?id=49482336&quot; then
hit.Parent.Humanoid.WalkSpeed = 20
else
hit.Parent.Humanoid.WalkSpeed = 16
end
script.Parent.Parent.Tongue.Transparency = 1
wait(2)
script.Parent.Parent.Zombie.WalkSpeed = 16
end
end
oneTime = false
end
end
script.Parent.Touched:connect(onTouched) </ProtectedString>
