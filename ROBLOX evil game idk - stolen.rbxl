							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Zombie Startup</string>
							<ProtectedString name="Source">wait(.5)
welds = script.Parent.Torso:GetChildren()
for num = 1, #welds do
if welds[num].Name == &quot;SecondaryWeld&quot; then
welds[num]:remove()
end end
wait(.5)
local w1 = Instance.new(&quot;Weld&quot;)
&#9;w1.Parent = script.Parent.Torso
&#9;w1.Part0 = w1.Parent
&#9;w1.Part1 = script.Parent.Torso2
&#9;w1.C1 = CFrame.fromEulerAnglesXYZ(0, 0, 0) * CFrame.new(0, -.5, 1)
&#9;w1.Name = &quot;SecondaryWeld&quot;
&#9;
&#9;local w2 = Instance.new(&quot;Weld&quot;)
&#9;w2.Parent = script.Parent.Torso
&#9;w2.Part0 = w2.Parent
&#9;w2.Part1 = script.Parent.arm1
&#9;w2.C1 = CFrame.fromEulerAnglesXYZ(-1.5, -1.7, -.1) * CFrame.new(-1.5, -.5, .5)
&#9;w2.Name = &quot;SecondaryWeld&quot;

&#9;local w3 = Instance.new(&quot;Weld&quot;)
&#9;w3.Parent = script.Parent.Torso
&#9;w3.Part0 = w3.Parent
&#9;w3.Part1 = script.Parent.tent
&#9;w3.C1 = CFrame.fromEulerAnglesXYZ(-1.5, 0, 0) * CFrame.new(0, -1.2, .5)
&#9;w3.Name = &quot;SecondaryWeld&quot;

&#9;local w4 = Instance.new(&quot;Weld&quot;)
