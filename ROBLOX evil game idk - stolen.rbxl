					<Item class="Script" referent="RBX5575">
						<Properties>
							<bool name="Archivable">true</bool>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script</string>
							<ProtectedString name="Source">local waiter = false
function onTouched(hit)
if hit ~= nil then
if hit.Parent:findFirstChild(&quot;Humanoid&quot;) ~= nil then
if waiter == false then
waiter = true
bricks = script.Parent.Parent.YellowBricks:GetChildren()
for num = 1, #bricks do
if bricks[num].Transparency == 1 then
bricks[num].Transparency = 0
bricks[num].CanCollide = true
else
bricks[num].Transparency = 1
bricks[num].CanCollide = false
end end
wait(1)
waiter = false
end
end
end
end 
--end of ends
script.Parent.Touched:connect(onTouched)</ProtectedString>
