local ba = but.Parent:GetChildren()
for numy = 1, #ba do
if but.Parent:findFirstChild(&quot;sqr&quot;..numy).Text == &quot;N/A&quot; then
but.Parent:findFirstChild(&quot;sqr&quot;..numy).BackgroundColor3 = green
else
but.Parent:findFirstChild(&quot;sqr&quot;..numy).BackgroundColor3 = red
