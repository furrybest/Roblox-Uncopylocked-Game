							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script</string>
							<ProtectedString name="Source">local hin = Instance.new(&quot;Hint&quot;)
local cont = false
function onTouched(hit)
if hit ~= nil then
if hit.Parent:findFirstChild(&quot;Humanoid&quot;) ~= nil then
if cont == false then
cont = true
hin.Parent = script.Parent
hin.Text = &quot;Chris(you): HQ, I&apos;ve arrived at the marshlands.&quot;
wait(7)
hin.Text = &quot;HQ: Alright, advance forward until you make it to Irving.&quot;
wait(7)
hin.Text = &quot;HQ: Be careful, there could be more hostiles around.&quot;
wait(5)
hin:remove()
wait(.5)
script.Parent:remove()
end
end
end
end

script.Parent.Touched:connect(onTouched)</ProtectedString>
