					<Item class="Script" referent="RBX3891">
						<Properties>
							<bool name="Archivable">true</bool>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script</string>
							<ProtectedString name="Source">local typeOfEmblem = &quot;YEmblem&quot;
function onTouched(hit)
if hit ~= nil then
if hit.Parent:findFirstChild(&quot;Humanoid&quot;) ~= nil then
game.Players:findFirstChild(hit.Parent.Name):findFirstChild(typeOfEmblem).Value = true
game.Players:findFirstChild(hit.Parent.Name).PlayerGui.inGame:findFirstChild(typeOfEmblem).Visible = true
wait(5)
if hit ~= nil then
game.Players:findFirstChild(hit.Parent.Name).PlayerGui.inGame:findFirstChild(typeOfEmblem).Visible = false
end
end end end

script.Parent.Touched:connect(onTouched)
</ProtectedString>
						</Properties>
					</Item>
