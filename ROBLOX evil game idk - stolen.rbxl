								<ProtectedString name="Source">function die()
if script.Parent.Parent.HelpGui.Visible == false then
script.Parent.Parent.HelpGui.Visible = true
else
script.Parent.Parent.HelpGui.Visible = false
end
end

script.Parent.MouseButton1Down:connect(die)</ProtectedString>
