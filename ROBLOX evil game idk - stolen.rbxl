						<string name="Name">AIPaths</string>
						<ProtectedString name="Source">fol = script.Follow.Value
sec = game.Workspace:findFirstChild(&quot;_Game Script_&quot;).Section
function findPieceInSection(foll)
if sec.Value == 1 then
return game.Workspace:findFirstChild(&quot;&quot;):findFirstChild(foll):findFirstChild(foll)
elseif sec.Value == 2 then
return game.Workspace:findFirstChild(&quot;&quot;):findFirstChild(foll):findFirstChild(foll)
elseif sec.Value == 3 then
return game.Workspace:findFirstChild(&quot;Sec3_Map2&quot;):findFirstChild(foll):findFirstChild(foll)
elseif sec.Value == 10 then
return game.Workspace:findFirstChild(&quot;Sec9_Map5&quot;):findFirstChild(foll):findFirstChild(foll)
elseif sec.Value == 5 then
return game.Workspace:findFirstChild(&quot;&quot;):findFirstChild(foll):findFirstChild(foll)
elseif sec.Value == 6 then
return game.Workspace:findFirstChild(&quot;&quot;):findFirstChild(foll):findFirstChild(foll)
elseif sec.Value == 17 then
return game.Workspace:findFirstChild(&quot;Sec17_Map11&quot;):findFirstChild(foll):findFirstChild(foll)
end end


function findNearestTorso(ZomTorso)
fol = script.Follow.Value
if fol ~= &quot;Humanoid&quot; then
return findPieceInSection(fol)
else
pla = game.Players:GetChildren()
test = nil
currentPlayer = nil
for num = 1, #pla do
if pla[num]:findFirstChild(&quot;inGame&quot;) ~= nil then
if pla[num].inGame.Value == true then
if test == nil then
test = (pla[num].Character.Torso.Position - ZomTorso).magnitude
currentPlayer = pla[num].Name
elseif (pla[num].Character.Torso.Position - ZomTorso).magnitude &lt; test then
test = (pla[num].Character.Torso.Position - ZomTorso).magnitude
currentPlayer = pla[num].Name
end end end end
if currentPlayer ~= nil then
if game.Players:findFirstChild(currentPlayer).Character ~= nil then
if game.Players:findFirstChild(currentPlayer).Character:findFirstChild(&quot;Torso&quot;) ~= nil then
script.Human.Value = currentPlayer
return game.Players:findFirstChild(currentPlayer).Character.Torso
end end end end end

while true do
wait(0.1)
local target = findNearestTorso(script.Parent.Torso.Position)
if target ~= nil then
script.Parent.Zombie:MoveTo(target.Position, target)
end
end
