obj202=Instance.new(&quot;TextLabel&quot;) obj202.Active=false obj202.BackgroundColor3=Color3.new(255/255,216/255,0/255) obj202.BackgroundTransparency=1 obj202.BorderColor3=Color3.new(27/255,42/255,53/255) obj202.Name=&quot;Text&quot; obj202.Parent=obj200 obj202.Position=UDim2.new(0,5,0,23) obj202.Size=UDim2.new(1,-10,0,74) obj202.Text=&quot;If you wish to rotate all of your bricks around a single point, click the button at the bottom of the Gui that says &apos;Around&apos; and then click the brick that you want to rotate everything around. To clear this, press the &quot;Around&quot; button twice.&quot; obj202.TextColor3=Color3.new(27/255,42/255,53/255) obj202.TextWrap=true obj202.TextXAlignment=Enum.TextXAlignment.Left obj202.TextYAlignment=Enum.TextYAlignment.Top
