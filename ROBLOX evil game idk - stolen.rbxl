						<Item class="Script" referent="RBX5314">
							<Properties>
								<bool name="Archivable">true</bool>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">Script</string>
								<ProtectedString name="Source">local stopper = false
function onTouched(hit)
if hit ~= nil then
if hit.Parent:findFirstChild(&quot;Humanoid&quot;) ~= nil then
if script.Parent.Transparency == 1 then
if stopper == false then
stopper = true
hit.Parent.Humanoid.WalkSpeed = 0
script.Parent.Transparency = 0
script.Parent.Parent.LArm2.Transparency = 0
script.Parent.Parent.RArm2.Transparency = 0
script.Parent.Parent.Head2.Transparency = 0

script.Parent.Parent.LArm1.Transparency = 1
script.Parent.Parent.RArm1.Transparency = 1
script.Parent.Parent.Head1.Transparency = 1
script.Parent.Parent.Torso1.Transparency = 1
game.Players:findFirstChild(hit.Parent.Name).PlayerGui.inGame.Weird:play()
game.Players:findFirstChild(hit.Parent.Name).PlayerGui.inGame.Yell:play()
game.Players:findFirstChild(hit.Parent.Name).PlayerGui.inGame.Yell2:play()
game.Players:findFirstChild(hit.Parent.Name).PlayerGui.inGame.Button.Visible = true
game.Players:findFirstChild(hit.Parent.Name).PlayerGui.inGame.Face.Visible = true
game.Players:findFirstChild(hit.Parent.Name).PlayerGui.inGame.Red.Visible = true
game.Players:findFirstChild(hit.Parent.Name).PlayerGui.inGame.TextLabel.Visible = true
game.Players:findFirstChild(hit.Parent.Name).PlayerGui.inGame.Button.Num.Value = 20
wait(6)
if hit ~= nil then
if game.Players:findFirstChild(hit.Parent.Name).PlayerGui.inGame.Button.Num.Value &gt; 0 then
hit.Parent.Humanoid.Health = 0
script.Parent.Transparency = 1
script.Parent.Parent.LArm2.Transparency = 1
script.Parent.Parent.RArm2.Transparency = 1
script.Parent.Parent.Head2.Transparency = 1

script.Parent.Parent.LArm1.Transparency = 0
script.Parent.Parent.RArm1.Transparency = 0
script.Parent.Parent.Head1.Transparency = 0
script.Parent.Parent.Torso1.Transparency = 0
else
script.Parent.Transparency = 1
script.Parent.Parent.LArm2.Transparency = 1
script.Parent.Parent.RArm2.Transparency = 1
script.Parent.Parent.Head2.Transparency = 1

script.Parent.Parent.LArm1.Transparency = 0
script.Parent.Parent.RArm1.Transparency = 0
script.Parent.Parent.Head1.Transparency = 0
script.Parent.Parent.Torso1.Transparency = 0
end end
wait(4)
stopper = false
end
end end end end

script.Parent.Touched:connect(onTouched)
</ProtectedString>
							</Properties>
						</Item>
					</Item>
