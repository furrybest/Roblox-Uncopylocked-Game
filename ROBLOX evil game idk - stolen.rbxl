								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">Script</string>
								<ProtectedString name="Source">sp = script.Parent
spp = script.Parent.Parent
gw = game.Workspace
sph = script.Parent.Parent:FindFirstChild(&quot;Zombie&quot;)
spt = script.Parent.Parent.tent
spla = script.Parent.Parent:FindFirstChild(&quot;Left Arm&quot;)
spra = script.Parent.Parent:FindFirstChild(&quot;Right Arm&quot;)
local attack = false


function punch(player)
if player ~= nil and player.Humanoid.Health &gt; 1 then
spra.Transparency = 1
spp.arm1.Transparency = 0
player.Humanoid.Health = player.Humanoid.Health - 10 * game.Players:findFirstChild(player.Name).Difficulty.Value
spp.Zombie.WalkSpeed = 2
wait(1)
spra.Transparency = 0
spp.arm1.Transparency = 1
spp.Zombie.WalkSpeed = 16
end end



function grab(player)
if player.UnderAttack.Value == true then
punch(player)
return
end
if player ~= nil and player.Humanoid.Health &gt; 1 then
player.UnderAttack.Value = true
spra.Transparency = 1
spla.Transparency = 1
spp.arm1.Transparency = 0
spp.arm2.Transparency = 0
spp.Zombie.WalkSpeed = 0
spt.Mesh.Scale = Vector3.new(.3, .3, .3)
spt.Transparency = 0
local grow = .3
local num = 1
if spp.Zombie.Health &gt; 1 then
player.Humanoid.WalkSpeed = 0
player.Torso.Anchored = true
player.UnderAttack.Value = true
else
if player.Torso.roblox.Texture == &quot;http://www.roblox.com/asset/?id=49482336&quot; then
player.Humanoid.WalkSpeed = 20
else
player.Humanoid.WalkSpeed = 16
end
player.Torso.Anchored = false
player.UnderAttack.Value = false
return
end
while num &lt; 5 do
num = num + 1
if spp.Zombie.Health &gt; 1 then
player.Humanoid.WalkSpeed = 0
player.Torso.Anchored = true
player.UnderAttack.Value = true
else
if player.Torso.roblox.Texture == &quot;http://www.roblox.com/asset/?id=49482336&quot; then
player.Humanoid.WalkSpeed = 20
else
player.Humanoid.WalkSpeed = 16
end
player.Torso.Anchored = false
player.UnderAttack.Value = false
return
end
if player ~= nil and player.Humanoid.Health &gt; 1 then
spt.Mesh.Scale = Vector3.new(grow, grow, grow)
grow = grow + .1
wait(.1)
else
spra.Transparency = 0
spla.Transparency = 0
spp.arm1.Transparency = 1
spp.arm2.Transparency = 1
spp.Zombie.WalkSpeed = 16
spt.Mesh.Scale = Vector3.new(.3, .3, .3)
spt.Transparency = 1
num = 21
end end



local num = 1
while num &lt; 20 do
num = num + 1
if spp.Zombie.Health &gt; 1 then
player.Humanoid.WalkSpeed = 0
player.Torso.Anchored = true
player.UnderAttack.Value = true
else
if player.Torso.roblox.Texture == &quot;http://www.roblox.com/asset/?id=49482336&quot; then
player.Humanoid.WalkSpeed = 20
else
player.Humanoid.WalkSpeed = 16
end
player.Torso.Anchored = false
player.UnderAttack.Value = false
return
end
if player ~= nil and player.Humanoid.Health &gt; 1 then
grow = grow + .1
wait(.1)
else
spra.Transparency = 0
spla.Transparency = 0
spp.arm1.Transparency = 1
spp.arm2.Transparency = 1
spp.Zombie.WalkSpeed = 16
spt.Mesh.Scale = Vector3.new(.3, .3, .3)
spt.Transparency = 1
num = 21
end end

spt.Mesh.Scale = Vector3.new(1, 1, 1)
wait(.1)
player.Humanoid.Health = player.Humanoid.Health - 20 * game.Players:findFirstChild(player.Name).Difficulty.Value
if player.Torso.roblox.Texture == &quot;http://www.roblox.com/asset/?id=49482336&quot; then
player.Humanoid.WalkSpeed = 20
else
player.Humanoid.WalkSpeed = 16
end
player.Torso.Anchored = false
player.UnderAttack.Value = false
sp.Sound:play()
wait(1.5)
spt.Mesh.Scale = Vector3.new(.6, .6, .6)
wait(1.5)
spra.Transparency = 0
spla.Transparency = 0
spp.arm1.Transparency = 1
spp.arm2.Transparency = 1
spp.Zombie.WalkSpeed = 16
spt.Mesh.Scale = Vector3.new(.3, .3, .3)
spt.Transparency = 1
end end




function onTouched(hit)
if hit ~= nil then
if hit.Parent:findFirstChild(&quot;Humanoid&quot;) ~= nil then
if attack == false then
attack = true
m = math.random(1,2)
if m == 1 then
punch(hit.Parent)
elseif m == 2 then
grab(hit.Parent)
end end end attack = false end end

script.Parent.Touched:connect(onTouched) </ProtectedString>
							</Properties>
						</Item>
						<Item class="Sound" referent="RBX8050">
							<Properties>
								<bool name="Archivable">true</bool>
								<bool name="Looped">false</bool>
