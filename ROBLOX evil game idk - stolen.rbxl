function LoadZombie(x,y,z)
local num = false
while num ~= true do
zom = game.Lighting.Majini:clone()
zom.RegenScript.Xpos.Value = x
zom.RegenScript.Ypos.Value = y
zom.RegenScript.Zpos.Value = z
zom.Parent = game.Workspace
zom.Torso.CFrame = CFrame.new(x,y,z)
wait(1)
if zom.Zombie.Health &gt; 1 then
num = true
zom:findFirstChild(&quot;Zombie Startup&quot;).Disabled = false
else
zom:remove()
end
end
end

function LoadReaper(x,y,z)
local num = false
while num ~= true do
zom = game.Lighting.Special.Reaper:clone()
zom.RegenScript.Xpos.Value = x
zom.RegenScript.Ypos.Value = y
zom.RegenScript.Zpos.Value = z
zom.Parent = game.Workspace
zom.Torso.CFrame = CFrame.new(x,y,z)
wait(1)
if zom.Zombie.Health &gt; 1 then
num = true
else
zom:remove()
end
end
end

function LoadLicker(x,y,z)
local num = false
while num ~= true do
zom = game.Lighting.Special.Licker:clone()
zom.RegenScript.Xpos.Value = x
zom.RegenScript.Ypos.Value = y
zom.RegenScript.Zpos.Value = z
zom.Parent = game.Workspace
zom.Torso.CFrame = CFrame.new(x,y,z)
wait(1)
if zom.Zombie.Health &gt; 1 then
num = true
else
zom:remove()
end
end
end

