script.Parent.Winds:stop()
script.Parent.TOPW:play()
s:play()
script.Parent.Fire1.Fire.Enabled = true
script.Parent.Fire2.Fire.Enabled = true
script.Parent.Fire3.Fire.Enabled = true
LoadZombie(script.Parent.ZomTele1.Position.X, script.Parent.ZomTele1.Position.Y, script.Parent.ZomTele1.Position.Z)
LoadZombie(script.Parent.ZomTele2.Position.X, script.Parent.ZomTele2.Position.Y, script.Parent.ZomTele2.Position.Z)
LoadZombie(script.Parent.ZomTele7.Position.X, script.Parent.ZomTele7.Position.Y, script.Parent.ZomTele7.Position.Z)
LoadZombie(script.Parent.ZomTele8.Position.X, script.Parent.ZomTele8.Position.Y, script.Parent.ZomTele8.Position.Z)
LoadZombie(script.Parent.ZomTele9.Position.X, script.Parent.ZomTele9.Position.Y, script.Parent.ZomTele9.Position.Z)
LoadZombie(script.Parent.ZomTele10.Position.X, script.Parent.ZomTele10.Position.Y, script.Parent.ZomTele10.Position.Z)
LoadZombie(script.Parent.ZomTele11.Position.X, script.Parent.ZomTele11.Position.Y, script.Parent.ZomTele11.Position.Z)
LoadZombie(script.Parent.ZomTele12.Position.X, script.Parent.ZomTele12.Position.Y, script.Parent.ZomTele12.Position.Z)

s:play()
while script.time.Value &gt; 0 do
wait(1)
pla = game.Players:GetChildren()
for num = 1, #pla do
if pla[num]:findFirstChild(&quot;inGame&quot;) ~= nil then
if pla[num]:findFirstChild(&quot;inGame&quot;).Value == true then
pla[num].PlayerGui.inGame.Timer.Visible = true
pla[num].PlayerGui.inGame.Timer.Text = &quot;Time Left: &quot;..script.time.Value
end end end
script.time.Value = script.time.Value - 1
if script.time.Value == 200 then
s:play()
script.Parent.TOPW:stop()
wait()
script.Parent.TOPW.Pitch = 2.5
script.Parent.Fire4.Fire.Enabled = true
script.Parent.Fire5.Fire.Enabled = true
script.Parent.TOPW:play()
s:play()
LoadZombie(script.Parent.ZomTele3.Position.X, script.Parent.ZomTele3.Position.Y, script.Parent.ZomTele3.Position.Z)
LoadZombie(script.Parent.ZomTele6.Position.X, script.Parent.ZomTele6.Position.Y, script.Parent.ZomTele6.Position.Z)
s:play()
elseif script.time.Value == 100 then
s:play()
script.Parent.TOPW:stop()
wait()
s:play()
script.Parent.TOPW.Pitch = 3
script.Parent.Smoke1.Smoke.Enabled = true
script.Parent.TOPW:play()
LoadReaper(script.Parent.ZomTele4.Position.X, script.Parent.ZomTele4.Position.Y, script.Parent.ZomTele4.Position.Z)
LoadLicker(script.Parent.ZomTele5.Position.X, script.Parent.ZomTele5.Position.Y, script.Parent.ZomTele5.Position.Z)
s:play()
end
end
