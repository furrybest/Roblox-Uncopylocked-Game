					</Properties>
					<Item class="Script" referent="RBX3351">
						<Properties>
							<bool name="Archivable">true</bool>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script</string>
							<ProtectedString name="Source">local cont = false
function LoadZombie(x,y,z)
local num = false
while num ~= true do
zom = game.Lighting.Marshland.Majini:clone()
zom.RegenScript.Xpos.Value = x
zom.RegenScript.Ypos.Value = y
zom.RegenScript.Zpos.Value = z
zom.Parent = game.Workspace
zom.Torso.CFrame = CFrame.new(x,y,z)
wait(1)
if zom.Zombie.Health &gt; 1 then
num = true
zom:findFirstChild(&quot;Zombie Startup&quot;).Disabled = false
else
zom:remove()
end
end
end

function onTouched(hit)
if hit ~= nil then
if hit.Parent:findFirstChild(&quot;Humanoid&quot;) ~= nil then
if cont == false then
cont = true
script.Parent.Parent.TimerScript.Disabled = false
script.Parent.Parent.Awakenking:stop()
script.Parent.Parent.Tunnel:play()
bricks = script.Parent.Parent.Gate1:GetChildren()
for num = 1, #bricks do
if bricks[num].Name == &quot;InvWall&quot; then
bricks[num].CanCollide = true
else
bricks[num].Transparency = 0
bricks[num].CanCollide = true
end end
bricks = script.Parent.Parent.Gate2:GetChildren()
for num = 1, #bricks do
if bricks[num].Name == &quot;InvWall&quot; then
bricks[num].CanCollide = true
else
bricks[num].Transparency = 0
bricks[num].CanCollide = true
end end
script.Parent.CanCollide = true
script.Parent.CanCollide = false
LoadZombie(script.Parent.Parent.ZomTele1.Position.X, script.Parent.Parent.ZomTele1.Position.Y, script.Parent.Parent.ZomTele1.Position.Z)
LoadZombie(script.Parent.Parent.ZomTele2.Position.X, script.Parent.Parent.ZomTele2.Position.Y, script.Parent.Parent.ZomTele2.Position.Z)
LoadZombie(script.Parent.Parent.ZomTele3.Position.X, script.Parent.Parent.ZomTele3.Position.Y, script.Parent.Parent.ZomTele3.Position.Z)
LoadZombie(script.Parent.Parent.ZomTele4.Position.X, script.Parent.Parent.ZomTele4.Position.Y, script.Parent.Parent.ZomTele4.Position.Z)
LoadZombie(script.Parent.Parent.ZomTele5.Position.X, script.Parent.Parent.ZomTele5.Position.Y, script.Parent.Parent.ZomTele5.Position.Z)
LoadZombie(script.Parent.Parent.ZomTele6.Position.X, script.Parent.Parent.ZomTele6.Position.Y, script.Parent.Parent.ZomTele6.Position.Z)
LoadZombie(script.Parent.Parent.ZomTele3.Position.X, script.Parent.Parent.ZomTele3.Position.Y, script.Parent.Parent.ZomTele3.Position.Z)
LoadZombie(script.Parent.Parent.ZomTele4.Position.X, script.Parent.Parent.ZomTele4.Position.Y, script.Parent.Parent.ZomTele4.Position.Z)
LoadZombie(script.Parent.Parent.ZomTele5.Position.X, script.Parent.Parent.ZomTele5.Position.Y, script.Parent.Parent.ZomTele5.Position.Z)
LoadZombie(script.Parent.Parent.ZomTele6.Position.X, script.Parent.Parent.ZomTele6.Position.Y, script.Parent.Parent.ZomTele6.Position.Z)

script.Parent.Parent.Start.Position = Vector3.new(script.Parent.Parent.Start2.Position)
game.Workspace:findFirstChild(&quot;_Game Script_&quot;).Section.Value = 7
pla = game.Players:GetChildren()
for num = 1, #pla do
if pla[num]:findFirstChild(&quot;inGame&quot;) ~= nil then
if pla[num].inGame.Value == true then
pla[num].Character.Humanoid.WalkSpeed = 0
pla[num].PlayerGui.Scripts.Loading.Visible = true
if pla[num].Character:findFirstChild(&quot;Torso&quot;) ~= nil then
pla[num].Character.Torso.CFrame = CFrame.new(script.Parent.Parent.Start2.Position)
end
end end end
wait(2)
for num = 1, #pla do
if pla[num]:findFirstChild(&quot;inGame&quot;) ~= nil then
if pla[num].inGame.Value == true then
pla[num].Character.Humanoid.WalkSpeed = 16
pla[num].PlayerGui.Scripts.Loading.Visible = false
end end end
wait(5)
script.Parent.Parent.Darkness.CanCollide = false
script.Parent.Parent.Darkness2.CanCollide = false
wait(.5)
script.Parent:remove()
end end end end
--end of ends
script.Parent.Touched:connect(onTouched)</ProtectedString>
