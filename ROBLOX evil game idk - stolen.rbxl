							<string name="Name">Script</string>
							<ProtectedString name="Source">function onTouched(hit)
if hit ~= nil then
if hit.Parent:findFirstChild(&quot;Humanoid&quot;) ~= nil then
game.Workspace:findFirstChild(&quot;_Game Script_&quot;).Section.Value = 5.5
end
end
end

