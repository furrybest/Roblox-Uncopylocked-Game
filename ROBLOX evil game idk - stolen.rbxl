SelectionBox.Color=BrickColor.new(&quot;Bright red&quot;)
SelectionBox.Parent=obj1

modeButtons={obj9,obj10,obj11,obj12,obj13,obj14,obj15,obj16,obj17,obj18}

handles=Instance.new(&quot;Handles&quot;)
handles.Name=&quot;BuildToolHandles&quot;
handles.Parent=obj1
axis_mode=&quot;X&quot; --axis mode is based off of obj21 and is set when handles are set.

archandles=Instance.new(&quot;ArcHandles&quot;)
archandles.Name=&quot;BuildToolArcHandles&quot;
archandles.Parent=obj1

index=1
permissions_mode=&quot;given&quot;
display_actions={&quot;move&quot;,&quot;save&quot;,&quot;delete&quot;,&quot;color&quot;,&quot;lock&quot;,&quot;change material of&quot;,&quot;change surface of&quot;,&quot;change transparency of&quot;,&quot;change reflectance of&quot;}
actions={&quot;Drag&quot;,&quot;Save&quot;,&quot;Delete&quot;,&quot;Color&quot;,&quot;Lock&quot;,&quot;Material&quot;,&quot;Surface&quot;,&quot;Transparency&quot;,&quot;Reflectance&quot;}
function refreshPermissionsGrid()
&#9;if permissions_mode==&quot;given&quot; then
&#9;&#9;for i,v in pairs(game.Players:GetChildren()) do
&#9;&#9;&#9;if i&gt;=index then
&#9;&#9;&#9;&#9;a=obj56:findFirstChild(&quot;Name&quot;..tostring(i+1-index)..&quot;Name&quot;)
&#9;&#9;&#9;&#9;a.Text=v.Name
&#9;&#9;&#9;&#9;for c=1,9 do
&#9;&#9;&#9;&#9;&#9;b=obj56:findFirstChild(&quot;Name&quot;..tostring(i+1-index)..&quot;Check&quot;..tostring(c))
&#9;&#9;&#9;&#9;&#9;b.Text=&quot;&quot;
&#9;&#9;&#9;&#9;&#9;if v:findFirstChild(&quot;BlobbyblobBuildToolStats&quot;) then
&#9;&#9;&#9;&#9;&#9;&#9;if v.BlobbyblobBuildToolStats:findFirstChild(&quot;Can&quot;..actions[c]..&quot;_&quot;..player.Name) then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;b.Text=&quot;X&quot;
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;elseif permissions_mode==&quot;taken&quot; then
&#9;&#9;for a=1,9 do --this loop clears all of the &quot;X&quot;s out of the grid.
&#9;&#9;&#9;for b=1,9 do
&#9;&#9;&#9;&#9;c=obj56:findFirstChild(&quot;Name&quot;..tostring(a+1-index)..&quot;Check&quot;..tostring(b))
&#9;&#9;&#9;&#9;if c then
&#9;&#9;&#9;&#9;&#9;c.Text=&quot;&quot;
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;if player:findFirstChild(&quot;BlobbyblobBuildToolStats&quot;) then
&#9;&#9;&#9;for i,v in pairs(player.BlobbyblobBuildToolStats:GetChildren()) do
&#9;&#9;&#9;&#9;f=string.find(v.Name,&quot;_&quot;)
&#9;&#9;&#9;&#9;if f~=nil and string.sub(v.Name,1,3)==&quot;Can&quot; then
&#9;&#9;&#9;&#9;&#9;action=string.sub(v.Name,4,f-1)
&#9;&#9;&#9;&#9;&#9;pName=string.sub(v.Name,f+1)
&#9;&#9;&#9;&#9;&#9;t=0
&#9;&#9;&#9;&#9;&#9;for a,b in pairs({&quot;Drag&quot;,&quot;Move&quot;,&quot;Size&quot;,&quot;Rotate&quot;,&quot;Anchor&quot;,&quot;Save&quot;,&quot;Delete&quot;,&quot;Color&quot;,&quot;Lock&quot;,&quot;Material&quot;,&quot;Surface&quot;,&quot;Transparency&quot;,&quot;Reflectance&quot;}) do
&#9;&#9;&#9;&#9;&#9;&#9;if action==b then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;t=a
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;plyr=&quot;&quot;
&#9;&#9;&#9;&#9;&#9;label_count=0
&#9;&#9;&#9;&#9;&#9;for a,b in pairs(obj56:GetChildren()) do
&#9;&#9;&#9;&#9;&#9;&#9;if string.sub(b.Name,6)==&quot;Name&quot; then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;label_count=label_count+1
&#9;&#9;&#9;&#9;&#9;&#9;&#9;if b.Text==pName then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;plyr=label_count
&#9;&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;if t&gt;=1 and t&lt;=5 then t=1 elseif t&gt;=6 then t=t-4 end
&#9;&#9;&#9;&#9;&#9;if t~=0 then
&#9;&#9;&#9;&#9;&#9;&#9;v=obj56:findFirstChild(&quot;Name&quot;..tostring(plyr)..&quot;Check&quot;..tostring(t))
&#9;&#9;&#9;&#9;&#9;&#9;if v~=nil then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;v.Text=&quot;X&quot;
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end

function givePermission(player,a)
&#9;if player:findFirstChild(&quot;BlobbyblobBuildToolStats&quot;)==nil then
&#9;&#9;local stats=Instance.new(&quot;IntValue&quot;)
&#9;&#9;stats.Parent=player
&#9;&#9;stats.Name=&quot;BlobbyblobBuildToolStats&quot;
&#9;end
&#9;stats=player:findFirstChild(&quot;BlobbyblobBuildToolStats&quot;)
&#9;for i,v in pairs(a) do
&#9;&#9;local permission=Instance.new(&quot;BoolValue&quot;)
&#9;&#9;permission.Name=&quot;Can&quot;..v..&quot;_&quot;..player.Name
&#9;&#9;permission.Parent=stats
&#9;&#9;permission.Value=true
&#9;end
end

function revokePermission(player,a)
&#9;if player:findFirstChild(&quot;BlobbyblobBuildToolStats&quot;)~=nil then
&#9;&#9;for i,v in pairs(a) do
&#9;&#9;&#9;while player.BlobbyblobBuildToolStats:findFirstChild(&quot;Can&quot;..v..&quot;_&quot;..player.Name)~=nil do
&#9;&#9;&#9;&#9;player.BlobbyblobBuildToolStats:findFirstChild(&quot;Can&quot;..v..&quot;_&quot;..player.Name):remove()
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end

function onScrollButtonDown(button)
if button==obj70 then index=math.max(1,index-1) end
if button==obj71 then index=math.min(math.max(#game.Players:GetChildren()-6,1),index+1) end
if button==obj57 then permissions_mode=&quot;given&quot; obj57.BackgroundColor3=Color3.new(102/255,1,51/255) obj58.BackgroundColor3=Color3.new(1,204/255,0) end
if button==obj58 then permissions_mode=&quot;taken&quot; obj60.Text=&quot;Build tool made by blobbyblob.&quot; obj58.BackgroundColor3=Color3.new(102/255,1,51/255) obj57.BackgroundColor3=Color3.new(1,204/255,0) end
refreshPermissionsGrid()
end
