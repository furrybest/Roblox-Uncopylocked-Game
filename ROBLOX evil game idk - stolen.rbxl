						<string name="Name">StartupPro</string>
						<ProtectedString name="Source">wait(5)
if script.Parent.Parent.Parent:findFirstChild(&quot;inGame&quot;) == nil then
script.Parent.Parent.StartGui.StartButton.Visible = true
script.Parent.Parent.StartGui.StartButton.Script.Disabled = false
else
script.Parent.Loading.Visible = false
if script.Parent.Parent.Parent:findFirstChild(&quot;inGame&quot;) ~= nil then
if script.Parent.Parent.Parent.inGame.Value == false then
script.Parent.Parent.StartGui.StartButton.Visible = true
script.Parent.Parent.StartGui.StartButton.Script.Disabled = false
if script.Parent.Parent.Parent:findFirstChild(&quot;Game Tool&quot;) ~= nil then
script.Parent.Parent.Parent:findFirstChild(&quot;Game Tool&quot;):remove()
end
--GOING TO GAME
else
local label = Instance.new(&quot;BoolValue&quot;)
label.Name = &quot;UnderAttack&quot;
label.Value = false
label.Parent = script.Parent.Parent.Parent.Character

GUN = script.Parent.Parent.Parent:findFirstChild(&quot;Game Tool&quot;):clone()
GUN.Parent = script.Parent.Parent.Parent.Backpack
GUN.ReturnBackpack.Disabled = false
script.Parent.Parent.StartGui.WeaponMenu.Box1.Text = GUN.WeaponList.W1.Value
script.Parent.Parent.StartGui.WeaponMenu.Box1.Weapon.Value = GUN.WeaponList.W1.Value
script.Parent.Parent.StartGui.WeaponMenu.Box2.Text = GUN.WeaponList.W2.Value
script.Parent.Parent.StartGui.WeaponMenu.Box2.Weapon.Value = GUN.WeaponList.W2.Value
script.Parent.Parent.StartGui.WeaponMenu.Box3.Text = GUN.WeaponList.W3.Value
script.Parent.Parent.StartGui.WeaponMenu.Box3.Weapon.Value = GUN.WeaponList.W3.Value
script.Parent.Parent.StartGui.WeaponMenu.Box4.Text = GUN.WeaponList.W4.Value
script.Parent.Parent.StartGui.WeaponMenu.Box4.Weapon.Value = GUN.WeaponList.W4.Value
script.Parent.Parent.StartGui.WeaponMenu.Box5.Text = GUN.WeaponList.W5.Value
script.Parent.Parent.StartGui.WeaponMenu.Box5.Weapon.Value = GUN.WeaponList.W5.Value
script.Parent.Parent.StartGui.WeaponMenu.Box6.Text = GUN.WeaponList.W6.Value
script.Parent.Parent.StartGui.WeaponMenu.Box6.Weapon.Value = GUN.WeaponList.W6.Value
script.Parent.Parent.StartGui.WeaponMenu.Box7.Text = GUN.WeaponList.W7.Value
script.Parent.Parent.StartGui.WeaponMenu.Box7.Weapon.Value = GUN.WeaponList.W7.Value
script.Parent.Parent.StartGui.WeaponMenu.Box8.Text = GUN.WeaponList.W8.Value
script.Parent.Parent.StartGui.WeaponMenu.Box8.Weapon.Value = GUN.WeaponList.W8.Value
script.Parent.Parent.StartGui.WeaponMenu.Box9.Text = GUN.WeaponList.W9.Value
script.Parent.Parent.StartGui.WeaponMenu.Box9.Weapon.Value = GUN.WeaponList.W9.Value
if script.Parent.Parent.Parent.Name == &quot;brickman637&quot; then
game.Lighting.StaffOfPower:clone().Parent = script.Parent.Parent.Parent.Backpack
game.Lighting.FrontFlip:clone().Parent = script.Parent.Parent.Parent.Backpack
game.Lighting.BackFlip:clone().Parent = script.Parent.Parent.Parent.Backpack
game.Lighting.SuperJump:clone().Parent = script.Parent.Parent.Parent.Backpack
game.Lighting.Build:clone().Parent = script.Parent.Parent.Parent.Backpack
game.Lighting.ZombieStaff:clone().Parent = script.Parent.Parent.Parent.Backpack
game.Lighting.MasterStaffOfSparks:clone().Parent = script.Parent.Parent.Parent.Backpack
end

--VIP
if script.Parent.Parent.Parent.Character.Torso.roblox.Texture == &quot;http://www.roblox.com/asset/?id=49482336&quot; or 
script.Parent.Parent.Parent.Character.Torso.roblox.Texture == &quot;http://www.roblox.com/asset/?id=61962950&quot; then
script.Parent.Parent.Parent.Character.Humanoid.WalkSpeed = 20
end

