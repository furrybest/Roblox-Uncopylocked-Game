&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end

&#9;if points&lt;1 then return end
&#9;patrolling=true
&#9;local time=2
