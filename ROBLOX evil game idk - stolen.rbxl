					<Item class="Script" referent="RBX5045">
						<Properties>
							<bool name="Archivable">true</bool>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script</string>
							<ProtectedString name="Source">local cont = false
function LoadZombie(x,y,z)
local num = false
while num ~= true do
zom = game.Lighting.Majini:clone()
zom.RegenScript.Xpos.Value = x
zom.RegenScript.Ypos.Value = y
zom.RegenScript.Zpos.Value = z
zom.Parent = game.Workspace
zom.Torso.CFrame = CFrame.new(x,y,z)
wait(1)
if zom.Zombie.Health &gt; 1 then
num = true
zom:findFirstChild(&quot;Zombie Startup&quot;).Disabled = false
else
zom:remove()
end
end
end
local hin = Instance.new(&quot;Hint&quot;)
function onTouched(hit)
if hit ~= nil then
if hit.Parent:findFirstChild(&quot;Humanoid&quot;) ~= nil then
if cont == false then
cont = true
script.Parent.Parent.TimerScript.Disabled = false
script.Parent.Parent.Gothic:stop()
script.Parent.Parent.Metal:play()
LoadZombie(script.Parent.Parent.ZomTele1.Position.X, script.Parent.Parent.ZomTele1.Position.Y, script.Parent.Parent.ZomTele1.Position.Z)
LoadZombie(script.Parent.Parent.ZomTele2.Position.X, script.Parent.Parent.ZomTele2.Position.Y, script.Parent.Parent.ZomTele2.Position.Z)
LoadZombie(script.Parent.Parent.ZomTele3.Position.X, script.Parent.Parent.ZomTele3.Position.Y, script.Parent.Parent.ZomTele3.Position.Z)
LoadZombie(script.Parent.Parent.ZomTele4.Position.X, script.Parent.Parent.ZomTele4.Position.Y, script.Parent.Parent.ZomTele4.Position.Z)
LoadZombie(script.Parent.Parent.ZomTele5.Position.X, script.Parent.Parent.ZomTele5.Position.Y, script.Parent.Parent.ZomTele5.Position.Z)
LoadZombie(script.Parent.Parent.ZomTele6.Position.X, script.Parent.Parent.ZomTele6.Position.Y, script.Parent.Parent.ZomTele6.Position.Z)
LoadZombie(script.Parent.Parent.ZomTele7.Position.X, script.Parent.Parent.ZomTele7.Position.Y, script.Parent.Parent.ZomTele7.Position.Z)
hin.Parent = script.Parent
hin.Text = &quot;Chris(you): Come in, HQ! The civilians are hostile!&quot;
wait(5)
hin.Text = &quot;Chris(you): I need backup!&quot;
wait(5)
hin.Text = &quot;HQ: Alright, we are sending backup.&quot;
wait(5)
hin.Text = &quot;HQ: Defend yourself until we get there.&quot;
wait(5)
hin:remove()
wait(.5)
script.Parent:remove()
end end end end

script.Parent.Touched:connect(onTouched)</ProtectedString>
