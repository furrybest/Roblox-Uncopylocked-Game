							<string name="Name">Script</string>
							<ProtectedString name="Source">local cont = false
function onTouched(hit)
if hit ~= nil then
if hit.Parent:findFirstChild(&quot;Humanoid&quot;) ~= nil then
if cont == false then
cont = true
script.Parent.Parent.Winds:stop()
script.Parent.Parent.Gothic:play()
script.Parent.Parent.TimerScript.Disabled = false
wait(.5)
script.Parent:remove()
end end end end

