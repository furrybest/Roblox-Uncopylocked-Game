								<string name="Name">Script</string>
								<ProtectedString name="Source">local sto = false
function onTouched(hit)
if hit ~= nil then
if hit.Parent:findFirstChild(&quot;Humanoid&quot;) ~= nil then
if script.Parent.Transparency == 0 then
if sto == false then
sto = true
game.Workspace:findFirstChild(&quot;_Game Script_&quot;).Section.Value = 14.5
end
end
end
end
end

script.Parent.Touched:connect(onTouched)</ProtectedString>
