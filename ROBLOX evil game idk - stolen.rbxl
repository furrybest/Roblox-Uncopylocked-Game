						<string name="Name">_Cutscene Procedure_</string>
						<ProtectedString name="Source">script.Start.Changed:connect(function()
chil = game.Players:GetChildren()
wait(4)
for num = 1, #chil do
&#9;if chil[num]:findFirstChild(&quot;inGame&quot;) ~= nil then
&#9;&#9;if chil[num].inGame.Value == true then
&#9;&#9;&#9;script.CamFocus:clone().Parent = chil[num].Backpack
end end end

wait(9)

local hin = Instance.new(&quot;Hint&quot;)
script.fire:play()
wait(.01)
set = script.Parent.Gun1:GetChildren()
for num = 1, #set do
set[num].Transparency = 1
end
set = script.Parent.Gun2:GetChildren()
for num = 1, #set do
set[num].Transparency = 0
end
wait(.2)
set = script.Parent.Gun1:GetChildren()
for num = 1, #set do
set[num].Transparency = 0
end
set = script.Parent.Gun2:GetChildren()
for num = 1, #set do
set[num].Transparency = 1
end
wait(.1)
script.fire:play()
wait(.01)
set = script.Parent.Gun1:GetChildren()
for num = 1, #set do
set[num].Transparency = 1
end
set = script.Parent.Gun2:GetChildren()
for num = 1, #set do
set[num].Transparency = 0
end
wait(.2)
set = script.Parent.Gun1:GetChildren()
for num = 1, #set do
set[num].Transparency = 0
end
set = script.Parent.Gun2:GetChildren()
for num = 1, #set do
set[num].Transparency = 1
end
wait(.1)
script.fire:play()
wait(.01)
set = script.Parent.Gun1:GetChildren()
for num = 1, #set do
set[num].Transparency = 1
end
set = script.Parent.Gun2:GetChildren()
for num = 1, #set do
set[num].Transparency = 0
end
wait(.2)
set = script.Parent.Gun1:GetChildren()
for num = 1, #set do
set[num].Transparency = 0
end
set = script.Parent.Gun2:GetChildren()
for num = 1, #set do
set[num].Transparency = 1
end
set = script.Parent.Gun1:GetChildren()
for num = 1, #set do
set[num].Transparency = 1
end
set = script.Parent.Person:GetChildren()
for num = 1, #set do
set[num].Transparency = 1
end
set = script.Parent.Person2:GetChildren()
for num = 1, #set do
set[num].Transparency = 0
end


WesChil = script.Parent.WesAnim1:GetChildren()
for num = 1, #WesChil do
WesChil[num].Transparency = 1
end
WesChil = script.Parent.WesAnim2:GetChildren()
for num = 1, #WesChil do
WesChil[num].Transparency = 0
end
wait(.1)
WesChil = script.Parent.WesAnim2:GetChildren()
for num = 1, #WesChil do
WesChil[num].Transparency = 1
end
WesChil = script.Parent.WesAnim3:GetChildren()
for num = 1, #WesChil do
WesChil[num].Transparency = 0
end
wait(.1)
WesChil = script.Parent.WesAnim3:GetChildren()
for num = 1, #WesChil do
WesChil[num].Transparency = 1
end
WesChil = script.Parent.WesAnim4:GetChildren()
for num = 1, #WesChil do
WesChil[num].Transparency = 0
end
wait(.1)
WesChil = script.Parent.WesAnim4:GetChildren()
for num = 1, #WesChil do
WesChil[num].Transparency = 1
end
WesChil = script.Parent.WesAnim5:GetChildren()
for num = 1, #WesChil do
WesChil[num].Transparency = 0
end
wait(.1)
















script.Parent.Heli.Floor.BodyVelocity.velocity = Vector3.new(-7,0,0)
wait(1)
print(&quot;HINT TIME&quot;)
hin.Parent = script.Parent
hin.Text = &quot;HQ: Good Job! We are coming to pick you up.&quot;
wait(8)
hin.Text = &quot;Wesker: CHHHRRRRRRIIIIIIISSSSSS!&quot;

script.Parent.WesAnim5.Tent.Transparency = 1
script.Parent.LongTent.Transparency = 0
local len = 5
while len &lt; 50 do
len = len + 1
wait(.05)
script.Parent.LongTent.Mesh.Scale = Vector3.new(2,len,2)
end

hin.Text = &quot;HQ: AWWWW!&quot;
wait(4)
hin.Text = &quot;HQ: Shoot him!&quot;
wait(2.5)
hin.Text = &quot;Chris(you): Time to end this...&quot;
wait(2)
set = script.Parent.Person:GetChildren()
for num = 1, #set do
set[num].Transparency = 0
end
set = script.Parent.Person2:GetChildren()
for num = 1, #set do
set[num].Transparency = 1
end
script.Parent.RocketL.Transparency = 0
set = script.Parent.Gun1:GetChildren()
for num = 1, #set do
set[num].Transparency = 0
end
script.Parent.Gun1.Gun.Transparency = 1
hin.Text = &quot;Chris(you): Eat this Wesker!&quot;
wait(.5)
script.Parent.RocketFire.Anim.Disabled = false
script.Parent.RocketFire.Transparency = 0
wait(2)
WesChil = script.Parent.WesAnim5:GetChildren()
for num = 1, #WesChil do
WesChil[num].Anchored = false
end
script.Parent.LongTent.Anchored = false
wait(.1)
wait(4)
hin.Text = &quot;HQ: Good job Chris, it&apos;s finally time to come home.&quot;
wait(6)
hin.Text = &quot;  &quot;
for num = 1, #chil do
&#9;if chil[num]:findFirstChild(&quot;inGame&quot;) ~= nil then
&#9;&#9;if chil[num].inGame.Value == true then
&#9;&#9;chil[num].PlayerGui.inGame.Fade.Start.Disabled = false
end end end


wait(6)
hin.Text = &quot;Chris(you): More and more I find myself wondering...&quot;
wait(6)
hin.Text = &quot;Chris(you): ...if it&apos;s all worth fighting for.&quot;
wait(6)
hin.Text = &quot;Chris(you): For a future without fear,&quot;
wait(6)
hin.Text = &quot;Chris(you): Ya, it&apos;s worth it.&quot;
wait(6)
hin:remove()


game.Workspace:findFirstChild(&quot;_Game Script_&quot;).Section.Value = 19
--FINISH SCRIPT HERE (MOVE CAMER BRICK ETC.)
end)


