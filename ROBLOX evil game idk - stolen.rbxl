						<string name="Name">ReturnBackpack</string>
						<ProtectedString name="Source">script.Parent.Changed:connect(function()
if script.Parent.Parent.Parent.Name ~= &quot;Workspace&quot; and script.Parent.Parent.Name ~= &quot;Backpack&quot; then
script.Parent.Parent = game.Players:findFirstChild(script.Parent.playerName.Value).Backpack
