						<ProtectedString name="Source">swoosh = script.Parent.Swoosh
swoosh:play()
dontRepeat = false
function onTouched(hit)
if dontRepeat == false then
dontRepeat = true
local chil = game.Workspace:children()
for x = 1, #chil do
if chil[x]:findFirstChild(&quot;Zombie&quot;) ~= nil and chil[x]:findFirstChild(&quot;Torso&quot;) ~= nil then
local dist = 20
if (chil[x].Torso.Position - script.Parent.Position).magnitude &lt;= dist then
if chil[x].Name ~= &quot;Jill&quot; then
game.Players:findFirstChild(script.Parent.PlayersName.Value).leaderstats.Gold.Value = game.Players:findFirstChild(script.Parent.PlayersName.Value).leaderstats.Gold.Value + 1
game.Players:findFirstChild(script.Parent.PlayersName.Value).Kills.Value = game.Players:findFirstChild(script.Parent.PlayersName.Value).Kills.Value + 1
if chil[x].Name == &quot;Licker&quot; then
game.Players:findFirstChild(script.Parent.PlayersName.Value).LickerKill.Value = true
elseif chil[x].Name == &quot;Reaper&quot; then
game.Players:findFirstChild(script.Parent.PlayersName.Value).ReaperKill.Value = true
end
chil[x].Zombie.Health = 0
else
chil[x].Zombie.Health = chil[x].Zombie.Health - 400
end end end end
swoosh:stop()
&#9;explosion = Instance.new(&quot;Explosion&quot;)
&#9;explosion.Position = script.Parent.Position
&#9;explosion.BlastRadius = 0
&#9;explosion.Parent = script.Parent
script.Parent.Transparency = 1
script.Parent.Explosion:play()
wait(.2)
script.Parent:remove()
end end

script.Parent.Touched:connect(onTouched)</ProtectedString>
