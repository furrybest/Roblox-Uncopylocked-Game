elseif fol == &quot;Humanoid&quot; and PName == &quot;startSpec6&quot; then
fol = &quot;Spec6g1p1&quot;

elseif fol == &quot;Humanoid&quot; and PName == &quot;startSpec7&quot; then
fol = &quot;Spec7g1p1&quot;

elseif fol == &quot;Humanoid&quot; and PName == &quot;startSpec8&quot; then
fol = &quot;Spec8g1p1&quot;


end 
script.Parent.AIPaths.Follow.Value = fol
end

