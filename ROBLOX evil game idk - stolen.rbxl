				<Item class="Script" referent="RBX2319">
					<Properties>
						<bool name="Archivable">true</bool>
						<bool name="Disabled">true</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">ChrisAnim1</string>
						<ProtectedString name="Source">set = script.Parent.ChrisAnimSet1:GetChildren()
numy = 0
while numy &lt; #set do
numy = numy + 1
if numy &gt; 3 then
wait(.13)
else
wait(.07)
end
parts = script.Parent.ChrisAnimSet1:findFirstChild(&quot;Anim&quot;..numy):GetChildren()
if numy &gt; 1 then
pieces = script.Parent.ChrisAnimSet1:findFirstChild(&quot;Anim&quot;..numy-1):GetChildren()
for num = 1, #pieces do
pieces[num].Transparency = 1
end
end
for num = 1, #parts do
parts[num].Transparency = 0
end
script.Parent.ChrisAnimSet1.Anim1.Vis1.Transparency = 0
script.Parent.ChrisAnimSet1.Anim1.Vis2.Transparency = 0
script.Parent.ChrisAnimSet1.Anim1.Vis3.Transparency = 0
script.Parent.ChrisAnimSet1.Anim1.Vis4.Transparency = 0
script.Parent.ChrisAnimSet1.Anim1.Vis5.Transparency = 0
if numy == 2 then
script.Parent.ChrisAnimSet1.Anim2.Vis1.Transparency = 0
elseif numy &gt; 2 then
script.Parent.ChrisAnimSet1.Anim3.Vis1.Transparency = 0
end
end
</ProtectedString>
					</Properties>
				</Item>
