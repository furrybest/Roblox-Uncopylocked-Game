									<Content name="LinkedSource"><null></null></Content>
									<string name="Name">Script</string>
									<ProtectedString name="Source">function onTouched(hit)
if script.Parent.Transparency == 0 then
if hit ~= nil then
if hit.Name == &quot;Paintball&quot; then
if hit:findFirstChild(&quot;Paintball&quot;) ~= nil then
if hit.Paintball.Damage.Value &lt; 10 then
script.Parent.Parent.Health.Value = script.Parent.Parent.Health.Value - 10
else
script.Parent.Parent.Health.Value = script.Parent.Parent.Health.Value - hit.Paintball.Damage.Value
end
elseif hit:findFirstChild(&quot;RocketScript&quot;) ~= nil then
script.Parent.Parent.Health.Value = script.Parent.Parent.Health.Value - 50
else
script.Parent.Parent.Health.Value = script.Parent.Parent.Health.Value - 10
end end end end end

script.Parent.Touched:connect(onTouched)</ProtectedString>
