				<Item class="Script" referent="RBX2209">
					<Properties>
						<bool name="Archivable">true</bool>
						<bool name="Disabled">true</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">JillAnim1</string>
						<ProtectedString name="Source">set = script.Parent.JillAnimSet1:GetChildren()
numy = 0
while numy &lt; #set do
numy = numy + 1
if numy &gt; 1 then
game.Workspace.Jill:findFirstChild(&quot;Right Arm&quot;).Transparency = 1
game.Workspace.Jill:findFirstChild(&quot;Left Arm&quot;).Transparency = 1
game.Workspace.Jill:findFirstChild(&quot;Right Leg&quot;).Transparency = 1
game.Workspace.Jill:findFirstChild(&quot;Left Leg&quot;).Transparency = 1
game.Workspace.Jill:findFirstChild(&quot;Head&quot;).Transparency = 1
game.Workspace.Jill:findFirstChild(&quot;Torso&quot;).Transparency = 1
end

if numy == 11 then
script.Parent.WINDOW.Transparency = 1
script.Parent.Win1.Transparency = .3
script.Parent.Win2.Transparency = .3
script.Parent.Win3.Transparency = .3
script.Parent.Win4.Transparency = .3
script.Parent.Win5.Transparency = .3
script.Parent.Win6.Transparency = .3
script.Parent.Win7.Transparency = .3
script.Parent.Win8.Transparency = .3
script.Parent.Win9.Transparency = .3
script.Glass:play()
end
wait(.11)
parts = script.Parent.JillAnimSet1:findFirstChild(&quot;Anim&quot;..numy):GetChildren()
if numy &gt; 1 then
pieces = script.Parent.JillAnimSet1:findFirstChild(&quot;Anim&quot;..numy-1):GetChildren()
for num = 1, #pieces do
pieces[num].Transparency = 1
end
end
for num = 1, #parts do
parts[num].Transparency = 0
end
if numy &lt; 7 then
script.Parent.JillAnimSet1.Anim1.P1.Transparency = 0
script.Parent.JillAnimSet1.Anim1.P2.Transparency = 0
script.Parent.JillAnimSet1.Anim1.P3.Transparency = 0
script.Parent.JillAnimSet1.Anim1.P4.Transparency = 0
script.Parent.JillAnimSet1.Anim1.P5.Transparency = 0
script.Parent.JillAnimSet1.Anim1.P6.Transparency = 0
script.Parent.JillAnimSet1.Anim1.P7.Transparency = 0
script.Parent.JillAnimSet1.Anim1.P8.Transparency = 0
script.Parent.JillAnimSet1.Anim1.P9.Transparency = 0
script.Parent.JillAnimSet1.Anim1.P10.Transparency = 0
script.Parent.JillAnimSet1.Anim1.P11.Transparency = 0
script.Parent.JillAnimSet1.Anim1.P12.Transparency = 0
else
wait(.02)
--script.Parent.JillAnimSet1.Anim1.P1.Transparency = 1
script.Parent.JillAnimSet1.Anim1.P2.Transparency = 1
script.Parent.JillAnimSet1.Anim1.P3.Transparency = 1
--script.Parent.JillAnimSet1.Anim1.P4.Transparency = 1
script.Parent.JillAnimSet1.Anim1.P5.Transparency = 1
script.Parent.JillAnimSet1.Anim1.P6.Transparency = 1
--script.Parent.JillAnimSet1.Anim1.P7.Transparency = 1
--script.Parent.JillAnimSet1.Anim1.P8.Transparency = 1
script.Parent.JillAnimSet1.Anim1.P9.Transparency = 1
--script.Parent.JillAnimSet1.Anim1.P10.Transparency = 1
--script.Parent.JillAnimSet1.Anim1.P11.Transparency = 1
script.Parent.JillAnimSet1.Anim1.P12.Transparency = 1
end
if numy &gt; 9 then
script.Parent.JillAnimSet1.Anim1.P1.Transparency = 1
script.Parent.JillAnimSet1.Anim1.P4.Transparency = 1
script.Parent.JillAnimSet1.Anim1.P7.Transparency = 1
script.Parent.JillAnimSet1.Anim1.P8.Transparency = 1
script.Parent.JillAnimSet1.Anim1.P10.Transparency = 1
script.Parent.JillAnimSet1.Anim1.P11.Transparency = 1
end
end
