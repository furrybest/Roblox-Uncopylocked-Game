					<Item class="Script" referent="RBX3316">
						<Properties>
							<bool name="Archivable">true</bool>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script</string>
							<ProtectedString name="Source">--bottomarm1, toparm1, topnail1, bottomnail1
local attacking = false
function onTouched(hit)
if hit ~= nil then
if hit.Parent:findFirstChild(&quot;Humanoid&quot;) ~= nil then
if hit.Parent.Humanoid.Health &gt; 0 then
if attacking == false then
attacking = true
hit.Parent.Torso.Anchored = true
hit.Parent.Humanoid.WalkSpeed = 0
script.Parent.Parent.Zombie.WalkSpeed = 0

wait(.5)
if hit.Parent.Humanoid.Health &lt;= 0 or script.Parent.Parent.Zombie.Health &lt;= 0 then
hit.Parent.Torso.Anchored = false
if hit.Parent.Torso.roblox.Texture == &quot;http://www.roblox.com/asset/?id=49482336&quot; then
hit.Parent.Humanoid.WalkSpeed = 20
else
hit.Parent.Humanoid.WalkSpeed = 16
end
script.Parent.Parent.Zombie.WalkSpeed = 16
script.Parent.Parent.Reaper.bottomarm3.Transparency = 0
script.Parent.Parent.Reaper.bottomarm4.Transparency = 0
script.Parent.Parent.Reaper.bottomnail2.Transparency = 0
script.Parent.Parent.Reaper.abottomarm3.Transparency = 1
script.Parent.Parent.Reaper.abottomarm4.Transparency = 1
script.Parent.Parent.Reaper.anail4.Transparency = 1
attacking = true
return
end
script.Parent.Parent.Reaper.bottomarm1.Transparency = 1
script.Parent.Parent.Reaper.bottomarm2.Transparency = 1
script.Parent.Parent.Reaper.bottomnail1.Transparency = 1
script.Parent.Parent.Reaper.abottomarm1.Transparency = 0
script.Parent.Parent.Reaper.abottomarm2.Transparency = 0
script.Parent.Parent.Reaper.anail2.Transparency = 0
if hit ~= nil then
if hit.Parent.Humanoid.Health ~= 0 then
hit.Parent.Humanoid.Health = hit.Parent.Humanoid.Health - 15
