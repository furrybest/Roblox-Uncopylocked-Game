				<Item class="Script" referent="RBX1603">
					<Properties>
						<bool name="Archivable">true</bool>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">_Cutscene Procedure_</string>
						<ProtectedString name="Source">chil = game.Players:GetChildren()

script.Start.Changed:connect(function()
script.Parent.DOTR:play()
for num = 1, #chil do
&#9;if chil[num]:findFirstChild(&quot;inGame&quot;) ~= nil then
&#9;&#9;if chil[num].inGame.Value == true then
&#9;&#9;chil[num].PlayerGui.inGame.Intro.Start.Disabled = false
end end end

wait(2)

for num = 1, #chil do
&#9;if chil[num]:findFirstChild(&quot;inGame&quot;) ~= nil then
&#9;&#9;if chil[num].inGame.Value == true then
&#9;&#9;&#9;script.CamFocus:clone().Parent = chil[num].Backpack
end end end

wait(9)

local hin = Instance.new(&quot;Hint&quot;)

script.Parent.Humvee.Floor.BodyVelocity.velocity = Vector3.new(5,0,0)
script.Parent.CameraBrick.Script.Disabled = false
wait(9)
print(&quot;HINT TIME&quot;)
hin.Parent = script.Parent
hin.Text = &quot;HQ: Chris, this is HQ.&quot;
wait(4)
hin.Text = &quot;HQ: We are sending you to investigate this area for the production of bioweapons.&quot;
wait(8)
hin.Text = &quot;HQ: We will tell you your mission when you arrive at the destination.&quot;
wait(8)
print(&quot;HINT TIME OVER!&quot;)
hin.Text = &quot;HQ: Watch your back.&quot;
--FINISH SCRIPT HERE (MOVE CAMER BRICK ETC.)
end)


</ProtectedString>
