					<Item class="Script" referent="RBX10671">
						<Properties>
							<bool name="Archivable">true</bool>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script</string>
							<ProtectedString name="Source">if script.Parent.Parent.Parent.Parent:findFirstChild(&quot;FixGame&quot;) == nil then
wait(10)
end
pla = game.Players:GetChildren()
script.Parent.TextLabel.Text = game.Workspace.ResetGame.Plays.Value..&quot; / &quot;..(#pla/2)
if script.Parent.Parent.Parent.Parent.FixGame.Value == false then
script.Parent.BackgroundColor3 = script.Parent.Green.Value
else
script.Parent.BackgroundColor3 = script.Parent.Red.Value
end
function click()
if script.Parent.Parent.Parent.Parent.FixGame.Value == false then
script.Parent.Parent.Parent.Parent.FixGame.Value = true
script.Parent.BackgroundColor3 = script.Parent.Red.Value
game.Workspace.ResetGame.Plays.Value = game.Workspace.ResetGame.Plays.Value + 1
end
end

script.Parent.MouseButton1Click:connect(click)
</ProtectedString>
