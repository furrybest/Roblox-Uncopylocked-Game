&#9;w4.Part0 = w4.Parent
&#9;w4.Part1 = script.Parent.Head
&#9;w4.C1 = CFrame.fromEulerAnglesXYZ(0, 0, 0) * CFrame.new(0, -1.5, 0)
&#9;w4.Name = &quot;SecondaryWeld&quot;

&#9;local w5 = Instance.new(&quot;Weld&quot;)
&#9;w5.Parent = script.Parent.Torso
&#9;w5.Part0 = w5.Parent
&#9;w5.Part1 = script.Parent.arm2
&#9;w5.C1 = CFrame.fromEulerAnglesXYZ(-1.5, -1.2, .3) * CFrame.new(1.5, -.5, .5)
&#9;w5.Name = &quot;SecondaryWeld&quot;


wait(.5)
script.Parent.Zombie.WalkSpeed = 16
script.Parent.Torso2.Anchored = false
script.Parent.arm1.Anchored = false
script.Parent.arm2.Anchored = false
script.Parent.tent.Anchored = false
