							<Item class="Script" referent="RBX2918">
								<Properties>
									<bool name="Archivable">true</bool>
									<bool name="Disabled">false</bool>
									<Content name="LinkedSource"><null></null></Content>
									<string name="Name">Script</string>
									<ProtectedString name="Source">function onTouched(hit)
if script.Parent.Transparency == 0 then
if hit ~= nil then
if hit.Name == &quot;Paintball&quot; then
if hit:findFirstChild(&quot;Paintball&quot;) ~= nil then
if hit.Paintball.Damage.Value &lt; 10 then
script.Parent.Parent.Health.Value = script.Parent.Parent.Health.Value - 10
else
script.Parent.Parent.Health.Value = script.Parent.Parent.Health.Value - hit.Paintball.Damage.Value
end
elseif hit:findFirstChild(&quot;RocketScript&quot;) ~= nil then
script.Parent.Parent.Health.Value = script.Parent.Parent.Health.Value - 50
else
script.Parent.Parent.Health.Value = script.Parent.Parent.Health.Value - 10
end end end end end

script.Parent.Touched:connect(onTouched)</ProtectedString>
								</Properties>
							</Item>
						</Item>
						<Item class="IntValue" referent="RBX2919">
							<Properties>
								<bool name="Archivable">true</bool>
								<string name="Name">Health</string>
								<int name="Value">1500</int>
							</Properties>
							<Item class="Script" referent="RBX2920">
								<Properties>
									<bool name="Archivable">true</bool>
									<bool name="Disabled">false</bool>
									<Content name="LinkedSource"><null></null></Content>
									<string name="Name">ChangeGui</string>
									<ProtectedString name="Source">script.Parent.Changed:connect(function()
if script.Parent.Value &lt; 1 then
game.Workspace:findFirstChild(&quot;_Game Script_&quot;).Section.Value = 18.5
else
local pla = game.Players:GetChildren()
for num = 1, #pla do
if pla[num]:findFirstChild(&quot;inGame&quot;) ~= nil then
if pla[num].inGame.Value == true then
pla[num].PlayerGui.inGame.FishHealth.Visible = true
pla[num].PlayerGui.inGame.FishHealth.TextLabel.Text = &quot;Wesker Health&quot;
pla[num].PlayerGui.inGame.FishHealth.Health.Size = UDim2.new(0,(script.Parent.Value)/(script.Parent.Multi.Value*1.5),0,50)
end end end

end
end)
</ProtectedString>
								</Properties>
							</Item>
							<Item class="Script" referent="RBX2921">
								<Properties>
									<bool name="Archivable">true</bool>
									<bool name="Disabled">false</bool>
									<Content name="LinkedSource"><null></null></Content>
									<string name="Name">FindHealth</string>
									<ProtectedString name="Source">wait(.1)
pla = game.Players:GetChildren()
script.Parent.Value = 1500*#pla
script.Parent.Multi.Value = #pla</ProtectedString>
								</Properties>
