						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Weapon Stats Creator</string>
						<ProtectedString name="Source">org = script.Parent:findFirstChild(&quot;Background(Organize)&quot;)
play = script.Parent.Parent.Parent

function loadGun(playweapon, weaponName)
GUN = playweapon
if GUN.Value == true then
local con = true
local Items = org.Items:children()
for x = 1, #Items do
if (Items[x].Text == &quot;N/A&quot;) and (con == true) then
Items[x].Text = weaponName
con = false
end
end
end
end

local weaponName = &quot;M92F&quot;
if play:findFirstChild(weaponName) == nil then
local GUN = Instance.new(&quot;BoolValue&quot;)
GUN.Name = weaponName
GUN.Value = true
GUN.Parent = play
--[[
local Ammo = Instance.new(&quot;IntValue&quot;)
Ammo.Value = game.Lighting:findFirstChild(weaponName).AmmoScript.ClipCap.Value
Ammo.Name = &quot;Ammo&quot;
Ammo.Parent = GUN

local MAmmo = Instance.new(&quot;IntValue&quot;)
MAmmo.Value = game.Lighting:findFirstChild(weaponName).AmmoScript.MAmmo.Value
MAmmo.Name = &quot;MAmmo&quot;
MAmmo.Parent = GUN

local Damage = Instance.new(&quot;IntValue&quot;)
Damage.Value = game.Lighting:findFirstChild(weaponName).Paintball.Damage.Value
Damage.Name = &quot;Damage&quot;
Damage.Parent = GUN

local MDamage = Instance.new(&quot;IntValue&quot;)
MDamage.Value = game.Lighting:findFirstChild(weaponName).Paintball.MDamage.Value
MDamage.Name = &quot;MDamage&quot;
MDamage.Parent = GUN

local Reload = Instance.new(&quot;NumberValue&quot;)
Reload.Value = game.Lighting:findFirstChild(weaponName).PaintballShooter.Reload.Value
Reload.Name = &quot;Reload&quot;
Reload.Parent = GUN

local MReload = Instance.new(&quot;NumberValue&quot;)
MReload.Value = game.Lighting:findFirstChild(weaponName).PaintballShooter.MReload.Value
MReload.Name = &quot;MReload&quot;
MReload.Parent = GUN
]]
end
loadGun(play:findFirstChild(weaponName), weaponName)

