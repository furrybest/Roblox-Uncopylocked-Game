					<string name="Name">_Game Script_</string>
					<ProtectedString name="Source">function LoadZombie(x,y,z)
local num = false
while num ~= true do
zom = game.Lighting.Jill:clone()
zom.RegenScript.Xpos.Value = x
zom.RegenScript.Ypos.Value = y
zom.RegenScript.Zpos.Value = z
zom.Parent = game.Workspace
zom.Torso.CFrame = CFrame.new(x,y,z)
wait(1)
if zom.Zombie.Health &gt; 1 then
num = true
zom:findFirstChild(&quot;Zombie Startup&quot;).Disabled = false
else
zom:remove()
end
end
end



script.Section.Changed:connect(function() --If Section value changed, trigger function


if script.Section.Value == 0 then 
print(&quot;Game Reset&quot;)
script.Section.Value = 1



elseif script.Section.Value == 1 then
game.Lighting.Ambient = game.Lighting.Light.Value
game.Lighting.Brightness = 1
Map = game.Lighting:findFirstChild(&quot;Sec1_Cut1&quot;):clone()
Map.Parent = Workspace
Map:MakeJoints()
Map:MoveTo(Vector3.new(0, 400, 0)) -- Place map
wait(3)

players = game.Players:GetChildren()
for num = 1, #players do
if players[num]:findFirstChild(&quot;inGame&quot;) ~= nil then
if players[num].inGame.Value == true then
players[num].PlayerGui.Intro.Intro.Animation.Disabled = false
end
end
end


elseif script.Section.Value == 2 then
game.Lighting.Ambient = game.Lighting.Light.Value
game.Lighting.Brightness = 1
game.Workspace:findFirstChild(&quot;Sec1_Cut1&quot;).DOTR:stop()
wait(.5)
game.Workspace:findFirstChild(&quot;Sec1_Cut1&quot;):remove()
Map = game.Lighting:findFirstChild(&quot;Sec2_Map1&quot;):clone()
Map.Parent = Workspace
Map:MakeJoints()
Map:MoveTo(Vector3.new(0, 400, 0)) -- Place map
wait(.2)
players = game.Players:GetChildren()
for num = 1, #players do
if players[num]:findFirstChild(&quot;inGame&quot;) ~= nil then
if players[num].inGame.Value == true then
