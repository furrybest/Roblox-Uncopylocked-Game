						<ProtectedString name="Source">ball = script.Parent
damage = script.Damage.Value



function onTouched(hit)
&#9;local humanoid = hit.Parent:findFirstChild(&quot;Zombie&quot;)
&#9;


&#9;if humanoid ~= nil then
&#9;&#9;local char = game.Players:playerFromCharacter(humanoid.Parent)
&#9;&#9;if char ~= nil then 
&#9;&#9;tagHumanoid(humanoid)
&#9;&#9;if humanoid.Health &lt;= damage and script.GoldGiver.Value == true and humanoid.Health &gt; 0 then
&#9;&#9;script.GoldGiver.Value = false
&#9;&#9;game.Players:findFirstChild(script.Parent.PlayersName.Value).leaderstats.Gold.Value = game.Players:findFirstChild(script.Parent.PlayersName.Value).leaderstats.Gold.Value + 1
&#9;&#9;game.Players:findFirstChild(script.Parent.PlayersName.Value).Kills.Value = game.Players:findFirstChild(script.Parent.PlayersName.Value).Kills.Value + 1
&#9;&#9;if hit.Parent.Name == &quot;Licker&quot; then
&#9;&#9;game.Players:findFirstChild(script.Parent.PlayersName.Value).LickerKill.Value = true
&#9;&#9;elseif hit.Parent.Name == &quot;Reaper&quot; then
&#9;&#9;game.Players:findFirstChild(script.Parent.PlayersName.Value).ReaperKill.Value = true
&#9;&#9;end
&#9;&#9;end
&#9;&#9;humanoid:TakeDamage(damage)
&#9;&#9;wait(2)
&#9;&#9;untagHumanoid(humanoid)
&#9;&#9;else
&#9;&#9;tagHumanoid(humanoid)
&#9;&#9;if humanoid.Health &lt;= damage and script.GoldGiver.Value == true and humanoid.Health &gt; 0 then
&#9;&#9;script.GoldGiver.Value = false
&#9;&#9;game.Players:findFirstChild(script.Parent.PlayersName.Value).leaderstats.Gold.Value = game.Players:findFirstChild(script.Parent.PlayersName.Value).leaderstats.Gold.Value + 1
&#9;&#9;game.Players:findFirstChild(script.Parent.PlayersName.Value).Kills.Value = game.Players:findFirstChild(script.Parent.PlayersName.Value).Kills.Value + 1
&#9;&#9;if hit.Parent.Name == &quot;Licker&quot; then
&#9;&#9;game.Players:findFirstChild(script.Parent.PlayersName.Value).LickerKill.Value = true
&#9;&#9;elseif hit.Parent.Name == &quot;Reaper&quot; then
&#9;&#9;game.Players:findFirstChild(script.Parent.PlayersName.Value).ReaperKill.Value = true
&#9;&#9;end
&#9;&#9;end
&#9;&#9;humanoid:TakeDamage(damage)
&#9;&#9;wait(2)
&#9;&#9;untagHumanoid(humanoid)
&#9;&#9;end
&#9;end

&#9;connection:disconnect()

&#9;wait(1)
&#9;if hit.CanCollide == true then
&#9;ball.Parent = nil
&#9;end
end

function tagHumanoid(humanoid)
&#9;-- todo: make tag expire
&#9;local tag = ball:findFirstChild(&quot;creator&quot;)
&#9;if tag ~= nil then
&#9;&#9;local new_tag = tag:clone()
&#9;&#9;new_tag.Parent = humanoid
&#9;end
end


function untagHumanoid(humanoid)
&#9;if humanoid ~= nil then
&#9;&#9;local tag = humanoid:findFirstChild(&quot;creator&quot;)
&#9;&#9;if tag ~= nil then
&#9;&#9;&#9;tag.Parent = nil
&#9;&#9;end
&#9;end
end

