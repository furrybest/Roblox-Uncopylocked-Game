				<Item class="Script" referent="RBX6070">
					<Properties>
						<bool name="Archivable">true</bool>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">_Cutscene Procedure_</string>
						<ProtectedString name="Source">chil = game.Players:GetChildren()

script.Start.Changed:connect(function()
wait(4)
play = game.Players:GetChildren()
for NUMOFCAM = 1, #play do
&#9;if play[NUMOFCAM]:findFirstChild(&quot;inGame&quot;) ~= nil then
&#9;&#9;if play[NUMOFCAM].inGame.Value == true then
&#9;&#9;&#9;script.Cam1:clone().Parent = play[NUMOFCAM].Backpack
end end end

wait(3)

set = script.Parent.Jill1:GetChildren()
for num = 1, #set do
set[num].Transparency = 1
end
script.Parent.Jill1:remove()
set = script.Parent.Jill2:GetChildren()
for num = 1, #set do
set[num].Transparency = 0
end
wait(.08)
set = script.Parent.Jill2:GetChildren()
for num = 1, #set do
set[num].Transparency = 1
end
script.Parent.Jill2:remove()
set = script.Parent.Jill3:GetChildren()
for num = 1, #set do
set[num].Transparency = 0
end
wait(.08)
set = script.Parent.Jill3:GetChildren()
for num = 1, #set do
set[num].Transparency = 1
end
script.Parent.Jill3:remove()
set = script.Parent.Jill4:GetChildren()
for num = 1, #set do
if set[num].Name ~= &quot;Arm2&quot; then
set[num].Transparency = 0
end
end
wait(.08)
local hin = Instance.new(&quot;Hint&quot;)
hin.Parent = script.Parent
hin.Text = &quot;Jill: Chris...&quot;
wait(4)
hin.Text = &quot;Chris(you): Jill, are you back to normal?&quot;
wait(6)
hin.Text = &quot;Jill: ...&quot;
wait(4)
hin.Text = &quot;Jill: ...I think so.&quot;
wait(6)
hin.Text = &quot;Jill: You have to stop Wesker!&quot;
wait(4)
hin.Text = &quot;Jill: Hes going to take over the entire world with Uroboros!&quot;
wait(5)
hin.Text = &quot;Chris(you): Uroboros?&quot;
wait(4)
hin.Text = &quot;Jill: It&apos;s what is making all of these people go crazy and attack you.&quot;
wait(7)
hin.Text = &quot;Jill: It&apos;s a parasite that infects people, creatures, and any other living thing.&quot;
wait(7)
hin.Text = &quot;Jill: Wesker is planning to spread this throughout the entire world using a jet.&quot;
wait(7)
hin.Text = &quot;Jill: He will fly the jet into the sky, where it will be shot down and...&quot;
wait(7)
hin.Text = &quot;Jill: ...the Uroboros inside will be released into the atmosphere... &quot;
wait(7)
hin.Text = &quot;Jill: ...infecting everyone on the planet.&quot;
wait(5)
set = script.Parent.Jill4:GetChildren()
for num = 1, #set do
set[num].Transparency = 1
end
for num = 1, #set do
if set[num].Name ~= &quot;Arm1&quot; then
set[num].Transparency = 0
end
end
hin.Text = &quot;Jill: Wesker went that way, stop him at all costs.&quot;
wait(5)
hin.Text = &quot;Chris(you): Ok. Are you going to be all right?&quot;
wait(5)
hin.Text = &quot;Jill: Ya, just stop wesker. Go now!&quot;
wait(5)
hin.Text = &quot;Chris(you): I understand...i&apos;ll come back once the job is finished.&quot;
wait(6)
hin.Text = &quot;*Jill passes out*&quot;
wait(5)
hin.Text = &quot;Chris(you): It&apos;s time to end this!&quot;
wait(5)
game.Workspace:findFirstChild(&quot;_Game Script_&quot;).Section.Value = 16.6
end)


</ProtectedString>
