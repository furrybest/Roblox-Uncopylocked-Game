							<ProtectedString name="Source">Camera = game.Workspace.CurrentCamera
local s = Instance.new(&quot;Sound&quot;)
s.Name = &quot;Sound&quot;
s.Pitch = 1
s.SoundId = &quot;rbxasset://sounds\\clickfast.wav&quot;
s.Volume = 1
s.Looped = false
s.archivable = false
s.Parent = Camera
wait(1)

TTitle = script.Parent.Title
DTitle = script.Parent.Date
LTitle = script.Parent.Location

function AnimTitle()
TTitle.Text = &quot;R&quot;
s:play()
wait(.3)
TTitle.Text = &quot;Ro&quot;
s:play()
wait(.3)
TTitle.Text = &quot;Rob&quot;
s:play()
wait(.3)
TTitle.Text = &quot;Robl&quot;
s:play()
wait(.3)
TTitle.Text = &quot;Roblo&quot;
s:play()
wait(.3)
TTitle.Text = &quot;Roblox&quot;
s:play()
wait(.3)
TTitle.Text = &quot;Roblox &quot;
--s:play()
wait(.3)
TTitle.Text = &quot;Roblox E&quot;
s:play()
wait(.3)
TTitle.Text = &quot;Roblox Ev&quot;
s:play()
wait(.3)
TTitle.Text = &quot;Roblox Evi&quot;
s:play()
wait(.3)
TTitle.Text = &quot;Roblox Evil&quot;
s:play()
wait(.3)
TTitle.Text = &quot;Roblox Evil &quot;
--s:play()
wait(.3)
TTitle.Text = &quot;Roblox Evil 5&quot;
s:play()
wait(.5)
end

function AnimDate()
DTitle.Text = &quot;1&quot;
s:play()
wait(.3)
DTitle.Text = &quot;10&quot;
s:play()
wait(.3)
DTitle.Text = &quot;10:&quot;
s:play()
wait(.3)
DTitle.Text = &quot;10:3&quot;
s:play()
wait(.3)
DTitle.Text = &quot;10:30&quot;
s:play()
wait(.3)
DTitle.Text = &quot;10:30:&quot;
s:play()
wait(.3)
DTitle.Text = &quot;10:30:0&quot;
s:play()
wait(.3)
DTitle.Text = &quot;10:30:03&quot;
s:play()
wait(.5)
end

function AnimLocation()
LTitle.Text = &quot;K&quot;
s:play()
wait(.3)
LTitle.Text = &quot;Ki&quot;
s:play()
wait(.3)
LTitle.Text = &quot;Kij&quot;
DTitle.Text = &quot;10:30:04&quot;
s:play()
wait(.3)
LTitle.Text = &quot;Kiju&quot;
s:play()
wait(.3)
LTitle.Text = &quot;Kijuj&quot;
s:play()
wait(.3)
LTitle.Text = &quot;Kijuju&quot;
DTitle.Text = &quot;10:30:05&quot;
s:play()
wait(.3)
LTitle.Text = &quot;Kijuju,&quot;
s:play()
wait(.3)
LTitle.Text = &quot;Kijuju, &quot;
--s:play()
wait(.3)
LTitle.Text = &quot;Kijuju, A&quot;
DTitle.Text = &quot;10:30:06&quot;
s:play()
wait(.3)
LTitle.Text = &quot;Kijuju, Af&quot;
s:play()
wait(.3)
LTitle.Text = &quot;Kijuju, Afr&quot;
s:play()
wait(.3)
LTitle.Text = &quot;Kijuju, Afri&quot;
DTitle.Text = &quot;10:30:07&quot;
s:play()
wait(.3)
LTitle.Text = &quot;Kijuju, Afric&quot;
s:play()
wait(.3)
LTitle.Text = &quot;Kijuju, Africa&quot;
s:play()
wait(.3)
DTitle.Text = &quot;10:30:08&quot;
end



fadeIn = 1
while fadeIn &gt; 0 do
fadeIn = fadeIn - .01
script.Parent.BackgroundTransparency = fadeIn
wait()
end

AnimTitle()
AnimDate()
AnimLocation()

fadeOut = 0
while fadeOut &lt; 1 do
fadeOut = fadeOut + .01
DTitle.TextTransparency = fadeOut
LTitle.TextTransparency = fadeOut
TTitle.TextTransparency = fadeOut
wait()
end

wait(2)
--[[
fadeOut = 0
while fadeOut &lt; 1 do
fadeOut = fadeOut + .01
script.Parent.BackgroundTransparency = fadeOut
wait()
end
]]
s:remove()
game.Workspace.Sec1_Cut1:findFirstChild(&quot;_Cutscene Procedure_&quot;).Start.Value = true
script.Parent.Visible = false
