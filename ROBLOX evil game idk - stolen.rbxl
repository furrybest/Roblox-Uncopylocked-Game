script.Parent.Parent.Light.Value = script.Parent.Parent.Light.Value - 1
end
script.Parent.Parent.Text = &quot; BRIGHTNESS: &quot;..script.Parent.Parent.Light.Value
if script.Parent.Parent.Light.Value &lt; 0 then
script.Parent.Parent.Parent.Parent.Parent.Ambient.Lighting.BackgroundColor3 = script.Parent.Parent.black.Value
script.Parent.Parent.Parent.Parent.Parent.Ambient.Lighting.BackgroundTransparency = (1 - (script.Parent.Parent.Light.Value * -1 / 10))
end
if script.Parent.Parent.Light.Value &gt; 0 then
script.Parent.Parent.Parent.Parent.Parent.Ambient.Lighting.BackgroundColor3 = script.Parent.Parent.white.Value
script.Parent.Parent.Parent.Parent.Parent.Ambient.Lighting.BackgroundTransparency = (1 - (script.Parent.Parent.Light.Value / 10))
end
if script.Parent.Parent.Light.Value == 0 then
script.Parent.Parent.Parent.Parent.Parent.Ambient.Lighting.BackgroundTransparency = 1
end
script.Parent.Parent.Parent.Parent.Parent.Parent.Parent.Lighting.Value = script.Parent.Parent.Light.Value
end

