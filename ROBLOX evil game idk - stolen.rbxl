Tool.Enabled = true

function GunChooser(WeaponNumber, timer, three, machine, shotgun, dam, clipcap, rocketEnabled) --Decide what current weapon is and associate the right function with it.
if not Tool.Enabled then
return
end
Tool.Enabled = false
local character = Tool.Parent;
local humanoid = character.Humanoid
if humanoid == nil then
print(&quot;Humanoid not found&quot;)
return 
end
print(WeaponNumber)
local targetPos = humanoid.TargetPoint
local lookAt = (targetPos - character.Head.Position).unit
if three == true then
fire_weapon(lookAt, WeaponNumber, dam, clipcap, shotgun, rocketEnabled)
wait(.1)
fire_weapon(lookAt, WeaponNumber, dam, clipcap, shotgun, rocketEnabled)
wait(.1)
end
fire_weapon(lookAt, WeaponNumber, dam, clipcap, shotgun, rocketEnabled)
wait(timer)
if machine == true then
GunChooser(WeaponNumber, timer, three, machine, shotgun, dam, clipcap)
else
Tool.Enabled = true
end end


