for numy = 1, #ba do
but.Parent:findFirstChild(&quot;sqr&quot;..numy).BackgroundColor3 = red
end




local it = but.Parent.Parent.Backpack:GetChildren()
for num = 1, #it do
if but.Parent.Parent.Backpack:findFirstChild(&quot;sqr&quot;..num).Text == &quot;N/A&quot; then
but.Parent.Parent.Backpack:findFirstChild(&quot;sqr&quot;..num).BackgroundColor3 = green
else
but.Parent.Parent.Backpack:findFirstChild(&quot;sqr&quot;..num).BackgroundColor3 = red
end
end



