							<string name="Name">Script</string>
							<ProtectedString name="Source">function click()
if script.Parent.Num.Value &gt; 0 then
script.Parent.Squish:play()
script.Parent.Num.Value = script.Parent.Num.Value - 1
else
script.Parent.Parent.Face.Visible = false
script.Parent.Parent.Red.Visible = false
script.Parent.Visible = false
script.Parent.Parent.TextLabel.Visible = false
script.Parent.Parent.Parent.Parent.Character.Humanoid.WalkSpeed = 16
end end

script.Parent.MouseButton1Click:connect(click)
</ProtectedString>
