obj200.Parent=obj1
elseif button.Name==&quot;Mode02&quot; then
obj200=Instance.new(&quot;Frame&quot;) obj200.BackgroundColor3=Color3.new(255/255,165/255,0/255) obj200.BorderColor3=Color3.new(27/255,42/255,53/255) obj200.Name=&quot;HelpDialog&quot; obj200.Position=UDim2.new(0.5,-100,0.5,-59) obj200.Size=UDim2.new(0,200,0,118)
