							<string name="Name">Script</string>
							<ProtectedString name="Source">MenuName = &quot;GameMenu&quot;
GuiList2 = {&quot;Back&quot;, &quot;Bonus&quot;, &quot;Chapter&quot;, &quot;Item&quot;, &quot;Join&quot;, &quot;Start&quot;}
stopfun = false
backypacky = script.Parent.Parent:findFirstChild(&quot;Background(Organize)&quot;).Backpack
function die()
--NORMAL STUFF DOWN HERE
if script.Parent.ToGame.Value == true then
if backypacky.sqr1.Text == &quot;N/A&quot; and backypacky.sqr2.Text == &quot;N/A&quot; and backypacky.sqr3.Text == &quot;N/A&quot; and backypacky.sqr4.Text == &quot;N/A&quot; and backypacky.sqr5.Text == &quot;N/A&quot; and backypacky.sqr6.Text == &quot;N/A&quot; and backypacky.sqr7.Text == &quot;N/A&quot; and backypacky.sqr8.Text == &quot;N/A&quot; and backypacky.sqr9.Text == &quot;N/A&quot; then 
--IF THERE ARE NO WEAPONS IN PLAYERS BACKPACK...
script.Parent.Error.Visible = true
else
local GUN = game.Lighting:findFirstChild(&quot;Game Tool&quot;):clone()
GUN.playerName.Value = script.Parent.Parent.Parent.Parent.Name
for x = 1, 9 do
if script.Parent.Parent:findFirstChild(&quot;Background(Organize)&quot;).Backpack:findFirstChild(&quot;sqr&quot;..x).Text ~= &quot;N/A&quot; then

if script.Parent.Parent:findFirstChild(&quot;Background(Organize)&quot;).Backpack:findFirstChild(&quot;sqr&quot;..x).Text == &quot;M92F&quot; then
GUN.WeaponList:findFirstChild(&quot;W&quot;..x).Ammo.Value = 100
GUN.WeaponList:findFirstChild(&quot;W&quot;..x).Clip.Value = 10
elseif script.Parent.Parent:findFirstChild(&quot;Background(Organize)&quot;).Backpack:findFirstChild(&quot;sqr&quot;..x).Text == &quot;H&amp;K P8&quot; then
GUN.WeaponList:findFirstChild(&quot;W&quot;..x).Ammo.Value = 99
GUN.WeaponList:findFirstChild(&quot;W&quot;..x).Clip.Value = 9
elseif script.Parent.Parent:findFirstChild(&quot;Background(Organize)&quot;).Backpack:findFirstChild(&quot;sqr&quot;..x).Text == &quot;SIG P226&quot; then
GUN.WeaponList:findFirstChild(&quot;W&quot;..x).Ammo.Value = 96
GUN.WeaponList:findFirstChild(&quot;W&quot;..x).Clip.Value = 8
elseif script.Parent.Parent:findFirstChild(&quot;Background(Organize)&quot;).Backpack:findFirstChild(&quot;sqr&quot;..x).Text == &quot;M93R&quot; then
GUN.WeaponList:findFirstChild(&quot;W&quot;..x).Ammo.Value = 90
GUN.WeaponList:findFirstChild(&quot;W&quot;..x).Clip.Value = 15
elseif script.Parent.Parent:findFirstChild(&quot;Background(Organize)&quot;).Backpack:findFirstChild(&quot;sqr&quot;..x).Text == &quot;Ithaca M37&quot; then
GUN.WeaponList:findFirstChild(&quot;W&quot;..x).Ammo.Value = 42
GUN.WeaponList:findFirstChild(&quot;W&quot;..x).Clip.Value = 6
elseif script.Parent.Parent:findFirstChild(&quot;Background(Organize)&quot;).Backpack:findFirstChild(&quot;sqr&quot;..x).Text == &quot;M3&quot; then
GUN.WeaponList:findFirstChild(&quot;W&quot;..x).Ammo.Value = 42
GUN.WeaponList:findFirstChild(&quot;W&quot;..x).Clip.Value = 6
elseif script.Parent.Parent:findFirstChild(&quot;Background(Organize)&quot;).Backpack:findFirstChild(&quot;sqr&quot;..x).Text == &quot;Jail Breaker&quot; then
GUN.WeaponList:findFirstChild(&quot;W&quot;..x).Ammo.Value = 64
GUN.WeaponList:findFirstChild(&quot;W&quot;..x).Clip.Value = 8
elseif script.Parent.Parent:findFirstChild(&quot;Background(Organize)&quot;).Backpack:findFirstChild(&quot;sqr&quot;..x).Text == &quot;Hydra&quot; then
GUN.WeaponList:findFirstChild(&quot;W&quot;..x).Ammo.Value = 24
GUN.WeaponList:findFirstChild(&quot;W&quot;..x).Clip.Value = 3
elseif script.Parent.Parent:findFirstChild(&quot;Background(Organize)&quot;).Backpack:findFirstChild(&quot;sqr&quot;..x).Text == &quot;VZ61&quot; then
GUN.WeaponList:findFirstChild(&quot;W&quot;..x).Ammo.Value = 200
GUN.WeaponList:findFirstChild(&quot;W&quot;..x).Clip.Value = 25
elseif script.Parent.Parent:findFirstChild(&quot;Background(Organize)&quot;).Backpack:findFirstChild(&quot;sqr&quot;..x).Text == &quot;H&amp;K MP5&quot; then
GUN.WeaponList:findFirstChild(&quot;W&quot;..x).Ammo.Value = 175
GUN.WeaponList:findFirstChild(&quot;W&quot;..x).Clip.Value = 25
elseif script.Parent.Parent:findFirstChild(&quot;Background(Organize)&quot;).Backpack:findFirstChild(&quot;sqr&quot;..x).Text == &quot;AK-74&quot; then
GUN.WeaponList:findFirstChild(&quot;W&quot;..x).Ammo.Value = 150
GUN.WeaponList:findFirstChild(&quot;W&quot;..x).Clip.Value = 25
elseif script.Parent.Parent:findFirstChild(&quot;Background(Organize)&quot;).Backpack:findFirstChild(&quot;sqr&quot;..x).Text == &quot;SIG 556&quot; then
GUN.WeaponList:findFirstChild(&quot;W&quot;..x).Ammo.Value = 150
GUN.WeaponList:findFirstChild(&quot;W&quot;..x).Clip.Value = 25
elseif script.Parent.Parent:findFirstChild(&quot;Background(Organize)&quot;).Backpack:findFirstChild(&quot;sqr&quot;..x).Text == &quot;S75&quot; then
GUN.WeaponList:findFirstChild(&quot;W&quot;..x).Ammo.Value = 36
GUN.WeaponList:findFirstChild(&quot;W&quot;..x).Clip.Value = 6
elseif script.Parent.Parent:findFirstChild(&quot;Background(Organize)&quot;).Backpack:findFirstChild(&quot;sqr&quot;..x).Text == &quot;Dragunov SVD&quot; then
GUN.WeaponList:findFirstChild(&quot;W&quot;..x).Ammo.Value = 36
GUN.WeaponList:findFirstChild(&quot;W&quot;..x).Clip.Value = 6
elseif script.Parent.Parent:findFirstChild(&quot;Background(Organize)&quot;).Backpack:findFirstChild(&quot;sqr&quot;..x).Text == &quot;H&amp;K PSG-1&quot; then
GUN.WeaponList:findFirstChild(&quot;W&quot;..x).Ammo.Value = 64
GUN.WeaponList:findFirstChild(&quot;W&quot;..x).Clip.Value = 8
elseif script.Parent.Parent:findFirstChild(&quot;Background(Organize)&quot;).Backpack:findFirstChild(&quot;sqr&quot;..x).Text == &quot;S&amp;W M29&quot; then
GUN.WeaponList:findFirstChild(&quot;W&quot;..x).Ammo.Value = 30
GUN.WeaponList:findFirstChild(&quot;W&quot;..x).Clip.Value = 6
elseif script.Parent.Parent:findFirstChild(&quot;Background(Organize)&quot;).Backpack:findFirstChild(&quot;sqr&quot;..x).Text == &quot;L Hawk&quot; then
GUN.WeaponList:findFirstChild(&quot;W&quot;..x).Ammo.Value = 40
GUN.WeaponList:findFirstChild(&quot;W&quot;..x).Clip.Value = 8
elseif script.Parent.Parent:findFirstChild(&quot;Background(Organize)&quot;).Backpack:findFirstChild(&quot;sqr&quot;..x).Text == &quot;S&amp;W M500&quot; then
GUN.WeaponList:findFirstChild(&quot;W&quot;..x).Ammo.Value = 42
GUN.WeaponList:findFirstChild(&quot;W&quot;..x).Clip.Value = 6
elseif script.Parent.Parent:findFirstChild(&quot;Background(Organize)&quot;).Backpack:findFirstChild(&quot;sqr&quot;..x).Text == &quot;Rocket Launcher&quot; then
GUN.WeaponList:findFirstChild(&quot;W&quot;..x).Ammo.Value = 15
GUN.WeaponList:findFirstChild(&quot;W&quot;..x).Clip.Value = 1
elseif script.Parent.Parent:findFirstChild(&quot;Background(Organize)&quot;).Backpack:findFirstChild(&quot;sqr&quot;..x).Text == &quot;Gatling Gun&quot; then
GUN.WeaponList:findFirstChild(&quot;W&quot;..x).Ammo.Value = 0
GUN.WeaponList:findFirstChild(&quot;W&quot;..x).Clip.Value = 0
elseif script.Parent.Parent:findFirstChild(&quot;Background(Organize)&quot;).Backpack:findFirstChild(&quot;sqr&quot;..x).Text == &quot;Longbow&quot; then
GUN.WeaponList:findFirstChild(&quot;W&quot;..x).Ammo.Value = 0
GUN.WeaponList:findFirstChild(&quot;W&quot;..x).Clip.Value = 0
end
GUN.WeaponList:findFirstChild(&quot;W&quot;..x).Value = script.Parent.Parent:findFirstChild(&quot;Background(Organize)&quot;).Backpack:findFirstChild(&quot;sqr&quot;..x).Text

end
end
GUN.Parent = script.Parent.Parent.Parent.Parent
--Kill player
script.Parent.Parent.Parent.Parent.Character.Humanoid.Health = 0
script.Parent.Parent.Parent.Parent.inGame.Value = true
wait(.1)
script.Parent.Parent:remove()
end
else
--Back to Menu
if stopfun == false then
stopfun = true

script.Parent.Parent:findFirstChild(&quot;Background&quot;).Visible = false
script.Parent.Parent:findFirstChild(&quot;Background(Organize)&quot;).Visible = false
script.Parent.Parent:findFirstChild(&quot;Background(Right)&quot;).Visible = false
script.Parent.Parent:findFirstChild(&quot;Background(Shop)&quot;).Visible = false
script.Parent.Parent:findFirstChild(&quot;Background2&quot;).Visible = false
script.Parent.Parent:findFirstChild(&quot;Organize&quot;).Visible = false
script.Parent.Parent:findFirstChild(&quot;Ready&quot;).Visible = false
script.Parent.Parent:findFirstChild(&quot;Shop&quot;).Visible = false

script.Parent.Parent:findFirstChild(MenuName).Visible = true
local xpos = -300
while xpos &lt; 0 do
xpos = xpos + 10
script.Parent.Parent:findFirstChild(MenuName):findFirstChild(GuiList2[1]).Position = UDim2.new(script.Parent.Parent:findFirstChild(MenuName):findFirstChild(GuiList2[1]).Position.X.Scale, script.Parent.Parent:findFirstChild(MenuName):findFirstChild(GuiList2[1]).Position.X.Offset, script.Parent.Parent:findFirstChild(MenuName):findFirstChild(GuiList2[1]).Position.Y.Scale, xpos)
script.Parent.Parent:findFirstChild(MenuName):findFirstChild(GuiList2[2]).Position = UDim2.new(script.Parent.Parent:findFirstChild(MenuName):findFirstChild(GuiList2[2]).Position.X.Scale, script.Parent.Parent:findFirstChild(MenuName):findFirstChild(GuiList2[1]).Position.X.Offset, script.Parent.Parent:findFirstChild(MenuName):findFirstChild(GuiList2[2]).Position.Y.Scale, xpos)
script.Parent.Parent:findFirstChild(MenuName):findFirstChild(GuiList2[3]).Position = UDim2.new(script.Parent.Parent:findFirstChild(MenuName):findFirstChild(GuiList2[3]).Position.X.Scale, script.Parent.Parent:findFirstChild(MenuName):findFirstChild(GuiList2[1]).Position.X.Offset, script.Parent.Parent:findFirstChild(MenuName):findFirstChild(GuiList2[3]).Position.Y.Scale, xpos)
script.Parent.Parent:findFirstChild(MenuName):findFirstChild(GuiList2[4]).Position = UDim2.new(script.Parent.Parent:findFirstChild(MenuName):findFirstChild(GuiList2[4]).Position.X.Scale, script.Parent.Parent:findFirstChild(MenuName):findFirstChild(GuiList2[1]).Position.X.Offset, script.Parent.Parent:findFirstChild(MenuName):findFirstChild(GuiList2[4]).Position.Y.Scale, xpos)
script.Parent.Parent:findFirstChild(MenuName):findFirstChild(GuiList2[5]).Position = UDim2.new(script.Parent.Parent:findFirstChild(MenuName):findFirstChild(GuiList2[5]).Position.X.Scale, script.Parent.Parent:findFirstChild(MenuName):findFirstChild(GuiList2[1]).Position.X.Offset, script.Parent.Parent:findFirstChild(MenuName):findFirstChild(GuiList2[5]).Position.Y.Scale, xpos)
script.Parent.Parent:findFirstChild(MenuName):findFirstChild(GuiList2[6]).Position = UDim2.new(script.Parent.Parent:findFirstChild(MenuName):findFirstChild(GuiList2[6]).Position.X.Scale, script.Parent.Parent:findFirstChild(MenuName):findFirstChild(GuiList2[1]).Position.X.Offset, script.Parent.Parent:findFirstChild(MenuName):findFirstChild(GuiList2[6]).Position.Y.Scale, xpos)
wait()
end
script.Parent.Parent:findFirstChild(MenuName):findFirstChild(GuiList2[1]).Script.Disabled = false
script.Parent.Parent:findFirstChild(MenuName):findFirstChild(GuiList2[2]).Script.Disabled = false
script.Parent.Parent:findFirstChild(MenuName):findFirstChild(GuiList2[3]).Script.Disabled = false
script.Parent.Parent:findFirstChild(MenuName):findFirstChild(GuiList2[4]).Script.Disabled = false
script.Parent.Parent:findFirstChild(MenuName):findFirstChild(GuiList2[5]).Script.Disabled = false
script.Parent.Parent:findFirstChild(MenuName):findFirstChild(GuiList2[6]).Script.Disabled = false
end
stopfun = false
end
end
