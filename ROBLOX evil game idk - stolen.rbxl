				<Item class="Script" referent="RBX5579">
					<Properties>
						<bool name="Archivable">true</bool>
						<bool name="Disabled">true</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">TimerScript</string>
						<ProtectedString name="Source">while script.time.Value &gt; 0 do
wait(1)
pla = game.Players:GetChildren()
for num = 1, #pla do
if pla[num]:findFirstChild(&quot;inGame&quot;) ~= nil then
if pla[num]:findFirstChild(&quot;inGame&quot;).Value == true then
pla[num].PlayerGui.inGame.Timer.Visible = true
pla[num].PlayerGui.inGame.Timer.Text = &quot;Time Left: &quot;..script.time.Value
end end end
script.time.Value = script.time.Value - 1
end
script.Parent.Door2.Part1.Transparency = 1
script.Parent.Door2.Part2.Transparency = 1
script.Parent.Door2.Part3.Transparency = 1
script.Parent.Door2.Part4.Transparency = 1

script.Parent.Door2.Part1.CanCollide = false
script.Parent.Door2.Part2.CanCollide = false
script.Parent.Door2.Part3.CanCollide = false
script.Parent.Door2.Part4.CanCollide = false

script.Parent.Door2.Part1.Transparency = 0
script.Parent.Door2.Part2.Transparency = 0
script.Parent.Door2.Part3.Transparency = 0
script.Parent.Door2.Part4.Transparency = 0

script.Parent.Door2.Part1.CanCollide = true
script.Parent.Door2.Part2.CanCollide = true
script.Parent.Door2.Part3.CanCollide = true
script.Parent.Door2.Part4.CanCollide = true

</ProtectedString>
