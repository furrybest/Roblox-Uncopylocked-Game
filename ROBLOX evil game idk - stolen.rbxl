but = script.Parent.Parent

function buttonClicked()
--Change Colors
local ba = but.Parent:GetChildren()
for numy = 1, #ba do
but.Parent:findFirstChild(&quot;sqr&quot;..numy).BackgroundColor3 = red
end
local it = but.Parent.Parent.Items:GetChildren()
for num = 1, #it do
if but.Parent.Parent.Items:findFirstChild(&quot;sqr&quot;..num).Text == &quot;N/A&quot; then
but.Parent.Parent.Items:findFirstChild(&quot;sqr&quot;..num).BackgroundColor3 = green
else
but.Parent.Parent.Items:findFirstChild(&quot;sqr&quot;..num).BackgroundColor3 = red
end
end
but.Parent.Parent.CurrentItem.Value = but.Text
but.Parent.Parent.CurrentItem.Backpack.Value = true
but.Parent.Parent.CurrentItem.SquareNum.Value = but.Name
but.move.Visible = false
but.remov.Visible = false
but.cancel.Visible = false
end

