function GetAllParts(root)
for i,v in pairs(root:GetChildren()) do
if v:IsA(&quot;BasePart&quot;) then
table.insert(parts,v)
end
GetAllParts(v)
end
end

--The two functions below and the math stuff related to it was made by Weaselman50, so if
--you&apos;re snooping around through my scripts, don&apos;t PM me to ask how the following makes sense. :P
function check(rel, slope1, slope2, Axis)
&#9;if rel[Axis]&gt;slope2[Axis]*-rel.z and slope1[Axis]&gt;slope2[Axis] then 
&#9;&#9;return rel[Axis]&lt;slope1[Axis]*-rel.z
&#9;elseif slope1[Axis]&lt;slope2[Axis] and rel[Axis]&lt;slope2[Axis]*-rel.z then
&#9;&#9;return rel[Axis]&gt;slope1[Axis]*-rel.z
&#9;else
&#9;&#9;return false
&#9;end
end
function search()
parts={}
GetAllParts(workspace)
&#9;for i, v in pairs(parts) do
&#9;&#9;if hasPermission(v,&quot;Drag&quot;) then
&#9;&#9;&#9;local rel=(workspace.CurrentCamera.CoordinateFrame:inverse()*CFrame.new(v.Position)).p
&#9;&#9;&#9;if rel.z&lt;0 and check(rel, slope1, slope2, &quot;x&quot;) and check(rel, slope1, slope2, &quot;y&quot;) then
&#9;&#9;&#9;&#9;&#9;Selection.Add(v)
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end

playersInGame={}
for i,v in pairs(game.Players:GetChildren()) do table.insert(playersInGame,v.Name) end
game.Players.ChildAdded:connect(function(player) table.insert(playersInGame,player.Name) end)
game.Players.ChildRemoved:connect(function(player) wait(60)
deleted=false
for i=#playersInGame,1,-1 do
if playersInGame[i]==player.Name and not deleted then
table.remove(playersInGame,i)
deleted=true
end
end
end)

function hasPermission(part,action)
--All permissions will be saved in the player whom it pertains to. For example, if blobbyblob allows
--farinhimlich to color his parts, the value &quot;CanColor_blobbyblob&quot; will be saved inside farinhimlich&apos;s
--player object under &quot;BlobbyblobBuildToolStats&quot;.
--[[Actions will be:
Drag: clicking and dragging to move the part around
Save: saving their bricks
Move: using the tool and pressing tab to move a part
And more self-explanatory ones: Color, Size, Rotate, Anchor, Lock, Material, Surface, Transparency
and Reflectance.
]]
if part==nil then return false end
--if action==&quot;Drag&quot; and (not part.Locked or (part.Locked and keys.check(52))) and player.Name==&quot;Player&quot; then return true end
if string.sub(part.Name,1,16)==&quot;BlobbyblobBuild_&quot; then
local owner=string.sub(part.Name,17)
pig=false for i,v in pairs(playersInGame) do if owner==v then pig=true end end
if string.sub(part.Name,1,16)==&quot;BlobbyblobBuild_&quot; and not pig then return true end --player is not in the game, nor has been in the last minute, so their parts are free game
local stats=player:findFirstChild(&quot;BlobbyblobBuildToolStats&quot;)
local permissions=stats:findFirstChild(&quot;Can&quot;..action..&quot;_&quot;..owner)
if ((not part.Locked or (part.Locked and keys.check(52))) and action==&quot;Drag&quot;) or action~=&quot;Drag&quot; then
if permissions then
if permissions.Value then
return true
end
end
end
end
return false
end

function onButton1Down(mouse)
&#9;if obj1:findFirstChild(&quot;ColorPicker&quot;) then
&#9;&#9;obj1.ColorPicker:remove()
&#9;end
&#9;if centerPointExpected then
&#9;&#9;centerPoint=mouse.Target
&#9;&#9;centerPointExpected=false
&#9;&#9;obj30.BackgroundColor3=Color3.new(255/255,208/255,0/255)
&#9;&#9;SelectionBox.Adornee=nil
&#9;&#9;return
&#9;end
&#9;if not mouseDown then
&#9;&#9;dontDragPl0x=false
&#9;&#9;if mouse.Target~=nil then
&#9;&#9;&#9;if (string.sub(mouse.Target.Name,1,16)==&quot;BlobbyblobBuild_&quot; or not mouse.Target.Locked) then
&#9;&#9;&#9;&#9;if string.sub(mouse.Target.Name,1,16)==&quot;BlobbyblobBuild_&quot; and obj33.BackgroundColor3==Color3.new(102/255,1,51/255) and (not mouse.Target.Locked or keys.check(52)) then
&#9;&#9;&#9;&#9;&#9;if keys.check(48) or keys.check(50) then
&#9;&#9;&#9;&#9;&#9;&#9;if Selection.Check(mouse.Target) then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;Selection.Remove(mouse.Target)
&#9;&#9;&#9;&#9;&#9;&#9;&#9;dontDragPl0x=true
&#9;&#9;&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;&#9;&#9;Selection.Add(mouse.Target)
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;&#9;if not Selection.Check(mouse.Target) then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;Selection.Clear()
&#9;&#9;&#9;&#9;&#9;&#9;&#9;Selection.Add(mouse.Target)
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;offset=(mouse.Target.CFrame:inverse()*CFrame.new(mouse.Hit.p)).p
&#9;&#9;&#9;&#9;if (mouse.Target~=nil and (not hasPermission(mouse.Target,&quot;Drag&quot;) and mouse.Target.Locked==false and string.sub(mouse.Target.Name,1,16)~=&quot;BlobbyblobBuild_&quot;)) or (hasPermission(mouse.Target,&quot;Drag&quot;) and obj32.BackgroundColor3==Color3.new(102/255,1,51/255) and (not mouse.Target.Locked or keys.check(52))) then
&#9;&#9;&#9;&#9;&#9;Selection.Clear()
&#9;&#9;&#9;&#9;&#9;p=mouse.Target:clone()
&#9;&#9;&#9;&#9;&#9;local targ=mouse.Target.Position+Vector3.new(0,.1,0)
&#9;&#9;&#9;&#9;&#9;p.Parent=workspace
&#9;&#9;&#9;&#9;&#9;p.Name=&quot;BlobbyblobBuild_&quot;..player.Name
&#9;&#9;&#9;&#9;&#9;p.Position=targ
&#9;&#9;&#9;&#9;&#9;Selection.Add(p)
&#9;&#9;&#9;&#9;&#9;Dragger:MouseDown(p,offset,Selection.Get())
&#9;&#9;&#9;&#9;&#9;mouse.Icon=&quot;rbxasset://textures\\GrabRotateCursor.png&quot;
&#9;&#9;&#9;&#9;&#9;mouseDown=true
&#9;&#9;&#9;&#9;elseif (mouse.Target~=nil and hasPermission(mouse.Target,&quot;Drag&quot;)) and not dontDragPl0x and Selection.Check(mouse.Target) then
&#9;&#9;&#9;&#9;&#9;Dragger:MouseDown(mouse.Target,offset,Selection.Get())
&#9;&#9;&#9;&#9;&#9;mouse.Icon=&quot;rbxasset://textures\\GrabRotateCursor.png&quot;
&#9;&#9;&#9;&#9;&#9;mouseDown=true
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;if not (keys.check(48) or keys.check(50)) then
&#9;&#9;&#9;&#9;&#9;Selection.Clear()
&#9;&#9;&#9;&#9;&#9;Highlight.Size=UDim2.new()
&#9;&#9;&#9;&#9;&#9;Highlight.Visible=true
&#9;&#9;&#9;&#9;&#9;Highlight.Position=UDim2.new(0, mouse.X, 0, mouse.Y-20)
&#9;&#9;&#9;&#9;&#9;p1=Vector2.new(mouse.X, mouse.Y)
&#9;&#9;&#9;&#9;&#9;local rel=(workspace.CurrentCamera.CoordinateFrame:inverse()*CFrame.new(mouse.Hit.p)).p
&#9;&#9;&#9;&#9;&#9;slope1=Vector2.new(rel.x/-rel.z, rel.y/-rel.z)
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;else
&#9;&#9;&#9;if not (keys.check(48) or keys.check(50)) then
&#9;&#9;&#9;&#9;Selection.Clear()
&#9;&#9;&#9;&#9;Highlight.Size=UDim2.new()
&#9;&#9;&#9;&#9;Highlight.Visible=true
&#9;&#9;&#9;&#9;Highlight.Position=UDim2.new(0, mouse.X, 0, mouse.Y-20)
&#9;&#9;&#9;&#9;p1=Vector2.new(mouse.X, mouse.Y)
&#9;&#9;&#9;&#9;local rel=(workspace.CurrentCamera.CoordinateFrame:inverse()*CFrame.new(mouse.Hit.p)).p
&#9;&#9;&#9;&#9;slope1=Vector2.new(rel.x/-rel.z, rel.y/-rel.z)
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end

function getAABB(parts)
if type(parts)~=&quot;table&quot; then return Vector3.new(0,0,0), Vector3.new(0,0,0) end
if #parts==0 then return Vector3.new(0,0,0), Vector3.new(0,0,0) end
local min=parts[1].Position
local max=parts[1].Position
for i,v in pairs(parts) do
for x=-1,1,2 do
for y=-1,1,2 do
for z=-1,1,2 do
local s=v.Size/2
local p = ((v.CFrame-v.CFrame.p) * CFrame.new(x*s.x, y*s.y, z*s.z)).p + v.Position 
min=Vector3.new(math.min(p.x,min.x),math.min(p.y,min.y),math.min(p.z,min.z))
max=Vector3.new(math.max(p.x,max.x),math.max(p.y,max.y),math.max(p.z,max.z))
end
end
end
end
return min,max
end

function onButton1Up(mouse)
AABB.Parent=nil
if mouseDown then
Dragger:MouseUp()
mouseDown=false
mouse.Icon=&quot;&quot;
end
if Highlight.Visible then
&#9;&#9;&#9;local rel=(workspace.CurrentCamera.CoordinateFrame:inverse()*CFrame.new(mouse.Hit.p)).p 
&#9;&#9;&#9;slope2=Vector2.new(rel.x/-rel.z, rel.y/-rel.z) 
&#9;&#9;&#9;search()
&#9;&#9;&#9;Highlight.Visible=false
end
refreshData()
refreshHandles()
end

function refreshHandles()
parts={}
for i,v in pairs(Selection.Get()) do
if (hasPermission(v,&quot;Move&quot;) and mode==&quot;Mode01&quot;) or (hasPermission(v,&quot;Rotate&quot;) and mode==&quot;Mode02&quot;) or (hasPermission(v,&quot;Size&quot;) and mode==&quot;Mode04&quot;) then
table.insert(parts,v)
end
end
if mode~=&quot;Mode02&quot; or #parts==0 then archandles.Parent=nil end
if (mode~=&quot;Mode01&quot; and mode~=&quot;Mode04&quot;) or #parts==0 then handles.Parent=nil end
if #Selection.Get()==0 then return end
if mode==&quot;Mode01&quot; then --move
if obj21.Text==&quot;&quot; or #parts&gt;1 then
min,max=getAABB(parts)
AABB.Size=max-min
AABB.CFrame=CFrame.new(min:lerp(max,.5))
AABB.Parent=LocalMsg
axis_mode=&quot;&quot;
handles.Parent=obj1
handles.Adornee=AABB
handles.Color=BrickColor.new(&quot;Bright orange&quot;)
if display_axes then
axis_x.Parent=LocalMsg
axis_x.Mesh.Scale=Vector3.new(.5,2,.5)
axis_x.CFrame=AABB.CFrame*CFrame.Angles(0,0,-math.pi/2)*CFrame.new(0,1+AABB.Size.x/2,0)
axis_y.Parent=LocalMsg
axis_y.Mesh.Scale=Vector3.new(.5,2,.5)
axis_y.CFrame=AABB.CFrame*CFrame.new(0,1+AABB.Size.y/2,0)
axis_z.Parent=LocalMsg
axis_z.Mesh.Scale=Vector3.new(.5,2,.5)
axis_z.CFrame=AABB.CFrame*CFrame.Angles(math.pi/2,0,0)*CFrame.new(0,1+AABB.Size.z/2,0)
end
elseif #parts==1 then
axis_mode=&quot;X&quot;
handles.Parent=obj1
handles.Adornee=parts[1]
handles.Color=BrickColor.new(&quot;Bright orange&quot;)
p=parts[1]
if display_axes then
axis_x.Parent=LocalMsg
axis_x.Mesh.Scale=Vector3.new(.5,2,.5)
axis_x.CFrame=p.CFrame*CFrame.Angles(0,0,-math.pi/2)*CFrame.new(0,1+p.Size.x/2,0)
axis_y.Parent=LocalMsg
axis_y.Mesh.Scale=Vector3.new(.5,2,.5)
axis_y.CFrame=p.CFrame*CFrame.new(0,1+p.Size.y/2,0)
axis_z.Parent=LocalMsg
axis_z.Mesh.Scale=Vector3.new(.5,2,.5)
axis_z.CFrame=p.CFrame*CFrame.Angles(math.pi/2,0,0)*CFrame.new(0,1+p.Size.z/2,0)
end
else
handles.Adornee=nil
axis_x.Parent=nil
axis_y.Parent=nil
axis_z.Parent=nil
end
elseif mode==&quot;Mode02&quot; then
if #parts&gt;1 then
min,max=getAABB(parts)
AABB.Size=max-min
AABB.CFrame=CFrame.new(min:lerp(max,.5))
AABB.Parent=LocalMsg
archandles.Parent=obj1
archandles.Adornee=AABB
if display_axes then
axis_x.Parent=LocalMsg
axis_x.Mesh.Scale=Vector3.new(.5,2,.5)
axis_x.CFrame=AABB.CFrame*CFrame.Angles(0,0,-math.pi/2)*CFrame.new(0,1+AABB.Size.x/2,0)
axis_y.Parent=LocalMsg
axis_y.Mesh.Scale=Vector3.new(.5,2,.5)
axis_y.CFrame=AABB.CFrame*CFrame.new(0,1+AABB.Size.y/2,0)
axis_z.Parent=LocalMsg
axis_z.Mesh.Scale=Vector3.new(.5,2,.5)
axis_z.CFrame=AABB.CFrame*CFrame.Angles(math.pi/2,0,0)*CFrame.new(0,1+AABB.Size.z/2,0)
end
elseif #parts==1 then
archandles.Parent=obj1
archandles.Adornee=parts[1]
p=parts[1]
if display_axes then
axis_x.Parent=LocalMsg
axis_x.Mesh.Scale=Vector3.new(.5,2,.5)
axis_x.CFrame=p.CFrame*CFrame.Angles(0,0,-math.pi/2)*CFrame.new(0,1+p.Size.x/2,0)
axis_y.Parent=LocalMsg
axis_y.Mesh.Scale=Vector3.new(.5,2,.5)
axis_y.CFrame=p.CFrame*CFrame.new(0,1+p.Size.y/2,0)
axis_z.Parent=LocalMsg
axis_z.Mesh.Scale=Vector3.new(.5,2,.5)
axis_z.CFrame=p.CFrame*CFrame.Angles(math.pi/2,0,0)*CFrame.new(0,1+p.Size.z/2,0)
end
else
archandles.Adornee=nil
axis_x.Parent=nil
axis_y.Parent=nil
axis_z.Parent=nil
end
elseif mode==&quot;Mode04&quot; then
if #parts==1 then
handles.Parent=obj1
handles.Adornee=parts[1]
handles.Color=BrickColor.new(&quot;Cyan&quot;)
p=parts[1]
if display_axes then
axis_x.Parent=LocalMsg
axis_x.Mesh.Scale=Vector3.new(.5,2,.5)
axis_x.CFrame=p.CFrame*CFrame.Angles(0,0,-math.pi/2)*CFrame.new(0,1+p.Size.x/2,0)
axis_y.Parent=LocalMsg
axis_y.Mesh.Scale=Vector3.new(.5,2,.5)
axis_y.CFrame=p.CFrame*CFrame.new(0,1+p.Size.y/2,0)
axis_z.Parent=LocalMsg
axis_z.Mesh.Scale=Vector3.new(.5,2,.5)
axis_z.CFrame=p.CFrame*CFrame.Angles(math.pi/2,0,0)*CFrame.new(0,1+p.Size.z/2,0)
end
else
handles.Adornee=nil
end
end
refreshData()
end

shortcuts_active=true
function onKeyDown(key,mouse)
if shortcuts_active then
if key==&quot;q&quot; then
onModeClick(obj9)
elseif key==&quot;e&quot; then
onModeClick(obj11)
elseif key==&quot;z&quot; then
onModeClick(obj10)
end
end
keys.down(string.byte(key))
if keys.check(48) and string.byte(key)==8 then
for i,v in pairs(Selection.Get()) do
if hasPermission(v,&quot;Delete&quot;) then
v:remove()
end
end
Selection.Clear()
end
if keys.check(48) and string.byte(key)==99 then
cloned={}
tallest=0
for i,v in pairs(Selection.Get()) do
if hasPermission(v,&quot;Drag&quot;) then
c=v:clone()
c.Parent=workspace
table.insert(cloned,c)
if v.Size.y&gt;tallest then tallest=v.Size.y end
end
end
Selection.Clear()
for i,v in pairs(cloned) do
v.CFrame=v.CFrame+Vector3.new(0,tallest,0)
Selection.Add(v)
end
end
if string.byte(key)==13 then
setMeshScale()
end
if mouseDown then
if key==&quot;r&quot; then
Dragger:AxisRotate(Enum.Axis.Y)
elseif key==&quot;t&quot; then
Dragger:AxisRotate(Enum.Axis.X)
end
end
if string.byte(key)==9 and (advsimp==&quot;Advanced&quot; or mode==&quot;Mode03&quot;) then
rx=obj21.Text==&quot;X&quot; and 1 or 0
ry=obj21.Text==&quot;X&quot; and 1 or 0
rz=obj21.Text==&quot;X&quot; and 1 or 0
if mode==&quot;Mode01&quot; then
for i,v in pairs(Selection.Get()) do
if hasPermission(v,&quot;Move&quot;) then
v.CFrame=CFrame.new((1-rx)*(tonumber(obj6.Text) or 0),(1-ry)*(tonumber(obj19.Text) or 0),(1-rz)*(tonumber(obj20.Text) or 0))*v.CFrame*CFrame.new(rx*(tonumber(obj6.Text) or 0),ry*(tonumber(obj19.Text) or 0),rz*(tonumber(obj20.Text) or 0))
end
end
elseif mode==&quot;Mode02&quot; then
for i,v in pairs(Selection.Get()) do
if hasPermission(v,&quot;Rotate&quot;) then

if centerPoint then
center=centerPoint.CFrame
SelectionBox.Adornee=centerPoint
Delay(.25,function() SelectionBox.Adornee=nil end)
local origin={}
for i,p in pairs(Selection.Get()) do
origin[p]=center:toObjectSpace(p.CFrame)
end
center=center*CFrame.Angles(math.rad(tonumber(obj6.Text) or 0),math.rad(tonumber(obj19.Text) or 0),math.rad(tonumber(obj20.Text) or 0))
for p,cf in pairs(origin) do
p.CFrame=center:toWorldSpace(cf)
end
else
if obj24.BackgroundColor3==Color3.new(1,204/255,0) then
v.CFrame=v.CFrame*CFrame.Angles(math.rad(tonumber(obj6.Text) or 0),math.rad(tonumber(obj19.Text) or 0),math.rad(tonumber(obj20.Text) or 0))
else
v.CFrame=CFrame.new(v.CFrame.p.x,v.CFrame.p.y,v.CFrame.p.z)*CFrame.Angles(math.rad(tonumber(obj6.Text) or 0),math.rad(tonumber(obj19.Text) or 0),math.rad(tonumber(obj20.Text) or 0))
end
end

end
end
elseif mode==&quot;Mode03&quot; then
for i,v in pairs(Selection.Get()) do
if hasPermission(v,&quot;Color&quot;) then
v.BrickColor=rememberColor
end
end
elseif mode==&quot;Mode04&quot; then
for i,v in pairs(Selection.Get()) do
if hasPermission(v,&quot;Size&quot;) then
c=v.CFrame
v.Size=v.Size+Vector3.new((tonumber(obj6.Text) or 0),(tonumber(obj19.Text) or 0),(tonumber(obj20.Text) or 0))
v.CFrame=c
end
end
elseif mode==&quot;Mode05&quot; then
for i,v in pairs(Selection.Get()) do
if hasPermission(v,&quot;Anchor&quot;) then
if rememberAnchor==0 then
v.Anchored=true
elseif rememberAnchor==1 then
v.Anchored=false
elseif rememberAnchor==2 then
v.Anchored=not v.Anchored
end
end
end
elseif mode==&quot;Mode06&quot; then
for i,v in pairs(Selection.Get()) do
if hasPermission(v,&quot;Lock&quot;) then
if rememberLock==0 then
v.Locked=true
elseif rememberLock==1 then
v.Locked=false
elseif rememberLock==2 then
v.Locked=not v.Locked
end
end
end
elseif mode==&quot;Mode07&quot; then
for i,v in pairs(Selection.Get()) do
if hasPermission(v,&quot;Material&quot;) then
v.Material=Enum.Material[rememberMaterial]
end
end
elseif mode==&quot;Mode08&quot; then
surface=mouse.TargetSurface
if surface==Enum.NormalId.Right then mouse.Target.RightSurface=Enum.SurfaceType[rememberSurface] end
if surface==Enum.NormalId.Left then mouse.Target.LeftSurface=Enum.SurfaceType[rememberSurface] end
if surface==Enum.NormalId.Top then mouse.Target.TopSurface=Enum.SurfaceType[rememberSurface] end
if surface==Enum.NormalId.Bottom then mouse.Target.BottomSurface=Enum.SurfaceType[rememberSurface] end
if surface==Enum.NormalId.Front then mouse.Target.FrontSurface=Enum.SurfaceType[rememberSurface] end
if surface==Enum.NormalId.Back then mouse.Target.BackSurface=Enum.SurfaceType[rememberSurface] end
elseif mode==&quot;Mode09&quot; then --Transparency
for i,v in pairs(Selection.Get()) do
if hasPermission(v,&quot;Transparency&quot;) then
if obj21.Text==&quot;X&quot; then
val=v.Transparency+tonumber(obj6.Text)
else
val=tonumber(obj6.Text)
end
if obj22.Text==&quot;X&quot; then
v.Transparency=math.max(0,math.min(val or 0,1))
else
v.Transparency=val
end
end
end
elseif mode==&quot;Mode10&quot; then --Reflectance
for i,v in pairs(Selection.Get()) do
if hasPermission(v,&quot;Reflectance&quot;) then
if obj21.Text==&quot;X&quot; then
val=v.Reflectance+tonumber(obj6.Text)
else
val=tonumber(obj6.Text)
end
if obj22.Text==&quot;X&quot; then
v.Reflectance=math.max(0,math.min(val or 0,1))
else
v.Reflectance=val
end
end
end
end
end
refreshHandles()
end

function onKeyUp(key,mouse)
keys.up(string.byte(key))
end

function onMove(mouse)
if not mouseDown then
if hasPermission(mouse.Target,&quot;Drag&quot;) and obj33.BackgroundColor3==Color3.new(102/255,1,51/255) then
mouse.Icon=&quot;rbxasset://textures\\DragCursor.png&quot;
elseif (mouse.Target~=nil and (not hasPermission(mouse.Target,&quot;Drag&quot;) and mouse.Target.Locked==false and string.sub(mouse.Target.Name,1,16)~=&quot;BlobbyblobBuild_&quot;)) or (hasPermission(mouse.Target,&quot;Drag&quot;) and obj32.BackgroundColor3==Color3.new(102/255,1,51/255)) then
mouse.Icon=&quot;http://www.roblox.com/asset/?id=25794664&quot;
else
mouse.Icon=&quot;&quot;
end
if mode==&quot;Mode08&quot; then
if hasPermission(mouse.Target,&quot;Surface&quot;) then
SurfaceSelection.Adornee=mouse.Target
SurfaceSelection.TargetSurface=mouse.TargetSurface
SurfaceSelection.Visible=true
else
SurfaceSelection.Visible=false
end
end
else
AABB.Parent=nil
handles.Adornee=nil
archandles.Adornee=nil
axis_x.Parent=nil
axis_y.Parent=nil
axis_z.Parent=nil
Dragger:MouseMove(mouse.UnitRay)
end
if Highlight.Visible then
Highlight.Size=UDim2.new(0, mouse.X-p1.x, 0, mouse.Y-p1.y)
end
if centerPointExpected then
SelectionBox.Adornee=mouse.Target
end
end

