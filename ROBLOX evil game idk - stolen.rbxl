						<ProtectedString name="Source">chil = game.Players:GetChildren()

script.Start.Changed:connect(function()
wait(4)
play = game.Players:GetChildren()
for NUMOFCAM = 1, #play do
&#9;if play[NUMOFCAM]:findFirstChild(&quot;inGame&quot;) ~= nil then
&#9;&#9;if play[NUMOFCAM].inGame.Value == true then
&#9;&#9;&#9;script.Cam1:clone().Parent = play[NUMOFCAM].Backpack
end end end

wait(5)

play = game.Players:GetChildren()
for NUMOFCAM = 1, #play do
&#9;if play[NUMOFCAM]:findFirstChild(&quot;inGame&quot;) ~= nil then
&#9;&#9;if play[NUMOFCAM].inGame.Value == true then
&#9;&#9;&#9;script.Cam2:clone().Parent = play[NUMOFCAM].Backpack
end end end
wait(1)
script.Parent.Anim.Disabled = false

--game.Workspace:findFirstChild(&quot;_Game Script_&quot;).Section.Value = 6
end)


