							<string name="Name">Script</string>
							<ProtectedString name="Source">org = script.Parent.Parent:findFirstChild(&quot;Background(Shop)&quot;)
function die()
if org.Visible == false then -- Cost to activate (50)
org.Visible = true
script.Parent.Parent.Organize.Active = false
script.Parent.Parent.Ready.Active = false
script.Parent.Parent.Shop.Active = false
script.Parent.Parent.Organize.Visible = false
script.Parent.Parent.Ready.Visible = false
script.Parent.Parent.Shop.Visible = false
else
org.Visible = false
script.Parent.Parent.Organize.Active = true
script.Parent.Parent.Ready.Active = true
script.Parent.Parent.Shop.Active = true
script.Parent.Parent.Organize.Visible = true
script.Parent.Parent.Ready.Visible = true
script.Parent.Parent.Shop.Visible = true
end
end

script.Parent.MouseButton1Down:connect(die)</ProtectedString>
