					<Item class="Script" referent="RBX9131">
						<Properties>
							<bool name="Archivable">true</bool>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">onDied</string>
							<ProtectedString name="Source">function LoadZombie(x,y,z)
local num = false
while num ~= true do
zom = game.Lighting.Jill:clone()
zom.Parent = game.Workspace
zom.Torso.CFrame = CFrame.new(x,y,z)
wait(1)
if zom.Zombie.Health &gt; 1 then
num = true
else
zom:remove()
end
end
end

oneTime = false
function onDied()
if script.Parent.Ready.Value == true then
game.Workspace:findFirstChild(&quot;_Game Script_&quot;).Section.Value = 16.5
wait(.5)
script.Parent.Parent:remove()
else
if oneTime == false then
oneTime = true
LoadZombie(game.Workspace:findFirstChild(&quot;Sec16_Map10&quot;).ZomTele1.Position.X, game.Workspace:findFirstChild(&quot;Sec16_Map10&quot;).ZomTele1.Position.Y, game.Workspace:findFirstChild(&quot;Sec16_Map10&quot;).ZomTele1.Position.Z)
wait(.5)
script.Parent.Parent:remove()
end
end end

script.Parent.Died:connect(onDied)</ProtectedString>
						</Properties>
					</Item>
					<Item class="Script" referent="RBX9132">
						<Properties>
							<bool name="Archivable">true</bool>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">HealthHack</string>
							<ProtectedString name="Source">wait(3)
print(&quot;Health Hack Enabled&quot;)
pla = game.Players:GetChildren()
script.Parent.MaxHealth = 1000*#pla
wait(.1)
script.Parent.Health = 1000*#pla</ProtectedString>
						</Properties>
