							<string name="Name">RegenScript</string>
							<ProtectedString name="Source">regentime = 1 --5 minutes
oneTime = false


function LoadZombie(x,y,z)
local num = false
while num ~= true do
zom = game.Lighting.Marshland.Majini:clone()
zom.RegenScript.Xpos.Value = x
zom.RegenScript.Ypos.Value = y
zom.RegenScript.Zpos.Value = z
zom.Parent = game.Workspace
zom.Torso.CFrame = CFrame.new(x,y,z)
wait(1)
if zom.Zombie.Health &gt; 1 then
num = true
zom:findFirstChild(&quot;Zombie Startup&quot;).Disabled = false
else
zom:remove()
end
end
end




function onDied()
if oneTime == false then
oneTime = true
if script.Parent.DontRegen.Value == false then
script.Parent.DontRegen.Value = true
    wait(regentime)
    wait(1)
LoadZombie(script.Xpos.Value, script.Ypos.Value, script.Zpos.Value)

wait(3)
script.Parent:remove()
end
end
end

script.Parent.Zombie.Died:connect(onDied)</ProtectedString>
