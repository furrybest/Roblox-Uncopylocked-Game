script.Parent.Tray.Bar3.Size = UDim2.new(0,15,0,0)
script.Parent.Tray.Bar4.Size = UDim2.new(0,32.5,0,15)
end
else --3.125=16.25
script.Parent.Tray.Bar1.Size = UDim2.new(0,15,0,0)
script.Parent.Tray.Bar2.Size = UDim2.new(0,0,0,15)
script.Parent.Tray.Bar3.Size = UDim2.new(0,15,0,0)
script.Parent.Tray.Bar4.Size = UDim2.new(0,16.25,0,15)
end
elseif pla.Health == 0 or pla.Health &lt; 1 then
script.Parent.Tray.Bar1.Size = UDim2.new(0,15,0,0)
script.Parent.Tray.Bar2.Size = UDim2.new(0,0,0,15)
script.Parent.Tray.Bar3.Size = UDim2.new(0,15,0,0)
script.Parent.Tray.Bar4.Size = UDim2.new(0,0,0,15)
end
end--while loop end
--just to make sure theres enough ends :D</ProtectedString>
