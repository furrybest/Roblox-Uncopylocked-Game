for i,v in pairs({obj133,obj134,obj135,obj136,obj137,obj138,obj139,obj140,obj141,obj142,obj143,obj144,obj145}) do
v.MouseButton1Down:connect(function() HelpDialog(v) end)
end


Highlight=Instance.new(&quot;Frame&quot;) Highlight.BackgroundTransparency=.8 Highlight.BorderColor3=Color3.new(0,0,0) Highlight.Parent=obj1 Highlight.Name=&quot;Highlight&quot; Highlight.Visible=false Highlight.BackgroundColor3=Color3.new(1,1,1)

