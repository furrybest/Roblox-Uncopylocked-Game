								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">Script</string>
								<ProtectedString name="Source">MenuName = &quot;GameMenu&quot;
GuiList2 = {&quot;Back&quot;, &quot;Bonus&quot;, &quot;Chapter&quot;, &quot;Item&quot;, &quot;Join&quot;, &quot;Start&quot;}
stopfun = false
function onButtonClicked()
if stopfun == false then
stopfun = true
script.Parent.Parent.Visible = false
script.Parent.Parent.Parent:findFirstChild(MenuName).Visible = true
local xpos = -300
while xpos &lt; 0 do
