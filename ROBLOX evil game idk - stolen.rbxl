					<Item class="Script" referent="RBX2166">
						<Properties>
							<bool name="Archivable">true</bool>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script</string>
							<ProtectedString name="Source">local hin = Instance.new(&quot;Hint&quot;)
local cont = false
function onTouched(hit)
if hit ~= nil then
if hit.Parent:findFirstChild(&quot;Humanoid&quot;) ~= nil then
if cont == false then
cont = true
hin.Parent = script.Parent
hin.Text = &quot;Chris(you): I&apos;ve located Irving&apos;s hideout, but hes gone.&quot;
wait(7)
hin.Text = &quot;Chris(you): There are some photos of the marshlands here also.&quot;
wait(7)
hin.Text = &quot;HQ: Alright. Search for a boat to use.&quot;
wait(5)
hin.Text = &quot;HQ: Use it to get to the marshlands and find Irving.&quot;
wait(7)
hin.Text = &quot;Chris(you): Okay. I&apos;ll contact you when I get there. Chris out.&quot;
wait(9)
hin.Text = &quot;Chris(you)(To self): Wait theres some more pics here...&quot;
wait(9)
hin.Text = &quot;Chris(you)(To self): Jill!?...&quot;
wait(6)
hin:remove()
script.Parent.Parent.Window:remove()
wait(.5)
script.Parent:remove()
end
end
end
end

