fol = &quot;n22p1s3&quot;
elseif fol == &quot;Humanoid&quot; and PName == &quot;startn23&quot; then
fol = &quot;n23p1s3&quot;
elseif fol == &quot;Humanoid&quot; and PName == &quot;startn24&quot; then
fol = &quot;n24p1s3&quot;
elseif fol == &quot;Humanoid&quot; and PName == &quot;startn25&quot; then
fol = &quot;n25p1s3&quot;
--SPECIAL PIECES
elseif fol == &quot;Spec1g1p1&quot; and PName == fol then
fol = &quot;Spec1g1p2&quot;
elseif fol == &quot;Spec1g1p2&quot; and PName == fol then
fol = &quot;Spec1g1p3&quot;
elseif fol == &quot;Spec1g1p3&quot; and PName == fol then
fol = &quot;Spec1g1p4&quot;
elseif fol == &quot;Spec1g1p4&quot; and PName == fol then
fol = &quot;Spec1g1p5&quot;
elseif fol == &quot;Spec1g1p5&quot; and PName == fol then
fol = &quot;Humanoid&quot;

elseif fol == &quot;Spec1g2p1&quot; and PName == fol then
fol = &quot;Spec1g2p2&quot;
elseif fol == &quot;Spec1g2p2&quot; and PName == fol then
fol = &quot;Humanoid&quot;

elseif fol == &quot;Spec2g1p1&quot; and PName == fol then
fol = &quot;Humanoid&quot;


elseif fol == &quot;Spec3g1p1&quot; and PName == fol then
fol = &quot;Spec3g1p2&quot;
elseif fol == &quot;Spec3g1p2&quot; and PName == fol then
fol = &quot;Spec3g1p3&quot;
elseif fol == &quot;Spec3g1p3&quot; and PName == fol then
fol = &quot;Humanoid&quot;

elseif fol == &quot;Spec3g2p1&quot; and PName == fol then
fol = &quot;Spec3g2p2&quot;
elseif fol == &quot;Spec3g2p2&quot; and PName == fol then
fol = &quot;Spec3g2p3&quot;
elseif fol == &quot;Spec3g2p3&quot; and PName == fol then
fol = &quot;Spec3g2p4&quot;
elseif fol == &quot;Spec3g2p4&quot; and PName == fol then
fol = &quot;Spec3g2p5&quot;
elseif fol == &quot;Spec3g2p5&quot; and PName == fol then
fol = &quot;Spec3g2p6&quot;
elseif fol == &quot;Spec3g2p6&quot; and PName == fol then
fol = &quot;Spec3g2p7&quot;
elseif fol == &quot;Spec3g2p7&quot; and PName == fol then
fol = &quot;Humanoid&quot;

elseif fol == &quot;Spec4g1p1&quot; and PName == fol then
fol = &quot;Humanoid&quot;

elseif fol == &quot;Spec5g1p1&quot; and PName == fol then
fol = &quot;Humanoid&quot;

elseif fol == &quot;Spec6g1p1&quot; and PName == fol then
fol = &quot;Humanoid&quot;

elseif fol == &quot;Spec7g1p1&quot; and PName == fol then
fol = &quot;Humanoid&quot;

elseif fol == &quot;Spec8g1p1&quot; and PName == fol then
fol = &quot;Humanoid&quot;

--START START PIECES
elseif fol == &quot;Humanoid&quot; and PName == &quot;startSpec1&quot; then
if game.Workspace:findFirstChild(script.Parent.AIPaths.Human.Value).Torso.Position.Y &gt; game.Workspace:findFirstChild(findSection()).Spec1Divider.Spec1Divider.Position.Y then
fol = &quot;Spec1g1p1&quot;
else
fol = &quot;Spec1g2p1&quot;
end

elseif fol == &quot;Humanoid&quot; and PName == &quot;startSpec3&quot; then
if game.Workspace:findFirstChild(script.Parent.AIPaths.Human.Value).Torso.Position.Y &gt; game.Workspace:findFirstChild(findSection()).Spec3Divider.Spec3Divider.Position.Y then
fol = &quot;Spec3g2p1&quot;
else
fol = &quot;Spec3g1p1&quot;
end

elseif fol == &quot;Humanoid&quot; and PName == &quot;startSpec2&quot; then
fol = &quot;Spec2g1p1&quot;

elseif fol == &quot;Humanoid&quot; and PName == &quot;startSpec4&quot; then
fol = &quot;Spec4g1p1&quot;

elseif fol == &quot;Humanoid&quot; and PName == &quot;startSpec5&quot; then
