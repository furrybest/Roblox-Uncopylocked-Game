				<Item class="Script" referent="RBX5109">
					<Properties>
						<bool name="Archivable">true</bool>
						<bool name="Disabled">true</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">TimerScript</string>
						<ProtectedString name="Source">while script.time.Value &gt; 0 do
wait(1)
pla = game.Players:GetChildren()
for num = 1, #pla do
if pla[num]:findFirstChild(&quot;inGame&quot;) ~= nil then
if pla[num]:findFirstChild(&quot;inGame&quot;).Value == true then
pla[num].PlayerGui.inGame.Timer.Visible = true
pla[num].PlayerGui.inGame.Timer.Text = &quot;Time Left: &quot;..script.time.Value
end end end
script.time.Value = script.time.Value - 1
if script.time.Value == 100 then
script.Parent.ChangeLight.Disabled = false
end
end

for num = 1, #pla do
pla[num].PlayerGui.inGame.Timer.Visible = false
end

script.Parent.EleDoor.Part1.Transparency = 1
script.Parent.EleDoor.Part1.CanCollide = false
wait(.2)
script.Parent.EleDoor.Part2.Transparency = 1
script.Parent.EleDoor.Part2.CanCollide = false
wait(.2)
script.Parent.EleDoor.Part3.Transparency = 1
script.Parent.EleDoor.Part3.CanCollide = false
wait(.2)
script.Parent.EleDoor.Part4.Transparency = 1
script.Parent.EleDoor.Part4.CanCollide = false
wait(.2)
script.Parent.EleDoor.Part5.Transparency = 1
script.Parent.EleDoor.Part5.CanCollide = false
wait(.2)
script.Parent.EleDoor.Part6.Transparency = 1
script.Parent.EleDoor.Part6.CanCollide = false
wait(.2)
script.Parent.EleDoor.Part7.Transparency = 1
script.Parent.EleDoor.Part7.CanCollide = false
wait(.2)
script.Parent.EleDoor.Part8.Transparency = 1
script.Parent.EleDoor.Part8.CanCollide = false
