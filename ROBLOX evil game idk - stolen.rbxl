								<ProtectedString name="Source">function die()
local every = script.Parent.Parent:children()
for x = 1, #every do
if every[x].className == &quot;ImageLabel&quot; or every[x].className == &quot;TextLabel&quot; then
if every[x].Name ~= &quot;BACKGROUND&quot; and every[x].Name ~= &quot;BackgroundPic&quot; and every[x].Name ~= &quot;BrickmanPic&quot; then
every[x].Visible = false
end
end
end
