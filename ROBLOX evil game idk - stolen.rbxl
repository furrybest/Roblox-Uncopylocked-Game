function refreshData()
if #Selection.Get()==1 then
p=Selection.Get()[1]
x,y,z,r00,r01,r02,r10,r11,r12,r20,r21,r22=p.CFrame:components()
v=p.Size
round_off=.001
obj39.Text=tostring(round(x,round_off))..&quot;, &quot;..tostring(round(y,round_off))..&quot;, &quot;..tostring(round(z,round_off))
obj41.Text=tostring(round(r00,round_off))..&quot;, &quot;..tostring(round(r01,round_off))..&quot;, &quot;..tostring(round(r02,round_off))
obj42.Text=tostring(round(r10,round_off))..&quot;, &quot;..tostring(round(r11,round_off))..&quot;, &quot;..tostring(round(r12,round_off))
obj43.Text=tostring(round(r20,round_off))..&quot;, &quot;..tostring(round(r21,round_off))..&quot;, &quot;..tostring(round(r22,round_off))
obj45.Text=tostring(round(v.x,round_off))..&quot;, &quot;..tostring(round(v.y,round_off))..&quot;, &quot;..tostring(round(v.z,round_off))
else
obj39.Text=&quot;?, ?, ?&quot;
obj41.Text=&quot;?, ?, ?&quot;
obj42.Text=&quot;?, ?, ?&quot;
obj43.Text=&quot;?, ?, ?&quot;
obj45.Text=&quot;?, ?, ?&quot;
end
end

round=function(number,multiple)
return math.floor(number/multiple+.5)*multiple
end

append_distance=0
handles.MouseDrag:connect(function(side,distance)
if handles.Color.Name==&quot;Bright orange&quot; then
x=(side==Enum.NormalId.Left or side==Enum.NormalId.Right) and 1 or 0
y=(side==Enum.NormalId.Top or side==Enum.NormalId.Bottom) and 1 or 0
z=(side==Enum.NormalId.Front or side==Enum.NormalId.Back) and 1 or 0
v=(side==Enum.NormalId.Right or side==Enum.NormalId.Top or side==Enum.NormalId.Back) and 1 or -1
d=round(distance-append_distance,movement_int)
append_distance=append_distance+d
if (axis_mode==&quot;X&quot;) then
for i,p in pairs(Selection.Get()) do
p.CFrame=p.CFrame*CFrame.new(x*d*v,y*d*v,z*d*v)
end
refreshHandles()
--[[AABB.CFrame=AABB.CFrame*CFrame.new(x*d*v,y*d*v,z*d*v)
axis_x.CFrame=axis_x.CFrame*CFrame.new(x*d*v,y*d*v,z*d*v)
axis_y.CFrame=axis_y.CFrame*CFrame.new(x*d*v,y*d*v,z*d*v)
axis_z.CFrame=axis_z.CFrame*CFrame.new(x*d*v,y*d*v,z*d*v)]]
else
for i,p in pairs(Selection.Get()) do
p.CFrame=CFrame.new(x*d*v,y*d*v,z*d*v)*p.CFrame
end
refreshHandles()
--[[AABB.CFrame=CFrame.new(x*d*v,y*d*v,z*d*v)*AABB.CFrame
axis_x.CFrame=CFrame.new(x*d*v,y*d*v,z*d*v)*axis_x.CFrame
axis_y.CFrame=CFrame.new(x*d*v,y*d*v,z*d*v)*axis_y.CFrame
axis_z.CFrame=CFrame.new(x*d*v,y*d*v,z*d*v)*axis_z.CFrame]]
end
elseif handles.Color.Name==&quot;Cyan&quot; then
if #Selection.Get()==1 then
x=(side==Enum.NormalId.Left or side==Enum.NormalId.Right) and 1 or 0
y=(side==Enum.NormalId.Top or side==Enum.NormalId.Bottom) and 1 or 0
z=(side==Enum.NormalId.Front or side==Enum.NormalId.Back) and 1 or 0
v=(side==Enum.NormalId.Right or side==Enum.NormalId.Top or side==Enum.NormalId.Back) and 1 or -1
d=round(distance-append_distance,1)
if (Selection.Get()[1].Size.x+d&lt;1 and x==1) then d=1-Selection.Get()[1].Size.x end
if (Selection.Get()[1].Size.y+d&lt;1 and y==1) then d=1-Selection.Get()[1].Size.y end
if (Selection.Get()[1].Size.z+d&lt;1 and z==1) then d=1-Selection.Get()[1].Size.z end
append_distance=append_distance+d
cf=Selection.Get()[1].CFrame
Selection.Get()[1].Size=Selection.Get()[1].Size+Vector3.new(x*d,y*d,z*d)
Selection.Get()[1].CFrame=cf*CFrame.new(x*d*v/2,y*d*v/2,z*d*v/2)

p=Selection.Get()[1]
refreshHandles()
--[[axis_x.Parent=LocalMsg
axis_x.Mesh.Scale=Vector3.new(.5,2,.5)
axis_x.CFrame=p.CFrame*CFrame.Angles(0,0,-math.pi/2)*CFrame.new(0,1+p.Size.x/2,0)
axis_y.Parent=LocalMsg
axis_y.Mesh.Scale=Vector3.new(.5,2,.5)
axis_y.CFrame=p.CFrame*CFrame.new(0,1+p.Size.y/2,0)
axis_z.Parent=LocalMsg
axis_z.Mesh.Scale=Vector3.new(.5,2,.5)
axis_z.CFrame=p.CFrame*CFrame.Angles(math.pi/2,0,0)*CFrame.new(0,1+p.Size.z/2,0)]]

end
end
end)
handles.MouseButton1Down:connect(function()
append_distance=0
end)

archandles.MouseDrag:connect(function(axis,relativeAngle,radius)

if #Selection.Get()==1 then
d=round(relativeAngle-append_distance,math.rad(rotate_rounding))
append_distance=append_distance+d
local x=(axis==Enum.Axis.X) and 1 or 0
local y=(axis==Enum.Axis.Y) and 1 or 0
local z=(axis==Enum.Axis.Z) and 1 or 0
p=Selection.Get()[1]
p.CFrame=p.CFrame*CFrame.Angles(x*d,y*d,z*d)
elseif #Selection.Get()&gt;1 then

d=round(relativeAngle-append_distance,math.rad(rotate_rounding))
append_distance=append_distance+d
local x=(axis==Enum.Axis.X) and 1 or 0
local y=(axis==Enum.Axis.Y) and 1 or 0
local z=(axis==Enum.Axis.Z) and 1 or 0
m1,m2=getAABB(Selection.Get())
center=CFrame.new(m1:lerp(m2,.5))
--the segment below was ripped from a script by Anaminus. Thank him for your being able to rotate multiple parts. ;)
local origin={}
for i,p in pairs(Selection.Get()) do
origin[p]=center:toObjectSpace(p.CFrame)
end
center=center*CFrame.Angles(x*d,y*d,z*d)
for p,cf in pairs(origin) do
p.CFrame=center:toWorldSpace(cf)
end

end
end)
archandles.MouseButton1Down:connect(function()
append_distance=0
end)

