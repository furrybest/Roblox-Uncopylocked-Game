							<string name="Name">Script</string>
							<ProtectedString name="Source">local checker = false
local doublecheck = false
script.Parent.Loading.Visible = true
wait(6)
doublecheck = true
script.Parent.Loading.Visible = false
script.Parent.clickto.Visible = true
if script.Parent.Visible == false then
checker = true
end
function die()
if doublecheck == true then
if checker == false then
checker = true
script.Parent.clickto.Visible = false
local x = 1
local y = 1.2
local cont = 30
while cont &gt; 1 do
x = x + .1
y = y + .1
cont = cont - 1
script.Parent.Size = UDim2.new(x,0,y,0)
wait()
end
script.Parent.Parent.StartMenu.Visible = true
script.Parent.Visible = false
MenuName = &quot;StartMenu&quot;
GuiList2 = {&quot;Start&quot;, &quot;Records&quot;, &quot;Options&quot;, &quot;Library&quot;, &quot;Leaderboards&quot;, &quot;Credits&quot;}
local xpos = -300
while xpos &lt; 0 do
xpos = xpos + 10
script.Parent.Parent:findFirstChild(MenuName):findFirstChild(GuiList2[1]).Position = UDim2.new(script.Parent.Parent:findFirstChild(MenuName):findFirstChild(GuiList2[1]).Position.X.Scale, 0, script.Parent.Parent:findFirstChild(MenuName):findFirstChild(GuiList2[1]).Position.Y.Scale, xpos)
script.Parent.Parent:findFirstChild(MenuName):findFirstChild(GuiList2[2]).Position = UDim2.new(script.Parent.Parent:findFirstChild(MenuName):findFirstChild(GuiList2[2]).Position.X.Scale, 0, script.Parent.Parent:findFirstChild(MenuName):findFirstChild(GuiList2[2]).Position.Y.Scale, xpos)
script.Parent.Parent:findFirstChild(MenuName):findFirstChild(GuiList2[3]).Position = UDim2.new(script.Parent.Parent:findFirstChild(MenuName):findFirstChild(GuiList2[3]).Position.X.Scale, 0, script.Parent.Parent:findFirstChild(MenuName):findFirstChild(GuiList2[3]).Position.Y.Scale, xpos)
script.Parent.Parent:findFirstChild(MenuName):findFirstChild(GuiList2[4]).Position = UDim2.new(script.Parent.Parent:findFirstChild(MenuName):findFirstChild(GuiList2[4]).Position.X.Scale, 0, script.Parent.Parent:findFirstChild(MenuName):findFirstChild(GuiList2[4]).Position.Y.Scale, xpos)
script.Parent.Parent:findFirstChild(MenuName):findFirstChild(GuiList2[5]).Position = UDim2.new(script.Parent.Parent:findFirstChild(MenuName):findFirstChild(GuiList2[5]).Position.X.Scale, 0, script.Parent.Parent:findFirstChild(MenuName):findFirstChild(GuiList2[5]).Position.Y.Scale, xpos)
script.Parent.Parent:findFirstChild(MenuName):findFirstChild(GuiList2[6]).Position = UDim2.new(script.Parent.Parent:findFirstChild(MenuName):findFirstChild(GuiList2[6]).Position.X.Scale, 0, script.Parent.Parent:findFirstChild(MenuName):findFirstChild(GuiList2[6]).Position.Y.Scale, xpos)
wait()
end
script.Parent.Parent:findFirstChild(MenuName):findFirstChild(GuiList2[1]).Script.Disabled = false
script.Parent.Parent:findFirstChild(MenuName):findFirstChild(GuiList2[2]).Script.Disabled = false
script.Parent.Parent:findFirstChild(MenuName):findFirstChild(GuiList2[3]).Script.Disabled = false
script.Parent.Parent:findFirstChild(MenuName):findFirstChild(GuiList2[4]).Script.Disabled = false
script.Parent.Parent:findFirstChild(MenuName):findFirstChild(GuiList2[5]).Script.Disabled = false
script.Parent.Parent:findFirstChild(MenuName):findFirstChild(GuiList2[6]).Script.Disabled = false
end
end
end

