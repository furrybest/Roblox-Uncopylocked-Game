function setBx1Stats()
GoldNum = 0
GoldNum = box.Box1.Text
if GoldNum == &quot;0&quot; then
pla.leaderstats.Gold.Value = 0
else
pla.leaderstats.Gold.Value = ((GoldNum-1763)/2.5)
end
end

