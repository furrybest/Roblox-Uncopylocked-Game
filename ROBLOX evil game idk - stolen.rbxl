										<ProtectedString name="Source">local green = script.Parent.Parent.Green.Value
local red = script.Parent.Parent.Red.Value
local grey = script.Parent.Parent.Grey.Value
local active = true
but = script.Parent.Parent

function buttonClicked()

--Change Colors
local ba = but.Parent:GetChildren()
for numy = 1, #ba do
if but.Parent:findFirstChild(&quot;sqr&quot;..numy).Text == &quot;N/A&quot; then
but.Parent:findFirstChild(&quot;sqr&quot;..numy).BackgroundColor3 = green
else
but.Parent:findFirstChild(&quot;sqr&quot;..numy).BackgroundColor3 = red
end 
end



local it = but.Parent.Parent.Backpack:GetChildren()
for num = 1, #it do
but.Parent.Parent.Backpack:findFirstChild(&quot;sqr&quot;..num).BackgroundColor3 = red
end







but.Parent.Parent.CurrentItem.Value = but.Text
but.Parent.Parent.CurrentItem.Backpack.Value = false
but.Parent.Parent.CurrentItem.SquareNum.Value = but.Name
but.move.Visible = false
but.remov.Visible = false
but.cancel.Visible = false
end

