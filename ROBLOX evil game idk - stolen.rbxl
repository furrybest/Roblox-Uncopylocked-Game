							<ProtectedString name="Source">onetime = false
function onTouched(hit)
if hit ~= nil then
if hit.Parent:findFirstChild(&quot;Humanoid&quot;) ~= nil then
if onetime == false then
onetime = true
game.Players:findFirstChild(hit.Parent.Name).leaderstats.Gold.Value = game.Players:findFirstChild(hit.Parent.Name).leaderstats.Gold.Value + 2
wait(.3)
script.Parent:remove()
end end end end

script.Parent.Touched:connect(onTouched)
