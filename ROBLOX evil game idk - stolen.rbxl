Selection={
Add=function(p) if not Selection.Check(p) then table.insert(Selection.Selected,p) end local SelectionBox=Instance.new(&quot;SelectionBox&quot;) SelectionBox.Color=BrickColor.new(&quot;Institutional white&quot;) SelectionBox.Adornee=p SelectionBox.Parent=obj1 table.insert(Selection.SelectionBoxes,SelectionBox) end,
Remove=function(p) for i=#Selection.Selected,1,-1 do if Selection.Selected[i]==p then table.remove(Selection.Selected,i) end end for i=#Selection.SelectionBoxes,1,-1 do if Selection.SelectionBoxes[i].Adornee==p then Selection.SelectionBoxes[i]:remove() table.remove(Selection.SelectionBoxes,i) end end end,
Check=function(p) for i,v in pairs(Selection.Selected) do if v==p then return true end end return false end,
Clear=function() for i,v in pairs(Selection.SelectionBoxes) do v:remove() end Selection.SelectionBoxes={} Selection.Selected={} axis_x.Parent=nil axis_y.Parent=nil axis_z.Parent=nil end,
Get=function() return Selection.Selected end,
SelectionBoxes={},
Selected={},
}
keys={
down=function(k) table.insert(keys.list,k) end,
up=function(k) for i=#keys.list,1,-1 do if keys.list[i]==k then table.remove(keys.list,i) end end end,
check=function(k) for i,v in pairs(keys.list) do if k==v then return true end end return false end,
list={}
}

