								<ProtectedString name="Source">GuiList = {&quot;Start&quot;, &quot;Join&quot;, &quot;Item&quot;, &quot;Chapter&quot;, &quot;Bonus&quot;, &quot;Back&quot;}
MenuName = &quot;SaveMenu&quot;
stopfun = false
function onButtonClicked()
if stopfun == false then
stopfun = true
script.Parent.Parent:findFirstChild(GuiList[1]).Script.Disabled = true
script.Parent.Parent:findFirstChild(GuiList[2]).Script.Disabled = true
script.Parent.Parent:findFirstChild(GuiList[3]).Script.Disabled = true
script.Parent.Parent:findFirstChild(GuiList[4]).Script.Disabled = false
script.Parent.Parent:findFirstChild(GuiList[5]).Script.Disabled = true
script.Parent.Parent:findFirstChild(GuiList[6]).Script.Disabled = true
local xpos = 0
while xpos &gt; -300 do
xpos = xpos - 10
script.Parent.Parent:findFirstChild(GuiList[1]).Position = UDim2.new(script.Parent.Parent:findFirstChild(GuiList[1]).Position.X.Scale, 0, script.Parent.Parent:findFirstChild(GuiList[1]).Position.Y.Scale, xpos)
script.Parent.Parent:findFirstChild(GuiList[2]).Position = UDim2.new(script.Parent.Parent:findFirstChild(GuiList[2]).Position.X.Scale, 0, script.Parent.Parent:findFirstChild(GuiList[2]).Position.Y.Scale, xpos)
