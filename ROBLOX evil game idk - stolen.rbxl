function computeDirection(vec)
&#9;local lenSquared = vec.magnitude * vec.magnitude
&#9;local invSqrt = 1 / math.sqrt(lenSquared)
&#9;return Vector3.new(vec.x * invSqrt, vec.y * invSqrt, vec.z * invSqrt)
end

function reloadTheGuns(wep, clipcap)
script.Parent.Reloading.Value = true
if script.Parent.CurrentWeapon.Ammo.Value &gt; (clipcap - script.Parent.CurrentWeapon.Clip.Value) then
if wep == &quot;M92F&quot; or wep == &quot;H&amp;K P8&quot; or wep == &quot;SIG P226&quot; or wep == &quot;M93R&quot; then
reloadHandgun()
script.Parent.Reloading.Value = false
elseif wep == &quot;Ithaca M37&quot; or wep == &quot;M3&quot; then
timesToReload = (clipcap - script.Parent.CurrentWeapon.Clip.Value)
while timesToReload &gt; 0 do
reloadShotgun1()
timesToReload = timesToReload - 1
end

script.Parent.Reloading.Value = false
elseif wep == &quot;Jail Breaker&quot; then
timesToReload = (clipcap - script.Parent.CurrentWeapon.Clip.Value)
while timesToReload &gt; 0 do
reloadShotgun1()
timesToReload = timesToReload - 1
end

script.Parent.Reloading.Value = false
elseif wep == &quot;Hydra&quot; then
timesToReload = (clipcap - script.Parent.CurrentWeapon.Clip.Value)
while timesToReload &gt; 0 do
reloadShotgun1()
timesToReload = timesToReload - 1
end

script.Parent.Reloading.Value = false
elseif wep == &quot;S75&quot; or wep == &quot;Dragunov SVD&quot; or wep == &quot;H&amp;K PSG-1&quot; then
reloadHandgun()
script.Parent.Reloading.Value = false
elseif wep == &quot;VZ61&quot; or wep == &quot;H&amp;K MP5&quot; or wep == &quot;AK-74&quot; or wep == &quot;SIG 556&quot; then
reloadHandgun()
script.Parent.Reloading.Value = false
elseif wep == &quot;S&amp;W M29&quot; or wep == &quot;L Hawk&quot; or wep == &quot;S&amp;W M500&quot; then
reloadHandgun()
script.Parent.Reloading.Value = false
elseif wep == &quot;Rocket Launcher&quot; then
RocketShot()
script.Parent.Reloading.Value = false
else
wait(2)
script.Parent.Reloading.Value = false
end
local gun = script.Parent.CurrentWeapon.Value
if script.Parent.CurrentWeapon.Value ~= gun then return end
script.Parent.CurrentWeapon.Ammo.Value = script.Parent.CurrentWeapon.Ammo.Value - (clipcap - script.Parent.CurrentWeapon.Clip.Value)
script.Parent.CurrentWeapon.Clip.Value = clipcap
game.Players:findFirstChild(script.Parent.Parent.Name).PlayerGui.Health.Tray.Ammo.Text = &quot;Ammo: &quot;..script.Parent.CurrentWeapon.Ammo.Value
game.Players:findFirstChild(script.Parent.Parent.Name).PlayerGui.Health.Tray.Clip.Text = &quot;Clip: &quot;..script.Parent.CurrentWeapon.Clip.Value

else
if wep == &quot;M92F&quot; or wep == &quot;H&amp;K P8&quot; or wep == &quot;SIG P226&quot; or wep == &quot;M93R&quot; then
reloadHandgun()
script.Parent.Reloading.Value = false
elseif wep == &quot;Ithaca M37&quot; or wep == &quot;M3&quot; then
reloadShotgun1()
script.Parent.Reloading.Value = false
elseif wep == &quot;Jail Breaker&quot; then
reloadShotgun2()
script.Parent.Reloading.Value = false
elseif wep == &quot;Hydra&quot; then
reloadShotgun3()
script.Parent.Reloading.Value = false
elseif wep == &quot;S75&quot; or wep == &quot;Dragunov SVD&quot; or wep == &quot;H&amp;K PSG-1&quot; then
reloadHandgun()
script.Parent.Reloading.Value = false
elseif wep == &quot;VZ61&quot; or wep == &quot;H&amp;K MP5&quot; or wep == &quot;AK-74&quot; or wep == &quot;SIG 556&quot; then
reloadHandgun()
script.Parent.Reloading.Value = false
elseif wep == &quot;S&amp;W M29&quot; or wep == &quot;L Hawk&quot; or wep == &quot;S&amp;W M500&quot; then
reloadHandgun()
script.Parent.Reloading.Value = false
elseif wep == &quot;Rocket Launcher&quot; then
RocketShot()
script.Parent.Reloading.Value = false
else
wait(2)
script.Parent.Reloading.Value = false
end
local gun = script.Parent.CurrentWeapon.Value
if script.Parent.CurrentWeapon.Value ~= gun then return end
script.Parent.CurrentWeapon.Clip.Value = (script.Parent.CurrentWeapon.Clip.Value + script.Parent.CurrentWeapon.Ammo.Value)
script.Parent.CurrentWeapon.Ammo.Value = 0
game.Players:findFirstChild(script.Parent.Parent.Name).PlayerGui.Health.Tray.Ammo.Text = &quot;Ammo: &quot;..script.Parent.CurrentWeapon.Ammo.Value
game.Players:findFirstChild(script.Parent.Parent.Name).PlayerGui.Health.Tray.Clip.Text = &quot;Clip: &quot;..script.Parent.CurrentWeapon.Clip.Value
end
end

