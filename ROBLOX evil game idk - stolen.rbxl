text=[[]]

function allowed(part)
if string.len(part.Name)&gt;=17 then
if string.sub(part.Name,1,16)==&quot;BlobbyblobBuild_&quot; then
p=string.sub(part.Name,17)
if game.Players.LocalPlayer:findFirstChild(&quot;BlobbyblobBuildToolStats&quot;) then
if game.Players.LocalPlayer.BlobbyblobBuildToolStats:findFirstChild(&quot;CanSave_&quot;..p) then
return true
end
end
end
end
if game.Players.LocalPlayer.Name==&quot;blobbyblob&quot; then return true end
return false
end

function recursive(root)
for count,a in pairs(root:GetChildren()) do
if (allowed(a) and (a:IsA(&quot;Part&quot;) or a:IsA(&quot;BlockMesh&quot;) or a:IsA(&quot;WedgePart&quot;) or a:IsA(&quot;TrussPart&quot;))) or (allowed(a.Parent) and a:IsA(&quot;DataModelMesh&quot;)) then
table.insert(gui_parts,a)
end
if #a:GetChildren()&gt;0 then recursive(a) end
end
end
recursive(workspace)
