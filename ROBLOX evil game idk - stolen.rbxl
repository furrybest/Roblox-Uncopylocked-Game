function onObj7Down(x,y)
if mode==&quot;Mode03&quot; then
if obj1:findFirstChild(&quot;ColorPicker&quot;)~=nil then
obj1.ColorPicker:remove()
end
local frame=Instance.new(&quot;Frame&quot;)
frame.Name=&quot;ColorPicker&quot;
frame.Size=UDim2.new(0,245,0,245)
frame.BackgroundColor3=Color3.new(.1,.1,.1)
frame.Position=UDim2.new(0,x,0,y-245-20)
frame.ZIndex=9
frame.Parent=obj1
color=0
for x_array=0,11,1 do
for y_array=0,11,1 do
while BrickColor.new(color).Name==&quot;Medium stone grey&quot; and color~=19 do
color=color+1
end
local imagebutton=Instance.new(&quot;ImageButton&quot;)
imagebutton.Size=UDim2.new(0,15,0,15)
imagebutton.Position=UDim2.new(0,x_array*20+5,0,y_array*20+5)
imagebutton.BackgroundColor3=BrickColor.new(color).Color
imagebutton.Parent=frame
imagebutton.ZIndex=9
imagebutton.MouseButton1Down:connect(function()
rememberColor=BrickColor.new(imagebutton.BackgroundColor3)
obj7.BackgroundColor3=rememberColor.Color
obj7.Text=rememberColor.Name
frame:remove()
end)
color=color+1
end
end

