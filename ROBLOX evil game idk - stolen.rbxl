local red = script.Parent.Parent.Red.Value
local grey = script.Parent.Parent.Grey.Value
local active = true
but = script.Parent.Parent

function buttonClicked()
if but.Parent.Parent.Backpack.sqr1.Text ~= &quot;N/A&quot; and but.Parent.Parent.Backpack.sqr2.Text ~= &quot;N/A&quot; and  but.Parent.Parent.Backpack.sqr3.Text ~= &quot;N/A&quot; and but.Parent.Parent.Backpack.sqr4.Text ~= &quot;N/A&quot; and  but.Parent.Parent.Backpack.sqr5.Text ~= &quot;N/A&quot; and  but.Parent.Parent.Backpack.sqr6.Text ~= &quot;N/A&quot; and  but.Parent.Parent.Backpack.sqr7.Text ~= &quot;N/A&quot; and  but.Parent.Parent.Backpack.sqr8.Text ~= &quot;N/A&quot; and but.Parent.Parent.Backpack.sqr9.Text ~= &quot;N/A&quot; then
but.move.Visible = false
but.remov.Visible = false
but.cancel.Visible = false
but.Parent.Parent.CurrentItem.MenuOpen.Value = false
return
end
--Change Colors






local ba = but.Parent:GetChildren()
for numy = 1, #ba do
but.Parent:findFirstChild(&quot;sqr&quot;..numy).BackgroundColor3 = red
end




local it = but.Parent.Parent.Backpack:GetChildren()
for num = 1, #it do
if but.Parent.Parent.Backpack:findFirstChild(&quot;sqr&quot;..num).Text == &quot;N/A&quot; then
but.Parent.Parent.Backpack:findFirstChild(&quot;sqr&quot;..num).BackgroundColor3 = green
else
but.Parent.Parent.Backpack:findFirstChild(&quot;sqr&quot;..num).BackgroundColor3 = red
end
end



