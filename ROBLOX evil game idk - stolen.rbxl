									<ProtectedString name="Source">local green = script.Parent.Green.Value
local red = script.Parent.Red.Value
local grey = script.Parent.Grey.Value
local active = true
but = script.Parent

function buttonClicked()
--Button active
if but.BackgroundColor3 == green then
but.Parent.Parent.CurrentItem.MenuOpen.Value = false
if but.Parent.Parent.CurrentItem.Backpack.Value == true then
script.Parent.Text = but.Parent.Parent.CurrentItem.Value
but.Parent.Parent.Backpack:findFirstChild(but.Parent.Parent.CurrentItem.SquareNum.Value).Text = &quot;N/A&quot;
else
script.Parent.Text = but.Parent.Parent.CurrentItem.Value
but.Parent.Parent.Items:findFirstChild(but.Parent.Parent.CurrentItem.SquareNum.Value).Text = &quot;N/A&quot;
end
--Change Colors
local ba = but.Parent:GetChildren()
for numy = 1, #ba do
but.Parent:findFirstChild(&quot;sqr&quot;..numy).BackgroundColor3 = grey
end

local it = but.Parent.Parent.Backpack:GetChildren()
for num = 1, #it do
but.Parent.Parent.Backpack:findFirstChild(&quot;sqr&quot;..num).BackgroundColor3 = grey
end
--Button not active
elseif but.BackgroundColor3 ~= red and but.Text ~= &quot;N/A&quot; and but.Parent.Parent.CurrentItem.MenuOpen.Value == false then
but.move.Visible = true
but.remov.Visible = true
but.cancel.Visible = true
but.Parent.Parent.CurrentItem.MenuOpen.Value = true
end
end

