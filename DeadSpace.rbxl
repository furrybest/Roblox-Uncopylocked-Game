					<string name="Name">Heal</string>
					<ProtectedString name="Source">while true do
wait()
if script.Parent.AOK.Value == true then
script.Parent.DS.MaxHealth = math.random(100, 200)
script.Parent.DS.Health = script.Parent.DS.MaxHealth
script:remove()
end
