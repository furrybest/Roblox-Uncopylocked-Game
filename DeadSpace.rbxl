&#9;&#9;&#9;Joint.C1 = CFrame.new(-0, 1, 0, -0, -0, -1, 0, 1, 0, 1, 0, 0)
&#9;&#9;&#9;Joint.Parent = Torso

&#9;&#9;&#9;local B = Instance.new(&quot;Part&quot;)
&#9;&#9;&#9;B.TopSurface = 0
&#9;&#9;&#9;B.BottomSurface = 0
&#9;&#9;&#9;B.formFactor = &quot;Symmetric&quot;
