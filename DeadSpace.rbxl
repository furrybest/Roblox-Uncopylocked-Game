			<Item class="LocalScript" referent="RBX9159">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">PaintballShooter</string>
					<ProtectedString name="Source">Tool = script.Parent



colors = {24,}



function fire(v)

&#9;script.Parent.OverheatV.Value = script.Parent.OverheatV.Value + 10

&#9;if Tool.Silenced.Value == false then
&#9;Tool.Handle.Fire:play()
&#9;elseif Tool.Silenced.Value == true then
&#9;Tool.Handle.SFire:play()
&#9;end
&#9;



&#9;local vCharacter = Tool.Parent

&#9;local vPlayer = game.Players:playerFromCharacter(vCharacter)



&#9;local missile = Instance.new(&quot;Part&quot;)



        



&#9;local spawnPos = script.Parent.Aim.Position

&#9;





&#9;spawnPos  = spawnPos + (v * 2.5)



&#9;missile.Position = spawnPos

&#9;missile.Size = Vector3.new(1,1,1)

&#9;missile.Velocity = v * 600

&#9;missile.BrickColor = BrickColor.new(26)

&#9;missile.Shape = 0

&#9;missile.BottomSurface = 0

&#9;missile.TopSurface = 0

&#9;missile.Name = &quot;Paintball&quot;

&#9;missile.Elasticity = 0

&#9;missile.Reflectance = .1

&#9;missile.CanCollide = true

&#9;missile.Friction = 0

&#9;me = script.Parent.ShotMesh:clone()
&#9;me.Parent = missile

&#9;local force = Instance.new(&quot;BodyForce&quot;)

&#9;force.force = Vector3.new(0,100,0)

&#9;force.Parent = missile

&#9;

&#9;Tool.BrickCleanup:clone().Parent = missile

&#9;Tool.Clean:clone().Parent = missile

&#9;Tool.Realism:clone().Parent = missile

&#9;Tool.Silenced:clone().Parent = missile

&#9;vf = Instance.new(&quot;ObjectValue&quot;)
&#9;vf.Parent = missile
&#9;vf.Name = &quot;Connector&quot;
&#9;vf.Value = script.Parent.Parent


&#9;local new_script = script.Parent.Paintball:clone()

&#9;new_script.Disabled = false

&#9;new_script.Gunner.Value = script.Parent

&#9;new_script.Parent = missile

&#9;new_script.Gunner.Value = script.Parent



&#9;local creator_tag = Instance.new(&quot;ObjectValue&quot;)

&#9;creator_tag.Value = vPlayer

&#9;creator_tag.Name = &quot;creator&quot;

&#9;creator_tag.Parent = missile

&#9;





&#9;missile.Parent = game.Workspace



end


function Cock()
script.Parent.Slider.Mesh.Offset = script.Parent.Slider.Mesh.Offset - Vector3.new(0,0.1,0)
script.Parent.Ring.Mesh.Offset = script.Parent.Ring.Mesh.Offset - Vector3.new(0,0.1,0)
wait(0.005)
script.Parent.Slider.Mesh.Offset = script.Parent.Slider.Mesh.Offset - Vector3.new(0,0.1,0)
script.Parent.Ring.Mesh.Offset = script.Parent.Ring.Mesh.Offset - Vector3.new(0,0.1,0)
wait(0.005)
script.Parent.Slider.Mesh.Offset = script.Parent.Slider.Mesh.Offset - Vector3.new(0,0.1,0)
script.Parent.Ring.Mesh.Offset = script.Parent.Ring.Mesh.Offset - Vector3.new(0,0.1,0)
pa = Instance.new(&quot;Part&quot;)
pa.Parent = game.Workspace
pa.BrickColor = BrickColor.new(24)
pa.formFactor = 0
pa.Size = Vector3.new(1,1,1)
pa.CFrame = script.Parent.Barrel.CFrame * CFrame.new(0.5,0,0)
mec = script.Parent.Shell:clone()
mec.Parent = pa
sc = script.Parent.Clean:clone()
sc.Disabled = false
sc.Parent = pa
wait(0.005)
script.Parent.Slider.Mesh.Offset = script.Parent.Slider.Mesh.Offset + Vector3.new(0,0.1,0)
script.Parent.Ring.Mesh.Offset = script.Parent.Ring.Mesh.Offset + Vector3.new(0,0.1,0)
wait(0.005)
script.Parent.Slider.Mesh.Offset = script.Parent.Slider.Mesh.Offset + Vector3.new(0,0.1,0)
script.Parent.Ring.Mesh.Offset = script.Parent.Ring.Mesh.Offset + Vector3.new(0,0.1,0)
wait(0.005)
script.Parent.Slider.Mesh.Offset = script.Parent.Slider.Mesh.Offset + Vector3.new(0,0.1,0)
script.Parent.Ring.Mesh.Offset = script.Parent.Ring.Mesh.Offset + Vector3.new(0,0.1,0)
end

function UnCock()
script.Parent.Slider.Mesh.Offset = script.Parent.Slider.Mesh.Offset - Vector3.new(0,0.1,0)
script.Parent.Ring.Mesh.Offset = script.Parent.Ring.Mesh.Offset - Vector3.new(0,0.1,0)
wait(0.01)
script.Parent.Slider.Mesh.Offset = script.Parent.Slider.Mesh.Offset - Vector3.new(0,0.1,0)
script.Parent.Ring.Mesh.Offset = script.Parent.Ring.Mesh.Offset - Vector3.new(0,0.1,0)
wait(0.01)
script.Parent.Slider.Mesh.Offset = script.Parent.Slider.Mesh.Offset - Vector3.new(0,0.1,0)
script.Parent.Ring.Mesh.Offset = script.Parent.Ring.Mesh.Offset - Vector3.new(0,0.1,0)
end


Tool.Enabled = true

function onActivated()

&#9;if script.Parent.Ammo.Value &gt; 0 and script.Parent.DisAble.Value == false then

&#9;if not Tool.Enabled then

&#9;&#9;return

&#9;end



&#9;Tool.Enabled = false

&#9;local character = Tool.Parent;

&#9;local humanoid = character.Humanoid

&#9;if humanoid == nil then

&#9;&#9;print(&quot;Humanoid not found&quot;)

&#9;&#9;return 

&#9;end


&#9;if script.Parent.Ammo.Value &gt; 1 then
&#9;script.Parent.Ammo.Value = script.Parent.Ammo.Value - 1
&#9;local targetPos = humanoid.TargetPoint
&#9;local lookAt = (targetPos - script.Parent.Aim.Position).unit
&#9;fire(lookAt)
&#9;Cock()
&#9;Tool.Enabled = true
&#9;elseif script.Parent.Ammo.Value == 1 then
&#9;script.Parent.Ammo.Value = script.Parent.Ammo.Value - 1
&#9;local targetPos = humanoid.TargetPoint
&#9;local lookAt = (targetPos - script.Parent.Aim.Position).unit
&#9;fire(lookAt)
&#9;UnCock()
&#9;Tool.Enabled = true
&#9;end
&#9;end

end





script.Parent.Activated:connect(onActivated)



</ProtectedString>
				</Properties>
			</Item>
			<Item class="LocalScript" referent="RBX9160">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Local Gui</string>
					<ProtectedString name="Source">local Tool = script.Parent
local arms = nil
local torso = nil
local weld33 = nil -- right arm
local weld55 = nil -- left arm
local welds = {}
enabled = true
