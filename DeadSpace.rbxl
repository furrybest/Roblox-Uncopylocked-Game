						<string name="Name">OnD</string>
						<ProtectedString name="Source">while true do
wait()
if script.Parent.Parent.DS.Health &lt; 1 then
script.Parent.HeartBeat.Volume = 0
script.Parent.HeartBeat:remove()
end
end
</ProtectedString>
					</Properties>
				</Item>
