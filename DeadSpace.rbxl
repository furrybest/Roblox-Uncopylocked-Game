							<string name="Name">Damage</string>
							<ProtectedString name="Source">deb = script.Debounce.Value

function animate(anim)
val = Instance.new(&quot;StringValue&quot;)
val.Name = &quot;toolanim&quot;
val.Parent = script.Parent
val.Value = anim
end

function damage(t,d,m)
t.Parent.Humanoid.Health = t.Parent.Humanoid.Health - 0
p = Instance.new(&quot;Part&quot;)
p.BrickColor = BrickColor.new(21)
p.Transparency = 0.5
p.Reflectance = 0
p.formFactor = script.Parent.Handle.formFactor
p.Shape = 1
p.FormFactor = 2
p.Size = Vector3.new(1,0.4,1)
p.TopSurface = 0
p.BottomSurface = 0
p.CanCollide = true
p.Anchored = false
p.Position = t.Position + Vector3.new(math.random(-10,10)/10,math.random(-10,10)/10,math.random(-10,10)/10)
p.Parent = game.Workspace
s = script.Remover:clone()
s.Disabled = false
s.Parent = p
if m == &quot;yes&quot; then
end
end

doit = false

function hit(touch)
if doit == true then
&#9;if touch.Parent ~= script.Parent.Parent then
&#9;if touch.Parent:FindFirstChild(&quot;Humanoid&quot;) ~= nil and script.Parent.Active.Value == true then
&#9;&#9;if deb == true then
&#9;&#9;deb = false
&#9;&#9;find = touch.Parent:FindFirstChild(&quot;BlueSteelClaws&quot;)
&#9;&#9;&#9;if find ~= nil then
&#9;&#9;&#9;&#9;if find.Blocking.Value == false then
&#9;&#9;&#9;&#9;damage(touch,18,&quot;no&quot;)
&#9;&#9;&#9;&#9;elseif find.Blocking.Value == true then
&#9;&#9;&#9;&#9;end&#9;
&#9;&#9;&#9;elseif find == nil then
&#9;&#9;&#9;&#9;damage(touch,18,&quot;no&quot;)&#9;
&#9;&#9;&#9;end
&#9;&#9;wait(0.1)
&#9;&#9;deb = true
&#9;&#9;end
&#9;elseif touch.Parent:FindFirstChild(&quot;Humanoid&quot;) ~= nil and script.Parent.RightActive.Value == true then
&#9;&#9;if deb == true then
&#9;&#9;deb = false
&#9;&#9;find = touch.Parent:FindFirstChild(&quot;BlueSteelClaws&quot;)
&#9;&#9;&#9;if find ~= nil then
&#9;&#9;&#9;&#9;if find.Blocking.Value == false then
&#9;&#9;&#9;&#9;damage(touch,40,&quot;no&quot;)
&#9;&#9;&#9;&#9;elseif find.Blocking.Value == true then
&#9;&#9;&#9;&#9;end&#9;
&#9;&#9;&#9;elseif find == nil then
&#9;&#9;&#9;&#9;damage(touch,40,&quot;no&quot;)&#9;
&#9;&#9;&#9;end
&#9;&#9;wait(0.1)
&#9;&#9;deb = true
&#9;&#9;end
&#9;elseif touch.Parent:FindFirstChild(&quot;Humanoid&quot;) ~= nil and script.Parent.ChargeActive.Value == true then
&#9;&#9;if deb == true then
&#9;&#9;deb = false
&#9;&#9;find = touch.Parent:FindFirstChild(&quot;BlueSteelClaws&quot;)
&#9;&#9;&#9;if find ~= nil then
&#9;&#9;&#9;&#9;if find.Blocking.Value == false then
&#9;&#9;&#9;&#9;damage(touch,30,&quot;no&quot;)
&#9;&#9;&#9;&#9;elseif find.Blocking.Value == true then
&#9;&#9;&#9;&#9;end&#9;
&#9;&#9;&#9;elseif find == nil then
&#9;&#9;&#9;&#9;damage(touch,30,&quot;no&quot;)&#9;
&#9;&#9;&#9;end
&#9;&#9;wait(0.1)
&#9;&#9;deb = true
&#9;&#9;end
&#9;end
&#9;end
end
end

script.Parent.Claw.Touched:connect(hit)
script.Parent.Claw2.Touched:connect(hit)</ProtectedString>
