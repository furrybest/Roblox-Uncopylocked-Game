				<Item class="Script" referent="RBX4867">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Find</string>
						<ProtectedString name="Source">while true do
wait()
a = game.Players:GetChildren()
for i =1, #a do
if a[i].Character ~= nil then
if a[i].Character:findFirstChild(&quot;Torso&quot;) ~= nil and a[i].Character:findFirstChild(&quot;Humanoid&quot;) ~= nil then
if a[i]:findFirstChild(&quot;db&quot;) == nil then
if (a[i].Character.Torso.Position - script.Parent.Position).magnitude &lt; 15 then
if a[i].PlayerGui:findFirstChild(&quot;Dark&quot;) == nil then
a[i].PlayerGui.SavePack.Downstairs.Value = true
gui = script.Parent.Parent.Dark:clone()
gui.Parent = a[i].PlayerGui
s = script.Parent.Amb:clone()
s.Parent = gui
s.Volume = 0.5
s:play()
cl = script.Parent.Clean:clone()
cl.Parent = a[i].Character
end
end
end
end
end
end
end
</ProtectedString>
					</Properties>
				</Item>
				<Item class="Script" referent="RBX4868">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Clean</string>
						<ProtectedString name="Source">while true do
wait()
if script.Parent:findFirstChild(&quot;Humanoid&quot;) ~= nil then
Player = game.Players:playerFromCharacter(script.Parent)
if script.Parent.Humanoid.Health &lt; 1 then
if Player.PlayerGui:findFirstChild(&quot;Dark&quot;) ~= nil then
if Player.PlayerGui.Dark:findFirstChild(&quot;Amb&quot;) ~= nil then 
Player.PlayerGui.Dark.Amb:stop()
Player.PlayerGui.Dark.Amb:remove()
end
end
end
end
end
</ProtectedString>
					</Properties>
				</Item>
