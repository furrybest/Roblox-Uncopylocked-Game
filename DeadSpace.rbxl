				<Item class="Script" referent="RBX4904">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Glow Script</string>
						<ProtectedString name="Source">while true do
&#9;for i=1, 9, 1 do
&#9;&#9;-- Go up
&#9;&#9;script.Parent.Reflectance = i * .1
&#9;&#9;wait(.1)
&#9;end
&#9;for i=9, 1, -1 do
&#9;&#9;-- Go down
&#9;&#9;script.Parent.Reflectance = i * .1
&#9;&#9;wait(.1)
&#9;end
end
</ProtectedString>
					</Properties>
				</Item>
