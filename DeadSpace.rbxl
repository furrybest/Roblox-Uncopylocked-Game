						<string name="Name">Emergency Eject</string>
						<ProtectedString name="Source">while true do
wait()
if script.Parent.Parent.Name == &quot;PlayerGui&quot; then
if script.Parent.Parent.Parent.Character ~= nil then
if script.Parent.Parent.Parent.Character.Humanoid.Health &lt; 1 then
