						<Item class="Script" referent="RBX11364">
							<Properties>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">Script</string>
								<ProtectedString name="Source">script.Finish.Smoke.Value = script.Parent.Gas
function onT(hit)
if hit ~= nil then
if hit.Parent.Name ~= script.Parent.Parent.Name and hit.Parent:findFirstChild(&quot;Humanoid&quot;) ~= nil and hit.Parent:findFirstChild(&quot;Finish&quot;) == nil then
if hit.Parent.Humanoid.Health &gt; 25 then
hit.Parent.Humanoid.Health = hit.Parent.Humanoid.Health - 25
script.Parent.Stab.Pitch = math.random(0.8, 1.2)
script.Parent.Stab:play()
playa = game.Players:playerFromCharacter(hit.Parent)
if playa.PlayerGui:findFirstChild(&quot;ScreenC&quot;) ~= nil then
randy = math.random(0,2)
if randy == 1 or randy == 2 then
gu = Instance.new(&quot;ImageLabel&quot;)
gu.Parent = playa.PlayerGui.ScreenC
gu.Size = UDim2.new(math.random(15,25)/100,0,math.random(15,25)/100,0)
gu.Position = UDim2.new(math.random(1,9)/10,0,math.random(1,9)/10,0)
gu.BackgroundTransparency = 1
randy2 = math.random(0,2)
if randy2 == 0 then
gu.Image = &quot;http://www.roblox.com/asset/?id=15579875&quot;
elseif randy2 == 1 then
gu.Image = &quot;http://www.roblox.com/asset/?id=15554130&quot;
elseif randy2 ==2 then
gu.Image = &quot;http://www.roblox.com/asset/?id=15553622&quot;
end
s = script.Clean:clone()
s.Disabled = false
s.Parent = gu
end
end
elseif hit.Parent.Humanoid.Health &lt; 26 and hit.Parent:findFirstChild(&quot;Finish&quot;) == nil and hit.Parent:findFirstChild(&quot;FAKE&quot;) == nil then
hit.Parent.Humanoid.Health = 1
fin = script.Finish:clone()
fin.Disabled = false
fin.Parent = hit.Parent
if string.sub(hit.Name, 1, 4) == &quot;Left&quot; or string.sub(hit.Name, 1, 5) == &quot;Right&quot; then
hit:BreakJoints()
end
end
end
end
end

script.Parent.Touched:connect(onT)

</ProtectedString>
							</Properties>
							<Item class="Script" referent="RBX11365">
								<Properties>
									<bool name="Disabled">false</bool>
									<Content name="LinkedSource"><null></null></Content>
									<string name="Name">Finish</string>
									<ProtectedString name="Source">db = true
while true do
wait()
if script.Parent:findFirstChild(&quot;Humanoid&quot;) ~= nil and db == true then
db = false
if script.Parent:findFirstChild(&quot;Health&quot;) ~= nil then
script.Parent.Health:remove()
end
script.Parent.Humanoid.Health = 0.1
script.Parent.Torso.Anchored = true
script.Parent.Humanoid.WalkSpeed = 0
script.Parent.Humanoid.Health = 0.1
if script.Parent:findFirstChild(&quot;FAKE&quot;) == nil then
e = script.Parent.Head:clone()
e.Parent = script.Parent
e.Position = script.Parent.Head.Position
e.Name = &quot;FAKE&quot;
end
a = script.Parent.Head:GetChildren()
for i = 1, #a do
a[i]:remove()
end
script.Parent.Head.Transparency = 1
h = script.Smoke.Value:clone()
h.Parent = e
h.Enabled = true
wait(2)
script.Parent.Torso.Anchored = false
script.Parent.Humanoid.Health = 0
script:remove()
end
end

</ProtectedString>
