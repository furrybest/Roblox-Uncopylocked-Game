						<Item class="Script" referent="RBX12568">
							<Properties>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">Cut</string>
								<ProtectedString name="Source">while true do
wait()
if script.Parent.Connect.Value &lt; 1 then
script.Parent:BreakJoints()
script.Parent.Parent.DS.Health = script.Parent.Parent.DS.Health - math.random(300,400)
script.Parent.S:play()
script.Parent.Blood.Enabled = true
wait(6)
script.Parent:remove()
end
end
</ProtectedString>
