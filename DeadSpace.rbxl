							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Flash</string>
							<ProtectedString name="Source">while true do
wait(0.1)
script.Parent.Text = &quot;REPEATEDLY CLICK TO BREAK INFECTOR&apos;S HOLD&quot;
wait(0.1)
script.Parent.Text = &quot;&quot;
