			<Item class="LocalScript" referent="RBX8764">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">SecurityCam</string>
					<ProtectedString name="Source">h = 0
db = true
while true do
wait()
if db == true then
db = false

x  = game.Workspace.CinematicGroup1.CinematicPerson1:GetChildren()
for n = 1, #x do
if x[n].className == &quot;Part&quot; then
x[n].Transparency = 0.5
end
end
x  = game.Workspace.CinematicGroup1.CinematicSlasher:GetChildren()
for n2 = 1, #x do
if x[n2].className == &quot;Part&quot; then
x[n2].Transparency = 0.5
end
end
x  = game.Workspace.CinematicGroup1.CinematicPerson2:GetChildren()
for n3 = 1, #x do
if x[n3].className == &quot;Part&quot; then
x[n3].Transparency = 0.5
end
end
x  = game.Workspace.CinematicGroup1.CinematicPerson1.CinematicShotgun:GetChildren()
for n4 = 1, #x do
if x[n4].className == &quot;Part&quot; then
x[n4].Transparency = 0.5
end
end
game.Workspace.CinematicGroup1.CinematicCover.Transparency = 0.5
game.Workspace.CinematicGroup1.CinematicPerson1.Head.NameTag.Words.Visible = true
game.Workspace.CinematicGroup1.CinematicPerson2.Head.NameTag.Words.Visible = true

script.Parent.Humanoid.WalkSpeed = 0
cam = game.Workspace.CurrentCamera
camc = cam:clone()
cam.CameraSubject = game.Workspace.Camera1.Lens
z = Instance.new(&quot;ObjectValue&quot;)
z.Parent = game.Players:playerFromCharacter(script.Parent).PlayerGui
z.Name = &quot;DS2&quot;
c = script.ScreenStatic:clone()
c.Parent = game.Players:playerFromCharacter(script.Parent).PlayerGui
c.Static.Visible = true
c.Dialogue.Visible = true
for l = 1, 10 do
c.Static.Image = &quot;http://www.roblox.com/asset/?id=9470950&quot;
wait(0.05)
c.Static.Image = &quot;http://www.roblox.com/asset/?id=9470965&quot;
wait(0.05)
cam.CoordinateFrame = CFrame.new(-505,1750,7.5) * CFrame.new(2.5,0,1)
end
c.Static.Image = &quot;http://www.roblox.com/asset/?id=28088116&quot;
words = &quot;Come on, Forsell! What are you doing?! We need to warn the others about the creature! It escaped into the air circulation vent!&quot;
sc = 0
for w = 1, #words do
wait(0.05)
sc = sc + 1
c.Dialogue.Text = &quot;Ryan: &quot;..string.sub(words, 1, sc)
end
wait(2)
words = &quot;Get out of here, Ryan. I&apos;m staying. Try to warn as many people as you can. Save as many as possible...&quot;
sc = 0
for w = 1, #words do
wait(0.05)
sc = sc + 1
c.Dialogue.Text = &quot;Forsell: &quot;..string.sub(words, 1, sc)
end
wait(2)
words = &quot;No! Your not being left behind! Come on, don&apos;t play hero! We can all make it out!&quot;
sc = 0
for w = 1, #words do
wait(0.05)
sc = sc + 1
c.Dialogue.Text = &quot;Ryan: &quot;..string.sub(words, 1, sc)
end
wait(2)
words = &quot;There&apos;s no way you&apos;ll be able to get everyone out in time if I don&apos;t distract it. I&apos;m the only one with a weapon in this whole sector.&quot;
sc = 0
for w = 1, #words do
wait(0.05)
sc = sc + 1
c.Dialogue.Text = &quot;Forsell: &quot;..string.sub(words, 1, sc)
end
wait(1)


for h = 1, 6 do
wait(0.05)
game.Workspace.CinematicGroup1.CinematicCover.CFrame = game.Workspace.CinematicGroup1.CinematicCover.CFrame * CFrame.new(0,2,0)
end

for m = 1, 14 do
wait(0.01)
a = game.Workspace.CinematicGroup1.CinematicSlasher:GetChildren() 
for i = 1, #a do 
if a[i].Name == &quot;Down&quot; then
a[i].CFrame = a[i].CFrame * CFrame.new(0,-0.75,0)
elseif a[i].Name == &quot;Foward&quot; then 
a[i].CFrame = a[i].CFrame * CFrame.new(-0.75,0,0) 
elseif a[i].Name == &quot;Backward&quot; then 
a[i].CFrame = a[i].CFrame * CFrame.new(0.75,0,0) 
end 
end
end
--10.5
c.CreepyAmb.Volume = 1
c.CreepyAmb:play()
for m2 = 1, 10 do
wait(0.01)
a = game.Workspace.CinematicGroup1.CinematicSlasher:GetChildren() 
for i = 1, #a do 
if a[i].Name == &quot;Down&quot; then
 a[i].CFrame = a[i].CFrame * CFrame.new(0,-0.75,0)
elseif a[i].Name == &quot;Foward&quot; then 
a[i].CFrame = a[i].CFrame * CFrame.new(-0.75,0,0) 
elseif a[i].Name == &quot;Backward&quot; then 
a[i].CFrame = a[i].CFrame * CFrame.new(0.75,0,0) 
end 
end
end
c.Moan.Volume = 1
c.Moan:play()
words = &quot;Oh my god.....Get outta here now! Lock the door on the other side! I&apos;ll hold it back as long as possible! COME ON, BRING IT FREAK!&quot;
sc = 0
for w = 1, #words do
wait(0.05)
sc = sc + 1
c.Dialogue.Text = &quot;Forsell: &quot;..string.sub(words, 1, sc)
end

for v = 1, 4 do
wait(0.05)
game.Workspace.CinematicGroup1.CinematicPerson1.RightArm.CFrame = game.Workspace.CinematicGroup1.CinematicPerson1.RightArm.CFrame * CFrame.new(0,0.25,0)
end

for v2 = 1, 4 do
wait(0.05)
game.Workspace.CinematicGroup1.CinematicPerson1.RightArm.CFrame = game.Workspace.CinematicGroup1.CinematicPerson1.RightArm.CFrame * CFrame.new(0,-0.25,0)
end

wait(1)
for l = 1, 10 do
wait(0.05)
c.Static.Image = &quot;http://www.roblox.com/asset/?id=9470950&quot;
wait(0.05)
c.Static.Image = &quot;http://www.roblox.com/asset/?id=9470965&quot;
end
c.Moan.Volume = 0
c.CreepyAmb.Volume = 0



x  = game.Workspace.CinematicGroup1.CinematicPerson1:GetChildren()
for n = 1, #x do
if x[n].className == &quot;Part&quot; then
x[n].Transparency = 1
end
end
x  = game.Workspace.CinematicGroup1.CinematicPerson1.CinematicShotgun:GetChildren()
for n4 = 1, #x do
if x[n4].className == &quot;Part&quot; then
x[n4].Transparency = 1
end
end
x  = game.Workspace.CinematicGroup1.CinematicSlasher:GetChildren()
for n2 = 1, #x do
if x[n2].className == &quot;Part&quot; then
x[n2].Transparency = 1
end
end
x  = game.Workspace.CinematicGroup1.CinematicPerson2:GetChildren()
for n3 = 1, #x do
if x[n3].className == &quot;Part&quot; then
x[n3].Transparency = 1
end
end
game.Workspace.CinematicGroup1.CinematicCover.Transparency = 1
game.Workspace.CinematicGroup1.CinematicPerson1.Head.NameTag.Words.Visible = false
game.Workspace.CinematicGroup1.CinematicPerson2.Head.NameTag.Words.Visible = false

a = game.Workspace.CinematicGroup1.CinematicSlasher:GetChildren() 
for i = 1, #a do 
if a[i].Name == &quot;Down&quot; then
 a[i].CFrame = a[i].CFrame * CFrame.new(0,18,0)
elseif a[i].Name == &quot;Foward&quot; then 
a[i].CFrame = a[i].CFrame * CFrame.new(18,0,0) 
elseif a[i].Name == &quot;Backward&quot; then 
a[i].CFrame = a[i].CFrame * CFrame.new(-18,0,0) 
end 
end
game.Workspace.CinematicGroup1.CinematicCover.CFrame = game.Workspace.CinematicGroup1.CinematicCover.CFrame * CFrame.new(0,-12,0)




c:remove()
script.Parent.Humanoid.WalkSpeed = 16
camc.Parent = game.Workspace
camc.CameraSubject = script.Parent
camc.CameraType = &quot;Follow&quot;
cam:remove()
z:remove()
script.Main.Value.On.Value = false
script.Main.Value.Player.Value = nil
script:remove()
end
end
</ProtectedString>
