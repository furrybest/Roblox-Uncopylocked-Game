						<string name="Name">Script</string>
						<ProtectedString name="Source">function doit()
ww = Instance.new(&quot;Weld&quot;)
ww.Parent = script.Parent.Parent.FTorso
ww.Part0 = script.Parent
ww.Part1 = script.Parent.Parent.FTorso
ww.C0 = CFrame.new(0, -0.9, 0) * CFrame.fromEulerAnglesXYZ(0.2,0,0.15)
end

doit()
</ProtectedString>
