							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Ouch</string>
							<ProtectedString name="Source">while true do
wait()
if script.Parent.Weaken.Value == true then
if script.Parent.Parent.Parent:findFirstChild(&quot;Humanoid&quot;) ~= nil then
script.Parent.Parent.Parent.Humanoid.Health = script.Parent.Parent.Parent.Humanoid.Health - math.random(1,2)
script.Parent.Parent.Parent.Humanoid.WalkSpeed = 8
wait(0.3)
end
end
end
</ProtectedString>
