				<Item class="Script" referent="RBX10664">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Buzz</string>
						<ProtectedString name="Source">function onT(hit)
if script.Parent.On.Value == true and hit.Name ~= &quot;RipBlade&quot; and hit.Name ~= &quot;Blood&quot; and hit.Parent ~= script.Parent.Parent.Parent then
if hit.Parent.Name ~= &quot;Ripper&quot; and hit.Name ~= &quot;RipBlade&quot; and hit.Parent.Name ~= script.Parent.Parent.Creator.Value and hit.Parent.Parent.Name ~= script.Parent.Parent.Creator.Value then
script.Parent.Parent.Handle.Rip:play()
end
if hit.Parent:findFirstChild(&quot;DS&quot;) ~= nil and hit.Name ~= &quot;RipBlade&quot; then
hit.Parent:findFirstChild(&quot;DS&quot;).Health = hit.Parent:findFirstChild(&quot;DS&quot;).Health - math.random(79, 95)
script.Parent.Parent.Handle.Rip.Pitch = math.random(1.3, 1.5)
par = Instance.new(&quot;Part&quot;)
par.Parent = game.Workspace
par.Shape = 0
par.Size = Vector3.new(1,1,1)
par.TopSurface = 0
par.BottomSurface = 0
par.Name = &quot;Blood&quot;
par.BrickColor = BrickColor.new(21)
par.Position = script.Parent.Position
par.CanCollide = false
velo = Vector3.new(math.random(-1, 1), math.random(-1, 1), math.random(-1, 1))
par.Velocity = 10 * velo
&#9;if hit.Parent:findFirstChild(&quot;GiveExp&quot;) ~= nil then
&#9;player = game.Players:playerFromCharacter(script.Parent.Parent.Parent)
&#9;if player.Level.Value &lt; 20 then
&#9;if hit.Parent.DS.Health &lt; 1 then
&#9;player.EXP.Value = player.EXP.Value - hit.Parent.GiveExp.Value
&#9;hit.Parent.GiveExp:remove()
&#9;elseif hit.Parent.DS.Health &gt; 0 then
&#9;player.EXP.Value = player.EXP.Value - 1
&#9;end
&#9;end
&#9;end
end
if hit.Name == &quot;Right Arm&quot; or hit.Name == &quot;Left Arm&quot; or hit.Name == &quot;Right Leg&quot; or hit.Name == &quot;Left Leg&quot; then
script.Parent.Parent.Handle.Rip.Pitch = math.random(1.3, 1.5)
wait(0.05)
hit:BreakJoints()
end
end
end

script.Parent.Touched:connect(onT)
</ProtectedString>
