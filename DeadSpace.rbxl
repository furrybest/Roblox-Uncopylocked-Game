					<Item class="Script" referent="RBX11709">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">WELD</string>
							<ProtectedString name="Source">function stick(hit)&#9;
&#9;print(&quot;Crap&quot;)
&#9;self = script.Parent.Torso
&#9;weld = Instance.new(&quot;Weld&quot;)
&#9;weld.Part0 = script.Parent.Torso
&#9;weld.Part1 = hit
&#9;local HitPos = self.Position
&#9;local CJ = CFrame.new(HitPos)
&#9;local C0 = self.CFrame:inverse() *CJ
&#9;local C1 = hit.CFrame:inverse() * CJ
&#9;weld.C0 = C0
&#9;weld.C1 = C1
&#9;weld.Parent = self
end


function stick1(hit)&#9;
&#9;print(&quot;Crap&quot;)
&#9;self = script.Parent.Torso
&#9;weld = Instance.new(&quot;Weld&quot;)
&#9;weld.Part0 = script.Parent.Torso
&#9;weld.Part1 = hit
&#9;local HitPos = self.Position
&#9;local CJ = CFrame.new(HitPos)
&#9;local C0 = self.CFrame:inverse() *CJ
&#9;local C1 = hit.CFrame:inverse() * CJ
&#9;weld.C0 = C0
&#9;weld.C1 = C1
&#9;weld.Parent = self
&#9;weld.C0 = CFrame.new(0,1.7,4) * CFrame.fromEulerAnglesXYZ(-0.8,0,0)
&#9;weld.Name = &quot;Tail&quot;
end


function stick2(hit)&#9;
&#9;print(&quot;Crap&quot;)
&#9;self = script.Parent.Torso
&#9;weld = Instance.new(&quot;Weld&quot;)
&#9;weld.Part0 = script.Parent.Torso
&#9;weld.Part1 = hit
&#9;local HitPos = self.Position
&#9;local CJ = CFrame.new(HitPos)
&#9;local C0 = self.CFrame:inverse() *CJ
&#9;local C1 = hit.CFrame:inverse() * CJ
&#9;weld.C0 = C0
&#9;weld.C1 = C1
&#9;weld.Parent = self
&#9;weld.C0 = CFrame.new(0,1.1,2.7) * CFrame.fromEulerAnglesXYZ(-0.8,0,0)
&#9;weld.Name = &quot;Sting&quot;
end



function weld()
a = script.Parent:GetChildren()
for  i = 1, #a do
if a[i].className == &quot;Part&quot; or a[i].className == &quot;Wedge&quot; then
if a[i].Name == &quot;Tail&quot; then
stick1(a[i])
elseif a[i].Name == &quot;Sting&quot; then
stick2(a[i])
else
stick(a[i])
end
end
end
end

weld()</ProtectedString>
