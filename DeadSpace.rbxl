						<ProtectedString name="Source">while true do
wait()
if script.Parent.AOK.Value == true then
wait(math.random(20,30))
script.Parent.DS.WalkSpeed = 0
wait(math.random(1,10)/10)
script.Parent.Torso.Velocity = Vector3.new(0,40,0)
script.Parent.DS.WalkSpeed = 35
wait(math.random(10,20)/10)
script.Parent.DS.WalkSpeed = 19
end
end

</ProtectedString>
