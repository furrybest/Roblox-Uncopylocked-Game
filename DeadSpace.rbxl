				<Item class="LocalScript" referent="RBX10725">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Main</string>
						<ProtectedString name="Source">plyr = nil
deb = true
deb2 = true
deb3 = true
deb4 = true
click = 0
waiting = false
blocking = false
target = nil

function animate(anim)
val = Instance.new(&quot;StringValue&quot;)
val.Name = &quot;toolanim&quot;
val.Parent = script.Parent
val.Value = anim
end

script.Parent.ChildRemoved:connect(function(c)
&#9;if c.className == &quot;StringValue&quot; and script.Parent.Blocking.Value == true then
&#9;&#9;if c.Value == &quot;Block&quot; then
&#9;&#9;animate(&quot;Block&quot;)&#9;
&#9;&#9;end
&#9;elseif c.className == &quot;StringValue&quot; and script.Parent.FinalActive.Value == true then
&#9;&#9;if c.Value == &quot;Ready&quot; then
&#9;&#9;animate(&quot;Ready&quot;)
&#9;&#9;end&#9;&#9;
&#9;end
end)

dber = true

script.Parent.Equipped:connect(function(mouse)
&#9;plyr = script.Parent.Parent
&#9;un = script.Parent:GetChildren()
&#9;for an = 1, #un do
&#9;if un[an].className == &quot;Part&quot; then
&#9;un[an].Anchored = false
&#9;end
&#9;end
&#9;pl = plyr:GetChildren()
&#9;for p = 1, #pl do
&#9;if pl[p].className == &quot;Humanoid&quot; and dber == true then
&#9;dber = false
&#9;CurHumanoid = pl[p]
&#9;end
&#9;end
&#9;dber = true
&#9;script.Parent.Parent.Torso[&quot;Left Shoulder&quot;].C1 = CFrame.new(0.4, 0.5, 0, -0, -0, -1, 0, 1, 0, 1, 0, 0) * CFrame.fromEulerAnglesXYZ(math.pi/16,0,0)
&#9;script.Parent.Parent.Torso[&quot;Right Shoulder&quot;].C1 = CFrame.new(-0.4, 0.5, 0, 0, 0, 1, 0, 1, 0, -1, -0, -0) * CFrame.fromEulerAnglesXYZ(math.pi/16,0,0)
&#9;if script.Parent.Parent:FindFirstChild(&quot;Animate&quot;) ~= nil then
&#9;script.Parent.Parent.Animate:remove()
&#9;anim = script.Animate2:clone()
&#9;anim.Disabled = false
&#9;anim.Parent = script.Parent.Parent
&#9;end
mouse.KeyDown:connect(function(key)
if script.Parent.Parent:FindFirstChild(&quot;Sabled&quot;) == nil then
if key == &quot;f&quot; and deb == true then
deb = false
script.Parent.Parent.Torso[&quot;Right Shoulder&quot;].C1 = CFrame.new(-0, 0.5, 0.5, 0, 0, 1, 0, 1, 0, -1, -0, -0) * CFrame.fromEulerAnglesXYZ(0,math.pi/2,0)
script.Parent.RightActive.Value = true
animate(&quot;RightUSlash&quot;)
wait(0.35)
script.Parent.Parent.Torso[&quot;Right Shoulder&quot;].C1 = CFrame.new(-0.4, 0.5, 0, 0, 0, 1, 0, 1, 0, -1, -0, -0) * CFrame.fromEulerAnglesXYZ(math.pi/16,0,0)
wait(0.15)
script.Parent.RightActive.Value = false
wait(0.5)
deb = true
elseif key == &quot;r&quot; and deb == true and deb2 == true then
deb = false
deb2 = false
animate(&quot;SpinSlash&quot;)
script.Parent.Active.Value = true
spin = Instance.new(&quot;BodyAngularVelocity&quot;)
spin.maxTorque = Vector3.new(0,9e+009,0)
spin.angularvelocity = Vector3.new(0,250,0)
spin.Parent = script.Parent.Parent.Torso
CurHumanoid.WalkSpeed = 0
wait(0.75)
CurHumanoid.WalkSpeed = 16
script.Parent.Active.Value = false
spin:remove()
wait(0.5)
deb = true
wait(3)
deb2 = true
elseif key == &quot;c&quot; and deb == true and deb3 == true then
deb = false
deb3 = false
CurHumanoid.WalkSpeed = 50
animate(&quot;Stab&quot;)
script.Parent.ChargeActive.Value = true
script.Parent.Parent.Torso[&quot;Left Shoulder&quot;].C1 = CFrame.new(0.4, 0.5, 0, -0, -0, -1, 0, 1, 0, 1, 0, 0) * CFrame.fromEulerAnglesXYZ(0,0,0)
