						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">function open()
if script.Parent.Parent.Mode.Value == true and script.Parent.Parent.db.Value == true then
script.Parent.Parent.db.Value = false
script.Parent.Parent.Door.Mesh.Scale = Vector3.new(1,0,1)
for i = 1, 100 do
wait(0.002)
script.Parent.Parent.Door.Mesh.Scale = script.Parent.Parent.Door.Mesh.Scale + Vector3.new(0,0.005,0)
script.Parent.Parent.Door.Mesh.Offset = script.Parent.Parent.Door.Mesh.Offset - Vector3.new(0,script.Parent.Parent.Door.Size.y/400,0)
end
script.Parent.Parent.Door.CanCollide = true
for ie = 1, 100 do
wait(0.002)
script.Parent.Parent.Door.Mesh.Scale = script.Parent.Parent.Door.Mesh.Scale + Vector3.new(0,0.005,0)
script.Parent.Parent.Door.Mesh.Offset = script.Parent.Parent.Door.Mesh.Offset - Vector3.new(0,script.Parent.Parent.Door.Size.y/400,0)
end
script.Parent.Parent.Mode.Value = false
script.Parent.Parent.db.Value = true
elseif script.Parent.Parent.Mode.Value == false and script.Parent.Parent.db.Value == true then
script.Parent.Parent.db.Value = false
for i2 = 1, 100 do
wait(0.002)
script.Parent.Parent.Door.Mesh.Scale = script.Parent.Parent.Door.Mesh.Scale - Vector3.new(0,0.005,0)
script.Parent.Parent.Door.Mesh.Offset = script.Parent.Parent.Door.Mesh.Offset + Vector3.new(0,script.Parent.Parent.Door.Size.y/400,0)
end
script.Parent.Parent.Door.CanCollide = false
for ie2 = 1, 100 do
wait(0.002)
script.Parent.Parent.Door.Mesh.Scale = script.Parent.Parent.Door.Mesh.Scale - Vector3.new(0,0.005,0)
script.Parent.Parent.Door.Mesh.Offset = script.Parent.Parent.Door.Mesh.Offset + Vector3.new(0,script.Parent.Parent.Door.Size.y/400,0)
end
script.Parent.Parent.Door.Mesh.Scale = Vector3.new(0,0,0)
script.Parent.Parent.Mode.Value = true
script.Parent.Parent.db.Value = true
end
end

script.Parent.ClickDetector.mouseClick:connect(open)</ProtectedString>
