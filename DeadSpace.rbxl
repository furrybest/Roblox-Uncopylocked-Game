while true do
wait()
if script.Parent.AOK.Value == true then
if script.Parent.StomachBurst.Value == true and db == true then
db = false
for i = 1, 8 do
wait(0.1)
script.Parent.Stomach.Meshy.Scale = script.Parent.Stomach.Meshy.Scale - Vector3.new(0.05,0.05,0.05)
end
for k = 1, math.random(2,4) do
c = game.Lighting.Necro.Swarm:clone()
c.Parent = game.Workspace
c:MoveTo(script.Parent.Stomach.Position)
hum = Instance.new(&quot;Humanoid&quot;)
hum.Name = &quot;DS&quot;
hum.Parent = c
c.AOK.Value = true
hum.Health = hum.MaxHealth
u = c:GetChildren()
for l = 1, #u do
if u[l].className == &quot;Part&quot; then
u[l].Anchored = false
end
end
end
for i2 = 1, 8 do
wait(0.1)
script.Parent.Stomach.Meshy.Scale = script.Parent.Stomach.Meshy.Scale - Vector3.new(0.05,0.02,0.05)
end
script.Parent.Stomach:remove()
end
end
end

