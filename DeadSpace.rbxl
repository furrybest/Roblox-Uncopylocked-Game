			<Item class="Script" referent="RBX1906">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<ProtectedString name="Source">wait(10)
while true do
wait()
ver = 1
for multi = 1, 3 do
wait(1)
r = math.random(0,25)
r2 = math.random(1,6)
CurrentNecro = script:findFirstChild(&quot;CurrentNecro&quot;..ver)
spot = script.Parent:findFirstChild(&quot;Bricks&quot;..r2).Door
if r == 0 or r == 2 or r == 3 then
c = game.Lighting.Necro.Slasher:clone()
c:MakeJoints()
c.Parent = game.Workspace
c:MakeJoints()
c:MoveTo(spot.Position)
c:MakeJoints()
CurrentNecro.Value = c
ver = ver + 1
wait(1)
hum = script.Parent.DS:clone()
hum.Health = 100
hum.Parent = c
c.AOK.Value = true
elseif r == 4 or r == 5 or r == 6 then
c = game.Lighting.Necro.ASlasher:clone()
c:MakeJoints()
c.Parent = game.Workspace
c:MakeJoints()
c:MoveTo(spot.Position)
c:MakeJoints()
CurrentNecro.Value = c
ver = ver + 1
hum = script.Parent.DS:clone()
hum.Health = 100
hum.Parent = c
c.AOK.Value = true
elseif r == 7 or r == 8 or r == 9 then
c = game.Lighting.Necro.Infector:clone()
c:MakeJoints()
c.Parent = game.Workspace
c:MakeJoints()
c:MoveTo(spot.Position)
c:MakeJoints()
CurrentNecro.Value = c
ver = ver + 1
hum = script.Parent.DS:clone()
hum.Health = 100
hum.Parent = c
c.AOK.Value = true
elseif r == 10 or r == 11 or r == 12 then
c = game.Lighting.Necro.Crawler:clone()
c:MakeJoints()
c.Parent = game.Workspace
c:MakeJoints()
c:MoveTo(spot.Position)
c:MakeJoints()
CurrentNecro.Value = c
ver = ver + 1
hum = script.Parent.DS:clone()
hum.Health = 100
hum.Parent = c
c.AOK.Value = true
elseif r == 13 or r == 14 or r == 15 then
c = game.Lighting.Necro.PregnantSlasherC:clone()
c:MakeJoints()
c.Parent = game.Workspace
c:MakeJoints()
c:MoveTo(spot.Position)
c:MakeJoints()
CurrentNecro.Value = c
ver = ver + 1
hum = script.Parent.DS:clone()
hum.Health = 100
hum.Parent = c
c.AOK.Value = true
elseif r == 16 or r == 17 or r == 18 then
model = Instance.new(&quot;Model&quot;)
model.Parent = game.Workspace
model.Name = &quot;SwarmHold&quot;
CurrentNecro.Value = model
for l = 1, math.random(2,3) do
c = game.Lighting.Necro.Swarm:clone()
c:MakeJoints()
c.Parent = model
c:MakeJoints()
c:MoveTo(spot.Position)
c:MakeJoints()
hum = script.Parent.DS:clone()
hum.Health = 100
hum.Parent = c
c.AOK.Value = true
end
ver = ver + 1
elseif r == 19 or r == 20 or r == 21 then
c = game.Lighting.Necro.PregnantSlasherS:clone()
c:MakeJoints()
c.Parent = game.Workspace
c:MakeJoints()
c:MoveTo(spot.Position)
c:MakeJoints()
CurrentNecro.Value = c
ver = ver + 1
hum = script.Parent.DS:clone()
hum.Health = 100
hum.Parent = c
c.AOK.Value = true
elseif r == 22 or r == 23 or r == 24 then
c = game.Lighting.Necro.Stinger:clone()
c:MakeJoints()
c.Parent = game.Workspace
c:MakeJoints()
c:MoveTo(spot.Position)
c:MakeJoints()
CurrentNecro.Value = c
ver = ver + 1
hum = script.Parent.DS:clone()
hum.Health = 100
hum.Parent = c
c.AOK.Value = true
elseif r == 25 then
c = game.Lighting.Necro.SuperSlasher:clone()
c:MakeJoints()
c.Parent = game.Workspace
c:MakeJoints()
c:MoveTo(spot.Position)
c:MakeJoints()
CurrentNecro.Value = c
ver = ver + 1
hum = script.Parent.DS:clone()
hum.Health = 100
hum.Parent = c
c.AOK.Value = true
end
end
wait(math.random(50,80))
a22 = game.Players:GetChildren()
for i22 = 1, #a22 do
if a22[i22].Character ~= nil then
if a22[i22].PlayerGui:findFirstChild(&quot;Dark&quot;) ~= nil and a22[i22].Character:findFirstChild(&quot;Head&quot;) ~= nil then
a22[i22].Character.Head.Anchored = true
a22[i22].PlayerGui.Dark.Frame.BackgroundTransparency = 0
end
end
end
wait(0.5)
if script.CurrentNecro1.Value ~= nil then
script.CurrentNecro1.Value:remove()
end
if script.CurrentNecro2.Value ~= nil then
script.CurrentNecro2.Value:remove()
end
if script.CurrentNecro3.Value ~= nil then
script.CurrentNecro3.Value:remove()
end
wait(0.5)
a23 = game.Players:GetChildren()
for i23 = 1, #a23 do
if a23[i23].Character ~= nil then
if a23[i23].PlayerGui:findFirstChild(&quot;Dark&quot;) ~= nil and a23[i23].Character:findFirstChild(&quot;Head&quot;) ~= nil then
a23[i23].Character.Head.Anchored = false
a23[i23].PlayerGui.Dark.Frame.BackgroundTransparency = 0.3
end
end
end
wait(math.random(5,19))
end
</ProtectedString>
