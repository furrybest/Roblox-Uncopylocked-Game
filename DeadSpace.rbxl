				<Item class="Script" referent="RBX10603">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Attack</string>
						<ProtectedString name="Source">close = false
while true do
wait()
a = game.Players:GetChildren()
for i = 1, #a do
if a[i].Character ~= nil and script.Parent.AOK.Value == true then
if a[i].Character:findFirstChild(&quot;Torso&quot;) ~= nil and a[i].Character:findFirstChild(&quot;Humanoid&quot;) ~= nil then
if (a[i].Character.Torso.Position - script.Parent.Torso.Position).magnitude &lt; 6 and a[i].Character.Humanoid.Health &gt; 0 then
close = true
end
end
end
end

if close == true then
script.Parent.Torso.Sting.C0 = CFrame.new(0,1.1,2.7) * CFrame.fromEulerAnglesXYZ(-0.8,0,0)
script.Parent.Torso.Tail.C0 = CFrame.new(0,1.7,4) * CFrame.fromEulerAnglesXYZ(-0.8,0,0)
wait(0.05)
script.Parent.Torso.Sting.C0 = CFrame.new(0,1.1,2.4) * CFrame.fromEulerAnglesXYZ(-0.85,0,0)
script.Parent.Torso.Tail.C0 = CFrame.new(0,2.2,3.85) * CFrame.fromEulerAnglesXYZ(-1,0,0)
wait(0.05)
script.Parent.Torso.Sting.C0 = CFrame.new(0,0.8,2) * CFrame.fromEulerAnglesXYZ(-0.8,0,0)
script.Parent.Torso.Tail.C0 = CFrame.new(0,2.4,3.7) * CFrame.fromEulerAnglesXYZ(-1.1,0,0)
wait(0.05)
script.Parent.Torso.Sting.C0 = CFrame.new(0,0.5,1.5) * CFrame.fromEulerAnglesXYZ(-0.7,0,0)
script.Parent.Torso.Tail.C0 = CFrame.new(0,2.8,3.55) * CFrame.fromEulerAnglesXYZ(-1.2,0,0)
wait(0.05)
script.Parent.Torso.Sting.C0 = CFrame.new(0,0.8,2) * CFrame.fromEulerAnglesXYZ(-0.8,0,0)
script.Parent.Torso.Tail.C0 = CFrame.new(0,2.4,3.7) * CFrame.fromEulerAnglesXYZ(-1.1,0,0)
wait(0.05)
script.Parent.Torso.Sting.C0 = CFrame.new(0,1.1,2.4) * CFrame.fromEulerAnglesXYZ(-0.85,0,0)
script.Parent.Torso.Tail.C0 = CFrame.new(0,2.2,3.85) * CFrame.fromEulerAnglesXYZ(-1,0,0)
wait(0.05)
script.Parent.Torso.Sting.C0 = CFrame.new(0,1.1,2.7) * CFrame.fromEulerAnglesXYZ(-0.8,0,0)
script.Parent.Torso.Tail.C0 = CFrame.new(0,1.7,4) * CFrame.fromEulerAnglesXYZ(-0.8,0,0)
wait(0.05)
close = false
end
end
</ProtectedString>
					</Properties>
				</Item>
			</Item>
