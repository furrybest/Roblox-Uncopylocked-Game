			<Item class="StringValue" referent="RBX9471">
				<Properties>
					<string name="Name">Log6M3</string>
					<string name="Value">Head of Technology Researchers, Janette Rede</string>
				</Properties>
			</Item>
			<Item class="StringValue" referent="RBX9472">
				<Properties>
					<string name="Name">Log1M2</string>
					<string name="Value">I don&apos;t know how they expect to control these creatures. The only thing &apos;the Creatures&apos; want seems to people...dead or otherwise...</string>
				</Properties>
			</Item>
			<Item class="StringValue" referent="RBX9473">
				<Properties>
					<string name="Name">Log1M3</string>
					<string name="Value">Medlab Worker, Joshua Roberts</string>
				</Properties>
			</Item>
			<Item class="TextButton" referent="RBX9474">
