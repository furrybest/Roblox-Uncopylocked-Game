								<ProtectedString name="Source">script.Finish.Smoke.Value = script.Parent.Gas
function t(hit)
if hit.Parent:findFirstChild(&quot;Humanoid&quot;) ~= nil and hit.Parent:findFirstChild(&quot;Finish&quot;) == nil then
if hit.Parent.Humanoid.Health &gt; 5 and hit.Parent:findFirstChild(&quot;INFECTORHOLD&quot;) == nil and hit.Parent:findFirstChild(&quot;CRAWLERHOLD&quot;) == nil then
hit.Parent.Humanoid.Health = hit.Parent.Humanoid.Health - math.random(3,5)
elseif hit.Parent.Humanoid.Health &lt; 6 and hit.Parent:findFirstChild(&quot;Finish&quot;) == nil and hit.Parent:findFirstChild(&quot;FAKE&quot;) == nil then
hit.Parent.Humanoid.Health = 1
fin = script.Finish:clone()
fin.Disabled = false
fin.Parent = hit.Parent
end
end
end

script.Parent.Touched:connect(t)</ProtectedString>
