			<Item class="Script" referent="RBX9501">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">KeepLogs</string>
					<ProtectedString name="Source">while true do
wait()
if script.Parent.Parent.Parent:findFirstChild(&quot;Log1PV&quot;) == nil then
p1 = Instance.new(&quot;BoolValue&quot;)
p1.Name = &quot;Log1PV&quot;
p1.Parent = script.Parent.Parent.Parent
p2 = p1:clone()
p2.Parent = script.Parent.Parent.Parent
p2.Name = &quot;Log2PV&quot;
p3 = p1:clone()
p3.Parent = script.Parent.Parent.Parent
p3.Name = &quot;Log3PV&quot;
p4 = p1:clone()
p4.Parent = script.Parent.Parent.Parent
p4.Name = &quot;Log4PV&quot;
p5 = p1:clone()
p5.Parent = script.Parent.Parent.Parent
p5.Name = &quot;Log5PV&quot;
p6 = p1:clone()
p6.Parent = script.Parent.Parent.Parent
p6.Name = &quot;Log6PV&quot;
elseif script.Parent.Parent.Parent:findFirstChild(&quot;Log1PV&quot;) ~= nil then
script.Parent.Log1V.Value = script.Parent.Parent.Parent.Log1PV.Value
script.Parent.Log2V.Value = script.Parent.Parent.Parent.Log2PV.Value
script.Parent.Log3V.Value = script.Parent.Parent.Parent.Log3PV.Value
script.Parent.Log4V.Value = script.Parent.Parent.Parent.Log4PV.Value
script.Parent.Log5V.Value = script.Parent.Parent.Parent.Log5PV.Value
script.Parent.Log6V.Value = script.Parent.Parent.Parent.Log6PV.Value
end
end


</ProtectedString>
