	<Item class="StarterGui" referent="RBX9354">
		<Properties>
			<string name="Name">StarterGui</string>
			<bool name="ShowDevelopmentGui">true</bool>
		</Properties>
		<Item class="ScreenGui" referent="RBX9355">
			<Properties>
				<string name="Name">LevelSystem</string>
			</Properties>
			<Item class="Script" referent="RBX9356">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">LevelUp</string>
					<ProtectedString name="Source">while true do
wait()
if script.Parent.Player.Value ~= nil then
player = script.Parent.Player.Value
if player.Level.Value == 10 then
if player:findFirstChild(&quot;Rewards1&quot;) == nil then
v1 = Instance.new(&quot;ObjectValue&quot;) 
v1.Parent = player
v1.Name = &quot;Rewards1&quot;
c1 = game.Lighting.Rewards.Reward1:clone()
c1.Name = &quot;Plasma Cutter&quot;
c1.Parent = player.StarterGear
c1c = c1:clone()
c1c.Parent = player.Backpack
script.Parent.NI.Image = &quot;http://www.roblox.com/asset/?id=27707371&quot;
script.Parent.NI.Visible = true
script.Parent.Desc.Text = &quot;You acquired the Plasma Cutter! Found on the Ishimura, this mining tool can switch the angle of the beam by pressing &apos;r&apos;.&quot;
script.Parent.Desc.Visible = true
script.Parent.Acquired.Volume = 1
script.Parent.Acquired:play()
wait(6)
script.Parent.Acquired.Volume = 0
script.Parent.Desc.Visible = false
script.Parent.NI.Visible = false
end
elseif player.Level.Value == 20 then
if player:findFirstChild(&quot;Rewards2&quot;) == nil then
v2 = Instance.new(&quot;ObjectValue&quot;) 
v2.Parent = player
v2.Name = &quot;Rewards2&quot;
c2 = game.Lighting.Rewards.Reward1:clone()
c2.Name = &quot;Ripper&quot;
c2.Parent = player.StarterGear
c2c = c2:clone()
c2c.Parent = player.Backpack
script.Parent.NI.Image = &quot;http://www.roblox.com/asset/?id=40983528&quot;
script.Parent.NI.Visible = true
script.Parent.Desc.Text = &quot;You acquired the Ripper! A versatile deep-space mining tool, can also fire blades with &apos;r&apos; and has a light with &apos;k&apos;&quot;
script.Parent.Desc.Visible = true
script.Parent.Acquired.Volume = 1
script.Parent.Acquired:play()
wait(6)
script.Parent.Acquired.Volume = 0
script.Parent.Desc.Visible = false
script.Parent.NI.Visible = false
end
end
end
end
</ProtectedString>
