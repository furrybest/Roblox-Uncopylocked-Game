d = true
SA = false
function KeyDownFunctions(key)
&#9;if key == &quot;r&quot; and d == true and script.Parent.Ammo.Value &lt; 12 and script.Parent.StoredAmmo.Value &gt; 11 then
&#9;&#9;d = false
&#9;&#9;Reload()
&#9;&#9;d = true
&#9;elseif key == &quot;e&quot; and d == true then
&#9;&#9;if SA == false then
&#9;&#9;d = false
&#9;&#9;AttachS()
&#9;&#9;SA = true
&#9;&#9;d = true
&#9;&#9;elseif SA == true then
&#9;&#9;d = false
&#9;&#9;UnAttachS()
&#9;&#9;SA = false
&#9;&#9;d = true
&#9;&#9;end
&#9;end
end
function onEquippedLocal(mouse)

&#9;if mouse == nil then
&#9;&#9;print(&quot;Mouse not found&quot;)
&#9;&#9;return 
&#9;end

&#9;scr = script.Parent.PistolGUI:clone()
&#9;scr.Parent = game.Players.LocalPlayer.PlayerGui&#9;
&#9;scr.Connect.Value = script.Parent
&#9;Equip()
&#9;mouse.Icon = &quot;http://www.roblox.com/asset/?id=25282070&quot;
&#9;mouse.Button1Down:connect(function() onButton1Down(mouse) end)&#9;mouse.KeyDown:connect(KeyDownFunctions)
end

function Unequip(mouse)
if game.Players.LocalPlayer.PlayerGui:findFirstChild(&quot;PistolGUI&quot;) ~= nil then
game.Players.LocalPlayer.PlayerGui.PistolGUI:remove()
end
if arms ~= nil and torso ~= nil then
local sh = {torso:FindFirstChild(&quot;Left Shoulder&quot;), torso:FindFirstChild(&quot;Right Shoulder&quot;)}
if sh ~= nil then
local yes = true
if yes then
