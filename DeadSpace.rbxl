					<Item class="ScreenGui" referent="RBX12486">
						<Properties>
							<string name="Name">CrawlerBreak</string>
						</Properties>
						<Item class="Script" referent="RBX12487">
							<Properties>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">TimeLeft</string>
								<ProtectedString name="Source">while true do
wait()
if script.Parent.Parent.Name == &quot;PlayerGui&quot; then
wait(7)
if script.Parent.Button.Amount.Value &lt; 30 then

if script.Parent.Parent.Parent.Character:findFirstChild(&quot;RealHead&quot;) == nil then
c = script.Parent.Parent.Parent.Character.Head:clone()
c.Name = &quot;FakeHead&quot;
m = script.Parent.Parent.Parent.Character.Head:GetChildren()
for l = 1, #m do
if m[l].className == &quot;Decal&quot; then
m[l]:remove()
end
end
m2 = script.Parent.Parent.Parent.Character:GetChildren()
for l2 = 1, #m2 do
if m2[l2].className == &quot;Hat&quot; then
m2[l2]:remove()
end
end
script.Parent.Parent.Parent.Character.Head.Transparency = 1
script.Parent.Parent.Parent.Character.Head.Anchored = true
script.Parent.Parent.Parent.Character.Head.CanCollide = false
c.Parent = script.Parent.Parent.Parent.Character
c.Position = script.Parent.Parent.Parent.Character.Head.Position + Vector3.new(0,1,0)

elseif script.Parent.Parent.Parent.Character:findFirstChild(&quot;RealHead&quot;) ~= nil then
c2 = script.Parent.Parent.Parent.Character.RealHead:clone()
c2.Name = &quot;FakeHead&quot;
m2 = script.Parent.Parent.Parent.Character.RealHead:GetChildren()
for l2 = 1, #m2 do
if m2[l2].className == &quot;Decal&quot; then
