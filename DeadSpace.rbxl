								<string name="Name">Script</string>
								<ProtectedString name="Source">script.Finish.Smoke.Value = script.Parent.Gas
function onT(hit)
if hit ~= nil then
if hit.Parent.Name ~= script.Parent.Parent.Name and hit.Parent:findFirstChild(&quot;Humanoid&quot;) ~= nil and hit.Parent:findFirstChild(&quot;Finish&quot;) == nil then
if hit.Parent.Humanoid.Health &gt; 10 and hit.Parent:findFirstChild(&quot;INFECTORHOLD&quot;) == nil and hit.Parent:findFirstChild(&quot;CRAWLERHOLD&quot;) == nil then
hit.Parent.Humanoid.Health = hit.Parent.Humanoid.Health - 10
script.Parent.Stab.Pitch = math.random(0.8, 1.2)
script.Parent.Stab:play()
playa = game.Players:playerFromCharacter(hit.Parent)
if playa.PlayerGui:findFirstChild(&quot;ScreenC&quot;) ~= nil then
randy = math.random(0,2)
if randy == 1 or randy == 2 then
gu = Instance.new(&quot;ImageLabel&quot;)
gu.Parent = playa.PlayerGui.ScreenC
gu.Size = UDim2.new(math.random(15,25)/100,0,math.random(15,25)/100,0)
gu.Position = UDim2.new(math.random(1,9)/10,0,math.random(1,9)/10,0)
gu.BackgroundTransparency = 1
randy2 = math.random(0,2)
if randy2 == 0 then
gu.Image = &quot;http://www.roblox.com/asset/?id=15579875&quot;
elseif randy2 == 1 then
gu.Image = &quot;http://www.roblox.com/asset/?id=15554130&quot;
elseif randy2 ==2 then
gu.Image = &quot;http://www.roblox.com/asset/?id=15553622&quot;
end
s = script.Clean:clone()
s.Disabled = false
s.Parent = gu
end
end
elseif hit.Parent.Humanoid.Health &lt; 11 and hit.Parent:findFirstChild(&quot;Finish&quot;) == nil and hit.Parent:findFirstChild(&quot;FAKE&quot;) == nil then
hit.Parent.Humanoid.Health = 1
fin = script.Finish:clone()
fin.Disabled = false
fin.Parent = hit.Parent
if string.sub(hit.Name, 1, 4) == &quot;Left&quot; or string.sub(hit.Name, 1, 5) == &quot;Right&quot; then
hit:BreakJoints()
end
end
end
end
end

script.Parent.Touched:connect(onT)

</ProtectedString>
