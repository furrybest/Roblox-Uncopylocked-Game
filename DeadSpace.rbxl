							<string name="Name">WELD</string>
							<ProtectedString name="Source">function stick(hit)&#9;
&#9;print(&quot;Crap&quot;)
&#9;self = script.Parent.Spine
&#9;weld = Instance.new(&quot;Weld&quot;)
&#9;weld.Part0 = script.Parent.Spine
&#9;weld.Part1 = hit
&#9;local HitPos = self.Position
&#9;local CJ = CFrame.new(HitPos)
&#9;local C0 = self.CFrame:inverse() *CJ
&#9;local C1 = hit.CFrame:inverse() * CJ
&#9;weld.C0 = C0
&#9;weld.C1 = C1
&#9;weld.Parent = self
end



function weld()
a = script.Parent:GetChildren()
for  i = 1, #a do
if a[i].className == &quot;Part&quot; and a[i]:findFirstChild(&quot;Meshy&quot;) ~= nil then
