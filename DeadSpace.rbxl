			</Properties>
			<Item class="LocalScript" referent="RBX8959">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">CamEdit</string>
					<ProtectedString name="Source">g = 0
h = 0
db = true
while true do
wait()
if db == true then
db = false
gui = script.DS:clone()
gui.Parent = game.Players.LocalPlayer.PlayerGui
cam = game.Workspace.CurrentCamera
camc = cam:clone()
cam.CameraSubject = game.Workspace.Subjecter
gui.Music.Volume = 1
gui.Music:play()
for i = 1, 80 do
wait(0.05)
g = g - 2
h = h + 0.25
cam.CoordinateFrame = CFrame.new(400,2150,1200) * CFrame.new(g,0,0)
end
gui.Label.Visible = false
gui.Label2.Visible = true
for i = 1, 60 do
wait(0.05)
g = g - 1
h = h + 0.5
cam.CoordinateFrame = CFrame.new(400,2150,1200) * CFrame.new(g,0,0)
cam.CoordinateFrame = cam.CoordinateFrame * CFrame.new(0,h,g)
end
gui.Label2.Visible = false
gui.Ambience.Volume = 1
gui.Ambience:play()
for i2 = 1, 20 do
wait(0.05)
g = g - 2
h = h + 0.25
gui.Title.BackgroundTransparency = gui.Title.BackgroundTransparency - 0.05
cam.CoordinateFrame = CFrame.new(400,2150,1200) * CFrame.new(g,0,0)
cam.CoordinateFrame = cam.CoordinateFrame * CFrame.new(0,h,g)
end
gui.Title.Image = &quot;http://www.roblox.com/asset/?id=84389956&quot;
wait(4)
gui.Ambience.Volume = 0
for k = 1, 20 do
wait(0.05)
gui.Title.BackgroundTransparency = gui.Title.BackgroundTransparency + 0.05
gui.Music.Volume = gui.Music.Volume - 0.05
end
gui:remove()
camc.Parent = game.Workspace
camc.CameraSubject = script.Parent
camc.CameraType = &quot;Follow&quot;
cam:remove()
script:remove()
end
end
