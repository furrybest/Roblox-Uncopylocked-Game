			<Item class="Script" referent="RBX1624">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Paintball</string>
					<ProtectedString name="Source">ball = script.Parent
sdamage = math.random(49,57)
damage = math.random(66,87)
db = true

function onTouched(hit)
if db == true then
if db == true and hit:findFirstChild(&quot;Bullet&quot;) == nil then
&#9;db = false
&#9;ball.Transparency = 1
&#9;ball.CanCollide = true
&#9;if hit:findFirstChild(&quot;Connect&quot;) ~= nil then
&#9;hit.Connect.Value = hit.Connect.Value - math.random(19,27)
&#9;end
&#9;a = hit.Parent:GetChildren()
&#9;for i = 1, #a do
&#9;if a[i].className == &quot;Humanoid&quot; and a[i].Parent ~= script.Parent.Connector.Value then
&#9;ball.Anchored = true
&#9;&#9;&#9;
&#9;&#9;











if game.Players:playerFromCharacter(hit.Parent) ~= nil and a[i].Name == &quot;DS&quot; then

&#9;&#9;if script.Parent.Silenced.Value == false then


&#9;if hit.Name == &quot;Torso&quot; then
&#9;a[i].Health = a[i].Health - damage * 2
&#9;elseif hit.Name == &quot;Head&quot; then
&#9;a[i].Health = a[i].Health - damage * 2.5
&#9;else
&#9;a[i].Health = a[i].Health - damage
&#9;end


&#9;&#9;elseif script.Parent.Silenced.Value == true then


&#9;if hit.Name == &quot;Torso&quot;  then
&#9;a[i].Health = a[i].Health - sdamage * 1.5
&#9;elseif hit.Name == &quot;Head&quot; then
&#9;a[i].Health = a[i].Health - sdamage * 2
&#9;else
&#9;a[i].Health = a[i].Health - sdamage
&#9;end


&#9;&#9;end
&#9;if hit.Parent:findFirstChild(&quot;GiveExp&quot;) ~= nil then
&#9;player = game.Players:playerFromCharacter(script.Gunner.Value.Parent)
&#9;if player.Level.Value &lt; 20 then
&#9;if hit.Parent.DS.Health &lt; 1 then
&#9;player.EXP.Value = player.EXP.Value - hit.Parent.GiveExp.Value
&#9;hit.Parent.GiveExp:remove()
&#9;elseif hit.Parent.DS.Health &gt; 0 then
&#9;player.EXP.Value = player.EXP.Value - 1
&#9;end
&#9;end
&#9;end











elseif game.Players:playerFromCharacter(hit.Parent) == nil then

&#9;&#9;if script.Parent.Silenced.Value == false then


&#9;if hit.Name == &quot;Torso&quot; then
&#9;a[i].Health = a[i].Health - damage * 2
&#9;elseif hit.Name == &quot;Head&quot; then
&#9;a[i].Health = a[i].Health - damage * 2.5
&#9;else
&#9;a[i].Health = a[i].Health - damage
&#9;end


&#9;&#9;elseif script.Parent.Silenced.Value == true then



&#9;if hit.Name == &quot;Torso&quot; then
&#9;a[i].Health = a[i].Health - sdamage * 1.5
&#9;elseif hit.Name == &quot;Head&quot; then
&#9;a[i].Health = a[i].Health - sdamage * 2
&#9;else
&#9;a[i].Health = a[i].Health - sdamage
&#9;end
&#9;
&#9;&#9;end
&#9;if hit.Parent:findFirstChild(&quot;GiveExp&quot;) ~= nil then
&#9;player = game.Players:playerFromCharacter(script.Gunner.Value.Parent)
&#9;if player.Level.Value &lt; 20 then
&#9;if hit.Parent.DS.Health &lt; 1 then
&#9;player.EXP.Value = player.EXP.Value - hit.Parent.GiveExp.Value
&#9;hit.Parent.GiveExp:remove()
&#9;elseif hit.Parent.DS.Health &gt; 0 then
&#9;player.EXP.Value = player.EXP.Value - 1
&#9;end
&#9;end
&#9;end


end

&#9;p = ball:clone()
&#9;p.Transparency = 0
&#9;p.BrickColor = BrickColor.new(21)
&#9;p.BrickCleanup:remove()
&#9;p.Clean.Disabled = false
&#9;p.Paintball:remove()
&#9;p.Anchored = true
&#9;p.Parent = game.Workspace
&#9;p.ShotMesh:remove()
&#9;p.creator:remove()
&#9;p.BodyForce:remove()
&#9;p.Velocity = Vector3.new(0,0,0)
&#9;p.Realism.Enabled = true
&#9;m = Instance.new(&quot;BlockMesh&quot;)
&#9;m.Parent = p
&#9;m.Scale = Vector3.new(0.3,0.4,0.3)
&#9;p.Anchored = false
&#9;p.formFactor = 2
&#9;p.Shape = 1
&#9;p.CFrame = hit.CFrame * CFrame.fromEulerAnglesXYZ(math.random(5,100)/10,math.random(5,100)/10,math.random(5,100)/10)
&#9;W = Instance.new(&quot;Weld&quot;)
&#9;W.Name = &quot;WeldedSTUCK&quot;
&#9;W.Part0 = hit
&#9;W.Part1 = p
&#9;CJ = CFrame.new(hit.Position)
&#9;C0 = hit.CFrame:inverse()*CJ
&#9;C1 = p.CFrame:inverse()*CJ
&#9;W.C0 = C0
&#9;W.C1 = C1
&#9;W.Parent = hit

&#9;end
&#9;end
wait(0.01)
ball.Parent = nil
end
else
&#9;if db == true and hit.Parent ~= script.Gunner.Value and hit.Parent.Parent ~= script.Gunner.Value then
&#9;script.Parent:remove()
&#9;end
end
end

ball.Touched:connect(onTouched)
</ProtectedString>
				</Properties>
				<Item class="ObjectValue" referent="RBX1625">
