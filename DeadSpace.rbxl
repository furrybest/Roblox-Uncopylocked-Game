			<Item class="StringValue" referent="RBX9477">
				<Properties>
					<string name="Name">Log6M1</string>
					<string name="Value">Our specialist are guessing the ship we found is actually human-made. Once astronauts got inside, the interior had oxygen and food similar to what we have on earth.</string>
				</Properties>
			</Item>
			<Item class="Script" referent="RBX9478">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">CinematicHelp</string>
					<ProtectedString name="Source">player = nil
while true do
wait()
if script.Parent.Parent.Parent.className == &quot;Player&quot; then
player = script.Parent.Parent.Parent
end
if player ~= nil then
if player.PlayerGui:findFirstChild(&quot;DS&quot;) ~= nil then
script.Parent.Parent = game.Lighting
elseif player.PlayerGui:findFirstChild(&quot;DS&quot;) == nil then
script.Parent.Parent = player.PlayerGui
end
end
end
</ProtectedString>
				</Properties>
			</Item>
			<Item class="BoolValue" referent="RBX9479">
				<Properties>
					<string name="Name">Log5V</string>
					<bool name="Value">false</bool>
				</Properties>
			</Item>
			<Item class="StringValue" referent="RBX9480">
				<Properties>
					<string name="Name">Log1M1</string>
					<string name="Value">I can&apos;t believe them. The government doesn&apos;t seem to have any control over itself anymore, wanting to turn the experiments into possible weapons..</string>
				</Properties>
			</Item>
			<Item class="StringValue" referent="RBX9481">
				<Properties>
					<string name="Name">Log2M3</string>
					<string name="Value">Head of Security, Henry Smith</string>
				</Properties>
			</Item>
			<Item class="StringValue" referent="RBX9482">
				<Properties>
					<string name="Name">Log2M2</string>
					<string name="Value">Oh no, its lunch time again...wonder what its going to be...&quot;Black and brown delight&quot;? </string>
				</Properties>
			</Item>
			<Item class="StringValue" referent="RBX9483">
				<Properties>
					<string name="Name">Log2M1</string>
					<string name="Value">I can&apos;t believe the food they serve down here. I swear its part food, and part of the specimens...****...seriously.</string>
				</Properties>
			</Item>
			<Item class="BoolValue" referent="RBX9484">
				<Properties>
					<string name="Name">StopF</string>
					<bool name="Value">false</bool>
				</Properties>
			</Item>
			<Item class="StringValue" referent="RBX9485">
				<Properties>
					<string name="Name">Log3M1</string>
					<string name="Value">Please...if you are reading this, help.....me....the creatures are EVERYWHERE....</string>
				</Properties>
			</Item>
			<Item class="StringValue" referent="RBX9486">
				<Properties>
					<string name="Name">Log3M2</string>
					<string name="Value">I&apos;ll be waiting in front of the medlab....please...if you are reading this, save me---</string>
				</Properties>
			</Item>
			<Item class="StringValue" referent="RBX9487">
				<Properties>
					<string name="Name">Log3M3</string>
					<string name="Value">Owner Unknown</string>
				</Properties>
			</Item>
			<Item class="StringValue" referent="RBX9488">
				<Properties>
					<string name="Name">Log4M3</string>
					<string name="Value">Ph.D in Celestial Objects, Kevin Jones</string>
				</Properties>
			</Item>
			<Item class="StringValue" referent="RBX9489">
				<Properties>
					<string name="Name">Log4M2</string>
					<string name="Value">At first, we believed it was an &apos;alien&apos; ship. But then pictures sent back showed the ship to have english writing on its side! Its called... &quot;Ishimura&quot;</string>
				</Properties>
			</Item>
			<Item class="StringValue" referent="RBX9490">
				<Properties>
					<string name="Name">Log4M1</string>
					<string name="Value">This is a day that will go down in history! Just today, a government probe picked up a...a &apos;Space Ship&apos;! It&apos;s lightyears ahead of our technology!</string>
				</Properties>
			</Item>
			<Item class="StringValue" referent="RBX9491">
				<Properties>
					<string name="Name">Log5M2</string>
					<string name="Value">One security cam showed a security memeber fire upon a specimen, nicknamed &quot;Slasher&quot; for its claws, to no effect. It quickly decimated the entire team and was only contained by locking the doors to the room.</string>
				</Properties>
			</Item>
			<Item class="StringValue" referent="RBX9492">
				<Properties>
					<string name="Name">Log5M3</string>
					<string name="Value">Lobby Administrator, Cassandra Golmen</string>
				</Properties>
			</Item>
			<Item class="StringValue" referent="RBX9493">
				<Properties>
					<string name="Name">Log5M1</string>
					<string name="Value">The specimens we found are dangerous. As we brought one down here, the trance they seem to have been in when we found them broke, and they became re-animated. Fortunatly, we only had a few left to move into the bunker, but even those few caused a slaughter.</string>
				</Properties>
			</Item>
			<Item class="StringValue" referent="RBX9494">
				<Properties>
					<string name="Name">Log6M2</string>
					<string name="Value">Scientists aren&apos;t sure where the ship came from or ,more likely, WHEN it came from.</string>
				</Properties>
			</Item>
