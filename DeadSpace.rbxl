						<ProtectedString name="Source">while true do
wait()
if script.Parent.AOK.Value == true then
if script.Parent.Parent == game.Workspace then
wait()
script.Parent.DS.Health = script.Parent.DS.MaxHealth
wait(2)
a = script.Parent:GetChildren()
for i = 1, #a do
if a[i].className == &quot;Part&quot; then
a[i].Anchored = false
end
end
script:remove()
end
end
end

