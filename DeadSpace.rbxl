						<string name="Name">Script</string>
						<ProtectedString name="Source">function run()
hit = script.Parent.Parent.Parent.Parent.Character.Torso
pla = game.Players:playerFromCharacter(hit.Parent)
if pla ~= nil and hit.Parent:findFirstChild(&quot;Spine Piece&quot;) == nil then
gg = hit.Parent:GetChildren()
for ivv = 1, #gg do
if gg[ivv].className == &quot;Shirt&quot; or gg[ivv].className == &quot;Pants&quot; or gg[ivv].className == &quot;ShirtGraphic&quot; or gg[ivv].className == &quot;Hat&quot; or gg[ivv].Name == &quot;Health&quot; then
gg[ivv]:remove()
end
end
gg2 = hit.Parent.Torso:GetChildren()
for ivv2 = 1, #gg2 do
if gg2[ivv2].className == &quot;Decal&quot; then
gg2[ivv2]:remove()
end
end

if hit.Parent:findFirstChild(&quot;Humanoid&quot;) ~= nil and hit.Parent:findFirstChild(&quot;Helm&quot;) == nil then
&#9;&#9;local g = game.Lighting.WareHouse.IssacS.Helm:clone()
&#9;&#9;g.Parent = hit.Parent
&#9;&#9;local C = g:GetChildren()
&#9;&#9;for i=1, #C do
&#9;&#9;&#9;if C[i].className == &quot;Part&quot; then
&#9;&#9;&#9;&#9;local W = Instance.new(&quot;Weld&quot;)
&#9;&#9;&#9;&#9;W.Part0 = g.Middle
&#9;&#9;&#9;&#9;W.Part1 = C[i]
&#9;&#9;&#9;&#9;local CJ = CFrame.new(g.Middle.Position)
&#9;&#9;&#9;&#9;local C0 = g.Middle.CFrame:inverse()*CJ
&#9;&#9;&#9;&#9;local C1 = C[i].CFrame:inverse()*CJ
&#9;&#9;&#9;&#9;W.C0 = C0
&#9;&#9;&#9;&#9;W.C1 = C1
&#9;&#9;&#9;&#9;W.Parent = g.Middle
&#9;&#9;&#9;&#9;if C[i].Name ~= &quot;Middle&quot; then
&#9;&#9;&#9;&#9;C[i].Transparency = 0
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;local Y = Instance.new(&quot;Weld&quot;)
&#9;&#9;&#9;&#9;Y.Part0 = hit.Parent.Torso
&#9;&#9;&#9;&#9;Y.Part1 = g.Middle
&#9;&#9;&#9;&#9;Y.C0 = CFrame.new(0, 0, 0)
&#9;&#9;&#9;&#9;Y.Parent = Y.Part0
&#9;&#9;end

&#9;&#9;local h = g:GetChildren()
&#9;&#9;for i = 1, # h do
&#9;&#9;&#9;h[i].Anchored = false
&#9;&#9;&#9;h[i].CanCollide = false
&#9;&#9;end
&#9;if hit.Parent.Head:findFirstChild(&quot;face&quot;) ~= nil then
&#9;hit.Parent.Head.face:remove()
&#9;end
&#9;end





