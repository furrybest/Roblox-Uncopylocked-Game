				<string name="Name">Script</string>
				<ProtectedString name="Source">while true do
wait()
a = game.Players:GetChildren()
for i = 1, #a do
if a[i].Character ~= nil then
if a[i].Character:findFirstChild(&quot;CamEdit&quot;) == nil then
if a[i]:findFirstChild(&quot;Cinema&quot;) == nil then
v = Instance.new(&quot;ObjectValue&quot;)
v.Parent = a[i]
v.Name = &quot;Cinema&quot;
c = script.CamEdit:clone()
c.Parent = a[i].Character
end
end
end
end
end
