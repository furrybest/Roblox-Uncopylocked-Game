			<Item class="LocalScript" referent="RBX9348">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">BackupWeld</string>
					<ProtectedString name="Source">function Weld(x,y)
&#9;local W = Instance.new(&quot;Weld&quot;)
&#9;W.Part0 = x
&#9;W.Part1 = y
&#9;local CJ = CFrame.new(x.Position)
&#9;local C0 = x.CFrame:inverse()*CJ
&#9;local C1 = y.CFrame:inverse()*CJ
&#9;W.C0 = C0
&#9;W.C1 = C1
&#9;W.Parent = x
end

function Get(A)
&#9;if A.className == &quot;Part&quot; then
&#9;&#9;Weld(script.Parent.Handle, A)
&#9;&#9;A.Anchored = false
&#9;else
&#9;&#9;local C = A:GetChildren()
&#9;&#9;for i=1, #C do
&#9;&#9;Get(C[i])
&#9;&#9;end
&#9;end
end

function Finale()
&#9;Get(script.Parent)
end

script.Parent.Equipped:connect(Finale)
script.Parent.Unequipped:connect(Finale)
Finale()</ProtectedString>
				</Properties>
			</Item>
			<Item class="LocalScript" referent="RBX9349">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">BackupWeld</string>
					<ProtectedString name="Source">function Weld(x,y)
&#9;local W = Instance.new(&quot;Weld&quot;)
&#9;W.Part0 = x
&#9;W.Part1 = y
&#9;local CJ = CFrame.new(x.Position)
&#9;local C0 = x.CFrame:inverse()*CJ
&#9;local C1 = y.CFrame:inverse()*CJ
&#9;W.C0 = C0
&#9;W.C1 = C1
&#9;W.Parent = x
end

function Get(A)
&#9;if A.className == &quot;Part&quot; then
&#9;&#9;Weld(script.Parent.Handle, A)
&#9;&#9;A.Anchored = false
&#9;else
&#9;&#9;local C = A:GetChildren()
&#9;&#9;for i=1, #C do
&#9;&#9;Get(C[i])
&#9;&#9;end
&#9;end
end

function Finale()
&#9;Get(script.Parent)
end

script.Parent.Equipped:connect(Finale)
script.Parent.Unequipped:connect(Finale)
Finale()</ProtectedString>
				</Properties>
			</Item>
			<Item class="Script" referent="RBX9350">
				<Properties>
					<bool name="Disabled">true</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Bullet</string>
					<ProtectedString name="Source">ball = script.Parent
damage = math.random(29,37)

db = true

function onTouched(hit)
if db == true and hit:findFirstChild(&quot;Bullet&quot;) == nil then
db = false
&#9;if hit:findFirstChild(&quot;Connect&quot;) ~= nil then
&#9;hit.Connect.Value = hit.Connect.Value - math.random(19,27)
&#9;end
&#9;script.Parent.Transparency = 1
&#9;a = hit.Parent:GetChildren()
&#9;for i = 1, #a do
&#9;if a[i].className == &quot;Humanoid&quot; then
&#9;if game.Players:playerFromCharacter(hit.Parent) ~= nil and a[i].Name == &quot;DS&quot; then
&#9;if hit.Name == &quot;Torso&quot; then
&#9;a[i].Health = a[i].Health - damage * 1.5
&#9;elseif hit.Name == &quot;Head&quot; then
&#9;a[i].Health = a[i].Health - damage * 2
&#9;else
&#9;a[i].Health = a[i].Health - damage
&#9;end
&#9;elseif game.Players:playerFromCharacter(hit.Parent) == nil then
&#9;if hit.Name == &quot;Torso&quot; then
&#9;a[i].Health = a[i].Health - damage * 1.5
&#9;elseif hit.Name == &quot;Head&quot; then
&#9;a[i].Health = a[i].Health - damage * 2
&#9;else
&#9;a[i].Health = a[i].Health - damage
&#9;end
&#9;end
&#9;end
&#9;end
&#9;wait()
&#9;if hit.Parent:findFirstChild(&quot;GiveExp&quot;) ~= nil then
&#9;player = game.Players:playerFromCharacter(script.Gunner.Value.Parent)
&#9;if player.Level.Value &lt; 20 then
&#9;if hit.Parent.DS.Health &lt; 1 then
&#9;player.EXP.Value = player.EXP.Value - hit.Parent.GiveExp.Value
&#9;hit.Parent.GiveExp:remove()
&#9;elseif hit.Parent.DS.Health &gt; 0 then
&#9;player.EXP.Value = player.EXP.Value - 1
&#9;end
&#9;end
&#9;end
&#9;wait(0.01)
&#9;ball.Parent = nil
else
if hit.Parent ~= script.Gunner.Value and db == true and hit.Parent.Parent ~= script.Gunner.Value then
script.Parent:remove()
end
end
end

ball.Touched:connect(onTouched)
wait(10)
ball.Parent = nil
</ProtectedString>
				</Properties>
				<Item class="ObjectValue" referent="RBX9351">
					<Properties>
						<string name="Name">Gunner</string>
						<Ref name="Value">null</Ref>
					</Properties>
				</Item>
			</Item>
			<Item class="Script" referent="RBX9352">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">CinematicHelp</string>
					<ProtectedString name="Source">player = nil
db = false
while true do
wait()
if script.Parent.Parent.Parent.className == &quot;Player&quot; then
player = script.Parent.Parent.Parent
end
if player ~= nil then
if player.PlayerGui:findFirstChild(&quot;DS&quot;) ~= nil then
db = true
script.Parent.Parent = game.Lighting
elseif player.PlayerGui:findFirstChild(&quot;DS&quot;) == nil and db == true then
script.Parent.Parent = player.Backpack
script:remove()
end
end
end
</ProtectedString>
				</Properties>
			</Item>
			<Item class="Script" referent="RBX9353">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">CinematicHelp2</string>
					<ProtectedString name="Source">player = nil
db = false
while true do
wait()
if script.Parent.Parent.Parent.className == &quot;Player&quot; then
player = script.Parent.Parent.Parent
end
if player ~= nil then
if player.PlayerGui:findFirstChild(&quot;DS2&quot;) ~= nil then
db = true
script.Parent.Parent = game.Lighting
elseif player.PlayerGui:findFirstChild(&quot;DS2&quot;) == nil and db == true then
script.Parent.Parent = player.Backpack
db = false
end
end
end
</ProtectedString>
				</Properties>
			</Item>
		</Item>
