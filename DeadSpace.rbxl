&#9;end
&#9;a = hit.Parent:GetChildren()
&#9;for i = 1, #a do
&#9;if a[i].className == &quot;Humanoid&quot; and a[i].Parent ~= script.Parent.Connector.Value then
&#9;ball.Anchored = true
&#9;&#9;&#9;
&#9;&#9;











if game.Players:playerFromCharacter(hit.Parent) ~= nil and a[i].Name == &quot;DS&quot; then

&#9;&#9;if script.Parent.Silenced.Value == false then


&#9;if hit.Name == &quot;Torso&quot; then
&#9;a[i].Health = a[i].Health - damage * 2
&#9;elseif hit.Name == &quot;Head&quot; then
&#9;a[i].Health = a[i].Health - damage * 2.5
&#9;else
&#9;a[i].Health = a[i].Health - damage
&#9;end


&#9;&#9;elseif script.Parent.Silenced.Value == true then


&#9;if hit.Name == &quot;Torso&quot;  then
&#9;a[i].Health = a[i].Health - sdamage * 1.5
&#9;elseif hit.Name == &quot;Head&quot; then
&#9;a[i].Health = a[i].Health - sdamage * 2
&#9;else
&#9;a[i].Health = a[i].Health - sdamage
&#9;end


&#9;&#9;end
&#9;if hit.Parent:findFirstChild(&quot;GiveExp&quot;) ~= nil then
&#9;player = game.Players:playerFromCharacter(script.Gunner.Value.Parent)
&#9;if player.Level.Value &lt; 20 then
&#9;if hit.Parent.DS.Health &lt; 1 then
&#9;player.EXP.Value = player.EXP.Value - hit.Parent.GiveExp.Value
&#9;hit.Parent.GiveExp:remove()
&#9;elseif hit.Parent.DS.Health &gt; 0 then
&#9;player.EXP.Value = player.EXP.Value - 1
&#9;end
&#9;end
&#9;end











elseif game.Players:playerFromCharacter(hit.Parent) == nil then

&#9;&#9;if script.Parent.Silenced.Value == false then


&#9;if hit.Name == &quot;Torso&quot; then
&#9;a[i].Health = a[i].Health - damage * 2
&#9;elseif hit.Name == &quot;Head&quot; then
&#9;a[i].Health = a[i].Health - damage * 2.5
&#9;else
&#9;a[i].Health = a[i].Health - damage
&#9;end


&#9;&#9;elseif script.Parent.Silenced.Value == true then



&#9;if hit.Name == &quot;Torso&quot; then
&#9;a[i].Health = a[i].Health - sdamage * 1.5
&#9;elseif hit.Name == &quot;Head&quot; then
&#9;a[i].Health = a[i].Health - sdamage * 2
&#9;else
&#9;a[i].Health = a[i].Health - sdamage
&#9;end
&#9;
&#9;&#9;end
&#9;if hit.Parent:findFirstChild(&quot;GiveExp&quot;) ~= nil then
&#9;player = game.Players:playerFromCharacter(script.Gunner.Value.Parent)
&#9;if player.Level.Value &lt; 20 then
&#9;if hit.Parent.DS.Health &lt; 1 then
&#9;player.EXP.Value = player.EXP.Value - hit.Parent.GiveExp.Value
&#9;hit.Parent.GiveExp:remove()
&#9;elseif hit.Parent.DS.Health &gt; 0 then
&#9;player.EXP.Value = player.EXP.Value - 1
&#9;end
&#9;end
&#9;end


end

&#9;p = ball:clone()
&#9;p.Transparency = 0
