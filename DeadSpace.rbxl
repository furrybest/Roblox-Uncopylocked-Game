				<Item class="Script" referent="RBX4975">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Click</string>
						<ProtectedString name="Source">function click()
if script.Parent.Parent.db.Value == true then
script.Parent.Parent.db.Value = false
a = script.Parent.Parent.Hologram:GetChildren()
for i = 1, #a do
if a[i].className == &quot;Part&quot; then
a[i].Transparency = 0.75
end
end
script.Parent.Parent.Hologram.Head.Face.Texture = &quot;http://www.roblox.com/asset/?id=24093275&quot;
holo = script.Parent.Parent.Hologram
holo.Head.NameTag.Words.Text = &quot;This is Joshua Roberts, on video log 59473, here to give a last statement&quot;
holo.Head.NameTag.Words.Visible = true
wait(5)
holo.Head.NameTag.Words.Text = &quot;......Those...monsters....they&apos;re out there and they&apos;re killing everyone! EVERYONE!&quot;
wait(6)
holo.Head.NameTag.Words.Text = &quot;I probably don&apos;t have much time left....I managed to lock myself in this security room.&quot;
wait(6)
holo.Head.NameTag.Words.Text = &quot;I can hear them....they were just in the medlab...I was there too, with my co-worker Jacob.&quot;
wait(7)
holo.Head.NameTag.Words.Text = &quot;We had heard reports...that the creatures we found aboard the alien ship were released by a terrorist...&quot;
wait(7)
holo.Head.NameTag.Words.Text = &quot;*Sotfly* Jacob...  *Back to normal voice* As we were taking samples of specimen 285PREDATOR, &apos;they&apos; found us...&quot;
wait(8)
holo.Head.NameTag.Words.Text = &quot;The government thought they could control them. *Wry Regret* I wish they were right.&quot;
wait(6)
holo.Head.NameTag.Words.Text = &quot;Oh my God, I can see them coming back into the medlab! They&apos;ve spotted me!&quot;
wait(5)
holo.Head.NameTag.Words.Text = &quot;No, oh please no! SOMEONE SAVE ME!!! PLEASE ANYONE!!! *Crash in Background* NOOOO!!!!------&quot;
wait(4)
script.Parent.Glass:play()
wait(2)
holo.Head.NameTag.Words.Text =  &quot; &quot;
for m = 1, 8 do
wait(0.2)
holo.Head.NameTag.Words.Text = holo.Head.NameTag.Words.Text..&quot;.&quot;
end
wait(1)
holo.Head.NameTag.Words.Text = holo.Head.NameTag.Words.Text..&quot;Transmission End&quot;
wait(2)
holo.Head.NameTag.Words.Visible = false
a2 = script.Parent.Parent.Hologram:GetChildren()
for i2 = 1, #a2 do
if a2[i2].className == &quot;Part&quot; then
a2[i2].Transparency = 1
end
end
script.Parent.Parent.Hologram.Head.Face.Texture = &quot;Clear&quot;
wait(0.5)
script.Parent.Parent.db.Value = true
end
end

script.Parent.ClickDetector.mouseClick:connect(click)
</ProtectedString>
					</Properties>
				</Item>
