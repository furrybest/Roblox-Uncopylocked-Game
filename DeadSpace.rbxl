								<ProtectedString name="Source">db = true
function touch(hit)
if db == true then
if hit.Parent ~= nil then
a = hit.Parent:GetChildren()
for i = 1, #a do
if a[i].className == &quot;Humanoid&quot; then
if a[i].Health &gt; 0 then
db = false
a[i].Health = a[i].Health - math.random(10,30)
script.Parent.HIT:play()
wait(0.1)
db = true
end
end
end
end
end
end

