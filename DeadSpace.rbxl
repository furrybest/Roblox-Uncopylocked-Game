				<Item class="Script" referent="RBX9913">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Kill Script</string>
						<ProtectedString name="Source">local larm = script.Parent:FindFirstChild(&quot;Left Arm&quot;)
local rarm = script.Parent:FindFirstChild(&quot;Right Arm&quot;)

function findNearestTorso(pos)
&#9;local list = game.Workspace:children()
&#9;local torso = nil
&#9;local dist = 800000
&#9;local temp = nil
&#9;local human = nil
&#9;local temp2 = nil
&#9;for x = 1, #list do
&#9;&#9;temp2 = list[x]
&#9;&#9;if (temp2.className == &quot;Model&quot;) and (temp2 ~= script.Parent) then
&#9;&#9;&#9;temp = temp2:findFirstChild(&quot;Torso&quot;)
&#9;&#9;&#9;human = temp2:findFirstChild(&quot;Humanoid&quot;)
&#9;&#9;&#9;if (temp ~= nil) and (human ~= nil) and (human.Health &gt; 0) and temp2:findFirstChild(&quot;INFECTORHOLD&quot;) == nil and temp2:findFirstChild(&quot;CRAWLERHOLD&quot;) == nil then
&#9;&#9;&#9;&#9;if (temp.Position - pos).magnitude &lt; dist then
&#9;&#9;&#9;&#9;&#9;torso = temp
&#9;&#9;&#9;&#9;&#9;dist = (temp.Position - pos).magnitude
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
&#9;return torso
end


while true do
&#9;wait(0.1)
if script.Parent.AOK.Value == true then
&#9;local target = findNearestTorso(script.Parent.Torso.Position)
&#9;if target ~= nil then
&#9;&#9;script.Parent.DS:MoveTo(target.Position, target)
&#9;&#9;script.Parent.DS.WalkSpeed = 21 + math.random(0, 2)
&#9;&#9;script.Parent.Attack.Value = true
&#9;elseif target == nil then
&#9;script.Parent.Attack.Value = false
&#9;end
end
end
</ProtectedString>
					</Properties>
				</Item>
				<Item class="Script" referent="RBX9914">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Remover</string>
						<ProtectedString name="Source">while true do
wait()
if script.Parent.AOK.Value == true then
&#9;if script.Parent.DS.Health&lt;1 then
&#9;&#9;wait(1)
&#9;&#9;if script.Parent.DS.Health&lt;1 then
&#9;&#9;wait(4)
&#9;&#9;script.Parent:remove()
&#9;&#9;end
&#9;end
end
end
&#9;&#9;


</ProtectedString>
