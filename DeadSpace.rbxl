						<Item class="Script" referent="RBX12690">
							<Properties>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">Attach</string>
								<ProtectedString name="Source">wait(0.05)
while true do
wait()
if script.Parent.Parent.AOK.Value == true then
if script.Parent.Parent.Jump.Value == true and script.Parent.Parent.DS.Health &gt; 0 then
a = game.Players:GetChildren()
for i = 1, #a do
if a[i].Character ~= nil then
if a[i].Character:findFirstChild(&quot;Torso&quot;) ~= nil and a[i].Character:findFirstChild(&quot;Humanoid&quot;) ~= nil then
if a[i].Character.Humanoid.Health &gt; 0 then
if (script.Parent.Position - a[i].Character.Torso.Position).magnitude &lt; 10 then
if a[i].Character:findFirstChild(&quot;CRAWLERHOLD&quot;) == nil and a[i].Character:findFirstChild(&quot;INFECTORHOLD&quot;) == nil then
script.Parent.Parent.Jump.Value = false
script.Parent.Parent.DS:remove()
script.Parent.Parent.Parent = a[i].Character
script.Parent.Parent.Name = &quot;AttachedSwarm&quot;
script.Parent.Parent.Torso.CanCollide = false
script.Parent.Parent.Head.CanCollide = false
g = script.Parent.Parent:GetChildren()
for h = 1, #g do
if g[h].className == &quot;Part&quot; or g[h].className == &quot;Wedge&quot; then
&#9;self = a[i].Character.Torso
&#9;weld = Instance.new(&quot;Weld&quot;)
&#9;weld.Part0 = self
&#9;weld.Part1 = g[h]
&#9;weld.C0 = CFrame.new(math.random(-10,10)/10,math.random(-10,10)/10,math.random(-5,5)/10) * CFrame.fromEulerAnglesXYZ(-4.6,0,3)
&#9;weld.Parent = self
&#9;weld.Name = &quot;SWARMWELD&quot;
end
end
if a[i].PlayerGui:findFirstChild(&quot;SwarmBreak&quot;) == nil then
c = script.Parent.Parent.SwarmBreak:clone()
c.Parent = a[i].PlayerGui
c.Swarm.Value = script.Parent.Parent
script.Parent.Weaken.Value = true
elseif a[i].PlayerGui:findFirstChild(&quot;SwarmBreak&quot;) ~= nil then
