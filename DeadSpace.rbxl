end



function weld()
a = script.Parent:GetChildren()
print(&quot;Stuff&quot;)
for  i = 1, #a do
if a[i].className == &quot;Part&quot; and a[i]:findFirstChild(&quot;Mesher2&quot;) ~= nil then
a[i]:BreakJoints()
stick(a[i])
end
end
