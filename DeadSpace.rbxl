				<Item class="Script" referent="RBX10001">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">KillScript</string>
						<ProtectedString name="Source">local larm = script.Parent:FindFirstChild(&quot;Left Arm&quot;)
local rarm = script.Parent:FindFirstChild(&quot;Right Arm&quot;)

function findNearestTorso(pos)
&#9;local list = game.Workspace:children()
&#9;local torso = nil
&#9;local dist = 75000
&#9;local temp = nil
&#9;local human = nil
&#9;local temp2 = nil
&#9;for x = 1, #list do
&#9;&#9;temp2 = list[x]
&#9;&#9;if (temp2.className == &quot;Model&quot;) and (temp2 ~= script.Parent) and game.Players:playerFromCharacter(temp2) ~= nil then
&#9;&#9;&#9;temp = temp2:findFirstChild(&quot;Torso&quot;)
&#9;&#9;&#9;human = temp2:findFirstChild(&quot;Humanoid&quot;)
&#9;&#9;&#9;if (temp ~= nil) and (human ~= nil) and (human.Health &gt; 0) and temp2:findFirstChild(&quot;CRAWLERHOLD&quot;) == nil and temp2:findFirstChild(&quot;INFECTORHOLD&quot;) == nil and game.Players:playerFromCharacter(temp2).PlayerGui:findFirstChild(&quot;SwarmBreak&quot;) == nil then
&#9;&#9;&#9;&#9;if (temp.Position - pos).magnitude &lt; dist then
&#9;&#9;&#9;&#9;&#9;torso = temp
&#9;&#9;&#9;&#9;&#9;dist = (temp.Position - pos).magnitude
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
&#9;return torso
end


while true do
&#9;wait(0.1)
if script.Parent.AOK.Value == true then
&#9;local target = findNearestTorso(script.Parent.Torso.Position)
&#9;if target ~= nil then
&#9;&#9;script.Parent.DS:MoveTo(target.Position, target)
&#9;&#9;script.Parent.DS.WalkSpeed = 18 + math.random(0, 2)
&#9;end
end
end
</ProtectedString>
					</Properties>
