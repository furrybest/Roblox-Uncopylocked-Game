					<Item class="Script" referent="RBX11070">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Welder</string>
							<ProtectedString name="Source">function WELD(origin, this, pos)
wee = Instance.new(&quot;Motor&quot;)
wee.Part0 = origin
wee.Part1 = this
wee.Parent = origin
wee.C0 = pos
wee.MaxVelocity = 0.55
ww = Instance.new(&quot;IntValue&quot;)
ww.Parent = wee
ww.Name = &quot;Pie&quot;
end

function one()
if script.Parent.Torso:findFirstChild(&quot;Motor&quot;) == nil then
WELD(script.Parent.Torso, script.Parent.LeftLimb, CFrame.new(-1.3, 5.3, 0) * CFrame.fromEulerAnglesXYZ(0, -7.9, 0))
WELD(script.Parent.Torso, script.Parent.RightLimb, CFrame.new(1.3, 5.3, 0) * CFrame.fromEulerAnglesXYZ(0, -7.9, 0))
elseif script.Parent.Torso:findFirstChild(&quot;Motor&quot;) ~= nil then
a = script.Parent.Torso:GetChildren()
for i = 1, #a do
if a[i].className == &quot;Motor&quot; then
a[i]:remove()
end
end
WELD(script.Parent.Torso, script.Parent.LeftLimb, CFrame.new(-1.3, 5.3, 0) * CFrame.fromEulerAnglesXYZ(0, -7.9, 0))
WELD(script.Parent.Torso, script.Parent.RightLimb, CFrame.new(1.3, 5.3, 0) * CFrame.fromEulerAnglesXYZ(0, -7.9, 0))
end
end

one()


