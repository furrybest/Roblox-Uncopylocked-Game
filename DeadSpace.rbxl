				<Item class="Script" referent="RBX2038">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">while true do
wait()
a = game.Players:GetChildren()
for i = 1, #a do
if a[i].Character ~= nil then
if a[i].Character:findFirstChild(&quot;Torso&quot;) ~= nil then
if (a[i].Character.Torso.Position - script.Parent.Position).magnitude &lt; 6 then
if a[i].Log6PV.Value == false then
a[i].Log6PV.Value = true
gui = script.Parent.NewLog:clone()
gui.Parent = a[i].PlayerGui
c = script.Parent.Clean:clone()
c.Parent = gui
c.Disabled = false
end
end
end
end
end
end
</ProtectedString>
					</Properties>
				</Item>
