				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Info</string>
				<ProtectedString name="Source">--[[ Contains important CFrame scripts.


a = game.Workspace.CinematicPerson1:GetChildren() for i = 1, #a do a[i].CFrame = a[i].CFrame * CFrame.fromEulerAnglesXYZ(0,0,0) end

