			<Item class="Script" referent="RBX9502">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">CinematicHelp2</string>
					<ProtectedString name="Source">player = nil
while true do
wait()
if script.Parent.Parent.Parent.className == &quot;Player&quot; then
player = script.Parent.Parent.Parent
end
if player ~= nil then
if player.PlayerGui:findFirstChild(&quot;DS2&quot;) ~= nil then
script.Parent.Parent = game.Lighting
elseif player.PlayerGui:findFirstChild(&quot;DS2&quot;) == nil then
script.Parent.Parent = player.PlayerGui
end
end
end
</ProtectedString>
				</Properties>
			</Item>
			<Item class="Script" referent="RBX9503">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<ProtectedString name="Source">function once()
a = script.Parent:GetChildren()
for i = 1, #a do
if a[i].className == &quot;TextButton&quot; or a[i].className == &quot;Frame&quot; or a[i].className == &quot;TextLabel&quot; then
a[i].Position = a[i].Position + UDim2.new(0,0,0.03125)
end
end
end

once()</ProtectedString>
