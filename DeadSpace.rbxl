				<Item class="Script" referent="RBX8993">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">db  = true
damage = math.random(2,3)
function touch(hit)
if hit.Parent ~= nil and db == true and script.Parent.Parent.Harm.Value == true then
db = false
if hit:findFirstChild(&quot;Connect&quot;) ~= nil then
hit.Connect.Value = hit.Connect.Value - math.random(25,29)
end
a = hit.Parent:GetChildren()
for i = 1, #a do
if a[i].className == &quot;Humanoid&quot; and a[i] ~= script.Parent.Parent.Parent:findFirstChild(&quot;Humanoid&quot;) then
if game.Players:playerFromCharacter(a[i].Parent) == nil then
if hit.Name == &quot;Torso&quot; then
a[i].Health = a[i].Health - damage * 1.25
elseif hit.Name == &quot;Head&quot; then
a[i].Health = a[i].Health - damage * 1.5
else 
a[i].Health = a[i].Health - damage 
end
elseif game.Players:playerFromCharacter(a[i].Parent) ~= nil and a[i].Name == &quot;DS&quot; then
if hit.Name == &quot;Torso&quot; then
a[i].Health = a[i].Health - damage * 1.25
elseif hit.Name == &quot;Head&quot; then
a[i].Health = a[i].Health - damage * 1.5
else 
a[i].Health = a[i].Health - damage 
end
end
end
end
wait(0.01)
db = true
end
end

connection = script.Parent.Touched:connect(touch)</ProtectedString>
