				<Item class="LocalScript" referent="RBX13167">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Local Gui</string>
						<ProtectedString name="Source">Tool = script.Parent;
wled = Instance.new(&quot;Weld&quot;)
wled.Parent = script.Parent.Spn
wled.Part0 = script.Parent.Spn
wled.Part1 = script.Parent.Blade
wled.C0 = CFrame.new(0, 0, 0)
wled.Name = &quot;Weldy&quot;
wled22 = Instance.new(&quot;Weld&quot;)
wled22.Parent = script.Parent.Spn
wled22.Part0 = script.Parent.Spn
wled22.Part1 = script.Parent.Spot
wled22.C0 = CFrame.new(0, 0.1, -4.255555555)
wled22.Name = &quot;Weldy&quot;
p = Instance.new(&quot;IntValue&quot;)
p.Parent = wled
p.Name = &quot;Pi&quot;

dd = true
enabled = true
function onButton1Down(mouse)
if dd == false or script.Parent.Ammo.Value &lt; 1 then return end
enabled = true
dd = false
aa = script.Parent.Spn:GetChildren()
for i = 1, #aa do
if aa[i].className == &quot;Weld&quot; then
if aa[i]:findFirstChild(&quot;Pi&quot;) ~= nil then
aa[i]:remove()
end
end
end
script.Parent.Blade.Self.Value = script.Parent.Parent
script.Parent.H1.Mesh.Offset = Vector3.new(0, -0.04, 0.6)
script.Parent.Spn.Mesh.Offset = Vector3.new(0, 0, 0.6)
script.Parent.Handle.Chain:play()
script.Parent.Blade.On.Value = true
script.Parent.Blade.Transparency = 0
script.Parent.Blade.Bod.maxForce = Vector3.new(99999, 99999, 99999)
script.Parent.Blade.Turn.maxTorque = Vector3.new(99999, 99999, 99999)
while enabled do
wait(0.1)
script.Parent.Ammo.Value = script.Parent.Ammo.Value - 1
script.Parent.Blade.Bod.position = script.Parent.Spot.Position + Vector3.new(0,1,0)
script.Parent.Blade.Dir.Value = true
lab.Text = &quot;Energy: &quot;..script.Parent.Ammo.Value
end
script.Parent.Blade.Bod.position = script.Parent.Spn.Position + Vector3.new(0,1,0)
wait(0.2)
script.Parent.Handle.Chain:stop()
script.Parent.Blade.Bod.maxForce = Vector3.new(0, 0, 0)
script.Parent.Blade.On.Value = false
script.Parent.Blade.Turn.maxTorque = Vector3.new(0, 0, 0)
wled2 = Instance.new(&quot;Weld&quot;)
wled2.Parent = script.Parent.Spn
wled2.Part0 = script.Parent.Spn
wled2.Part1 = script.Parent.Blade
wled2.C0 = CFrame.new(0, 0, 0)
p2 = Instance.new(&quot;IntValue&quot;)
p2.Parent = wled2
p2.Name = &quot;Pi&quot;
script.Parent.Blade.Transparency = 1
script.Parent.H1.Mesh.Offset = Vector3.new(0, -0.4, 0.6)
script.Parent.Spn.Mesh.Offset = Vector3.new(0, 0.15, 0.6)
script.Parent.Blade.Dir.Value = false
wait(0.1)
dd = true
end

function onButton1Up(mouse)
enabled = false
end

on = true

function onKeyDown(key)
if key == &quot;r&quot; and dd == true and script.Parent.Ammo.Value &gt; 5 then
dd = false
script.Parent.Ammo.Value = script.Parent.Ammo.Value - 20
lab.Text = &quot;Energy: &quot;..script.Parent.Ammo.Value
script.Parent.Handle.Launch:play()
ddd = Instance.new(&quot;Part&quot;)
ddd.Parent = game.Workspace
ddd.Size = Vector3.new(1, 1.2, 1)
ddd.CFrame = script.Parent.Spn.CFrame * CFrame.new(0, 0, -5)
ddd.CanCollide = false
ddd.Name = &quot;RipBlade&quot;
boody = Instance.new(&quot;BodyVelocity&quot;)
boody.Parent = ddd
boody.maxForce = Vector3.new(99999, 99999, 99999)
boody.velocity = script.Parent.Spn.CFrame.lookVector * 50
ssss = script.Parent.Blade.Turn:clone()
ssss.Parent = ddd
ssss.maxTorque = Vector3.new(99999, 99999, 99999)
script.stick:clone().Parent = ddd
script.Parent.Blade.Mesh:clone().Parent = ddd
v = Instance.new(&quot;BoolValue&quot;)
v.Parent = ddd
v.Name = &quot;V&quot;
jpeg = script.cle:clone()
jpeg.Parent = ddd
jpeg.Disabled = false
wait(0.7)
dd = true
elseif key == &quot;k&quot; then
if on == true then
on = false
script.Parent.Light.Transparency = 1
elseif on == false then
on = true
script.Parent.Light.Transparency = .5
end
end
end







function onEquippedLocal(mouse)

&#9;if mouse == nil then
&#9;&#9;print(&quot;Mouse not found&quot;)
&#9;&#9;return 
&#9;end

&#9;script.Parent.Creator.Value = game.Players.LocalPlayer.Name

&#9;script.Parent.Handle.Rip.Volume = 1
&#9;script.Parent.Handle.Chain.Volume = 1

&#9;mouse.Icon = &quot;rbxasset://textures\\ArrowCursor.png&quot;
&#9;mouse.Button1Down:connect(function() onButton1Down(mouse) end)
&#9;mouse.Button1Up:connect(function() onButton1Up(mouse) end)
&#9;mouse.KeyDown:connect(onKeyDown)
GUI = script.Parent.RipperGUI:clone()
GUI.Parent = game.Players.LocalPlayer.PlayerGui
lab = GUI.Ammo
clop = script.Set:clone()
clop.Disabled = false
clop.Parent = lab
bob = Instance.new(&quot;ObjectValue&quot;)
bob.Parent = lab
bob.Name = &quot;ammo&quot;
bob.Value = script.Parent.Ammo
end

function onUnequippedLocal(mouse)
script.Parent.Handle.Rip.Volume = 0
script.Parent.Handle.Chain.Volume = 0
GUI:remove()
script.Parent.Handle.Chain:stop()
script.Parent.Blade.Bod.maxForce = Vector3.new(0, 0, 0)
script.Parent.Blade.On.Value = false
script.Parent.Blade.Turn.maxTorque = Vector3.new(0, 0, 0)
wled23 = Instance.new(&quot;Weld&quot;)
wled23.Parent = script.Parent.Spn
wled23.Part0 = script.Parent.Spn
wled23.Part1 = script.Parent.Blade
wled23.C0 = CFrame.new(0, 0, 0)
wled23.Name = &quot;Weldy&quot;
p23 = Instance.new(&quot;IntValue&quot;)
p23.Parent = wled23
p23.Name = &quot;Pi&quot;
script.Parent.Blade.Transparency = 1
end

Tool.Unequipped:connect(onUnequippedLocal)
Tool.Equipped:connect(onEquippedLocal)</ProtectedString>
