&#9;&#9;bp2 = script.BodyPosition:clone()
&#9;&#9;bp2.position = bp.position + cframe
&#9;&#9;bp2.Parent = target.Character.Torso
&#9;&#9;script.Parent.FinalActive.Value = true
&#9;&#9;wait(1.5)
&#9;&#9;script.Parent.FinalActive.Value = false
&#9;&#9;animate(&quot;Final&quot;)
&#9;&#9;bp.position = script.Parent.Parent.Torso.Position + Vector3.new(0,-15,0)
&#9;&#9;bp2.position = bp2.position - Vector3.new(0,15,0)
&#9;&#9;wait(0.2)
&#9;&#9;bp2:remove()
&#9;&#9;E = Instance.new(&quot;Explosion&quot;)
&#9;&#9;E.BlastRadius = 1
&#9;&#9;E.BlastPressure = 0
&#9;&#9;E.Position = target.Character.Torso.Position
&#9;&#9;E.Parent = game.Workspace
&#9;&#9;target.Character.DS.Health = 0 -- manual change is needed for....humanoid....---------------------------------------------------------------------------------------------------------------------------------------------------                    &lt;--
&#9;&#9;wait(0.3)
&#9;&#9;CurHumanoid.WalkSpeed = 16
&#9;&#9;bp:remove()
&#9;&#9;script.Parent.Parent.Torso[&quot;Left Shoulder&quot;].C1 = CFrame.new(0.4, 0.5, 0, -0, -0, -1, 0, 1, 0, 1, 0, 0) * CFrame.fromEulerAnglesXYZ(math.pi/16,0,0)
&#9;&#9;script.Parent.Parent.Torso[&quot;Right Shoulder&quot;].C1 = CFrame.new(-0.4, 0.5, 0, 0, 0, 1, 0, 1, 0, -1, -0, -0) * CFrame.fromEulerAnglesXYZ(math.pi/16,0,0)
&#9;&#9;wait(0.5)
&#9;&#9;deb = true
&#9;&#9;wait(25)
&#9;&#9;deb4 = true
&#9;&#9;end
&#9;end
end
end)

mouse.Button1Down:connect(function()
if script.Parent.Parent:FindFirstChild(&quot;Sabled&quot;) == nil then
click = click + 1
&#9;&#9;if deb == true then
&#9;&#9;deb = false
