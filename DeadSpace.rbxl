			<Item class="ScreenGui" referent="RBX8507">
				<Properties>
					<string name="Name">CrawlerBreak</string>
				</Properties>
				<Item class="Script" referent="RBX8508">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">TimeLeft</string>
						<ProtectedString name="Source">while true do
wait()
if script.Parent.Parent.Name == &quot;PlayerGui&quot; then
wait(7)
if script.Parent.Button.Amount.Value &lt; 30 then

if script.Parent.Parent.Parent.Character:findFirstChild(&quot;RealHead&quot;) == nil then
c = script.Parent.Parent.Parent.Character.Head:clone()
c.Name = &quot;FakeHead&quot;
m = script.Parent.Parent.Parent.Character.Head:GetChildren()
for l = 1, #m do
if m[l].className == &quot;Decal&quot; then
m[l]:remove()
end
end
m2 = script.Parent.Parent.Parent.Character:GetChildren()
for l2 = 1, #m2 do
if m2[l2].className == &quot;Hat&quot; then
m2[l2]:remove()
end
end
script.Parent.Parent.Parent.Character.Head.Transparency = 1
script.Parent.Parent.Parent.Character.Head.Anchored = true
script.Parent.Parent.Parent.Character.Head.CanCollide = false
c.Parent = script.Parent.Parent.Parent.Character
c.Position = script.Parent.Parent.Parent.Character.Head.Position + Vector3.new(0,1,0)

elseif script.Parent.Parent.Parent.Character:findFirstChild(&quot;RealHead&quot;) ~= nil then
c2 = script.Parent.Parent.Parent.Character.RealHead:clone()
c2.Name = &quot;FakeHead&quot;
m2 = script.Parent.Parent.Parent.Character.RealHead:GetChildren()
for l2 = 1, #m2 do
if m2[l2].className == &quot;Decal&quot; then
m2[l2]:remove()
end
end
m23 = script.Parent.Parent.Parent.Character.Head:GetChildren()
for l23 = 1, #m23 do
if m23[l23].className == &quot;Decal&quot; then
m23[l23]:remove()
end
end
m22 = script.Parent.Parent.Parent.Character:GetChildren()
for l22 = 1, #m22 do
if m22[l22].className == &quot;Hat&quot; then
m22[l22]:remove()
end
end
if script.Parent.Parent.Parent.Character:findFirstChild(&quot;Helmet&quot;) ~= nil then
script.Parent.Parent.Parent.Character.Helmet:remove()
end
script.Parent.Parent.Parent.Character.RealHead.Transparency = 1
script.Parent.Parent.Parent.Character.Head.Anchored = true
script.Parent.Parent.Parent.Character.RealHead.CanCollide = false
c2.Parent = script.Parent.Parent.Parent.Character
c2.Position = script.Parent.Parent.Parent.Character.RealHead.Position + Vector3.new(0,1,0)
end
script.Parent.Button.Visible = false
script.Parent.Die:play()
wait(3)
script.Parent.Parent.Parent.Character.Head.Anchored = false
script.Parent.Parent.Parent.Character.Humanoid.Name = &quot;DS&quot;
script.Parent.Parent.Parent.Character.DS.MaxHealth = 200
script.Parent.Parent.Parent.Character.DS.Health = 200
script.Parent.Parent.Parent.Character.DS.WalkSpeed = 20
if script.Parent.Parent:findFirstChild(&quot;Dark&quot;) ~= nil then
script.Parent.Parent.Dark:remove()
end
clean = script.Parent.Parent.Parent.Backpack:GetChildren()
for all = 1, #clean do
if clean[all].className == &quot;Tool&quot; then
clean[all]:remove()
end
end
clean2 = script.Parent.Parent.Parent.Character:GetChildren()
for all2 = 1, #clean2 do
if clean2[all2].className == &quot;Tool&quot; then
clean2[all2].Parent = script.Parent.Parent.Parent.Backpack
wait(0.01)
clean2[all2]:remove()
end
end
claw = game.Lighting.WareHouse.Claws:clone()
claw.Parent = script.Parent.Parent.Parent.Backpack
script:remove()
elseif script.Parent.Button.Amount.Value &gt; 29 then
if script.Parent.Parent.Parent.Character:findFirstChild(&quot;CRAWLERHOLD&quot;) ~= nil then
script.Parent.Parent.Parent.Character:findFirstChild(&quot;CRAWLERHOLD&quot;):remove()
end
if script.Parent.Parent.Parent.Character:findFirstChild(&quot;HeadCrawler&quot;) ~= nil then
script.Parent.Parent.Parent.Character.HeadCrawler:remove()
end
script.Parent:remove()
end
end
end

</ProtectedString>
					</Properties>
				</Item>
				<Item class="ObjectValue" referent="RBX8509">
					<Properties>
						<string name="Name">Crawler</string>
						<Ref name="Value">null</Ref>
