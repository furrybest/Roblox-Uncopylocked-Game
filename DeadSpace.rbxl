&#9;&#9;script.Parent.Parent.Torso[&quot;Left Shoulder&quot;].C1 = CFrame.new(0, 0.5, -0.5, -0, -0, -1, 0, 1, 0, 1, 0, 0) * CFrame.fromEulerAnglesXYZ(0,math.pi/2,0)
&#9;&#9;bp = script.BodyPosition:clone()
