				<Item class="Script" referent="RBX9440">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">ActivateS</string>
						<ProtectedString name="Source">function run()
p = script.Parent.Parent.Parent.Parent
if p.Character:findFirstChild(&quot;Head&quot;) ~= nil and p.Character:findFirstChild(&quot;Torso&quot;) ~= nil then
if p.Character:findFirstChild(&quot;Worn&quot;) == nil then
scr = script.Parent.Cleaner:clone()
scr.Disabled = false
scr.Parent = p.Character
u = game.Lighting.WareHouse.Police:clone()
u.Parent = p.Character
u2 = game.Lighting.WareHouse.Police2:clone()
u2.Parent = p.Character
hel = game.Lighting.WareHouse.Helmet:clone()
hel.Parent = p.Character
hel.CFrame = p.Character.Head.CFrame
w = Instance.new(&quot;Weld&quot;)
w.Parent = hel
w.Part0 = hel
w.Part1 = p.Character.Head
pos = CFrame.new(p.Character.Head.Position)
w.C0 = hel.CFrame:inverse() * pos
w.C1 = p.Character.Head.CFrame:inverse() * pos
v = Instance.new(&quot;ObjectValue&quot;)
v.Name = &quot;Worn&quot;
v.Parent = p.Character
script.Parent.Parent:remove()
end
end
end

script.Parent.MouseButton1Down:connect(run)
</ProtectedString>
					</Properties>
				</Item>
				<Item class="Script" referent="RBX9441">
					<Properties>
						<bool name="Disabled">true</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Cleaner</string>
						<ProtectedString name="Source">while true do
wait()
s = script.Parent:GetChildren()
for k = 1, #s do
if s[k].className == &quot;Pants&quot; or s[k].className == &quot;Shirt&quot; or s[k].className == &quot;Hat&quot; then
if s[k].Name ~= &quot;Police&quot; and s[k].Name ~= &quot;Police2&quot; then
s[k]:remove()
end
end
end
end

</ProtectedString>
					</Properties>
				</Item>
			</Item>
			<Item class="Script" referent="RBX9442">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Main</string>
					<ProtectedString name="Source">while true do
wait()
if script.Parent.Parent.Parent.Character:findFirstChild(&quot;CamEdit&quot;) == nil then
script.Parent.Swat.Visible = true
script.Parent.Issac.Visible = true
script.Parent.Title.Visible = true
script.Parent.NoSuit.Visible = true
elseif script.Parent.Parent.Parent.Character:findFirstChild(&quot;CamEdit&quot;) ~= nil then
script.Parent.Swat.Visible = false
script.Parent.Issac.Visible = false
script.Parent.Title.Visible = false
script.Parent.NoSuit.Visible = false
end
if script.Parent.Parent.Parent.Character:findFirstChild(&quot;NameTag&quot;) == nil then
p = script.Parent.Parent.Parent
name = script.Parent.Named:clone()
name.Parent = p.Character
name.Adornee = p.Character.Torso
name.Words.Text = p.Name
name.Name = &quot;NameTag&quot;
head = p.Character.Head:clone()
head.Name = &quot;RealHead&quot;
head.Parent = p.Character
head.CFrame = p.Character.Head.CFrame
head.BrickColor = p.Character.Head.BrickColor
w2 = Instance.new(&quot;Weld&quot;)
w2.Parent = head
w2.Part0 = head
w2.Part1 = p.Character.Head
pos = CFrame.new(p.Character.Head.Position)
w2.C0 = head.CFrame:inverse() * pos
w2.C1 = p.Character.Head.CFrame:inverse() * pos
if p.Character.Head:findFirstChild(&quot;face&quot;) ~= nil then
p.Character.Head.face:remove()
end
p.Character.Head.Transparency = 1
end
end
</ProtectedString>
				</Properties>
			</Item>
