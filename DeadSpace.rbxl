		<Item class="Script" referent="RBX4906">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Scare Factor</string>
				<ProtectedString name="Source">while true do
wait()
a = game.Players:GetChildren()
for i = 1, #a do
if a[i].PlayerGui:findFirstChild(&quot;SpawnScare&quot;) == nil then
c = script.SpawnScare:clone()
c.Parent = a[i].PlayerGui
c.Disabled = false
end
end
end
</ProtectedString>
			</Properties>
			<Item class="Script" referent="RBX4907">
				<Properties>
					<bool name="Disabled">true</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">SpawnScare</string>
					<ProtectedString name="Source">while true do
wait(math.random(90,120))
random = math.random(1,3)
if script.Parent:findFirstChild(&quot;DS2&quot;) == nil then
if random == 1 then
c = script.S1:clone()
c.Parent = script.Parent
c.Image.Visible = true
c.SoundS.Volume = 1
c.SoundS:play()
wait(0.2)
c.Image.Visible = false
wait(5)
c.SoundS.Volume = 0
c:remove()
elseif random == 2 then
c = script.S2:clone()
c.Parent = script.Parent
c.Image.Visible = true
c.SoundS.Volume = 1
c.SoundS:play()
wait(0.2)
c.Image.Visible = false
wait(5)
c.SoundS.Volume = 0
c:remove()
elseif random == 3 then
c = script.S3:clone()
c.Parent = script.Parent
c.Image.Visible = true
c.SoundS.Volume = 1
c.SoundS:play()
wait(0.2)
c.Image.Visible = false
wait(5)
c.SoundS.Volume = 0
c:remove()
end
end
end
</ProtectedString>
				</Properties>
