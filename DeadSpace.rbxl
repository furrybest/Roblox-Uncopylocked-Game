						<Item class="Script" referent="RBX12418">
							<Properties>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">Attach</string>
								<ProtectedString name="Source">while true do
wait()
if script.Parent.Parent.AOK.Value == true then
if script.Parent.Parent.Jump.Value == true and script.Parent.Parent.DS.Health &gt; 0 then
a = game.Players:GetChildren()
for i = 1, #a do
if a[i].Character ~= nil then
if a[i].Character:findFirstChild(&quot;Torso&quot;) ~= nil and a[i].Character:findFirstChild(&quot;Humanoid&quot;) ~= nil then
if a[i].Character:findFirstChild(&quot;Humanoid&quot;) ~= nil then
if a[i].Character.Humanoid.Health &gt; 0 then
if a[i].Character:findFirstChild(&quot;CRAWLERHOLD&quot;) == nil and a[i].Character:findFirstChild(&quot;INFECTORHOLD&quot;) == nil and a[i].PlayerGui:findFirstChild(&quot;SwarmBreak&quot;) == nil then
if (script.Parent.Position - a[i].Character.Torso.Position).magnitude &lt; 10 then
script.Parent.Parent.Jump.Value = false
h = Instance.new(&quot;ObjectValue&quot;)
h.Name = &quot;CRAWLERHOLD&quot;
h.Parent = a[i].Character
c = script.Parent.Parent:clone()
c.Parent = a[i].Character
c:MakeJoints()
c.DS:remove()
c.Respawn:remove()
c.KillScript:remove()
c.Torso.Attach:remove()
c.Name = &quot;HeadCrawler&quot;
c:MoveTo(a[i].Character.Torso.Position)
script.Parent.Parent.DS.Health = 0
g = c:GetChildren()
for h = 1, #g do
if g[h].className == &quot;Part&quot; or g[h].className == &quot;Wedge&quot; then
&#9;self = a[i].Character.Torso
&#9;weld = Instance.new(&quot;Weld&quot;)
&#9;weld.Part0 = self
&#9;weld.Part1 = g[h]
&#9;weld.C0 = CFrame.new(0,1.7,0) * CFrame.fromEulerAnglesXYZ(0,0,0)
&#9;weld.Parent = self
&#9;weld.Name = &quot;CRAWLERWELD&quot;
end
end
c = script.Parent.Parent.CrawlerBreak:clone()
c.Parent = a[i].PlayerGui
c.Crawler.Value = script.Parent.Parent
end
end
end
end
end
end
end
end
end
end


</ProtectedString>
