				<Item class="Script" referent="RBX8771">
					<Properties>
						<bool name="Disabled">true</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">OnDeath</string>
						<ProtectedString name="Source">while true do
wait()
if script.Parent.Main.Value.Player.Value.Character:findFirstChild(&quot;Humanoid&quot;) ~= nil then
if script.Parent.Main.Value.Player.Value.Character.Humanoid.Health &lt; 1 then
script.Parent.Main.Value.Player.Value = nil
script.Parent.Main.Value.On.Value = false
script.Parent.Main.Value.PlayerName.Value = &quot;&quot;
script.Parent:remove()
end
else
script.Parent.Main.Value.Player.Value = nil
script.Parent.Main.Value.On.Value = false
script.Parent.Main.Value.PlayerName.Value = &quot;&quot;
script.Parent:remove()
end
end
</ProtectedString>
					</Properties>
				</Item>
			</Item>
			<Item class="Script" referent="RBX8772">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">MiddleGUI</string>
					<ProtectedString name="Source">while true do
wait()
if script.Parent.On.Value == true and script.Parent.Player.Value ~= nil and script.Parent.Player.Value.Character:findFirstChild(&quot;SecurityCam&quot;) == nil then
d = script.Parent.SecurityCam:clone()
d.Parent = script.Parent.Player.Value.Character
d.Main.Value = script.Parent
d.OnDeath.Disabled = false
end
end
</ProtectedString>
				</Properties>
