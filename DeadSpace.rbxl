							<string name="Name">Modifier</string>
							<ProtectedString name="Source">while true do
wait()
 if script.Parent.HeartBeatV.Value == true and db == true then
script.Parent.HeartBeat:play()
db = false
elseif script.Parent.HeartBeatV.Value == false then
db = true
if script.Parent:findFirstChild(&quot;HeartBeat&quot;) ~= nil then
script.Parent.HeartBeat:stop()
end
end
end
