				<Item class="Script" referent="RBX4953">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">TimeLeft</string>
						<ProtectedString name="Source">while true do
wait()
if script.Parent.Parent.Name == &quot;PlayerGui&quot; then
wait(7)
if script.Parent.Button.Amount.Value &lt; 25 then
if script.Parent.Parent.Parent.Character.Head ~= nil then
c = script.Parent.Parent.Parent.Character.Head:clone()
m = script.Parent.Parent.Parent.Character.Head:GetChildren()
for l = 1, #m do
if m[l].className == &quot;Decal&quot; then
m[l]:remove()
end
end
m2 = script.Parent.Parent.Parent.Character:GetChildren()
for l2 = 1, #m2 do
if m2[l2].className == &quot;Hat&quot; then
m2[l2]:remove()
end
end
script.Parent.Parent.Parent.Character.Head.Transparency = 1
script.Parent.Parent.Parent.Character.Head.Anchored = true
script.Parent.Parent.Parent.Character.Head.CanCollide = false
c.Parent = script.Parent.Parent.Parent.Character
c.Position = script.Parent.Parent.Parent.Character.Head.Position + Vector3.new(0,1,0)
script.Parent.Button.Visible = false
script.Parent.Die:play()
wait(3)
mod = game.Lighting.Necro.Slasher:clone()
mod.Parent = game.Workspace
mod:MakeJoints()
mod:MoveTo(script.Parent.Parent.Parent.Character.Head.Position)
hum = Instance.new(&quot;Humanoid&quot;)
hum.Name = &quot;DS&quot;
hum.Parent = mod
mod.AOK.Value = true
hum.Health = hum.MaxHealth
s = script.Parent.CleanS:clone()
s.Disabled = false
s.Parent = mod
wait()
an = mod:GetChildren()
for un = 1, #an do
if an[un].className == &quot;Part&quot; then
an[un].Anchored = false
end
end
rem = script.Parent.Parent.Parent.Character:GetChildren()
for r = 1, #rem do
if rem[r].className == &quot;Part&quot; then 
rem[r]:remove()
end
end
wait(0.1)
script.Parent.Infector.Value.Jump.Value = true
end
elseif script.Parent.Button.Amount.Value &gt; 24 then
if script.Parent.Parent.Parent.Character:findFirstChild(&quot;INFECTORHOLD&quot;) ~= nil then
script.Parent.Parent.Parent.Character:findFirstChild(&quot;INFECTORHOLD&quot;):remove()
end
script.Parent.Infector.Value.DS.Health = 0
script.Parent:remove()
end
end
end

</ProtectedString>
