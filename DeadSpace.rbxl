function weld()
a = script.Parent:GetChildren()
for  i = 1, #a do
if a[i].className == &quot;Part&quot; or a[i].className == &quot;Wedge&quot; then
if a[i].Name == &quot;Tail&quot; then
stick1(a[i])
elseif a[i].Name == &quot;Sting&quot; then
stick2(a[i])
else
stick(a[i])
end
end
end
