			<Item class="Script" referent="RBX9414">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<ProtectedString name="Source">--Script made by robbieNEC

waitTime=8&#9;--How long it shows


script.Parent.Frame.Visible=false

function playerEntered(Player)
&#9;if Player ~= nil then
&#9;&#9;link = &quot;http://www.roblox.com/thumbs/avatar.ashx?x=150&amp;y=200&amp;format=png&amp;username=&quot;
&#9;&#9;script.Parent.Frame.ImageLabel.Image = link .. Player.Name .. &quot;&amp;RAND=&quot; .. math.random(1,100000)
&#9;&#9;script.Parent.Frame.TextBox.Text= Player.Name .. &quot; has entered&quot;
&#9;&#9;script.Parent.Frame.Visible=true
&#9;&#9;wait(waitTime)
&#9;&#9;script.Parent.Frame.Visible=false
&#9;end
end


game.Players.ChildAdded:connect(playerEntered)


</ProtectedString>
				</Properties>
			</Item>
		</Item>
