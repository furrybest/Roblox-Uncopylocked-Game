						<string name="Name">cle</string>
						<ProtectedString name="Source">wait(30)
if script.Parent.V.Value == false then
script.Parent:remove()
end
</ProtectedString>
					</Properties>
				</Item>
				<Item class="Script" referent="RBX10677">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">stick</string>
						<ProtectedString name="Source">arrow = script.Parent

ddd = false

function stick(hit)

&#9;if ddd == true then return end
&#9;ddd = true
&#9;script.Parent.V.Value = true
&#9;-- joint myself to the thing i hit

&#9;script.Parent.BodyVelocity:remove()
&#9;script.Parent.Turn:remove()

&#9;local weld = Instance.new(&quot;Weld&quot;)

&#9;weld.Part0 = arrow
&#9;weld.Part1 = hit


&#9;local HitPos = arrow.Position + (arrow.CFrame.lookVector * 2.2)

&#9;local CJ = CFrame.new(HitPos)
&#9;local C0 = arrow.CFrame:inverse() *CJ
&#9;local C1 = hit.CFrame:inverse() * CJ
&#9;
&#9;weld.C0 = C0
&#9;weld.C1 = C1

&#9;weld.Parent = arrow



&#9;if hit.Parent:findFirstChild(&quot;Zombie&quot;) ~= nil then
&#9;hit.Parent:findFirstChild(&quot;Zombie&quot;).Health = hit.Parent:findFirstChild(&quot;Zombie&quot;).Health - math.random(25, 30)
&#9;end

&#9;wait(10)

&#9;script.Parent:remove()

end


function onTouched(hit)
if hit.Parent.Name ~= &quot;Ripper&quot; and hit.Name ~= &quot;Classes&quot; and hit.Parent:findFirstChild(&quot;RipperGUI&quot;) == nil then 
if ddd == true then return end
stick(hit)
end
end


if script.Parent.Name ~= &quot;Local Gui&quot; then
connection = arrow.Touched:connect(onTouched)
end

