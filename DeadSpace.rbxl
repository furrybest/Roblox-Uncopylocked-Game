				<Item class="Script" referent="RBX2078">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">while true do
wait()
a = game.Players:GetChildren()
for i = 1, #a do
if a[i].Character ~= nil then
if a[i].Character:findFirstChild(&quot;Torso&quot;) ~= nil then
if (a[i].Character.Torso.Position - script.Parent.Position).magnitude &lt; 6 then
if a[i].Log2PV.Value == false then
a[i].Log2PV.Value = true
gui = script.Parent.NewLog:clone()
gui.Parent = a[i].PlayerGui
c = script.Parent.Clean:clone()
c.Parent = gui
c.Disabled = false
end
end
end
end
end
end
</ProtectedString>
					</Properties>
				</Item>
				<Item class="Script" referent="RBX2079">
					<Properties>
						<bool name="Disabled">true</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Clean</string>
						<ProtectedString name="Source">while true do
wait(3)
script.Parent:remove()
end
</ProtectedString>
					</Properties>
				</Item>
