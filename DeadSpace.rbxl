						<string name="Name">Cut</string>
						<ProtectedString name="Source">while true do
wait()
if script.Parent.Connect.Value &lt; 1 then
script.Parent:BreakJoints()
script.Parent.Parent.DS.Health = script.Parent.Parent.DS.Health - math.random(75,125)
script.Parent.S:play()
wait(4)
script.Parent:remove()
end
end
</ProtectedString>
