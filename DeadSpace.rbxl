				<Item class="Script" referent="RBX13341">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Weld Script</string>
						<ProtectedString name="Source">function Weld(x,y)
&#9;local W = Instance.new(&quot;Weld&quot;)
&#9;W.Part0 = x
&#9;W.Part1 = y
&#9;local CJ = CFrame.new(x.Position)
&#9;local C0 = x.CFrame:inverse()*CJ
&#9;local C1 = y.CFrame:inverse()*CJ
&#9;W.C0 = C0
&#9;W.C1 = C1
&#9;W.Parent = x
end

function Get(A)
&#9;if A.className == &quot;Part&quot; then
&#9;&#9;Weld(script.Parent.Handle, A)
&#9;&#9;A.Anchored = false
&#9;else
&#9;&#9;local C = A:GetChildren()
&#9;&#9;for i=1, #C do
&#9;&#9;Get(C[i])
&#9;&#9;end
&#9;end
end

function Finale()
&#9;Get(script.Parent)
end

script.Parent.Equipped:connect(Finale)
script.Parent.Unequipped:connect(Finale)
Finale()</ProtectedString>
					</Properties>
				</Item>
				<Item class="Script" referent="RBX13342">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">RocketScript</string>
						<ProtectedString name="Source">shaft = script.Parent
position = shaft.Position

function fly()
&#9;direction = shaft.CFrame.lookVector 
&#9;position = position + direction * 12
&#9;error = position - shaft.Position
&#9;shaft.Velocity = 7*error
end


ball = script.Parent
damage = math.random(29,37)

db = true

function onTouched(hit)
if db == true and hit:findFirstChild(&quot;Bullet&quot;) == nil then
db = false
&#9;if hit:findFirstChild(&quot;Connect&quot;) ~= nil then
&#9;hit.Connect.Value = hit.Connect.Value - math.random(19,27)
&#9;end
&#9;script.Parent.Transparency = 1
&#9;a = hit.Parent:GetChildren()
&#9;for i = 1, #a do
&#9;if a[i].className == &quot;Humanoid&quot; then
&#9;if game.Players:playerFromCharacter(hit.Parent) ~= nil and a[i].Name == &quot;DS&quot; then
&#9;if hit.Name == &quot;Torso&quot; then
&#9;a[i].Health = a[i].Health - damage * 1.5
&#9;elseif hit.Name == &quot;Head&quot; then
&#9;a[i].Health = a[i].Health - damage * 2
&#9;else
&#9;a[i].Health = a[i].Health - damage
&#9;end
&#9;elseif game.Players:playerFromCharacter(hit.Parent) == nil then
&#9;if hit.Name == &quot;Torso&quot; then
&#9;a[i].Health = a[i].Health - damage * 1.5
&#9;elseif hit.Name == &quot;Head&quot; then
&#9;a[i].Health = a[i].Health - damage * 2
&#9;else
&#9;a[i].Health = a[i].Health - damage
&#9;end
&#9;end
&#9;end
&#9;end
&#9;wait()
&#9;if hit.Parent:findFirstChild(&quot;GiveExp&quot;) ~= nil then
&#9;player = game.Players:playerFromCharacter(script.Gunner.Value.Parent)
&#9;if player.Level.Value &lt; 20 then
&#9;if hit.Parent.DS.Health &lt; 1 then
&#9;player.EXP.Value = player.EXP.Value - hit.Parent.GiveExp.Value
&#9;hit.Parent.GiveExp:remove()
&#9;elseif hit.Parent.DS.Health &gt; 0 then
&#9;player.EXP.Value = player.EXP.Value - 1
&#9;end
&#9;end
&#9;end
&#9;wait(0.01)
&#9;ball.Parent = nil
else
if hit.Parent ~= script.Gunner.Value and db == true and hit.Parent.Parent ~= script.Gunner.Value then
script.Parent:remove()
end
end
end

ball.Touched:connect(onTouched)


r = game:service(&quot;RunService&quot;)

t, s = r.Stepped:wait()
d = t + 100.0 - s

while t &lt; d do

&#9;fly()

&#9;t = r.Stepped:wait()

end


shaft:remove()</ProtectedString>
					</Properties>
					<Item class="ObjectValue" referent="RBX13343">
						<Properties>
							<string name="Name">Gunner</string>
							<Ref name="Value">null</Ref>
						</Properties>
					</Item>
				</Item>
				<Item class="Script" referent="RBX13344">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Server Launcher</string>
						<ProtectedString name="Source">local Rocket = Instance.new(&quot;Part&quot;)
local Tool = script.Parent
MEEEESH = script.Parent.Mesh:clone()
rocketmesh = MEEEESH:clone()
rocketmesh.Parent = Rocket
Rocket.Locked = true
Rocket.BackSurface = 3
Rocket.BottomSurface = 3
Rocket.FrontSurface = 3
Rocket.LeftSurface = 3
Rocket.RightSurface = 3
Rocket.TopSurface = 3
Rocket.formFactor = 0
Rocket.BrickColor = BrickColor.new(23)
Rocket.Name = &quot;bullet&quot;


bf = Instance.new(&quot;BodyForce&quot;)
bf.force = Vector3.new(0,400,0)
bf.Parent = Rocket
Tool.RocketScript:clone().Parent = Rocket
Rocket.RocketScript.Gunner.Value = script.Parent

function fire(vTarget)

&#9; vHandle = script.Parent.Barrel

&#9;local vCharacter = Tool.Parent

&#9;local vPlayer = game.Players:playerFromCharacter(vCharacter)

&#9;local spawnPos = vHandle.Position

&#9;local dir = vTarget - vHandle.Position

&#9;dir = computeDirection(dir)

&#9;spawnPos  = vHandle.Position + (dir * 6)

&#9;if script.Parent.Mode.Value == false then
&#9;Rocket.Size = Vector3.new(1,2,1)
&#9;Rocket.Mesh.Scale = Vector3.new(0.3,1,0.3)
&#9;elseif script.Parent.Mode.Value == true then
&#9;Rocket.Size = Vector3.new(2,1,1)
&#9;Rocket.Mesh.Scale = Vector3.new(1,0.3,0.3)
&#9;end

&#9;local missile = Rocket:clone()


&#9;local pos = spawnPos
&#9;
&#9;--missile.Position = pos
&#9;missile.CFrame = CFrame.new(pos,  pos + dir)

&#9;local creator_tag = Instance.new(&quot;ObjectValue&quot;)

&#9;local vPlayer = game.Players:playerFromCharacter(vCharacter)

&#9;if vPlayer == nil then
&#9;&#9;print(&quot;Player not found&quot;)
&#9;else
&#9;&#9;if (vPlayer.Neutral == false) then -- nice touch
&#9;&#9;&#9;missile.BrickColor = vPlayer.TeamColor
&#9;&#9;end
&#9;end

&#9;creator_tag.Value =vPlayer
&#9;creator_tag.Name = &quot;creator&quot;
&#9;creator_tag.Parent = missile
&#9;
&#9;missile.RocketScript.Disabled = false

&#9;missile.Parent = game.Workspace
&#9;script.Parent.Ammo.Value = script.Parent.Ammo.Value - 5
&#9;script.Parent.Msg.Value.Text = &quot;Energy: &quot;..script.Parent.Ammo.Value

end

function computeDirection(vec)
&#9;local lenSquared = vec.magnitude * vec.magnitude
&#9;local invSqrt = 1 / math.sqrt(lenSquared)
&#9;return Vector3.new(vec.x * invSqrt, vec.y * invSqrt, vec.z * invSqrt)
end

Tool.Enabled = true
function onActivated()
&#9;if not Tool.Enabled then
&#9;&#9;return
&#9;end

&#9;Tool.Enabled = false

&#9;local character = Tool.Parent;
&#9;local humanoid = character.Humanoid
&#9;if humanoid == nil then
&#9;&#9;print(&quot;Humanoid not found&quot;)
&#9;&#9;return 
&#9;end

&#9;local targetPos = humanoid.TargetPoint

&#9;--local lookAt = (targetPos - script.Parent.Barrel.Position).unit

&#9;fire(targetPos)

&#9;wait(0.5)

&#9;Tool.Enabled = true
end


script.Parent.Activated:connect(onActivated)

</ProtectedString>
					</Properties>
				</Item>
				<Item class="LocalScript" referent="RBX13345">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Local Gui</string>
						<ProtectedString name="Source">local Tool = script.Parent;

enabled = true
function onButton1Down(mouse)
&#9;if not enabled then
&#9;&#9;return
&#9;end

&#9;enabled = false
   &#9;mouse.Icon = &quot;http://www.roblox.com/asset/?id=5462401&quot; 

&#9;wait(2)
 &#9;mouse.Icon = &quot;http://www.roblox.com/asset/?id=5462401&quot; 
&#9;enabled = true

end

db = true
function onKeyDown(key)
if key == &quot;r&quot; then
if db == true then
if script.Parent.Mode.Value == false then
db = false
script.Parent.Mode.Value = true
wait(0.5)
db = true
elseif script.Parent.Mode.Value == true then
db = false
script.Parent.Mode.Value = false
wait(0.5)
db = true
end
end
end
end

function onEquippedLocal(mouse)

&#9;if mouse == nil then
&#9;&#9;print(&quot;Mouse not found&quot;)
&#9;&#9;return 
&#9;end

&#9;mouse.Icon = &quot;http://www.roblox.com/asset/?id=5462401&quot;
&#9;mouse.Button1Down:connect(function() onButton1Down(mouse) end)
&#9;mouse.KeyDown:connect(onKeyDown)

GUI = script.Parent.CutterGUI:clone()
GUI.Parent = game.Players.LocalPlayer.PlayerGui
lab = GUI.Ammo
script.Parent.Msg.Value = lab
end

function UE()
GUI:remove()
end



Tool.Unequipped:connect(UE)
Tool.Equipped:connect(onEquippedLocal)
</ProtectedString>
					</Properties>
