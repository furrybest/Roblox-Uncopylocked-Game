							<string name="Name">YesScript</string>
							<ProtectedString name="Source">db = true
function Yes()
if db == true then
db = false
script.Parent.Parent.Main.Value.Player.Value = script.Parent.Parent.Parent.Parent
script.Parent.Parent.Main.Value.PlayerName.Value = script.Parent.Parent.Parent.Parent.Name
