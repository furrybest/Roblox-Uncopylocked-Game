					</Properties>
					<Item class="Script" referent="RBX9425">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Changer</string>
							<ProtectedString name="Source">chila = true
while true do
wait()
if script.Parent.Parent.Humanoid.Health &gt; 75 and chila == true then
script.Parent.Health1.BrickColor = BrickColor.new(23)
script.Parent.Health1.Reflectance = 0.25
elseif script.Parent.Parent.Humanoid.Health &lt; 76 then
script.Parent.Health1.BrickColor = BrickColor.new(26)
script.Parent.Health1.Reflectance = 0
end
if script.Parent.Parent.Humanoid.Health &gt; 50 and chila == true then
script.Parent.Health2.BrickColor = BrickColor.new(23)
script.Parent.Health2.Reflectance = 0.25
elseif script.Parent.Parent.Humanoid.Health &lt; 51 then
script.Parent.Health2.BrickColor = BrickColor.new(26)
script.Parent.Health2.Reflectance = 0
end
if script.Parent.Parent.Humanoid.Health &gt; 25 and chila == true then
script.Parent.Health3.BrickColor = BrickColor.new(23)
script.Parent.Health3.Reflectance = 0.25
elseif script.Parent.Parent.Humanoid.Health &lt; 26 then
script.Parent.Health3.BrickColor = BrickColor.new(26)
script.Parent.Health3.Reflectance = 0
end
if script.Parent.Parent.Humanoid.Health &gt; 1 and script.Parent.Parent.Humanoid.Health &lt; 26 and chila == true then
script.Parent.Health4.BrickColor = BrickColor.new(23)
script.Parent.Health4.Reflectance = 0.25
elseif script.Parent.Parent.Humanoid.Health &lt; 1 then
script.Parent.Health4.BrickColor = BrickColor.new(21)
script.Parent.Health3.BrickColor = BrickColor.new(21)
script.Parent.Health2.BrickColor = BrickColor.new(21)
script.Parent.Health1.BrickColor = BrickColor.new(21)
script.Parent.Health4.Reflectance = 0
script.Parent.Health3.Reflectance = 0
script.Parent.Health2.Reflectance = 0
script.Parent.Health1.Reflectance = 0
end
end
</ProtectedString>
