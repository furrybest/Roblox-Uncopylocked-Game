				<Item class="Script" referent="RBX8510">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Detach</string>
						<ProtectedString name="Source">while true do
wait()
if script.Parent.Parent.Name == &quot;PlayerGui&quot; then
if script.Parent.Button.Amount.Value &gt; 24 then
if script.Parent.Parent.Parent.Character:findFirstChild(&quot;CRAWLERHOLD&quot;) ~= nil then
script.Parent.Parent.Parent.Character.CRAWLERHOLD:remove()
end
if script.Parent.Parent.Parent.Character:findFirstChild(&quot;HeadCrawler&quot;) ~= nil then
script.Parent.Parent.Parent.Character.HeadCrawler:remove()
end
script.Parent:remove()
end
end
end

</ProtectedString>
