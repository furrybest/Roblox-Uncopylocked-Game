					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Respawn</string>
					<ProtectedString name="Source">name=&quot;Humanoid&quot;

robo=script.Parent:clone()

while true do
wait()
&#9;if script.Parent.DS.Health&lt;1 then
&#9;&#9;
&#9;&#9;script.Parent:BreakJoints()
&#9;&#9;wait(20)
&#9;&#9;robot=robo:clone()
&#9;&#9;Robot = robot:GetChildren()
&#9;&#9;for a = 1, #Robot do
&#9;&#9;if  Robot[a].className == &quot;Part&quot; then
&#9;&#9;Robot[a].Anchored = true
&#9;&#9;end
&#9;&#9;end
&#9;&#9;robot.Parent=script.Parent.Parent
&#9;&#9;robot:makeJoints()
&#9;&#9;script.Parent:remove()
&#9;&#9;wait()
&#9;&#9;Robot2 = robot:GetChildren()
&#9;&#9;for a2 = 1, #Robot2 do
&#9;&#9;if  Robot2[a2].className == &quot;Part&quot; then
&#9;&#9;Robot2[a2].Anchored = false
&#9;&#9;end
&#9;&#9;end
&#9;end
end
&#9;&#9;


