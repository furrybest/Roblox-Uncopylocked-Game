			<Item class="Script" referent="RBX8211">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Kill Script</string>
					<ProtectedString name="Source">local larm = script.Parent:FindFirstChild(&quot;Left Arm&quot;)
local rarm = script.Parent:FindFirstChild(&quot;Right Arm&quot;)

function findNearestTorso(pos)
&#9;local list = game.Workspace:children()
&#9;local torso = nil
&#9;local dist = 25
&#9;local temp = nil
&#9;local human = nil
&#9;local temp2 = nil
&#9;for x = 1, #list do
&#9;&#9;temp2 = list[x]
&#9;&#9;if (temp2.className == &quot;Model&quot;) and (temp2 ~= script.Parent) and game.Players:playerFromCharacter(temp2) ~= nil then
&#9;&#9;&#9;temp = temp2:findFirstChild(&quot;Torso&quot;)
&#9;&#9;&#9;human = temp2:findFirstChild(&quot;Humanoid&quot;)
&#9;&#9;&#9;if (temp ~= nil) and (human ~= nil) and (human.Health &gt; 0) and temp2:findFirstChild(&quot;INFECTORHOLD&quot;) == nil then
&#9;&#9;&#9;&#9;if (temp.Position - pos).magnitude &lt; dist then
&#9;&#9;&#9;&#9;&#9;torso = temp
&#9;&#9;&#9;&#9;&#9;dist = (temp.Position - pos).magnitude
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
&#9;return torso
end


while true do
&#9;wait(0.1)
&#9;local target = findNearestTorso(script.Parent.Torso.Position)
&#9;if target ~= nil then
&#9;&#9;script.Parent.DS:MoveTo(target.Position, target)
&#9;&#9;script.Parent.DS.WalkSpeed = 19 + math.random(0, 2)
&#9;end
end
</ProtectedString>
				</Properties>
			</Item>
			<Item class="BoolValue" referent="RBX8212">
				<Properties>
					<string name="Name">Jump</string>
					<bool name="Value">true</bool>
				</Properties>
			</Item>
			<Item class="Script" referent="RBX8213">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Respawn</string>
					<ProtectedString name="Source">wait(0.1)

robo=script.Parent:clone()

while true do
wait()
&#9;if script.Parent.DS.Health&lt;1 then
&#9;&#9;
&#9;&#9;script.Parent:BreakJoints()
&#9;&#9;wait(15)
&#9;&#9;robot=robo:clone()
&#9;&#9;Robot = robot:GetChildren()
&#9;&#9;for a = 1, #Robot do
&#9;&#9;if  Robot[a].className == &quot;Part&quot; then
&#9;&#9;Robot[a].Anchored = true
&#9;&#9;end
&#9;&#9;end
&#9;&#9;robot.Parent=script.Parent.Parent
&#9;&#9;robot:makeJoints()
&#9;&#9;script.Parent:remove()
&#9;&#9;wait()
&#9;&#9;Robot2 = robot:GetChildren()
&#9;&#9;for a2 = 1, #Robot2 do
&#9;&#9;if  Robot2[a2].className == &quot;Part&quot; then
&#9;&#9;Robot2[a2].Anchored = false
&#9;&#9;end
&#9;&#9;end
&#9;end
end
&#9;&#9;


</ProtectedString>
				</Properties>
			</Item>
			<Item class="Script" referent="RBX8214">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">WELD</string>
					<ProtectedString name="Source">function stick(hit)&#9;
&#9;print(&quot;Crap&quot;)
&#9;self = script.Parent.Torso
&#9;weld = Instance.new(&quot;Weld&quot;)
&#9;weld.Part0 = script.Parent.Torso
&#9;weld.Part1 = hit
&#9;local HitPos = self.Position
&#9;local CJ = CFrame.new(HitPos)
&#9;local C0 = self.CFrame:inverse() *CJ
&#9;local C1 = hit.CFrame:inverse() * CJ
&#9;weld.C0 = C0
&#9;weld.C1 = C1
&#9;weld.Parent = self
end



function weld()
a = script.Parent:GetChildren()
for  i = 1, #a do
if a[i].className == &quot;Part&quot; or a[i].className == &quot;Wedge&quot; then
stick(a[i])
end
end
end

weld()</ProtectedString>
				</Properties>
			</Item>
