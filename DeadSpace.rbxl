			<Item class="Script" referent="RBX8944">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">WELD</string>
					<ProtectedString name="Source">function stick(hit)&#9;
&#9;print(&quot;Crap&quot;)
&#9;self = script.Parent.Spine
&#9;weld = Instance.new(&quot;Weld&quot;)
&#9;weld.Part0 = script.Parent.Spine
&#9;weld.Part1 = hit
&#9;local HitPos = self.Position
&#9;local CJ = CFrame.new(HitPos)
&#9;local C0 = self.CFrame:inverse() *CJ
&#9;local C1 = hit.CFrame:inverse() * CJ
&#9;weld.C0 = C0
&#9;weld.C1 = C1
&#9;weld.Parent = self
end



function weld()
a = script.Parent:GetChildren()
for  i = 1, #a do
if a[i].className == &quot;Part&quot; and a[i]:findFirstChild(&quot;Meshy&quot;) ~= nil then
stick(a[i])
end
end
end

weld()</ProtectedString>
				</Properties>
			</Item>
			<Item class="Script" referent="RBX8945">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Welder</string>
					<ProtectedString name="Source">function WELD(origin, this, pos)
wee = Instance.new(&quot;Motor&quot;)
wee.Part0 = origin
wee.Part1 = this
wee.Parent = origin
wee.C0 = pos
wee.MaxVelocity = 0.55
ww = Instance.new(&quot;IntValue&quot;)
ww.Parent = wee
ww.Name = &quot;Pie&quot;
end

function one()
if script.Parent.Torso:findFirstChild(&quot;Motor&quot;) == nil then
WELD(script.Parent.Torso, script.Parent.LeftLimb, CFrame.new(-1.3, 5.3, 0) * CFrame.fromEulerAnglesXYZ(0, -7.9, 0))
WELD(script.Parent.Torso, script.Parent.RightLimb, CFrame.new(1.3, 5.3, 0) * CFrame.fromEulerAnglesXYZ(0, -7.9, 0))
elseif script.Parent.Torso:findFirstChild(&quot;Motor&quot;) ~= nil then
a = script.Parent.Torso:GetChildren()
for i = 1, #a do
if a[i].className == &quot;Motor&quot; then
a[i]:remove()
end
end
WELD(script.Parent.Torso, script.Parent.LeftLimb, CFrame.new(-1.3, 5.3, 0) * CFrame.fromEulerAnglesXYZ(0, -7.9, 0))
WELD(script.Parent.Torso, script.Parent.RightLimb, CFrame.new(1.3, 5.3, 0) * CFrame.fromEulerAnglesXYZ(0, -7.9, 0))
end
end

one()


</ProtectedString>
				</Properties>
