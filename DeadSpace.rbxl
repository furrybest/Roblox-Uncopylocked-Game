					<Item class="Script" referent="RBX9806">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script</string>
							<ProtectedString name="Source">script.Finish.Smoke.Value = script.Parent.Gas
function t(hit)
if hit.Parent:findFirstChild(&quot;Humanoid&quot;) ~= nil and hit.Parent:findFirstChild(&quot;Finish&quot;) == nil then
if hit.Parent.Humanoid.Health &gt; 5 and hit.Parent:findFirstChild(&quot;INFECTORHOLD&quot;) == nil and hit.Parent:findFirstChild(&quot;CRAWLERHOLD&quot;) == nil then
hit.Parent.Humanoid.Health = hit.Parent.Humanoid.Health - math.random(3,5)
elseif hit.Parent.Humanoid.Health &lt; 6 and hit.Parent:findFirstChild(&quot;Finish&quot;) == nil and hit.Parent:findFirstChild(&quot;FAKE&quot;) == nil then
hit.Parent.Humanoid.Health = 1
fin = script.Finish:clone()
fin.Disabled = false
fin.Parent = hit.Parent
end
end
end

script.Parent.Touched:connect(t)</ProtectedString>
						</Properties>
						<Item class="Script" referent="RBX9807">
							<Properties>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">Finish</string>
								<ProtectedString name="Source">db = true
while true do
wait()
if script.Parent:findFirstChild(&quot;Humanoid&quot;) ~= nil and db == true then
db = false
if script.Parent:findFirstChild(&quot;Health&quot;) ~= nil then
script.Parent.Health:remove()
end
script.Parent.Humanoid.Health = 0.1
script.Parent.Torso.Anchored = true
script.Parent.Humanoid.WalkSpeed = 0
script.Parent.Humanoid.Health = 0.1
if script.Parent:findFirstChild(&quot;FAKE&quot;) == nil then
e = script.Parent.Head:clone()
e.Parent = script.Parent
e.Position = script.Parent.Head.Position
e.Name = &quot;FAKE&quot;
end
a = script.Parent.Head:GetChildren()
for i = 1, #a do
a[i]:remove()
end
script.Parent.Head.Transparency = 1
h = script.Smoke.Value:clone()
h.Parent = e
h.Enabled = true
wait(2)
script.Parent.Torso.Anchored = false
script.Parent.Humanoid.Health = 0
script:remove()
end
end

</ProtectedString>
