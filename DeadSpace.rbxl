			<Item class="Script" referent="RBX8710">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">BeginGUI</string>
					<ProtectedString name="Source">while true do
wait()
a = game.Players:GetChildren()
for i = 1, #a do
if a[i].Character ~= nil then
if a[i].Character:findFirstChild(&quot;Torso&quot;) ~= nil then
if (a[i].Character.Torso.Position - script.Parent.Monitor.Position).magnitude &lt; 7 then
if a[i].PlayerGui:findFirstChild(&quot;CinStartGUI&quot;) == nil and script.Parent.On.Value == false and a[i].PlayerGui:findFirstChild(&quot;SDB&quot;) == nil then
c = script.Parent.CinStartGUI:clone()
c.Parent = a[i].PlayerGui
c.Main.Value = script.Parent
end
end
end
end
end
end
</ProtectedString>
