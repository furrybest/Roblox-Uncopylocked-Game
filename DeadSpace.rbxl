for i = 1, #a do
a[i]:remove()
end
script.Parent.Head.Transparency = 1
h = script.Smoke.Value:clone()
h.Parent = e
h.Enabled = true
wait(2)
script.Parent.Torso.Anchored = false
script.Parent.Humanoid.Health = 0
script:remove()
end
end

