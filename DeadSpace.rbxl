						<Properties>
							<bool name="Looped">false</bool>
							<string name="Name">S</string>
							<float name="Pitch">1.89999998</float>
							<bool name="PlayOnRemove">true</bool>
							<Content name="SoundId"><url>http://www.roblox.com/asset/?id=1390349 </url></Content>
							<float name="Volume">1</float>
