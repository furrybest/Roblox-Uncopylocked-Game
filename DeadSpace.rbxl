					<string name="Name">DownScript</string>
					<ProtectedString name="Source">while true do
wait()
if script.Parent.Attack.Value == true then
&#9;g = script.Parent.Torso:GetChildren()
&#9;for it = 1, #g do
&#9;if g[it].className == &quot;Motor&quot; then
&#9;if g[it]:findFirstChild(&quot;Pie&quot;) ~= nil then
&#9;g[it].DesiredAngle = 1.7
&#9;wait(0.4)
&#9;g[it].DesiredAngle = 0
&#9;wait(0.3)
&#9;end
&#9;end
&#9;end
end
end

</ProtectedString>
