				<Item class="Script" referent="RBX4950">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Attach</string>
						<ProtectedString name="Source">while true do
wait()
if script.Parent.Parent.AOK.Value == true then
if script.Parent.Parent.Jump.Value == true and script.Parent.Parent.DS.Health &gt; 0 then
a = game.Players:GetChildren()
for i = 1, #a do
if a[i].Character ~= nil then
if a[i].Character:findFirstChild(&quot;Torso&quot;) ~= nil and a[i].Character:findFirstChild(&quot;Humanoid&quot;) ~= nil then
if a[i].Character.Humanoid.Health &gt; 0 then
if a[i].Character:findFirstChild(&quot;INFECTORHOLD&quot;) == nil and a[i].Character:findFirstChild(&quot;CRAWLERHOLD&quot;) == nil and a[i].PlayerGui:findFirstChild(&quot;SwarmBreak&quot;) == nil then
if (script.Parent.Position - a[i].Character.Torso.Position).magnitude &lt; 10 then
script.Parent.Parent.Jump.Value = false
h = Instance.new(&quot;ObjectValue&quot;)
h.Name = &quot;INFECTORHOLD&quot;
h.Parent = a[i].Character
g = script.Parent.Parent:GetChildren()
for h = 1, #g do
if g[h].className == &quot;Part&quot; or g[h].className == &quot;Wedge&quot; then
&#9;self = a[i].Character.Torso
&#9;weld = Instance.new(&quot;Weld&quot;)
&#9;weld.Part0 = self
&#9;weld.Part1 = g[h]
&#9;weld.C0 = CFrame.new(0,-1,-0.8) * CFrame.fromEulerAnglesXYZ(-4.6,0,3)
&#9;weld.Parent = self
&#9;weld.Name = &quot;INFECTWELD&quot;
end
end
c = script.Parent.Parent.InfectBreak:clone()
c.Parent = a[i].PlayerGui
c.Infector.Value = script.Parent.Parent
end
end
end
end
end
end
end
end
end


</ProtectedString>
