					<string name="Name">Remover</string>
					<ProtectedString name="Source">while true do
wait()
if script.Parent.AOK.Value == true then
&#9;if script.Parent.DS.Health&lt;1 then
&#9;&#9;wait(1)
&#9;&#9;if script.Parent.DS.Health&lt;1 then
&#9;&#9;wait(4)
&#9;&#9;script.Parent:remove()
&#9;&#9;end
&#9;end
end
end
&#9;&#9;


</ProtectedString>
